<script setup lang="uts">
import { checkDirectEntry } from './src/router/interceptor';
import { useAppStore } from './src/store';
import { initNativeMidButtonTap } from '@/src/tabbar';

onLaunch(() => {
  // 提前实例化 App Store（含持久化还原），并初始化外观模式：跟随系统 / 浅色 / 深色
  useAppStore().initThemeMode();

  // 注册原生 TabBar 中间按钮监听（仅在原生模式且配置了 midButton 时生效）
  initNativeMidButtonTap();

  // #ifdef MP-WEIXIN
  // 微信小程序真机 @font-face 不生效，使用 uni.loadFontFace 加载 uni-icons 字体
  uni.loadFontFace({
    global: true,
    family: 'UniIconsFontFamily',
    source: 'url(\'/static/uniicons.ttf\')',
    success() {
      console.log('global loadFontFace uniicons.ttf success');
    },
    fail(error) {
      console.warn('global loadFontFace uniicons.ttf fail', error.errMsg);
    }
  });

  // #endif
});

// TODO(临时): UTS 探针页自动打开，任务 10 结束后删除
let probeTryCount: number = 0;
function openProbePage(): void {
  probeTryCount++;
  uni.navigateTo({
    url: '/src/sub/routerGuardProbe/routerGuardProbe',
    fail: () => {
      if (probeTryCount < 8) {
        setTimeout(() => {
          openProbePage();
        }, 800);
      }
    }
  });
}

onShow((options?) => {
  // #ifndef APP
  checkDirectEntry(options);
  // #endif

  // TODO(临时): UTS 探针页自动打开，任务 10 结束后删除
  // #ifdef APP-ANDROID
  setTimeout(() => {
    openProbePage();
  }, 1200);
  // #endif
});
</script>

