<script setup lang="uts">
import { checkDirectEntry } from './src/router/interceptor';
import { useAppStore } from './src/store';
import { initNativeMidButtonTap } from '@/src/tabbar';
import { setupIconfont } from '@/uni_modules/ali-iconfont/common/iconfont.uts';
import { applyThemeColor, themeColor } from '@/src/utils/theme/index.uts';

onLaunch(() => {
  // 提前实例化 App Store（含持久化还原），并初始化外观模式：跟随系统 / 浅色 / 深色
  const appStore = useAppStore();
  appStore.initThemeMode();

  // 确保全局 themeColor 与运行环境同步为持久化恢复的主题色
  if (appStore.state.theme.length > 0) {
    themeColor.value = appStore.state.theme;
    applyThemeColor(appStore.state.theme);
  }

  // 注册原生 TabBar 中间按钮监听（仅在原生模式且配置了 midButton 时生效）
  initNativeMidButtonTap();

  // 注册阿里 iconfont 字体图标库（见 uni_modules/ali-iconfont）。
  // 无参：字体 URL 与图标表都由插件自持（common/icons.uts，由插件脚本从阿里 CSS 生成）。
  // 换图标 / 换图标库 = 改插件根目录的 iconfont.config.mjs、再跑 `pnpm icons`，这里一个字都不用改。
  // 字体加载：小程序端由 setupIconfont 内部统一 loadFontFace（带 global，覆盖全部小程序平台）；
  // Web / H5 端靠 AliIconfontIcon 组件自带的 @font-face（同一份 CSS 生成，不手写）；
  // App 端走 AliIconfontIcon 的 web-view，字体内联在本地页里，不在这里加载。
  // 用法：<AliIconfontIcon name="gear" :size="24" />
  setupIconfont();

  // #ifdef MP-WEIXIN
  // 微信小程序真机 @font-face 不生效，使用 uni.loadFontFace 加载 uni-icons 字体
  uni.loadFontFace({
    global: true,
    family: 'UniIconsFontFamily',
    source: 'url(\'/static/uniicons.ttf\')',
    success() {
      console.log('global loadFontFace uniicons.ttf success');
    },
    fail(error) {
      console.warn('global loadFontFace uniicons.ttf fail', error.errMsg);
    }
  });

  // #endif
});

onShow((options?) => {
  // #ifndef APP
  checkDirectEntry(options);
  // #endif
});
</script>

<style lang="scss">
@import './src/style/index.scss';

/* #ifdef MP-WEIXIN */
/* 微信小程序真机：在全局 app.wxss 中注册字体，确保组件内可用 */
@import '@/uni_modules/uni-icons/components/uni-icons/uniicons_mp.css';
/* #endif */
/* #ifndef MP-WEIXIN */
@import './main.css';
/* #endif */

/* 阿里 iconfont 的字体声明不在这里 —— 它跟着 AliIconfontIcon 组件走：
   声明写在组件的 style 块里，由 uni_modules/ali-iconfont/scripts/gen-icons.mjs 从阿里 CSS 生成
   （换库改 iconfont.config.mjs 后跑 `pnpm icons`）。
   宿主只需在 onLaunch 调 setupIconfont()（见上），本文件一个字都不用改。 */

page {
  --test-color: #006241;
  --color-test: #006241;
  --font-test: 'Issue 978', sans-serif;
  --font-sans: 'inter', 'inter Fallback', system-ui;
  --font-serif: ui-serif, Georgia, Cambria, 'Times New Roman', Times, serif;
  --font-mono: var(--font-plex-mono), monospace;
  --color-red-50: #fef2f2;
  --color-red-500: #fb2c36;
  --color-red-950: #460809;
  --color-orange-500: #fe6e00;
  --color-amber-500: #f99c00;
  --color-yellow-500: #edb200;
  --color-lime-500: #80cd00;
  --color-green-500: #00c758;
  --color-emerald-500: #00bb7f;
  --color-teal-500: #00baa7;
  --color-cyan-500: #00b7d7;
  --color-sky-500: #00a5ef;
  --color-blue-500: #3080ff;
  --color-indigo-500: #625fff;
  --color-violet-500: #8d54ff;
  --color-purple-500: #ac4bff;
  --color-fuchsia-500: #e12afb;
  --color-pink-500: #f6339a;
  --color-rose-500: #ff2357;
  --color-slate-900: #0f172b;
  --color-gray-900: #101828;
  --color-zinc-900: #18181b;
  --color-neutral-900: #171717;
  --color-stone-900: #1c1917;
  --color-black: #000;
  --color-white: #fff;
  --spacing: 0.25rem;
  --text-base: 1rem;
  --font-weight-bold: 700;
  --radius-lg: 0.5rem;
  --default-font-family: var(--font-inter), system-ui;
  --default-mono-font-family: var(--font-plex-mono), monospace;
}

.issue-902-theme-scope {
  --theme-color: #16a34a;
}

/*  #ifdef  H5  */
svg {
  display: initial;
}

/*  #endif  */
</style>
