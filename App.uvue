<script setup lang="uts">
import { onAppShow } from '@dcloudio/uni-app';
import { checkDirectEntry } from '@/uni_modules/route-bestX/index.uts';
import { useTokenStore, useUserStore } from '@/src/store/index.uts';
import type { IUserInfo } from '@/src/store/index.uts';
import { initNativeMidButtonTap } from '@/src/tabbar/index.uts';
import { reportError } from '@/src/utils/report/index.uts';

/**
 * 已登录时静默刷新用户信息，确保服务端调整后的权限及时生效。
 * 失败时保留本地缓存，401 由 HTTP 拦截器统一清理登录态。
 */
function refreshUserInfoIfNeeded(): void {
  const tokenStore = useTokenStore();
  const userStore = useUserStore();
  if (!tokenStore.hasValidLogin()) {
    userStore.clearUserInfo();
    return;
  }
  // 模拟接口延迟返回最新用户信息
  setTimeout((): void => {
    // 延迟期间若已退出登录，不再回写模拟数据
    if (!tokenStore.hasValidLogin()) {
      return;
    }
    // 模拟接口未返回 permissions 的场景，保留登录后缓存的权限结果
    const nextPermissions = userStore.state.userInfo.permissions.length > 0
      ? userStore.state.userInfo.permissions
      : ['report:read', 'report:edit'];
    userStore.setUserInfo({
      userId: 1001,
      username: 'mock-user',
      nickname: '模拟刷新用户',
      avatar: '/static/logo.png',
      permissions: nextPermissions
    } as IUserInfo);
  }, 500);
}

onLaunch(() => {
  // 注册原生 TabBar 中间按钮监听（仅在原生模式且配置了 midButton 时生效）
  initNativeMidButtonTap();

  // 权限属于用户信息的一部分，登录态恢复后静默拉取一次最新结果
  refreshUserInfoIfNeeded();

  // #ifdef MP-WEIXIN
  // 微信小程序真机 @font-face 不生效，使用 uni.loadFontFace 加载 uni-icons 字体
  uni.loadFontFace({
    global: true,
    family: 'UniIconsFontFamily',
    source: 'url(\'/static/uniicons.ttf\')',
    success() {
      console.log('global loadFontFace uniicons.ttf success');
    },
    fail(error) {
      console.warn('global loadFontFace uniicons.ttf fail', error.errMsg);
    }
  });
  // #endif
});

onAppShow((options: any | null): void => {
  checkDirectEntry(options);
});

// 全局错误监听：仅可在 App.uvue 中生效
// onError 覆盖 Web / 小程序 / Android / iOS / 鸿蒙全平台（App 端 4.33+ 亦覆盖异步逻辑错误）
onError((error) => {
  reportError(error, 'App.onError');
});

// onUnhandledRejection 仅 Web 与小程序支持，App 原生端（Android / iOS / 鸿蒙）不支持，须条件编译隔离
// #ifdef WEB || MP
onUnhandledRejection((res) => {
  reportError(res.reason, 'App.onUnhandledRejection');
});
// #endif
</script>

<style lang="scss">
@import './src/style/index.scss';

/* #ifdef MP-WEIXIN */
/* 微信小程序真机：在全局 app.wxss 中注册字体，确保组件内可用 */
@import '@/uni_modules/uni-icons/components/uni-icons/uniicons_mp.css';
/* #endif */
/* #ifndef MP-WEIXIN */
@import './main.css';
/* #endif */

/* 阿里 iconfont（uni_modules/ali-iconfont）目前本项目没用到 —— 没有页面渲染 AliIconfontIcon。
   以后要用，只做一件事：在 onLaunch 里 import 并调用一次 setupIconfont()（无参）：

     import { setupIconfont } from '@/uni_modules/ali-iconfont/common/iconfont.uts';
     setupIconfont();

   漏掉这一步，组件查不到码点，图标会静默渲染成空白（不报错）。
   字体声明不写在这里 —— 它跟着 AliIconfontIcon 组件走：组件的 style 块里，由插件脚本从阿里 CSS
   生成（换图标 / 换库改插件的 iconfont.config.mjs 后跑 `pnpm icons`）。 */

page {
  --test-color: #006241;
  --color-test: #006241;
  --font-test: 'Issue 978', sans-serif;
  --font-sans: 'inter', 'inter Fallback', system-ui;
  --font-serif: ui-serif, Georgia, Cambria, 'Times New Roman', Times, serif;
  --font-mono: var(--font-plex-mono), monospace;
  --color-red-50: #fef2f2;
  --color-red-500: #fb2c36;
  --color-red-950: #460809;
  --color-orange-500: #fe6e00;
  --color-amber-500: #f99c00;
  --color-yellow-500: #edb200;
