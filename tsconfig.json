{
  "compilerOptions": {
    "target": "esnext",
    "jsx": "preserve",
    "lib": [
      "esnext",
      "dom"
    ],
    "baseUrl": ".",
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@img/*": [
        "./static/*"
      ]
    },
    "resolveJsonModule": true,
    "types": [
      "@dcloudio/types"
    ],
    "plugins": [
      {
        "name": "@vue/typescript-plugin",
        "languages": [
          "vue",
          "uvue",
          "uts"
        ]
      }
    ],
    "allowArbitraryExtensions": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "strict": true,
    "noImplicitThis": true,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true
  },
  "vueCompilerOptions": {
    "extensions": [
      ".vue",
      ".uvue",
      ".uts"
    ],
    "plugins": [
      "./.vscode/uts-volar-plugin/index.cjs"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.uts",
    "src/**/*.uvue",
    "src/**/*.vue",
    "*.uvue",
    "*.uts",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "unpackage",
    "dist",
    "uni_modules",
    ".hbuilderx",
    "uniCloud-alipay"
  ]
}
