{
  "name": "unibestx",
  "version": "1.0.0",
  "packageManager": "pnpm@10.6.1",
  "description": "unibestX - 最好的 uni-app X 开发框架",
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "node scripts/sync-hbuilderx.mjs --ensure && node scripts/dev-warmup.mjs web",
    "dev:mp-weixin": "node scripts/sync-hbuilderx.mjs --ensure && uni-launch mp-weixin",
    "dev:mp-alipay": "node scripts/sync-hbuilderx.mjs --ensure && uni-launch mp-alipay",
    "dev:web": "node scripts/sync-hbuilderx.mjs --ensure && node scripts/dev-warmup.mjs web",
    "dev:mock": "node scripts/sync-hbuilderx.mjs --ensure && VITE_USE_MOCK=true VITE_H5_USE_PROXY=true node scripts/dev-warmup.mjs web",
    "dev:vconsole": "node scripts/sync-hbuilderx.mjs --ensure && VITE_SHOW_VCONSOLE=true node scripts/dev-warmup.mjs web",
    "dev:app-android": "node scripts/sync-hbuilderx.mjs --ensure && uni-launch app-android",
    "dev:app-ios": "node scripts/sync-hbuilderx.mjs --ensure && uni-launch app-ios --iosTarget simulator",
    "dev:app-ios:device": "node scripts/sync-hbuilderx.mjs --ensure && uni-launch app-ios --iosTarget device",
    "dev:app-harmony": "node scripts/sync-hbuilderx.mjs --ensure && uni-launch app-harmony",
    "build:h5": "node scripts/sync-hbuilderx.mjs --ensure && node scripts/build-h5.mjs",
    "build:analyze": "node scripts/sync-hbuilderx.mjs --ensure && VISUALIZER=true node scripts/build-h5.mjs",
    "analyze": "VISUALIZER=true node scripts/build-h5.mjs",
    "env:test": "node scripts/switch-env.mjs test",
    "env:prod": "node scripts/switch-env.mjs prod",
    "build:test": "node scripts/sync-hbuilderx.mjs --ensure && node scripts/build-h5.mjs --env test",
    "build:prod": "node scripts/sync-hbuilderx.mjs --ensure && node scripts/build-h5.mjs --env prod",
    "optimize:img": "node scripts/optimize-images.mjs",
    "optimize:img:check": "node scripts/optimize-images.mjs --check",
    "docker:build:test": "pnpm build:test && docker compose build h5-test && pnpm docker:up:test",
    "docker:build:prod": "pnpm build:prod && docker compose build h5-prod && pnpm docker:up:prod",
    "docker:up:test": "docker compose up -d h5-test",
    "docker:up:prod": "docker compose up -d h5-prod",
    "docker:stop:test": "docker compose stop h5-test",
    "docker:stop:prod": "docker compose stop h5-prod",
    "docker:down:test": "docker compose rm -s -f h5-test",
    "docker:down:prod": "docker compose rm -s -f h5-prod",
    "docker:down": "docker compose down",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint:style": "stylelint \"src/**/*.{css,scss,vue,uvue}\" \"*.{css,scss,vue,uvue}\" --cache",
    "lint:style:fix": "stylelint \"src/**/*.{css,scss,vue,uvue}\" \"*.{css,scss,vue,uvue}\" --fix --cache",
    "lint:all": "pnpm lint && pnpm lint:style",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gen:uts-dts": "node scripts/gen-uts-dts.mjs",
    "check:uts-dts": "node scripts/gen-uts-dts.mjs --check",
    "sync:hbuilderx": "node scripts/sync-hbuilderx.mjs",
    "sync:hbuilderx:check": "node scripts/sync-hbuilderx.mjs --check",
    "sandbox:reset": "node scripts/reset-sandbox.mjs",
    "health": "node scripts/doctor.mjs",
    "health:quick": "node scripts/doctor.mjs --quick",
    "prepare": "husky"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020620260917001",
    "@dcloudio/uni-cli-shared": "3.0.0-5020620260917001",
    "@dcloudio/uni-components": "3.0.0-5020620260917001",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020620260917001",
    "crypto-js": "^4.2.0",
    "json5": "^2.2.3",
    "minimatch": "^10.2.5",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vite": "5.2.8",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@dcloudio/hbuilderx-cli": "^1.2.0",
    "@dcloudio/types": "^3.4.31",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/crypto-js": "^4.2.2",
    "@types/mockjs": "^1.0.10",
    "@uni-helper/eslint-config": "0.5.0",
    "@uni-helper/uni-app-types": "^1.0.1",
    "@vue/test-utils": "^2.5.1",
    "@vue/typescript-plugin": "3.3.11",
    "depcheck": "^1.4.7",
    "eslint": "^9.39.4",
    "eslint-plugin-format": "^1.5.0",
    "gh-pages": "^6.3.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "mockjs": "^1.1.0",
    "postcss-html": "^2.0.0",
    "rollup-plugin-visualizer": "^5.14.0",
    "sass": "^1.63.2",
    "sass-loader": "10.4.1",
    "sharp": "^0.35.5",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-config-standard-vue": "^2.0.0",
    "stylelint-order": "^8.1.1",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vconsole": "^3.15.1",
    "vite-plugin-build-info": "^0.1.2",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-mock": "^3.0.2",
    "vite-plugin-vconsole": "^2.1.1",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.9",
    "vue-tsc": "^3.3.11",
    "weapp-tailwindcss": "5.5.12"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current"
      ],
      "cpu": [
        "current",
        "x64"
      ]
    },
    "overrides": {
      "@intlify/core-base": "11.1.10",
      "@vue/compiler-core": "^3.5.13",
      "@vue/compiler-dom": "^3.5.13",
      "@vue/compiler-sfc": "^3.5.13",
      "@vue/reactivity": "^3.5.13",
      "@vue/runtime-core": "^3.5.13",
      "@vue/server-renderer": "^3.5.13",
      "@vue/shared": "^3.5.13",
      "vue": "^3.5.13"
    }
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,uts,vue,uvue,mjs,cjs,json,md}": [
      "eslint --fix"
    ],
    "**/*.{css,scss,vue,uvue}": [
      "stylelint --fix --allow-empty-input"
    ]
  }
}
