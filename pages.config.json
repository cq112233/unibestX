{
  "pages": [
    {
      "path": "src/pages/index/index",
      "customPageClass": "init-page",
      "customPageStyle": "background-color: transparent;",
      "name": "index",
      "type": "home",
      "layout": "navbar",
      "showBack": false,
      "hideStatusBar": false,
      "hideNavbar": false,
      "enablePullDownRefresh": true,
      "style": {
        "navigationBarTitleText": "首页",
        "navigationStyle": "custom",
        "mp-alipay": {
          "transparentTitle": "always",
          "titlePenetrate": "YES",
          "defaultTitle": ""
        }
      }
    },
    {
      "path": "src/pages/me/me",
      "layout": "navbar",
      "showBack": false,
      "enablePullDownRefresh": true,
      "hideStatusBar": false,
      "hideNavbar": false,
      "style": {
        "navigationBarTitleText": "tabbar.me",
        "navigationStyle": "custom",
        "mp-alipay": {
          "transparentTitle": "always",
          "titlePenetrate": "YES",
          "defaultTitle": ""
        }
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "uni-app x",
    "navigationBarBackgroundColor": "#ffffff",
    "backgroundColor": "#f8fafc",
    "backgroundColorContent": "#ffffff",
    "backgroundColorTop": "#f8fafc",
    "backgroundColorBottom": "#f8fafc",
    "backgroundTextStyle": "dark"
  },
  "easycom": {
    "autoscan": true,
    "custom": {
      "^TabbarMaskModal$": "@/src/components/TabbarMaskModal/TabbarMaskModal.uvue"
    }
  },
  "subPackages": [
    {
      "root": "src/sub",
      "pages": [
        {
          "path": "auth/login",
          "layout": "navbar",
          "showBack": true,
          "hideNavbar": false,
          "enablePullDownRefresh": false,
          "style": {
            "navigationBarTitleText": "登录",
            "navigationStyle": "custom",
            "mp-alipay": {
              "transparentTitle": "always",
              "titlePenetrate": "YES",
              "defaultTitle": ""
            }
          }
        }
      ]
    }
  ]
}
