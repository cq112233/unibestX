{
  "pages": [
    {
      "path": "src/pages/index/index",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "首页"
      },
      "layout": "default"
    },
    {
      "path": "src/pages/ai/ai",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "ai"
      },
      "layout": false
