        "navigationBarTitleText": "我的"
      },
      "layout": false
    },
    {
      "path": "uni_modules/rice-ui/pages/dialog/dialog",
      "style": {}
    },
    {
      "path": "uni_modules/rice-ui/pages/action-sheet/action-sheet",
      "style": {}
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "@navigationBarTextStyle",
    "navigationBarTitleText": "uni-app x",
    "navigationBarBackgroundColor": "@navigationBarBackgroundColor",
    "backgroundColor": "@backgroundColor",
    "backgroundColorContent": "@backgroundColorContent",
    "backgroundTextStyle": "@backgroundTextStyle"
  },
  "tabBar": {
    "custom": true,
    "color": "@tabBarColor",
    "selectedColor": "@tabBarSelectedColor",
    "backgroundColor": "@tabBarBackgroundColor",
    "borderStyle": "@tabBarBorderStyle",
    "list": [
      {
        "pagePath": "src/pages/index/index",
        "text": "首页"
      },
      {
        "pagePath": "src/pages/basic/basic",
        "text": "基础"
      },
      {
