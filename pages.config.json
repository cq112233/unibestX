{
  "pages": [
    {
      "path": "src/pages/index/index",
      "customPageClass": "init-page",
      "customPageStyle": "background-color: transparent;",
      "layout": "navbar",
      "showBack": false,
      "hideStatusBar": false,
      "hideNavbar": false,
      "enablePullDownRefresh": true,
      "style": {
        "navigationBarTitleText": "首页",
        "navigationStyle": "custom",
        "mp-alipay": {
          "transparentTitle": "always",
          "titlePenetrate": "YES",
          "defaultTitle": ""
        }
      }
    },
    {
      "path": "src/pages/me/me",
      "layout": "navbar",
      "showBack": false,
      "enablePullDownRefresh": true,
      "hideStatusBar": false,
      "hideNavbar": false,
      "style": {
        "navigationBarTitleText": "我的",
        "navigationStyle": "custom",
        "mp-alipay": {
          "transparentTitle": "always",
          "titlePenetrate": "YES",
          "defaultTitle": ""
        }
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "@navigationBarTextStyle",
    "navigationBarTitleText": "uni-app x",
    "navigationBarBackgroundColor": "@navigationBarBackgroundColor",
    "backgroundColor": "@backgroundColor",
    "backgroundColorContent": "@backgroundColorContent",
    "backgroundColorTop": "@backgroundColorTop",
    "backgroundColorBottom": "@backgroundColorBottom",
    "backgroundTextStyle": "@backgroundTextStyle"
  },
  "easycom": {
    "autoscan": true,
    "custom": {
      "^TabbarMaskModal$": "@/src/components/TabbarMaskModal/TabbarMaskModal.uvue"
    }
  },
  "subPackages": [
    {
      "root": "src/sub",
      "pages": [
        {
          "path": "auth/login",
          "layout": "navbar",
          "showBack": true,
          "hideNavbar": false,
          "enablePullDownRefresh": false,
          "style": {
            "navigationBarTitleText": "登录",
            "navigationStyle": "custom",
            "mp-alipay": {
              "transparentTitle": "always",
              "titlePenetrate": "YES",
              "defaultTitle": ""
            }
          }
        },
        {
          "path": "privacy/privacy",
          "customPageClass": "page-container",
          "customPageStyle": "background-color: transparent;",
          "layout": "navbar",
          "showBack": false,
          "hideStatusBar": false,
          "hideNavbar": false,
          "enablePullDownRefresh": false,
          "style": {
            "navigationBarTitleText": "隐私政策",
            "navigationStyle": "custom",
            "mp-alipay": {
              "transparentTitle": "always",
              "titlePenetrate": "YES",
              "defaultTitle": ""
            }
          }
        },
        {
          "path": "webview/webview",
          "customPageClass": "page-container",
          "customPageStyle": "background-color: transparent;",
          "showBack": false,
          "hideStatusBar": false,
          "hideNavbar": false,
          "enablePullDownRefresh": false,
          "style": {
            "navigationBarTitleText": "详情",
            "navigationStyle": "custom",
            "mp-alipay": {
              "transparentTitle": "always",
              "titlePenetrate": "YES",
              "defaultTitle": ""
            }
          }
        }
      ]
    }
  ]
}
