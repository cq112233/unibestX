# ==========================================
# 公用环境变量（所有环境都会加载）
# VITE_H5_USE_PROXY（H5 反向代理开关）为公用配置；
# VITE_ENV_TYPE / VITE_SERVER_BASEURL 等按环境拆分到：
#   .env.development（开发） / .env.test（测试） / .env.production（生产）
# ==========================================

# 应用名称（H5 标题等地方使用）
VITE_APP_TITLE=unibestX

# 应用版本号
VITE_APP_VERSION=1.0.0

# H5 是否开启反向代理（仅 H5 生效）：true=走代理（请求 /api），false=直连完整域名（默认）
# 该开关只影响 H5，App / 小程序始终直连 VITE_SERVER_BASEURL 完整域名，不受此开关影响
# 走代理时：开发配 vite.config.ts 的 server.proxy，生产配 deploy/nginx.conf 的 /api 反代
VITE_H5_USE_PROXY=false

# ==========================================
# 底部 Tabbar 策略模式（支持 4 种模式）
# 0: NO_TABBAR（无 tabbar）
# 1: NATIVE_TABBAR（原生 tabbar，pages.json 自动生成配置，带页面状态缓存，使用 uni.switchTab；⚠️ 原生 midButton 鼓包在小程序/鸿蒙端不支持）
# 2: CUSTOM_TABBAR_WITH_NATIVE（【推荐：带页面缓存】自定义 tabbar：pages.json custom:true 自动生成原生配置并隐藏，保留各 Tab 页面状态缓存，使用 uni.switchTab）
# 3: CUSTOM_TABBAR_WITHOUT_NATIVE（【不带缓存】纯自定义 tabbar：pages.json 无 tabBar 节点，使用 uni.redirectTo，每次切换重新加载页面）
# ==========================================
VITE_TABBAR_MODE=2

