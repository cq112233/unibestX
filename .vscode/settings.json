{
  "files.associations": {
    // *.uvue 关联为 "vue"，让 Volar 语言服务器处理
    // Volar 内部在 lang="uts" 时会 fallback 到 ts，从而支持 import 路径跳转
    "*.uvue": "vue",
    "*.uts": "typescript",
    "pages.json": "jsonc",
    "manifest.json": "jsonc"
  },

  // uni-app x: 启用 Volar 对 .uvue 文件的基本解析（如跳转定义），但在下面通过 [vue] block 禁用其模板类型报错
  "vue.server.additionalExtensions": [
    "uvue"
  ],

  // 启用 TS/JS 语法与未导入变量检查
  "typescript.validate.enable": true,
  "javascript.validate.enable": true,

  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "README.md": "index.html,favicon.ico,robots.txt,CHANGELOG.md",
    "docker.md": "Dockerfile,docker*.md,nginx*,.dockerignore",
    "pages.config.ts": "manifest.config.ts,openapi-ts-request.config.ts",
    "package.json": "tsconfig.json,pnpm-lock.yaml,pnpm-workspace.yaml,LICENSE,.gitattributes,.gitignore,.gitpod.yml,CNAME,.npmrc,.browserslistrc",
    "eslint.config.mjs": ".commitlintrc.*,.prettier*,.editorconfig,.commitlint.cjs,.eslint*"
  },

  "stylelint.enable": false,
  "css.validate": false,
  "scss.validate": false,
  "less.validate": false,

  "typescript.tsdk": "node_modules/typescript/lib",
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  // 加载 Volar 的 TypeScript 服务器插件，让其处理 .uvue 文件中 lang="uts" 的 import 跳转定义
  "typescript.tsserver.pluginPaths": [
    "/Users/chenqi/.antigravity-ide/extensions/vue.volar-3.3.10-universal/dist"
  ],
  "editor.tabSize": 2,
  "editor.detectIndentation": false,
  "editor.formatOnSave": true,
  "prettier.enable": false,
  "eslint.enable": true,
  "eslint.run": "onType",
  "editor.defaultFormatter": "dbaeumer.vscode-eslint",
  "eslint.format.enable": true,

  // Auto fix
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "never"
  },

  // Silent the stylistic rules in you IDE, but still auto fix them
  "eslint.rules.customizations": [
    { "rule": "style/*", "severity": "off", "fixable": true },
    { "rule": "format/*", "severity": "off", "fixable": true },
    { "rule": "*-indent", "severity": "off", "fixable": true },
    { "rule": "*-spacing", "severity": "off", "fixable": true },
    { "rule": "*-spaces", "severity": "off", "fixable": true },
    { "rule": "*-order", "severity": "off", "fixable": true },
    { "rule": "*-dangle", "severity": "off", "fixable": true },
    { "rule": "*-newline", "severity": "off", "fixable": true },
    { "rule": "*quotes", "severity": "off", "fixable": true },
    { "rule": "*semi", "severity": "off", "fixable": true }
  ],

  // Enable eslint for all supported languages
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "vue",
    "uvue",
    "html",
    "markdown",
    "json",
    "jsonc",
    "yaml",
    "toml",
    "xml",
    "gql",
    "graphql",
    "astro",
    "svelte",
    "css",
    "less",
    "scss",
    "pcss",
    "postcss"
  ],
  "[vue]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[uvue]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "i18n-ally.localesPaths": [
    "src/i18n/locales"
  ],
  "i18n-ally.pathMatcher": "{locale}.json",
  "i18n-ally.keystyle": "nested",
  "i18n-ally.sourceLanguage": "zh-CN",
  "i18n-ally.displayLanguage": "zh-CN",
  "i18n-ally.include": [
    "src/**/*.uvue",
    "src/**/*.uts",
    "src/**/*.vue",
    "src/**/*.ts",
    "src/**/*.js"
  ],
  "i18n-ally.enabledFrameworks": [
    "vue",
    "vue-sfc"
  ],
  "i18n-ally.enabledParsers": [
    "ts",
    "js",
    "json"
  ],
  "i18n-ally.parsers.extendFileExtensions": {
    "uts": "ts",
    "uvue": "vue"
  },
  "i18n-ally.parsers.typescript.compilerOptions": {
    "module": "commonjs",
    "allowJs": true,
    "target": "es2020",
    "moduleResolution": "node",
    "skipLibCheck": true,
    "strict": false
  },
  "[typescript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "cSpell.words": [
    "uvue",
    "uts",
    "UTS",
    "UTSJSONObject",
    "uniapp",
    "uniappx",
    "unibest",
    "unibestx",
    "dcloud",
    "dcloudio",
    "hbuilder",
    "hbuilderx",
    "HBuilderX",
    "easycom",
    "uniCloud",
    "nativeplugins",
    "vdom",
    "waterflow",
    "flowitem",
    "listview",
    "listitem",
    "stickyheader",
    "stickysection",
    "nestedscroll",
    "nestedscrollheader",
    "nestedscrollbody",
    "refreshbox",
    "refreshheader",
    "customrefresher",
    "refresherpulling",
    "refresherrefresh",
    "refresherrestore",
    "refresherenabled",
    "refreshertriggered",
    "refresherdefaultstyle",
    "tabbar",
    "definePage",
    "defineProps",
    "defineEmits",
    "defineExpose",
    "defineOptions",
    "defineSlots",
    "defineModel",
    "withDefaults",
    "onInit",
    "onLoad",
    "onShow",
    "onReady",
    "onHide",
    "onUnload",
    "onPullDownRefresh",
    "onReachBottom",
    "onBackPress",
    "OnBackPressOptions",
    "onPageScroll",
    "onResize",
    "onTabItemTap",
    "onNavigationBarButtonTap",
    "onNavigationBarSearchInputChanged",
    "onNavigationBarSearchInputConfirmed",
    "onNavigationBarSearchInputClicked",
    "onShareAppMessage",
    "onShareTimeline",
    "onAddToFavorites",
    "getCurrentPages",
    "getApp",
    "onMounted",
    "onUnmounted",
    "onBeforeMount",
    "onBeforeUnmount",
    "shallowRef",
    "shallowReactive",
    "toRef",
    "toRefs",
    "toValue",
    "customRef",
    "triggerRef",
    "uview",
    "zpaging",
    "unocss",
    "iconify",
    "dayuts",
    "irainna",
    "echarts",
    "subpackages",
    "volar",
    "vueuse",
    "antfu"
  ]
}
