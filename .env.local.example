# ==========================================
# 本地环境变量配置示例（复制本文件重命名为 .env.local 并填入你自己的密钥）
# ==========================================

# 1. Apifox 凭证
APIFOX_PROJECT_ID=
APIFOX_TOKEN=

# 2. DCloud / uni-app 应用唯一标识
VITE_DCLOUD_APPID=

# 3. uniCloud 空间密钥
VITE_UNICLOUD_SPACE_ID=
VITE_UNICLOUD_ACCESS_KEY=
VITE_UNICLOUD_SECRET_KEY=

# 4. 各大小程序 AppID
VITE_WX_APPID=
VITE_ALIPAY_APPID=

# 5. 鸿蒙（HarmonyOS）签名与证书配置（可选）
VITE_HARMONY_BUNDLE_NAME=
VITE_HARMONY_CERTPATH=
VITE_HARMONY_KEY_ALIAS=
VITE_HARMONY_KEY_PASSWORD=
VITE_HARMONY_PROFILE=
VITE_HARMONY_STORE_FILE=
VITE_HARMONY_STORE_PASSWORD=

