# ==========================================
# 本地环境变量配置示例（复制本文件重命名为 .env.local 并填入你自己的密钥）
# 本文件会提交到仓库，**只能放非敏感值**；密钥类字段请留在 .env.local（已被 .gitignore 忽略）
# ==========================================

# 1. Apifox 凭证
# 项目 ID 与 openapi-ts-request.config.ts 的默认值一致，可直接沿用
APIFOX_PROJECT_ID=
# Token 属于个人凭证，请到 Apifox「账号设置 → 访问令牌」自行生成后填入 .env.local
APIFOX_TOKEN=

# 2. DCloud / uni-app 应用唯一标识
VITE_DCLOUD_APPID=

# 3. uniCloud 空间
VITE_UNICLOUD_SPACE_ID=
# accessKey / secretKey 属于敏感凭证，请填入 .env.local，不要写进本示例文件
VITE_UNICLOUD_ACCESS_KEY=
VITE_UNICLOUD_SECRET_KEY=

# 4. 各大小程序 AppID
VITE_WX_APPID=
VITE_ALIPAY_APPID=

# 5. 鸿蒙（HarmonyOS）签名与证书配置（可选）
VITE_HARMONY_BUNDLE_NAME=
VITE_HARMONY_CERTPATH=
VITE_HARMONY_KEY_ALIAS=
# 以下三项属于敏感凭证，请填入 .env.local，不要写进本示例文件
VITE_HARMONY_KEY_PASSWORD=
VITE_HARMONY_PROFILE=
VITE_HARMONY_STORE_FILE=
VITE_HARMONY_STORE_PASSWORD=

