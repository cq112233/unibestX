<template>
  <!-- 应用全局骨架与皮肤容器，通过 CSS 变量绑定响应式主题色 / 暗黑模式 -->
  <view class="root-container flex flex-col flex-1" style="flex: 1;" :class="{ dark: appStore.state.isDark }" :style="themeStyle">
    <!-- 页面内容滚动容器 -->
    <scroll-view direction="vertical" class="flex-1" style="flex: 1;">
      <slot></slot>
    </scroll-view>
    <!-- 自定义 TabBar：根据 config.uts 中的 type 配置切换形态（胶囊或标准底座） -->
    <template v-if="customTabbarEnable && isCurrentPageTabbar">
      <!-- 悬浮胶囊风格 (type: 'capsule') -->
      <CustomCapsuleTabbar v-if="isCapsuleTabbar" />
      <!-- 标准底座风格 (type: 'default') -->
      <Tabbar v-else />
    </template>
  </view>
</template>

<script setup lang="uts">
import Tabbar from '@/src/tabbar/index.uvue';
import CustomCapsuleTabbar from '@/src/tabbar/custom/index.uvue';
import { customTabbarEnable, isCapsuleTabbar, isPageTabbar, syncCurIdxByCurrentPage } from '@/src/tabbar/helper';
import { useAppStore } from '@/src/store';
import { applyNavbarTheme, getThemeTokens } from '@/src/utils/theme';
import { computed, onMounted, ref, watch } from 'vue';

// 激活应用状态管理 Store
const appStore = useAppStore();

// 主题样式变量：亮 / 暗两套，跟随 appStore.state.isDark 响应式切换
const themeStyle = computed((): UTSJSONObject => {
  const dark = appStore.state.isDark;
  return {
    '--theme-color': appStore.state.theme,
    '--bg-color': getThemeTokens(dark).bgContent,
    '--text-color': dark ? '#e2e8f0' : '#1e293b',
    '--text-secondary': dark ? '#94a3b8' : '#64748b',
    '--card-bg': dark ? '#1e293b' : '#ffffff',
    '--border-color': dark ? '#334155' : '#e2e8f0'
  } as UTSJSONObject;
});

// 控制当前页面是否需要显示底部导航栏
const isCurrentPageTabbar = ref(false);

// 组件挂载时：同步 H5 / 小程序原生导航栏主题与路由状态
onMounted(() => {
  applyNavbarTheme(appStore.state.isDark);
  try {
    const pages = getCurrentPages();
    if (pages.length > 0) {
      const route = pages[pages.length - 1].route;
      if (route != null && route.length > 0) {
        const path = route.startsWith('/') ? route : `/${route}`;
        const isTabbar = isPageTabbar(path);
        isCurrentPageTabbar.value = isTabbar;
        if (isTabbar) {
          syncCurIdxByCurrentPage();
        }
      }
    }
  }
  catch {}
});

// 主题模式 / 系统深浅色变化时，当前页面不切换也实时同步导航栏
watch((): boolean => appStore.state.isDark, (newVal: boolean) => {
  applyNavbarTheme(newVal);
});
</script>

<style lang="scss" scoped>
.root-container {
  background-color: var(--bg-color, #f5f6fa);
}
</style>
