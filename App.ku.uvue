<template>
  <!-- 应用全局骨架与皮肤容器，通过 CSS 变量绑定响应式主题色 / 暗黑模式 -->
  <view class="root-container flex flex-col flex-1" style="flex: 1; display: flex; flex-direction: column;"
    :class="{ dark: appStore.state.isDark }" :style="themeStyle">
    <!-- 页面内容滚动容器 -->
    <scroll-view direction="vertical" class="flex-1" style="flex: 1;">
      <slot></slot>
    </scroll-view>
    <!-- 自定义 TabBar：根据 config.uts 中的 type 配置切换形态（胶囊或标准底座） -->
    <template v-if="customTabbarEnable && isCurrentPageTabbar">
      <!-- 悬浮胶囊风格 (type: 'capsule') -->
      <CustomCapsuleTabbar v-if="isCapsuleTabbar" />
      <!-- 标准底座风格 (type: 'default') -->
      <Tabbar v-else />
    </template>
  </view>
</template>

<script setup lang="uts">
import Tabbar from '@/src/tabbar/index.uvue';
import CustomCapsuleTabbar from '@/src/tabbar/custom/index.uvue';
import { customTabbarEnable, isCapsuleTabbar, isPageTabbar, syncCurIdxByCurrentPage } from '@/src/tabbar/helper';
import { useAppStore } from '@/src/store';
import { applyNavbarTheme, getThemeTokens } from '@/src/utils/theme';
import { computed, nextTick, onMounted, onUnmounted, ref, watch } from 'vue';
import { updateAvailableHeight } from '@/src/utils/systemInfo.uts';
import { selectedTabbarStrategy } from '@/src/tabbar/helper/index.uts';
import { registerToast, unregisterToast } from '@/src/utils/toast';
import type { ComponentPublicInstance } from 'vue';

/**
 * 页面参数 Props：由 autoRootPlugin 编译时从 pages.json 提取（与 LayoutComponent 同一套、全量注入），
 * 每页一个 AppKu 实例，各自拿到自己页面的参数，供挂载阶段按页面做可用高度等计算。
 * 注：layout 也随页面注入（default 布局不扣状态栏/导航栏）；type/debug 等 definePage 私有键不会写入 pages.json，收不到。
 */
const props = defineProps({
  /** 是否显示左侧返回按钮（默认 true） */
  showBack: {
    type: Boolean,
    default: true
  },
  /** 是否隐藏导航栏（默认 false） */
  hideNavbar: {
    type: Boolean,
    default: false
  },
  /** 页面布局模板标识（非 navbar 布局按无导航处理，参与可用高度计算时不扣状态栏/导航栏） */
  layout: {
    type: String,
    default: ''
  },
  /** 是否启用内容区域的自定义下拉刷新 */
  enablePullDownRefresh: {
    type: Boolean,
    default: false
  },
  /** 页面根容器自定义类名（页面 customPageClass） */
  customPageClass: {
    type: String,
    default: ''
  },
  /** 页面根容器自定义行内样式（页面 customPageStyle） */
  customPageStyle: {
    type: String,
    default: ''
  },
  /** 页面 style 完整配置对象（未拍平：navigationStyle / navigationBarTitleText / navigationBarBackgroundColor 等） */
  pageStyle: {
    type: Object,
    default: () => ({})
  }
});

// 激活应用状态管理 Store
const appStore = useAppStore();

/**
 * 获取 pageStyle 对象
 */
const pageStyleObj = computed((): UTSJSONObject => {
  return (props.pageStyle ?? {}) as UTSJSONObject;
});

// 主题样式变量：亮 / 暗两套，跟随 appStore.state.isDark 响应式切换
const themeStyle = computed((): UTSJSONObject => {
  const dark = appStore.state.isDark;
  return {
    '--theme-color': appStore.state.theme,
    '--bg-color': getThemeTokens(dark).bgContent,
    '--text-color': dark ? '#e2e8f0' : '#1e293b',
    '--text-secondary': dark ? '#94a3b8' : '#64748b',
    '--card-bg': dark ? '#1e293b' : '#ffffff',
    '--border-color': dark ? '#334155' : '#e2e8f0'
  } as UTSJSONObject;
});

// 控制当前页面是否需要显示底部导航栏
const isCurrentPageTabbar = ref(false);
// 挂载全局 Toast 组件的 DOM/组件实例引用
const uToastRef = ref<ComponentPublicInstance | null>(null);

// 监听 uToastRef 变化，第一时间注册到全局 Toast 栈
watch(uToastRef, (val: ComponentPublicInstance | null) => {
  if (val != null) {
    registerToast(val!);
  }
}, { immediate: true });

// 组件挂载时：同步 H5 / 小程序原生导航栏主题与路由状态
onMounted(() => {
  applyNavbarTheme(appStore.state.isDark);
  try {
    const pages = getCurrentPages();
    if (pages.length > 0) {
      const route = pages[pages.length - 1].route;
      if (route != null && route.length > 0) {
        const path = route.startsWith('/') ? route : `/${route}`;
        const isTabbar = isPageTabbar(path);
        isCurrentPageTabbar.value = isTabbar;
        if (isTabbar) {
          syncCurIdxByCurrentPage();
        }
      }
    }
  }
  catch (_e) {
    // 捕获异常
  }
  if (uToastRef.value != null) {
    registerToast(uToastRef.value!);
  }
});

// 组件挂载钩子：注册全局 Toast
onMounted(() => {
  if (uToastRef.value != null) {
    registerToast(uToastRef.value!);
  }
  nextTick(() => {
    if (uToastRef.value != null) {
      registerToast(uToastRef.value!);
    }
  });
});

// 组件销毁钩子：反注册 Toast 以释放内存防内存泄漏
onUnmounted(() => {
  if (uToastRef.value != null) {
    unregisterToast(uToastRef.value!);
  }
});

// 每个页面切换都会触发：同步 H5 / 小程序原生导航栏主题
onShow(() => {
  if (uToastRef.value != null) {
    registerToast(uToastRef.value!);
  }
  applyNavbarTheme(appStore.state.isDark);
});

// 主题模式 / 系统深浅色变化时，当前页面不切换也实时同步导航栏
watch((): boolean => appStore.state.isDark, (newVal: boolean) => {
  applyNavbarTheme(newVal);
});

const isCustomNav = computed((): boolean => {
  const textStyleFromStyle = (pageStyleObj.value.navigationStyle as string | null) ?? '';
  if (textStyleFromStyle.length > 0) {
    if (textStyleFromStyle == 'custom') {
      return true;
    }
    else {
      return false;
    }
  }
  else {
    return false;
  }
});

onShow(() => {
  console.log('AppKu:onShow');
  // defineProps 生成的 props 类型（GenAppku）不能直接赋给 AppKuHeightProps 接口，按字段组装字面量传入
  // #ifdef MP-WEIXIN
  setTimeout(() => {
    updateAvailableHeight({
      hideNavbar: props.hideNavbar,
      pageStyle: (props.pageStyle ?? {}) as UTSJSONObject,
      layout: props.layout
    }, selectedTabbarStrategy);
  }, 150);
  // #endif
  // #ifndef MP-WEIXIN
  setTimeout(() => {
    updateAvailableHeight({
      hideNavbar: props.hideNavbar,
      pageStyle: (props.pageStyle ?? {}) as UTSJSONObject,
      layout: props.layout
    }, selectedTabbarStrategy);
  }, 150);
  // #endif
});
</script>

<style lang="scss" scoped>
.root-container {
  background-color: var(--bg-color, #f5f6fa);
}
</style>
