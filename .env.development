# ==========================================
# 开发环境配置（HBuilderX 运行 / pnpm dev:* 时自动加载）
# ==========================================
VITE_ENV_TYPE=development

# 环境中文名称（EnvCard 等界面展示）
VITE_ENV_NAME=开发环境

# 接口地址（两个不同服务器 API 示例；H5 直连、App / 小程序 均读取此值）
VITE_SERVER_BASEURL=https://nx1cf4m0do.sealoshzh.site
VITE_SERVER_BASEURL_SECONDARY=https://nx1cf4m0do.sealoshzh.site

# OSS 上传接口配置
VITE_UPLOAD_BASEURL=https://xxx.com
VITE_UPLOAD_PATH=/gateway/user/sys/oss/upload/xxx
