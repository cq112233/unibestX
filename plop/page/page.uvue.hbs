<script setup lang="uts">
import { ref } from 'vue';
import { useRoute, useRouter } from '@/uni_modules/route-bestX/index.uts';
{{#if needApi}}
import { fetch{{ pascalCase name }}ListApi } from '@/src/api/{{ module }}/{{ camelCase name }}.uts';
import type { {{ pascalCase name }}Item } from '@/src/api/{{ module }}/{{ camelCase name }}.uts';
{{/if}}

/**
 * 页面契约配置（按 unibestX 分册 4 规范显式声明所有基础项）
 */
definePage({
  name: '{{ camelCase name }}',
  debug: false,
  debugHome: false,
  layout: 'navbar',
  showBack: true,
  hideStatusBar: false,
  hideNavbar: false,
  enablePullDownRefresh: false,
  style: {
    navigationBarTitleText: '{{ title }}',
    navigationStyle: 'custom'
  }
});

/** 当前路由快照 */
const route = useRoute();
/** 路由控制器 */
const router = useRouter();

{{#if needApi}}
/** 列表数据 */
const list = ref<Array<{{ pascalCase name }}Item>>([]);
/** 加载状态 */
const loading = ref<boolean>(false);

/** 加载数据 */
function loadData(): void {
  loading.value = true;
  fetch{{ pascalCase name }}ListApi(1, 20)
    .then((res) => {
      list.value = res.list;
    })
    .finally(() => {
      loading.value = false;
    });
}

loadData();
{{/if}}
</script>

