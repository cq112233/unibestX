import { computed, ref } from 'vue';
import { useQuery } from '@/uni_modules/request-bestX/index.uts';
import type { QueryFunctionContext, QueryOptions } from '@/uni_modules/request-bestX/index.uts';

/**
 * {{ description }} 结果项契约（一律使用 type，禁止 interface）
 */
export type {{ pascalCase entityName }}Item = {
  id: string;
  title: string;
  description: string;
};

/**
 * 分页容器契约
 */
export type {{ pascalCase entityName }}PageResult = {
  list: Array<{{ pascalCase entityName }}Item>;
  total: number;
  hasMore: boolean;
};

/**
 * {{ description }} Hook（遵循 Query 词根语义化，基于 useQuery 自动状态/缓存）
 */
export function {{ hookName }}() {
  const pageNo = ref<number>(1);
  const pageSize = ref<number>(10);
  const keyword = ref<string>('');

  const {
    data,
    isPending,
    isError,
    refetch
  } = useQuery<{{ pascalCase entityName }}PageResult>({
    queryKey: ['{{ camelCase entityName }}', 'list', pageNo, pageSize, keyword],
    queryFn: (_ctx: QueryFunctionContext): Promise<{{ pascalCase entityName }}PageResult> => {
      // TODO: 替换为实际业务 API 函数，如 fetch{{ pascalCase entityName }}ListApi(pageNo.value, pageSize.value, keyword.value)
      const mockList: Array<{{ pascalCase entityName }}Item> = [
        { id: '1', title: '示例数据 1', description: '这是通过 {{ hookName }} 获取的数据' },
        { id: '2', title: '示例数据 2', description: '这是通过 {{ hookName }} 获取的数据' }
      ];
      return Promise.resolve({
        list: mockList,
        total: mockList.length,
        hasMore: false
      } as {{ pascalCase entityName }}PageResult);
    }
  } as QueryOptions<{{ pascalCase entityName }}PageResult>);

  const list = computed<Array<{{ pascalCase entityName }}Item>>((): Array<{{ pascalCase entityName }}Item> => {
    const res = data.value;
    return res != null ? res.list : ([] as Array<{{ pascalCase entityName }}Item>);
  });

  function search(kw: string): void {
    pageNo.value = 1;
    keyword.value = kw;
  }

  function reset(): void {
    pageNo.value = 1;
    keyword.value = '';
  }

  return {
    pageNo,
    pageSize,
    keyword,
    list,
    loading: isPending,
    isError,
    search,
    reset,
    refetch
  };
}
