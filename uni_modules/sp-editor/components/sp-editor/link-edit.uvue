<template>
  <view class="link-edit-container" v-if="showPopup">
    <view class="link-edit">
      <view class="title"><text>添加链接</text></view>
      <view class="edit">
        <view class="description">
          <text>链接描述：</text>
          <input v-model="descVal" type="text" class="input" placeholder="请输入链接描述" />
        </view>
        <view class="address">
          <text>链接地址：</text>
          <input v-model="addrVal" type="text" class="input" placeholder="请输入链接地址" />
        </view>
      </view>
      <view class="control">
        <view class="cancel" @click="close"><text class="cancel-text">取消</text></view>
        <view class="confirm" @click="onConfirm"><text class="confirm-text">确认</text></view>
      </view>
    </view>
    <view class="mask"></view>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'

defineOptions({
  name: 'link-edit'
})

const emit = defineEmits(['open', 'close', 'confirm'])

const showPopup = ref<boolean>(false)
const descVal = ref<string>('')
const addrVal = ref<string>('')

function open() {
  showPopup.value = true
  emit('open')
}

function close() {
  showPopup.value = false
  descVal.value = ''
  addrVal.value = ''
  emit('close')
}

function onConfirm() {
  if (descVal.value == '') {
    uni.showToast({
      title: '请输入链接描述',
      icon: 'none'
    })
    return
  }
  if (addrVal.value == '') {
    uni.showToast({
      title: '请输入链接地址',
      icon: 'none'
    })
    return
  }
  emit('confirm', {
    text: descVal.value,
    href: addrVal.value
  } as UTSJSONObject)
  close()
}

defineExpose({
  open,
  close
})
</script>

<style lang="scss">
.link-edit-container {
  .link-edit {
    width: 80%;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background-color: #ffffff;
    box-shadow: -2px -2px 4px rgba(0, 0, 0, 0.05), 2px 2px 4px rgba(0, 0, 0, 0.05);
    border-radius: 12rpx;
    box-sizing: border-box;
    z-index: 999;
    font-size: 14px;

    .title {
      height: 80rpx;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .edit {
      padding: 24rpx;
      border-top: 1px solid #eeeeee;
      border-bottom: 1px solid #eeeeee;
      box-sizing: border-box;

      .input {
        flex: 1;
        padding: 4px;
        font-size: 14px;
        border: 1px solid #eeeeee;
        border-radius: 8rpx;
      }

      .description {
        display: flex;
        flex-direction: row;
        align-items: center;
      }
      .address {
        display: flex;
        flex-direction: row;
        align-items: center;
        margin-top: 24rpx;
      }
    }

    .control {
      height: 80rpx;
      display: flex;
      flex-direction: row;

      .cancel {
        flex: 1;
        display: flex;
        justify-content: center;
        align-items: center;
      }
      .cancel-text {
        color: #dd524d;
      }
      .confirm {
        border-left: 1px solid #eeeeee;
        flex: 1;
        display: flex;
        justify-content: center;
        align-items: center;
      }
      .confirm-text {
        color: #007aff;
      }
    }
  }
  .mask {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.05);
    z-index: 998;
  }
}
</style>
