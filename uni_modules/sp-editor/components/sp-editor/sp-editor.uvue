<script setup lang="uts">
import { ref, watch, getCurrentInstance } from 'vue'
import ColorPicker from './color-picker.uvue'
import LinkEdit from './link-edit.uvue'
import FabTool from './fab-tool.uvue'
import { addLink, linkFlag, getIconCharacter } from '../../utils/index.uts'

type RgbColor = {
  r: number,
  g: number,
  b: number,
  a: number
}

defineOptions({
	name: 'sp-editor'
})

const props = defineProps({
	editorId: {
		type: String,
		default: 'editor'
	},
	placeholder: {
		type: String,
		default: '写点什么吧 ~'
	},
	readOnly: {
		type: Boolean,
		default: false
	},
	maxlength: {
		type: Number,
		default: -1
	},
	toolbarConfig: {
		type: Object as PropType<UTSJSONObject>,
		default: (): UTSJSONObject => {
			return {
				keys: [] as Array<string>,
				excludeKeys: [] as Array<string>,
				iconSize: '18px',
				iconColumns: 10
			} as UTSJSONObject
		}
	}
})

const emit = defineEmits(['init', 'confirm', 'input', 'overMax', 'exportHtml', 'addLink', 'upinImage', 'upinVideo'])
const instance = getCurrentInstance()

const formats = ref<UTSJSONObject>({} as UTSJSONObject)
const curFab = ref<string>('')
const textColor = ref<string>('')
const backgroundColor = ref<string>('')
const curColor = ref<string>('')
const defaultColor = ref<RgbColor>({ r: 0, g: 0, b: 0, a: 1 } as RgbColor)
const iconSize = ref<string>('20px')
const iconColumns = ref<number>(10)
const toolbarList = ref<Array<string>>([] as Array<string>)

const colorPickerRef = ref<any | null>(null)
const linkEditRef = ref<any | null>(null)
let editorCtx: any | null = null

const toolbarAllList = [
	'header',
	'H1',
	'H2',
	'H3',
	'H4',
	'H5',
	'H6',
	'bold',
	'italic',
	'underline',
	'strike',
	'align',
	'alignLeft',
	'alignCenter',
	'alignRight',
	'alignJustify',
	'lineHeight',
	'letterSpacing',
	'marginTop',
	'marginBottom',
	'fontFamily',
	'fontSize',
	'color',
	'backgroundColor',
	'date',
	'listCheck',
	'listOrdered',
	'listBullet',
	'indentInc',
	'indentDec',
	'divider',
	'scriptSub',
	'scriptSuper',
	'direction',
	'image',
	'video',
	'link',
	'undo',
	'redo',
	'removeFormat',
	'clear',
	'export'
] as Array<string>

const fabTools = {
	header: [
		{ title: '一级标题', name: 'H1', value: 1, icon: 'icon-format-header-1' },
		{ title: '二级标题', name: 'H2', value: 2, icon: 'icon-format-header-2' },
		{ title: '三级标题', name: 'H3', value: 3, icon: 'icon-format-header-3' },
		{ title: '四级标题', name: 'H4', value: 4, icon: 'icon-format-header-4' },
		{ title: '五级标题', name: 'H5', value: 5, icon: 'icon-format-header-5' },
		{ title: '六级标题', name: 'H6', value: 6, icon: 'icon-format-header-6' }
	],
	fontFamily: [
		{ title: '宋体', name: '宋', value: '宋体', icon: '' },
		{ title: '黑体', name: '黑', value: '黑体', icon: '' },
		{ title: '楷体', name: '楷', value: '楷体', icon: '' },
		{ title: '仿宋', name: '仿', value: '仿宋', icon: '' },
		{ title: '华文隶书', name: '隶', value: 'STLiti', icon: '' },
		{ title: '华文行楷', name: '行', value: 'STXingkai', icon: '' },
		{ title: '幼圆', name: '圆', value: 'YouYuan', icon: '' }
	],
	fontSize: [
		{ title: '12', name: '12', value: '12px', icon: '' },
		{ title: '14', name: '14', value: '14px', icon: '' },
		{ title: '16', name: '16', value: '16px', icon: '' },
		{ title: '18', name: '18', value: '18px', icon: '' },
		{ title: '20', name: '20', value: '20px', icon: '' },
		{ title: '22', name: '22', value: '22px', icon: '' },
		{ title: '24', name: '24', value: '24px', icon: '' }
	],
	align: [
		{ title: '左对齐', name: 'alignLeft', value: 'left', icon: 'icon-zuoduiqi' },
		{ title: '居中对齐', name: 'alignCenter', value: 'center', icon: 'icon-juzhongduiqi' },
		{ title: '右对齐', name: 'alignRight', value: 'right', icon: 'icon-youduiqi' },
		{ title: '两端对齐', name: 'alignJustify', value: 'justify', icon: 'icon-zuoyouduiqi' }
	],
	lineHeight: [
		{ title: '1倍', name: '1', value: '1', icon: '' },
		{ title: '1.5倍', name: '1.5', value: '1.5', icon: '' },
		{ title: '2倍', name: '2', value: '2', icon: '' },
		{ title: '2.5倍', name: '2.5', value: '2.5', icon: '' },
		{ title: '3倍', name: '3', value: '3', icon: '' }
	],
	space: [
		{ title: '0.5倍', name: '0.5', value: '0.5em', icon: '' },
		{ title: '1倍', name: '1', value: '1em', icon: '' },
		{ title: '1.5倍', name: '1.5', value: '1.5em', icon: '' },
		{ title: '2倍', name: '2', value: '2em', icon: '' },
		{ title: '2.5倍', name: '2.5', value: '2.5em', icon: '' },
		{ title: '3倍', name: '3', value: '3em', icon: '' }
	]
} as UTSJSONObject

function onEditorReady() {
	uni.createSelectorQuery()
		.in(instance?.proxy)
		.select('#' + props.editorId)
		.context((res) => {
			if (res != null) {
				editorCtx = res.context
				emit('init', editorCtx, props.editorId)
			}
		})
		.exec()
}

function undo() {
	if (editorCtx != null) {
		editorCtx.undo()
	}
}

function redo() {
	if (editorCtx != null) {
		editorCtx.redo()
	}
}

function showPicker() {
	const picker = colorPickerRef.value as any | null
	if (picker == null) return

	if (curColor.value == 'color') {
		defaultColor.value = textColor.value != ''
			? picker.hex2Rgb(textColor.value)
			: ({ r: 0, g: 0, b: 0, a: 1 } as RgbColor)
	} else if (curColor.value == 'backgroundColor') {
		defaultColor.value = backgroundColor.value != ''
			? picker.hex2Rgb(backgroundColor.value)
			: ({ r: 0, g: 0, b: 0, a: 0 } as RgbColor)
	}
	picker.open()
}

function formatIcon(name: string, value: any) {
	if (editorCtx == null) return
	if (name == 'color' || name == 'backgroundColor') {
		curColor.value = name
		showPicker()
	} else {
		editorCtx.format(name, value)
	}
}

function fabTap(fabType: string) {
	if (curFab.value != fabType) {
		curFab.value = fabType
	} else {
		curFab.value = ''
	}
}

function formatFabSub(name: string, value: any) {
	formatIcon(name, value)
	fabTap(name)
}

function confirmColor(e: UTSJSONObject) {
	const hex = e['hex'] as string
	if (curColor.value == 'color') {
		textColor.value = hex
		if (editorCtx != null) {
			editorCtx.format('color', textColor.value)
		}
	} else if (curColor.value == 'backgroundColor') {
		backgroundColor.value = hex
		if (editorCtx != null) {
			editorCtx.format('backgroundColor', backgroundColor.value)
		}
	}
}

function onStatusChange(e: any) {
	const detail = e.detail as UTSJSONObject
	const color = detail['color'] as string | null
	const bg = detail['backgroundColor'] as string | null
	if (color != null) {
		textColor.value = color
	}
	if (bg != null) {
		backgroundColor.value = bg
	}
	formats.value = detail
}

function insertDivider() {
	if (editorCtx != null) {
		editorCtx.insertDivider()
	}
}

function clear() {
	uni.showModal({
		title: '清空编辑器',
		content: '确定清空编辑器吗？',
		success: (res) => {
			if (res.confirm && editorCtx != null) {
				editorCtx.clear()
			}
		}
	})
}

function removeFormat() {
	uni.showModal({
		title: '文本格式化',
		content: '确定要清除所选择部分文本块格式吗？',
		showCancel: true,
		success: (res) => {
			if (res.confirm && editorCtx != null) {
				editorCtx.removeFormat()
			}
		}
	})
}

function insertDate() {
	const date = new Date()
	const formatDate = date.getFullYear().toString() + '/' + (date.getMonth() + 1).toString() + '/' + date.getDate().toString()
	if (editorCtx != null) {
		editorCtx.insertText({ text: formatDate })
	}
}

function insertLink() {
	const linkEdit = linkEditRef.value as any | null
	if (linkEdit != null) {
		linkEdit.open()
	}
}

function confirmLink(e: UTSJSONObject) {
	const linkEdit = linkEditRef.value as any | null
	if (linkEdit != null) {
		linkEdit.close()
	}
	addLink(editorCtx, e, () => {
		if (editorCtx != null) {
			editorCtx.getContents({
				success: (res: any) => {
					const resObj = res as UTSJSONObject
					const html = resObj['html'] as string
					const text = resObj['text'] as string
					emit('input', { html: html, text: text } as UTSJSONObject, props.editorId)
				}
			})
		}
	})
	emit('addLink', e, props.editorId)
}

function insertImage() {
	uni.chooseImage({
		success: (res) => {
			const tempFiles = res.tempFiles
			emit('upinImage', tempFiles, editorCtx, props.editorId)
		},
		fail: () => {
			uni.showToast({
				title: '未授权访问相册权限，请授权后使用',
				icon: 'none'
			})
		}
	})
}

function insertVideo() {
	uni.chooseVideo({
		sourceType: ['camera', 'album'],
		success: (res) => {
			const tempFilePath = res.tempFilePath
			emit('upinVideo', tempFilePath, editorCtx, props.editorId)
		},
		fail: () => {
			uni.showToast({
				title: '未授权访问媒体权限，请授权后使用',
				icon: 'none'
			})
		}
	})
}

function onEditorInput(e: any) {
	const detail = e.detail as UTSJSONObject
	const html = detail['html'] as string
	const text = detail['text'] as string
	if (text.indexOf(linkFlag) != -1) return

	const maxlen = parseInt(props.maxlength.toString())
	const textStr = text.replace(/[ \t\r\n]/g, '')
	if (textStr.length > maxlen && maxlen != -1) {
		uni.showModal({
			content: '超过' + maxlen.toString() + '字数啦~',
			confirmText: '确定',
			showCancel: false,
			success: () => {
				emit('overMax', { html, text } as UTSJSONObject, props.editorId)
			}
		})
	} else {
		emit('input', { html, text } as UTSJSONObject, props.editorId)
	}
}

function exportHtml() {
	if (editorCtx != null) {
		editorCtx.getContents({
			success: (res: any) => {
				const resObj = res as UTSJSONObject
				const html = resObj['html'] as string
				emit('exportHtml', html, props.editorId)
			}
		})
	}
}

function eLongpress() {}

watch(() => props.toolbarConfig, (newToolbar: UTSJSONObject) => {
	const keys = newToolbar['keys'] as Array<string> | null
	const excludeKeys = newToolbar['excludeKeys'] as Array<string> | null
	const iSize = newToolbar['iconSize'] as string | null
	const iColumns = newToolbar['iconColumns'] as number | null

	if (keys != null && keys.length > 0) {
		toolbarList.value = keys
	} else {
		if (excludeKeys != null && excludeKeys.length > 0) {
			toolbarList.value = toolbarAllList.filter((item: string): boolean => !excludeKeys.includes(item))
		} else {
			toolbarList.value = toolbarAllList
		}
	}
	iconSize.value = iSize != null ? iSize : '18px'
	iconColumns.value = iColumns != null ? iColumns : 10
}, { deep: true, immediate: true })

defineExpose({
	undo,
	redo,
	exportHtml,
	clear,
	removeFormat
})
</script>

<style lang="scss">
@import '@/uni_modules/sp-editor/icons/editor-icon.css';
@import '@/uni_modules/sp-editor/icons/custom-icon.css';

.sp-editor {
	height: 100%;
	display: flex;
	flex-direction: column;
	position: relative;
}

.sp-editor-toolbar {
	box-sizing: border-box;
	padding: calc(var(--icon-size) / 4) 0;
	border-bottom: 1px solid #e4e4e4;
	font-family: 'Helvetica Neue', 'Helvetica', 'Arial', sans-serif;
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
}

.toolbar-item {
	display: flex;
	align-items: center;
	justify-content: center;
	height: calc(var(--icon-size) * 1.8);
	cursor: pointer;
}

.sp-editor-icon {
	font-family: sp-editor-icon !important;
	font-style: normal;
	font-size: var(--icon-size);
	line-height: calc(var(--icon-size) * 1.8);
}

.sp-custom-icon {
	font-family: sp-custom-icon !important;
	font-style: normal;
	font-size: var(--icon-size);
	line-height: calc(var(--icon-size) * 1.8);
}

.sp-editor-wrapper {
	flex: 1;
	overflow: hidden;
	position: relative;
}

.editor-container {
	padding: 8rpx 16rpx;
	box-sizing: border-box;
	width: 100%;
	height: 100%;
	font-size: 16px;
	line-height: 1.5;
}

.ql-image-overlay-none {
	::v-deep .ql-image-overlay {
		pointer-events: none;
		opacity: 0;
	}
}

::v-deep .ql-editor.ql-blank::before {
	font-style: normal;
	color: #cccccc;
}

::v-deep .ql-container {
	min-height: unset;
}

.ql-active {
	color: #66ccff;
}

.fab-tools {
	display: flex;
	padding: 0 10rpx;
	box-sizing: border-box;
}

.fab-sub-item {
	width: auto;
	height: auto;
	margin: 10rpx;
	display: flex;
	align-items: center;
	justify-content: center;
}
</style>
