				:id="editorId"
				class="ql-editor editor-container"
				:class="{ 'ql-image-overlay-none': readOnly }"
				show-img-size
				show-img-toolbar
				show-img-resize
				:placeholder="placeholder"
				:read-only="readOnly"
				@statuschange="onStatusChange"
				@ready="onEditorReady"
				@input="onEditorInput"
