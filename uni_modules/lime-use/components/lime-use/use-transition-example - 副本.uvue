<!-- useTransition 缁勪欢绀轰緥 -->
<!-- 杩欐槸涓€涓娇鐢?useTransition 缁勫悎寮忓嚱鏁扮殑绀轰緥缁勪欢锛屽睍绀轰簡鍊艰繃娓″姩鐢荤殑鍩烘湰鐢ㄦ硶 -->
<template>
	<button 
		@click="toggle" 
		class="fixed right-4 bottom-4 bg-primary text-white p-4 rounded-full shadow-lg"
		style="width: 60px; height: 60px; border-radius: 999px;  z-index: 999; font-size: 12px;"
	>
		杩囨浮
	</button>
	
	<view class="bg-white p-4 mb-4 rounded">
		<text class="text-lg font-bold mb-4">鍩虹鍊艰繃娓＄ず渚?/text>
		<view class="bg-gray-1 p-3 mb-4 rounded-xl">
			<text class="block mb-1">涓夋璐濆灏旀洸绾? {{ cubicBezierNumber.toFixed(2) }}</text>
			<text class="block mb-1">鑷畾涔夊嚱鏁? {{ customFnNumber.toFixed(2) }}</text>
		</view>
		<view class="h-5 bg-gray-2 rounded-full overflow-hidden mb-4" style="height:20px; padding: 0 10px">
			<view 
				class="h-full bg-primary rounded-full transition-all duration-300 ease-out" style="width:20px;transform: translateX(-50%);" 
				:style="{ left: `${cubicBezierNumber * 100}%` }"
			></view>
		</view>
		<view class="h-5 bg-gray-2 rounded-full overflow-hidden" style="height:20px; padding: 0 10px">
			<view 
				class="h-full bg-error rounded-full transition-all duration-300 ease-out" style="width:20px;transform: translateX(-50%);" 
				:style="{ left: `${customFnNumber * 100}%` }"
			></view>
		</view>
	</view>
	
	<view class="bg-white p-4 mb-4 rounded">
		<text class="text-lg font-bold mb-4">鍚戦噺杩囨浮绀轰緥</text>
		<text class="block mb-4">鍚戦噺鍊? [{{ vector[0].toFixed(2) }}, {{ vector[1].toFixed(2) }}]</text>
		<view class="relative h-32 bg-gray-1 rounded-xl mb-4 overflow-hidden">
			<view 
				class="absolute w-6 h-6 bg-primary rounded-full" 
				style="width: 10px;height:10px"
				:style="{ 
					left: `${vector[0] * 100}%`, 
					top: `${vector[1] * 100}%`,
					transform: 'translate(-50%, -50%)'
				}"
			></view>
		</view>
	</view>
	
	<view class="bg-white p-4 mb-4 rounded">
		<text class="text-lg font-bold mb-4">鏂囨湰杩囨浮绀轰緥</text>
		<view class="bg-gray-1 p-4 mb-4 rounded-xl text-center">
			<text class="text-xl font-bold">{{ word }}</text>
		</view>
	</view>
	
	<view class="bg-white p-4 mb-4 rounded">
		<text class="text-lg font-bold mb-4">棰滆壊杩囨浮绀轰緥</text>
		<view class="flex gap-4 mb-4">
			<view class="flex-1">
				<text class="block mb-1 text-center">杩囨浮棰滆壊</text>
				<view 
					class="h-16 rounded"
					:style="{ backgroundColor: `rgb(${Math.round(transitionedColor[0])}, ${Math.round(transitionedColor[1])}, ${Math.round(transitionedColor[2])})` }"
				></view>
			</view>
		</view>
	</view>
</template>

<script setup>
	// 瀵煎叆蹇呰鐨勫嚱鏁?	import { ref, computed, shallowRef } from 'vue'
	import { useTransition, TransitionPresets, type UseTransitionOptions } from '@/uni_modules/lime-use'

	// 閰嶇疆閫夐」
	const duration = 1500

	// 婧愬€?	const baseNumber = shallowRef(0)
	const baseVector = shallowRef<number[]>([0, 0])
	const baseWord = shallowRef('Hello')
	const sourceColor = shallowRef<number[]>([0, 0, 0])

	// 涓夋璐濆灏旀洸绾胯繃娓?	const cubicBezierNumber = useTransition<number>(baseNumber, {
		duration,
		easing: [0.75, 0, 0.25, 1],
		onStarted: () => {
			console.log('杩囨浮寮€濮?)
		},
		onFinished: () => {
			console.log('杩囨浮缁撴潫')
		}
	} as UseTransitionOptions<number>)
	// 鑷畾涔夌紦鍔ㄥ嚱鏁?	function easeOutElastic(n: number) {
		return n == 0
			? 0
			: n == 1
				? 1
				: (Math.pow(2, -10 * n)) * Math.sin((n * 10 - 0.75) * ((2 * Math.PI) / 3)) + 1
	}
	// 鑷畾涔夌紦鍔ㄥ嚱鏁拌繃娓?	const customFnNumber = useTransition<number>(baseNumber, {
		duration,
		easing: easeOutElastic
	} as UseTransitionOptions<number>)

	// 鍚戦噺杩囨浮
	const vector = useTransition<number[]>(baseVector, {
		duration,
		easing: TransitionPresets.easeOutExpo
	} as UseTransitionOptions<number[]>)
	
	// 鏂囨湰鎻掑€煎嚱鏁?	function wordlerp(from: string, target: string, alpha: number) {
		from = from.padEnd(target.length)
		target = target.padEnd(from.length)

		const result:string[] = []
		for (let i = 0; i < from.length; i++) {
			const current = from.charCodeAt(i) ?? 0
			const next = target.charCodeAt(i) ?? 0
			const charCode = Math.round(current + (next - current) * alpha)
			result.push(String.fromCharCode(charCode))
		}
		return result.join('')
	}
	// 鏂囨湰杩囨浮
	const word = useTransition<string>(baseWord, {
		duration,
		interpolation: wordlerp,
		easing: TransitionPresets.easeInOutExpo
	} as UseTransitionOptions<string>)

	// 棰滆壊杩囨浮
	const transitionedColor = useTransition<number[]>(sourceColor, {
		duration,
		easing: TransitionPresets.easeOutCubic
	} as UseTransitionOptions<number[]>)

	

	// 闂€欒鏁扮粍
	const greetings = [
		'Ahoj',
		'Bok',
		'Ciao',
		'Czesc',
		'Hallo',
		'Hei',
		'Hej',
		'Hello',
		'Hola',
		'Merhaba',
		'Moi',
		'Namaste',
		'Ola',
		'Privet',
		'Salam',
		'Salut',
		'Sawasdee',
		'Shalom',
		'Yia',
		'Zdravo'
	]

	

	// 闅忔満鏁扮敓鎴愬嚱鏁?	function rand(min: number, max: number) {
		return Math.floor(Math.random() * (max - min + 1)) + min
	}

	// 鍒囨崲鍊肩殑鍑芥暟
	function toggle() {
		baseNumber.value = baseNumber.value == 1 ? 0 : 1
		baseVector.value = [Math.random(), Math.random()]
		sourceColor.value = [
			Math.floor(Math.random() * 256),
			Math.floor(Math.random() * 256),
			Math.floor(Math.random() * 256)
		]
		const arr = greetings.filter(word => word !== baseWord.value)
		baseWord.value = arr[rand(0, arr.length - 1)]
	}
</script>

<style lang="scss">
	@import '@/uni_modules/lime-style/atomic.scss';
</style>