<template>
	<view
	    class="up-tabbar-item"
	    :style="[addStyle(customStyle)]"
	    :class="[isMidButton ? 'up-tabbar-item--mid-button' : '']"
	    @tap="clickHandler"
	>
		<view 
			class="up-tabbar-item__icon"
			:class="[isMidButton ? 'up-tabbar-item__icon--mid-button' : '']"
		>
			<view class="up-tabbar-item--mid-button-cover" v-if="isMidButton">
			</view>
			<up-icon
			    v-if="icon != ''"
			    :name="icon"
			    :color="isActive ? activeColor : inactiveColor"
			    :size="isMidButton ? 26 : 20"
			></up-icon>
			<template v-else>
				<slot
				    v-if="isActive"
				    name="active-icon"
				/>
				<slot
				    v-else
				    name="inactive-icon"
				/>
			</template>
			<up-badge
				absolute
				:offset="[0, dot ? '34rpx' : (badge != null && parseInt(badge.toString()) > 9 ? '14rpx' : '20rpx')]"
			    :customStyle="badgeStyle"
			    :isDot="dot"
			    :value="badge != null ? (dot ? 1 : badge) : 0"
			    :show="dot ? true : (badge != null ? parseInt(badge.toString()) > 0 : false)"
			></up-badge>
		</view>
		
		<slot name="text">
			<text
			    class="up-tabbar-item__text"
			    :style="{
					color: isActive ? activeColor : inactiveColor
				}"
			>{{ text }}</text>
		</slot>
	</view>
</template>

<script setup lang="uts">
import { computed, inject } from 'vue'
import { addStyle } from '../../libs/function/index.uts'

defineOptions({
  name: 'up-tabbar-item'
})

const props = defineProps({
  name: {
    type: [String, Number, null],
    default: null
  },
  icon: {
    type: String,
    default: ''
  },
  badge: {
    type: [String, Number, null],
    default: null
  },
  dot: {
    type: Boolean,
    default: false
  },
  text: {
    type: String,
    default: ''
  },
  badgeStyle: {
    type: [Object, String],
    default: 'top: 6px;right:2px;'
  },
  mode: {
    type: String,
    default: ''
  },
  customStyle: {
    type: Object,
    default: () => ({})
  }
})

const emit = defineEmits(['click'])

const parentProps = inject<any | null>('upTabbarProps', null)
const parentChange = inject<((name: string | number) => void) | null>('upTabbarChange', null)

const isMidButton = computed<boolean>(() => {
  return props.mode === 'midButton'
})

const isActive = computed<boolean>(() => {
  if (parentProps == null || props.name == null) return false
  return parentProps.value == props.name
})

const activeColor = computed<string>(() => {
  return parentProps?.activeColor ?? '#1989fa'
})

const inactiveColor = computed<string>(() => {
  return parentProps?.inactiveColor ?? '#7d7e80'
})

function clickHandler() {
  if (props.name != null && parentChange != null) {
    parentChange(props.name!)
  }
  emit('click', props.name)
}
</script>

<style lang="scss" scoped>
	@import '../../libs/css/components.scss';

	.up-tabbar-item {
		@include flex(column);
		align-items: center;
		justify-content: center;
		flex: 1;

		&__icon {
			position: relative;
			@include flex;
			justify-content: center;
			align-items: center;
		}

		&__text {
			margin-top: 2px;
			font-size: 11px;
			color: $up-content-color;
			text-align: center;
		}

		&--mid-button {
			position: relative;
		}

		&__icon--mid-button {
			position: absolute;
			top: -18px;
			width: 44px;
			height: 44px;
			border-radius: 50%;
			background-color: #fff;
			box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
			display: flex;
			align-items: center;
			justify-content: center;
			z-index: 10;
		}
	}
</style>
