		flex-direction: column;
	}

	.up-cropper__panel {
		position: fixed;
		left: 0;
		top: 0;
		right: 0;
		bottom: 0;
		z-index: 999;
		background-color: #000000;
	}

	.up-cropper__canvas {
		display: flex;
	}

