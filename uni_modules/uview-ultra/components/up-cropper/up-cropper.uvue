<template>
	<view class="up-cropper">
		<view v-if="visible" class="up-cropper__panel">
			<canvas
				class="up-cropper__canvas"
				:id="canvasId"
				:canvas-id="canvasId"
				:style="canvasStyle"
				@touchstart="touchStart"
				@touchmove="touchMove"
				@touchend="touchEnd"
				@touchcancel="touchEnd"
			></canvas>
			<canvas
				class="up-cropper__export"
				:id="exportCanvasId"
				:canvas-id="exportCanvasId"
				:style="exportCanvasStyle"
			></canvas>
			<view class="up-cropper__toolbar">
				<template v-if="!previewing">
					<text class="up-cropper__button" @click="select">重选</text>
					<text class="up-cropper__button" @click="close">关闭</text>
					<text v-if="showRotateButton" class="up-cropper__button" @click="rotate">旋转</text>
					<text class="up-cropper__button" @click="preview">预览</text>
					<text class="up-cropper__button" @click="confirm">确定</text>
				</template>
				<template v-else>
					<text class="up-cropper__button" @click="exitPreview">返回</text>
					<text class="up-cropper__button" @click="confirm">确定</text>
				</template>
			</view>
		</view>
		<view v-else @click="openDefault">
			<slot></slot>
		</view>
	</view>
</template>

<script setup lang="uts">
import { ref, computed, nextTick, getCurrentInstance } from 'vue'

type CropTouch = {
	x: number,
	y: number
}

function makeId(prefix: string): string {
	return prefix + Date.now().toString()
}

function getPixelRatio(): number {
	const info = uni.getSystemInfoSync()
	if (info.pixelRatio > 0) {
		return info.pixelRatio
	}
	return 1
}

function toObject(value: any | null): UTSJSONObject {
	return value == null ? ({} as UTSJSONObject) : value as UTSJSONObject
}

function normalizeString(value: any | null, fallback: string = ''): string {
	return value == null ? fallback : value.toString()
}

function rpxToPx(value: any | null, fallback: number): number {
	if (typeof value === 'number') {
		return value as number
	}
	if (value == null) {
		return fallback
	}
	const text = value.toString()
	if (text.endsWith('rpx')) {
		const parsed = parseFloat(text.substring(0, text.length - 3))
		return isNaN(parsed) ? fallback : parsed * uni.getWindowInfo().windowWidth / 750
	}
	if (text.endsWith('px')) {
		const parsed = parseFloat(text.substring(0, text.length - 2))
		return isNaN(parsed) ? fallback : parsed
	}
	const parsed = parseFloat(text)
	return isNaN(parsed) ? fallback : parsed
}

function numberValue(value: any | null, fallback: number = 0): number {
	if (typeof value === 'number') {
		return value as number
	}
	if (value == null) {
		return fallback
	}
	const parsed = parseFloat(value.toString())
	return isNaN(parsed) ? fallback : parsed
}

function touchPoint(e: UniTouchEvent): CropTouch {
	let x = 0
	let y = 0
	if (e.touches.length > 0) {
		x = e.touches[0].pageX
		y = e.touches[0].pageY
	} else if (e.changedTouches.length > 0) {
		x = e.changedTouches[0].pageX
		y = e.changedTouches[0].pageY
	}
	return { x, y } as CropTouch
}

function touchAt(e: UniTouchEvent, index: number): CropTouch | null {
	if (e.touches.length > index) {
		return {
			x: e.touches[index].pageX,
			y: e.touches[index].pageY
		} as CropTouch
	}
	return null
}

function distanceBetween(a: CropTouch, b: CropTouch): number {
	const x = a.x - b.x
	const y = a.y - b.y
	return Math.sqrt(x * x + y * y)
}

function clamp(value: number, min: number, max: number): number {
	if (value < min) return min
	if (value > max) return max
	return value
}

defineOptions({
	name: 'up-cropper'
})

const props = defineProps({
	minScale: {
		type: [String, Number],
		default: 0.3
	},
	maxScale: {
		type: [String, Number],
		default: 4
	},
	canScale: {
		type: Boolean,
		default: true
	},
	canRotate: {
		type: Boolean,
		default: true
	},
	lockWidth: {
		type: [String, Number],
		default: ''
	},
	lockHeight: {
		type: [String, Number],
		default: ''
	},
	stretch: {
		type: String,
		default: ''
	},
	lock: {
		type: String,
		default: ''
	},
	noTab: {
		type: Boolean,
		default: true
	},
	inner: {
		type: Boolean,
		default: false
	},
	quality: {
		type: [String, Number],
		default: 1
	},
	canChangeSize: {
		type: Boolean,
		default: false
	},
	areaWidth: {
		type: String,
		default: '300rpx'
	},
	areaHeight: {
		type: String,
		default: '300rpx'
	},
	exportWidth: {
		type: String,
		default: '260rpx'
	},
	exportHeight: {
		type: String,
		default: '260rpx'
	},
	fillColor: {
		type: String,
		default: 'transparent'
	},
	index: {
		type: [String, Number],
		default: 0
	}
})

const emit = defineEmits(['avtinit', 'confirm', 'cancel', 'error'])
const instance = getCurrentInstance()

function resolveFillColor(): string {
	if (props.fillColor == 'transparent') {
		return 'rgba(0,0,0,0)'
	}
	return props.fillColor
}

const canvasId = ref<string>(makeId('up-cropper-'))
const exportCanvasId = ref<string>(makeId('up-cropper-export-'))
let canvasContext: CanvasContext | null = null
let exportCanvasContext: CanvasContext | null = null
let ctx: CanvasRenderingContext2D | null = null
let exportCtx: CanvasRenderingContext2D | null = null
let imageElement: any | null = null
const imagePath = ref<string>('')
const imageWidth = ref<number>(0)
const imageHeight = ref<number>(0)
const visible = ref<boolean>(false)
const canvasWidth = ref<number>(uni.getWindowInfo().windowWidth)
const canvasHeight = ref<number>(uni.getWindowInfo().windowHeight - 70)
const cropWidth = ref<number>(rpxToPx(props.areaWidth, 300))
const cropHeight = ref<number>(rpxToPx(props.areaHeight, 300))
const outputWidth = ref<number>(rpxToPx(props.exportWidth, 260))
const outputHeight = ref<number>(rpxToPx(props.exportHeight, 260))
const imageX = ref<number>(0)
const imageY = ref<number>(0)
const baseDisplayWidth = ref<number>(0)
const baseDisplayHeight = ref<number>(0)
const displayWidth = ref<number>(0)
const displayHeight = ref<number>(0)
const scaleValue = ref<number>(1)
const minScaleValue = ref<number>(numberValue(props.minScale, 0.3))
const maxScaleValue = ref<number>(numberValue(props.maxScale, 4))
const rotateDeg = ref<number>(0)
const canScaleLocal = ref<boolean>(props.canScale)
const canRotateLocal = ref<boolean>(props.canRotate && !props.inner)
const canChangeSizeLocal = ref<boolean>(props.canChangeSize)
const lockMode = ref<string>(normalizeString(props.lock))
const stretchMode = ref<string>(normalizeString(props.stretch))
const innerMode = ref<boolean>(props.inner)
let returnData: any | null = null
let lastOptions: UTSJSONObject = {} as UTSJSONObject
let activeTouch: CropTouch | null = null
let secondTouch: CropTouch | null = null
let startPinchDistance: number = 0
let startScaleValue: number = 1
let resizeHandle: string = ''
const previewing = ref<boolean>(false)
const currentIndex = ref<number>(0)

const canvasStyle = computed<UTSJSONObject>(() => {
	return {
		width: canvasWidth.value.toString() + 'px',
		height: canvasHeight.value.toString() + 'px'
	} as UTSJSONObject
})

const exportCanvasStyle = computed<UTSJSONObject>(() => {
	return {
		width: outputWidth.value.toString() + 'px',
		height: outputHeight.value.toString() + 'px'
	} as UTSJSONObject
})

const cropLeft = computed<number>(() => {
	return (numberValue(canvasWidth.value, 0) - numberValue(cropWidth.value, 0)) / 2
})

const cropTop = computed<number>(() => {
	return (numberValue(canvasHeight.value, 0) - numberValue(cropHeight.value, 0)) / 2
})

const showRotateButton = computed<boolean>(() => {
	return canRotateLocal.value
})

function initCanvas(): Promise<void> {
	return new Promise((resolve, reject) => {
		uni.createCanvasContextAsync({
			id: canvasId.value as string.IDString,
			component: instance?.proxy,
			success: (context: CanvasContext) => {
				canvasContext = context
				const c2d = context.getContext('2d')
				if (c2d == null) {
					reject(new Error('Canvas context is not ready'))
					return
				}
				const pixelRatio = getPixelRatio()
				const canvas = c2d.canvas
				canvas.width = canvasWidth.value * pixelRatio
				canvas.height = canvasHeight.value * pixelRatio
				c2d.scale(pixelRatio, pixelRatio)
				ctx = c2d
				uni.createCanvasContextAsync({
					id: exportCanvasId.value as string.IDString,
					component: instance?.proxy,
					success: (exportContext: CanvasContext) => {
						exportCanvasContext = exportContext
						const export2d = exportContext.getContext('2d')
						if (export2d == null) {
							reject(new Error('Export canvas context is not ready'))
							return
						}
						const exportCanvas = export2d.canvas
						exportCanvas.width = outputWidth.value * pixelRatio
						exportCanvas.height = outputHeight.value * pixelRatio
						export2d.scale(pixelRatio, pixelRatio)
						exportCtx = export2d
						resolve()
					},
					fail: (err: UniError) => {
						reject(err)
					}
				})
			},
			fail: (err: UniError) => {
				reject(err)
			}
		})
	})
}

function keepImageInCrop(): void {
	const cropL = cropLeft.value
	const cropT = cropTop.value
	const cropW = numberValue(cropWidth.value, 0)
	const cropH = numberValue(cropHeight.value, 0)
	const displayW = numberValue(displayWidth.value, 0)
	const displayH = numberValue(displayHeight.value, 0)
	if (displayW <= cropW) {
		imageX.value = cropL + (cropW - displayW) / 2
	} else {
		if (numberValue(imageX.value, 0) > cropL) {
			imageX.value = cropL
		}
		if (numberValue(imageX.value, 0) + displayW < cropL + cropW) {
			imageX.value = cropL + cropW - displayW
		}
	}
	if (displayH <= cropH) {
		imageY.value = cropT + (cropH - displayH) / 2
	} else {
		if (numberValue(imageY.value, 0) > cropT) {
			imageY.value = cropT
		}
		if (numberValue(imageY.value, 0) + displayH < cropT + cropH) {
			imageY.value = cropT + cropH - displayH
		}
	}
}

function fitImage(): void {
	const cropW = numberValue(cropWidth.value, 300)
	const cropH = numberValue(cropHeight.value, 300)
	const imgW = Math.max(1, numberValue(imageWidth.value, 1))
	const imgH = Math.max(1, numberValue(imageHeight.value, 1))
	let scale = Math.max(cropW / imgW, cropH / imgH)
	const imageRadio = imgW / imgH
	const mode = stretchMode.value
	if (mode == 'x') {
		scale = cropW / imgW
	} else if (mode == 'y') {
		scale = cropH / imgH
	} else if (mode == 'long') {
		scale = imageRadio > 1 ? cropW / imgW : cropH / imgH
	} else if (mode == 'short') {
		scale = imageRadio > 1 ? cropH / imgH : cropW / imgW
	}
	let displayW = imgW * scale
	let displayH = imgH * scale
	if (innerMode.value) {
		if (displayW < cropW) {
			displayW = cropW
			displayH = displayW / imageRadio
		}
		if (displayH < cropH) {
			displayH = cropH
			displayW = displayH * imageRadio
		}
	}
	baseDisplayWidth.value = displayW
	baseDisplayHeight.value = displayH
	displayWidth.value = displayW
	displayHeight.value = displayH
	scaleValue.value = 1
	rotateDeg.value = 0
	imageX.value = cropLeft.value + (cropW - displayW) / 2
	imageY.value = cropTop.value + (cropH - displayH) / 2
	keepImageInCrop()
	emit('avtinit')
}

function drawHandle(context: CanvasRenderingContext2D, x: number, y: number, size: number): void {
	context.fillRect(x - size / 2, y - size / 2, size, size)
	context.strokeRect(x - size / 2, y - size / 2, size, size)
}

function drawResizeHandles(context: CanvasRenderingContext2D, left: number, top: number, width: number, height: number): void {
	const size = 12
	context.fillStyle = '#ffffff'
	context.strokeStyle = '#d14343'
	context.lineWidth = 1
	drawHandle(context, left, top, size)
	drawHandle(context, left + width, top, size)
	drawHandle(context, left, top + height, size)
	drawHandle(context, left + width, top + height, size)
}

function draw(): void {
	const context = ctx
	const image = imageElement
	if (context == null || image == null) return
	const canvasW = numberValue(canvasWidth.value, 0)
	const canvasH = numberValue(canvasHeight.value, 0)
	const cropL = cropLeft.value
	const cropT = cropTop.value
	const cropW = numberValue(cropWidth.value, 0)
	const cropH = numberValue(cropHeight.value, 0)
	const imgX = numberValue(imageX.value, 0)
	const imgY = numberValue(imageY.value, 0)
	const displayW = numberValue(displayWidth.value, 0)
	const displayH = numberValue(displayHeight.value, 0)
	context.clearRect(0, 0, canvasW, canvasH)
	context.fillStyle = 'rgba(0,0,0,0.72)'
	context.fillRect(0, 0, canvasW, canvasH)
	context.save()
	context.beginPath()
	context.rect(cropL, cropT, cropW, cropH)
	context.clip()
	context.fillStyle = resolveFillColor()
	context.fillRect(cropL, cropT, cropW, cropH)
	context.translate(imgX + displayW / 2, imgY + displayH / 2)
	context.rotate(rotateDeg.value * Math.PI / 180)
	// #ifdef APP-ANDROID
	context.drawImage(image as UniImageElementImpl, -displayW / 2, -displayH / 2, displayW, displayH)
	// #endif
	// #ifndef APP-ANDROID
	context.drawImage(image as any, -displayW / 2, -displayH / 2, displayW, displayH)
	// #endif
	context.restore()
	context.strokeStyle = '#ffffff'
	context.lineWidth = 2
	context.strokeRect(cropL, cropT, cropW, cropH)
	if (canChangeSizeLocal.value) {
		drawResizeHandles(context, cropL, cropT, cropW, cropH)
	}
}

function createCanvasImage(path: string): void {
	const canvas = canvasContext
	if (canvas == null) {
		emit('error', new Error('Canvas is not ready'))
		return
	}
	const image = canvas.createImage()
	image.onload = () => {
		imageElement = image
		fitImage()
		draw()
	}
	// #ifdef WEB || MP-WEIXIN
	(image as UTSJSONObject)['onerror'] = () => {
		emit('error', new Error('Image load failed'))
	}
	// #endif
	image.src = path
}

function loadImage(path: string): void {
	uni.getImageInfo({
		src: path,
		success: (info: GetImageInfoSuccess) => {
			imagePath.value = path
			imageWidth.value = info.width
			imageHeight.value = info.height
			visible.value = true
			nextTick(() => {
				initCanvas().then(() => {
					createCanvasImage(info.path)
				}).catch((err: any | null) => {
					emit('error', err)
				})
			})
		},
		fail: () => {
			emit('error', '读取图片失败')
		}
	})
}

function chooseImage(index: any | null = 0, params: UTSJSONObject = {} as UTSJSONObject, data: any | null = null): void {
	const options = toObject(params)
	lastOptions = options
	currentIndex.value = typeof index === 'number' ? (index as number) : 0
	cropWidth.value = rpxToPx(options['areaWidth'], rpxToPx(props.areaWidth, 300))
	cropHeight.value = rpxToPx(options['areaHeight'], rpxToPx(props.areaHeight, 300))
	outputWidth.value = rpxToPx(options['exportWidth'], rpxToPx(props.exportWidth, 260))
	outputHeight.value = rpxToPx(options['exportHeight'], rpxToPx(props.exportHeight, 260))
	minScaleValue.value = numberValue(options['minScale'], numberValue(props.minScale, 0.3))
	maxScaleValue.value = numberValue(options['maxScale'], numberValue(props.maxScale, 4))
	canScaleLocal.value = options['canScale'] == null ? props.canScale : (options['canScale'] as boolean)
	canRotateLocal.value = (options['canRotate'] == null ? props.canRotate : (options['canRotate'] as boolean)) && !(options['inner'] == null ? props.inner : (options['inner'] as boolean))
	canChangeSizeLocal.value = options['canChangeSize'] == null ? props.canChangeSize : (options['canChangeSize'] as boolean)
	innerMode.value = options['inner'] == null ? props.inner : (options['inner'] as boolean)
	lockMode.value = normalizeString(options['lock'], normalizeString(props.lock))
	stretchMode.value = normalizeString(options['stretch'], normalizeString(props.stretch))
	returnData = data
	previewing.value = false
	uni.chooseImage({
		count: 1,
		sizeType: ['original', 'compressed'],
		sourceType: ['album', 'camera'],
		success: (res: ChooseImageSuccess) => {
			if (res.tempFilePaths.length == 0) return
			loadImage(res.tempFilePaths[0])
		},
		fail: () => {
			emit('cancel')
		}
	})
}

function openDefault(): void {
	chooseImage(0, {} as UTSJSONObject)
}

function select(): void {
	chooseImage(currentIndex.value, lastOptions, returnData)
}

function getResizeHandle(point: CropTouch): string {
	const tolerance = 28
	const left = cropLeft.value
	const top = cropTop.value
	const width = numberValue(cropWidth.value, 0)
	const height = numberValue(cropHeight.value, 0)
	if (Math.abs(point.x - left) <= tolerance && Math.abs(point.y - top) <= tolerance) return 'top-left'
	if (Math.abs(point.x - left - width) <= tolerance && Math.abs(point.y - top) <= tolerance) return 'top-right'
	if (Math.abs(point.x - left) <= tolerance && Math.abs(point.y - top - height) <= tolerance) return 'bottom-left'
	if (Math.abs(point.x - left - width) <= tolerance && Math.abs(point.y - top - height) <= tolerance) return 'bottom-right'
	return ''
}

function resizeCrop(point: CropTouch): void {
	const minSize = 50
	const oldW = numberValue(cropWidth.value, 0)
	const oldH = numberValue(cropHeight.value, 0)
	const centerX = cropLeft.value + oldW / 2
	const centerY = cropTop.value + oldH / 2
	let nextW = Math.abs(point.x - centerX) * 2
	let nextH = Math.abs(point.y - centerY) * 2
	const maxW = numberValue(canvasWidth.value, 0) - 24
	const maxH = numberValue(canvasHeight.value, 0) - 24
	nextW = clamp(nextW, minSize, maxW)
	nextH = clamp(nextH, minSize, maxH)
	const lockedWidth = rpxToPx(props.lockWidth, 0)
	const lockedHeight = rpxToPx(props.lockHeight, 0)
	if (lockedWidth > 0) nextW = lockedWidth
	if (lockedHeight > 0) nextH = lockedHeight
	cropWidth.value = nextW
	cropHeight.value = nextH
}

function applyScale(nextScale: number): void {
	const centerX = imageX.value + displayWidth.value / 2
	const centerY = imageY.value + displayHeight.value / 2
	scaleValue.value = nextScale
	displayWidth.value = baseDisplayWidth.value * nextScale
	displayHeight.value = baseDisplayHeight.value * nextScale
	imageX.value = centerX - displayWidth.value / 2
	imageY.value = centerY - displayHeight.value / 2
}

function handlePinch(first: CropTouch, second: CropTouch): void {
	const currentDistance = distanceBetween(first, second)
	if (startPinchDistance > 0 && canScaleLocal.value) {
		const minScale = numberValue(minScaleValue.value, 0.3)
		const maxScale = numberValue(maxScaleValue.value, 4)
		const nextScale = clamp(startScaleValue * currentDistance / startPinchDistance, minScale, maxScale)
		applyScale(nextScale)
	}
	keepImageInCrop()
	draw()
}

function isMoveLockedX(): boolean {
	return lockMode.value == 'x' || lockMode.value == 'longSel' || lockMode.value == 'long'
}

function isMoveLockedY(): boolean {
	return lockMode.value == 'y' || lockMode.value == 'shortSel' || lockMode.value == 'short'
}

function touchStart(e: UniTouchEvent): void {
	if (previewing.value) return
	const first = touchAt(e, 0)
	const second = touchAt(e, 1)
	if (first != null && second != null) {
		activeTouch = first
		secondTouch = second
		startPinchDistance = distanceBetween(first, second)
		startScaleValue = scaleValue.value
		resizeHandle = ''
		return
	}
	const point = touchPoint(e)
	activeTouch = point
	secondTouch = null
	resizeHandle = canChangeSizeLocal.value ? getResizeHandle(point) : ''
}

function touchMove(e: UniTouchEvent): void {
	if (previewing.value) return
	const first = touchAt(e, 0)
	const second = touchAt(e, 1)
	if (first != null && second != null) {
		handlePinch(first, second)
		return
	}
	const last = activeTouch
	if (last == null) return
	const point = touchPoint(e)
	if (resizeHandle.length > 0) {
		resizeCrop(point)
	} else {
		if (!isMoveLockedX()) {
			imageX.value += point.x - last.x
		}
		if (!isMoveLockedY()) {
			imageY.value += point.y - last.y
		}
	}
	activeTouch = point
	keepImageInCrop()
	draw()
}

function touchEnd(): void {
	activeTouch = null
	secondTouch = null
	resizeHandle = ''
}

function rotate(): void {
	if (!canRotateLocal.value || previewing.value) return
	rotateDeg.value = (rotateDeg.value + 90) % 360
	draw()
}

function drawPreview(): void {
	const context = ctx
	const image = imageElement
	if (context == null || image == null) return
	const canvasW = numberValue(canvasWidth.value, 0)
	const canvasH = numberValue(canvasHeight.value, 0)
	const cropW = numberValue(cropWidth.value, 0)
	const cropH = numberValue(cropHeight.value, 0)
	const previewW = Math.min(canvasW - 40, cropW)
	const previewH = cropH * previewW / Math.max(1, cropW)
	const x = (canvasW - previewW) / 2
	const y = Math.max(20, (canvasH - previewH) / 2)
	context.clearRect(0, 0, canvasW, canvasH)
	context.fillStyle = '#000000'
	context.fillRect(0, 0, canvasW, canvasH)
	context.save()
	context.beginPath()
	context.rect(x, y, previewW, previewH)
	context.clip()
	context.fillStyle = resolveFillColor()
	context.fillRect(x, y, previewW, previewH)
	const scaleX = previewW / cropW
	const scaleY = previewH / cropH
	const cropL = cropLeft.value
	const cropT = cropTop.value
	const displayW = numberValue(displayWidth.value, 0)
	const displayH = numberValue(displayHeight.value, 0)
	context.translate(x + (imageX.value + displayW / 2 - cropL) * scaleX, y + (imageY.value + displayH / 2 - cropT) * scaleY)
	context.rotate(rotateDeg.value * Math.PI / 180)
	// #ifdef APP-ANDROID
	context.drawImage(image as UniImageElementImpl, -displayW * scaleX / 2, -displayH * scaleY / 2, displayW * scaleX, displayH * scaleY)
	// #endif
	// #ifndef APP-ANDROID
	context.drawImage(image as any, -displayW * scaleX / 2, -displayH * scaleY / 2, displayW * scaleX, displayH * scaleY)
	// #endif
	context.restore()
	context.strokeStyle = '#ffffff'
	context.lineWidth = 1
	context.strokeRect(x, y, previewW, previewH)
}

function preview(): void {
	previewing.value = true
	drawPreview()
}

function exitPreview(): void {
	previewing.value = false
	draw()
}

function confirm(): void {
	const context = exportCtx
	const canvas = exportCanvasContext
	const image = imageElement
	if (context == null || canvas == null || image == null) {
		emit('error', new Error('Canvas is not ready'))
		return
	}
	const outputW = numberValue(outputWidth.value, 0)
	const outputH = numberValue(outputHeight.value, 0)
	const displayW = Math.max(1, numberValue(displayWidth.value, 1))
	const displayH = Math.max(1, numberValue(displayHeight.value, 1))
	const cropW = numberValue(cropWidth.value, 0)
	const cropH = numberValue(cropHeight.value, 0)
	const cropL = cropLeft.value
	const cropT = cropTop.value
	const imgX = numberValue(imageX.value, 0)
	const imgY = numberValue(imageY.value, 0)
	context.clearRect(0, 0, outputW, outputH)
	context.fillStyle = resolveFillColor()
	context.fillRect(0, 0, outputW, outputH)
	context.save()
	const scaleX = outputW / Math.max(1, cropW)
	const scaleY = outputH / Math.max(1, cropH)
	context.scale(scaleX, scaleY)
	context.translate(imgX + displayW / 2 - cropL, imgY + displayH / 2 - cropT)
	context.rotate(rotateDeg.value * Math.PI / 180)
	// #ifdef APP-ANDROID
	context.drawImage(image as UniImageElementImpl, -displayW / 2, -displayH / 2, displayW, displayH)
	// #endif
	// #ifndef APP-ANDROID
	context.drawImage(image as any, -displayW / 2, -displayH / 2, displayW, displayH)
	// #endif
	context.restore()
	const quality = clamp(numberValue(props.quality, 1), 0, 1)
	const path = canvas.toDataURL('image/png', quality)
	visible.value = false
	previewing.value = false
	emit('confirm', {
		path,
		avatar: path,
		index: currentIndex.value,
		data: returnData
	} as UTSJSONObject)
}

function close(): void {
	visible.value = false
	emit('cancel')
}

defineExpose({
	chooseImage,
	select,
	loadImage,
	rotate,
	preview,
	exitPreview,
	confirm,
	close
})
</script>

