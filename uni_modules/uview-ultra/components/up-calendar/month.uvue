<template>
	<view class="up-calendar-month-wrapper" ref="up-calendar-month-wrapper">
		<view v-for="(item, index) in monthsInner" :key="index" :class="[`up-calendar-month-` + index.toString()]"
			:ref="`up-calendar-month-` + index.toString()" :id="`month-` + index.toString()">
			<view v-if="index != 0" class="up-calendar-month__title">
				<text class="up-calendar-month__title-text">{{ getMonthTitle(item) }}</text>
			</view>
			<view class="up-calendar-month__days">
				<view v-if="showMark" class="up-calendar-month__days__month-mark-wrapper">
					<text class="up-calendar-month__days__month-mark-wrapper__text">{{ item['month'] }}</text>
				</view>
				<template v-for="(item1, index1) in item.date" :key="item1.dateStr ?? index1">
					<view class="up-calendar-month__days__day"
						:style="dayStyle(index1, item1)" @tap="clickHandler(index, index1, item1)">
						<view class="up-calendar-month__days__day__select" 
							:style="daySelectStyle(item1)"
							:class="{
								'up-calendar-month__days__day__select--selected': isSelected(item1),
								'up-calendar-month__days__day__select--today': isToday(item1),
								'up-calendar-month__days__day__select--range-start-selected': isRangeStart(item1),
								'up-calendar-month__days__day__select--range-end-selected': isRangeEnd(item1)
							}">
							<view v-if="isRangeMiddle(item1)" class="up-calendar-month__days__day__select__range-bg" :style="rangeBgStyle"></view>
							<text class="up-calendar-month__days__day__select__info"
								:class="{
									'up-calendar-month__days__day__select__info--selected': isSelected(item1),
									'up-calendar-month__days__day__select__info--disabled': item1.disabled,
									'up-calendar-month__days__day__select__info--range-middle': isRangeMiddle(item1)
								}"
								:style="textStyle(item1)">{{ item1['day'] }}</text>
							<text v-if="getBottomInfo(item1) != ''"
								class="up-calendar-month__days__day__select__buttom-info"
								:class="{
									'up-calendar-month__days__day__select__buttom-info--selected': isSelected(item1),
									'up-calendar-month__days__day__select__buttom-info--disabled': item1['disabled']
								}">
								{{ getBottomInfo(item1) }}
							</text>
							<text v-if="item1['dot']" class="up-calendar-month__days__day__select__dot"></text>
						</view>
					</view>
				</template>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import { ref, computed, watch, onMounted, getCurrentInstance, nextTick } from 'vue'
import { addUnit, upGetRect, getWindowInfo } from '../../libs/function/index'
import { formatMonthTitle } from '../../libs/i18n/index.uts'
import { colorGradient } from '../../libs/function/colorGradient'
import { array as testArray } from '../../libs/function/test'
import { dayuts } from '@/uni_modules/lime-dayuts'
import { UPCalendarMonthsItemDate, CalendarMonthItem } from './types.uts'

defineOptions({
	name: 'up-calendar-month'
})

const props = defineProps({
	showMark: {
		type: Boolean,
		default: true
	},
	color: {
		type: String,
		default: '#3c9cff'
	},
	months: {
		type: Array as PropType<Array<CalendarMonthItem>>,
		default: () => [] as Array<CalendarMonthItem>
	},
	mode: {
		type: String,
		default: 'single'
	},
	rowHeight: {
		type: [String, Number],
		default: 58
	},
	maxCount: {
		type: [String, Number],
		default: 999
	},
	startText: {
		type: String,
		default: '开始'
	},
	endText: {
		type: String,
		default: '结束'
	},
	defaultDate: {
		type: [Array, String, Date],
		default: null
	},
	minDate: {
		type: [String, Number],
		default: 0
	},
	maxDate: {
		type: [String, Number],
		default: 0
	},
	maxMonth: {
		type: [String, Number],
		default: 2
	},
	readonly: {
		type: Boolean,
		default: false
	},
	maxRange: {
		type: [Number, String],
		default: 365
	},
	rangePrompt: {
		type: String,
		default: ''
	},
	showRangePrompt: {
		type: Boolean,
		default: true
	},
	allowSameDay: {
		type: Boolean,
		default: false
	},
	todayDate: {
		type: String,
		default: ''
	}
})

const emit = defineEmits(['monthSelected', 'updateMonthTop'])
const instance = getCurrentInstance()

const width = ref<number>(0)
const monthsInner = ref<Array<CalendarMonthItem>>([])
const selected = ref<Array<string>>([])

const startDate = computed<string>((): string => {
	if (selected.value.length > 0) return selected.value[0]
	return ''
})

const endDate = computed<string>((): string => {
	if (selected.value.length >= 2) return selected.value[selected.value.length - 1]
	return ''
})

const emptyStyle = {} as UTSJSONObject

const defaultDayStyle = computed((): UTSJSONObject => {
	const style = {} as UTSJSONObject
	style['height'] = addUnit(props.rowHeight)
	if (props.mode == 'range') {
		style['padding'] = 0
	}
	return style
})

const customSelectedBgStyle = computed((): UTSJSONObject => {
	const style = {} as UTSJSONObject
	if (props.color != '#3c9cff') {
		style['backgroundColor'] = props.color
	}
	return style
})

const customTodayBorderStyle = computed((): UTSJSONObject => {
	const style = {} as UTSJSONObject
	if (props.color != '#3c9cff') {
		style['borderColor'] = props.color
	}
	style['boxSizing'] = 'border-box'
	return style
})

const rangeBgStyle = computed((): UTSJSONObject => {
	const style = {} as UTSJSONObject
	if (props.color != '#3c9cff') {
		style['backgroundColor'] = colorGradient(props.color, '#ffffff', 100)[90]
		style['opacity'] = 0.7
	}
	return style
})

const customRangeTextColorStyle = computed((): UTSJSONObject => {
	const style = {} as UTSJSONObject
	if (props.color != '#3c9cff') {
		style['color'] = props.color
	}
	return style
})

function getMonthTitle(item: CalendarMonthItem): string {
	return formatMonthTitle(item.year, item.month)
}

function isRangeMiddle(item: UPCalendarMonthsItemDate): boolean {
	if (props.mode != 'range') return false
	const s = startDate.value
	const e = endDate.value
	if (s == '' || e == '') return false
	const d = item.dateStr ?? ''
	return d > s && d < e
}

function isSelected(item: UPCalendarMonthsItemDate): boolean {
	const d = item.dateStr ?? ''
	if (d == '') return false
	if (props.mode == 'single') {
		return startDate.value != '' && d == startDate.value
	}
	if (props.mode == 'range') {
		if (startDate.value == '') return false
		if (d == startDate.value) return true
		return endDate.value != '' && d == endDate.value
	}
	return selected.value.indexOf(d) != -1
}

function isToday(item: UPCalendarMonthsItemDate): boolean {
	const d = item.dateStr ?? ''
	return props.todayDate != '' && d == props.todayDate && !isSelected(item)
}

function isRangeStart(item: UPCalendarMonthsItemDate): boolean {
	if (props.mode != 'range') return false
	const s = startDate.value
	const e = endDate.value
	const d = item.dateStr ?? ''
	return s != '' && e != '' && s != e && d == s
}

function isRangeEnd(item: UPCalendarMonthsItemDate): boolean {
	if (props.mode != 'range') return false
	const s = startDate.value
	const e = endDate.value
	const d = item.dateStr ?? ''
	return s != '' && e != '' && s != e && d == e
}

function dayStyle(index2: number, item: UPCalendarMonthsItemDate): UTSJSONObject {
	if (index2 > 0) {
		return defaultDayStyle.value
	}
	const style = {} as UTSJSONObject
	style['height'] = addUnit(props.rowHeight)
	let week = item.week
	week = (week == 0 ? 7 : week) - 1
	style['marginLeft'] = `${(week / 7) * 100}%`
	if (props.mode == 'range') {
		style['padding'] = 0
	}
	return style
}

function daySelectStyle(item: UPCalendarMonthsItemDate): UTSJSONObject {
	if (props.color == '#3c9cff') {
		return emptyStyle
	}
	if (isSelected(item)) {
		return customSelectedBgStyle.value
	}
	if (isToday(item)) {
		return customTodayBorderStyle.value
	}
	return emptyStyle
}

function textStyle(item: UPCalendarMonthsItemDate): UTSJSONObject {
	if (props.color == '#3c9cff') {
		return emptyStyle
	}
	if (props.mode == 'range' && isRangeMiddle(item)) {
		return customRangeTextColorStyle.value
	}
	return emptyStyle
}

function getBottomInfo(item: UPCalendarMonthsItemDate): string {
	const bottomInfo = (item.bottomInfo != null) ? item.bottomInfo!.toString() : ''
	if (props.mode == 'range') {
		const s = startDate.value
		if (s == '') return bottomInfo
		const e = endDate.value
		const d = item.dateStr ?? ''
		if (e != '') {
			if (s == e && d == s) {
				return `${props.startText}/${props.endText}`
			}
			if (d == s) return props.startText
			if (d == e) return props.endText
		} else {
			if (d == s) return props.startText
		}
	}
	return bottomInfo
}

function setSelected(sel: Array<string>, shouldEmit = true) {
	selected.value = sel
	if (shouldEmit) {
		emit('monthSelected', selected.value, 'tap')
	}
}

function clickHandler(index1: number, index21: number, item: UPCalendarMonthsItemDate) {
	if (props.readonly) return
	const date = item.dateStr ?? ''
	let disabled = item.disabled ?? false
	if (disabled || date == '') return
	let curSelected = [...selected.value]
	if (props.mode == 'single') {
		curSelected = [date]
	} else if (props.mode == 'multiple') {
		const itemIndex = curSelected.indexOf(date)
		if (itemIndex != -1) {
			curSelected.splice(itemIndex, 1)
		} else {
			if (curSelected.length < parseInt(props.maxCount.toString())) {
				curSelected.push(date)
			}
		}
	} else {
		if (curSelected.length == 0 || curSelected.length >= 2) {
			curSelected = [date]
		} else if (curSelected.length == 1) {
			const existsDate = curSelected[0]
			if (date < existsDate) {
				curSelected = [date]
			} else if (date > existsDate) {
				curSelected.push(date)
				const startDateVal = curSelected[0]
				const endDateVal = curSelected[1]
				const arr = [] as Array<string>
				let cur = dayuts(startDateVal as any)
				const end = dayuts(endDateVal as any)
				while (cur.isBefore(end)) {
					arr.push(cur.format("YYYY-MM-DD"))
					cur = cur.add(1, 'day')
				}
				arr.push(endDateVal)
				curSelected = arr
			} else {
				if (curSelected[0] == date && !props.allowSameDay) return
				curSelected.push(date)
			}
		}
	}
	setSelected(curSelected)
}

function setDefaultDate() {
	if (props.defaultDate == null) {
		const sel = [dayuts().format("YYYY-MM-DD")]
		setSelected(sel, false)
		return
	}
	let defDate = [] as Array<string>
	let minDateData = props.minDate.toString()
	let maxDateData = props.maxDate.toString()
	const minDate = (minDateData != '' && minDateData != '0') ? minDateData : dayuts().format("YYYY-MM-DD")
	const maxDate = (maxDateData != '' && maxDateData != '0') ? maxDateData : dayuts(minDate as any).add(parseInt(props.maxMonth.toString()) - 1, 'month').format("YYYY-MM-DD")
	if (props.mode == 'single') {
		if (!testArray(props.defaultDate)) {
			defDate = [dayuts(props.defaultDate as any).format("YYYY-MM-DD")]
		} else {
			let tmp = dayuts((props.defaultDate as Array<any>)[0] as any).format("YYYY-MM-DD")
			defDate = [tmp]
		}
	} else {
		if (!testArray(props.defaultDate)) return
		defDate = props.defaultDate as Array<string>
	}
	defDate = defDate.filter(it => {
		const d = dayuts(it as any).format("YYYY-MM-DD")
		return d >= minDate && d <= maxDate
	})
	setSelected(defDate, false)
}

function getWrapperWidth() {
	upGetRect('.up-calendar-month-wrapper', false, instance?.proxy).then((res) => {
		let size = res as NodeInfo
		let w = size.width ?? 0
		if (w <= 0) {
			w = getWindowInfo().windowWidth
		}
		width.value = w
	})
}

function getMonthRect() {
	const promiseAllArr = props.months.map((item: CalendarMonthItem, index: number): Promise<NodeInfo> => {
		return upGetRect(`.up-calendar-month-${index}`, false, instance?.proxy)
	})
	Promise.all(promiseAllArr).then((res) => {
		let sizes = res as NodeInfo[]
		let height = 1
		const topArr = [] as Array<number>
		for (let i = 0; i < props.months.length; i++) {
			topArr.push(height)
			height += sizes[i].height ?? 0
		}
		emit('updateMonthTop', topArr)
	})
}

function init() {
	nextTick(() => {
		getWrapperWidth()
		getMonthRect()
	})
}

watch((): Array<any | null> => [props.minDate, props.maxDate, props.defaultDate] as Array<any | null>, () => {
	setDefaultDate()
}, { immediate: true })

watch((): Array<CalendarMonthItem> => props.months, (n: Array<CalendarMonthItem>) => {
	monthsInner.value = n
}, { immediate: true })

onMounted(() => {
	init()
})

defineExpose({
	init,
	setDefaultDate,
	setSelected
})
</script>

<style lang="scss" scoped>
	@import "../../libs/css/components.scss";

	.up-calendar-month-wrapper {
		margin-top: 4px;
	}

	.up-calendar-month {

		&__title {
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			height: 42px;
		}

		&__title-text {
			font-size: 14px;
			line-height: 42px;
			color: $up-main-color;
			text-align: center;
			font-weight: bold;
		}

		&__days {
			position: relative;
			@include flex;
			flex-wrap: wrap;

			&__month-mark-wrapper {
				position: absolute;
				top: 0;
				bottom: 0;
				left: 0;
				right: 0;
				@include flex;
				justify-content: center;
				align-items: center;

				&__text {
					font-size: 155px;
					color: rgba(231, 232, 234, 0.83);
				}
			}

			&__day {
				@include flex;
				padding: 2px;
				/* #ifndef APP */
				width: calc(100% / 7);
				box-sizing: border-box;
				/* #endif */
				/* #ifdef APP */
				width: 14.285%;
				/* #endif */

				&__select {
					flex: 1;
					@include flex;
					align-items: center;
					justify-content: center;
					position: relative;

					&__range-bg {
						position: absolute;
						top: 0;
						bottom: 0;
						left: 0;
						right: 0;
						z-index: 1;
						background-color: $up-primary;
						opacity: 0.15;
					}

					&__dot {
						width: 7px;
						height: 7px;
						border-radius: 100px;
						background-color: $up-error;
						position: absolute;
						top: 12px;
						right: 7px;
						z-index: 2;
					}

					&__buttom-info {
						color: $up-content-color;
						text-align: center;
						position: absolute;
						bottom: 5px;
						font-size: 10px;
						text-align: center;
						left: 0;
						right: 0;
						z-index: 2;

						&--selected {
							color: #ffffff;
						}

						&--disabled {
							color: #cacbcd;
						}
					}

					&__info {
						text-align: center;
						font-size: 16px;
						position: relative;
						z-index: 2;

						&--selected {
							color: #ffffff;
						}

						&--disabled {
							color: #cacbcd;
						}

						&--range-middle {
							color: $up-primary;
						}
					}

					&--today {
						border-width: 1px;
						border-style: solid;
						border-color: $up-primary;
						box-sizing: border-box;
					}

					&--selected {
						background-color: $up-primary;
						@include flex;
						justify-content: center;
						align-items: center;
						flex: 1;
						border-radius: 3px;
					}

					&--range-selected {
						opacity: 0.3;
						border-radius: 0;
					}

					&--range-start-selected {
						border-top-right-radius: 0;
						border-bottom-right-radius: 0;
					}

					&--range-end-selected {
						border-top-left-radius: 0;
						border-bottom-left-radius: 0;
					}
				}
			}
		}
	}
</style>
