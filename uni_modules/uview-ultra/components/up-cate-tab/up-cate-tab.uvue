<template>
	<view class="up-cate-tab" :style="cateStyle">
		<view class="up-cate-tab__wrap">
			<scroll-view
				class="up-cate-tab__view up-cate-tab__menu-scroll-view"
				direction="vertical"
				scroll-with-animation
				:scroll-top="scrollTop"
				:scroll-into-view="itemId"
			>
				<view
					v-for="(item, index) in getTabList()"
					:key="index"
					:id="'tab' + index.toString()"
					class="up-cate-tab__item"
					:class="[innerCurrent == index ? 'up-cate-tab__item-active' : '']"
					@tap.stop="swichMenu(index)"
				>
					<slot name="tabItem" :item="item"></slot>
					<text class="up-cate-tab__item-text" :class="[innerCurrent == index ? 'up-cate-tab__item-text-active' : '']">{{ getTabLabel(item) }}</text>
				</view>
			</scroll-view>
			<scroll-view
				direction="vertical"
				scroll-with-animation
				class="up-cate-tab__right-box"
				:scroll-top="scrollRightTop"
				:scroll-into-view="scrollIntoView"
				@scroll="rightScroll"
			>
				<view class="up-cate-tab__right-top">
					<slot name="rightTop" :tabList="getTabList()"></slot>
				</view>
				<view class="up-cate-tab__page-view">
					<template v-for="(item, index) in getTabList()" :key="index">
						<view
							v-if="mode == 'follow' || (mode == 'tab' && index == innerCurrent)"
							class="up-cate-tab__page-item"
							:id="'item' + index.toString()"
						>
							<slot name="itemList" :item="item"></slot>
							<view class="item-title">
								<text>{{ getTabLabel(item) }}</text>
							</view>
							<view class="item-container">
								<template v-for="(item1, index1) in getChildren(item)" :key="index1">
									<slot name="pageItem" :pageItem="item1"></slot>
									<view class="thumb-box">
										<image class="item-menu-image" :src="getItemIcon(item1)" mode=""></image>
										<text class="item-menu-name">{{ getItemLabel(item1) }}</text>
									</view>
								</template>
							</view>
						</view>
					</template>
				</view>
			</scroll-view>
		</view>
	</view>
</template>

<script setup lang="uts">
import { ref, computed, watch, onMounted, getCurrentInstance } from 'vue'

function toText(value: any | null): string {
	return value == null ? '' : value.toString()
}

function addUnit(value: string): string {
	if (value.length == 0) return '0px'
	if (value.endsWith('%') || value.endsWith('px') || value.endsWith('rpx') || value.endsWith('vh')) {
		return value
	}
	return value + 'px'
}

defineOptions({
	name: 'up-cate-tab'
})

const props = defineProps({
	mode: {
		type: String,
		default: 'follow'
	},
	height: {
		type: String,
		default: '100%'
	},
	tabList: {
		type: Array as PropType<Array<UTSJSONObject>>,
		default: () => [] as Array<UTSJSONObject>
	},
	tabKeyName: {
		type: String,
		default: 'name'
	},
	itemKeyName: {
		type: String,
		default: 'name'
	},
	current: {
		type: Number,
		default: 0
	}
})

const emit = defineEmits(['update:current'])
const instance = getCurrentInstance()

const scrollTop = ref<number>(0)
const scrollIntoView = ref<string>('')
const oldScrollTop = ref<number>(0)
const innerCurrent = ref<number>(props.current)
const menuHeight = ref<number>(0)
const menuItemHeight = ref<number>(0)
const itemId = ref<string>('')
const menuItemPos = ref<Array<number>>([])
const rects = ref<Array<NodeInfo>>([])
const arr = ref<Array<number>>([])
const scrollRightTop = ref<number>(0)
let timerActive = false

const cateStyle = computed<UTSJSONObject>(() => {
	return { height: addUnit(props.height) } as UTSJSONObject
})

function getTabList(): Array<UTSJSONObject> {
	return props.tabList
}

function getTabLabel(item: UTSJSONObject): string {
	return toText(item[props.tabKeyName])
}

function getChildren(item: UTSJSONObject): Array<UTSJSONObject> {
	const value = item['children']
	return value == null ? [] as Array<UTSJSONObject> : value as Array<UTSJSONObject>
}

function getItemLabel(item: UTSJSONObject): string {
	return toText(item[props.itemKeyName])
}

function getItemIcon(item: UTSJSONObject): string {
	return toText(item['icon'])
}

function getElRect(className: string, dataVal: string): void {
	uni.createSelectorQuery()
		.in(instance?.proxy)
		.select('.' + className)
		.boundingClientRect()
		.exec((res: Array<any>) => {
			if (res.length == 0 || res[0] == null) {
				setTimeout(() => {
					getElRect(className, dataVal)
				}, 30)
				return
			}
			const rect = res[0] as NodeInfo
			const h = rect.height ?? 0
			if (dataVal == 'menuHeight') {
				menuHeight.value = h
			} else if (dataVal == 'menuItemHeight') {
				menuItemHeight.value = h
			}
		})
}

function leftMenuStatus(index: number): void {
	const list = getTabList()
	if (list.length == 0) return
	const nextIndex = Math.max(0, Math.min(index, list.length - 1))
	innerCurrent.value = nextIndex
	emit('update:current', nextIndex)
	if (menuHeight.value == 0) {
		getElRect('up-cate-tab__menu-scroll-view', 'menuHeight')
	}
	if (menuItemHeight.value == 0) {
		getElRect('up-cate-tab__item', 'menuItemHeight')
	}
	if (menuHeight.value > 0 && menuItemHeight.value > 0) {
		scrollTop.value = nextIndex * menuItemHeight.value + menuItemHeight.value / 2 - menuHeight.value / 2
		itemId.value = 'tab' + nextIndex.toString()
	}
}

function getMenuItemTop(): void {
	uni.createSelectorQuery()
		.in(instance?.proxy)
		.selectAll('.up-cate-tab__page-item')
		.boundingClientRect()
		.exec((res: Array<any>) => {
			if (res.length == 0 || res[0] == null) {
				setTimeout(() => {
					getMenuItemTop()
				}, 100)
				return
			}
			const rList = res[0] as Array<NodeInfo>
			if (rList.length == 0) return
			rects.value = rList
			arr.value = [] as Array<number>
			const firstTop = rList[0].top ?? 0
			for (let i = 0; i < rList.length; i++) {
				const top = rList[i].top ?? 0
				arr.value.push(top - firstTop)
			}
		})
}

function deferRefresh(): void {
	setTimeout(() => {
		getMenuItemTop()
		leftMenuStatus(innerCurrent.value)
	}, 50)
}

function swichMenu(index: number): void {
	if (index < 0 || index >= getTabList().length) return
	if (props.mode == 'follow') {
		if (arr.value.length == 0) {
			getMenuItemTop()
		}
		const target = 'item' + index.toString()
		if (scrollIntoView.value != target) {
			scrollIntoView.value = target
		}
	} else {
		scrollRightTop.value = 0
	}
	if (index == innerCurrent.value) return
	innerCurrent.value = index
	leftMenuStatus(index)
	emit('update:current', index)
}

function deferSwitch(index: number): void {
	setTimeout(() => {
		swichMenu(index)
	}, 50)
}

function rightScroll(e: UniScrollEvent): void {
	if (props.mode != 'follow') return
	const detail = e.detail as UTSJSONObject
	const st = detail['scrollTop'] as number
	oldScrollTop.value = st
	if (arr.value.length == 0) {
		getMenuItemTop()
	}
	if (timerActive) return
	timerActive = true
	setTimeout(() => {
		timerActive = false
		const scrollHeight = st + 1
		for (let i = 0; i < arr.value.length; i++) {
			const height1 = arr.value[i]
			const height2 = i + 1 < arr.value.length ? arr.value[i + 1] : -1
			if (height2 == -1 || (scrollHeight >= height1 && scrollHeight <= height2)) {
				leftMenuStatus(i)
				return
			}
		}
	}, 100)
}

watch(() => props.tabList, () => {
	deferRefresh()
}, { immediate: true })

watch(() => props.current, (nval: number) => {
	innerCurrent.value = nval
	leftMenuStatus(nval)
	deferSwitch(nval)
})

watch(() => props.height, () => {
	deferRefresh()
})

onMounted(() => {
	innerCurrent.value = props.current
	leftMenuStatus(innerCurrent.value)
	deferRefresh()
	deferSwitch(innerCurrent.value)
})

defineExpose({
	swichMenu
})
</script>

<style lang="scss" scoped>
.up-cate-tab {
	display: flex;
	flex-direction: column;
}

.up-cate-tab__wrap {
	flex: 1;
	display: flex;
	flex-direction: row;
	overflow: hidden;
}

.up-cate-tab__view {
	width: 200rpx;
	height: 100%;
}

.up-cate-tab__item {
	height: 110rpx;
	background: #f6f6f6;
	box-sizing: border-box;
	display: flex;
	align-items: center;
	justify-content: center;
}

.up-cate-tab__item-active {
	background: #ffffff;
	border-left-width: 4px;
	border-left-style: solid;
	border-left-color: #2979ff;
}

.up-cate-tab__item-text {
	font-size: 26rpx;
	color: #444444;
	font-weight: 400;
	line-height: 1;
}

.up-cate-tab__item-text-active {
	color: #000000;
	font-size: 30rpx;
	font-weight: 600;
}

.up-cate-tab__right-box {
	flex: 1;
	background-color: rgb(250, 250, 250);
}

.up-cate-tab__right-top {
	display: flex;
}

.up-cate-tab__page-view {
	padding: 16rpx;
}

.up-cate-tab__page-item {
	margin-bottom: 30rpx;
	background-color: #ffffff;
	padding: 16rpx;
	border-radius: 8rpx;
}

.item-title {
	font-size: 26rpx;
	color: #303133;
	font-weight: bold;
}

.item-container {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
}

.thumb-box {
	width: 33.333333%;
	display: flex;
	align-items: center;
	justify-content: center;
	flex-direction: column;
	margin-top: 20rpx;
}

.item-menu-image {
	width: 120rpx;
	height: 120rpx;
}

.item-menu-name {
	font-weight: normal;
	font-size: 24rpx;
	color: #303133;
}
</style>
