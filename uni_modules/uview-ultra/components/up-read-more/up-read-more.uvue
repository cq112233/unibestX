<template>
	<view class="up-read-more">
		<view
		    class="up-read-more__content"
		    :style="{
				height: isLongContent && status === 'close' ? addUnit(showHeight) : 'auto'
			}"
		>
			<view
			    class="up-read-more__content__inner"
			    :class="[elId]"
			>
				<slot></slot>
			</view>
		</view>
		<view
		    class="up-read-more__toggle"
		    :style="[innerShadowStyle]"
		    v-if="isLongContent"
		>
			<slot name="toggle">
				<view
				    class="up-read-more__toggle__text"
				    @tap="toggleReadMore"
				>
					<up-text
					    :text="status === 'close' ? closeText : openText"
					    :color="color"
					    :size="fontSize"
					    :lineHeight="fontSize"
					    margin="0 5px 0 0"
					></up-text>
					<view class="up-read-more__toggle__icon">
						<up-icon
						    :color="color"
						    :size="parseInt(getPx(fontSize)) + 2"
						    :name="status === 'close' ? 'arrow-down' : 'arrow-up'"
						></up-icon>
					</view>
				</view>
			</slot>
		</view>
	</view>
</template>

<script setup lang="uts">
import { computed, ref, onMounted, getCurrentInstance } from 'vue'
import { addUnit, guid, getPx, sleep, upGetRect } from '../../libs/function/index'

defineOptions({
  name: 'up-read-more'
})

const props = defineProps({
  showHeight: {
    type: [String, Number],
    default: 400
  },
  toggle: {
    type: Boolean,
    default: false
  },
  closeText: {
    type: String,
    default: '展开阅读全文'
  },
  openText: {
    type: String,
    default: '收起'
  },
  color: {
    type: String,
    default: '#2979ff'
  },
  fontSize: {
    type: [String, Number],
    default: 14
  },
  shadowStyle: {
    type: Object,
    default: () => ({
      backgroundImage: 'linear-gradient(to bottom, rgba(255, 255, 255, 0) 0%, #fff 80%)',
      paddingTop: '100px',
      marginTop: '-100px'
    })
  },
  textIndent: {
    type: String,
    default: '2em'
  },
  name: {
    type: [String, Number],
    default: ''
  }
})

const emit = defineEmits(['open', 'close'])
const instance = getCurrentInstance()

const isLongContent = ref<boolean>(true)
const status = ref<string>('close')
const elId = ref<string>(guid())
const contentHeight = ref<number>(0)
const initRetryCount = ref<number>(0)

const innerShadowStyle = computed<UTSJSONObject>(() => {
  if (status.value === 'open') return {} as UTSJSONObject
  // #ifdef APP
  const appStyle = {} as UTSJSONObject
  appStyle['backgroundColor'] = 'rgba(255, 255, 255, 0.85)'
  const shadow = (props.shadowStyle ?? {}) as UTSJSONObject
  appStyle['paddingTop'] = shadow['paddingTop'] ?? '100px'
  appStyle['marginTop'] = shadow['marginTop'] ?? '-100px'
  return appStyle
  // #endif
  // #ifndef APP
  return (props.shadowStyle ?? {}) as UTSJSONObject
  // #endif
})

async function getContentHeight(): Promise<NodeInfo> {
  return new Promise(resolve => {
    upGetRect('.' + elId.value, false, instance?.proxy).then((res: NodeInfo) => {
      resolve(res)
    })
  })
}

async function init() {
  await sleep(150)
  getContentHeight().then((size: NodeInfo) => {
    contentHeight.value = size.height ?? 0
    if (contentHeight.value <= 0) {
      initRetryCount.value = initRetryCount.value + 1
      if (initRetryCount.value <= 3) {
        setTimeout(() => { init() }, 200)
      }
      return
    }
    if (contentHeight.value <= parseFloat(getPx(props.showHeight))) {
      isLongContent.value = false
      status.value = 'close'
    }
  })
}

function toggleReadMore() {
  status.value = status.value === 'close' ? 'open' : 'close'
  if (props.toggle == false) isLongContent.value = false
  emit(status.value, props.name)
}

onMounted(() => {
  init()
})
</script>

<style lang="scss" scoped>
.up-read-more {

	&__content {
		overflow: hidden;
	}

	&__toggle {
		@include flex;
		justify-content: center;
		position: relative;

		&__text {
			@include flex;
			align-items: center;
			justify-content: center;
			margin-top: 5px;
		}
	}
}
</style>
