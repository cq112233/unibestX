<template>
	<view
		v-if="inited"
		class="up-transition"
		ref="upTransitionRef"
		@tap="clickHandler"
		:class="[classes, customClass]"
		:style="mergeStyle"
	>
		<slot />
	</view>
</template>

<script setup lang="uts">
import { computed, ref, shallowRef, watch, nextTick, onUnmounted } from 'vue'
import defProps from './transition.uts'
import { addStyle, deepMerge, sleep } from '../../libs/function/index.uts'

defineOptions({
  name: 'up-transition'
})

const props = defineProps({
  show: {
    type: Boolean,
    default: false
  },
  mode: {
    type: String,
    default: 'fade'
  },
  duration: {
    type: [Number, String],
    default: '300'
  },
  timingFunction: {
    type: String,
    default: 'ease-out'
  },
  customStyle: {
    type: Object,
    default: () => ({})
  },
  customClass: {
    type: String,
    default: ''
  }
})

const emit = defineEmits(['click', 'beforeEnter', 'enter', 'afterEnter', 'beforeLeave', 'leave', 'afterLeave'])

const upTransitionRef = shallowRef<UniElement | null>(null)
const inited = ref<boolean>(false)
const viewStyle = ref<UTSJSONObject>({} as UTSJSONObject)
const status = ref<string>('')
const transitionEnded = ref<boolean>(false)
const display = ref<boolean>(false)
const classes = ref<string>('')
const currentDuration = ref<number>(0)
let enterTimer: number | null = null
let leaveTimer: number | null = null
// 动画世代计数器：每次发起 enter/leave 时递增，异步恢复后检查是否已被更新的操作取代
let animationId: number = 0

function clearTimers(): void {
  if (enterTimer != null) {
    clearTimeout(enterTimer!)
    enterTimer = null
  }
  if (leaveTimer != null) {
    clearTimeout(leaveTimer!)
    leaveTimer = null
  }
}

const getClassNames = function (name: string): UTSJSONObject {
  return {
    'enter': `up-${name}-enter up-${name}-enter-active`,
    'enter-to': `up-${name}-enter-to up-${name}-enter-active`,
    'leave': `up-${name}-leave up-${name}-leave-active`,
    'leave-to': `up-${name}-leave-to up-${name}-leave-active`
  } as UTSJSONObject
}

const getModeStyle = function (mode: string, state: string): UTSJSONObject {
  const style = {} as UTSJSONObject
  if (mode == 'none') {
    return style
  }
  if (state == 'enter' || state == 'leave-to') {
    if (mode == 'fade') {
      style['opacity'] = 0
    } else if (mode == 'zoom') {
      style['transform'] = 'scale(0.95)'
    } else if (mode == 'fade-zoom') {
      style['transform'] = 'scale(0.95)'
      style['opacity'] = 0
    } else if (mode == 'fade-up') {
      style['transform'] = 'translateY(100%)'
      style['opacity'] = 0
    } else if (mode == 'fade-down') {
      style['transform'] = 'translateY(-100%)'
      style['opacity'] = 0
    } else if (mode == 'fade-left') {
      style['transform'] = 'translateX(-100%)'
      style['opacity'] = 0
    } else if (mode == 'fade-right') {
      style['transform'] = 'translateX(100%)'
      style['opacity'] = 0
    } else if (mode == 'slide-up') {
      style['transform'] = 'translateY(100%)'
    } else if (mode == 'slide-down') {
      style['transform'] = 'translateY(-100%)'
    } else if (mode == 'slide-left') {
      style['transform'] = 'translateX(-100%)'
    } else if (mode == 'slide-right') {
      style['transform'] = 'translateX(100%)'
    }
  } else if (state == 'enter-to' || state == 'leave') {
    if (mode == 'fade') {
      style['opacity'] = 1
    } else if (mode == 'zoom') {
      style['transform'] = 'scale(1)'
    } else if (mode == 'fade-zoom') {
      style['transform'] = 'scale(1)'
      style['opacity'] = 1
    } else if (mode == 'fade-up' || mode == 'slide-up') {
      style['transform'] = 'translateY(0)'
      if (mode.startsWith('fade')) {
        style['opacity'] = 1
      }
    } else if (mode == 'fade-down' || mode == 'slide-down') {
      style['transform'] = 'translateY(0)'
      if (mode.startsWith('fade')) {
        style['opacity'] = 1
      }
    } else if (mode == 'fade-left' || mode == 'slide-left') {
      style['transform'] = 'translateX(0)'
      if (mode.startsWith('fade')) {
        style['opacity'] = 1
      }
    } else if (mode == 'fade-right' || mode == 'slide-right') {
      style['transform'] = 'translateX(0)'
      if (mode.startsWith('fade')) {
        style['opacity'] = 1
      }
    }
  }
  return style
}

function getTransitionProp(modeVal: string): string {
  if (modeVal == 'fade') {
    return 'opacity'
  } else if (modeVal.startsWith('slide')) {
    return 'transform'
  } else if (modeVal.startsWith('fade-zoom') || modeVal == 'zoom' || modeVal.startsWith('fade-up') || modeVal.startsWith('fade-down') || modeVal.startsWith('fade-left') || modeVal.startsWith('fade-right')) {
    return 'transform, opacity'
  } else if (modeVal == 'none') {
    return 'none'
  }
  return 'all'
}

function applyModeStyleToEl(el: UniElement, mode: string, state: string): void {
  const style = getModeStyle(mode, state)
  const keys = UTSJSONObject.keys(style)
  for (let i = 0; i < keys.length; i++) {
    const key = keys[i]
    const val = style[key]?.toString() ?? ''
    el.style.setProperty(key, val)
  }
}

const mergeStyle = computed<UTSJSONObject>(() => {
  const modeVal = (props.mode != '' ? props.mode : 'fade')
  const transitionProp = getTransitionProp(modeVal)

  const res = {
    transitionProperty: transitionProp,
    transitionDuration: `${currentDuration.value}ms`,
    transitionTimingFunction: props.timingFunction,
  } as UTSJSONObject
  const custom = addStyle(props.customStyle) as UTSJSONObject
  return deepMerge(deepMerge(res, custom), viewStyle.value) as UTSJSONObject
})

function clickHandler() {
  emit('click')
}

function onTransitionEnd(expectedId: number = -1) {
  // 如果传入了 expectedId 且当前 animationId 已变化，说明有更新的 enter/leave 启动了，丢弃此回调
  if (expectedId >= 0 && expectedId != animationId) return
  if (transitionEnded.value) return
  transitionEnded.value = true
  emit(status.value == 'leave' ? 'afterLeave' : 'afterEnter')
  if (!props.show && display.value) {
    display.value = false
    inited.value = false
  }
}

function applyCustomStyleToEl(el: UniElement, customStyle: any): void {
  const obj = addStyle(customStyle) as UTSJSONObject
  const keys = UTSJSONObject.keys(obj)
  for (let i = 0; i < keys.length; i++) {
    const key = keys[i]
    const val = obj[key]?.toString() ?? ''
    el.style.setProperty(key, val)
  }
}

async function vueEnter(): Promise<void> {
  clearTimers()
  const myId = ++animationId
  transitionEnded.value = false
  const classNames = getClassNames(props.mode)
  status.value = 'enter'
  emit('beforeEnter')
  inited.value = true
  display.value = true
  classes.value = classNames['enter']?.toString() ?? ''
  viewStyle.value = getModeStyle(props.mode, 'enter')
  currentDuration.value = 0

  await nextTick()
  if (animationId != myId) return

  let el = upTransitionRef.value
  if (el == null) {
    await sleep(20)
    if (animationId != myId) return
    el = upTransitionRef.value
  }

  const durationMs = Math.max(0, parseInt(props.duration != null ? props.duration.toString() : '300'))
  const transitionProp = getTransitionProp(props.mode)

  if (el != null && el.style != null) {
    applyCustomStyleToEl(el, props.customStyle)
    el.style.setProperty('transition-property', transitionProp)
    el.style.setProperty('transition-duration', '0ms')
    applyModeStyleToEl(el, props.mode, 'enter')
  }

  if (durationMs <= 0 || props.mode == 'none') {
    classes.value = classNames['enter-to']?.toString() ?? ''
    viewStyle.value = getModeStyle(props.mode, 'enter-to')
    if (el != null && el.style != null) {
      applyModeStyleToEl(el, props.mode, 'enter-to')
    }
    emit('enter')
    onTransitionEnd(myId)
    return
  }

  // 等待 40ms 确保 Native 渲染引擎（Vapor 模式与 VDOM 模式）完成初始位置的首帧测量与绘制
  await sleep(40)
  if (animationId != myId) return

  if (status.value != 'enter' || !props.show) {
    return
  }

  emit('enter')
  transitionEnded.value = false

  currentDuration.value = durationMs
  classes.value = classNames['enter-to']?.toString() ?? ''
  viewStyle.value = getModeStyle(props.mode, 'enter-to')

  if (el == null) {
    el = upTransitionRef.value
  }

  if (el != null && el.style != null) {
    applyCustomStyleToEl(el, props.customStyle)
    el.style.setProperty('transition-property', transitionProp)
    el.style.setProperty('transition-duration', `${durationMs}ms`)
    el.style.setProperty('transition-timing-function', props.timingFunction)
    applyModeStyleToEl(el, props.mode, 'enter-to')
  }

  enterTimer = setTimeout(() => {
    onTransitionEnd(myId)
  }, durationMs)
}

async function vueLeave(): Promise<void> {
  if (!display.value) return
  clearTimers()
  const myId = ++animationId
  transitionEnded.value = false
  const classNames = getClassNames(props.mode)
  status.value = 'leave'
  emit('beforeLeave')

  const durationMs = Math.max(0, parseInt(props.duration != null ? props.duration.toString() : '300'))
  currentDuration.value = durationMs

  classes.value = classNames['leave']?.toString() ?? ''
  viewStyle.value = getModeStyle(props.mode, 'leave')

  await nextTick()
  // 关键：如果在 await 期间有新的 enter/leave 发起，当前操作已过时，必须丢弃
  if (animationId != myId) return

  transitionEnded.value = false
  emit('leave')

  let el = upTransitionRef.value

  if (durationMs <= 0 || props.mode == 'none') {
    classes.value = classNames['leave-to']?.toString() ?? ''
    viewStyle.value = getModeStyle(props.mode, 'leave-to')
    if (el != null && el.style != null) {
      applyModeStyleToEl(el, props.mode, 'leave-to')
    }
    onTransitionEnd(myId)
    return
  }

  classes.value = classNames['leave-to']?.toString() ?? ''
  viewStyle.value = getModeStyle(props.mode, 'leave-to')

  if (el != null && el.style != null) {
    const transitionProp = getTransitionProp(props.mode)
    el.style.setProperty('transition-property', transitionProp)
    el.style.setProperty('transition-duration', `${durationMs}ms`)
    el.style.setProperty('transition-timing-function', props.timingFunction)
    applyModeStyleToEl(el, props.mode, 'leave-to')
  }

  leaveTimer = setTimeout(() => {
    onTransitionEnd(myId)
  }, durationMs)
}

watch((): boolean => props.show, (newVal: boolean) => {
  if (newVal) {
    vueEnter()
  } else {
    vueLeave()
  }
}, { immediate: true })

watch((): string => props.mode, (newMode: string, oldMode: string) => {
  if (newMode != oldMode && props.show && display.value) {
    vueEnter()
  }
})

onUnmounted(() => {
  clearTimers()
})
</script>

<style lang="scss" scoped>
@import '../../libs/css/components.scss';
@import './vue.ani-style.scss';

.up-transition {}
</style>
