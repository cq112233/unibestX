<template>
	<view class="up-short-video">
		<view class="up-short-video__header">
			<slot name="menu">
				<view class="up-short-video__header__menu">
					<up-icon name="grid" size="24"></up-icon>
				</view>
			</slot>
			
			<up-tabs 
				:list="tabsList" 
				:current="currentTab"
                lineColor="#ddd"
                :activeStyle="{
                    color: '#ddd',
                    fontWeight: 400,
                    transform: 'scale(1)'
                }"
                :inactiveStyle="{
                    color: '#bbb',
                    transform: 'scale(1)'
                }"
				@change="handleTabChange"
				class="up-short-video__header__tabs"
			></up-tabs>
			
			<slot name="search">
				<view class="up-short-video__header__search">
					<up-icon name="search" size="24"></up-icon>
				</view>
			</slot>
		</view>
		
		<swiper 
			:vertical="true" 
			:autoplay="false" 
			@change="handleSwiperChange"
			:current="currentVideo"
			class="up-short-video__content"
		>
			<swiper-item v-for="(item, index) in videoItems" :key="index">
				<view class="up-short-video__content__item">
					<view class="up-short-video__content__video">
						<video 
							:id="getVideoId(index)"
							:src="getVideoUrl(item)" 
							:autoplay="index === currentVideo" 
							:controls="false"
							:show-fullscreen-btn="false"
							:show-play-btn="false"
							:show-center-play-btn="false"
							:enable-progress-gesture="true"
							:loop="true"
							:playback-rate="getPlaybackRate(item)"
							@play="onVideoPlay"
							@pause="onVideoPause"
							@ended="onVideoEnded"
							@timeupdate="onTimeUpdate"
							@loadedmetadata="onLoadedMetadata"
							style="width: 100%; height: 100%;"
						></video>
					</view>
					
					<view class="up-short-video__content__author">
						<view class="up-short-video__content__author__avatar">
							<up-avatar :src="getAuthorAvatar(item)" size="50px"></up-avatar>
						</view>
						<view class="up-short-video__content__author__info">
							<text class="up-short-video__content__author__name">{{ getAuthorName(item) }}</text>
							<text class="up-short-video__content__author__desc">{{ getAuthorDesc(item) }}</text>
						</view>
						<view class="up-short-video__content__author__follow">
							<up-button type="primary" size="mini">Follow</up-button>
						</view>
					</view>
					
					<view class="up-short-video__content__actions">
						<slot name="actions" :item="item" :index="index">
							<view class="up-short-video__content__actions__item" @click="handleLike(item, index)">
								<up-icon color="#eee" :name="isLiked(item) ? 'thumb-up-fill' : 'thumb-up'" size="32px"></up-icon>
								<text class="up-short-video__content__actions__text">{{ getCountText(item, 'likeCount') }}</text>
							</view>
							<view class="up-short-video__content__actions__item" @click="handleComment(item, index)">
								<up-icon color="#eee" name="chat" size="32px"></up-icon>
								<text class="up-short-video__content__actions__text">{{ getCountText(item, 'commentCount') }}</text>
							</view>
							<view class="up-short-video__content__actions__item" @click="handleShare(item, index)">
								<up-icon color="#eee" name="share" size="32px"></up-icon>
								<text class="up-short-video__content__actions__text">{{ getCountText(item, 'shareCount') }}</text>
							</view>
							<view class="up-short-video__content__actions__item" @click="handleCollect(item, index)">
								<up-icon color="#eee" :name="isCollected(item) ? 'bookmark-fill' : 'bookmark'" size="32px"></up-icon>
								<text class="up-short-video__content__actions__text">{{ getCountText(item, 'collectCount') }}</text>
							</view>
						</slot>
					</view>
				</view>
			</swiper-item>
		</swiper>
		
		<up-action-sheet
			:show="showSpeedSheet"
			:actions="speedOptions"
			title="Playback speed"
			@close="showSpeedSheet = false"
			@select="selectSpeed"
		></up-action-sheet>
		
		<view class="up-short-video__footer">
			<view class="up-short-video__progress" style="z-index: 999;">
				<up-slider 
					:value="currentProgress" 
					:min="0" 
					:max="100" 
					:step="1"
					:show-value="false"
                    :innerStyle="{ padding: 0 }"
                    activeColor="rgba(255,255,255,0.32)"
					inactive-color="rgba(255,255,255,0.3)"
					block-size="6px"
                    block-color="rgba(255,255,255,0.5)"
					height="1px"
					@changing="onProgressChanging"
					@change="onProgressChange"
				></up-slider>
			</view>
			
			<slot name="tabbar">
				<up-tabbar
                    :fixed="true"
                    :placeholder="true"
                    :safeAreaInsetBottom="true"
                    borderColor="rgba(255,255,255,0.25) !important"
                    backgroundColor="rgba(255,255,255,0.05)"
                >
					<up-tabbar-item
						@click="goNext"
						text="Home"
						icon="home"
					>
					</up-tabbar-item>
					<up-tabbar-item
						text="Discover"
						icon="photo"
					></up-tabbar-item>
					<up-tabbar-item
						text="Live"
						icon="play-right"
					></up-tabbar-item>
					<up-tabbar-item
						text="Mine"
						icon="account"
					></up-tabbar-item>
				</up-tabbar>
			</slot>
		</view>
	</view>
</template>

<script setup lang="uts">
import { ref, computed, watch, nextTick, getCurrentInstance } from 'vue'

function createTabsList(): Array<UTSJSONObject> {
	const tabs = [] as Array<UTSJSONObject>
	const names = ['Recommend', 'Follow', 'Friends', 'Local']
	for (let i = 0; i < names.length; i++) {
		const item = {} as UTSJSONObject
		item['name'] = names[i]
		tabs.push(item)
	}
	return tabs
}

function createVideoList(): Array<UTSJSONObject> {
	return [] as Array<UTSJSONObject>
}

function createSpeedOptions(): Array<UTSJSONObject> {
	const options = [] as Array<UTSJSONObject>
	const values = [0.5, 0.75, 1.0, 1.25, 1.5, 2.0]
	for (let i = 0; i < values.length; i++) {
		const item = {} as UTSJSONObject
		item['name'] = `${values[i]}x`
		item['value'] = values[i]
		options.push(item)
	}
	return options
}

function copyObject(item: UTSJSONObject): UTSJSONObject {
	const copied = {} as UTSJSONObject
	const keys = UTSJSONObject.keys(item)
	for (let i = 0; i < keys.length; i++) {
		const key = keys[i]
		const value = item[key]
		if (value != null && typeof value === 'object' && !Array.isArray(value)) {
			copied[key] = copyObject(value as UTSJSONObject)
		} else {
			copied[key] = value
		}
	}
	return copied
}

function copyVideoList(list: Array<UTSJSONObject>): Array<UTSJSONObject> {
	const copied = [] as Array<UTSJSONObject>
	for (let i = 0; i < list.length; i++) {
		copied.push(copyObject(list[i]))
	}
	return copied
}

function normalizeNumber(value: any | null, defaultValue: number = 0): number {
	if (typeof value === 'number') {
		return value as number
	}
	if (value == null) {
		return defaultValue
	}
	const parsed = parseFloat(value.toString())
	return isNaN(parsed) ? defaultValue : parsed
}

function stringValue(value: any | null): string {
	return value == null ? '' : value.toString()
}

function booleanValue(value: any | null): boolean {
	if (typeof value === 'boolean') {
		return value as boolean
	}
	return value != null && value.toString() == 'true'
}

defineOptions({
	name: 'up-short-video'
})

const props = defineProps({
	tabsList: {
		type: Array as PropType<Array<UTSJSONObject>>,
		default: () => createTabsList()
	},
	videoList: {
		type: Array as PropType<Array<UTSJSONObject>>,
		default: () => createVideoList()
	},
	currentTab: {
		type: Number,
		default: 0
	},
	currentVideo: {
		type: Number,
		default: 0
	}
})

const emit = defineEmits([
	'tabChange',
	'videoChange',
	'like',
	'comment',
	'share',
	'collect',
	'progressChanging',
	'progressChange',
	'videoPlay',
	'videoPause',
	'videoEnded',
	'timeUpdate',
	'loadedMetadata',
	'goNext'
])
const instance = getCurrentInstance()

const internalVideoList = ref<Array<UTSJSONObject>>(createVideoList())
const showSpeedSheet = ref<boolean>(false)
const currentSpeedVideoIndex = ref<number>(0)
const speedOptions = ref<Array<UTSJSONObject>>(createSpeedOptions())

const videoItems = computed<Array<UTSJSONObject>>(() => {
	return internalVideoList.value
})

function getVideoItem(index: number): UTSJSONObject | null {
	const list = videoItems.value
	if (index < 0 || index >= list.length) {
		return null
	}
	return list[index]
}

const currentProgress = computed<number>(() => {
	const item = getVideoItem(props.currentVideo)
	if (item == null) {
		return 0
	}
	return normalizeNumber(item['progress'], 0)
})

function syncVideoList(list: Array<UTSJSONObject>): void {
	internalVideoList.value = copyVideoList(list)
}

function getVideoId(index: number): string {
	return `video-${index}`
}

function getPlaybackRate(item: UTSJSONObject): number {
	return normalizeNumber(item['playbackRate'], 1)
}

function getVideoUrl(item: UTSJSONObject): string {
	return stringValue(item['videoUrl'])
}

function getAuthor(item: UTSJSONObject): UTSJSONObject {
	const author = item['author'] as UTSJSONObject | null
	return author == null ? ({} as UTSJSONObject) : author
}

function getAuthorAvatar(item: UTSJSONObject): string {
	return stringValue(getAuthor(item)['avatar'])
}

function getAuthorName(item: UTSJSONObject): string {
	return stringValue(getAuthor(item)['name'])
}

function getAuthorDesc(item: UTSJSONObject): string {
	return stringValue(getAuthor(item)['desc'])
}

function isLiked(item: UTSJSONObject): boolean {
	return booleanValue(item['isLiked'])
}

function isCollected(item: UTSJSONObject): boolean {
	return booleanValue(item['isCollected'])
}

function getCountText(item: UTSJSONObject, key: string): string {
	return stringValue(item[key])
}

function updateVideoItemValue(index: number, key: string, value: any): void {
	const item = getVideoItem(index)
	if (item == null) {
		return
	}
	item[key] = value
}

function getEventNumber(detail: UTSJSONObject, key: string, defaultValue: number = 0): number {
	return normalizeNumber(detail[key], defaultValue)
}

function handleTabChange(index: number): void {
	emit('tabChange', index)
}

function playVideo(index: number): void {
	const videoContext = uni.createVideoContext(getVideoId(index), instance?.proxy)
	if (videoContext != null) {
		videoContext.play()
	}
}

function pauseCurrentVideo(): void {
	const videoContext = uni.createVideoContext(getVideoId(props.currentVideo), instance?.proxy)
	if (videoContext != null) {
		videoContext.pause()
	}
}

function handleSwiperChange(e: UniCustomEvent<UTSJSONObject>): void {
	const curIndex = getEventNumber(e.detail, 'current', 0)
	pauseCurrentVideo()
	nextTick(() => {
		playVideo(curIndex)
	})
	emit('videoChange', curIndex)
}

function handleLike(item: UTSJSONObject, index: number): void {
	emit('like', { item: item, index: index } as UTSJSONObject)
}

function handleComment(item: UTSJSONObject, index: number): void {
	emit('comment', { item: item, index: index } as UTSJSONObject)
}

function handleShare(item: UTSJSONObject, index: number): void {
	emit('share', { item: item, index: index } as UTSJSONObject)
}

function handleCollect(item: UTSJSONObject, index: number): void {
	emit('collect', { item: item, index: index } as UTSJSONObject)
}

function onProgressChanging(value: UniCustomEvent<UTSJSONObject>): void {
	const progress = getEventNumber(value.detail, 'value', 0)
	updateVideoItemValue(props.currentVideo, 'progressValue', progress)
	emit('progressChanging', {
		progress: progress,
		index: props.currentVideo
	} as UTSJSONObject)
}

function onProgressChange(value: UniCustomEvent<UTSJSONObject>): void {
	const progress = getEventNumber(value.detail, 'value', 0)
	updateVideoItemValue(props.currentVideo, 'progressValue', progress)
	emit('progressChange', {
		progress: progress,
		index: props.currentVideo
	} as UTSJSONObject)
}

function showSpeedOptions(index: number): void {
	currentSpeedVideoIndex.value = index
	showSpeedSheet.value = true
}

function selectSpeed(action: UTSJSONObject): void {
	const videoContext = uni.createVideoContext(getVideoId(currentSpeedVideoIndex.value), instance?.proxy)
	const speed = normalizeNumber(action['value'], 1)
	if (videoContext != null) {
		videoContext.playbackRate(speed)
	}
	updateVideoItemValue(currentSpeedVideoIndex.value, 'playbackRate', speed)
	showSpeedSheet.value = false
}

function onVideoPlay(e: UniEvent): void {
	emit('videoPlay', { index: props.currentVideo, event: e } as UTSJSONObject)
}

function onVideoPause(e: UniEvent): void {
	emit('videoPause', { index: props.currentVideo, event: e } as UTSJSONObject)
}

function onVideoEnded(e: UniEvent): void {
	emit('videoEnded', { index: props.currentVideo, event: e } as UTSJSONObject)
}

function onTimeUpdate(e: UniCustomEvent<UTSJSONObject>): void {
	const currentTime = getEventNumber(e.detail, 'currentTime', 0)
	const duration = getEventNumber(e.detail, 'duration', 0)
	if (duration > 0) {
		updateVideoItemValue(props.currentVideo, 'progress', currentTime / duration * 100)
	}
	emit('timeUpdate', { index: props.currentVideo, event: e } as UTSJSONObject)
}

function onLoadedMetadata(e: UniEvent): void {
	emit('loadedMetadata', { index: props.currentVideo, event: e } as UTSJSONObject)
}

function goNext(): void {
	emit('goNext')
}

watch((): Array<UTSJSONObject> => props.videoList, (newVal: Array<UTSJSONObject>) => {
	syncVideoList(newVal)
}, { immediate: true })

defineExpose({
	playVideo,
	pauseCurrentVideo,
	showSpeedOptions
})
</script>

<style lang="scss" scoped>
	.up-short-video {
		width: 100%;
		height: 100%;
		position: relative;
		
		&__header {
			position: absolute;
			top: 0;
			left: 0;
			right: 0;
			z-index: 10;
			display: flex;
            flex-direction: row;
			align-items: center;
			justify-content: space-between;
			padding: 10px 15px;
			background-color: rgba(255, 255, 255, 0.05);
            opacity: 1;
			
			&__menu, &__search {
				width: 40px;
				height: 40px;
				display: flex;
				align-items: center;
				justify-content: center;
			}
			
			&__tabs {
				flex: 1;
				margin: 0 10px;
			}
		}
		
		&__content {
			width: 100%;
			height: 100%;
			
			&__item {
				width: 100%;
				height: 100%;
				position: relative;
			}
			
			&__video {
				width: 100%;
				height: 100%;
				position: relative;
				
				&__speed {
					position: absolute;
					top: 15px;
					right: 15px;
					z-index: 10;
					background-color: rgba(0, 0, 0, 0.3);
					border-radius: 20px;
					padding: 5px 10px;
					display: flex;
					align-items: center;
					
					.speed-text {
						color: #fff;
						font-size: 12px;
						margin-right: 4px;
					}
				}
			}
			
			&__author {
				position: absolute;
				left: 15px;
				bottom: 100px;
				display: flex;
                flex-direction: row;
				align-items: center;
				z-index: 10;
				
				&__info {
					margin-left: 10px;
					display: flex;
					flex-direction: column;
					justify-content: center;
				}

                &__name {
					color: #eee;
					font-size: 16px;
					font-weight: bold;
					margin-bottom: 5px;
				}
				
				&__desc {
					color: rgba(255, 255, 255, 0.8);
					font-size: 14px;
				}
				
				&__follow {
					margin-left: 15px;
				}
			}
			
			&__actions {
				position: absolute;
				right: 15px;
				bottom: 100px;
				display: flex;
				flex-direction: column;
				align-items: center;
				z-index: 10;
				
				&__item {
					display: flex;
					flex-direction: column;
					align-items: center;
					margin-bottom: 20px;
				}
				
				&__text {
					color: #fff;
					font-size: 12px;
					margin-top: 5px;
				}
			}
		}
		
		&__footer {
			position: absolute;
			bottom: 0;
			left: 0;
			right: 0;
			z-index: 10;
		}
		
		&__progress {
		}
	}
</style>
