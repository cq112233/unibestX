<template>
	<view class="up-navbar-mini" :class="[customClass]">
		<view class="up-navbar-mini__inner" :class="[fixed ? 'up-navbar-mini--fixed' : '']">
			<up-status-bar
				v-if="safeAreaInsetTop"
			></up-status-bar>
			<view
				class="up-navbar-mini__content"
				:style="contentStyle"
			>
				<view
					class="up-navbar-mini__content__left"
					hover-class="up-navbar-mini__content__left--hover"
					hover-start-time="150"
					@tap="leftClick"
				>
					<slot name="left">
						<up-icon
							:name="leftIcon"
							:size="iconSize"
							:color="iconColor"
						></up-icon>
					</slot>
				</view>
				<view style="padding: 10px 10px;">
					<up-line direction="col" color="#fff" length="16px"></up-line>
				</view>
                <view
					class="up-navbar-mini__content__center" @tap="homeClick">
                    <slot name="center">
                        <up-icon name="home" :size="iconSize" :color="iconColor"></up-icon>
                    </slot>
                </view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import { computed } from 'vue'
import { addUnit } from '../../libs/function/index'

defineOptions({
	name: 'up-navbar-mini'
})

const props = defineProps({
	safeAreaInsetTop: {
		type: Boolean,
		default: true
	},
	placeholder: {
		type: Boolean,
		default: false
	},
	fixed: {
		type: Boolean,
		default: false
	},
	leftIcon: {
		type: String,
		default: 'arrow-left'
	},
	bgColor: {
		type: String,
		default: '#ffffff'
	},
	height: {
		type: [String, Number],
		default: '44px'
	},
	iconSize: {
		type: [String, Number],
		default: '20px'
	},
	iconColor: {
		type: String,
		default: '#303133'
	},
	autoBack: {
		type: Boolean,
		default: false
	},
	homeUrl: {
		type: String,
		default: ''
	},
	customClass: {
		type: String,
		default: ''
	}
})

const emit = defineEmits(["leftClick", "homeClick"])

const contentStyle = computed<UTSJSONObject>(() => {
	return {
		height: addUnit(props.height),
		backgroundColor: props.bgColor,
	} as UTSJSONObject
})

function leftClick(): void {
	emit('leftClick')
	if (props.autoBack) {
		uni.navigateBack()
	}
}

function homeClick(): void {
	emit('homeClick')
	if (props.homeUrl != '') {
		uni.reLaunch({ url: props.homeUrl })
	}
}
</script>

<style lang="scss" scoped>
	@import "../../libs/css/components.scss";

	.up-navbar-mini {
        &__inner {
            width: 180rpx;
            overflow: hidden;
        }

		&--fixed {
			position: fixed;
			left: 20px;
			right: 0;
			top: 10px;
			z-index: 11;
		}

		&__content {
			@include flex(row);
            padding: 0 15px;
			border-radius: 20px;
			align-items: center;
			height: 36px;
			background-color: #9acafc;
			position: relative;
			justify-content: space-between;

			&__left {
				@include flex(row);
				align-items: center;

				&--hover {
					opacity: 0.7;
				}
			}
		}
	}
</style>