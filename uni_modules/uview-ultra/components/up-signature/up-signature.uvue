<template>
	<view class="up-signature">
		<view
			class="up-signature__canvas-wrap"
			:style="canvasWrapStyle"
			@touchstart.stop.prevent="touchStart"
			@touchmove.stop.prevent="touchMove"
			@touchend.stop.prevent="touchEnd"
			@touchcancel.stop.prevent="touchEnd"
		>
			<canvas
				:id="canvasId"
				ref="canvasRef"
				class="up-signature__canvas"
				:disable-scroll="true"
				@touchstart.stop.prevent="touchStart"
				@touchmove.stop.prevent="touchMove"
				@touchend.stop.prevent="touchEnd"
				@touchcancel.stop.prevent="touchEnd"
			></canvas>
		</view>

		<view v-if="showToolbar" class="up-signature__toolbar">
			<view class="up-signature__toolbar-icons">
				<view class="up-signature__toolbar-icon" @click="undo">
					<up-icon name="arrow-left" size="22" :color="pathCount == 0 ? '#cccccc' : '#999999'"></up-icon>
				</view>
				<view class="up-signature__toolbar-icon" @click="clearCanvas">
					<up-icon name="trash" size="25" color="#999999"></up-icon>
				</view>
				<view class="up-signature__toolbar-icon" @click="toggleBrushSettings">
					<up-icon name="edit-pen" size="25" color="#999999"></up-icon>
				</view>
				<view class="up-signature__toolbar-icon" @click="toggleColorSettings">
					<up-icon name="grid" size="24" color="#999999"></up-icon>
				</view>
				<view class="up-signature__toolbar-icon" @click="exportSignature">
					<up-icon name="checkmark" size="25" :color="isEmpty ? '#cccccc' : '#999999'"></up-icon>
				</view>
			</view>

			<view v-if="showBrushSettings" class="up-signature__brush-settings">
				<view class="up-signature__progress">
					<text class="up-signature__progress-label">{{ penSizeLabel }}:</text>
					<up-slider
						v-model="lineWidth"
						:min="1"
						:max="20"
						:step="1"
						:value-show="lineWidth"
					></up-slider>
				</view>
			</view>

			<view v-if="showColorSettings" class="up-signature__color-settings">
				<view class="up-signature__color-picker">
					<text class="up-signature__color-label">{{ penColorLabel }}:</text>
					<view class="up-signature__colors">
						<view
							v-for="(color, index) in colorItems"
							:key="index"
							class="up-signature__color-item"
							:class="lineColor == color ? 'up-signature__color-item--active' : ''"
							:style="getColorStyle(color)"
							@click="selectColor(color)"
						></view>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import { ref, computed, watch, onMounted, onUnmounted, nextTick, getCurrentInstance } from 'vue'
import { t } from '../../libs/i18n/index.uts'

type SignaturePoint = {
	x: number,
	y: number,
	type: string,
	color: string,
	width: number
}

type SignatureCanvasContext = CanvasRenderingContext2D

function normalizeNumber(value: any | null, defaultValue: number = 0): number {
	if (typeof value == 'number') {
		return value as number
	}
	if (value == null) {
		return defaultValue
	}
	const parsed = parseFloat(value.toString())
	return isNaN(parsed) ? defaultValue : parsed
}

function createPath(): Array<SignaturePoint> {
	return [] as Array<SignaturePoint>
}

function createPathStack(): Array<Array<SignaturePoint>> {
	return [] as Array<Array<SignaturePoint>>
}

function createColors(): Array<string> {
	return [
		'#000000',
		'#ff0000',
		'#00ff00',
		'#0000ff',
		'#ffff00',
		'#00ffff',
		'#ff00ff',
		'#ffffff'
	] as Array<string>
}

function createPoint(x: number, y: number, type: string, color: string, width: number): SignaturePoint {
	return {
		x,
		y,
		type,
		color,
		width
	} as SignaturePoint
}

defineOptions({
	name: 'up-signature'
})

const props = defineProps({
	width: {
		type: [String, Number],
		default: 300
	},
	height: {
		type: [String, Number],
		default: 200
	},
	bgColor: {
		type: String,
		default: '#ffffff'
	},
	color: {
		type: String,
		default: '#000000'
	},
	thickness: {
		type: [String, Number],
		default: 3
	},
	showToolbar: {
		type: Boolean,
		default: true
	}
})

const emit = defineEmits(['confirm', 'error', 'change', 'clear'])

let canvasCompCount = 0

function makeCanvasId(prefix: string): string {
	return prefix + Date.now().toString() + '_' + (++canvasCompCount).toString()
}

const instance = getCurrentInstance()
const canvasId = ref<string>(makeCanvasId('up-signature-'))
const canvasWidth = ref<number>(normalizeNumber(props.width, 300))
const canvasHeight = ref<number>(normalizeNumber(props.height, 200))
const lineColor = ref<string>(props.color)
const lineWidth = ref<number>(normalizeNumber(props.thickness, 3))
const isDrawing = ref<boolean>(false)
const pathStack = ref<Array<Array<SignaturePoint>>>(createPathStack())
const isEmpty = ref<boolean>(true)
const presetColors = ref<Array<string>>(createColors())
const showBrushSettings = ref<boolean>(false)
const showColorSettings = ref<boolean>(false)

let ctx: SignatureCanvasContext | null = null
let lastDrawX = 0
let lastDrawY = 0
let isDrawingActive = false
let currentPathPoints: Array<SignaturePoint> = []
let cachedRectLeft = 0
let cachedRectTop = 0
let isContextInitialized = false

const canvasRef = ref<UniCanvasElement | null>(null)
let canvasContext: CanvasContext | null = null
let canvasEl: UniCanvasElement | null = null
// #ifdef WEB
let isMouseDown = false
// #endif

const pathCount = computed<number>(() => {
	return pathStack.value.length
})

const colorItems = computed<Array<string>>(() => {
	return presetColors.value
})

const canvasWrapStyle = computed<UTSJSONObject>(() => {
	const style = {} as UTSJSONObject
	style['width'] = canvasWidth.value.toString() + 'px'
	style['height'] = canvasHeight.value.toString() + 'px'
	style['backgroundColor'] = props.bgColor
	style['touchAction'] = 'none'
	return style
})

const penSizeLabel = computed<string>(() => {
	return t('up.signature.penSize', {} as UTSJSONObject)
})

const penColorLabel = computed<string>(() => {
	return t('up.signature.penColor', {} as UTSJSONObject)
})

function getColorStyle(col: string): UTSJSONObject {
	const style = {} as UTSJSONObject
	style['backgroundColor'] = col
	return style
}

function getLineColor(): string {
	return lineColor.value == null ? '#000000' : lineColor.value.toString()
}

function getLineWidth(): number {
	return normalizeNumber(lineWidth.value, 3)
}

function getDrawElement(): UniElement | null {
	if (canvasRef.value != null) {
		return canvasRef.value
	}
	if (canvasEl != null) {
		return canvasEl
	}
	return null
}

function updateRect(): void {
	const el = getDrawElement()
	if (el != null) {
		const rect = el.getBoundingClientRect()
		if (rect != null) {
			cachedRectLeft = rect.left
			cachedRectTop = rect.top
		}
	}
}

function getTouchPoint(e: UniTouchEvent): SignaturePoint {
	let x = 0
	let y = 0
	let touch: UniTouch | null = null
	if (e.touches.length > 0) {
		touch = e.touches[0]
	} else if (e.changedTouches.length > 0) {
		touch = e.changedTouches[0]
	}
	if (touch != null) {
		x = touch.clientX - cachedRectLeft
		y = touch.clientY - cachedRectTop
	}
	return createPoint(x, y, 'move', '', 0)
}

function applyLineStyle(color: string, width: number): void {
	if (ctx == null) return
	ctx!.lineWidth = width
	ctx!.strokeStyle = color
	ctx!.lineCap = 'round'
	ctx!.lineJoin = 'round'
}

function beginPath(): void {
	if (ctx != null) {
		ctx!.beginPath()
	}
}

function moveTo(x: number, y: number): void {
	if (ctx != null) {
		ctx!.moveTo(x, y)
	}
}

function lineTo(x: number, y: number): void {
	if (ctx != null) {
		ctx!.lineTo(x, y)
	}
}

function stroke(): void {
	if (ctx == null) return
	ctx!.stroke()
}

function closePath(): void {
	if (ctx != null) {
		ctx!.closePath()
	}
}

function clearDrawing(): void {
	if (ctx == null) return
	ctx!.clearRect(0, 0, 100000, 100000)
	ctx!.fillStyle = props.bgColor
	ctx!.fillRect(0, 0, 100000, 100000)
}

function startDraw(x: number, y: number): void {
	isDrawingActive = true
	isDrawing.value = true
	isEmpty.value = false
	currentPathPoints = []
	const col = getLineColor()
	const wid = getLineWidth()
	const startPoint = createPoint(normalizeNumber(x, 0), normalizeNumber(y, 0), 'start', col, wid)
	currentPathPoints.push(startPoint)
	lastDrawX = startPoint.x
	lastDrawY = startPoint.y

	// 立即绘制起点微线段以产生圆点（点击即出点，lineCap 保证圆润）
	applyLineStyle(col, wid)
	beginPath()
	moveTo(startPoint.x, startPoint.y)
	lineTo(startPoint.x + 0.1, startPoint.y + 0.1)
	stroke()
	closePath()
}

function moveDraw(x: number, y: number): void {
	if (!isDrawingActive) return
	const nx = normalizeNumber(x, 0)
	const ny = normalizeNumber(y, 0)
	// 过滤极其微小的抖动
	if (Math.abs(nx - lastDrawX) < 0.5 && Math.abs(ny - lastDrawY) < 0.5) {
		return
	}
	const col = getLineColor()
	const wid = getLineWidth()
	const movePoint = createPoint(nx, ny, 'move', col, wid)
	currentPathPoints.push(movePoint)

	applyLineStyle(col, wid)
	beginPath()
	moveTo(lastDrawX, lastDrawY)
	lineTo(movePoint.x, movePoint.y)
	stroke()
	closePath()

	lastDrawX = movePoint.x
	lastDrawY = movePoint.y
}

function endDraw(): void {
	if (!isDrawingActive) return
	isDrawingActive = false
	isDrawing.value = false
	if (currentPathPoints.length > 0) {
		pathStack.value.push(currentPathPoints)
		emit('change', currentPathPoints)
	}
	currentPathPoints = []
}

// #ifdef WEB
function attachMouseEvents(canvas: UniCanvasElement): void {
	canvas.addEventListener('mousedown', (event: UniMouseEvent) => {
		isMouseDown = true
		updateRect()
		startDraw(event.clientX - cachedRectLeft, event.clientY - cachedRectTop)
	})
	canvas.addEventListener('mousemove', (event: UniMouseEvent) => {
		if (!isMouseDown) return
		moveDraw(event.clientX - cachedRectLeft, event.clientY - cachedRectTop)
	})
	canvas.addEventListener('mouseup', () => {
		isMouseDown = false
		endDraw()
	})
}
// #endif

function initContext(): void {
	if (isContextInitialized) return

	// #ifdef APP
	const canvas = canvasRef.value
	if (canvas != null) {
		try {
			const c = canvas.getContext('2d')
			if (c != null) {
				ctx = c
				canvasEl = canvas
				const dpr = uni.getDeviceInfo().devicePixelRatio ?? 1
				// #ifdef APP-HARMONY
				const rect = canvas.getBoundingClientRect()
				const w = (rect != null && rect.width > 0) ? rect.width : canvasWidth.value
				const h = (rect != null && rect.height > 0) ? rect.height : canvasHeight.value
				canvas.width = w * dpr
				canvas.height = h * dpr
				// #endif
				c.scale(dpr, dpr)
				isContextInitialized = true
				clearDrawing()
				updateRect()
				return
			}
		} catch (_e) {}
	}
	// #endif

	// #ifndef APP
	try {
		uni.createCanvasContextAsync({
			id: canvasId.value as string.IDString,
			component: instance?.proxy,
			success: (context: CanvasContext) => {
				if (isContextInitialized) return
				canvasContext = context
				const c = context.getContext('2d')
				if (c != null) {
					ctx = c
					canvasEl = c.canvas ?? canvasRef.value
					const dpr = uni.getDeviceInfo().devicePixelRatio ?? 1
					if (canvasEl != null) {
						const w = (canvasEl.offsetWidth > 0 ? canvasEl.offsetWidth : canvasWidth.value) * dpr
						const h = (canvasEl.offsetHeight > 0 ? canvasEl.offsetHeight : canvasHeight.value) * dpr
						canvasEl.width = w
						canvasEl.height = h
						c.scale(dpr, dpr)
						// #ifdef WEB
						attachMouseEvents(canvasEl!)
						// #endif
					}
					isContextInitialized = true
					clearDrawing()
					updateRect()
				}
			},
			fail: (_err: UniError) => {}
		})
	} catch (_e) {}
	// #endif
}

function touchStart(e: UniTouchEvent): void {
	e.stopPropagation()
	e.preventDefault()
	uni.$emit('setPageScrollEnabled', false)
	updateRect()
	const point = getTouchPoint(e)
	startDraw(point.x, point.y)
}

function touchMove(e: UniTouchEvent): void {
	if (!isDrawingActive) return
	e.stopPropagation()
	e.preventDefault()
	const point = getTouchPoint(e)
	moveDraw(point.x, point.y)
}

function touchEnd(e: UniTouchEvent): void {
	e.stopPropagation()
	e.preventDefault()
	uni.$emit('setPageScrollEnabled', true)
	endDraw()
}

function selectColor(col: string): void {
	lineColor.value = col
}

function redraw(): void {
	clearDrawing()
	const stack = pathStack.value
	if (stack.length == 0) {
		isEmpty.value = true
		return
	}
	isEmpty.value = false
	for (let i = 0; i < stack.length; i++) {
		const path = stack[i]
		if (path.length == 0) continue
		beginPath()
		for (let j = 0; j < path.length; j++) {
			const point = path[j]
			if (j == 0 && point.type == 'start') {
				applyLineStyle(point.color, point.width)
				moveTo(point.x, point.y)
				lineTo(point.x + 0.1, point.y + 0.1)
			} else if (point.type == 'move') {
				lineTo(point.x, point.y)
			}
		}
		stroke()
		closePath()
	}
}

function undo(): void {
	if (pathStack.value.length == 0) return
	pathStack.value.pop()
	redraw()
	emit('change', pathStack.value.length > 0 ? pathStack.value[pathStack.value.length - 1] : [] as Array<SignaturePoint>)
}

function clearCanvas(): void {
	clearDrawing()
	pathStack.value = createPathStack()
	currentPathPoints = []
	isEmpty.value = true
	emit('clear')
	emit('change', [] as Array<SignaturePoint>)
}

function exportSignature(): void {
	if (isEmpty.value) {
		emit('error', '签名为空')
		return
	}
	redraw()

	// #ifdef APP
	const el = getDrawElement()
	if (el != null) {
		try {
			el.takeSnapshot({
				format: 'png',
				success: (res: TakeSnapshotSuccess) => {
					const tempFilePath = res.tempFilePath
					if (tempFilePath == '') {
						emit('error', '导出签名图片失败')
					} else {
						emit('confirm', tempFilePath)
					}
				},
				fail: (err: TakeSnapshotFail) => {
					emit('error', err.errMsg)
				}
			} as TakeSnapshotOptions)
			return
		} catch (_e) {}
	}
	// #endif

	// 1. 优先从 canvasContext.toDataURL 导出
	if (canvasContext != null) {
		try {
			const dataUrl = canvasContext!.toDataURL('image/png', 1)
			if (dataUrl != null && dataUrl != '') {
				emit('confirm', dataUrl)
				return
			}
		} catch (_e) {}
	}

	// 2. 其次从 canvasEl / canvasRef 导出
	const cEl = canvasEl ?? canvasRef.value
	if (cEl != null) {
		try {
			const dataUrl = cEl.toDataURL('image/png', 1)
			if (dataUrl != null && dataUrl != '') {
				emit('confirm', dataUrl)
				return
			}
		} catch (_e) {}
	}

	emit('error', '导出签名图片失败')
}

function toggleBrushSettings(): void {
	showBrushSettings.value = !showBrushSettings.value
	if (showBrushSettings.value) {
		showColorSettings.value = false
	}
}

function toggleColorSettings(): void {
	showColorSettings.value = !showColorSettings.value
	if (showColorSettings.value) {
		showBrushSettings.value = false
	}
}

watch((): any => props.width, (newVal: any | null) => {
	canvasWidth.value = normalizeNumber(newVal, 300)
	nextTick(() => {
		updateRect()
	})
})

watch((): any => props.height, (newVal: any | null) => {
	canvasHeight.value = normalizeNumber(newVal, 200)
	nextTick(() => {
		updateRect()
	})
})

watch((): any => props.color, (newVal: string) => {
	lineColor.value = newVal
})

watch((): any => props.thickness, (newVal: any | null) => {
	lineWidth.value = normalizeNumber(newVal, 3)
})

let initAttempts = 0

function scheduleInit(delay: number): void {
	setTimeout(() => {
		initContext()
		if (ctx == null && initAttempts < 3) {
			initAttempts++
			scheduleInit(200)
		}
	}, delay)
}

onMounted(() => {
	nextTick(() => {
		initAttempts = 0
		scheduleInit(50)
	})
})

onUnmounted(() => {
	uni.$emit('setPageScrollEnabled', true)
})

defineExpose({
	undo,
	clearCanvas,
	redraw,
	exportSignature
})
</script>

<style lang="scss" scoped>
	.up-signature {
		display: flex;
		flex-direction: column;

		&__canvas-wrap {
			border-width: 1px;
			border-style: solid;
			border-color: #e0e0e0;
			border-radius: 4px;
			overflow: hidden;
			touch-action: none;
		}

		&__canvas {
			width: 100%;
			height: 100%;
			touch-action: none;
		}

		&__toolbar {
			margin-top: 5px;
			background-color: #ffffff;
		}

		&__toolbar-icons {
			display: flex;
			flex-direction: row;
			justify-content: space-between;
			align-items: center;
			width: 100%;
			padding: 1px 0;
			border-radius: 4px;
		}

		&__toolbar-icon {
			flex: 1;
			display: flex;
			flex-direction: row;
			justify-content: center;
			align-items: center;
			padding: 5px 0;
		}

		&__brush-settings,
		&__color-settings {
			margin-top: 15px;
			padding: 1px;
			border-radius: 4px;
		}

		&__progress-label,
		&__color-label {
			display: flex;
			margin-bottom: 10px;
			font-size: 14px;
			color: #999999;
		}

		&__colors {
			display: flex;
			flex-direction: row;
			flex-wrap: wrap;
		}

		&__color-item {
			width: 30px;
			height: 30px;
			border-radius: 50%;
			margin-right: 10px;
			margin-bottom: 10px;
			border-width: 2px;
			border-style: solid;
			border-color: transparent;

			&--active {
				border-color: #2979ff;
			}
		}
	}
</style>
