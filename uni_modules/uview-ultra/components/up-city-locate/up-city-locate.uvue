<template>
	<view class="up-city-locate">
		<up-index-list :indexList="indexList">
			<template #header>
				<view class="up-current-city-wrap">
					<view class="up-current-city-title"><text class="up-current-city-title-text">定位城市</text></view>
					<view class="up-current-city-item" @tap="location">
						<view class="up-location-city"><text class="up-location-city-text">{{locationCity}}</text></view>
					</view>
				</view>
			</template>
			<template :key="index" v-for="(item, index) in cityList">
				<!-- #ifdef APP-NVUE -->
				<up-index-anchor :text="getIndexText(index)"></up-index-anchor>
				<!-- #endif -->
				<up-index-item>
					<up-index-anchor :text="getIndexText(index)"></up-index-anchor>
					<view class="hot-city-list" v-if="index == 0">
						<view class="" v-for="(item1, index1) in getCityGroup(item)" :key="index1" @tap="selectedCity(item1)">
							<view class="hot-city-item"><text class="hot-city-item-text">{{ getCityName(item1) }}</text></view>
						</view>
					</view>
					<view v-else class="item-list" v-for="(item1, index1) in getCityGroup(item)" :key="index1">
						<view class="list__item" @tap="selectedCity(item1)">
							<text class="list__item__city-name">{{getCityName(item1)}}</text>
						</view>
						<up-line></up-line>
					</view>
				</up-index-item>
			</template>
			<template #footer>
				<view class="up-safe-area-inset--bottom">
					<text class="list__footer"></text>
				</view>
			</template>
		</up-index-list>
	</view>
</template>

<script setup lang="uts">
import { ref, watch, onMounted } from 'vue'

defineOptions({
	name: 'up-city-locate'
})

const props = defineProps({
	indexList: {
		type: Array as PropType<Array<string>>,
		default: () => ['热'] as Array<string>
	},
	cityList: {
		type: Array as PropType<Array<Array<UTSJSONObject>>>,
		default: () => [
			[
				{ name: '北京', value: 'beijing' } as UTSJSONObject,
				{ name: '上海', value: 'shanghai' } as UTSJSONObject,
				{ name: '广州', value: 'guangzhou' } as UTSJSONObject,
				{ name: '深圳', value: 'shenzhen' } as UTSJSONObject,
				{ name: '杭州', value: 'hangzhou' } as UTSJSONObject
			] as Array<UTSJSONObject>
		] as Array<Array<UTSJSONObject>>
	},
	locationType: {
		type: String,
		default: 'wgs84'
	},
	currentCity: {
		type: String,
		default: ''
	},
	nameKey: {
		type: String,
		default: 'name'
	}
})

const emit = defineEmits(['location-success', 'select-city'])

const locationCity = ref<string>(props.currentCity.length > 0 ? props.currentCity : '定位中...')

watch(() => props.currentCity, (val: string) => {
	locationCity.value = val
})

function getIndexText(index: number): string {
	const list = props.indexList
	if (index < 0 || index >= list.length) {
		return ''
	}
	return list[index]
}

function getCityGroup(item: any | null): Array<UTSJSONObject> {
	const group = item as Array<UTSJSONObject> | null
	if (group == null) {
		return [] as Array<UTSJSONObject>
	}
	return group
}

function getCityName(city: any | null): string {
	const cityObject = city as UTSJSONObject | null
	if (cityObject == null) {
		return ''
	}
	const val = cityObject[props.nameKey]
	if (val == null) {
		return ''
	}
	return val.toString()
}

function selectedCity(city: any | null): void {
	locationCity.value = getCityName(city)
	emit('select-city', {
		locationCity: locationCity.value
	} as UTSJSONObject)
}

function location(): void {
	uni.getLocation({
		type: props.locationType,
		geocode: true,
		success: (res: any) => {
			const result = res as UTSJSONObject
			const address = result['address'] as UTSJSONObject | null
			const city = address == null ? null : address['city']
			locationCity.value = city == null ? '' : city.toString()
			result['locationCity'] = locationCity.value
			emit('location-success', result)
		},
		fail: () => {
			locationCity.value = '定位失败'
		}
	})
}

onMounted(() => {
	location()
})

defineExpose({
	location,
	selectedCity
})
</script>

<style lang="scss">
	.list__item {
		padding: 8px 1px;
	}
	.up-current-city-title {
		margin-bottom: 5px;
	}
	.up-current-city-title-text {
		color: grey;
		font-size: 14px;
	}
	.up-current-city-item {
		height: 30px;
	}
	.up-location-city-text {
		font-size: 15px;
		color: #303133;
	}
	.hot-city-list {
		display: flex !important;
		flex-direction: row !important;
		flex-wrap: wrap;
		padding: 12px 0;
	}
	.hot-city-item {
		padding: 6px 12px;
		margin: 5px;
		border-width: 1px;
		border-style: solid;
		border-color: #ededed;
		border-radius: 4px;
	}
	.hot-city-item-text {
		font-size: 14px;
		color: #303133;
	}
</style>
