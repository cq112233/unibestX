<template>
	<view class="up-picker-data">
		<view class="up-picker-data__trigger">
			<slot name="trigger"></slot>
			<up-input
				:model-value="current"
				disabled
				disabled-color="#ffffff"
				:placeholder="title"
				border="none"
			></up-input>
			<view class="up-picker-data__trigger__cover" @click="show = true"></view>
		</view>
		<up-picker
			:show="show"
			:columns="columns"
			:key-name="labelKey"
			:default-index="defaultIndex"
			@confirm="confirm"
			@cancel="cancel"
			@close="close"
		></up-picker>
	</view>
</template>

<script setup lang="uts">
import { ref, computed, watch } from 'vue'

function stringValue(value: any | null): string {
	return value == null ? '' : value.toString()
}

function createIndexList(): Array<number> {
	return [] as Array<number>
}

defineOptions({
	name: 'up-picker-data'
})

const props = defineProps({
	modelValue: {
		type: [String, Number],
		default: ''
	},
	title: {
		type: String,
		default: ''
	},
	description: {
		type: String,
		default: ''
	},
	options: {
		type: Array as PropType<Array<UTSJSONObject>>,
		default: () => [] as Array<UTSJSONObject>
	},
	valueKey: {
		type: String,
		default: 'id'
	},
	labelKey: {
		type: String,
		default: 'name'
	}
})

const emit = defineEmits(['update:modelValue', 'cancel', 'close', 'confirm'])

const show = ref<boolean>(false)
const current = ref<string>('')
const defaultIndex = ref<Array<number>>(createIndexList())

const columns = computed<Array<Array<UTSJSONObject>>>(() => {
	return [props.options] as Array<Array<UTSJSONObject>>
})

function syncCurrent(): void {
	const list = props.options
	const model = stringValue(props.modelValue)
	current.value = ''
	defaultIndex.value = createIndexList()
	for (let i = 0; i < list.length; i++) {
		const item = list[i]
		if (stringValue(item[props.valueKey]) == model) {
			current.value = stringValue(item[props.labelKey])
			defaultIndex.value = [i] as Array<number>
			return
		}
	}
}

function cancel(): void {
	show.value = false
	emit('cancel')
}

function close(): void {
	show.value = false
	emit('close')
}

function confirm(e: UTSJSONObject): void {
	const value = e['value'] as Array<UTSJSONObject>
	if (value.length == 0) {
		show.value = false
		emit('confirm')
		return
	}
	const item = value[0]
	show.value = false
	emit('update:modelValue', item[props.valueKey])
	current.value = stringValue(item[props.labelKey])
	emit('confirm')
}

watch((): Array<any | null> => [props.modelValue, props.options] as Array<any | null>, () => {
	syncCurrent()
}, { immediate: true, deep: true })
</script>

<style lang="scss" scoped>
	.up-picker-data__trigger {
		position: relative;
	}

	.up-picker-data__trigger__cover {
		position: absolute;
		left: 0;
		right: 0;
		top: 0;
		bottom: 0;
		z-index: 10;
	}
</style>
