<template>
	<view class="up-select">
		<view :class="['up-select__content', disabled ? 'disabled' : '']">
			<view class="up-select__label" @click="openSelect">
				<slot name="text" :currentLabel="currentLabel">
					<text class="up-select__text" v-if="showOptionsLabel">
						{{ currentLabel }}
					</text>
					<text class="up-select__text" v-else>
						{{ label }}
					</text>
				</slot>
				<slot name="icon">
					<up-icon name="arrow-down" :size="iconSize" :color="iconColor"></up-icon>
				</slot>
			</view>
			<up-overlay :show="isOpen" @click="overlayClick" v-if="overlay" :zIndex="zIndex" :duration="duration + 50"
				:customStyle="overlayStyle" :opacity="overlayOpacity" @touchmove.stop.prevent="noop"></up-overlay>
			<view class="up-select__options__wrap"
				:style="optionsWrapStyle">
				<view class="up-select__options" v-if="isOpen">
					<slot name="options">
						<view class="up-select__options_item" :class="getOptionClass(item)"
							:key="index" v-for="(item, index) in options" @click="selectItem(item)">
							<slot name="optionItem" :item="item">
								<text class="up-select__item_text" :style="{color: itemColor}">
									{{ getOptionLabel(item) }}
								</text>
							</slot>
						</view>
					</slot>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import { ref, computed, onMounted, getCurrentInstance, nextTick } from 'vue'
import { getWindowInfo, upGetRect } from '../../libs/function/index'

defineOptions({
	name: 'up-select'
})

const props = defineProps({
	maxHeight: {
		type: String,
		default: '90vh'
	},
	overlay: {
		type: Boolean,
		default: true
	},
	overlayOpacity: {
		type: Number,
		default: 0.01
	},
	overlayStyle: {
		type: Object,
		default: () => ({})
	},
	duration: {
		type: Number,
		default: 300
	},
	label: {
		type: String,
		default: '选项'
	},
	options: {
		type: Array as PropType<UTSJSONObject[]>,
		default: () => [] as UTSJSONObject[]
	},
	keyName: {
		type: String,
		default: 'id'
	},
	labelName: {
		type: String,
		default: 'name'
	},
	showOptionsLabel: {
		type: Boolean,
		default: false
	},
	current: {
		type: [String, Number],
		default: ''
	},
	zIndex: {
		type: Number,
		default: 11000
	},
	itemColor: {
		type: String,
		default: '#333333'
	},
	iconColor: {
		type: String,
		default: ''
	},
	iconSize: {
		type: String,
		default: '13px'
	},
	disabled: {
		type: Boolean,
		default: false
	}
})

const emit = defineEmits(['update:current', 'select'])
const instance = getCurrentInstance()

function noop() {}

function valueToString(val: any | null): string {
	return val == null ? '' : val.toString()
}

function normalizeNumber(val: any | null, fallback: number = 0): number {
	if (typeof val === 'number') {
		return val as number
	}
	if (val == null) {
		return fallback
	}
	const parsed = parseFloat(val.toString())
	return isNaN(parsed) ? fallback : parsed
}

const isOpen = ref<boolean>(false)
const optionsWrapLeft = ref<string>('auto')
const optionsWrapRight = ref<string>('auto')
const optionsWrapTop = ref<string>('0px')
const optionsWrapMinWidth = ref<string>('100px')
const optionsWrapMaxHeight = ref<string>('90vh')

onMounted(() => {
	if (props.maxHeight != null && props.maxHeight != '') {
		optionsWrapMaxHeight.value = props.maxHeight
	}
})

const currentLabel = computed<string>(() => {
	const opts = props.options
	for (let i = 0; i < opts.length; i++) {
		const item = opts[i]
		if (valueToString(item[props.keyName]) == valueToString(props.current)) {
			return valueToString(item[props.labelName])
		}
	}
	return ''
})

const optionsWrapStyle = computed<UTSJSONObject>(() => {
	return {
		overflowY: 'auto',
		position: 'fixed',
		zIndex: props.zIndex + 1,
		left: optionsWrapLeft.value,
		right: optionsWrapRight.value,
		top: optionsWrapTop.value,
		minWidth: optionsWrapMinWidth.value,
		maxHeight: optionsWrapMaxHeight.value
	} as UTSJSONObject
})

function getOptionClass(item: UTSJSONObject): string {
	return valueToString(item[props.keyName]) == valueToString(props.current) ? 'active' : ''
}

function getOptionLabel(item: UTSJSONObject): string {
	return valueToString(item[props.labelName])
}

function adjustOptionsWrapPosition(): void {
	const wi = getWindowInfo()
	const windowWidth = wi.windowWidth
	const windowHeight = wi.windowHeight
	upGetRect('.up-select__label', false, instance?.proxy).then((rect: NodeInfo) => {
		const left = normalizeNumber(rect.left, 0)
		const top = normalizeNumber(rect.top, 0)
		const width = Math.max(100, normalizeNumber(rect.width, 100))
		const height = normalizeNumber(rect.height, 0)
		const dropdownTop = top + height
		const availableHeight = Math.max(80, windowHeight - dropdownTop - 8)
		optionsWrapTop.value = dropdownTop.toString() + 'px'
		optionsWrapMinWidth.value = width.toString() + 'px'
		optionsWrapMaxHeight.value = availableHeight.toString() + 'px'
		if (left + width > windowWidth) {
			optionsWrapLeft.value = 'auto'
			optionsWrapRight.value = '0px'
		} else {
			optionsWrapLeft.value = left.toString() + 'px'
			optionsWrapRight.value = 'auto'
		}
	})
}

function openSelect(): void {
	if (props.disabled) return
	isOpen.value = true
	nextTick(() => {
		if (isOpen.value) {
			adjustOptionsWrapPosition()
		}
	})
}

function closeSelect(): void {
	isOpen.value = false
}

function overlayClick(): void {
	isOpen.value = false
}

function selectItem(item: UTSJSONObject): void {
	isOpen.value = false
	emit('update:current', item[props.keyName])
	emit('select', item)
}

defineExpose({
	open: openSelect,
	close: closeSelect
})
</script>

<style lang="scss" scoped>
	.up-select__content {
		position: relative;
	}

	.up-select__label {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		/* #ifdef H5 */
		cursor: pointer;
		/* #endif */
	}

	.up-select__text {
		margin-right: 2px;
	}

	.disabled {
		opacity: 0.6;
		pointer-events: none;
	}

	.up-select__options__wrap {
		position: fixed;
		top: 0;
		left: 0;
	}

	.up-select__options {
		min-width: 100px;
		box-sizing: border-box;
		border-radius: 4px;
		border-width: 1px;
		border-style: solid;
		border-color: #f1f1f1;
		background-color: #fff;
	}

	.up-select__options_item {
		padding: 10px 12px;
		box-sizing: border-box;
		width: 100%;
		height: 100%;
		/* #ifdef H5 */
		cursor: pointer;
		/* #endif */
	}
</style>
