<template>
    <view class="up-table-row up-table-row-child"
        :class="[highlightCurrentRow && currentRow === row ? 'up-table-row-highlight' : '',
        rowClassName != null ? rowClassName(row, rowIndex) : '',
        stripe && rowIndex % 2 === 1 ? 'up-table-row-zebra' : ''
        ]" :style="{height: rowHeight}" @click="handleRowClick(row)">
        <view v-for="(col, colIndex) in columns" :key="col['key'] ?? colIndex" 
            class="up-table-cell"
            :class="[col['align'] != null ? 'up-text-' + col['align'] : '',
                cellClassName != null ? cellClassName(row, col) : '',
                getFixedClass(col),
                getCellSpanClass(rowIndex, colIndex)
            ]"
            :style="[cellStyleInner({row: row, column: col, rowIndex: rowIndex, columnIndex: colIndex, level: level}), getCellSpanStyle(rowIndex, colIndex)]">
                <!-- 复选框列 -->
                <view v-if="col['type'] === 'selection'">
                    <checkbox :checked="isSelected(row)"
                        @click.stop="$emit('toggleSelect', row)" />
                </view>
                <template v-else>
                    <!-- 在mainCol列显示展开图标 -->
                    <view v-if="col['key'] === computedMainCol && hasTree"
                        @click.stop="toggleExpand(row)" :style="{width: expandWidth}">
                        <view v-if="row[treeProps['children'] ?? 'children'] && (row[treeProps['children'] ?? 'children'] as UTSJSONObject[]).length > 0">
                            <text>{{ isExpanded(row) ? '-' : '+' }}</text>
                        </view>
                    </view>
                    <slot name="cellChild" :row="row" :column="col" :prow="parentRow"
                        :rowIndex="rowIndex" :columnIndex="colIndex" :level="level">
                        <view class="up-table-cell_content">
                            <text>{{ row[col['key'] ?? ''] }}</text>
                        </view>
                    </slot>
                </template>
        </view>
    </view>
    <!-- 递归渲染更深层级的子级 -->
    <template v-if="isExpanded(row) && row[treeProps['children'] ?? 'children'] && (row[treeProps['children'] ?? 'children'] as UTSJSONObject[]).length">
        <template v-for="(rowChild, childIndex) in (row[treeProps['children'] ?? 'children'] as UTSJSONObject[])" :key="rowChild[rowKey] != null ? rowChild[rowKey] : childIndex">
            <table-row 
                :row="rowChild" 
                :rowIndex="childIndex"
                :parent-row="row"
                :columns="columns"
                :tree-props="treeProps"
                :row-key="rowKey"
                :expanded-keys="expandedKeys"
                :cell-style-inner="cellStyleInner"
                :is-expanded="isExpanded"
                :row-class-name="rowClassName"
                :stripe="stripe"
                :cell-class-name="cellClassName"
                :get-fixed-class="getFixedClass"
                :highlight-current-row="highlightCurrentRow"
                :current-row="currentRow"
                :handle-row-click="handleRowClick"
                :toggle-expand="toggleExpand"
                :level="level + 1"
                :rowHeight="rowHeight"
                :hasTree="hasTree"
                :selectedRows="selectedRows"
                :expandWidth="expandWidth"
                :computed-main-col="computedMainCol"
                :span-method="spanMethod"
                @toggle-select="$emit('toggleSelect', $event)"
                @row-click="$emit('rowClick', $event)"
                @toggle-expand="$emit('toggleExpand', $event)"
            >
            <template v-slot:cellChild="scope">
                <slot name="cellChild" :row="scope['row']" :column="scope['column']" :prow="scope['prow']"
                    :rowIndex="scope['rowIndex']" :columnIndex="scope['columnIndex']" :level="level">
                </slot>                      
            </template>
            </table-row>
        </template>
    </template>
</template>

<script setup lang="uts">
import { computed } from 'vue'

function createSpan(rowspan: number = 1, colspan: number = 1): UTSJSONObject {
    return {
        rowspan: rowspan,
        colspan: colspan
    } as UTSJSONObject;
}

function valueToString(value: any | null): string {
    return value == null ? '' : value.toString();
}

defineOptions({
    name: 'tableRow'
})

const props = defineProps({
    row: {
        type: Object as PropType<UTSJSONObject>,
        required: true
    },
    rowIndex: {
        type: Number,
        required: true
    },
    parentRow: {
        type: Object as PropType<UTSJSONObject | null>,
        default: null
    },
    columns: {
        type: Array as PropType<UTSJSONObject[]>,
        required: true
    },
    treeProps: {
        type: Object as PropType<UTSJSONObject>,
        required: true
    },
    rowKey: {
        type: String,
        required: true
    },
    expandedKeys: {
        type: Array as PropType<string[]>,
        required: true
    },
    cellStyleInner: {
        type: Function,
        required: true
    },
    isExpanded: {
        type: Function,
        required: true
    },
    rowClassName: {
        type: Function,
        default: null
    },
    stripe: {
        type: Boolean,
        default: false
    },
    cellClassName: {
        type: Function,
        default: null
    },
    getFixedClass: {
        type: Function,
        required: true
    },
    highlightCurrentRow: {
        type: Boolean,
        default: false
    },
    currentRow: {
        type: Object as PropType<UTSJSONObject | null>,
        default: null
    },
    handleRowClick: {
        type: Function,
        required: true
    },
    toggleExpand: {
        type: Function,
        required: true
    },
    level: {
        type: Number,
        required: true
    },
    computedMainCol: {
        type: String,
        required: true
    },
    expandWidth: {
        type: String,
        required: true
    },
    hasTree: {
        type: Boolean,
        default: false
    },
    selectedRows: {
        type: Array as PropType<UTSJSONObject[]>,
        default: () => [] as UTSJSONObject[]
    },
    rowHeight: {
        type: String,
        required: true
    },
    spanMethod: {
        type: Function as PropType<UTSCallback | null>,
        default: null
    }
})

const emit = defineEmits(['rowClick', 'toggleExpand', 'toggleSelect'])

function getChildrenKey(): string {
    const p = props.treeProps
    const childrenKey = p['children']
    return valueToString(childrenKey) == '' ? 'children' : valueToString(childrenKey)
}

function getRowKeyValue(r: UTSJSONObject): string {
    return valueToString(r[props.rowKey])
}

function findSelectedRowIndex(r: UTSJSONObject): number {
    const rowKeyValue = getRowKeyValue(r)
    const selRows = props.selectedRows
    for (let i = 0; i < selRows.length; i++) {
        const selectedRow = selRows[i] as UTSJSONObject
        if (getRowKeyValue(selectedRow) == rowKeyValue) {
            return i
        }
    }
    return -1
}

function isSelected(r: UTSJSONObject): boolean {
    return findSelectedRowIndex(r) >= 0
}

function getSpanValue(value: any | null, fallback: number = 1): number {
    if (value == null || valueToString(value) == '') {
        return fallback
    }
    const parsed = parseInt(value.toString())
    return isNaN(parsed) ? fallback : parsed
}

function getCellSpan(rIndex: number, columnIndex: number): UTSJSONObject {
    if (typeof props.spanMethod !== 'function') {
        return createSpan()
    }
    const spanMethod = props.spanMethod as UTSCallback | null
    if (spanMethod == null) {
        return createSpan()
    }
    const r = props.row
    const col = props.columns[columnIndex] as UTSJSONObject
    const result = spanMethod.invoke({
        row: r,
        column: col,
        rowIndex: rIndex,
        columnIndex: columnIndex
    } as UTSJSONObject)
    if (Array.isArray(result)) {
        const arr = result as number[]
        const rowspan = arr.length > 0 ? getSpanValue(arr[0], 1) : 1
        const colspan = arr.length > 1 ? getSpanValue(arr[1], 1) : 1
        return createSpan(rowspan, colspan)
    }
    return createSpan()
}

function getCellSpanClass(rIndex: number, columnIndex: number): string {
    const span = getCellSpan(rIndex, columnIndex)
    if ((span['rowspan'] as number) == 0 || (span['colspan'] as number) == 0) {
        return 'up-table-cell-hidden'
    }
    if ((span['rowspan'] as number) > 1 || (span['colspan'] as number) > 1) {
        return 'up-table-cell-merged'
    }
    return ''
}

function getCellSpanStyle(rIndex: number, columnIndex: number): UTSJSONObject {
    const span = getCellSpan(rIndex, columnIndex)
    const style = {} as UTSJSONObject
    const rowspan = span['rowspan'] as number
    const colspan = span['colspan'] as number
    if (rowspan > 1) {
        const currentHeight = parseInt(props.rowHeight)
        if (!isNaN(currentHeight)) {
            style['height'] = `${rowspan * currentHeight}px`
        }
    }
    if (colspan > 1) {
        style['flex'] = colspan
    }
    if (rowspan == 0 || colspan == 0) {
        style['display'] = 'none'
    }
    return style
}
</script>

<style lang="scss" scoped>
.up-table-row {
    display: flex;
    flex-direction: row;
    position: relative;
}

.up-table-cell {
    flex: 1;
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 10px 1px;
    font-size: 14px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.1;
    border-bottom: 1px solid #ebeef5;
    &.up-text-left {
        justify-content: flex-start;
        text-align: left;
    }
    &.up-text-center {
        justify-content: center;
        text-align: center;
    }
    &.up-text-right {
        justify-content: flex-end;
        text-align: right;
    }
}

.up-table-row-zebra {
    background-color: #fafafa;
}

.up-table-row-highlight {
    background-color: #f5f7fa;
}

.up-table-cell-hidden {
    opacity: 0;
}

.up-table-cell-merged {
    z-index: 1;
}
</style>
