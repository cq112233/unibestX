<template>
  <up-pull-refresh
    :refreshing="refreshing"
    :threshold="50"
    @refresh="handleRefresh"
  >
    <up-virtual-list
      ref="virtualList"
      :list-data="listData"
      :item-height="itemHeight"
      :height="height"
      :buffer="buffer"
      :key-field="keyField"
      :scroll-top="scrollTop"
      @scroll="handleScroll"
    >
      <template #default="{ item, index }">
        <slot :item="item" :index="index"></slot>
      </template>
    </up-virtual-list>
  </up-pull-refresh>
</template>

<script setup lang="uts">
import { ref } from 'vue'

defineOptions({
  name: 'up-refresh-virtual-list'
})

const props = defineProps({
  listData: {
    type: Array as PropType<Array<UTSJSONObject>>,
    default: () => [] as Array<UTSJSONObject>
  },
  itemHeight: {
    type: Number,
    default: 50
  },
  height: {
    type: [String, Number],
    default: '100%'
  },
  buffer: {
    type: Number,
    default: 4
  },
  keyField: {
    type: String,
    default: 'id'
  }
})

const emit = defineEmits(['refresh', 'scroll'])

const refreshing = ref<boolean>(false)
const scrollTop = ref<number>(0)
const virtualList = ref<any | null>(null)

function handleRefresh(): void {
  refreshing.value = true
  emit('refresh')
}

function handleScroll(top: number): void {
  scrollTop.value = top
  emit('scroll', top)
}

function finishRefresh(): void {
  refreshing.value = false
}

function scrollTo(top: number): void {
  scrollTop.value = top
}

function scrollToTop(): void {
  scrollTo(0)
}

defineExpose({
  finishRefresh,
  scrollTo,
  scrollToTop
})
</script>
