/**
 * unix-Bignumber —— 任意精度十进制大数据运算库（全端支持）
 *
 * 全平台支持：App (Android / iOS / 鸿蒙) / H5 / 微信小程序等全端
 *
 * 与依赖原生 BigInteger / 浮点的实现不同，本库内部**只用十进制数字字符串做逐位运算**，
 * 因此五端（Kotlin / Swift / ArkTS / JS）编译产物行为完全一致，不存在精度或格式差异。
 *
 * 能力概览：
 * 1. 任意精度加 / 减 / 乘 / 除 / 取余 / 幂 / 开方，支持 20 位以上小数而不丢精度；
 * 2. 九种舍入模式、可配置小数位（DECIMAL_PLACES）、指数（MODULO_MODE）、科学计数阈值（EXPONENTIAL_AT）；
 * 3. 2~36 进制构造与输出、千分位格式化（toFormat）、比较与判定、整数/小数位/有效数字统计；
 * 4. 非整数次幂（如 `x^0.5`）走 `exp(n·ln x)` 高精度定点算法，不依赖原生 Math.log / Math.exp。
 *
 * @example
 * ```uts
 * import { BigNumber } from '@/uni_modules/unix-Bignumber'
 *
 * new BigNumber(0.3).plus(0.1).toString()          // '0.4'
 * new BigNumber('9').exponentiatedBy(0.5).toString() // '3'
 * new BigNumber(1).dividedBy(3).toString()          // '0.33333333333333333333'
 * ```
 */
import { ziAdd, ziCmp, ziDivMod, ziDivModSmall, ziIsZero, ziMul, ziMulSmall, ziPow10, ziShiftRoundHalfUp, ziSqrt, ziSub, ziTrim, ziTrimEnd, ziZeros } from './lib/zint.uts'
import { fxAbs, fxExp, fxLn, FxExpResult } from './lib/fx.uts'

// #region 舍入模式常量（与 bignumber.js 语义一致）

/** 远离零方向进位（0.5 → 1，-0.5 → -1） */
export const ROUND_UP: number = 0
/** 向零方向截断（1.9 → 1，-1.9 → -1） */
export const ROUND_DOWN: number = 1
/** 向正无穷大方向进位（1.1 → 2，-1.9 → -1） */
export const ROUND_CEIL: number = 2
/** 向负无穷大方向截断（1.9 → 1，-1.1 → -2） */
export const ROUND_FLOOR: number = 3
/** 四舍五入，.5 远离零（默认） */
export const ROUND_HALF_UP: number = 4
/** 四舍五入，.5 向零方向 */
export const ROUND_HALF_DOWN: number = 5
/** 四舍五入，.5 取偶 */
export const ROUND_HALF_EVEN: number = 6
/** 四舍五入，.5 向正无穷 */
export const ROUND_HALF_CEIL: number = 7
/** 四舍五入，.5 向负无穷 */
export const ROUND_HALF_FLOOR: number = 8

/** 取模模式：向零截断（等价 JS `%`，也是默认值） */
export const MODULO_MODE_DOWN: number = 1
/** 取模模式：欧几里得取模，结果恒为非负 */
export const MODULO_MODE_EUCLID: number = 9

// #endregion

// #region 内部数值表示与工具

/** 有限值的内部表示：value = s * c * 10^e（k == 0 时有效） */
type BigRaw = {
  /** 符号：1 / -1，零与 NaN 为 0 */
  s: number
  /** 系数数字串（无前导零、无尾随零），零为 '0' */
  c: string
  /** 十进制指数 */
  e: number
  /** 类型：0 有限 / 1 NaN / 2 Infinity */
  k: number
}

/** 十进制拆分结果 */
type DecSplit = {
  /** 整数部分数字串 */
  intPart: string
  /** 小数部分数字串（不含小数点） */
  fracPart: string
}

/** raw 类型常量 */
const K_FINITE: number = 0
const K_NAN: number = 1
const K_INF: number = 2

/** 字符编码常量 */
const CH_MINUS: number = 45
const CH_PLUS: number = 43
const CH_ZERO: number = 48
const CH_NINE: number = 57

/**
 * 构造 NaN
 * @returns NaN 的 raw 表示
 */
function rawNaN(): BigRaw {
  return { s: 0, c: '0', e: 0, k: K_NAN } as BigRaw
}

/**
 * 构造零
 * @returns 零的 raw 表示
 */
function rawZero(): BigRaw {
  return { s: 0, c: '0', e: 0, k: K_FINITE } as BigRaw
}

/**
 * 构造无穷大
 * @param sign 符号
 * @returns 无穷大的 raw 表示
 */
function rawInf(sign: number): BigRaw {
  return { s: sign < 0 ? -1 : 1, c: '0', e: 0, k: K_INF } as BigRaw
}

/**
 * 规范化（去前导零 / 尾随零，零归位，并做 RANGE 收敛）
 * @param sign 符号
 * @param c 系数数字串
 * @param e 十进制指数
 * @returns 规范化后的 raw
 */
function rawNormalize(sign: number, c: string, e: number): BigRaw {
  const trimmed: string = ziTrim(c)
  if (ziIsZero(trimmed)) {
    return rawZero()
  }
  const te = ziTrimEnd(trimmed)
  const digits: string = te.value
  const exp10: number = e + te.removed
  const dex: number = exp10 + digits.length - 1
  // RANGE：超出可表示指数区间时收敛为 ±Infinity / ±0，避免构造天文数字
  if (dex > CFG_RANGE_POS) {
    return rawInf(sign)
  }
  if (dex < CFG_RANGE_NEG) {
    return rawZero()
  }
  return { s: sign < 0 ? -1 : 1, c: digits, e: exp10, k: K_FINITE } as BigRaw
}

/**
 * 对已有 raw 换符号
 * @param r 输入 raw
 * @param sign 目标符号
 * @returns 换符号后的 raw
 */
function rawWithSign(r: BigRaw, sign: number): BigRaw {
  if (r.k != K_FINITE || r.s == 0) {
    return r
  }
  return { s: sign < 0 ? -1 : 1, c: r.c, e: r.e, k: r.k } as BigRaw
}

/**
 * 取相反数
 * @param r 输入 raw
 * @returns -r
 */
function rawNeg(r: BigRaw): BigRaw {
  if (r.k != K_FINITE || r.s == 0) {
    return r
  }
  return { s: -r.s, c: r.c, e: r.e, k: r.k } as BigRaw
}

/**
 * 取绝对值
 * @param r 输入 raw
 * @returns |r|
 */
function rawAbs(r: BigRaw): BigRaw {
  if (r.k != K_FINITE || r.s >= 0) {
    return r
  }
  return { s: 1, c: r.c, e: r.e, k: r.k } as BigRaw
}

/**
 * 判断是否为零
 * @param r 输入 raw
 * @returns 是否为零
 */
function rawIsZero(r: BigRaw): boolean {
  return r.k == K_FINITE && r.s == 0
}

/**
 * 判断是否为正整数
 * @param r 输入 raw
 * @returns 是否为整数
 */
function rawIsInteger(r: BigRaw): boolean {
  if (r.k != K_FINITE) {
    return false
  }
  if (r.s == 0) {
    return true
  }
  return r.e >= 0
}

/**
 * 比较两个 raw 的绝对值
 * @param a 输入 raw
 * @param b 输入 raw
 * @returns a>b 返回 1，a<b 返回 -1，相等返回 0
 */
function rawCmpAbs(a: BigRaw, b: BigRaw): number {
  // 以 e + c.length 代替 dex 比较，避免负指数相加溢出
  const da: number = a.e + a.c.length
  const db: number = b.e + b.c.length
  if (da != db) {
    return da > db ? 1 : -1
  }
  const e: number = Math.min(a.e, b.e)
  const ca: string = a.c + ziZeros(a.e - e)
  const cb: string = b.c + ziZeros(b.e - e)
  return ziCmp(ca, cb)
}

/**
 * 比较两个 raw
 * @param a 输入 raw
 * @param b 输入 raw
 * @returns a>b 返回 1，a<b 返回 -1，相等返回 0（NaN 情况由调用方先行处理）
 */
function rawCmp(a: BigRaw, b: BigRaw): number {
  if (a.k == K_INF || b.k == K_INF) {
    if (a.k == K_INF && b.k == K_INF) {
      return a.s == b.s ? 0 : (a.s > b.s ? 1 : -1)
    }
    if (a.k == K_INF) {
      return a.s > 0 ? 1 : -1
    }
    return b.s > 0 ? -1 : 1
  }
  if (a.s != b.s) {
    return a.s > b.s ? 1 : -1
  }
  if (a.s == 0) {
    return 0
  }
  const c: number = rawCmpAbs(a, b)
  return a.s < 0 ? -c : c
}

/**
 * 带符号加法
 * @param a 输入 raw
 * @param b 输入 raw
 * @returns a+b
 */
function rawPlus(a: BigRaw, b: BigRaw): BigRaw {
  if (a.k == K_NAN || b.k == K_NAN) {
    return rawNaN()
  }
  if (a.k == K_INF || b.k == K_INF) {
    if (a.k == K_INF && b.k == K_INF) {
      return a.s == b.s ? a : rawNaN()
    }
    return a.k == K_INF ? a : b
  }
  if (a.s == 0) {
    return b
  }
  if (b.s == 0) {
    return a
  }
  const e: number = Math.min(a.e, b.e)
  const ca: string = a.c + ziZeros(a.e - e)
  const cb: string = b.c + ziZeros(b.e - e)
  if (a.s == b.s) {
    return rawNormalize(a.s, ziAdd(ca, cb), e)
  }
  const c: number = ziCmp(ca, cb)
  if (c == 0) {
    return rawZero()
  }
  if (c > 0) {
    return rawNormalize(a.s, ziSub(ca, cb), e)
  }
  return rawNormalize(b.s, ziSub(cb, ca), e)
}

/**
 * 带符号减法
 * @param a 输入 raw
 * @param b 输入 raw
 * @returns a-b
 */
function rawMinus(a: BigRaw, b: BigRaw): BigRaw {
  return rawPlus(a, rawNeg(b))
}

/**
 * 带符号乘法
 * @param a 输入 raw
 * @param b 输入 raw
 * @returns a*b
 */
function rawMul(a: BigRaw, b: BigRaw): BigRaw {
  if (a.k == K_NAN || b.k == K_NAN) {
    return rawNaN()
  }
  if (a.k == K_INF || b.k == K_INF) {
    if (rawIsZero(a) || rawIsZero(b)) {
      return rawNaN()
    }
    return rawInf(a.s * b.s)
  }
  if (a.s == 0 || b.s == 0) {
    return rawZero()
  }
  return rawNormalize(a.s * b.s, ziMul(a.c, b.c), a.e + b.e)
}

/**
 * 按舍入模式决定「商是否进位」
 * @param q 截断后的商（非负整数串）
 * @param rem 余数（非负整数串）
 * @param den 除数（非负整数串）
 * @param rm 舍入模式
 * @param sign 结果符号
 * @returns 进位后的商
 */
function rawRoundQuotient(q: string, rem: string, den: string, rm: number, sign: number): string {
  if (ziIsZero(rem)) {
    return q
  }
  if (rm == ROUND_DOWN) {
    return q
  }
  if (rm == ROUND_CEIL) {
    return sign > 0 ? ziAdd(q, '1') : q
  }
  if (rm == ROUND_FLOOR) {
    return sign < 0 ? ziAdd(q, '1') : q
  }
  if (rm == ROUND_UP) {
    return ziAdd(q, '1')
  }
  const half: number = ziCmp(ziMulSmall(rem, 2), den)
  if (half > 0) {
    return ziAdd(q, '1')
  }
  if (half < 0) {
    return q
  }
  // 恰好一半
  if (rm == ROUND_HALF_DOWN) {
    return q
  }
  if (rm == ROUND_HALF_EVEN) {
    return ((q.charCodeAt(q.length - 1) ?? 0) - CH_ZERO) % 2 == 1 ? ziAdd(q, '1') : q
  }
  if (rm == ROUND_HALF_CEIL) {
    return sign > 0 ? ziAdd(q, '1') : q
  }
  if (rm == ROUND_HALF_FLOOR) {
    return sign < 0 ? ziAdd(q, '1') : q
  }
  // ROUND_HALF_UP 及其他未知值
  return ziAdd(q, '1')
}

/**
 * 丢弃末 drop 位并按舍入模式收敛
 * @param r 输入 raw
 * @param drop 丢弃位数
 * @param rm 舍入模式
 * @returns 收敛后的 raw
 */
function rawRoundDrop(r: BigRaw, drop: number, rm: number): BigRaw {
  if (r.k != K_FINITE || drop <= 0 || r.s == 0) {
    return r
  }
  let kept: string = '0'
  let rest: string = r.c
  if (r.c.length > drop) {
    kept = r.c.substring(0, r.c.length - drop)
    rest = r.c.substring(r.c.length - drop)
  }
  const q: string = rawRoundQuotient(kept, rest, ziPow10(drop), rm, r.s)
  return rawNormalize(r.s, q, r.e + drop)
}

/**
 * 收敛到指定小数位
 * @param r 输入 raw
 * @param dp 保留小数位（可为负，表示向十位 / 百位取整）
 * @param rm 舍入模式
 * @returns 收敛后的 raw
 */
function rawRoundTo(r: BigRaw, dp: number, rm: number): BigRaw {
  if (r.k != K_FINITE || r.s == 0) {
    return r
  }
  return rawRoundDrop(r, -(r.e + dp), rm)
}

/**
 * 收敛到指定有效数字位数
 * @param r 输入 raw
 * @param digits 有效数字位数
 * @param rm 舍入模式
 * @returns 收敛后的 raw
 */
function rawRoundSd(r: BigRaw, digits: number, rm: number): BigRaw {
  if (r.k != K_FINITE || r.s == 0 || digits < 1) {
    return r
  }
  return rawRoundDrop(r, r.c.length - digits, rm)
}

/**
 * 绝对值除法，精确到 dp 位小数
 * @param ca 被除数系数（非零数字串）
 * @param ea 被除数指数
 * @param cb 除数系数（非零数字串）
 * @param eb 除数指数
 * @param dp 目标小数位
 * @param rm 舍入模式
 * @returns |a| / |b| 的 raw（符号为正）
 */
function rawDivAbs(ca: string, ea: number, cb: string, eb: number, dp: number, rm: number): BigRaw {
  const shift: number = (ea - eb) + dp
  let num: string = ca
  let den: string = cb
  if (shift >= 0) {
    num = ca + ziZeros(shift)
  }
  else {
    den = cb + ziZeros(-shift)
  }
  const dm = ziDivMod(num, den)
  const q: string = rawRoundQuotient(dm.q, dm.r, den, rm, 1)
  return rawNormalize(1, q, -dp)
}

/**
 * 带符号除法
 * @param a 输入 raw
 * @param b 输入 raw
 * @param dp 目标小数位
 * @param rm 舍入模式
 * @returns a/b
 */
function rawDiv(a: BigRaw, b: BigRaw, dp: number, rm: number): BigRaw {
  if (a.k == K_NAN || b.k == K_NAN) {
    return rawNaN()
  }
  if (b.k == K_INF) {
    if (a.k == K_INF) {
      return rawNaN()
    }
    return rawZero()
  }
  if (b.s == 0) {
    // 除以零：0/0 为 NaN，其余符号随被除数（-1/0 === -Infinity）
    if (a.s == 0) {
      return rawNaN()
    }
    return rawInf(a.s)
  }
  if (a.k == K_INF) {
    return rawInf(a.s * b.s)
  }
  if (a.s == 0) {
    return rawZero()
  }
  const abs = rawDivAbs(a.c, a.e, b.c, b.e, dp, rm)
  return rawWithSign(abs, a.s * b.s)
}

/**
 * 取模：a - b * trunc(a/b)
 * @param a 输入 raw
 * @param b 输入 raw
 * @param mode 取模模式（MODULO_MODE）
 * @returns a mod b
 */
function rawModulo(a: BigRaw, b: BigRaw, mode: number): BigRaw {
  if (a.k != K_FINITE || b.k != K_FINITE) {
    return rawNaN()
  }
  if (b.s == 0) {
    return rawNaN()
  }
  if (a.s == 0) {
    return rawZero()
  }
  // 商向零截断（或按 MODULO_MODE 收敛），再回乘求余
  const q: BigRaw = rawDiv(a, b, 0, mode == MODULO_MODE_EUCLID ? ROUND_FLOOR : mode)
  let r: BigRaw = rawMinus(a, rawMul(q, b))
  if (mode == MODULO_MODE_EUCLID && r.s < 0) {
    r = rawPlus(r, rawAbs(b))
  }
  return r
}

/**
 * 整数快速幂
 * @param base 底数
 * @param kStr 非负十进制整数字符串
 * @param mod 模（null 表示不取模）
 * @param mode 取模模式
 * @returns base^kStr（或 base^kStr mod m）
 */
function rawPowInt(base: BigRaw, kStr: string, mod: BigRaw | null, mode: number): BigRaw {
  let e: string = kStr
  let result: BigRaw = rawNormalize(1, '1', 0)
  let b: BigRaw = base
  while (!ziIsZero(e)) {
    const dm = ziDivModSmall(e, 2)
    if (dm.r == '1') {
      result = rawMul(result, b)
      if (mod != null) {
        result = rawModulo(result, mod, mode)
      }
    }
    e = dm.q
    if (!ziIsZero(e)) {
      b = rawMul(b, b)
      if (mod != null) {
        b = rawModulo(b, mod, mode)
      }
    }
    if (result.k == K_INF) {
      return result
    }
  }
  return result
}

/**
 * 估算整数幂结果的十进制位数（不做实际运算，用于防御性收敛）
 * @param base 底数
 * @param kStr 指数（非负整数字符串）
 * @param negExp 指数是否为负
 * @returns 结果的十进制位数估算值（可为负，表示趋近于零）
 */
function estimatePowDigits(base: BigRaw, kStr: string, negExp: boolean): number {
  const leadLen: number = Math.min(15, base.c.length)
  const lead: number = parseFloat(base.c.substring(0, leadLen))
  const m: number = lead / Math.pow(10, leadLen - 1)
  // log10(|base|) = (十进制指数) + log10(首位有效数字构成的小数)
  const lg: number = (base.e + base.c.length - 1) + Math.log(m) / 2.302585092994046
  const kn: number = kStr.length > 6 ? 1000000 : parseInt(kStr)
  const est: number = kn * lg * (negExp ? -1 : 1)
  return isFinite(est) ? est : 1000000
}

/**
 * 取 raw 的整数数字串（要求 raw 为整数）
 * @param r 输入 raw
 * @returns 整数字符串
 */
function rawToIntString(r: BigRaw): string {
  if (r.s == 0) {
    return '0'
  }
  if (r.e >= 0) {
    return r.c + ziZeros(r.e)
  }
  // 小数部分全为零时可直接截断（rawIsInteger 保证）
  return r.c.substring(0, r.c.length + r.e)
}

/**
 * 把 raw 转成定点整数（放大 10^p 倍，四舍五入）
 * @param r 输入 raw
 * @param p 定点精度
 * @returns 定点整数串（可能带负号）
 */
function rawToFixedInt(r: BigRaw, p: number): string {
  if (r.k != K_FINITE || r.s == 0) {
    return '0'
  }
  const shifted: number = r.e + p
  let digits: string = r.c
  if (shifted >= 0) {
    digits = r.c + ziZeros(shifted)
  }
  else {
    digits = ziShiftRoundHalfUp(r.c, -shifted)
  }
  return r.s < 0 ? '-' + digits : digits
}

/** 从非负整数字符串构造 raw */
function rawFromIntString(s: string, sign: number): BigRaw {
  return rawNormalize(sign, s, 0)
}

/**
 * 取十进制字符对应数值
 * @param ch 单个字符
 * @param base 进制
 * @returns 0..35，非法返回 -1
 */
function charToDigit(ch: string, base: number): number {
  const code: number = ch.charCodeAt(0) ?? 0
  if (code >= CH_ZERO && code <= CH_NINE) {
    const v: number = code - CH_ZERO
    return v < base ? v : -1
  }
  const lower: string = ch.toLowerCase()
  const idx: number = CFG_ALPHABET.indexOf(lower)
  if (idx < 0 || idx >= base) {
    return -1
  }
  return idx
}

/** 取数值对应的进制字符 */
function digitToChar(v: number): string {
  return CFG_ALPHABET.substring(v, v + 1)
}

/**
 * 解析「可带符号的十进制整数串」用于指数部分
 * @param s 输入串
 * @returns 数值（越界时钳制）
 */
function parseExpNumber(s: string): number {
  if (s.length == 0) {
    return 0
  }
  let sign: number = 1
  let body: string = s
  if ((body.charCodeAt(0) ?? 0) == CH_MINUS || (body.charCodeAt(0) ?? 0) == CH_PLUS) {
    sign = (body.charCodeAt(0) ?? 0) == CH_MINUS ? -1 : 1
    body = body.substring(1)
  }
  if (body.length == 0) {
    return 0
  }
  for (let i: number = 0; i < body.length; i++) {
    const c: number = body.charCodeAt(i) ?? 0
    if (c < CH_ZERO || c > CH_NINE) {
      return 0
    }
  }
  if (body.length > 9) {
    return sign * 1000000000
  }
  return sign * parseInt(body)
}

/**
 * 在 base 10 下定位指数标记 e / E
 * @param s 输入串
 * @returns 下标，找不到返回 -1
 */
function findExpIndex(s: string): number {
  for (let i: number = 0; i < s.length; i++) {
    const c: number = s.charCodeAt(i) ?? 0
    if (c == 101 || c == 69) {
      return i
    }
  }
  return -1
}

/**
 * 把字符串按指定进制解析为 raw
 * @param src 原始字符串
 * @param base 进制（2~36）
 * @returns 解析结果（非法输入返回 NaN）
 */
function rawFromString(src: string, base: number): BigRaw {
  if (base < 2 || base > 36) {
    return rawNaN()
  }
  // 去掉空白与下划线分隔符
  let s: string = ''
  for (let i: number = 0; i < src.length; i++) {
    const ch: string = src.substring(i, i + 1)
    if (ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r' || ch == '_') {
      continue
    }
    s += ch
  }
  if (s.length == 0) {
    return rawNaN()
  }
  let sign: number = 1
  const head: number = s.charCodeAt(0) ?? 0
  if (head == CH_MINUS || head == CH_PLUS) {
    sign = head == CH_MINUS ? -1 : 1
    s = s.substring(1)
  }
  if (s.length == 0) {
    return rawNaN()
  }
  if (s == 'Infinity') {
    return rawInf(sign)
  }
  if (s == 'NaN') {
    return rawNaN()
  }
  // 指数部分（仅十进制支持 e 记法）
  let expPart: number = 0
  if (base == 10) {
    const eIdx: number = findExpIndex(s)
    if (eIdx >= 0) {
      const expStr: string = s.substring(eIdx + 1)
      if (expStr.length == 0) {
        return rawNaN()
      }
      expPart = parseExpNumber(expStr)
      s = s.substring(0, eIdx)
    }
  }
  // 拆分整数与小数部分
  const dotIdx: number = s.indexOf('.')
  let intDigits: string = dotIdx >= 0 ? s.substring(0, dotIdx) : s
  let fracDigits: string = dotIdx >= 0 ? s.substring(dotIdx + 1) : ''
  if (dotIdx >= 0 && s.indexOf('.', dotIdx + 1) >= 0) {
    return rawNaN()
  }
  if (intDigits.length == 0 && fracDigits.length == 0) {
    return rawNaN()
  }
  if (base == 10) {
    let digits: string = ''
    for (let i: number = 0; i < intDigits.length; i++) {
      const c: number = intDigits.charCodeAt(i) ?? 0
      if (c < CH_ZERO || c > CH_NINE) {
        return rawNaN()
      }
      digits += intDigits.substring(i, i + 1)
    }
    for (let i: number = 0; i < fracDigits.length; i++) {
      const c: number = fracDigits.charCodeAt(i) ?? 0
      if (c < CH_ZERO || c > CH_NINE) {
        return rawNaN()
      }
      digits += fracDigits.substring(i, i + 1)
    }
    if (digits.length == 0) {
      return rawNaN()
    }
    return rawNormalize(sign, digits, -fracDigits.length + expPart)
  }
  // 2~36 进制
  let intVal: string = '0'
  for (let i: number = 0; i < intDigits.length; i++) {
    const d: number = charToDigit(intDigits.substring(i, i + 1), base)
    if (d < 0) {
      return rawNaN()
    }
    intVal = ziAdd(ziMulSmall(intVal, base), d.toString())
  }
  let result: BigRaw = rawFromIntString(intVal, 1)
  if (fracDigits.length > 0) {
    let fracNum: string = '0'
    for (let i: number = 0; i < fracDigits.length; i++) {
      const d: number = charToDigit(fracDigits.substring(i, i + 1), base)
      if (d < 0) {
        return rawNaN()
      }
      fracNum = ziAdd(ziMulSmall(fracNum, base), d.toString())
    }
    if (!ziIsZero(fracNum)) {
      let den: string = '1'
      for (let i: number = 0; i < fracDigits.length; i++) {
        den = ziMulSmall(den, base)
      }
      // 非十进制分数可能无限循环，取 40 位十进制精度
      const fracRaw: BigRaw = rawDivAbs(fracNum, 0, den, 0, 40, ROUND_DOWN)
      result = rawPlus(result, fracRaw)
    }
  }
  return rawWithSign(result, sign)
}

/**
 * 把数值解析为 raw
 * @param n 数值
 * @returns 解析结果
 */
function rawFromNumber(n: number): BigRaw {
  if (isNaN(n)) {
    return rawNaN()
  }
  if (!isFinite(n)) {
    return rawInf(n > 0 ? 1 : -1)
  }
  if (n == 0) {
    return rawZero()
  }
  // toString 可能是 '1.5' / '1e+21' / '1.0E21'（Kotlin），解析层都已兼容
  return rawFromString(n.toString(), 10)
}

/**
 * 把「按 10^p 放大的带符号定点整数」转回 raw（初等函数结果回灌用）
 * @param fixed 带符号定点整数字符串
 * @param p 定点精度
 * @returns 对应数值的 raw
 */
function rawFromFixedInt(fixed: string, p: number): BigRaw {
  const sign: number = fixed.length > 0 && (fixed.charCodeAt(0) ?? 0) == CH_MINUS ? -1 : 1
  return rawNormalize(sign, fxAbs(fixed), -p)
}

// #endregion

// #region 全局配置

/** 格式化选项 */
export type BigNumberFormat = {
  /** 小数点符号 */
  decimalSeparator: string
  /** 整数分组符号 */
  groupSeparator: string
  /** 整数组大小，0 表示不分组 */
  groupSize: number
  /** 高位次级分组大小（印度式分组用），0 表示不分次级组 */
  secondaryGroupSize: number
  /** 小数分组符号 */
  fractionGroupSeparator: string
  /** 小数组大小，0 表示不分组 */
  fractionGroupSize: number
  /** 前缀 */
  prefix: string
  /** 后缀 */
  suffix: string
}

/** 格式化选项（入参，字段可省略） */
export type BigNumberFormatInput = {
  decimalSeparator?: string
  groupSeparator?: string
  groupSize?: number
  secondaryGroupSize?: number
  fractionGroupSeparator?: string
  fractionGroupSize?: number
  prefix?: string
  suffix?: string
}

/** 配置项（入参，字段可省略） */
export type BigNumberConfigInput = {
  /** 除法 / 开方等运算保留的小数位，默认 20 */
  DECIMAL_PLACES?: number
  /** 默认舍入模式 0~8，默认 4（四舍五入） */
  ROUNDING_MODE?: number
  /** 科学计数法阈值 [负阈值, 正阈值]，默认 [-7, 20] */
  EXPONENTIAL_AT?: Array<number>
  /** 指数取值范围 [下界, 上界]，默认 [-1e9, 1e9] */
  RANGE?: Array<number>
  /** 是否使用加密安全随机（本库暂未使用随机数，仅占位），默认 false */
  CRYPTO?: boolean
  /** 取模模式，1 向零截断 / 9 欧几里得，默认 1 */
  MODULO_MODE?: number
  /** 非整数次幂的额外精度，默认 0（跟随 DECIMAL_PLACES） */
  POW_PRECISION?: number
  /** 进制字符表，默认 0-9a-z */
  ALPHABET?: string
  /** 格式化选项 */
  FORMAT?: BigNumberFormatInput
}

/** 配置项（出参，全部字段都会返回） */
export type BigNumberConfigOutput = {
  DECIMAL_PLACES: number
  ROUNDING_MODE: number
  EXPONENTIAL_AT: Array<number>
  RANGE: Array<number>
  CRYPTO: boolean
  MODULO_MODE: number
  POW_PRECISION: number
  ALPHABET: string
  FORMAT: BigNumberFormat
}

/** 当前小数位 */
let CFG_DP: number = 20
/** 当前舍入模式 */
let CFG_RM: number = ROUND_HALF_UP
/** 科学计数法负阈值（dex <= 该值时用科学计数法） */
let CFG_EXP_NEG: number = -7
/** 科学计数法正阈值（dex >= 该值时用科学计数法） */
let CFG_EXP_POS: number = 21
/** 指数下界 */
let CFG_RANGE_NEG: number = -1000000000
/** 指数上界 */
let CFG_RANGE_POS: number = 1000000000
/** 是否启用加密随机（保留项） */
let CFG_CRYPTO: boolean = false
/** 取模模式 */
let CFG_MODULO: number = MODULO_MODE_DOWN
/** 非整数次幂额外精度 */
let CFG_POW_PRECISION: number = 0
/** 进制字符表 */
let CFG_ALPHABET: string = '0123456789abcdefghijklmnopqrstuvwxyz'
/** 格式化选项 */
let CFG_FORMAT: BigNumberFormat = {
  decimalSeparator: '.',
  groupSeparator: ',',
  groupSize: 3,
  secondaryGroupSize: 0,
  fractionGroupSeparator: ' ',
  fractionGroupSize: 0,
  prefix: '',
  suffix: ''
} as BigNumberFormat

/** 非整数次幂使用的内部定点精度（保护位） */
const POW_GUARD_DIGITS: number = 25
/** 整数幂结果允许的最大十进制位数（超出直接收敛为 ±Infinity / ±0，避免内存与耗时失控） */
const MAX_POW_DIGITS: number = 100000

/**
 * 更新全局配置（对应 bignumber.js 的 `BigNumber.config`）
 * @param cfg 配置项，字段可省略
 * @returns 更新后的完整配置
 */
export function config(cfg: BigNumberConfigInput): BigNumberConfigOutput {
  const dp = cfg.DECIMAL_PLACES
  if (dp != null && dp >= 0 && dp <= 1000000) {
    CFG_DP = Math.floor(dp)
  }
  const rm = cfg.ROUNDING_MODE
  if (rm != null && rm >= 0 && rm <= 8) {
    CFG_RM = Math.floor(rm)
  }
  const ea = cfg.EXPONENTIAL_AT
  if (ea != null && ea.length > 1) {
    CFG_EXP_NEG = Math.floor(ea[0])
    CFG_EXP_POS = Math.floor(ea[1]) + 1
  }
  const range = cfg.RANGE
  if (range != null && range.length > 1) {
    CFG_RANGE_NEG = Math.floor(range[0])
    CFG_RANGE_POS = Math.floor(range[1])
  }
  const crypto = cfg.CRYPTO
  if (crypto != null) {
    CFG_CRYPTO = crypto
  }
  const mm = cfg.MODULO_MODE
  if (mm != null) {
    CFG_MODULO = Math.floor(mm)
  }
  const pp = cfg.POW_PRECISION
  if (pp != null && pp >= 0) {
    CFG_POW_PRECISION = Math.floor(pp)
  }
  const alpha = cfg.ALPHABET
  if (alpha != null && alpha.length >= 2 && alpha.length <= 36) {
    CFG_ALPHABET = alpha
  }
  const fmt = cfg.FORMAT
  if (fmt != null) {
    CFG_FORMAT = mergeFormat(fmt)
  }
  return getConfig()
}

/**
 * 读取当前全局配置（对应 bignumber.js 的 `BigNumber.config()`）
 * @returns 完整配置
 */
export function getConfig(): BigNumberConfigOutput {
  return {
    DECIMAL_PLACES: CFG_DP,
    ROUNDING_MODE: CFG_RM,
    EXPONENTIAL_AT: [CFG_EXP_NEG, CFG_EXP_POS - 1] as Array<number>,
    RANGE: [CFG_RANGE_NEG, CFG_RANGE_POS] as Array<number>,
    CRYPTO: CFG_CRYPTO,
    MODULO_MODE: CFG_MODULO,
    POW_PRECISION: CFG_POW_PRECISION,
    ALPHABET: CFG_ALPHABET,
    FORMAT: CFG_FORMAT
  } as BigNumberConfigOutput
}

/**
 * 把部分格式化选项合并到当前配置
 * @param fmt 部分选项
 * @returns 合并后的完整选项
 */
function mergeFormat(fmt: BigNumberFormatInput): BigNumberFormat {
  const base: BigNumberFormat = CFG_FORMAT
  const ds = fmt.decimalSeparator
  const gs = fmt.groupSeparator
  const gz = fmt.groupSize
  const sgs = fmt.secondaryGroupSize
  const fgs = fmt.fractionGroupSeparator
  const fgz = fmt.fractionGroupSize
  const pre = fmt.prefix
  const suf = fmt.suffix
  return {
    decimalSeparator: ds != null ? ds : base.decimalSeparator,
    groupSeparator: gs != null ? gs : base.groupSeparator,
    groupSize: gz != null ? gz : base.groupSize,
    secondaryGroupSize: sgs != null ? sgs : base.secondaryGroupSize,
    fractionGroupSeparator: fgs != null ? fgs : base.fractionGroupSeparator,
    fractionGroupSize: fgz != null ? fgz : base.fractionGroupSize,
    prefix: pre != null ? pre : base.prefix,
    suffix: suf != null ? suf : base.suffix
  } as BigNumberFormat
}

// #endregion

// #region 渲染与进制转换

/**
 * 把十进制系数拆分为整数部分与小数部分
 * @param c 系数数字串
 * @param e 指数
 * @returns 拆分结果
 */
function splitDecimal(c: string, e: number): DecSplit {
  if (e >= 0) {
    return { intPart: c + ziZeros(e), fracPart: '' } as DecSplit
  }
  const frac: number = -e
  if (c.length > frac) {
    return { intPart: c.substring(0, c.length - frac), fracPart: c.substring(c.length - frac) } as DecSplit
  }
  return { intPart: '0', fracPart: ziZeros(frac - c.length) + c } as DecSplit
}

/**
 * 十进制非科学计数法渲染
 * @param c 系数
 * @param e 指数
 * @returns 普通小数串
 */
function renderPlain(c: string, e: number): string {
  const parts: DecSplit = splitDecimal(c, e)
  if (parts.fracPart.length == 0) {
    return parts.intPart
  }
  return parts.intPart + '.' + parts.fracPart
}

/**
 * 十进制科学计数法渲染
 * @param c 系数
 * @param dex 最高位十进制指数
 * @returns 科学计数法串（不含符号）
 */
function renderExponential(c: string, dex: number): string {
  const head: string = c.substring(0, 1)
  const tail: string = c.length > 1 ? c.substring(1) : ''
  const mantissa: string = tail.length > 0 ? head + '.' + tail : head
  const expStr: string = (dex < 0 ? '-' : '+') + Math.abs(dex).toString()
  return mantissa + 'e' + expStr
}

/**
 * 非十进制整数部分转换
 * @param digits 十进制整数串
 * @param base 目标进制
 * @returns 目标进制串
 */
function intToBase(digits: string, base: number): string {
  if (ziIsZero(digits)) {
    return '0'
  }
  const out: Array<string> = []
  let cur: string = digits
  while (!ziIsZero(cur)) {
    const dm = ziDivModSmall(cur, base)
    out.push(digitToChar(parseInt(dm.r)))
    cur = dm.q
  }
  out.reverse()
  return out.join('')
}

/**
 * 非十进制小数部分转换（最多输出 DECIMAL_PLACES 位）
 * @param fracDigits 十进制小数字符串
 * @param base 目标进制
 * @returns 目标进制小数字符串
 */
function fracToBase(fracDigits: string, base: number): string {
  const maxDigits: number = CFG_DP > 0 ? Math.floor(CFG_DP) : 0
  if (maxDigits == 0) {
    return ''
  }
  let num: string = fracDigits
  const den: string = ziPow10(fracDigits.length)
  const out: Array<string> = []
  for (let i: number = 0; i < maxDigits; i++) {
    num = ziMulSmall(num, base)
    const dm = ziDivMod(num, den)
    out.push(digitToChar(parseInt(dm.q)))
    num = dm.r
    if (ziIsZero(num)) {
      break
    }
  }
  return out.join('')
}

/**
 * 渲染为指定进制的字符串
 * @param r 输入 raw
 * @param base 目标进制
 * @returns 字符串
 */
function rawToString(r: BigRaw, base: number): string {
  if (r.k == K_NAN) {
    return 'NaN'
  }
  if (r.k == K_INF) {
    return r.s < 0 ? '-Infinity' : 'Infinity'
  }
  if (r.s == 0) {
    return '0'
  }
  const signStr: string = r.s < 0 ? '-' : ''
  if (base != 10) {
    const parts: DecSplit = splitDecimal(r.c, r.e)
    const intStr: string = intToBase(parts.intPart, base)
    if (parts.fracPart.length == 0) {
      return signStr + intStr
    }
    const fracStr: string = fracToBase(parts.fracPart, base)
    if (fracStr.length == 0) {
      return signStr + intStr
    }
    return signStr + intStr + '.' + fracStr
  }
  const dex: number = r.e + r.c.length - 1
  if (dex <= CFG_EXP_NEG || dex >= CFG_EXP_POS) {
    return signStr + renderExponential(r.c, dex)
  }
  return signStr + renderPlain(r.c, r.e)
}

/**
 * 渲染为固定小数位的字符串
 * @param r 输入 raw
 * @param dp 小数位
 * @returns 字符串
 */
function rawToFixed(r: BigRaw, dp: number): string {
  if (r.k == K_NAN) {
    return 'NaN'
  }
  if (r.k == K_INF) {
    return r.s < 0 ? '-Infinity' : 'Infinity'
  }
  const signStr: string = r.s < 0 ? '-' : ''
  const parts: DecSplit = splitDecimal(r.c, r.e)
  let fracStr: string = parts.fracPart
  if (fracStr.length < dp) {
    fracStr = fracStr + ziZeros(dp - fracStr.length)
  }
  if (dp <= 0) {
    return signStr + parts.intPart
  }
  return signStr + parts.intPart + '.' + fracStr
}

/**
 * 按分组选项插入分隔符
 * @param value 数字串（不含符号与小数点）
 * @param size 组大小
 * @param secondary 次级组大小
 * @param separator 分隔符
 * @returns 分组后的串
 */
function groupDigits(value: string, size: number, secondary: number, separator: string): string {
  if (size <= 0 || value.length <= size || separator.length == 0) {
    return value
  }
  // 从低位往高位按 size 切组，最高一组允许短于 size；secondary 用于印度式分组（如 1,23,45,678）
  const secSize: number = secondary > 0 ? secondary : size
  const parts: Array<string> = []
  parts.push(value.substring(value.length - size))
  let rest: string = value.substring(0, value.length - size)
  while (rest.length > secSize) {
    parts.push(rest.substring(rest.length - secSize))
    rest = rest.substring(0, rest.length - secSize)
  }
  if (rest.length > 0) {
    parts.push(rest)
  }
  parts.reverse()
  return parts.join(separator)
}

/**
 * 按 FORMAT 配置渲染（千分位等）
 * @param r 输入 raw
 * @param dp 小数位
 * @returns 字符串
 */
function rawToFormat(r: BigRaw, dp: number): string {
  if (r.k == K_NAN) {
    return 'NaN'
  }
  if (r.k == K_INF) {
    return r.s < 0 ? '-Infinity' : 'Infinity'
  }
  const fmt: BigNumberFormat = CFG_FORMAT
  const signStr: string = r.s < 0 ? '-' : ''
  if (r.s == 0) {
    const zeros: string = dp > 0 ? fmt.decimalSeparator + ziZeros(dp) : ''
    return fmt.prefix + signStr + '0' + zeros + fmt.suffix
  }
  const parts: DecSplit = splitDecimal(r.c, r.e)
  const intStr: string = groupDigits(parts.intPart, fmt.groupSize, fmt.secondaryGroupSize, fmt.groupSeparator)
  let fracStr: string = parts.fracPart
  if (fracStr.length < dp) {
    fracStr = fracStr + ziZeros(dp - fracStr.length)
  }
  if (dp <= 0) {
    return fmt.prefix + signStr + intStr + fmt.suffix
  }
  const fracGrouped: string = groupDigits(fracStr, fmt.fractionGroupSize, 0, fmt.fractionGroupSeparator)
  return fmt.prefix + signStr + intStr + fmt.decimalSeparator + fracGrouped + fmt.suffix
}

// #endregion

// #region BigNumber 类

/**
 * 空基类：只为让 `BigNumber` 有资格写 `override toString()`
 *
 * 原生端（Kotlin / Swift / ArkTS）的根类型 `Any` 自带 `toString()`，
 * 子类要覆写它**必须**带 `override` 修饰符；而 UTS 的类型检查又规定
 * 「带 `override` 的成员，其所在类必须 `extends` 其他类」，
 * 于是就只能垫这一层空基类。业务代码无需感知，本类也不导出。
 */
class BigNumberBase {
  constructor() {
  }
}

/**
 * 任意精度十进制大数据
 *
 * 典型用法：
 * ```uts
 * const a = new BigNumber('0.1')
 * const b = new BigNumber('0.2')
 * a.plus(b).toString() // '0.3'
 * ```
 */
export class BigNumber extends BigNumberBase {
  /** 符号：1 / -1，零与 NaN 为 0 */
  private sign: number = 1
  /** 系数数字串（无前导零、无尾随零） */
  private coeff: string = '0'
  /** 十进制指数：value = sign * coeff * 10^exp */
  private exp: number = 0
  /** 类型：0 有限 / 1 NaN / 2 Infinity */
  private kind: number = K_FINITE

  /**
   * 构造
   * @param value 字符串 / 数值 / bigint / BigNumber
   * @param base 进制（2~36），默认 10
   */
  constructor(value: any, base: number = 10) {
    super()
    this.parseValue(value, base)
  }

  /**
   * 把入参解析到内部字段
   * @param value 入参
   * @param base 进制
   */
  private parseValue(value: any, base: number): void {
    if (value == null) {
      this.write(rawNaN())
      return
    }
    const t: string = typeof value
    if (t == 'number' && base != 10) {
      this.write(rawFromString((value as number).toString(), base))
      return
    }
    this.write(this.coerce(value, base))
  }

  /**
   * 把任意入参统一转为内部表示（默认按十进制解析）
   * @param value 入参
   * @param base 进制，默认 10
   * @returns 内部表示
   */
  private coerce(value: any, base: number = 10): BigRaw {
    if (value == null) {
      return rawNaN()
    }
    if (value instanceof BigNumber) {
      const other: BigNumber = value as BigNumber
      return { s: other.sign, c: other.coeff, e: other.exp, k: other.kind } as BigRaw
    }
    const t: string = typeof value
    if (t == 'string') {
      return rawFromString(value as string, base)
    }
    if (t == 'number') {
      return rawFromNumber(value as number)
    }
    if (t == 'bigint') {
      return rawFromString((value as any).toString(), base)
    }
    return rawNaN()
  }

  /**
   * 导出内部表示
   * @returns 内部 raw
   */
  private read(): BigRaw {
    return { s: this.sign, c: this.coeff, e: this.exp, k: this.kind } as BigRaw
  }

  /**
   * 写入内部表示
   * @param r 内部 raw
   */
  private write(r: BigRaw): void {
    this.sign = r.s
    this.coeff = r.c
    this.exp = r.e
    this.kind = r.k
  }

  /**
   * 以另一个 BigNumber 为基准完成一次二元运算
   * @param value 另一个操作数
   * @param op 运算类型：plus / minus / times
   * @returns 结果
   */
  private binary(value: any, op: string): BigNumber {
    const a: BigRaw = this.read()
    const b: BigRaw = this.coerce(value)
    let result: BigRaw = rawNaN()
    if (op == 'plus') {
      result = rawPlus(a, b)
    }
    else if (op == 'minus') {
      result = rawMinus(a, b)
    }
    else {
      result = rawMul(a, b)
    }
    const out: BigNumber = new BigNumber(0)
    out.write(result)
    return out
  }

  // #region 四则运算

  /**
   * 加法
   * @param value 加数
   * @returns this + value
   */
  plus(value: any): BigNumber {
    return this.binary(value, 'plus')
  }

  /**
   * 减法
   * @param value 减数
   * @returns this - value
   */
  minus(value: any): BigNumber {
    return this.binary(value, 'minus')
  }

  /**
   * 乘法
   * @param value 乘数
   * @returns this * value
   */
  multipliedBy(value: any): BigNumber {
    return this.binary(value, 'times')
  }

  /**
   * 除法（按 DECIMAL_PLACES 与 ROUNDING_MODE 收敛）
   * @param value 除数
   * @returns this / value
   */
  dividedBy(value: any): BigNumber {
    const a: BigRaw = this.read()
    const b: BigRaw = this.coerce(value)
    const out: BigNumber = new BigNumber(0)
    out.write(rawDiv(a, b, CFG_DP, CFG_RM))
    return out
  }

  /**
   * 整除（向零截断）
   * @param value 除数
   * @returns trunc(this / value)
   */
  dividedToIntegerBy(value: any): BigNumber {
    const a: BigRaw = this.read()
    const b: BigRaw = this.coerce(value)
    const out: BigNumber = new BigNumber(0)
    out.write(rawDiv(a, b, 0, ROUND_DOWN))
    return out
  }

  /**
   * 取模（按 MODULO_MODE）
   * @param value 模数
   * @returns this mod value
   */
  modulo(value: any): BigNumber {
    const a: BigRaw = this.read()
    const b: BigRaw = this.coerce(value)
    const out: BigNumber = new BigNumber(0)
    out.write(rawModulo(a, b, CFG_MODULO))
    return out
  }

  /**
   * 幂运算
   * @param value 指数
   * @param modulus 模（传入时按整数模幂计算）
   * @returns this 的 value 次幂
   */
  exponentiatedBy(value: any, modulus: any | null = null): BigNumber {
    const a: BigRaw = this.read()
    const n: BigRaw = this.coerce(value)
    const out: BigNumber = new BigNumber(0)
    if (a.k == K_NAN || n.k == K_NAN) {
      out.write(rawNaN())
      return out
    }
    if (modulus != null) {
      const m: BigRaw = this.coerce(modulus)
      if (m.k != K_FINITE || m.s == 0 || !rawIsInteger(a) || !rawIsInteger(n)) {
        out.write(rawNaN())
        return out
      }
      const kStr: string = rawToIntString(rawAbs(n))
      out.write(rawPowInt(rawModulo(a, m, CFG_MODULO), kStr, m, CFG_MODULO))
      return out
    }
    if (n.k == K_INF) {
      // |this| > 1 时为正无穷，|this| < 1 时为 0
      const absCmp: number = rawCmpAbs(a, rawNormalize(1, '1', 0))
      if (absCmp == 0) {
        out.write(rawNaN())
      }
      else if ((absCmp > 0) == (n.s > 0)) {
        out.write(rawInf(1))
      }
      else {
        out.write(rawZero())
      }
      return out
    }
    if (n.s == 0) {
      out.write(rawNormalize(1, '1', 0))
      return out
    }
    if (a.s == 0) {
      if (n.s > 0) {
        out.write(rawZero())
      }
      else {
        out.write(rawInf(1))
      }
      return out
    }
    if (rawIsInteger(n)) {
      const negExp: boolean = n.s < 0
      const kStr: string = rawToIntString(rawAbs(n))
      // 估算结果数量级，避免构造天文数字（估算|结果|的十进制位数）
      const est: number = estimatePowDigits(a, kStr, negExp)
      if (est > MAX_POW_DIGITS || est < -MAX_POW_DIGITS) {
        out.write(est > 0 ? rawInf(1) : rawZero())
        return out
      }
      let powered: BigRaw = rawPowInt(a, kStr, null, CFG_MODULO)
      if (negExp) {
        powered = rawDiv(rawNormalize(1, '1', 0), powered, CFG_DP, CFG_RM)
      }
      out.write(powered)
      return out
    }
    // 非整数指数：x^n = exp(n * ln x)，负数底数在实数域无定义
    if (a.s < 0) {
      out.write(rawNaN())
      return out
    }
    const p: number = Math.max(CFG_DP, CFG_POW_PRECISION) + POW_GUARD_DIGITS
    // ln 结果带符号，必须按定点带符号约定回灌
    const lnRaw: BigRaw = rawFromFixedInt(fxLn(a.c, a.e, p), p)
    const yRaw: BigRaw = rawMul(n, lnRaw)
    const yFixed: string = rawToFixedInt(yRaw, p)
    const powered: FxExpResult = fxExp(yFixed, p)
    out.write(rawRoundTo(rawNormalize(1, powered.digits, powered.exp), CFG_DP, CFG_RM))
    return out
  }

  /**
   * 平方根（按 DECIMAL_PLACES 与 ROUNDING_MODE 收敛）
   * @returns sqrt(this)
   */
  sqrt(): BigNumber {
    const r: BigRaw = this.read()
    const out: BigNumber = new BigNumber(0)
    if (r.k != K_FINITE || r.s < 0) {
      out.write(rawNaN())
      return out
    }
    if (r.s == 0) {
      out.write(rawZero())
      return out
    }
    const dp: number = CFG_DP > 0 ? CFG_DP : 0
    // 目标：x = floor(sqrt(V) * 10^dp) 再按舍入模式修正
    // V * 10^(2dp) = N' / D'
    const shifted: number = r.e + 2 * dp
    let np: string = r.c
    let dpp: string = '1'
    if (shifted >= 0) {
      np = r.c + ziZeros(shifted)
    }
    else {
      dpp = ziPow10(-shifted)
    }
    const m: string = ziMul(np, dpp)
    const root: string = ziSqrt(m)
    let x: string = ziDivMod(root, dpp).q
    // 判断是否精确：N' == x^2 * D'
    const exact: boolean = ziCmp(np, ziMul(ziMul(x, x), dpp)) == 0
    if (!exact) {
      // 比较 sqrt(V)*10^dp 与 x + 0.5 ⇔ 比较 4N' 与 (2x+1)^2 * D'
      const lhs: string = ziMulSmall(np, 4)
      const t: string = ziAdd(ziMulSmall(x, 2), '1')
      const rhs: string = ziMul(ziMul(t, t), dpp)
      const cmp: number = ziCmp(lhs, rhs)
      let up: boolean = false
      if (CFG_RM == ROUND_UP) {
        up = true
      }
      else if (CFG_RM == ROUND_DOWN) {
        up = false
      }
      else if (CFG_RM == ROUND_CEIL) {
        up = true
      }
      else if (CFG_RM == ROUND_FLOOR) {
        up = false
      }
      else if (CFG_RM == ROUND_HALF_DOWN) {
        up = cmp > 0
      }
      else if (CFG_RM == ROUND_HALF_EVEN) {
        up = cmp > 0 || (cmp == 0 && ((x.charCodeAt(x.length - 1) ?? 0) - CH_ZERO) % 2 == 1)
      }
      else if (CFG_RM == ROUND_HALF_CEIL) {
        up = cmp > 0 || cmp == 0
      }
      else if (CFG_RM == ROUND_HALF_FLOOR) {
        up = cmp > 0
      }
      else {
        up = cmp >= 0
      }
      if (up) {
        x = ziAdd(x, '1')
      }
    }
    out.write(rawNormalize(1, x, -dp))
    return out
  }

  // #endregion

  // #region 比较与判定

  /**
   * 比较
   * @param value 另一操作数
   * @returns 大于返回 1，小于返回 -1，相等返回 0；任一为 NaN 返回 null
   */
  comparedTo(value: any): number | null {
    const a: BigRaw = this.read()
    const b: BigRaw = this.coerce(value)
    if (a.k == K_NAN || b.k == K_NAN) {
      return null
    }
    return rawCmp(a, b)
  }

  /**
   * 是否相等
   * @param value 另一操作数
   * @returns 是否相等
   */
  isEqualTo(value: any): boolean {
    const c: number | null = this.comparedTo(value)
    return c == 0
  }

  /**
   * 是否大于
   * @param value 另一操作数
   * @returns 是否大于
   */
  isGreaterThan(value: any): boolean {
    const c: number | null = this.comparedTo(value)
    return c == 1
  }

  /**
   * 是否大于等于
   * @param value 另一操作数
   * @returns 是否大于等于
   */
  isGreaterThanOrEqualTo(value: any): boolean {
    const c: number | null = this.comparedTo(value)
    return c == 1 || c == 0
  }

  /**
   * 是否小于
   * @param value 另一操作数
   * @returns 是否小于
   */
  isLessThan(value: any): boolean {
    const c: number | null = this.comparedTo(value)
    return c == -1
  }

  /**
   * 是否小于等于
   * @param value 另一操作数
   * @returns 是否小于等于
   */
  isLessThanOrEqualTo(value: any): boolean {
    const c: number | null = this.comparedTo(value)
    return c == -1 || c == 0
  }

  /**
   * 是否有限值
   * @returns 是否有限
   */
  isFinite(): boolean {
    return this.kind == K_FINITE
  }

  /**
   * 是否整数
   * @returns 是否整数
   */
  isInteger(): boolean {
    return rawIsInteger(this.read())
  }

  /**
   * 是否为 NaN
   * @returns 是否为 NaN
   */
  isNaN(): boolean {
    return this.kind == K_NAN
  }

  /**
   * 是否为负数（零既不是正数也不是负数）
   * @returns 是否为负数
   */
  isNegative(): boolean {
    return this.kind == K_FINITE && this.sign < 0
  }

  /**
   * 是否为正数
   * @returns 是否为正数
   */
  isPositive(): boolean {
    return this.kind == K_FINITE && this.sign > 0
  }

  /**
   * 是否为零
   * @returns 是否为零
   */
  isZero(): boolean {
    return this.kind == K_FINITE && this.sign == 0
  }

  // #endregion

  // #region 变形与统计

  /**
   * 绝对值
   * @returns |this|
   */
  absoluteValue(): BigNumber {
    const out: BigNumber = new BigNumber(0)
    out.write(rawAbs(this.read()))
    return out
  }

  /**
   * 取相反数
   * @returns -this
   */
  negated(): BigNumber {
    const out: BigNumber = new BigNumber(0)
    out.write(rawNeg(this.read()))
    return out
  }

  /**
   * 取整
   * @param rm 舍入模式，默认跟随 ROUNDING_MODE
   * @returns 取整结果
   */
  integerValue(rm: number = -1): BigNumber {
    const out: BigNumber = new BigNumber(0)
    out.write(rawRoundTo(this.read(), 0, rm >= 0 ? rm : CFG_RM))
    return out
  }

  /**
   * 小数位数：无参时返回位数，传参时返回收敛到指定位数的结果
   * @param dp 目标小数位（省略时返回统计值）
   * @param rm 舍入模式
   * @returns 小数位数（number）或收敛结果（BigNumber）；非有限值返回 null
   *
   * 注意：`any | null` 而非 `any` —— UTS 的 `any` 在原生端是非空类型，
   * 写成 `any` 会让 `return null` 在 Kotlin 侧报 `Null cannot be a value of a non-null type 'Any'`。
   */
  decimalPlaces(dp: number = -1, rm: number = -1): any | null {
    const r: BigRaw = this.read()
    if (dp < 0) {
      // NaN / ±Infinity 没有小数位概念，返回 null（与 bignumber.js 一致）
      if (r.k != K_FINITE) {
        return null
      }
      return r.e >= 0 ? 0 : -r.e
    }
    const out: BigNumber = new BigNumber(0)
    out.write(rawRoundTo(r, dp, rm >= 0 ? rm : CFG_RM))
    return out
  }

  /**
   * 有效数字：无参时返回位数，传参时返回收敛到指定位数的结果
   * @param significantDigits 目标有效数字位数；传 true 时统计时包含整数部分尾随零
   * @param rm 舍入模式
   * @returns 有效数字位数（number）或收敛结果（BigNumber）；非有限值返回 null
   */
  sd(significantDigits: any | null = null, rm: any | null = null): any | null {
    const r: BigRaw = this.read()
    if (significantDigits == null) {
      // NaN / ±Infinity 没有有效数字概念，返回 null
      if (r.k != K_FINITE) {
        return null
      }
      return r.s == 0 ? 1 : r.c.length
    }
    if (typeof significantDigits == 'boolean') {
      // NaN / ±Infinity 同样没有有效数字概念
      if (r.k != K_FINITE) {
        return null
      }
      if (r.s == 0) {
        return 1
      }
      const flag: boolean = significantDigits as boolean
      return flag ? r.c.length + (r.e > 0 ? r.e : 0) : r.c.length
    }
    const digits: number = significantDigits as number
    const mode: number = rm != null ? (rm as number) : CFG_RM
    const out: BigNumber = new BigNumber(0)
    out.write(rawRoundSd(r, digits, mode >= 0 ? mode : CFG_RM))
    return out
  }

  /**
   * 有效数字（`sd` 的别名）
   * @param significantDigits 目标有效数字位数或统计开关
   * @param rm 舍入模式
   * @returns 位数（number）或结果（BigNumber / NaN）
   */
  precision(significantDigits: any | null = null, rm: any | null = null): any | null {
    return this.sd(significantDigits, rm)
  }

  /**
   * 小数点平移
   * @param places 平移位数，正数向右（变大），负数向左（变小）
   * @returns 平移后的值
   */
  shiftedBy(places: number): BigNumber {
    const r: BigRaw = this.read()
    const out: BigNumber = new BigNumber(0)
    if (r.k != K_FINITE || r.s == 0) {
      out.write(r)
      return out
    }
    out.write(rawNormalize(r.s, r.c, r.e + Math.floor(places)))
    return out
  }

  // #endregion

  // #region 输出

  /**
   * 转换为十进制字符串（覆写 `Any.toString()`）
   *
   * ⚠️ 为什么单独留一个无参重载：原生端（Kotlin / Swift / ArkTS）的 `Any` 自带
   * `toString()`，若类里只声明带默认值的 `toString(base: number = 10)`，
   * Kotlin 的 `x.toString()` 会解析到 `Any.toString()`，返回 `BigNumber@1a2b3c` 这类
   * 对象标识串（**不报错、不警告，只有 App 端结果错**，H5 / 小程序因为原型链覆盖反而正常）。
   * 显式声明无参 `toString()` 后，Kotlin 的 `x.toString()` 才落到本方法上。
   *
   * @returns 十进制字符串
   */
  override toString(): string

  /**
   * 转换为指定进制的字符串
   * @param base 进制（2~36），默认 10
   * @returns 字符串
   */
  toString(base: number = 10): string {
    const b: number = base >= 2 && base <= 36 ? Math.floor(base) : 10
    return rawToString(this.read(), b)
  }

  /**
   * 转换为固定小数位的字符串
   * @param dp 小数位，默认 0
   * @param rm 舍入模式，默认跟随 ROUNDING_MODE
   * @returns 字符串
   */
  toFixed(dp: number = 0, rm: number = -1): string {
    const r: BigRaw = this.read()
    const digits: number = dp >= 0 ? Math.floor(dp) : 0
    return rawToFixed(rawRoundTo(r, digits, rm >= 0 ? rm : CFG_RM), digits)
  }

  /**
   * 按千分位等配置格式化
   * @param dp 小数位，默认跟随 DECIMAL_PLACES
   * @param rm 舍入模式，默认跟随 ROUNDING_MODE
   * @param format 临时格式化选项（不修改全局配置）
   * @returns 格式化后的字符串
   */
  toFormat(dp: number = -1, rm: number = -1, format: BigNumberFormatInput | null = null): string {
    const r: BigRaw = this.read()
    const digits: number = dp >= 0 ? Math.floor(dp) : CFG_DP
    const mode: number = rm >= 0 ? Math.floor(rm) : CFG_RM
    const rounded: BigRaw = rawRoundTo(r, digits, mode)
    if (format != null) {
      const backup: BigNumberFormat = CFG_FORMAT
      CFG_FORMAT = mergeFormat(format)
      const text: string = rawToFormat(rounded, digits)
      CFG_FORMAT = backup
      return text
    }
    return rawToFormat(rounded, digits)
  }

  /**
   * 转换为 JavaScript/UTS 数值（可能丢精度，仅供与原生数值互操作）
   * @returns 数值
   */
  toNumber(): number {
    if (this.kind == K_NAN) {
      return NaN
    }
    if (this.kind == K_INF) {
      return this.sign < 0 ? -Infinity : Infinity
    }
    return parseFloat(rawToString(this.read(), 10))
  }

  /**
   * 序列化为字符串（JSON.stringify 时生效）
   * @returns 字符串
   */
  toJSON(): string {
    return rawToString(this.read(), 10)
  }

  /**
   * 原始值
   * @returns 字符串
   */
  valueOf(): string {
    return rawToString(this.read(), 10)
  }

  // #endregion

  // #region 别名（与 bignumber.js 保持一致）

  /** `multipliedBy` 别名 */
  times(value: any): BigNumber {
    return this.multipliedBy(value)
  }

  /** `dividedBy` 别名 */
  div(value: any): BigNumber {
    return this.dividedBy(value)
  }

  /** `dividedToIntegerBy` 别名 */
  idiv(value: any): BigNumber {
    return this.dividedToIntegerBy(value)
  }

  /** `modulo` 别名 */
  mod(value: any): BigNumber {
    return this.modulo(value)
  }

  /** `exponentiatedBy` 别名 */
  pow(value: any, modulus: any | null = null): BigNumber {
    return this.exponentiatedBy(value, modulus)
  }

  /** `isEqualTo` 别名 */
  eq(value: any): boolean {
    return this.isEqualTo(value)
  }

  /** `isGreaterThan` 别名 */
  gt(value: any): boolean {
    return this.isGreaterThan(value)
  }

  /** `isGreaterThanOrEqualTo` 别名 */
  gte(value: any): boolean {
    return this.isGreaterThanOrEqualTo(value)
  }

  /** `isLessThan` 别名 */
  lt(value: any): boolean {
    return this.isLessThan(value)
  }

  /** `isLessThanOrEqualTo` 别名 */
  lte(value: any): boolean {
    return this.isLessThanOrEqualTo(value)
  }

  /** `decimalPlaces` 别名 */
  dp(value: number = -1, rm: number = -1): any | null {
    return this.decimalPlaces(value, rm)
  }

  /** `absoluteValue` 别名 */
  abs(): BigNumber {
    return this.absoluteValue()
  }

  // #endregion

  // #region 静态方法

  /**
   * 判断是否为 BigNumber 实例
   * @param value 待判断的值
   * @returns 是否为 BigNumber
   */
  static isBigNumber(value: any): boolean {
    return value instanceof BigNumber
  }

  /**
   * 更新全局配置
   * @param cfg 配置项
   * @returns 更新后的完整配置
   */
  static config(cfg: BigNumberConfigInput): BigNumberConfigOutput {
    return config(cfg)
  }

  /**
   * 读取全局配置
   * @returns 完整配置
   */
  static getConfig(): BigNumberConfigOutput {
    return getConfig()
  }

  /**
   * 构造快捷方法
   * @param value 入参
   * @param base 进制
   * @returns BigNumber 实例
   */
  static of(value: any, base: number = 10): BigNumber {
    return new BigNumber(value, base)
  }

  // #endregion
}

