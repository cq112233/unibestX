/**
 * 路由与页面路径工具库
 * 统一收敛页面路径规范化、清洗、当前页面路径获取与比对、以及 URL 解析方法
 */

/**
 * URL 解析结构体
 */
export type UrlObj = {
  /** 页面路由路径（不含参数） */
  path: string;
  /** 路由参数键值对 Map */
  query: Map<string, string>;
};

/**
 * 导航入参对象（对标 vue-router 的 `RouteLocationRaw`）—— 只用于 `router.push()` 这类「想去哪」的入参
 *
 * 【为什么必须有这个具名类型，而不是让 `push(to: any)` 收着】
 * 参数标成 `any` 时，VSCode / Volar 在 `router.push({ ... })` 里**一个字段都补不全**
 * （实测：`any` 弹的是一堆全局符号，`UTSJSONObject` 只弹 `getString` 之类的成员方法），
 * 只有具名对象类型才把 `path` / `query` 这些键喂给编辑器。
 *
 * 【⚠️ 与 route-types.uts 的 RouteLocation 的区别】
 * 那个是框架**归一化后读出来**的「当前位置」（query 已是 `Map`，值已解码）；
 * 这个是调用方**传进去**的「想去哪」（query 是原始 JSON 对象，值还没编码）。
 * 两个方向不要混用。
 *
 * 【⚠️ 语义变化：对象形态的约束从「必须是字面量」放宽为「字面量或本类型变量都行」】
 * 改动前 `resolveUrl()` 内部是 `to as UTSJSONObject`，而 `UTSJSONObject` 与具名 `type`
 * 在 UTS 里会生成**两个不同的运行期 class**（产物里分别 `new UTSJSONObject({...})` /
 * `new XxxRaw({...})`），所以那时只能收字面量，带类型标注的变量会在真机抛
 * `ClassCastException`（H5 / 单测不复现）。
 * 现在 `resolveUrl()` 直接按字段读 `to.path` / `to.query`，不再做强转 ——
 * 字面量与变量都被编译成同一个原生对象，那条崩溃来路就此消失。
 * 代价：**不能再传裸的 `UTSJSONObject`**（如 `JSON.parseObject()` 的返回值）；
 * 那会被类型检查挡在**编译期**，而不是拖到真机才崩 —— 这是有意的收紧。
 */
export type RouteLocationRaw = {
  /** 目标页面路径；可以是纯 path，也可以自带 query 串（如 `/a/b?x=1`） */
  path?: string;
  /** 路由名称；若未提供 path，可根据 name 去匹配获取路径 */
  name?: string;
  /** query 参数；省略表示不带参数（值由 serializeQuery 负责编码） */
  query?: UTSJSONObject;
  /** 路由参数（对标 vue-router 的 params），直接转为 query 拼接到 url 上 */
  params?: UTSJSONObject;
  /** 是否以 replace 方式跳转（替换当前页面历史，等价于 uni.redirectTo） */
  replace?: boolean;
  /** 是否走路由守卫/拦截器，默认 true；设为 false 时直接跳转并跳过拦截器 */
  intercept?: boolean;
};

/**
 * 安全 URL 解码（支持多层编码容错与异常防护）
 *
 * 各端交到我们手里的 query 值形态**不一致**，特别是带路径的重定向参数（如 redirect）：
 * - **编码态**：拦截器解析的 url、以及微信小程序/支付宝小程序的页面 options。
 * - **嵌套/多层编码态**：如拦截器跳转时 redirect 作为参数又被整体编码了一次
 *   （`%252F` -> 第一层解出 `%2F`，需二次解码为 `/`），若只解一次会导致回跳路径仍带有 URL 编码。
 * - **真含字面量 `%`**（如 `100%`）：JS 运行时会抛 `URIError`、UTS 原生侧返回 null，
 *   两端都要兜住并保留原文 —— 而不是退化成空串或崩溃。
 *
 * @param value 待解码的原始字符串
 * @returns 解码后的值；不含 `%` 或解码失败时原样返回
 */
export function decodeSafe(value: string): string {
  let res = value;
  if (!res.includes('%')) {
    return res;
  }
  try {
    const firstDecoded = decodeURIComponent(res);
    if (firstDecoded != null) {
      res = firstDecoded;
      // 容错多层编码：若解完一层仍残留常见的 URL 元字符编码（/、?、=、&），再尝试解一层
      if (
        res.includes('%2F') || res.includes('%2f')
        || res.includes('%3F') || res.includes('%3f')
        || res.includes('%3D') || res.includes('%3d')
        || res.includes('%26')
      ) {
        try {
          const secondDecoded = decodeURIComponent(res);
          if (secondDecoded != null) {
            res = secondDecoded;
          }
        }
        catch {}
      }
    }
  }
  catch {}
  return res;
}

/**
 * query 参数值的 URL 解码（容错版，路由状态入库前统一走它）
 * 内部统一走 decodeSafe，实现单层与嵌套多层编码的自动安全解码。
 *
 * @param value query 原始值
 * @returns 解码后的值；不含 `%` 或解码失败时原样返回
 */
export function decodeQueryValue(value: string): string {
  return decodeSafe(value);
}

/**
 * 解析 URL 字符串为路径与参数键值对
 * 例如: "/src/pages/login?redirect=index" -> { path: "/src/pages/login", query: { redirect: "index" } }
 *
 * 值统一过 decodeQueryValue，保证与页面 options / onAppRoute 事件同口径（都是解码态）。
 *
 * @param url 待解析的 URL 字符串
 * @returns 包含 path 和 query Map 的 UrlObj
 */
export function parseUrlToObj(url: string): UrlObj {
  const parts = url.split('?');
  const path = parts[0];
  const query = new Map<string, string>();
  if (parts.length > 1) {
    const queryStr = parts[1];
    const pairs = queryStr.split('&');
    for (let i = 0; i < pairs.length; i++) {
      const pair = pairs[i].split('=');
      if (pair.length > 1) {
        const key = pair[0];
        query.set(key, decodeQueryValue(pair[1]));
      }
      else if (pair.length > 0) {
        query.set(pair[0], '');
      }
    }
  }
  return { path, query } as UrlObj;
}

/**
 * 保证路径以前导斜杠 "/" 开头
 * 例如："pages/index" -> "/pages/index"
 *
 * @param path 原始路径
 * @returns 以前导斜杠开头的路径
 */
export function ensureLeadingSlash(path: string): string {
  if (path.length == 0) {
    return '/';
  }
  return path.startsWith('/') ? path : `/${path}`;
}

/**
 * 去除路径前导斜杠 "/"
 * 例如："/pages/index" -> "pages/index"
 *
 * @param path 原始路径
 * @returns 去除前导斜杠后的路径
 */
export function removeLeadingSlash(path: string): string {
  if (path.startsWith('/')) {
    return path.substring(1);
  }
  return path;
}

/**
 * 清洗并规范化页面路径（去除 ? 及后面的查询参数，统一保证前导 /）
 * 例如：
 * - "src/pages/index/index?foo=1" -> "/src/pages/index/index"
 * - "/pages/index/index?tab=2" -> "/pages/index/index"
 * - "pages/index/index" -> "/pages/index/index"
 *
 * @param path 原始路径或包含参数的 URL
 * @returns 规范化后的路径（以 / 开头，不含 query 参数）
 */
export function cleanPath(path: string): string {
  if (path.length == 0) {
    return '';
  }
  let p = path.trim();
  const queryIdx = p.indexOf('?');
  if (queryIdx >= 0) {
    p = p.substring(0, queryIdx);
  }
  return p.startsWith('/') ? p : `/${p}`;
}

/**
 * 路径 Key 标准化（去除 /src/ 前缀，统一规范为 /pages/... 或 /sub/... 格式）
 * 专供 Map Key、存储索引等精确比对使用
 *
 * @param path 原始路径或 URL
 * @returns 标准化后的绝对路径
 */
export function canonicalPath(path: string): string {
  const p = cleanPath(path);
  if (p.startsWith('/src/')) {
    return p.substring(4);
  }
  return p;
}

/**
 * 比较两个页面路径是否指向同一页面
 * 自动去除 query 参数与前导斜杠，支持完整匹配与结尾路由匹配
 * 例如：
 * - "/pages/index/index" 与 "pages/index/index?foo=1" -> true
 * - "/src/pages/index/index" 与 "pages/index/index" -> true
 * - "pages/index/index" 与 "/pages/index/index" -> true
 *
 * @param path1 路径1
 * @param path2 路径2
 * @returns 是否指向同一页面
 */
export function isSamePath(path1: string, path2: string): boolean {
  if (path1.length == 0 && path2.length == 0) {
    return true;
  }
  if (path1.length == 0 || path2.length == 0) {
    return false;
  }
  const p1 = cleanPath(path1);
  const p2 = cleanPath(path2);
  if (p1 == p2) {
    return true;
  }
  // 去除前导斜杠后再比一次
  const raw1 = removeLeadingSlash(p1);
  const raw2 = removeLeadingSlash(p2);
  if (raw1 == raw2) {
    return true;
  }
  if (raw1.length == 0 || raw2.length == 0) {
    return false;
  }
  // 支持末尾路由包含匹配（处理带或不带 src/ 前缀的场景）
  return raw1.endsWith(raw2) || raw2.endsWith(raw1);
}

/**
 * 获取当前栈顶页面的原生 route 路径字符串（如 "pages/index/index"）
 * @returns 页面路由字符串，未获取到时返回空字符串 ""
 */
export function getCurrentRoute(): string {
  try {
    const pages = getCurrentPages();
    if (pages.length > 0) {
      const page = pages[pages.length - 1];
      return page.route ?? '';
    }
  }
  catch {
    // ignore
  }
  return '';
}

/**
 * 获取当前栈顶页面的路由参数对象（UniPage.options，即进入该页时带的 query）
 *
 * 为什么需要它：`uni.onAppRoute` 在**目标页 onShow 之后**才触发，且 App 端页面栈本身有滞后，
 * 冷启动 / 返回 / 页面重新显示这些「稳定时机」需要一个不依赖事件的当前页参数来源。
 * `options` 与 `route` 同属官方 UniPage 属性，平台支持：
 * Android unixVer 4.31 / iOS 4.31 / Web 4.31 / 微信小程序 √。
 *
 * ⚠️ **各端给出的值编码态不一致**：微信小程序的 `options` 是 **URL 编码态**（微信官方口径），
 *    App / H5 多为解码态。取到值后必须过 decodeQueryValue 归一，不要直接塞进路由状态。
 *
 * @returns 栈顶页面的参数对象；页面栈为空、平台未实现或参数为空时返回 null
 */
export function getCurrentPageOptions(): UTSJSONObject | null {
  try {
    const pages = getCurrentPages();
    if (pages.length > 0) {
      const page = pages[pages.length - 1];
      // `?? null` 不能省：声明侧 options 是可选属性（真源在部分平台未实现），
      // 直接赋值会因 `undefined` 报 TS2322（同 getCurrentRoute 的 `route ?? ''`）
      const options: UTSJSONObject | null = page.options ?? null;
      if (options == null) {
        return null;
      }
      return options;
    }
  }
  catch {
    // ignore
  }
  return null;
}

/**
 * 获取当前栈顶页面的规范化路径（统一带前导 "/"，且去除 URL 参数）
 * 例如："/pages/index/index"
 * @returns 规范化路径字符串，未获取到时返回空字符串 ""
 */
export function getCurrentPath(): string {
  const route = getCurrentRoute();
  if (route.length == 0) {
    return '';
  }
  return cleanPath(route);
}

/**
 * 获取 URL 中的查询参数字符串（去除 ?）
 * 例如："/pages/login?from=home&tab=1" -> "from=home&tab=1"
 *
 * @param url 完整 URL 字符串
 * @returns 查询参数字符串，无参数时返回空字符串 ""
 */
export function getQueryString(url: string): string {
  const idx = url.indexOf('?');
  if (idx >= 0 && idx < url.length - 1) {
    return url.substring(idx + 1);
  }
  return '';
}

/**
 * 获取当前页面栈的深度（当前打开的页面数）
 * @returns 页面栈数量
 */
export function getPageStackLength(): number {
  try {
    return getCurrentPages().length;
  }
  catch {
    return 0;
  }
}

/**
 * query 值的字符串化：string / number / boolean 直转，数组用 `,` 连接，其余走 JSON
 *
 * @param value 任意 query 值
 * @returns 字符串形态；对象序列化失败时返回空串
 */
export function queryValueToString(value: any): string {
  if (Array.isArray(value)) {
    const arr = value as Array<any>;
    const items: Array<string> = [];
    for (let i = 0; i < arr.length; i++) {
      items.push(queryValueToString(arr[i]));
    }
    return items.join(',');
  }
  const valueType = typeof value;
  if (valueType == 'string') {
    return value as string;
  }
  if (valueType == 'number') {
    return `${value as number}`;
  }
  if (valueType == 'boolean') {
    return (value as boolean) ? 'true' : 'false';
  }
  if (valueType == 'object') {
    return JSON.stringify(value) ?? '';
  }
  return '';
}

/**
 * 把 `{ key: value }` 形态的 query 对象序列化为 query 串（值做 URL 编码）
 *
 * ⚠️ 键遍历必须用 `UTSJSONObject.keys()` + `getAny()`：写成
 *    `query.toMap().forEach((value: any, key: string) => {})` 会因给 any 值参数
 *    显式标注类型而在 Kotlin 端报 error17（详见分册 1.14）。
 *
 * @param query query 对象，值为 null 的键按「忽略」处理
 * @returns 形如 `id=1&tab=home` 的 query 串，无有效键时返回空串
 */
export function serializeQuery(query: UTSJSONObject | null): string {
  if (query == null) {
    return '';
  }
  const parts: Array<string> = [];
  const keys = UTSJSONObject.keys(query);
  for (let i = 0; i < keys.length; i++) {
    const key = keys[i];
    const value = query[key];
    if (value == null) {
      continue;
    }
    parts.push(`${key}=${encodeURIComponent(queryValueToString(value))}`);
  }
  return parts.join('&');
}

/** 路由名称到路径解析器函数类型 */
export type NameToPathResolver = (name: string) => string | null;

let nameToPathResolver: NameToPathResolver | null = null;

/**
 * 注册路由名 → 页面路径解析器（由 route-state.uts 初始化时注入）
 *
 * @param resolver 解析器函数，入参为 name，返回对应的页面路径或 null
 */
export function setNameToPathResolver(resolver: NameToPathResolver | null): void {
  nameToPathResolver = resolver;
}

/**
 * 根据路由名称查找对应的页面路径
 *
 * @param name 路由名称
 * @returns 页面规范化路径；未找到返回 null
 */
export function resolvePathByName(name: string): string | null {
  if (name == '') {
    return null;
  }
  const resolver = nameToPathResolver;
  if (resolver != null) {
    return resolver(name);
  }
  return null;
}

/**
 * 提取或合并 RouteLocationRaw 中的 query / params 参数对象
 *
 * @param target 导航目标对象
 * @returns 合并后的 UTSJSONObject，无任何参数时返回 null
 */
function extractLocationQuery(target: RouteLocationRaw): UTSJSONObject | null {
  const query = target.query;
  const params = target.params;
  if (query == null) {
    return params != null ? params : null;
  }
  if (params == null) {
    return query;
  }
  const merged = new UTSJSONObject();
  const queryKeys = UTSJSONObject.keys(query);
  for (let i = 0; i < queryKeys.length; i++) {
    const k = queryKeys[i];
    merged[k] = query[k];
  }
  const paramsKeys = UTSJSONObject.keys(params);
  for (let i = 0; i < paramsKeys.length; i++) {
    const k = paramsKeys[i];
    merged[k] = params[k];
  }
  return merged;
}

/**
 * 把导航目标归一化为 uni 导航 API 可直接使用的 url 字符串
 * 支持三种形态（与 vue-router 的 router.push 一致）：
 * - 字符串：`'/src/pages/index/index'`、`'subDetail?id=1'`
 * - 路径对象：`{ path: '/src/pages/detail/detail', query: { id: 1 } }`
 * - 命名路由对象：`{ name: 'modalBasicDemo', params: { id: 1 } }`（通过 name 匹配路径，params 自动转 query）
 *
 * @param to 导航目标（字符串 url，或 `{ path, name, query, params }` 字面量 / `RouteLocationRaw` 变量）
 * @returns 归一化后的 url；入参为空或缺 path/name 时返回空串 ""
 */
export function resolveUrl(to: string | RouteLocationRaw | null): string {
  if (to == null) {
    return '';
  }
  if (typeof to == 'string') {
    return to as string;
  }
  const target = to as RouteLocationRaw;
  const rawPath = target.path;
  let path = rawPath != null ? rawPath : '';

  // 若未提供 path，但提供了 name，根据 name 查找对应路径
  if (path == '') {
    const rawName = target.name;
    const name = rawName != null ? rawName : '';
    if (name != '') {
      const matched = resolvePathByName(name);
      if (matched != null && matched != '') {
        path = matched;
      }
      else {
        console.warn(`[router] 未找到路由名称「${name}」对应的页面路径`);
      }
    }
  }

  if (path == '') {
    return '';
  }

  const queryObj = extractLocationQuery(target);
  const queryStr = serializeQuery(queryObj);
  if (queryStr == '') {
    return path;
  }
  return path.includes('?') ? `${path}&${queryStr}` : `${path}?${queryStr}`;
}

// ==========================================
// 路由工具统一聚合类（全端一目了然速查与单例）
// ==========================================

/**
 * 路由工具聚合类
 *
 * 集中呈现所有路由与路径处理方法，一目了然；同时支持面向对象式 `route.xxx()` 调用。
 *
 * @example
 * ```uts
 * // 方式 1：标准具名导入（精准导入本叶子文件，别穿 @/src/router 门面）
 * import { cleanPath, getCurrentPath, parseUrlToObj } from '@/src/router/utils/utils.uts';
 *
 * // 方式 2：对象单例导入（一目了然）
 * import { route } from '@/src/router/utils/utils.uts';
 * console.log(route.getCurrentPath());
 * ```
 */
export class RouteUtils {
  /** 解析 URL 为路径与参数 Map */
  parseUrlToObj(url: string): UrlObj {
    return parseUrlToObj(url);
  }

  /** 清洗并规范化页面路径（去除 ? 参数，统一补全前导 /） */
  cleanPath(path: string): string {
    return cleanPath(path);
  }

  /** 保证路径以前导斜杠 "/" 开头 */
  ensureLeadingSlash(path: string): string {
    return ensureLeadingSlash(path);
  }

  /** 获取当前栈顶页面的规范化路径（带前导 /，不含 query） */
  getCurrentPath(): string {
    return getCurrentPath();
  }

  /** 获取当前栈顶页面的原生 route 字符串 */
  getCurrentRoute(): string {
    return getCurrentRoute();
  }

  /** 获取当前栈顶页面的路由参数对象（UniPage.options） */
  getCurrentPageOptions(): UTSJSONObject | null {
    return getCurrentPageOptions();
  }

  /** 获取当前页面栈层数 */
  getPageStackLength(): number {
    return getPageStackLength();
  }

  /** 获取 URL 中的 query 参数字符串 */
  getQueryString(url: string): string {
    return getQueryString(url);
  }

  /** 比较两个页面路径是否指向同一页面 */
  isSamePath(path1: string, path2: string): boolean {
    return isSamePath(path1, path2);
  }

  /** 去除路径的前导斜杠 "/" */
  removeLeadingSlash(path: string): string {
    return removeLeadingSlash(path);
  }

  /** 把 `{ path, query }` 对象序列化为 query 串（值做 URL 编码） */
  serializeQuery(query: UTSJSONObject | null): string {
    return serializeQuery(query);
  }

  /** 安全 URL 解码（支持多层编码容错，如 %252F -> %2F -> /） */
  decodeSafe(value: string): string {
    return decodeSafe(value);
  }

  /** query 参数值的 URL 解码（容错：不含 `%` 或解码失败时原样返回） */
  decodeQueryValue(value: string): string {
    return decodeQueryValue(value);
  }

  /** query 值的字符串化（string / number / boolean / 数组 / 对象 通用） */
  queryValueToString(value: any): string {
    return queryValueToString(value);
  }

  /** 注册路由名称到路径的解析器 */
  setNameToPathResolver(resolver: NameToPathResolver | null): void {
    setNameToPathResolver(resolver);
  }

  /** 根据路由名称查找对应的页面路径 */
  resolvePathByName(name: string): string | null {
    return resolvePathByName(name);
  }

  /** 把导航目标（字符串 url 或 `{ path, name, query, params }` 字面量 / `RouteLocationRaw` 变量）归一化为 url 字符串 */
  resolveUrl(to: string | RouteLocationRaw | null): string {
    return resolveUrl(to);
  }
}

/** 路由工具全局单例 */
export const route = new RouteUtils();

