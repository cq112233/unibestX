/**
 * 路由响应式状态（等价 vue-router 的 currentRoute）
 *
 * 页面/组件通过 `useRoute()`（见 ./useRoute.uts）读取当前路由，读取到的是响应式对象，
 * 路由变化时依赖它的模板 / computed 会自动更新。
 *
 * ## 状态从哪来（四层，互为兜底）
 *
 * 1. **主**：导航发起方在跳转前写入目标 url（见 ../interceptor/interceptor.uts 的 invoke）——
 *    「发起方知道自己要去哪」，不依赖任何平台回调时序，App / H5 / 小程序一致。
 *    必要原因见下方「onAppRoute 在目标页 onShow 之后才触发」。
 * 2. **主**：`uni.onAppRoute` 官方「路由完成」事件 —— 全端支持：App-Android / App-iOS /
 *    Web / 微信 / 鸿蒙（unixVer 5.25 起，本项目基座 5.26，真机实测**会触发**）；
 *    支付宝小程序自 HBuilderX 5.31 起支持（底层依赖 my.createRouteObserver，模拟器中未提供，需在真机环境测试；
 *    目标页不存在时不触发 onAppRoute 但会触发 onBeforeAppRoute）。
 *    类型声明不在项目的 `node_modules/@dcloudio/*` 里（那里没有 uni-app-x 包），真源在
 *    HBuilderX 内置 dts：`builtin-dts/uniappx/node_modules/@dcloudio/uni-app-x/types/
 *    uni/uts-plugin-api/lib/uni-route/utssdk/interface.d.ts`（`OnAppRoute` / `AppRouteEvent`）。
 *    事件载荷带 `path`（不含前导斜杠）、`query`、`openType`（navigateTo / navigateBack /
 *    redirectTo / reLaunch / switchTab / appLaunch）、`notFound`、`routeEventId`、`timeStamp`，
 *    因此**返回上一页、切 Tab、reLaunch 也会触发**，是这些场景最可靠的校正源。
 * 3. **兜底**：页面栈回读 `syncRouteState()` —— 读栈顶页面的 `route` + `options`，
 *    用于冷启动 / 返回上一页 / 导航失败回滚 / 页面重新显示（`useRoute()` 里注册的 onPageShow）。
 * 4. **兜底**：`useRoute()` 首次调用时的页面栈回读（仅在状态还是空的时候，见 ensureRouteReady）。
 *
 * 四层写入的是同一个 `routeState`，写入点唯一收敛在 `commitRoute()`。
 *
 * ⚠️ **onAppRoute 在目标页 onShow 之后才触发**（官方事件时序：请求 → onBeforeAppRoute →
 * 执行路由 → 目标页 onShow → onAppRoute）。也就是说**目标页 setup 的那一刻，事件还没到**，
 * 状态里存的仍是上一页 —— 单靠事件，新页面首帧会读到上一页的路由（曾经的 BUG：
 * 进入 routerBasicDemo 后 route.path 恒为 /src/pages/index/index）。所以导航发起方必须
 * 在请求时就写入目标路由（第 1 层），onAppRoute 只负责「事后校正」。
 *
 * ⚠️ **App 端页面栈有滞后**（实测 5.26 基座）：页面刚入栈的那一小段时间里，
 * `getCurrentPages()` 栈顶仍指向**上一页** —— 页面 setup 时读到的是上一页、
 * `navigateTo` 的 success 回调 + `setTimeout(0)` 读到的还是上一页。
 * 因此「页面 setup / 导航 success 时回读页面栈」这种写法在 App 上必然**整体慢一页**，
 * 页面栈只能在「确定的稳定时机」读：冷启动、返回、页面 onPageShow。
 *
 * ## 谁读到什么：`useRoute()` 返回的是**本页快照**，不是下面这个 routeState
 *
 * `routeState`（本文件）是**全局唯一一份**（四层数据源都写它），语义是「应用当前 / 正在导航到的
 * 路由」，框架侧（拦截器、回读、单测）看这一份。
 *
 * 业务侧 `useRoute()` 返回的**不是**它，而是**本次调用所在页面的独立快照**（快照的模型、两道闸
 * 与生命周期全在同目录的 ./route-snapshot.uts，本文件只负责在提交时把全局那份推给它）。
 * 为什么要拆、拆完各自的行为，见那个文件的头部说明。
 *
 * ## 路径口径
 *
 * `path` 统一走 `cleanPath()`：带前导 `/`、不带 query、不做 `src/` 前缀的增删
 * （页面栈原始 route 为 `src/pages/index/index`，onAppRoute 的 path 为 `src/pages/index/index`
 * 之外还可能不带 `src/`，两者都以调用方传入的原文为准、只补前导斜杠）。
 *
 * ## query 口径
 *
 * `route.query` 的值**一律是解码态**。四个数据源里，url 字符串（拦截器）与平台给出的参数对象
 * （onAppRoute 的 `event.query`、页面 `options`）编码态并不一致 —— 后者在微信小程序上是
 * URL 编码态 —— 故**所有入口统一过 `decodeQueryValue()`**（见 utils.uts），
 * 页面侧拿到 `route.query.get('name')` 即是可直接展示的中文。
 */
import { reactive } from 'vue';

let pageMetaJsonString: string = '';

/**
 * 设置页面元信息 JSON 字符串（可选注入）
 */
export function setPageMetaJson(jsonStr: string): void {
  pageMetaJsonString = jsonStr;
  pageConfigTable = null;
}
import {
  canonicalPath,
  cleanPath,
  decodeQueryValue,
  getCurrentPageOptions,
  getCurrentPath,
  getPageStackLength,
  getQueryString,
  isSamePath,
  parseUrlToObj,
  queryValueToString,
  setNameToPathResolver
} from '../utils/utils.uts';
import { publishRoute } from './route-snapshot.uts';
import { createEmptyRoute } from './route-types.uts';
import type { RouteLocation, RouteRecordRaw } from './route-types.uts';
import type { RouteTarget } from '../guard/types.uts';

/**
 * 当前路由（响应式）—— **全局唯一一份**，语义是「应用当前 / 正在导航到的路由」
 *
 * ⚠️ 业务侧读路由请用 `useRoute()`（返回的是**本页快照**，与这里的区别见文件头
 *    「谁读到什么」）；本对象主要给框架侧（拦截器、回读、单测）看。
 * ⚠️ 只读：外部**不要**直接赋值/改字段，那会让状态与真实页面栈脱节；
 *    请通过 `router.push()` 等导航方法或 `syncRouteState()` 驱动它更新。
 */
export const routeState: RouteLocation = reactive(createEmptyRoute());

/** 记录上一个已生效的稳定路由快照（用于在返回或目标页已冲刷状态时取到真正的离开页） */
export const previousRouteState: RouteTarget = {
  path: '',
  query: new Map<string, string>(),
  fullPath: ''
} as RouteTarget;

// ==========================================
// 路由元信息注册表（可选的轻量路由表）
// ==========================================

/** 路径 → meta 的注册表（key 为 cleanPath 规范化后的路径） */
const routeMetaMap: Map<string, UTSJSONObject> = new Map<string, UTSJSONObject>();

/** 路由名称 → 规范化路径的缓存字典 */
const nameToPathCache = new Map<string, string>();

/**
 * 注册某个页面的路由元信息，注册后 `useRoute().meta / .name` 即可读到
 *
 * @param path 页面路径，可省略前导 `/` 与 `src/` 前缀
 * @param meta 元信息对象字面量，约定字段：`name`（路由名）、`title`（页面标题）、
 *             `requireAuth`（是否需要登录）等，字段可自由扩展
 *
 * @example
 * ```uts
 * setRouteMeta('/src/pages/me/me', { name: 'me', title: '我的', requireAuth: true });
 * ```
 */
export function setRouteMeta(path: string, meta: UTSJSONObject): void {
  const key = cleanPath(path);
  if (key == '') {
    return;
  }
  routeMetaMap.set(key, meta);
  nameToPathCache.clear();
}

/**
 * 批量注册路由元信息（通过对象字典形式：路径 -> 元信息对象）
 *
 * @param metaMap 形如 { '/pages/detail/detail': { name: 'detail', title: '详情' } }
 */
export function setRoutesMeta(metaMap: UTSJSONObject): void {
  const keys = UTSJSONObject.keys(metaMap);
  for (let i = 0; i < keys.length; i++) {
    const path = keys[i];
    const meta = metaMap[path];
    if (meta != null && typeof meta == 'object') {
      const key = cleanPath(path);
      if (key != '') {
        routeMetaMap.set(key, meta as UTSJSONObject);
      }
    }
  }
  nameToPathCache.clear();
}

/**
 * 批量注册路由表列表（通过 RouteRecordRaw 数组形式，对标 vue-router 的 routes 配置）
 *
 * @param routes 形如 [{ path: '/pages/detail/detail', name: 'detail', meta: { title: '详情' } }]
 */
export function setRoutes(routes: RouteRecordRaw[]): void {
  for (let i = 0; i < routes.length; i++) {
    const item = routes[i];
    const key = cleanPath(item.path);
    if (key == '') {
      continue;
    }
    const metaObj = item.meta != null ? item.meta! : new UTSJSONObject();
    if (item.name != null && item.name != '') {
      metaObj['name'] = item.name;
    }
    routeMetaMap.set(key, metaObj);
  }
  nameToPathCache.clear();
}

/**
 * 移除某个页面的路由元信息注册
 *
 * ⚠️ 两种 `src/` 前缀写法都要删：注册时按调用方原文存 key，而查询（getRouteMeta）两种写法都能命中，
 *    只删一种会留下「换一种写法注册过、按另一种写法撤不掉」的幽灵注册值。
 *
 * @param path 页面路径，写法与 `setRouteMeta()` 注册时一致即可
 */
export function removeRouteMeta(path: string): void {
  const key = cleanPath(path);
  routeMetaMap.delete(key);
  routeMetaMap.delete(swapSrcPrefix(key));
  nameToPathCache.clear();
}

/**
 * 把路径换成另一种 `src/` 前缀写法（`/src/pages/x` ↔ `/pages/x`），用于兼容历史路径写法
 *
 * @param key cleanPath 规范化后的路径
 * @returns 换成另一种写法的路径（原本带 `/src/` 就去掉，原本不带就补上）
 */
function swapSrcPrefix(key: string): string {
  return key.startsWith('/src/') ? key.substring(4) : `/src${key}`;
}

// ==========================================
// pages.json 页面配置（route.meta 的默认数据源）
// ==========================================

/**
 * pages.json 页面配置表：路径 → 该页面的完整配置项
 *
 * 内容由构建期插件生成（plugins/vite-plugin-uni-pages.ts → src/router/generated/page-meta.uts），
 * 即「页面的 definePage 里写了什么，这里就是什么」，所以**不需要**在业务页面里手写 setRouteMeta。
 * 首次使用时解析一次并缓存；表为空（老工程未接入生成器）时静默退化为 null。
 */
let pageConfigTable: Map<string, UTSJSONObject> | null = null;

/**
 * 从路径中提取默认的路由名（路径最后一个单词）
 * 例如：/src/sub/modalBasicDemo/modalBasicDemo -> modalBasicDemo
 *
 * @param path 页面路径
 * @returns 路径最后一个单词，路径为空时返回 null
 */
export function getDefaultRouteName(path: string): string | null {
  if (path == '') {
    return null;
  }
  const clean = path.includes('?') ? path.substring(0, path.indexOf('?')) : path;
  const parts = clean.split('/');
  for (let i = parts.length - 1; i >= 0; i--) {
    const part = parts[i].trim();
    if (part != '') {
      return part;
    }
  }
  return null;
}

/**
 * 根据路由名称查找对应的页面路径
 *
 * 匹配优先级：
 * 1. 动态注册表（setRouteMeta 注册的 meta 中的 name）
 * 2. 静态页面配置表（PAGE_META_JSON 中 definePage 声明的 name）
 * 3. 兜底匹配：未显式声明 name 时的路径最后一个单词（如 /src/sub/modalBasicDemo/modalBasicDemo -> modalBasicDemo）
 *
 * @param name 路由名称
 * @returns 匹配到的规范化页面路径（如 /src/sub/modalBasicDemo/modalBasicDemo），未匹配到返回 null
 */
export function findPathByName(name: string): string | null {
  if (name == '') {
    return null;
  }
  // 1. 检查缓存
  const cached = nameToPathCache.get(name);
  if (cached != null) {
    return cached;
  }

  // 2. 查动态注册表 (routeMetaMap)
  let foundDynamic: string | null = null;
  routeMetaMap.forEach((meta: UTSJSONObject, pathKey: string): void => {
    if (foundDynamic != null) {
      return;
    }
    const metaName = readMetaString(meta, 'name');
    if (metaName == name) {
      foundDynamic = pathKey;
    }
  });
  if (foundDynamic != null) {
    nameToPathCache.set(name, foundDynamic!);
    return foundDynamic;
  }

  // 3. 查静态页面配置表 (PAGE_META_JSON)
  const table = ensurePageConfigTable();
  let foundStatic: string | null = null;
  let fallbackMatch: string | null = null;

  table.forEach((config: UTSJSONObject, pathKey: string): void => {
    if (foundStatic != null) {
      return;
    }
    const pageName = readMetaString(config, 'name');
    if (pageName == name) {
      foundStatic = pathKey;
      return;
    }
    // 兜底记录：路径最后一段匹配
    if (fallbackMatch == null && getDefaultRouteName(pathKey) == name) {
      fallbackMatch = pathKey;
    }
  });

  if (foundStatic != null) {
    nameToPathCache.set(name, foundStatic!);
    return foundStatic;
  }

  // 4. 兜底命中路径末尾单词
  if (fallbackMatch != null) {
    nameToPathCache.set(name, fallbackMatch!);
    return fallbackMatch;
  }

  return null;
}

/**
 * 从生成的 JSON 常量解析出页面配置表（懒加载，只解析一次）
 *
 * @returns 路径 → 页面配置项的 Map；表为空时返回空 Map（不返回 null）
 */
function ensurePageConfigTable(): Map<string, UTSJSONObject> {
  // ⚠️ 必须先拷进局部 const 再判空：`pageConfigTable` 是模块级可变属性，Kotlin 不对
  //    「可能被并发改写的属性」做智能转换，直接写 `return pageConfigTable` 会报
  //    `Smart cast to 'Map<String, UTSJSONObject>' is impossible`（Android 编译期）。
  const cached = pageConfigTable;
  if (cached != null) {
    return cached;
  }
  const table = new Map<string, UTSJSONObject>();
  pageConfigTable = table;
  if (pageMetaJsonString == '') {
    return table;
  }
  const parsed = JSON.parseObject(pageMetaJsonString);
  if (parsed == null) {
    return table;
  }
  // ⚠️ 遍历用「UTSJSONObject.keys() + 下标访问」而非实例方法：H5 / 蒸汽模式跑的是 JS 运行时，
  //    这里的值可能是纯 JS 对象（无 getJSON/getAny 等实例方法），下标访问两端都成立。
  const keys = UTSJSONObject.keys(parsed);
  for (let i = 0; i < keys.length; i++) {
    const oneKey = keys[i];
    const oneValue = parsed[oneKey];
    if (oneValue == null) {
      continue;
    }
    table.set(oneKey, oneValue as UTSJSONObject);
  }
  return table;
}

/**
 * 动态获取应用默认首页路径（优先从物理页面栈底获取，其次从 pages.json 路由表首项提取）
 * 避免在插件底层硬编码特定工程的首页路径
 *
 * @returns 规范化后的默认首页绝对路径（如 /src/pages/index/index 或 /pages/index/index）
 */
export function getDefaultHomePage(): string {
  // 1. 优先从物理页面栈底获取（应用已挂载时的真实首页）
  try {
    const pages = getCurrentPages();
    if (pages.length > 0) {
      const pageRoute = pages[0].route ?? '';
      if (pageRoute != '') {
        return cleanPath(pageRoute);
      }
    }
  }
  catch { }

  // 2. 其次从 pages.json 静态配置表中获取首个页面（uni-app 规范第一项为首页）
  const table = ensurePageConfigTable();
  if (table.size > 0) {
    let firstPath: string | null = null;
    table.forEach((_val: UTSJSONObject, key: string): void => {
      if (firstPath == null) {
        firstPath = key;
      }
    });
    if (firstPath != null) {
      return cleanPath(firstPath!);
    }
  }

  // 3. 兜底官方约定默认首页路径
  return '/pages/index/index';
}

/**
 * 读取某个页面在 pages.json 里的配置项（页面 definePage 声明的字段）
 *
 * @param path 页面路径
 * @returns 该页面的配置项；查不到返回 null
 */
export function getPageConfig(path: string): UTSJSONObject | null {
  const key = cleanPath(path);
  if (key == '') {
    return null;
  }
  const table = ensurePageConfigTable();
  const exact = table.get(key);
  if (exact != null) {
    return exact;
  }
  // 先落局部变量再判空：Map.get 的类型是 `T | undefined`，直接 return 会报 TS2322
  const swapped = table.get(swapSrcPrefix(key));
  if (swapped != null) {
    return swapped;
  }
  return null;
}

/**
 * 从 meta 对象里读一个字符串字段
 *
 * ⚠️ 用下标访问 + queryValueToString，而不是 `meta.getString()`：
 *    meta 可能来自 JSON.parseObject（H5 侧为普通 JS 对象），实例方法不保证存在。
 *
 * @param meta 元信息对象（setRouteMeta 注册值或 pages.json 配置项）
 * @param key 要读的字段名，如 `name`
 * @returns 字段的字符串值；字段不存在或转换后为空串时返回 null
 */
export function readMetaString(meta: UTSJSONObject, key: string): string | null {
  const value = meta[key];
  if (value == null) {
    return null;
  }
  const text = queryValueToString(value);
  return text == '' ? null : text;
}

/**
 * 按路径读取路由元信息
 *
 * 两级数据源，就近优先：
 * 1. `setRouteMeta()` 手写注册（可覆盖 / 补充 pages.json 里的配置）；
 * 2. pages.json 里该页面的配置项（构建期生成，见 ./route-state.uts 顶部说明）。
 *
 * @param path 页面路径
 * @returns 元信息对象；两级都没命中返回 null
 */
export function getRouteMeta(path: string): UTSJSONObject | null {
  const key = cleanPath(path);
  if (key == '') {
    return null;
  }
  const registered = routeMetaMap.get(key);
  if (registered != null) {
    return registered;
  }
  const registeredSwapped = routeMetaMap.get(swapSrcPrefix(key));
  if (registeredSwapped != null) {
    return registeredSwapped;
  }
  return getPageConfig(key);
}

// ==========================================
// 统一路由参数持久化管理（Query Store）
// ==========================================

/** 全局统一页面路由参数持久化映射表：Canonical Path -> Query Map */
const routeQueryStore: Map<string, Map<string, string>> = new Map<string, Map<string, string>>();

/**
 * 统一存入目标页面的 query（导航发起方、拦截器调用）
 *
 * @param path 页面路径（自动通过 canonicalPath 规范化为统一 Key）
 * @param query 查询参数 Map
 */
export function saveRouteQuery(path: string, query: Map<string, string>): void {
  const key = canonicalPath(path);
  if (key == '') {
    return;
  }
  const copy = new Map<string, string>();
  query.forEach((v: string, k: string): void => {
    copy.set(k, v);
  });
  routeQueryStore.set(key, copy);
}

/**
 * 统一读取目标页面的暂存 query
 *
 * @param path 页面路径
 * @returns 暂存的 query Map，查不到返回 null
 */
export function getSavedRouteQuery(path: string): Map<string, string> | null {
  const key = canonicalPath(path);
  if (key == '') {
    return null;
  }
  const cached = routeQueryStore.get(key);
  return cached != null ? cached : null;
}

/**
 * 统一清除目标页面的 query 暂存
 *
 * @param path 页面路径
 */
export function clearRouteQuery(path: string): void {
  const key = canonicalPath(path);
  if (key != '') {
    routeQueryStore.delete(key);
  }
}

// ==========================================
// 状态写入（唯一收敛点）
// ==========================================

/**
 * 把 query Map 拼回 query 串（值做 URL 编码）
 *
 * @param path 规范化路径（带前导 `/`）
 * @param query 查询参数 Map
 * @returns `path?k=v&k2=v2`；query 为空时原样返回 path
 */
function buildFullPath(path: string, query: Map<string, string>): string {
  if (query.size == 0) {
    return path;
  }
  const parts: Array<string> = [];
  query.forEach((value: string, key: string): void => {
    parts.push(`${key}=${encodeURIComponent(value)}`);
  });
  return `${path}?${parts.join('&')}`;
}

/**
 * 唯一的状态写入点：路径 + query + meta 一次性落盘
 *
 * 路径为空时整体忽略（避免页面栈尚未建立时把状态清空）。
 *
 * @param path 目标路径（可省略前导 `/` 与 `src/` 前缀，内部走 cleanPath 归一）
 * @param query 查询参数 Map（值已是解码态）
 * @param fullPath 完整路径（含 query 串），由调用方拼好传入
 * @param includeClaimed 本次提交是不是「落地」真值（见 route-snapshot.uts 的 publishRoute）：
 *                       `false` = 导航请求发出时的预写，不打扰任何已认领的快照
 */
function commitRoute(path: string, query: Map<string, string>, fullPath: string, includeClaimed: boolean): void {
  const normalizedPath = cleanPath(path);
  if (normalizedPath == '') {
    return;
  }
  let finalQuery = query;
  let finalFullPath = fullPath;
  if (finalQuery.size > 0) {
    saveRouteQuery(normalizedPath, finalQuery);
  } else {
    const saved = getSavedRouteQuery(normalizedPath);
    if (saved != null && saved.size > 0) {
      finalQuery = saved;
      finalFullPath = buildFullPath(normalizedPath, saved);
    }
  }
  // 在全局 routeState 被改写前，若原路径非空且与新路径不同，暂存为上一个路由快照
  if (routeState.path != '' && !isSamePath(routeState.path, normalizedPath)) {
    previousRouteState.path = routeState.path;
    previousRouteState.fullPath = routeState.fullPath;
    const prevQuery = new Map<string, string>();
    routeState.query.forEach((v: string, k: string) => {
      prevQuery.set(k, v);
    });
    previousRouteState.query = prevQuery;
  }
  else if (routeState.path == '' && previousRouteState.path == '') {
    const cur = getCurrentPath();
    if (cur != '' && !isSamePath(cur, normalizedPath)) {
      previousRouteState.path = cur;
      previousRouteState.fullPath = cur;
    }
  }
  const meta = getRouteMeta(normalizedPath);
  routeState.path = normalizedPath;
  routeState.fullPath = finalFullPath;
  routeState.query = finalQuery;
  routeState.meta = meta;
  let routeName: string | null = null;
  if (meta != null) {
    routeName = readMetaString(meta, 'name');
  }
  if (routeName == null || routeName == '') {
    routeName = getDefaultRouteName(normalizedPath);
  }
  routeState.name = routeName;
  let currentStack: UniPage[] = [];
  try {
    currentStack = getCurrentPages();
  }
  catch {
    currentStack = [] as UniPage[];
  }
  if (currentStack.length > 0 || routeState.pages.length == 0) {
    routeState.pages = currentStack;
    routeState.page = currentStack.length > 0 ? currentStack[currentStack.length - 1] : null;
  }
  publishRoute(routeState, normalizedPath, includeClaimed);
}

/**
 * 用 url 字符串解析出路由并落盘
 *
 * @param url 目标 url
 * @param includeClaimed 是否按「落地」真值处理（见 commitRoute / route-snapshot.uts 的 publishRoute）
 */
function commitRouteFromUrl(url: string, includeClaimed: boolean): void {
  if (url == '') {
    return;
  }
  const urlObj = parseUrlToObj(url);
  const normalizedPath = cleanPath(urlObj.path);
  if (normalizedPath == '') {
    return;
  }
  const queryStr = getQueryString(url);
  if (queryStr == '') {
    commitRoute(normalizedPath, urlObj.query, normalizedPath, includeClaimed);
    return;
  }
  commitRoute(normalizedPath, urlObj.query, `${normalizedPath}?${queryStr}`, includeClaimed);
}

/**
 * 用 url 字符串同步路由状态（**落地真值**：业务侧手动刷新、以及任何「这就是当前路由了」的场合）
 *
 * 会一并刷新「已认领且本页在前台」的快照，因此**不要**拿它写「即将跳转的目标」——
 * 那种预写请用 applyTargetRouteFromUrl()，否则上一页会被提前改写。
 *
 * @param url 目标 url，如 `/src/pages/detail/detail?id=1`、`src/pages/index/index?tab=2`
 */
export function applyRouteFromUrl(url: string): void {
  commitRouteFromUrl(url, true);
}

/**
 * 导航**请求**发出时的预写：写进全局路由，但不打扰任何已认领的快照（拦截器专用）
 *
 * 存在的全部理由：全局那份必须在**请求发出时**就变成目标路由，新页面的 setup 才能第一帧就读对
 * （onAppRoute 在目标页 onShow 之后才触发，靠它兜就晚了）；但同一时刻上一页还挂在栈上、还在屏幕上，
 * 所以这次预写**只喂还没认领路径的快照**，已认领的一律不动 —— 上一页因此不会在
 * 「下一页还在进入」的时候就把自己的 route 翻掉（同页带参重进尤其明显）。
 *
 * @param url 即将跳转到的目标 url
 */
export function applyTargetRouteFromUrl(url: string): void {
  commitRouteFromUrl(url, false);
}

/**
 * 把 `{ key: value }` 形态的对象（onAppRoute 事件载荷 / UniPage.options）转成 query Map
 *
 * ⚠️ 这里必须用「UTSJSONObject.keys() + 下标访问」，**不要**用实例方法 getAny()/getJSON()：
 *    H5 / 蒸汽模式的运行时下发的是纯 JS 对象（uni-h5 内部 `Object.assign({}, event.query)`），
 *    没有 UTSJSONObject 的实例方法，getAny() 会抛 `rawQuery.getAny is not a function`；
 *    该异常又被运行时的 try/catch 吞掉（只在 console.error 出现），
 *    表现为「路由状态整体不更新、query 恒为空」（2026-10-13 实测，见分册 1 的 getJSON/getAny 说明）。
 *    UTSJSONObject.keys 在 H5 侧就是 Object.keys，下标访问两端都成立。
 *
 * ⚠️ 各端交来的**值编码态不一致**，必须过 decodeQueryValue 归一（只对字符串解）：
 *    微信小程序的页面 `options` 是 URL 编码态（微信官方口径「路由参数以 URL 编码传递，
 *    需自行 decodeURIComponent」，MP 运行时 `this.options = onLoad(query)` 原样转存），
 *    而 `onAppRoute` 事件 / App 页面 options 多为解码态 —— 不归一就会出现
 *    「小程序上中文 name 参数显示成 `%E5%AF%B9%E8%B1%A1...`」。
 *    非字符串值（number / boolean / JSON 串）走 stringify 后不再解码。
 *
 * @param raw 参数对象；为 null 时返回空 Map
 * @returns 解码归一后的 query Map（非字符串值走 stringify，不再解码）
 */
function queryMapFromObject(raw: UTSJSONObject | null): Map<string, string> {
  const query = new Map<string, string>();
  if (raw == null) {
    return query;
  }
  const keys = UTSJSONObject.keys(raw);
  for (let i = 0; i < keys.length; i++) {
    const key = keys[i];
    const value = raw[key];
    if (value == null) {
      continue;
    }
    const text = queryValueToString(value);
    query.set(key, typeof value == 'string' ? decodeQueryValue(text) : text);
  }
  return query;
}

/** 页面栈回读同步前的拦截守卫钩子（返回 false 表示拦截并不再继续提交路由状态） */
export type BeforeSyncRouteHook = (currentPath: string) => boolean;

let beforeSyncRouteHook: BeforeSyncRouteHook | null = null;

/**
 * 注册 syncRouteState 执行前置钩子（供 interceptor.uts 挂接页面返回守卫校验）
 */
export function setBeforeSyncRouteHook(hook: BeforeSyncRouteHook | null): void {
  beforeSyncRouteHook = hook;
}

/**
 * 从页面栈回读当前路由（冷启动 / 返回上一页 / 导航失败回滚 / 页面重新显示时的兜底）
 *
 * 路径与参数都来自**同一个**栈顶页面：`route` 给路径、`options` 给参数（UniPage 的官方属性，
 * 见 utils 的 getCurrentPageOptions），因此不再有「回读必然丢失 query」的先天缺陷。
 *
 * ⚠️ **调用时机必须落在页面栈已稳定的时刻**：App 端页面刚入栈时栈顶仍是上一页
 *    （详见本文件头部说明），此刻回读会把状态改回上一页。所以本函数**不**在页面 setup /
 *    导航 success 时调用，新增页面的初始状态由导航发起方直接写入（`applyRouteFromUrl`）。
 *
 * ⚠️ 「同一页面且这次没读到参数」时跳过：否则会用空 query 抹掉导航发起方写入的参数。
 */
export function syncRouteState(): void {
  const currentPath = getCurrentPath();
  if (currentPath == '') {
    return;
  }
  if (beforeSyncRouteHook != null) {
    const allowed = beforeSyncRouteHook!(currentPath);
    if (!allowed) {
      return;
    }
  }
  const query = queryMapFromObject(getCurrentPageOptions());
  const stackLen = getPageStackLength();
  const isBack = routeState.pages.length > 0 && stackLen > 0 && stackLen < routeState.pages.length;
  // 仅在非出栈返回、且同路径、且本次参数为空时跳过（避免新页初载 options 延迟冲掉发起方写入的 query）
  if (!isBack && isSamePath(currentPath, routeState.path) && query.size == 0) {
    return;
  }
  commitRoute(currentPath, query, buildFullPath(currentPath, query), true);
}

// ==========================================
// 全局路由完成监听（主数据源）
// ==========================================

/**
 * 处理 onAppRoute 事件：把官方事件载荷落进 routeState
 *
 * 注意 `event.path` 官方口径为「不含开头的斜杠」，由 cleanPath 统一补上。
 *
 * @param event onAppRoute 事件载荷（path / query / openType 等）
 */
function handleAppRoute(event: AppRouteEvent): void {
  const rawPath = event.path;
  if (rawPath == '') {
    return;
  }
  const normalizedPath = cleanPath(rawPath);
  const query = queryMapFromObject(event.query);
  commitRoute(normalizedPath, query, buildFullPath(normalizedPath, query), true);
}

/** 监听是否已安装（幂等标记，避免重复注册导致回调叠加） */
let routeListenerInstalled: boolean = false;

/**
 * 安装全局「路由完成」监听（幂等，由 useRoute / useRouter 自动调用）
 */
export function installRouteStateListener(): void {
  if (routeListenerInstalled) {
    return;
  }
  routeListenerInstalled = true;
  uni.onAppRoute((event: AppRouteEvent): void => {
    handleAppRoute(event);
  });
}

/**
 * 卸载全局「路由完成」监听（一般无需调用，主要供单测复位）
 *
 * ⚠️ 这里按官方签名不传回调，会移除**所有** onAppRoute 监听；
 *    若业务另有 onAppRoute 监听，请勿调用本方法。
 */
export function uninstallRouteStateListener(): void {
  if (!routeListenerInstalled) {
    return;
  }
  routeListenerInstalled = false;
  uni.offAppRoute();
}

/**
 * 确保路由状态已就绪：安装监听 + （仅状态为空时）从页面栈回读
 * （useRoute / useRouter 内部调用，业务侧一般不需要直接调用）
 *
 * ⚠️ 回读**只在状态还是空的时候**做。理由见本文件头部「App 端页面栈有滞后」：
 *    页面 setup 时栈顶可能还停在上一页，无条件回读会把刚由导航发起方写好的目标路由
 *    覆盖回上一页（这正是「安卓上进入新页面却显示上一页路由信息」的直接成因）。
 *    状态非空说明已经有人写过当前路由，就不要再读了。
 */
export function ensureRouteReady(): void {
  installRouteStateListener();
  let currentStack: UniPage[] = [];
  try {
    currentStack = getCurrentPages();
  }
  catch {
    currentStack = [] as UniPage[];
  }
  if (currentStack.length > 0) {
    routeState.pages = currentStack;
    routeState.page = currentStack[currentStack.length - 1];
  }
  if (routeState.path != '') {
    return;
  }
  // 冷启动 / 直链进入：还没有任何导航写入过状态，此时栈顶就是当前页，回读是安全的
  syncRouteState();
  // App 端首个页面入栈可能晚于本函数执行，延后一拍再补一次（仍以「状态为空」为前提）
  setTimeout((): void => {
    if (routeState.path == '') {
      syncRouteState();
    }
  }, 0);
}

// 注册全局路由名称 → 页面路径解析器（供 utils.resolveUrl 使用）
setNameToPathResolver((name: string): string | null => {
  return findPathByName(name);
});
