/**
 * 守卫契约：类型与裁决构造器 —— 零依赖叶子文件
 *
 * 为什么单独一个文件：规则文件（./guardLogin.uts 之类）与入口（./index.uts）都要用这几个类型
 * 和 `allow()` / `block()` / `next()`。若把它们放进 index.uts，规则文件就得反过来 import index.uts ——
 * 入口与规则互相 import 会成环（Kotlin 端类静态初始化死锁）。放这里，两边都只单向依赖它。
 *
 * ⚠️ 本文件保持**零依赖**（不 import 任何模块），也别往里写业务规则。
 */

/**
 * 一次导航的目标路由（对标 vue-router 的 RouteLocationNormalized）
 */
export type RouteTarget = {
  /** 规范化后的绝对路径（带前导 `/`，不含 query），如 `/src/pages/me/me` */
  path: string;
  /** query 参数（值已 URL 解码），取值写法：`ctx.to.query.get('id')` */
  query: Map<string, string>;
  /**
   * `path` + query 串，如 `/src/pages/me/me?id=1`；
   * 与 path / query **同口径（值已是解码态）** —— 拼登录页 redirect 时必须
   * `encodeURIComponent()` 整体编码一次（见 ./guardLogin.uts 里拼 loginUrl 那行）
   */
  fullPath: string;
  /** 路由元信息（来自 definePage / pages.config.json），对标 vue-router 的 to.meta */
  meta: UTSJSONObject | null;
  /** 路由名称，对标 vue-router 的 to.name */
  name: string | null;
  /** 路由参数，与 query 同值（命名路由的 params 最终也会落到 query） */
  params: Map<string, string>;
};

/** 构造空的 RouteTarget（用于首屏 / 无来源页面时的 from 兜底） */
export function createEmptyRouteTarget(): RouteTarget {
  return {
    path: '',
    query: new Map<string, string>(),
    fullPath: '',
    meta: null,
    name: null,
    params: new Map<string, string>()
  } as RouteTarget;
}

import { resolveUrl } from '../utils/utils.uts';
import type { RouteLocationRaw } from '../utils/utils.uts';

/**
 * 守卫裁决结果
 */
export type GuardResult = {
  /** 是否放行本次跳转 */
  pass: boolean;
  /** 不放行时的改跳目标 url（可带 query）；`null` = 静默拦截（不跳任何页面） */
  redirect: string | null;
  /** 是否以 replace 方式重定向（true 则走 uni.redirectTo，默认为 false 走 uni.navigateTo） */
  replace?: boolean;
};

/**
 * 对齐 vue-router 的 next() 构造裁决
 * - `next()` / `next(true)`：放行本次导航（等价于 `allow()`）
 * - `next(false)`：拦截并取消本次导航（等价于 `block(null)`）
 * - `next('/login')`：重定向改跳至目标地址（等价于 `block('/login')`）
 * - `next({ path: '/login', query: { ... }, replace: true })`：支持对象形态与 replace 重定向
 */
export function next(location: any | null = null): GuardResult {
  if (location == null) {
    return { pass: true, redirect: null } as GuardResult;
  }
  if (typeof location == 'boolean') {
    if (location == true) {
      return { pass: true, redirect: null } as GuardResult;
    }
    return { pass: false, redirect: null } as GuardResult;
  }
  if (typeof location == 'string') {
    return { pass: false, redirect: location as string } as GuardResult;
  }
  // 支持对象形态：{ path, name, query, params, replace }
  let isReplace = false;
  if (typeof location == 'object') {
    const obj = location as UTSJSONObject;
    // eslint-disable-next-line dot-notation
    if (obj['replace'] == true) {
      isReplace = true;
    }
  }
  const resolved = resolveUrl(location as RouteLocationRaw);
  const redirectTarget = resolved != '' ? resolved : null;
  if (isReplace) {
    return {
      pass: false,
      redirect: redirectTarget,
      replace: true
    } as GuardResult;
  }
  return {
    pass: false,
    redirect: redirectTarget
  } as GuardResult;
}

/** 构造放行裁决（对齐 vue-router 的 next()） */
export function allow(): GuardResult {
  return next();
}

/** 构造拦截裁决；`redirect` 传 null 表示静默拦截，传 url 表示改跳（对齐 vue-router 的 next(redirect)） */
export function block(redirect: string | null = null): GuardResult {
  if (redirect == null) {
    return next(false);
  }
  return next(redirect);
}

/**
 * 守卫上下文：通用路由事实与裁决构造器（业务无关的纯粹上下文）
 */
export type RouteGuardContext = {
  /** 本次跳转的目标 */
  to: RouteTarget;
  /** 上一个页面（来源页面）路由；若为冷启动首跳或无前序页面，各字段为空（path 为 ''） */
  from: RouteTarget;
  /** 触发本次跳转的 uni API 名：`navigateTo` / `redirectTo` / `reLaunch` / `switchTab` / `appLaunch` */
  api: string;
  /** 对齐 vue-router 的裁决构造函数，可直接从 ctx 解构使用：const { to, next } = ctx */
  next: (location?: any | null) => GuardResult;
};

/** 守卫函数签名：接收 RouteGuardContext，返回 GuardResult */
export type RouteGuardHandler = (ctx: RouteGuardContext) => GuardResult;

/**
 * 标准路由导航 next 回调函数签名
 * - `next()` / `next(true)`：放行本次导航
 * - `next(false)`：拦截并取消本次导航
 * - `next('/login')`：重定向改跳至目标地址
 */
export type NextFunction = (location?: any | null) => void;

/**
 * 标准全局前置守卫函数签名（对齐 vue-router 的 beforeEach）
 * @param to 目标路由
 * @param from 来源路由
 * @param next 裁决回调（或直接同步 return boolean / string 重定向）
 */
export type NavigationGuard = (to: RouteTarget, from: RouteTarget, next: NextFunction, api?: string) => any | null;

/**
 * 标准全局后置路由钩子签名（对齐 vue-router 的 afterEach）
 * @param to 目标路由
 * @param from 来源路由
 * @param failure 导航异常或取消信息（成功放行完成时为 null）
 */
export type NavigationHookAfter = (to: RouteTarget, from: RouteTarget, failure?: any | null) => void;

/**
 * 标准全局路由错误回调签名（对齐 vue-router 的 onError）
 * @param error 捕获到的异常或错误对象
 * @param to 目标路由（可能为空）
 * @param from 来源路由（可能为空）
 */
export type NavigationErrorHandler = (error: any, to?: RouteTarget | null, from?: RouteTarget | null) => void;

