export type TextProps = {
  text ?: string | number,
  type ?: 'primary' | 'success' | 'warning' | 'error' | 'default' | 'info',
  lines ?: number,
  decoration ?: 'underline' | 'line-through' | 'none'
  url ?: string,
  textClass ?: string,
  prefixIcon ?: string,
  suffixIcon ?: string,
  prefixIconStyle ?: UTSJSONObject,
  suffixIconStyle ?: UTSJSONObject,
}