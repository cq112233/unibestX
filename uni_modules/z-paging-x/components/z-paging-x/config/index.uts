// [z-paging-x]全局配置

let config: null | UTSJSONObject = null;

// 读取配置项：全局配置不存在，或对应配置项不存在时返回默认值，反之返回配置项
function _getConfig<T>(key: string, defaultValue: T): T {
  if (config == null) return defaultValue;
  const value: null | any = config![key];
  return (value == null ? defaultValue : value) as T;
}

// #ifdef VUE3-VAPOR
// 蒸汽模式下整个应用被打包为单个 js bundle，组件 props 的 default 表达式在模块加载时即被求值，
// 此时 main.uts 中的 setZPXConfig 尚未执行，直接返回值会把内置默认值固化。
// 因此这里返回工厂函数，交由 vue 在每次创建组件实例、解析 props 时再调用，保证能读到全局配置。
export function gc<T>(key: string, defaultValue: T): () => T {
  return (): T => _getConfig<T>(key, defaultValue)
}
// #endif
// #ifndef VUE3-VAPOR
// 非蒸汽模式下 props 定义在组件首次实例化时才求值（晚于 setZPXConfig），直接返回配置值即可
export function gc<T>(key: string, defaultValue: T): T {
  return _getConfig<T>(key, defaultValue)
}
// #endif

// 设置默认全局配置
export function setZPXConfig(_config: UTSJSONObject) {
  config = _config;
}
