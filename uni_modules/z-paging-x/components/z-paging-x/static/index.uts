// [z-paging-x]公用的静态图片资源

const _base64Chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';

// 将ASCII字符串编码为base64(svg内容均为ASCII)。不依赖btoa，鸿蒙平台不支持btoa
function _asciiToBase64(str: string): string {
  let result = '';
  let i = 0;
  while (i < str.length) {
    // charCodeAt在UTS中返回number | null
    const c1: number = str.charCodeAt(i) ?? 0;
    const c2: number = i + 1 < str.length ? (str.charCodeAt(i + 1) ?? 0) : 0;
    const c3: number = i + 2 < str.length ? (str.charCodeAt(i + 2) ?? 0) : 0;
    const n: number = c1 * 65536 + c2 * 256 + c3;
    result += _base64Chars.charAt(Math.floor(n / 262144) % 64);
    result += _base64Chars.charAt(Math.floor(n / 4096) % 64);
    result += i + 1 < str.length ? _base64Chars.charAt(Math.floor(n / 64) % 64) : '=';
    result += i + 2 < str.length ? _base64Chars.charAt(n % 64) : '=';
    i += 3;
  }
  return result;
}

function _svgToDataUrl(svg: string): string {
  return 'data:image/svg+xml;base64,' + _asciiToBase64(svg);
}

// 下拉刷新箭头(向上)
export function getArrowSvg(color: string): string {
  return _svgToDataUrl(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><path d="M50 88V14M22 42L50 14L78 42" fill="none" stroke="${color}" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"/></svg>`);
}

// 下拉刷新成功
export function getSuccessSvg(color: string): string {
  return _svgToDataUrl(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="50" cy="50" r="42" fill="none" stroke="${color}" stroke-width="8"/><path d="M30 52L45 66L72 38" fill="none" stroke="${color}" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/></svg>`);
}

// loading(12根线条，线宽、长度及各线条透明度均按原flower图片还原：从12点钟方向起顺时针由浅到深)
const _loadingOpacities: number[] = [0.56, 0.56, 0.65, 0.65, 0.75, 0.75, 0.86, 0.93, 0.93, 1, 0.47, 0.47];
export function getLoadingSvg(color: string): string {
  let lines = '';
  for (let i = 0; i < 12; i++) {
    lines += `<line x1="50" y1="4" x2="50" y2="20" opacity="${_loadingOpacities[i]}" transform="rotate(${i * 30} 50 50)"/>`;
  }
  return _svgToDataUrl(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><g stroke="${color}" stroke-width="8" stroke-linecap="round">${lines}</g></svg>`);
}

export const base64Empty: string = 'data:image/png;base64,';
export const base64Error: string = 'data:image/png;base64,';
export const base64BackToTop: string = 'data:image/png;base64,';