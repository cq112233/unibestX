  lvert: '|',
  rvert: '|',
  Vert: '‖',
  lVert: '‖',
  rVert: '‖',
  backslash: '\\',
  sum: 'Σ',
  prod: '∏',
  coprod: '∐',
  int: '∫',
  iint: '∬',
  oint: '∮',
  bigcup: '⋃',
  bigcap: '⋂',
  therefore: '∴',
  because: '∵',
  dagger: '†',
