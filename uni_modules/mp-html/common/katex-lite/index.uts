/**
 * katex-lite —— 面向 uni-app X 的极简 LaTeX 公式排版引擎（纯 UTS 实现，全端通用）
 *
 * 为什么不用 npm 上的 KaTeX？
 * uni-app X 的 App 端（Android 编译 Kotlin / iOS 编译 Swift）**没有 JS 引擎**，
 * KaTeX 是纯 JS 库，在 App 端既无法引入也无法运行；mp-html 官方的 latex 插件同样是
 * 「H5 塞 KaTeX.js + App 走 WebView」的路线，与本项目的原生渲染链路不兼容。
 * 于是这里用 UTS 重写了一个「演示够用」的公式排版引擎。
 *
 * 三段式流水线：
 * 1) 解析：LaTeX 子集 → 中间节点树（行 / 原子 / 分式 / 根式 / 上下标 / 大运算符 / 矩阵 / 重音）；
 * 2) 排版：按 TeX 的盒子模型算尺寸 —— 每个盒子携带 width（宽）、height（基线以上）、
 *    depth（基线以下），子盒子的坐标一律相对「本盒左边缘 + 本盒基线」；
 * 3) 摊平：把盒子树展平成一组**绝对定位图元**（文本盒 + 线段），使用方按 style 串贴进容器即可
 *    （参考 `src/sub/rxjsDemo/rxjsDemo.uvue` 的三处用法：流式公式 / 静态示例 / 行内公式）。
 *
 * 为什么输出「绝对定位图元」而不是 HTML？
 * 本项目的 Markdown 走 mp-html，它只支持有限标签（text / image / table / pre …）：
 * 分式、根号、上下标这类二维排版用它的标签体系表达不出来（原生端 <text> 里也不能嵌 view）。
 * 原生端唯一能自由摆放二维结构的手段就是 position: absolute ——
 * 公式的每一笔（分子、分母、分数线、根号横线、指数）各自是一个绝对定位的小盒子。
 *
 * 支持范围（够演示用，不追求 TeX 完备）：
 * - 上下标 ^ _（含 `x'` 撇号）、\frac \dfrac \tfrac、\sqrt[n]{}
 * - \sum \prod \int 等大运算符（∑∏ 上下限堆叠，∫ 侧挂）、\lim \sin \cos \log …
 * - \begin{pmatrix|bmatrix|Bmatrix|vmatrix|cases} … \end{…} 矩阵与分段函数
 * - 希腊字母、关系符、箭头、运算符号、\text \mathrm \mathbb、\hat \vec \bar \overline
 * - 常用间距 \\, \; \quad \qquad；未知命令退化成「原样显示命令名」，不抛错
 *
 * 流式友好：LaTeX 分块到达时（`\frac{1}{`、尾随 `\`、未闭合 `\begin{pmatrix}`）不会抛异常，
 * 半截公式按「能排多少排多少」渲染，下一块到达后整棵重排。
 *
 * @example
 * ```uts
 * import { renderKatex } from '@/uni_modules/mp-html/index.uts';
 * import type { KatexLayout, KatexBox } from '@/uni_modules/mp-html/index.uts';
 *
 * const layout: KatexLayout = renderKatex('x = \\frac{-b \\pm \\sqrt{b^2-4ac}}{2a}', 18);
 * // layout.boxes 是绝对定位图元，layout.height 是公式总高（px）
 * ```
 */

// ==========================================
// 一、对外类型（禁止 interface，统一用 type）
// ==========================================

/**
 * 一个已排版好的图元。
 *
 * 坐标已经换算到「公式容器」坐标系（原点在容器左上角，y 向下为正）：
 * 组件只需 `position:absolute; left:x; top:top` 贴上去即可，不需要再懂任何字体度量。
 */
export type KatexBox = {
  /** 'text' 文本图元 / 'rule' 线段（分数线、根号横线、上划线） */
  kind: string;
  /** 文本内容（kind == 'rule' 时为空串） */
  text: string;
  /** 左边缘，px */
  x: number;
  /** 上边缘，px */
  top: number;
  /** 宽度，px（文本盒是估算宽度，线段盒是精确宽度） */
  width: number;
  /** 字号，px（kind == 'rule' 时为 0） */
  fontSize: number;
  /** 线段粗细，px（kind == 'text' 时为 0） */
  lineHeight: number;
  /** 是否斜体（数学变量斜体、数字与函数名正体） */
  italic: boolean;
};

/** 排版结果 */
export type KatexLayout = {
  /** 公式宽度，px */
  width: number;
  /** 公式总高度（基线以上 + 以下），px */
  height: number;
  /** 图元列表，已按「先文本后线段」无关的顺序排列（渲染顺序不影响结果） */
  boxes: Array<KatexBox>;
  /** 出错信息，空串表示正常 */
  error: string;
};

/**
 * 文本盒的 `line-height` 相对字号的倍数 —— **组件渲染文本盒时必须用同一个数**。
 *
 * 取 1.15 而不是 1：盒高贴到字号上时，`(`、`∫` 这类降部比基线余量更深的字形会被原生
 * 文本盒裁掉，上下各留 0.075em 余量更稳。`renderKatex` 算容器高度时也按这个倍数推盒底，
 * 两边不同步就会出现「公式最后一行探出容器被裁掉」——二次方程求根公式的 `2a` 就是这么丢的。
 */
export const KATEX_LINE_HEIGHT_RATIO: number = 1.15;

/**
 * 文本盒「上边缘 → 基线」的距离系数：`基线偏移 = KATEX_BASELINE_RATIO × 字号`。
 *
 * 文本盒内的基线位置是「半行距 + 字体升部」，只与字号成正比，所以可以用一个常数描述。
 * 0.84 是 Roboto 在实际行高下的实测值（升部 0.927 / 降部 0.244 的理论值是 0.92 上下），
 * 换字体族、或改 KATEX_LINE_HEIGHT_RATIO，这个数都要重新标定。
 */
export const KATEX_BASELINE_RATIO: number = 0.84;

/** 上下标相对基准字号的缩放 */
const SCRIPT_SCALE: number = 0.72;
/** 分式分子/分母相对基准字号的缩放（嵌套时自然逐层变小） */
const FRAC_SCALE: number = 0.95;

// ==========================================
// 二、中间节点树
// ==========================================

/**
 * 中间节点（内部类型，不导出）。
 *
 * 用「一个大 type + 全字段给默认值」而不是联合类型：UTS 里可选字段参与运算时
 * 处处要判空，字段齐全反而更省心（这也是本项目禁止 interface 的同一套思路）。
 */
type MNode = {
  /** row / sym / rule / space / frac / sqrt / script / bigop / matrix / accent / overline */
  kind: string;
  /** sym 的字符、accent 的重音符、bigop 的标记 */
  text: string;
  /** 原子类别：ord / bin / rel / open / close / punct / op / func，用于行内自动间距；matrix 借它存对齐方向 */
  cls: string;
  /** 字号倍率（相对父级字号）。注意：kind == 'rule' 时语义是「线段粗细（em）」 */
  scale: number;
  /** 数学变量斜体、数字与函数名正体 */
  italic: boolean;
  /** 子节点（row 的成员 / frac 的分子分母与分数线 / matrix 的单元格与定界符） */
  children: Array<MNode>;
  /** 上标；sqrt 借它存根指数 */
  sup: MNode | null;
  /** 下标 */
  sub: MNode | null;
  /** rule 的宽度（em）、space 的留白宽度（em） */
  w: number;
  /** frac: 'nobar' 表示不带分数线（预留）；bigop: 'stack' 上下限堆叠 / 'side' 侧挂 */
  mode: string;
  /** matrix 的行数、列数 */
  rows: number;
  cols: number;
  /** matrix 的左右定界符（'{' 用于 cases，'' 表示不画） */
  delimL: string;
  delimR: string;

  // ---- 以下为布局产物（px，相对本盒左边缘 / 本盒基线） ----
  width: number;
  height: number;
  depth: number;
  x: number;
  y: number;
};

/** 盒子度量（em） */
type Metrics = {
  height: number;
  depth: number;
};

function mnode(kind: string): MNode {
  return {
    kind,
    text: '',
    cls: 'ord',
    scale: 1,
    italic: false,
    children: [] as Array<MNode>,
    sup: null,
    sub: null,
    w: 0,
    mode: '',
    rows: 0,
    cols: 0,
    delimL: '',
    delimR: '',
    width: 0,
    height: 0,
    depth: 0,
    x: 0,
    y: 0
  } as MNode;
}

/** 安全取子节点：下标越界时返回一个空行节点，避免原生端 IndexOutOfBoundsException */
function childAt(n: MNode, i: number): MNode {
  if (i >= 0 && i < n.children.length) {
    return n.children[i];
  }
  return mnode('row');
}

/** 单字符原子 */
function symbolNode(ch: string): MNode {
  const n = mnode('sym');
  n.text = ch;
  n.cls = classOf(ch);
  n.italic = isVariableChar(ch);
  return n;
}

/** 多字符正体文本（\text{...}、函数名、未知命令名） */
function textNode(s: string): MNode {
  const n = mnode('sym');
  n.text = s;
  n.cls = 'ord';
  n.italic = false;
  return n;
}

/** 留白 */
function spaceNode(wEm: number): MNode {
  const n = mnode('space');
  n.w = wEm;
  return n;
}

/** 线段（分数线 / 根号横线 / 上划线）：w 为宽度（em），t 为粗细（em） */
function ruleNode(wEm: number, tEm: number): MNode {
  const n = mnode('rule');
  n.w = wEm;
  n.scale = tEm;
  return n;
}

/** 大运算符（∑ ∏ ∫ 与 \lim 这类上下限可堆叠的算子） */
function bigopNode(op: MNode, stacked: boolean): MNode {
  const n = mnode('bigop');
  n.children = [op];
  n.mode = stacked ? 'stack' : 'side';
  n.cls = 'op';
  n.scale = op.kind == 'sym' && op.text.length == 1 ? 1.35 : 1;
  return n;
}

// ==========================================
// 三、字符分类与度量表
// ==========================================

const LETTERS: string = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ';
/** 二元运算：左右各留中等间距 */
const BIN_CHARS: string = '+−±∓×÷∗⋅∘∙⊕⊗⊙∖∪∩∧∨';
/** 关系符：左右各留关系间距 */
const REL_CHARS: string = '=<>≤≥≠≈≡≃≅∼∝∈∉∋⊂⊃⊆⊇≪≫→←↔⇒⇐⇔↦∣∥⊥';
/** 左/右定界符：内侧不留间距 */
const OPEN_CHARS: string = '([{⟨⌈⌊';
const CLOSE_CHARS: string = ')]}⟩⌉⌋';
/** 标点：后面留一 ThinSpace */
const PUNCT_CHARS: string = ',;';
/** 堆叠上下限的大运算符 */
const BIGOP_CHARS: string = '∑∏∐⋃⋂Σ';
/** 侧挂上下限的大运算符 */
const BIGINT_CHARS: string = '∫∬∮';
/** 宽字形 */
const WIDE_CHARS: string = '∑∏∐⋃⋂∫∬∮√Σ';
/** 窄字形 */
const NARROW_CHARS: string = 'ilj.,;:!\'`';
/** 有降部（基线以下有笔画）的字符 */
const DESCENDER_CHARS: string = 'gjpqyQ()[]{}|/';
/** 只有 x 高的字符 */
const XHEIGHT_CHARS: string = 'acemnorsuvwxz';
/** 围绕数学轴线居中的字符（= + − × ≤ …），基线在它们的中部 */
const CENTERED_CHARS: string = '=<>≤≥≈≡≠+−×÷±∓∼⋅≃≅∝∈∉⊂⊃⊆⊇';

/** 希腊字母命令 → 字符（UTSJSONObject + getString：缺失键返回 null，不做下标强转） */
const SYMBOLS: UTSJSONObject = {
  alpha: 'α',
  beta: 'β',
  gamma: 'γ',
  delta: 'δ',
  varepsilon: 'ε',
  epsilon: 'ε',
  zeta: 'ζ',
  eta: 'η',
  theta: 'θ',
  vartheta: 'ϑ',
