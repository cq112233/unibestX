export type CanvasTextAlign = string

export type TitleOption = {
  text?: string
  color?: string
  show?: boolean
  fontSize?: number
  align?: string
  left?: number
  top?: number
}

export type GridOption = {
  left?: number
  right?: number
  top?: number
  bottom?: number
  show?: boolean
  color?: string
  backgroundColor?: string
  borderColor?: string
  showHorizontal?: boolean
  showVertical?: boolean
}

export type AxisLabelOption = {
  interval?: number
  format?: string
  rotate?: number
  color?: string
  show?: boolean
  fontSize?: number
}

export type AxisLineOption = {
  show?: boolean
  color?: string
}

export type SplitLineOption = {
  show?: boolean
  color?: string
}

export type AxisOption = {
  data?: string[]
  min?: number
  max?: number
  color?: string
  axisLabel?: AxisLabelOption
  axisLine?: AxisLineOption
  splitLine?: SplitLineOption
  valueSuffix?: string
  mirror?: boolean
}

export type LegendOption = {
  show?: boolean
  textColor?: string
  toggleable?: boolean
  fontSize?: number
  iconSize?: number
  itemGap?: number
  rowGap?: number
  position?: string
  barLayout?: string
}

export type LabelOption = {
  show?: boolean
  color?: string
  fontSize?: number
  position?: string
}

export type PieLabelOption = {
  show?: boolean
  color?: string
  position?: string
  showPercent?: boolean
  showLine?: boolean
  lineColor?: string
}

export type RadarIndicatorOption = {
  name: string
  max: number
}

export type RadarOption = {
  indicator: RadarIndicatorOption[]
}

export type LineStyleOption = {
  color?: string
  width?: number
  type?: string
  opacity?: number
}

export type MarkLineOption = {
  value: number
  label?: string
  color?: string
  startIndex?: number
}

export type MarkPointOption = {
  type?: string
  dataIndex?: number
  label?: string
  color?: string
}

export type MarkAreaOption = {
  startIndex: number
  endIndex: number
  label?: string
  color?: string
}

export type LineColorRangeOption = {
  startIndex: number
  endIndex: number
  color: string
}

export type ItemStyleOption = {
  borderRadius?: number
  opacity?: number
  borderWidth?: number
  borderColor?: string
  backgroundColor?: string
  pattern?: string
  patternColor?: string
  patternSize?: number
  patternWidth?: number
}

export type ChartSeries = {
  name?: string
  type: string
  data: number[]
  scatterData?: number[][]
  boxplotData?: number[][]
  candlestickData?: number[][]
  color?: string
  colors?: string[]
  itemColors?: string[]
  startIndex?: number
  barWidth?: number | string
  orient?: string
  stack?: string
  mirror?: boolean
  realtimeSort?: boolean
  symbolSize?: number
  radius?: number | string
  innerRadius?: number | string
  startAngle?: number
  pieStyle?: string
  roseType?: string
  selectedMode?: boolean
  selectedOffset?: number
  showLabel?: boolean
  showPercent?: boolean
  labelPosition?: string
  showLabelLine?: boolean
  labelLineLength?: number
  labelLineLength2?: number
  labelLineColor?: string
  labelColor?: string
  labelFormat?: string
  labelAvoidOverlap?: boolean
  labelMinGap?: number
  labelMaxWidth?: number
  borderWidth?: number
  borderColor?: string
  smooth?: boolean
  step?: string
  showSymbol?: boolean
  symbolStyle?: string
  lineStyle?: LineStyleOption
  markLine?: MarkLineOption[]
  markPoint?: MarkPointOption[]
  markArea?: MarkAreaOption[]
  lineColorRanges?: LineColorRangeOption[]
  areaStyle?: boolean
  itemStyle?: ItemStyleOption
  label?: LabelOption
  overlay?: boolean
  gradientColors?: string[]
  progressMax?: number
  progressGap?: number
  progressRound?: boolean
  progressBackgroundColor?: string
  centerText?: string
  centerValue?: string
  centerTextColor?: string
  centerValueColor?: string
  centerValueFontSize?: number
  gaugeStyle?: string
  gaugeGradientColors?: string[]
  gaugeBackgroundColor?: string
  gaugeWidth?: number
  pointerColor?: string
  gaugeStartAngle?: number
  gaugeEndAngle?: number
  gaugeRound?: boolean
  gaugeShowPointer?: boolean
  gaugeShowTicks?: boolean
  gaugeTickCount?: number
}

export type HitRegion = {
  type: string
  seriesIndex: number
  dataIndex: number
  name: string
  value: number
  x: number
  y: number
  width: number
  height: number
  centerX: number
  centerY: number
  radius: number
  startAngle: number
  endAngle: number
  innerRadius?: number
}

export type TooltipOption = {
  show?: boolean
  merge?: boolean
  trigger?: string
  axisLineColor?: string
  axisLineLabelColor?: string
  axisLineLabelBgColor?: string
  showAxisLine?: boolean
  axisPointerLineColor?: string
  axisPointerLabelColor?: string
  axisPointerLabelBgColor?: string
  showAxisPointer?: boolean
  duration?: number
  backgroundColor?: string
  textColor?: string
  borderRadius?: number
  showMarker?: boolean
