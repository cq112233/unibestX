}

export type TooltipData = {
  dataIndex: number
  seriesIndex: number
  x: number
  y: number
  categoryLabel: string
  items: TooltipItem[]
}

export type TooltipItem = {
  seriesName: string
  value: number
  color: string
  y: number
}

export type ChartOption = {
  title?: TitleOption
  grid?: GridOption
  xAxis?: AxisOption
  yAxis?: AxisOption
  radar?: RadarOption
  legend?: LegendOption
  label?: LabelOption
  tooltip?: TooltipOption
