/**
 * codec.uts —— unix-crypto 的「字节 / 文本 / Base64」底层编解码（纯 UTS，零运行时依赖）
 *
 * ⚠️ 为什么不能用 `TextEncoder` / `TextDecoder`：
 * 这两个是浏览器 Web API，而小程序的 JS 运行时（iOS 走 JavaScriptCore、Android 走 V8 精简版）
 * **默认不把它们挂到全局**，调用即抛 `TextEncoder is not defined`。
 * 更坑的是开发者工具往往「假装支持」（工具里跑得好好的），只有真机才炸。
 * 本库的每一个哈希 / 加解密入口（base64 / md5 / sha256 / hmac / aes / des）
 * 都要先过一层 UTF-8 编解码，所以只要这一处用了 TextEncoder，
 * 整个库在小程序端就会**只剩不碰字符串的 uuid 能用** —— 这正是支付宝小程序上曾经的现象。
 *
 * ⚠️ 为什么也不用 `uni.arrayBufferToBase64` / `uni.base64ToArrayBuffer`：
 * 这两个 API 在小程序端由宿主提供（支付宝要求基础库 ≥ 2.1.15，且各宿主命名不同），
 * 属于「平台差异 + 版本差异」叠加出来的不确定项。改为手写纯 UTS 实现后，
 * 这层依赖被彻底断掉，App / 鸿蒙 / H5 / 各小程序端的结果保证逐字节一致。
 *
 * ⚠️ 关于 `charCodeAt` 的 `?? 0`：UTS 里 `String.charCodeAt()` 的返回类型是 `number | null`
 * （不是 JS 的 `number`），不兜底就直接参与算术，Kotlin 侧会报
 * `Operator call is prohibited on a nullable receiver of type 'Number?'`，
 * 而 H5 / 小程序端因为原始类型不报错 —— 属于「只有原生端才炸」的坑。
 */

/** Base64 字符表（标准表，含 `+` 与 `/`） */
const B64_ALPHABET: string = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'

/** Unicode 替换字符 U+FFFD，用于表示无法解码的非法字节序列 */
const REPLACEMENT: string = String.fromCharCode(0xFFFD)

/**
 * 把码点按 UTF-8 规则拆成字节追加到输出数组
 * @param out 输出字节数组（按顺序 push）
 * @param cp 已合成的 Unicode 码点
 */
function pushUtf8(out: Array<number>, cp: number): void {
  if (cp < 0x80) {
    out.push(cp)
  }
  else if (cp < 0x800) {
    out.push(0xC0 | (cp >> 6))
    out.push(0x80 | (cp & 0x3F))
  }
  else if (cp < 0x10000) {
    out.push(0xE0 | (cp >> 12))
    out.push(0x80 | ((cp >> 6) & 0x3F))
    out.push(0x80 | (cp & 0x3F))
  }
  else {
    out.push(0xF0 | (cp >> 18))
    out.push(0x80 | ((cp >> 12) & 0x3F))
    out.push(0x80 | ((cp >> 6) & 0x3F))
    out.push(0x80 | (cp & 0x3F))
  }
}

/**
 * 数字数组转 Uint8Array（内部工具）
 * @param values 每项取值 0~255 的数字数组
 * @returns 对应字节数组
 */
function numbersToBytes(values: Array<number>): Uint8Array {
  const bytes: Uint8Array = new Uint8Array(values.length)
  for (let i: number = 0; i < values.length; i++) {
    bytes[i] = values[i]
  }
  return bytes
}

/**
 * 查一个字符在 Base64 表中的下标
 * @param code 字符编码
 * @returns 0~63 表示有效字符；-1 表示不在表内（含 `=` 与空白字符）
 */
function b64CharValue(code: number): number {
  if (code >= 65 && code <= 90) {
    return code - 65
  }
  if (code >= 97 && code <= 122) {
    return code - 97 + 26
  }
  if (code >= 48 && code <= 57) {
    return code - 48 + 52
  }
  if (code == 43) {
    return 62
  }
  if (code == 47) {
    return 63
  }
  return -1
}

/**
 * 字符串转 UTF-8 字节数组（等价于 `new TextEncoder().encode(text)`）
 *
 * 落单的代理位（高代理位后面没跟低代理位、或单独出现低代理位）按 WHATWG 规范
 * 替换为 U+FFFD，与浏览器、Node 的行为保持一致。
 *
 * @param text 原始字符串
 * @returns UTF-8 编码的字节数组
 */
export function utf8Encode(text: string): Uint8Array {
  const out: Array<number> = []
  const n: number = text.length
  let i: number = 0
  while (i < n) {
    const first: number = text.charCodeAt(i) ?? 0
    i++
    let cp: number = first
    if (first >= 0xD800 && first <= 0xDBFF) {
      // 高代理位：尝试与紧跟其后的低代理位配对，合成增补平面码点
      const second: number = i < n ? (text.charCodeAt(i) ?? 0) : 0
      if (second >= 0xDC00 && second <= 0xDFFF) {
        cp = 0x10000 + ((first - 0xD800) << 10) + (second - 0xDC00)
        i++
      }
      else {
        cp = 0xFFFD
      }
    }
    else if (first >= 0xDC00 && first <= 0xDFFF) {
      // 落单的低代理位
      cp = 0xFFFD
    }
    pushUtf8(out, cp)
  }
  return numbersToBytes(out)
}

/**
 * UTF-8 字节数组转字符串（等价于 `new TextDecoder().decode(bytes)`）
 *
 * 非法序列（非法首字节、续接字节不合法、过长编码、代理位区间码点、超出 U+10FFFF）
 * 一律替换为 U+FFFD，与 WHATWG 解码器的容错行为一致，绝不抛异常。
 *
 * @param bytes UTF-8 编码的字节数组
 * @returns 解码后的字符串
 */
export function utf8Decode(bytes: Uint8Array): string {
  const out: Array<string> = []
  const n: number = bytes.length
  let i: number = 0
  while (i < n) {
    const b0: number = bytes[i] | 0
    let cp: number = 0
    let len: number = 1
    if (b0 < 0x80) {
      cp = b0
      len = 1
    }
    else if ((b0 & 0xE0) == 0xC0) {
      cp = b0 & 0x1F
      len = 2
    }
    else if ((b0 & 0xF0) == 0xE0) {
      cp = b0 & 0x0F
      len = 3
    }
    else if ((b0 & 0xF8) == 0xF0) {
      cp = b0 & 0x07
      len = 4
    }
    else {
      // 10xxxxxx（落单续接字节）或 11111xxx 等非法首字节
      out.push(REPLACEMENT)
      i++
      continue
    }
    if (i + len > n) {
      // 序列被截断
      out.push(REPLACEMENT)
      i++
      continue
    }
    let valid: boolean = true
    for (let k: number = 1; k < len; k++) {
      const bk: number = bytes[i + k] | 0
      if ((bk & 0xC0) != 0x80) {
        valid = false
        break
      }
      cp = (cp << 6) | (bk & 0x3F)
    }
    if (valid) {
      if (len == 2 && cp < 0x80) {
        valid = false
      }
      else if (len == 3 && cp < 0x800) {
        valid = false
      }
      else if (len == 4 && cp < 0x10000) {
        valid = false
      }
      else if (cp > 0x10FFFF) {
        valid = false
      }
      else if (cp >= 0xD800 && cp <= 0xDFFF) {
        valid = false
      }
    }
    if (!valid) {
      out.push(REPLACEMENT)
      i++
      continue
    }
    if (cp < 0x10000) {
      out.push(String.fromCharCode(cp))
    }
    else {
      const v: number = cp - 0x10000
      out.push(String.fromCharCode(0xD800 + (v >> 10)))
      out.push(String.fromCharCode(0xDC00 + (v & 0x3FF)))
    }
    i += len
  }
  return out.join('')
}

/**
 * 字节数组转 Base64 字符串（带 `=` 填充，等价于 `uni.arrayBufferToBase64`）
 * @param bytes 字节数组
 * @returns Base64 字符串
 */
export function b64Encode(bytes: Uint8Array): string {
  const parts: Array<string> = []
  const n: number = bytes.length
  let i: number = 0
  while (i + 2 < n) {
    const g0: number = bytes[i] | 0
    const g1: number = bytes[i + 1] | 0
    const g2: number = bytes[i + 2] | 0
    parts.push(B64_ALPHABET.charAt((g0 >> 2) & 0x3F))
    parts.push(B64_ALPHABET.charAt(((g0 & 0x03) << 4) | ((g1 >> 4) & 0x0F)))
    parts.push(B64_ALPHABET.charAt(((g1 & 0x0F) << 2) | ((g2 >> 6) & 0x03)))
    parts.push(B64_ALPHABET.charAt(g2 & 0x3F))
    i += 3
  }
  const rest: number = n - i
  if (rest == 1) {
    const m0: number = bytes[i] | 0
    parts.push(B64_ALPHABET.charAt((m0 >> 2) & 0x3F))
    parts.push(B64_ALPHABET.charAt((m0 & 0x03) << 4))
    parts.push('=')
    parts.push('=')
  }
  else if (rest == 2) {
    const p0: number = bytes[i] | 0
    const p1: number = bytes[i + 1] | 0
    parts.push(B64_ALPHABET.charAt((p0 >> 2) & 0x3F))
    parts.push(B64_ALPHABET.charAt(((p0 & 0x03) << 4) | ((p1 >> 4) & 0x0F)))
    parts.push(B64_ALPHABET.charAt((p1 & 0x0F) << 2))
    parts.push('=')
  }
  return parts.join('')
}

/**
 * Base64 字符串转字节数组（等价于 `uni.base64ToArrayBuffer`）
 *
 * 表内字符之外的字符（换行 / 空格 / PEM 头尾残留 / 结尾的 `=`）一律忽略，
 * 因此天然兼容「带填充、无填充、带换行」三种写法，无需调用方先做清洗。
 *
 * @param b64 Base64 字符串（可带换行与填充）
 * @returns 解码后的字节数组
 */
export function b64Decode(b64: string): Uint8Array {
  const vals: Array<number> = []
  for (let i: number = 0; i < b64.length; i++) {
    const idx: number = b64CharValue(b64.charCodeAt(i) ?? 0)
    if (idx >= 0) {
      vals.push(idx)
    }
  }
  const n: number = vals.length
  // 4 个 Base64 字符还原 3 字节；末尾不足 4 个时，3 个还原 2 字节、2 个还原 1 字节
  const tail: number = n % 4
  let outLen: number = Math.floor(n / 4) * 3
  if (tail == 3) {
    outLen += 2
  }
  else if (tail == 2) {
    outLen += 1
  }
  const out: Uint8Array = new Uint8Array(outLen)
  let oi: number = 0
  let vi: number = 0
  while (vi + 3 < n) {
    const q0: number = vals[vi]
    const q1: number = vals[vi + 1]
    const q2: number = vals[vi + 2]
    const q3: number = vals[vi + 3]
    const word: number = (q0 << 18) | (q1 << 12) | (q2 << 6) | q3
    out[oi] = (word >> 16) & 0xFF
    out[oi + 1] = (word >> 8) & 0xFF
    out[oi + 2] = word & 0xFF
    oi += 3
    vi += 4
  }
  const rest: number = n - vi
  if (rest == 3) {
    const w3: number = (vals[vi] << 18) | (vals[vi + 1] << 12) | (vals[vi + 2] << 6)
    out[oi] = (w3 >> 16) & 0xFF
    out[oi + 1] = (w3 >> 8) & 0xFF
  }
  else if (rest == 2) {
    const w2: number = (vals[vi] << 18) | (vals[vi + 1] << 12)
    out[oi] = (w2 >> 16) & 0xFF
  }
  return out
}
