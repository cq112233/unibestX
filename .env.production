# ==========================================
# 生产环境配置（打正式包用，默认即此环境，无需切换）
# 使用：pnpm env:prod → 确保 .env.production.local 已删除，再执行 pnpm build:h5
# ==========================================
VITE_ENV_TYPE=production

# 接口地址（完整域名；H5 直连、App / 小程序 均读取此值）
VITE_SERVER_BASEURL=https://ukw0y1.laf.run
VITE_SERVER_BASEURL_SECONDARY=https://ukw0y1.laf.run

# OSS 上传接口配置
VITE_UPLOAD_BASEURL=https://xxx.com
VITE_UPLOAD_PATH=/gateway/user/sys/oss/upload/xxx
