import type { CustomTabBarItem } from './types';
/**
 * Tabbar 策略映射结构类型
 */
export type TabbarStrategyType = {
    NO_TABBAR: number;
    NATIVE_TABBAR: number;
    CUSTOM_TABBAR: number;
};
/**
 * tabbar 选择的策略（参考 unibest）
 * 0: NO_TABBAR (无 tabbar)
 * 1: NATIVE_TABBAR (原生 tabbar)
 * 2: CUSTOM_TABBAR (自定义 tabbar)
 */
export const TABBAR_STRATEGY_MAP: TabbarStrategyType = {
    NO_TABBAR: 0,
    NATIVE_TABBAR: 1,
    CUSTOM_TABBAR: 2
};
/** 解析环境变量中的 Tabbar 模式 */
function parseTabbarStrategy(): number {
    const envMode: string = `${import.meta.env.VITE_TABBAR_MODE ?? '1'}`.trim();
    if (envMode == '0' || envMode == 'NO_TABBAR') {
        return TABBAR_STRATEGY_MAP.NO_TABBAR;
    }
    if (envMode == '2' || envMode == 'CUSTOM_TABBAR') {
        return TABBAR_STRATEGY_MAP.CUSTOM_TABBAR;
    }
    return TABBAR_STRATEGY_MAP.NATIVE_TABBAR;
}
/** 当前激活的 Tabbar 策略 */
export const selectedTabbarStrategy: number = parseTabbarStrategy();
/** 是否启用 tabbar 缓存（原生或自定义模式下为 true，无 tabbar 时为 false） */
export const tabbarCacheEnable: boolean = selectedTabbarStrategy != TABBAR_STRATEGY_MAP.NO_TABBAR;
/** 是否启用自定义 tabbar（CUSTOM_TABBAR 为 true） */
export const customTabbarEnable: boolean = selectedTabbarStrategy == TABBAR_STRATEGY_MAP.CUSTOM_TABBAR;
/** 是否需要隐藏原生 tabbar（CUSTOM_TABBAR 为 true） */
export const needHideNativeTabbar: boolean = selectedTabbarStrategy == TABBAR_STRATEGY_MAP.CUSTOM_TABBAR;
/** 是否使用原生 tabbar（NATIVE_TABBAR 为 true） */
export const isNativeTabbar: boolean = selectedTabbarStrategy == TABBAR_STRATEGY_MAP.NATIVE_TABBAR;
/**
 * 自定义 tabbar 列表配置
 * pagePath 需要与 pages.json 中的 path 一致
 * text 使用 i18n key 以支持动态语言切换
 * iconType 改为 'icon' 以使用 uni-icons 字体图标
 */
export const customTabbarList: CustomTabBarItem[] = [
    {
        text: 'tabbar.home',
        pagePath: 'src/pages/index/index',
        iconType: 'icon',
        icon: 'home',
        iconActive: 'home-filled',
        badge: null,
        isBulge: false
    } as CustomTabBarItem,
    {
        text: 'tabbar.basic',
        pagePath: 'src/pages/basic/basic',
        iconType: 'icon',
        icon: 'tune',
        iconActive: 'tune-filled',
        badge: null,
        isBulge: false
    } as CustomTabBarItem,
    {
        text: 'tabbar.ai',
        pagePath: '',
        iconType: 'icon',
        icon: 'chatboxes',
        iconActive: 'chatboxes-filled',
        badge: null,
        isBulge: true
    } as CustomTabBarItem,
    {
        text: 'tabbar.function',
        pagePath: 'src/pages/function/function',
        iconType: 'icon',
        icon: 'gear',
        iconActive: 'gear-filled',
        badge: null,
        isBulge: false
    } as CustomTabBarItem,
    {
        text: 'tabbar.me',
        pagePath: 'src/pages/me/me',
        iconType: 'icon',
        icon: 'person',
        iconActive: 'person-filled',
        badge: null,
        isBulge: false
    } as CustomTabBarItem
];
