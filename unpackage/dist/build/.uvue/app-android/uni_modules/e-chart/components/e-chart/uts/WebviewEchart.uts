type EchartEvent = (e: UTSJSONObject) => void;
/**
 * 模拟Echart对象,兼容Webview交互 (支持 Vapor 蒸汽模式与 VDOM 模式)
 */
export default class WebviewEchart {
    private canvasId: string = "";
    private webviewCtx: WebviewContext | null = null;
    private element: UniWebViewElement | null = null;
    private onEventMap: Map<string, EchartEvent> = new Map();
    private onceEventMap: Map<string, EchartEvent> = new Map();
    constructor(canvasId: string, webviewCtx: WebviewContext | null = null, element: UniWebViewElement | null = null) {
        this.canvasId = canvasId;
        this.webviewCtx = webviewCtx;
        this.element = element;
    }
    evalJS(code: string) {
        if (this.element != null) {
            this.element!.evalJS(code);
            return;
        }
        if (this.webviewCtx != null) {
            this.webviewCtx!.evalJS(code);
            return;
        }
        if (this.canvasId != "") {
            const el = uni.getElementById(this.canvasId) as UniWebViewElement | null;
            if (el != null) {
                this.element = el;
                this.element!.evalJS(code);
                return;
            }
            try {
                const ctx = uni.createWebviewContext(this.canvasId);
                if (ctx != null) {
                    this.webviewCtx = ctx;
                    this.webviewCtx!.evalJS(code);
                    return;
                }
            }
            catch (_e: any) { }
        }
    }
    init(theme?: string, opts: UTSJSONObject = {}) {
        this.evalJS(`init(${JSON.stringify({ theme, opts })})`);
    }
    onWebviewMsg(e: UniWebViewMessageEvent) {
        console.log('onWebviewMsg', e.detail.data);
        for (let msg of e.detail.data) {
            const msgType = msg['type'] as string;
            const data = msg['data'] as UTSJSONObject;
            // 长期监听的事件
            const onEventMap = this.onEventMap.get(msgType);
            if (onEventMap != null) {
                onEventMap(data);
            }
            // 一次性事件
            const onceEvent = this.onceEventMap.get(msgType);
            if (onceEvent != null) {
                onceEvent(data);
                this.onceEventMap.delete(msgType);
            }
        }
    }
    setOption(option: UTSJSONObject, notMerge: boolean = false, lazyUpdate: boolean = false) {
        this.evalJS(`setOption(${JSON.stringify(option)}, ${notMerge}, ${lazyUpdate})`);
    }
    getOption(success: EchartEvent) {
        this.onceEventMap.set('getOption', success);
        this.evalJS(`getOption()`);
    }
    getWidth(success: EchartEvent) {
        this.onceEventMap.set('getWidth', success);
        this.evalJS(`getWidth()`);
    }
    getHeight(success: EchartEvent) {
        this.onceEventMap.set('getHeight', success);
        this.evalJS(`getHeight()`);
    }
    resize(option: UTSJSONObject = {}) {
        this.evalJS(`resize(${JSON.stringify(option)})`);
    }
    on(name: string, handler: EchartEvent) {
        this.onEventMap.set(name, handler);
        this.evalJS(`on(${JSON.stringify({ name })})`); // 无法传递单纯的string,必须为对象形态的string
    }
    on(name: string, query: string | UTSJSONObject, handler: EchartEvent) {
        this.onEventMap.set(name, handler);
        this.evalJS(`on(${JSON.stringify({ name, query })})`); // 无法传递单纯的string,必须为对象形态的string
    }
    off(name: string) {
        this.evalJS(`off(${JSON.stringify({ name })})`);
    }
    dispatchAction(option: UTSJSONObject) {
        this.evalJS(`dispatchAction(${JSON.stringify(option)})`);
    }
    showLoading(option: UTSJSONObject) {
        this.evalJS(`showLoading(${JSON.stringify(option)})`);
    }
    hideLoading() {
        this.evalJS(`hideLoading()`);
    }
    appendData(option: UTSJSONObject) {
        this.evalJS(`appendData(${JSON.stringify(option)})`);
    }
    canvasToTempFilePath(option: UTSJSONObject) {
        const success = option['success'] as (res: UTSJSONObject) => void;
        this.onceEventMap.set('canvasToTempFilePath', success);
        this.evalJS(`canvasToTempFilePath()`);
    }
    clear() {
        this.evalJS(`clear()`);
    }
    dispose() {
        this.evalJS(`dispose()`);
    }
}
