/**
 * Lodash Core JS 算法重构版 (UTS 100% 原生无缝兼容)
 * 具备跨平台高兼容性，无缝支持 Android、iOS、鸿蒙 (HarmonyOS)、Web 及小程序
 */
/**
 * 数组去重
 * @param array 待去重的原始数组
 * @returns 去重后的新数组
 */
function uniq(array: any[]): any[] {
    let index = -1;
    const length = array.length;
    const result: any[] = [];
    while (++index < length) {
        const value = array[index];
        if (result.indexOf(value) < 0) {
            result.push(value);
        }
    }
    return result;
}
/**
 * 数组切片分组
 * @param array 原始数组
 * @param size 每个分组的元素个数
 * @returns 拆分后的二维数组
 */
function chunk(array: any[], size: number): any[] {
    const length = array != null ? array.length : 0;
    if (length == 0 || size < 1) {
        return [];
    }
    let index = 0;
    const step = size > 0 ? size : 1;
    const result: any[] = [];
    while (index < length) {
        const nextIndex = index + step;
        result.push(array.slice(index, nextIndex));
        index = nextIndex;
    }
    return result;
}
/**
 * 数组随机打乱 (Fisher-Yates 洗牌算法)
 * @param array 原始数组
 * @returns 打乱顺序后的新数组
 */
function shuffle(array: any[]): any[] {
    const length = array != null ? array.length : 0;
    if (length == 0) {
        return [];
    }
    let index = -1;
    const lastIndex = length - 1;
    const result = array.slice();
    while (++index < length) {
        const rand = Math.floor(index + Math.random() * (lastIndex - index + 1)) as number;
        const value = result[rand];
        result[rand] = result[index];
        result[index] = value;
    }
    return result;
}
/**
 * 对象嵌套路径安全取值
 * @param object 目标对象
 * @param path 属性路径 (例如 'user.info.name')
 * @param defaultValue 当取值未找到或为空时的兜底默认值
 * @returns 目标属性值或兜底默认值
 */
function get(object: any | null, path: string, defaultValue: any | null = null): any | null {
    if (object == null) {
        return defaultValue;
    }
    const pathKeys = path.split('.');
    let index = 0;
    const length = pathKeys.length;
    let curr: any | null = object;
    while (curr != null && index < length) {
        const key = pathKeys[index++];
        if (typeof curr == 'object') {
            const jsonObj = curr as UTSJSONObject;
            curr = jsonObj[key];
        }
        else {
            curr = null;
        }
    }
    return index == length && curr != null ? curr : defaultValue;
}
/**
 * 对象与数组深拷贝
 * @param value 待深拷贝的任意值/对象
 * @returns 完全隔离的深拷贝副本
 */
function cloneDeep(value: any | null): any | null {
    if (value == null || typeof value != 'object') {
        return value;
    }
    if (Array.isArray(value)) {
        const arr = value as any[];
        const copy: any[] = [];
        for (let i = 0; i < arr.length; i++) {
            const item = cloneDeep(arr[i]);
            if (item != null) {
                copy.push(item!);
            }
        }
        return copy;
    }
    const obj = value as UTSJSONObject;
    const res: UTSJSONObject = {};
    const keys = UTSJSONObject.keys(obj);
    for (let i = 0; i < keys.length; i++) {
        const k = keys[i];
        res[k] = cloneDeep(obj[k]);
    }
    return res;
}
/**
 * 文本转换驼峰命名 (camelCase)
 * @param string 输入文本
 * @returns 转换后的驼峰字符串
 */
function camelCase(string: string): string {
    if (string == '')
        return '';
    const words = string.replace(/[-_]+/g, ' ').trim().split(' ');
    let result = '';
    for (let i = 0; i < words.length; i++) {
        const word = words[i];
        if (word.length > 0) {
            if (result.length == 0) {
                result += word.toLowerCase();
            }
            else {
                result += word.charAt(0).toUpperCase() + word.slice(1).toLowerCase();
            }
        }
    }
    return result;
}
/**
 * 文本转换短横线分隔命名 (kebabCase)
 * @param string 输入文本
 * @returns 转换后的短横线分隔字符串
 */
function kebabCase(string: string): string {
    if (string == '')
        return '';
    const words = string.replace(/([a-z0-9])([A-Z])/g, '$1-$2').replace(/[-_\s]+/g, '-').split('-');
    const result: string[] = [];
    for (let i = 0; i < words.length; i++) {
        const w = words[i];
        if (w.length > 0) {
            result.push(w.toLowerCase());
        }
    }
    return result.join('-');
}
/**
 * 首字母大写修饰 (capitalize)
 * @param string 输入文本
 * @returns 转换后首字母大写的字符串
 */
function capitalize(string: string): string {
    if (string == '')
        return '';
    return string.charAt(0).toUpperCase() + string.slice(1).toLowerCase();
}
/**
 * 高精度防抖函数
 * @param func 被防抖调用的目标函数
 * @param wait 延迟触发的时间 (毫秒)
 * @returns 封装后的防抖代理函数
 */
function debounce(func: any, wait: number): any {
    let timerId: number = 0;
    function timerExpired() {
        timerId = 0;
        const fn = func as () => void;
        fn();
    }
    return function () {
        if (timerId != 0) {
            clearTimeout(timerId);
        }
        timerId = setTimeout(() => {
            timerExpired();
        }, wait);
    };
}
/**
 * 生成指定范围内的随机整数
 * @param lower 最小值 (默认为 0)
 * @param upper 最大值 (默认为 1)
 * @returns 生成的随机整数
 */
function random(lower: number = 0, upper: number = 1): number {
    const min = Math.min(lower, upper);
    const max = Math.max(lower, upper);
    return Math.floor(min + Math.random() * (max - min + 1)) as number;
}
/**
 * 深度等值比较 (isEqual)
 * @param value 比较值 A
 * @param other 比较值 B
 * @returns 内容是否完全相等
 */
function isEqual(value: any | null, other: any | null): boolean {
    if (value == other)
        return true;
    if (value == null || other == null)
        return false;
    if (typeof value != typeof other)
        return false;
    if (typeof value != 'object')
        return value == other;
    return JSON.stringify(value) == JSON.stringify(other);
}
/**
 * 对象深度合并 (merge)
 * @param target 目标合并对象
 * @param source 源对象
 * @returns 合并后的目标对象
 */
function merge(target: any, source: any): any {
    if (target == null || source == null)
        return target != null ? target : source;
    const tObj = target as UTSJSONObject;
    const sObj = source as UTSJSONObject;
    const keys = UTSJSONObject.keys(sObj);
    for (let i = 0; i < keys.length; i++) {
        const k = keys[i];
        const sVal = sObj[k];
        const tVal = tObj[k];
        if (typeof sVal == 'object' && sVal != null && typeof tVal == 'object' && tVal != null) {
            tObj[k] = merge(tVal, sVal);
        }
        else {
            tObj[k] = sVal;
        }
    }
    return tObj;
}
/**
 * 实例化 Lodash 工具集工厂函数
 * @returns 包含所有核心工具 Api 的 Lodash 实例
 */
export default function initLodash(): any {
    return {
        uniq: (array: any[]): any[] => uniq(array),
        chunk: (array: any[], size: number): any[] => chunk(array, size),
        shuffle: (array: any[]): any[] => shuffle(array),
        get: (object: any | null, path: string, defaultValue: any | null): any | null => get(object, path, defaultValue),
        cloneDeep: (value: any | null): any | null => cloneDeep(value),
        camelCase: (string: string): string => camelCase(string),
        kebabCase: (string: string): string => kebabCase(string),
        capitalize: (string: string): string => capitalize(string),
        debounce: (func: any, wait: number): any => debounce(func, wait),
        random: (lower: number, upper: number): number => random(lower, upper),
        isEqual: (value: any | null, other: any | null): boolean => isEqual(value, other),
        merge: (target: any, source: any): any => merge(target, source)
    };
}
export { uniq, chunk, shuffle, get, cloneDeep, camelCase, kebabCase, capitalize, debounce, random, isEqual, merge, initLodash };
