/**
 * RSA 纯 UTS 实现（跨平台通用）
 *
 * 适用于 H5 / 微信小程序 / iOS / 鸿蒙等所有非 Android 平台，实现标准 RSA：
 * - 密钥导入：公钥支持 PKCS#1（BEGIN RSA PUBLIC KEY）与 SPKI（BEGIN PUBLIC KEY）
 *   私钥支持 PKCS#1（BEGIN RSA PRIVATE KEY）与 PKCS#8（BEGIN PRIVATE KEY），PEM 或裸 Base64
 * - 加解密：RSA/ECB/PKCS1Padding（EME-PKCS1-v1_5），密文输出十六进制
 * - 签名验签：EMSA-PKCS1-v1_5（传入摘要与算法名，支持 MD5 / SHA-1 / SHA-256）
 * - 密钥对生成：纯 JS / BigInt 快速生成标准 SPKI 公钥与 PKCS#8 私钥
 * - 大数运算：字节大端序数组 + Knuth D 长除法取模，不依赖 BigInt，可在各端编译为原生代码
 */
// ---- 类型定义 ----
/** 解析后的 RSA 公钥 */
type RsaPublicKey = {
    modulus: Uint8Array;
    exponent: Uint8Array;
};
/** 解析后的 RSA 私钥（仅保留解密 / 签名所需参数） */
type RsaPrivateKey = {
    modulus: Uint8Array;
    privateExponent: Uint8Array;
};
/** DER 元素信息 */
type DerElement = {
    tag: number;
    contentStart: number;
    contentLen: number;
    nextStart: number;
};
/** Base64 字符表 */
const B64_CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';
// ---- 通用工具：文本 / 字节 / 十六进制 ----
/**
 * 字节数组转十六进制字符串（小写）
 * @param bytes 字节数组
 * @returns 十六进制字符串
 */
function bytesToHex(bytes: Uint8Array): string {
    let result = '';
    for (let i = 0; i < bytes.length; i++) {
        const b = bytes[i] | 0;
        result += (b < 16 ? '0' : '') + b.toString(16);
    }
    return result;
}
/**
 * 十六进制字符串转字节数组
 * @param hex 十六进制字符串（偶数长度）
 * @returns 字节数组
 */
function hexToBytes(hex: string): Uint8Array {
    const len = hex.length / 2;
    const bytes = new Uint8Array(len);
    for (let i = 0; i < len; i++) {
        bytes[i] = parseInt(hex.substring(i * 2, i * 2 + 2), 16);
    }
    return bytes;
}
/**
 * 字符串转 UTF-8 字节数组
 * @param text 原始字符串
 * @returns UTF-8 编码的字节数组
 */
function textToBytes(text: string): Uint8Array {
    return new TextEncoder().encode(text);
}
/**
 * UTF-8 字节数组转字符串
 * @param bytes UTF-8 编码的字节数组
 * @returns 解码后的字符串
 */
function bytesToText(bytes: Uint8Array): string {
    return new TextDecoder().decode(bytes);
}
/**
 * 截取字节数组的子区间
 * @param bytes 原始字节数组
 * @param start 起始下标（含）
 * @param end 结束下标（不含）
 * @returns 子区间字节数组
 */
function subBytes(bytes: Uint8Array, start: number, end: number): Uint8Array {
    const len = end - start;
    const out = new Uint8Array(len);
    for (let i = 0; i < len; i++) {
        out[i] = bytes[start + i];
    }
    return out;
}
/**
 * 去除 PEM 头尾与空白，仅保留 Base64 字符
 * @param pem PEM 字符串或裸 Base64
 * @returns 纯净的 Base64 字符串
 */
function stripPem(pem: string): string {
    // 先按行剔除 PEM 头尾标记（BEGIN/END 行），再过滤非 Base64 字符
    const lines = pem.split('\n');
    let body = '';
    for (let i = 0; i < lines.length; i++) {
        if (lines[i].indexOf('-----') >= 0) {
            continue;
        }
        body = body + lines[i];
    }
    let result = '';
    for (let i = 0; i < body.length; i++) {
        const c = body.charAt(i);
        if (B64_CHARS.indexOf(c) >= 0 || c == '=') {
            result += c;
        }
    }
    return result;
}
/**
 * Base64 解码为字节数组（使用 uni-app X 自带 API）
 * @param b64 Base64 字符串（可带 PEM 头尾）
 * @returns 解码后的字节数组
 */
function base64DecodeToBytes(b64: string): Uint8Array {
    // 先剔除 PEM 头尾，再补齐 = 填充到 4 的倍数（兼容无填充的裸 Base64）
    let clean = stripPem(b64);
    while (clean.length % 4 != 0) {
        clean = clean + '=';
    }
    return new Uint8Array(uni.base64ToArrayBuffer(clean));
}
// ---- DER 解析：密钥导入 ----
/**
 * 读取 DER 元素（tag / 内容区间 / 下一元素位置）
 * @param bytes DER 字节数组
 * @param start 起始偏移
 * @returns 元素信息
 */
function derReadElement(bytes: Uint8Array, start: number): DerElement {
    const tag = bytes[start] | 0;
    const l0 = bytes[start + 1] | 0;
    let len: number = 0;
    let headerLen: number = 2;
    if (l0 < 0x80) {
        len = l0;
    }
    else {
        const numLen = l0 & 0x7f;
        for (let i = 0; i < numLen; i++) {
            len = len * 256 + (bytes[start + 2 + i] | 0);
        }
        headerLen = 2 + numLen;
    }
    const contentStart = start + headerLen;
    return { tag: tag, contentStart: contentStart, contentLen: len, nextStart: contentStart + len } as DerElement;
}
/**
 * 提取 DER INTEGER 的值（去除前导 0）
 * @param bytes DER 字节数组
 * @param elem INTEGER 元素
 * @returns 整数值字节数组
 */
function derIntegerValue(bytes: Uint8Array, elem: DerElement): Uint8Array {
    return trimZero(subBytes(bytes, elem.contentStart, elem.contentStart + elem.contentLen));
}
/**
 * 解析公钥（自动识别 PKCS#1 / SPKI）
 * @param pem 公钥 PEM 或 Base64
 * @returns 模数与公钥指数
 */
function parsePublicKey(pem: string): RsaPublicKey {
    const der = base64DecodeToBytes(pem);
    const outer = derReadElement(der, 0);
    const content = subBytes(der, outer.contentStart, outer.contentStart + outer.contentLen);
    const first = derReadElement(content, 0);
    if (first.tag == 0x02) {
        // PKCS#1：SEQUENCE { INTEGER n, INTEGER e }
        const n = derIntegerValue(content, first);
        const eElem = derReadElement(content, first.nextStart);
        const e = derIntegerValue(content, eElem);
        return { modulus: n, exponent: e } as RsaPublicKey;
    }
    // SPKI：SEQUENCE { SEQUENCE 算法, BIT STRING { 0x00, PKCS#1 } }
    const algo = derReadElement(content, 0);
    const bit = derReadElement(content, algo.nextStart);
    const pkcs1 = subBytes(content, bit.contentStart + 1, bit.contentStart + bit.contentLen);
    const pk1 = derReadElement(pkcs1, 0);
    const nElem = derReadElement(pkcs1, pk1.contentStart);
    const n = derIntegerValue(pkcs1, nElem);
    const eElem = derReadElement(pkcs1, nElem.nextStart);
    const e = derIntegerValue(pkcs1, eElem);
    return { modulus: n, exponent: e } as RsaPublicKey;
}
/**
 * 解析 PKCS#1 私钥 DER（取 n 与 d）
 * @param pkcs1 PKCS#1 私钥 DER 字节
 * @returns 模数与私钥指数
 */
function parsePrivateKeyPkcs1(pkcs1: Uint8Array): RsaPrivateKey {
    const outer = derReadElement(pkcs1, 0);
    const content = subBytes(pkcs1, outer.contentStart, outer.contentStart + outer.contentLen);
    const ver = derReadElement(content, 0);
    const nElem = derReadElement(content, ver.nextStart);
    const n = derIntegerValue(content, nElem);
    const eElem = derReadElement(content, nElem.nextStart);
    const dElem = derReadElement(content, eElem.nextStart);
    const d = derIntegerValue(content, dElem);
    return { modulus: n, privateExponent: d } as RsaPrivateKey;
}
/**
 * 解析私钥（自动识别 PKCS#1 / PKCS#8）
 * @param pem 私钥 PEM 或 Base64
 * @returns 模数与私钥指数
 */
function parsePrivateKey(pem: string): RsaPrivateKey {
    const der = base64DecodeToBytes(pem);
    const outer = derReadElement(der, 0);
    const content = subBytes(der, outer.contentStart, outer.contentStart + outer.contentLen);
    const first = derReadElement(content, 0);
    if (first.tag == 0x02) {
        const second = derReadElement(content, first.nextStart);
        if (second.tag == 0x02) {
            // PKCS#1：version, n, e, d, ...
            const n = derIntegerValue(content, second);
            const eElem = derReadElement(content, second.nextStart);
            const dElem = derReadElement(content, eElem.nextStart);
            const d = derIntegerValue(content, dElem);
            return { modulus: n, privateExponent: d } as RsaPrivateKey;
        }
        // PKCS#8：version INTEGER, SEQUENCE 算法, OCTET STRING { PKCS#1 }
        const algo = second;
        const octet = derReadElement(content, algo.nextStart);
        const pkcs1 = subBytes(content, octet.contentStart, octet.contentStart + octet.contentLen);
        return parsePrivateKeyPkcs1(pkcs1);
    }
    throw new Error('无法识别的私钥格式，请使用 PKCS#1 或 PKCS#8 密钥');
}
// ---- 大数运算（字节大端序，去前导 0，至少 1 字节） ----
/**
 * 去除字节数组前导 0（至少保留 1 字节）
 * @param bytes 原始字节数组
 * @returns 去除前导 0 后的字节数组
 */
function trimZero(bytes: Uint8Array): Uint8Array {
    let start = 0;
    while (start < bytes.length - 1 && bytes[start] == 0) {
        start++;
    }
    return subBytes(bytes, start, bytes.length);
}
/**
 * 判断大数是否为 0
 * @param bytes 大数
 * @returns 是否为 0
 */
function isZero(bytes: Uint8Array): boolean {
    for (let i = 0; i < bytes.length; i++) {
        if (bytes[i] != 0) {
            return false;
        }
    }
    return true;
}
/**
 * 大数比较
 * @param a 大数 a
 * @param b 大数 b
 * @returns -1（a < b）/ 0（a == b）/ 1（a > b）
 */
function bigCmp(a: Uint8Array, b: Uint8Array): number {
    if (a.length != b.length) {
        return a.length > b.length ? 1 : -1;
    }
    for (let i = 0; i < a.length; i++) {
        const av = a[i] | 0;
        const bv = b[i] | 0;
        if (av != bv) {
            return av > bv ? 1 : -1;
        }
    }
    return 0;
}
/**
 * 大数加法
 * @param a 大数 a
 * @param b 大数 b
 * @returns a + b
 */
function bigAdd(a: Uint8Array, b: Uint8Array): Uint8Array {
    const maxLen = a.length > b.length ? a.length : b.length;
    const out = new Uint8Array(maxLen + 1);
    let carry = 0;
    for (let i = 0; i < maxLen; i++) {
        const av = i < a.length ? (a[a.length - 1 - i] | 0) : 0;
        const bv = i < b.length ? (b[b.length - 1 - i] | 0) : 0;
        const s = av + bv + carry;
        out[maxLen - i] = s & 0xff;
        carry = s >> 8;
    }
    out[0] = carry;
    return trimZero(out);
}
/**
 * 大数减法（要求 a >= b）
 * @param a 大数 a
 * @param b 大数 b
 * @returns a - b
 */
function bigSub(a: Uint8Array, b: Uint8Array): Uint8Array {
    const out = new Uint8Array(a.length);
    let borrow = 0;
    for (let i = 0; i < a.length; i++) {
        const av = a[a.length - 1 - i] | 0;
        const bv = i < b.length ? (b[b.length - 1 - i] | 0) : 0;
        let diff = av - bv - borrow;
        if (diff < 0) {
            diff = diff + 256;
            borrow = 1;
        }
        else {
            borrow = 0;
        }
        out[a.length - 1 - i] = diff;
    }
    return trimZero(out);
}
/**
 * 大数右移指定位数（大端序）
 * @param a 大数
 * @param bits 右移位数（0-7）
 * @returns 右移结果
 */
function bigShrBits(a: Uint8Array, bits: number): Uint8Array {
    const out = new Uint8Array(a.length);
    let carry = 0;
    for (let i = a.length - 1; i >= 0; i--) {
        const v = a[i] | 0;
        out[i] = (v >> bits) | carry;
        carry = (v & ((1 << bits) - 1)) << (8 - bits);
    }
    return trimZero(out);
}
// ---- 小端序辅助（仅 bigMod 内部使用） ----
/**
 * 去除小端序数组高位（尾部）的 0，至少保留 1 字节
 * @param bytes 小端序字节数组
 * @returns 去除高位 0 后的字节数组
 */
function trimLE(bytes: Uint8Array): Uint8Array {
    let end = bytes.length;
    while (end > 1 && bytes[end - 1] == 0) {
        end = end - 1;
    }
    return subBytes(bytes, 0, end);
}
/**
 * 大端序转小端序
 * @param bytes 大端序字节数组
 * @returns 小端序字节数组
 */
function toLE(bytes: Uint8Array): Uint8Array {
    const out = new Uint8Array(bytes.length);
    for (let i = 0; i < bytes.length; i++) {
        out[i] = bytes[bytes.length - 1 - i];
    }
    return trimLE(out);
}
/**
 * 小端序转大端序
 * @param bytes 小端序字节数组
 * @returns 大端序字节数组
 */
function toBE(bytes: Uint8Array): Uint8Array {
    const out = new Uint8Array(bytes.length);
    for (let i = 0; i < bytes.length; i++) {
        out[i] = bytes[bytes.length - 1 - i];
    }
    return trimZero(out);
}
/**
 * 小端序大数左移指定位数（不裁剪高位 0，输出长度 = 输入长度 + 1）
 * @param a 小端序大数
 * @param bits 左移位数（0-7）
 * @returns 左移结果
 */
function bigShlBitsLE(a: Uint8Array, bits: number): Uint8Array {
    const out = new Uint8Array(a.length + 1);
    let carry = 0;
    for (let i = 0; i < a.length; i++) {
        const v = a[i] | 0;
        out[i] = ((v << bits) | carry) & 0xff;
        carry = v >> (8 - bits);
    }
    out[a.length] = carry;
    return out;
}
/**
 * 大数乘法（小学竖式乘法）
 * @param a 大数 a
 * @param b 大数 b
 * @returns a * b
 */
function bigMul(a: Uint8Array, b: Uint8Array): Uint8Array {
    if (isZero(a) || isZero(b)) {
        return new Uint8Array(1);
    }
    const outLen = a.length + b.length;
    const out = new Uint8Array(outLen);
    for (let i = 0; i < a.length; i++) {
        const ai = a[a.length - 1 - i] | 0;
        let carry = 0;
        for (let j = 0; j < b.length; j++) {
            const bj = b[b.length - 1 - j] | 0;
            const k = outLen - 1 - (i + j);
            const t = (out[k] | 0) + ai * bj + carry;
            out[k] = t & 0xff;
            carry = t >> 8;
        }
        const k2 = outLen - 1 - (i + b.length);
        out[k2] = (out[k2] | 0) + carry;
    }
    return trimZero(out);
}
/**
 * 计算 b 最高字节的前导 0 个数（0-7）
 * @param b 字节值（1-255）
 * @returns 前导 0 个数
 */
function leadingZeroBits(b: number): number {
    let bits = 0;
    let mask = 0x80;
    while ((b & mask) == 0) {
        bits = bits + 1;
        mask = mask >> 1;
    }
    return bits;
}
/**
 * 获取大数第 i 位（从最高位起算）
 * @param a 大数
 * @param i 位下标（0 为最高位）
 * @returns 0 或 1
 */
function bigGetBit(a: Uint8Array, i: number): number {
    const byteIndex = Math.floor(i / 8);
    const bitInByte = 7 - (i % 8);
    return ((a[byteIndex] | 0) >> bitInByte) & 1;
}
/**
 * 将大数左侧补齐到 n 字节
 * @param bytes 大数
 * @param n 目标字节数
 * @returns 补齐后的字节数组
 */
function padToN(bytes: Uint8Array, n: number): Uint8Array {
    if (bytes.length >= n) {
        return bytes;
    }
    const out = new Uint8Array(n);
    const gap = n - bytes.length;
    for (let i = 0; i < bytes.length; i++) {
        out[gap + i] = bytes[i];
    }
    return out;
}
/**
 * 大数取模（Knuth D 长除法，O(n^2)，内部使用小端序）
 * @param a 被除数
 * @param m 模数（> 0）
 * @returns a mod m
 */
function bigMod(a: Uint8Array, m: Uint8Array): Uint8Array {
    if (bigCmp(a, m) < 0) {
        return a;
    }
    const n = m.length;
    if (n == 1) {
        const mv = m[0] | 0;
        let rem = 0;
        for (let i = 0; i < a.length; i++) {
            rem = (rem * 256 + (a[i] | 0)) % mv;
        }
        const out = new Uint8Array(1);
        out[0] = rem;
        return out;
    }
    // 规范化：左移使模数最高位为 1
    const shift = leadingZeroBits(m[0] | 0);
    const v = trimLE(bigShlBitsLE(toLE(m), shift));
    // 被除数保留进位字节作为最高位保护字节（不裁剪），保证商位数足够
    const uArr = bigShlBitsLE(toLE(a), shift);
    const uLen = uArr.length;
    const qLen = uLen - n;
    // Knuth D：从高位到低位逐位求商并做乘减
    for (let j = qLen - 1; j >= 0; j--) {
        const uTop = (uArr[j + n] | 0) * 256 + (uArr[j + n - 1] | 0);
        let qhat = Math.floor(uTop / (v[n - 1] | 0));
        if (qhat >= 256) {
            qhat = 255;
        }
        let rhat = uTop - qhat * (v[n - 1] | 0);
        while (qhat >= 256 || qhat * (v[n - 2] | 0) > rhat * 256 + (uArr[j + n - 2] | 0)) {
            qhat = qhat - 1;
            rhat = rhat + (v[n - 1] | 0);
            if (rhat >= 256) {
                break;
            }
        }
        // 乘减：u[j..j+n-1] -= qhat * v，最高位保护字节单独处理借位
        let borrow = 0;
        for (let i = 0; i < n; i++) {
            const p = qhat * (v[i] | 0) + borrow;
            const t = (uArr[j + i] | 0) - (p & 0xff);
            uArr[j + i] = t & 0xff;
            borrow = (p >> 8) + (t < 0 ? 1 : 0);
        }
        let hi = (uArr[j + n] | 0) - borrow;
        if (hi < 0) {
            // 加回 v，商减 1（此处无需记录商）
            let carry = 0;
            for (let i = 0; i < n; i++) {
                const s = (uArr[j + i] | 0) + (v[i] | 0) + carry;
                uArr[j + i] = s & 0xff;
                carry = s >> 8;
            }
            hi = hi + carry;
        }
        uArr[j + n] = hi;
    }
    // 余数 = 低 n 字节，转回大端序并反规范化右移
    return bigShrBits(toBE(subBytes(uArr, 0, n)), shift);
}
/**
 * 大数模幂（平方-乘算法）
 * @param base 底数
 * @param exp 指数
 * @param m 模数
 * @returns base^exp mod m
 */
function bigModPow(base: Uint8Array, exp: Uint8Array, m: Uint8Array): Uint8Array {
    let result = new Uint8Array(1);
    result[0] = 1;
    let b = bigMod(base, m);
    const expBits = exp.length * 8;
    for (let i = 0; i < expBits; i++) {
        result = bigMod(bigMul(result, result), m);
        if (bigGetBit(exp, i) == 1) {
            result = bigMod(bigMul(result, b), m);
        }
    }
    return result;
}
/**
 * 将大数左侧补齐到 k 字节（I2OSP）
 * @param x 大数
 * @param k 目标字节数
 * @returns k 字节大端序结果
 */
function i2osp(x: Uint8Array, k: number): Uint8Array {
    return padToN(x, k);
}
// ---- PKCS#1 v1.5 填充 ----
/**
 * 构造 EMSA-PKCS1-v1_5 的 DigestInfo
 * @param digestHex 摘要十六进制字符串
 * @param hashType 摘要算法名（MD5 / SHA-1 / SHA-256）
 * @returns DigestInfo 字节数组
 */
function buildDigestInfo(digestHex: string, hashType: string): Uint8Array {
    const digest = hexToBytes(digestHex);
    let prefixHex = '3031300d060960864801650304020105000420';
    if (hashType == 'MD5') {
        prefixHex = '3020300c06082a864886f70d020505000410';
    }
    else if (hashType == 'SHA-1' || hashType == 'SHA1') {
        prefixHex = '3021300906052b0e03021a05000414';
    }
    const prefix = hexToBytes(prefixHex);
    const out = new Uint8Array(prefix.length + digest.length);
    for (let i = 0; i < prefix.length; i++) {
        out[i] = prefix[i];
    }
    for (let i = 0; i < digest.length; i++) {
        out[prefix.length + i] = digest[i];
    }
    return out;
}
// ---- 对外导出 ----
/**
 * RSA 公钥加密（EME-PKCS1-v1_5）
 * @param text 明文（UTF-8）
 * @param publicKey 公钥（PEM 或 Base64，PKCS#1 / SPKI）
 * @returns 密文十六进制字符串
 */
export function rsaEncryptUts(text: string, publicKey: string): string {
    const key = parsePublicKey(publicKey);
    const k = key.modulus.length;
    const m = textToBytes(text);
    const mLen = m.length;
    if (mLen > k - 11) {
        throw new Error('RSA 明文过长：最长 ' + (k - 11) + ' 字节，当前 ' + mLen + ' 字节');
    }
    const em = new Uint8Array(k);
    em[0] = 0;
    em[1] = 2;
    const psLen = k - mLen - 3;
    for (let i = 0; i < psLen; i++) {
        em[2 + i] = Math.floor(Math.random() * 255) + 1;
    }
    em[k - mLen - 1] = 0;
    for (let i = 0; i < mLen; i++) {
        em[k - mLen + i] = m[i];
    }
    const c = bigModPow(em, key.exponent, key.modulus);
    return bytesToHex(i2osp(c, k));
}
/**
 * RSA 私钥解密（EME-PKCS1-v1_5）
 * @param hex 密文十六进制字符串
 * @param privateKey 私钥（PEM 或 Base64，PKCS#1 / PKCS#8）
 * @returns 明文（UTF-8）
 */
export function rsaDecryptUts(hex: string, privateKey: string): string {
    const key = parsePrivateKey(privateKey);
    const k = key.modulus.length;
    const c = hexToBytes(hex);
    if (c.length != k) {
        throw new Error('RSA 密文长度不正确：应为 ' + k + ' 字节，实际 ' + c.length + ' 字节');
    }
    const m = bigModPow(c, key.privateExponent, key.modulus);
    const em = i2osp(m, k);
    if (em[0] != 0 || em[1] != 2) {
        throw new Error('RSA 解密失败：填充头无效');
    }
    let sep = -1;
    for (let i = 2; i < k; i++) {
        if (em[i] == 0) {
            sep = i;
            break;
        }
    }
    if (sep < 10) {
        throw new Error('RSA 解密失败：填充无效');
    }
    return bytesToText(subBytes(em, sep + 1, k));
}
/**
 * RSA 私钥签名（EMSA-PKCS1-v1_5）
 * @param digestHex 摘要十六进制字符串
 * @param hashType 摘要算法名（MD5 / SHA-1 / SHA-256）
 * @param privateKey 私钥（PEM 或 Base64，PKCS#1 / PKCS#8）
 * @returns 签名十六进制字符串
 */
export function rsaSignUts(digestHex: string, hashType: string, privateKey: string): string {
    const key = parsePrivateKey(privateKey);
    const k = key.modulus.length;
    const t = buildDigestInfo(digestHex, hashType);
    const tLen = t.length;
    if (tLen > k - 11) {
        throw new Error('RSA 签名摘要过长：密钥至少需要 ' + (tLen + 11) + ' 字节');
    }
    const em = new Uint8Array(k);
    em[0] = 0;
    em[1] = 1;
    const psLen = k - tLen - 3;
    for (let i = 0; i < psLen; i++) {
        em[2 + i] = 0xff;
    }
    em[k - tLen - 1] = 0;
    for (let i = 0; i < tLen; i++) {
        em[k - tLen + i] = t[i];
    }
    const s = bigModPow(em, key.privateExponent, key.modulus);
    return bytesToHex(i2osp(s, k));
}
/**
 * RSA 公钥验签（EMSA-PKCS1-v1_5）
 * @param digestHex 摘要十六进制字符串
 * @param hashType 摘要算法名（MD5 / SHA-1 / SHA-256）
 * @param publicKey 公钥（PEM 或 Base64，PKCS#1 / SPKI）
 * @param sigHex 签名十六进制字符串
 * @returns 验签是否通过
 */
export function rsaVerifyUts(digestHex: string, hashType: string, publicKey: string, sigHex: string): boolean {
    const key = parsePublicKey(publicKey);
    const k = key.modulus.length;
    const s = hexToBytes(sigHex);
    if (s.length != k) {
        return false;
    }
    const m = bigModPow(s, key.exponent, key.modulus);
    const em = i2osp(m, k);
    if (em[0] != 0 || em[1] != 1) {
        return false;
    }
    let sep = -1;
    for (let i = 2; i < k; i++) {
        if (em[i] == 0) {
            sep = i;
            break;
        }
        if (em[i] != 0xff) {
            return false;
        }
    }
    if (sep < 10) {
        return false;
    }
    const t = buildDigestInfo(digestHex, hashType);
    if (k - sep - 1 != t.length) {
        return false;
    }
    for (let i = 0; i < t.length; i++) {
        if (em[sep + 1 + i] != t[i]) {
            return false;
        }
    }
    return true;
}
// ---- RSA 密钥对生成（纯 JS / BigInt，支持微信小程序 / H5 / 全端） ----
function bigIntToDerInteger(n: any): Uint8Array {
    let hex: string = n.toString(16);
    if (hex.length % 2 != 0) {
        hex = '0' + hex;
    }
    const firstByte = parseInt(hex.substring(0, 2), 16);
    if (firstByte >= 0x80) {
        hex = '00' + hex;
    }
    const bytes = hexToBytes(hex);
    const len = bytes.length;
    let header: Uint8Array;
    if (len < 128) {
        header = new Uint8Array([0x02, len]);
    }
    else if (len < 256) {
        header = new Uint8Array([0x02, 0x81, len]);
    }
    else {
        header = new Uint8Array([0x02, 0x82, Math.floor(len / 256), len % 256]);
    }
    const out = new Uint8Array(header.length + bytes.length);
    for (let i = 0; i < header.length; i++)
        out[i] = header[i];
    for (let i = 0; i < bytes.length; i++)
        out[header.length + i] = bytes[i];
    return out;
}
function derSequence(items: Uint8Array[]): Uint8Array {
    let totalLen = 0;
    for (let i = 0; i < items.length; i++) {
        totalLen += items[i].length;
    }
    let header: Uint8Array;
    if (totalLen < 128) {
        header = new Uint8Array([0x30, totalLen]);
    }
    else if (totalLen < 256) {
        header = new Uint8Array([0x30, 0x81, totalLen]);
    }
    else {
        header = new Uint8Array([0x30, 0x82, Math.floor(totalLen / 256), totalLen % 256]);
    }
    const out = new Uint8Array(header.length + totalLen);
    for (let i = 0; i < header.length; i++)
        out[i] = header[i];
    let offset = header.length;
    for (let i = 0; i < items.length; i++) {
        for (let j = 0; j < items[i].length; j++) {
            out[offset + j] = items[i][j];
        }
        offset += items[i].length;
    }
    return out;
}
function rsaGenerateKeyPairAndroid(bits: number): string {
    try {
        const kpg = java.security.KeyPairGenerator.getInstance('RSA');
        kpg.initialize(bits.toInt());
        const kp = kpg.generateKeyPair();
        const pubBytes = kp.getPublic().getEncoded();
        const priBytes = kp.getPrivate().getEncoded();
        const pubB64 = android.util.Base64.encodeToString(pubBytes, android.util.Base64.NO_WRAP);
        const priB64 = android.util.Base64.encodeToString(priBytes, android.util.Base64.NO_WRAP);
        return '{"publicKey":"' + pubB64 + '","privateKey":"' + priB64 + '"}';
    }
    catch (_e: any) {
        return '{"publicKey":"","privateKey":""}';
    }
}
/**
 * 生成 RSA 密钥对（全端兼容）
 * @param bits 密钥长度（建议 1024）
 * @returns JSON：{"publicKey":"SPKI-Base64","privateKey":"PKCS8-Base64"}
 */
export function rsaGenerateKeyPairUts(bits: number): string {
    return rsaGenerateKeyPairAndroid(bits);
}
