<template>
  <Card title="环境变量">
    <view class="wtu-1yjek9y-0 wtu-s1ir6x-1 wtu-r20r67-2 wtu-1fwde1j-3 wtu-1hn9nh1-4">
      <view class="wtu-1wn3kuh-5 wtu-x1ltc0-6 wtu-1s9hnts-7">
        <text class="wtu-1yinq8w-8 wtu-y0qx9p-9">应用名称</text>
        <text class="wtu-1yinq8w-8 wtu-1xrmo7y-a wtu-7t1zi1-b">{{ appTitle }}</text>
      </view>
      <view class="wtu-1wn3kuh-5 wtu-x1ltc0-6 wtu-1s9hnts-7">
        <text class="wtu-1yinq8w-8 wtu-y0qx9p-9">应用版本</text>
        <text class="wtu-1yinq8w-8 wtu-1xrmo7y-a wtu-7t1zi1-b">{{ appVersion }}</text>
      </view>
      <view class="wtu-1wn3kuh-5 wtu-x1ltc0-6 wtu-1s9hnts-7">
        <text class="wtu-1yinq8w-8 wtu-y0qx9p-9">编译环境</text>
        <text class="wtu-1yinq8w-8 wtu-1xrmo7y-a" :style="{ color: envColor }">{{ envLabel }}</text>
      </view>
      <view class="wtu-1wn3kuh-5 wtu-x1ltc0-6 wtu-1s9hnts-7">
        <text class="wtu-1yinq8w-8 wtu-y0qx9p-9">环境标识</text>
        <text class="wtu-21em1e-c wtu-1a0szfl-d">{{ envTypeText }}</text>
      </view>
      <view class="wtu-1wn3kuh-5 wtu-x1ltc0-6">
        <text class="wtu-1yinq8w-8 wtu-y0qx9p-9">接口地址</text>
        <text class="wtu-21em1e-c wtu-1a0szfl-d wtu-10cqf12-e wtu-twd3o9-f wtu-1exppl3-g">{{ apiBaseUrl }}</text>
      </view>
    </view>
  </Card>
</template>

<script setup vapor lang="uts">
import Card from '../../basic/components/Card.uvue';
import { computed } from 'vue';

// 应用名称 / 版本（.env 公用配置，全端读取）
const appTitle: string = `${import.meta.env.VITE_APP_TITLE}`;
const appVersion: string = `${import.meta.env.VITE_APP_VERSION}`;

// 编译期环境识别（只读展示，运行期不支持切换）：
// 全端（App / H5 / 微信小程序）均支持读取 .env 的 VITE_ENV_TYPE（development / test / production），
// 与 src/http/request.uts 读取 VITE_SERVER_BASEURL 的方式一致
type EnvType = 'development' | 'test' | 'production';

const buildEnvType: string = `${import.meta.env.VITE_ENV_TYPE ?? ''}`;
const systemEnv: EnvType = buildEnvType == 'test' ? 'test' : (process.env.NODE_ENV == 'development' ? 'development' : 'production');

// 与 src/http/request.uts 保持一致的实际接口地址（全端读取 VITE_SERVER_BASEURL）
const apiBaseUrl: string = `${import.meta.env.VITE_SERVER_BASEURL ?? 'https://ukw0y1.laf.run'}`;
// 原始环境标识（用于核对当前构建产物属于哪个环境）
const envTypeText: string = systemEnv;

const envLabel = computed((): string => {
  if (systemEnv === 'test') {
    return '测试';
  }
  if (systemEnv === 'production') {
    return '生产';
  }
  return '开发';
});

const envColor = computed((): string => {
  if (systemEnv === 'test') {
    return '#f59e0b';
  }
  if (systemEnv === 'production') {
    return '#ef4444';
  }
  return '#10b981';
});
</script>

