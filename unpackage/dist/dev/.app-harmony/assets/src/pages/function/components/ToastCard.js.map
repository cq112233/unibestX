<template>
  <Card title="全局 Toast 提示调用">
    <!-- 说明区域 -->
    <view class="wtu-mnbm96-0 wtu-1bq9shh-1 wtu-13ryylq-2 wtu-33hvuz-3 wtu-4tuys3-4 wtu-8r66y1-5">
      <text class="wtu-3i3gs6-6 wtu-1pd9yl-7 wtu-aahijk-8">
        演示从功能页调用 App.ku.uvue 全局挂载的 &lt;up-toast ref="uToastRef" /&gt;，支持自定义消息、类型与轻提示反馈。
      </text>
    </view>

    <!-- 自定义输入内容 -->
    <view class="wtu-4tpahe-9">
      <text class="wtu-3i3gs6-6 wtu-b5uul9-a wtu-9szial-b">自定义 Toast 内容</text>
      <input
        v-model="customMsg"
        placeholder="请输入要提示的文字内容"
        class="wtu-16m9tth-c wtu-19clxu8-d wtu-6x9tj9-e wtu-y4lian-f wtu-33hvuz-3 wtu-4tuys3-4 wtu-f8q5hx-g wtu-1l8aqp8-h wtu-12c53hp-i"
      />
    </view>

    <!-- 按钮操作组 -->
    <view class="wtu-1yca3x4-j wtu-clldfh-k">
      <view
        class="wtu-bte5oa-l wtu-nw1q8k-m wtu-zsktp1-n wtu-13pz9mv-o wtu-1b6qia0-p wtu-1yca3x4-j wtu-clldfh-k wtu-xpmuf1-q wtu-164irp9-r"
        @click="showCustomToast"
      >
        <text class="wtu-pubmk8-s wtu-1tbrxcb-t wtu-bj9ji2-u">弹出自定义 Toast</text>
      </view>
      <view
        class="wtu-bte5oa-l wtu-zhey3t-v wtu-13pz9mv-o wtu-1b6qia0-p wtu-1yca3x4-j wtu-clldfh-k wtu-xpmuf1-q wtu-164irp9-r"
        @click="showSuccessToast"
      >
        <text class="wtu-pubmk8-s wtu-1tbrxcb-t wtu-bj9ji2-u">弹出成功 Toast</text>
      </view>
    </view>
  </Card>
</template>

<script setup lang="uts">
import Card from '../../basic/components/Card.uvue';
import { ref } from 'vue';
import { toast, toastSuccess } from '@/src/utils/toast';

const customMsg = ref<string>('来自 Function 功能页的 Toast 消息！');

function showCustomToast() {
  if (customMsg.value.trim() == '') {
    toast('请输入提示内容');
    return;
  }
  toast(customMsg.value);
}

function showSuccessToast() {
  toastSuccess('Function 页面全局 Toast 触发成功！');
}
</script>

