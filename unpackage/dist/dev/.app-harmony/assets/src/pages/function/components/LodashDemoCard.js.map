    <view class="wtu-99n919-0 wtu-15nin6-1 wtu-1ip6ax4-3 wtu-1379u88-4 wtu-1v5vx5i-5">
      <text class="wtu-wt9zgi-6 wtu-1u1vbk3-7 wtu-vhwil1-8 wtu-12p3ytc-9">4. 防抖函数与随机数 (debounce, random)</text>

      <view class="wtu-11fbh7u-n wtu-hehpb2-o wtu-20vb01-w wtu-1ukgctb-g">
        <view class="wtu-1a16q90-17">
          <text class="wtu-nlue1j-a wtu-g2bdc6-b">防抖点击触发次数 (400ms):</text>
          <text class="wtu-nlue1j-a wtu-cgohmy-18">连击时仅在停止 400ms 后加 1</text>
        </view>
        <text class="wtu-vf75qw-19 wtu-1u1vbk3-7 wtu-6l0vg0-1a">{{ debouncedCount }}</text>
      </view>

      <view class="wtu-zvxz19-i wtu-1hlaid0-j wtu-kkfitq-k wtu-l4ptrb-1b wtu-lfvf6n-m wtu-11fbh7u-n wtu-hehpb2-o wtu-ltxxn6-p wtu-1ukgctb-g" @click="handleDebounceClick">
