        <text class="wtu-nlue1j-a wtu-g2bdc6-b">_.kebabCase (短横线):</text>
        <text class="result-text wtu-wt9zgi-6 wtu-1u1vbk3-7 wtu-1a9i6pt-14 wtu-efn5x4-e" style="font-family: monospace;">{{ kebabCaseResult }}</text>
      </view>

