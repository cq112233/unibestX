    <view class="wtu-99n919-0 wtu-15nin6-1 wtu-kwjfx7-2 wtu-1ip6ax4-3 wtu-1379u88-4 wtu-1v5vx5i-5">
      <text class="wtu-wt9zgi-6 wtu-1u1vbk3-7 wtu-vhwil1-8 wtu-12p3ytc-9">3. 字符串修饰与格式化 (camelCase, kebabCase)</text>

      <view class="wtu-1ukgctb-g">
        <text class="wtu-nlue1j-a wtu-g2bdc6-b wtu-16b98e4-v">输入文本:</text>
        <input v-model="inputText" class="wtu-zvxz19-i wtu-1hlaid0-j wtu-11xru9i-10 wtu-ehidfg-11 wtu-1ip6ax4-3 wtu-1379u88-4 wtu-119kf4q-12 wtu-wt9zgi-6 wtu-vhwil1-8" placeholder="请输入待转换文本" />
      </view>

      <view class="wtu-12p3ytc-9">
        <text class="wtu-nlue1j-a wtu-g2bdc6-b">_.camelCase (驼峰):</text>
        <text class="result-text wtu-wt9zgi-6 wtu-1u1vbk3-7 wtu-en1iwp-13 wtu-efn5x4-e" style="font-family: monospace;">{{ camelCaseResult }}</text>
