    <!-- 2. 对象深拷贝与安全取值 (get, cloneDeep) -->
    <view class="wtu-99n919-0 wtu-15nin6-1 wtu-kwjfx7-2 wtu-1ip6ax4-3 wtu-1379u88-4 wtu-1v5vx5i-5">
