<template>
  <AppKu>

  <view class="wtu-1hohpe6-0 wtu-kfqmh9-1 wtu-tikv1r-2 wtu-ivlko1-3 wtu-nw53rz-4">
    <!-- 头部卡片：用户头像及状态 -->
    <view class="wtu-v9mcu4-5 wtu-4q8au6-6 wtu-4hefdc-7 wtu-8ywmhi-8 wtu-eogvvs-9 wtu-ugiijb-a wtu-1hohpe6-0 wtu-kfqmh9-1 wtu-tikv1r-2">
      <image class="wtu-1xovv6-b wtu-1h6ymxp-c wtu-152xqwk-d wtu-r07p60-e wtu-19juoov-f wtu-1ypllkc-g wtu-1q8anq5-h" :src="avatarUrl" />
      <text class="wtu-1fov80n-i wtu-58fnu4-j wtu-1c3ypac-k wtu-tminbx-l">
        {{ userStore.state.userInfo.username.length > 0 ? userStore.state.userInfo.username : '未登录用户' }}
      </text>
      <text v-if="userStore.state.userInfo.username.length > 0" class="wtu-1n331w6-m wtu-1ya1no3-n wtu-kjtkcs-o">
        {{ userStore.state.userInfo.nickname }}
      </text>
      <view class="wtu-1hohpe6-0 wtu-1pllh87-p">
        <text
          class="wtu-15s69u4-q wtu-jzjlp-r wtu-1vsb6g1-s wtu-w73263-t wtu-17lenqs-u wtu-j5499y-v"
          :class="tokenStore.hasValidLogin() ? 'wtu-1x8u93y-w wtu-1obvnxf-x' : 'wtu-11a9dql-y wtu-1ya1no3-n'"
        >
          {{ tokenStore.hasValidLogin() ? '已登录' : '未登录' }}
        </text>
      </view>
    </view>

    <!-- 信息区域：序列化数据展示 -->
    <view class="wtu-v9mcu4-5 wtu-4q8au6-6 wtu-4hefdc-7 wtu-zc1s4-z wtu-c4whgz-10 wtu-1hohpe6-0 wtu-kfqmh9-1">
      <view class="wtu-f24hak-11 wtu-1hohpe6-0 wtu-1pllh87-p">
        <text class="wtu-1dvngh7-12 wtu-4yhcom-13 wtu-wy5oxr-14">用户信息 (JSON)</text>
      </view>
      <view class="wtu-oegkbd-15 wtu-11a9dql-y wtu-kjtkcs-o" />
      <scroll-view class="wtu-1p4csuv-16 wtu-tcbx2t-17 wtu-1ahbmur-18 wtu-wpo3pd-19" direction="vertical">
        <text class="wtu-ysnhyx-1a wtu-1f6mdr3-1b wtu-6wgrlu-1c" style="font-family: monospace;">{{ userInfoJson }}</text>
      </scroll-view>
    </view>

    <!-- 按钮区域 -->
    <view class="wtu-v9mcu4-5 wtu-w39gum-1d wtu-1hohpe6-0 wtu-kfqmh9-1">
      <view v-if="tokenStore.hasValidLogin()" class="wtu-v9mcu4-5 wtu-8ijhou-1e wtu-tcbx2t-17 wtu-1l9wu4z-1f wtu-1hohpe6-0 wtu-1pllh87-p wtu-tikv1r-2 wtu-1rnqkyn-1g" @click="handleLogout">
        <text class="wtu-amc2mi-1h wtu-1n331w6-m wtu-58fnu4-j">退出登录</text>
      </view>
      <view v-else class="wtu-v9mcu4-5 wtu-8ijhou-1e wtu-tcbx2t-17 wtu-1y6dimz-1i wtu-1hohpe6-0 wtu-1pllh87-p wtu-tikv1r-2 wtu-1rnqkyn-1g" @click="handleLogin">
        <text class="wtu-amc2mi-1h wtu-1n331w6-m wtu-58fnu4-j">登录</text>
      </view>
    </view>
  </view>

  </AppKu>
</template>

<script setup vapor lang="uts">
import AppKu from '@/App.ku.uvue'
import { useTokenStore, useUserStore } from '../../store';
import { LOGIN_PAGE } from '../../router/config';
import { handleBackPressExit } from '@/src/utils/backPress';
import { setCurIdxByPath } from '@/src/tabbar/store';
;

onBackPress((options: OnBackPressOptions): boolean => {

  if (options.from == 'backbutton') {
    return handleBackPressExit();
  }

  return false;
});

const userStore = useUserStore();
const tokenStore = useTokenStore();

// 计算头像
const avatarUrl = computed((): string => {
  if (userStore.state.userInfo.avatar.length > 0) {
    return userStore.state.userInfo.avatar;
  }
  return '/static/logo.png';
});

// 序列化用户信息为 JSON
const userInfoJson = computed((): string => {
  const info = {
    userId: userStore.state.userInfo.userId,
    username: userStore.state.userInfo.username,
    nickname: userStore.state.userInfo.nickname,
    avatar: userStore.state.userInfo.avatar
  };
  return JSON.stringify(info, null, 2);
});

onShow(() => {
  uni.__f__('log','at src/pages/me/me.uvue:90','All storage keys:', uni.getStorageInfoSync().keys);
  uni.__f__('log','at src/pages/me/me.uvue:91','pinia:token:', uni.getStorageSync('pinia:token'));
  uni.__f__('log','at src/pages/me/me.uvue:92','pinia:user:', uni.getStorageSync('pinia:user'));
});

// 登录
function handleLogin() {
  uni.navigateTo({
    url: LOGIN_PAGE
  });
}

// 退出登录
function handleLogout() {
  uni.showModal({
    title: '提示',
    content: '确定要退出登录吗？',
    success: (res) => {
      if (res.confirm) {
        tokenStore.clearToken();
        userStore.clearUserInfo();
        uni.showToast({
          title: '退出登录成功',
          icon: 'success'
        });
        // 退出后跳回首页（me 页需要登录，不能停留）
        setTimeout(() => {
          const targetUrl = '/src/pages/index/index';
          setCurIdxByPath(targetUrl);
          uni.switchTab({ url: targetUrl });
        }, 0);
      }
    }
  });
}
</script>

