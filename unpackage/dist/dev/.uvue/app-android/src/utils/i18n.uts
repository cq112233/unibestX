import i18n from '../i18n/index.uts';
import { tabbarList } from '../tabbar/store.uts';
/**
 * 非 vue / uvue 文件使用 i18n 翻译
 * @param key 翻译的 key
 * @param named 命名参数
 */
export function t(key: string, named: UTSJSONObject | null = null): string {
    if (named != null) {
        return i18n.global.t(key, named);
    }
    return i18n.global.t(key);
}
/**
 * 获取 %xxx% 格式包装或普通 key 的多语言翻译文本
 * 例如：%basic.langTitle% 或 basic.langTitle
 * @param key 多语言 key
 */
export function getI18nText(key: string): string {
    let cleanKey = key;
    if (cleanKey.startsWith('%') && cleanKey.endsWith('%') && cleanKey.length > 2) {
        cleanKey = cleanKey.substring(1, cleanKey.length - 1);
    }
    return t(cleanKey, null);
}
/**
 * 设置原生 TabBar 各项的多语言文本 (设置 uni.setTabBarItem)
 */
export function setTabbarItem(): void {
    for (let i = 0; i < tabbarList.length; i++) {
        const item = tabbarList[i];
        const text = getI18nText(item.text);
        uni.setTabBarItem({
            index: i,
            text: text,
        } as SetTabBarItemOptions);
    }
}
/**
 * 设置原生/当前页面 NavigationBar (导航栏) 标题的多语言文本
 * @param titleKey 标题的多语言 key，支持 'basic.langTitle' 或 '%basic.langTitle%' 格式
 */
export function setNavigationBarTitle(titleKey: string): void {
    const title = getI18nText(titleKey);
    uni.setNavigationBarTitle({
        title: title,
    } as SetNavigationBarTitleOptions);
}
/**
 * 非 vue / uvue 文件中使用 i18n 测试示例
 */
export function testI18n(): void {
