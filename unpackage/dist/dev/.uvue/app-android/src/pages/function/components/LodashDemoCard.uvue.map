        <text class="wtu-nlue1j-a wtu-g2bdc6-b">_.get(obj, 'user.invalid.path', '安全兜底值'):</text>
        <text class="result-text wtu-wt9zgi-6 wtu-1u1vbk3-7 wtu-t30dgu-r wtu-efn5x4-e" style="font-family: monospace;">
          "{{ getFallbackResult }}"
        </text>
      </view>

      <view class="wtu-ie0kbi-s wtu-x0rgyb-t wtu-26he62-u" />

      <view class="wtu-12p3ytc-9">
        <text class="wtu-nlue1j-a wtu-g2bdc6-b wtu-16b98e4-v">深拷贝防污染对比 (点击修改深拷贝副本的值):</text>
        <view class="wtu-11fbh7u-n wtu-20vb01-w wtu-16b98e4-v">
          <text class="wtu-nlue1j-a wtu-trlwv5-q">原对象 age:</text>
          <text class="wtu-nlue1j-a wtu-1u1vbk3-7 wtu-12jpf2i-d">{{ rawObjAge }}</text>
        </view>
        <view class="wtu-11fbh7u-n wtu-20vb01-w wtu-12p3ytc-9">
          <text class="wtu-nlue1j-a wtu-trlwv5-q">副本对象 age:</text>
          <text class="wtu-nlue1j-a wtu-1u1vbk3-7 wtu-dvbist-x">{{ clonedObjAge }}</text>
        </view>
        <view class="wtu-zvxz19-i wtu-1hlaid0-j wtu-kkfitq-k wtu-15b9oe7-y wtu-lfvf6n-m wtu-11fbh7u-n wtu-hehpb2-o wtu-ltxxn6-p" @click="mutateClonedObj">
