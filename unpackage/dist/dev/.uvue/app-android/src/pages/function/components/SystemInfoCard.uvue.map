<template>
  <Card title="设备系统信息">
    <view class="wtu-oay3eq-0 wtu-xwpmb1-1 wtu-1f04jd2-2 wtu-yvwy5v-3 wtu-ydbv97-4 wtu-luxr69-5">
      <view class="wtu-2dnwdx-6 wtu-y6hc1g-7 wtu-fxzeik-8">
        <text class="wtu-1hz062s-9 wtu-2prjq9-a">手机品牌</text>
        <text class="wtu-1hz062s-9 wtu-10grseq-b wtu-14btyn8-c">{{ sysBrand !== '' ? sysBrand : '暂无数据' }}</text>
      </view>
      <view class="wtu-2dnwdx-6 wtu-y6hc1g-7 wtu-fxzeik-8">
        <text class="wtu-1hz062s-9 wtu-2prjq9-a">手机型号</text>
        <text class="wtu-1hz062s-9 wtu-10grseq-b wtu-14btyn8-c">{{ sysModel !== '' ? sysModel : '暂无数据' }}</text>
      </view>
      <view class="wtu-2dnwdx-6 wtu-y6hc1g-7 wtu-fxzeik-8">
        <text class="wtu-1hz062s-9 wtu-2prjq9-a">操作系统</text>
        <text class="wtu-1hz062s-9 wtu-10grseq-b wtu-14btyn8-c">{{ sysSystem !== '' ? sysSystem : '暂无数据' }}</text>
      </view>
      <view class="wtu-2dnwdx-6 wtu-y6hc1g-7">
        <text class="wtu-1hz062s-9 wtu-2prjq9-a">运行平台</text>
        <text class="wtu-1hz062s-9 wtu-10grseq-b wtu-14btyn8-c">{{ sysPlatform !== '' ? sysPlatform : '暂无数据' }}</text>
      </view>
    </view>
    <view class="wtu-1tlvelu-d wtu-xe6yl0-e wtu-79ydq7-f wtu-17j8w31-g wtu-o8ie9c-h wtu-2dnwdx-6 wtu-1ie67qt-i wtu-1d5n1t1-j" @click="fetchSystemInfo">
      <text class="wtu-tl526o-k wtu-1hz062s-9 wtu-10grseq-b">获取系统信息</text>
    </view>
  </Card>
</template>

<script setup lang="uts">
import Card from '../../basic/components/Card.uvue';
import { onMounted, ref } from 'vue';

const sysBrand = ref('');
const sysModel = ref('');
const sysSystem = ref('');
const sysPlatform = ref('');

function fetchSystemInfo() {
  try {
    const info = uni.getSystemInfoSync();
    sysBrand.value = info.brand ?? '';
    sysModel.value = info.model ?? '';
    sysSystem.value = info.system ?? '';
    sysPlatform.value = info.uniPlatform ?? '';
  }
  catch (err) {
    console.error(err);
  }
}

onMounted(() => {
  fetchSystemInfo();
});
</script>

