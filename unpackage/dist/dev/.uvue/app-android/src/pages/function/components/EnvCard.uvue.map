<template>
  <Card title="环境变量">
    <view class="rounded-12px p-16px border-width-1px border-style-solid border-color-[#e2e8f0]">
      <view class="wtu-1wn3kuh-0 wtu-x1ltc0-1 mb-10px">
        <text class="text-14px wtu-y0qx9p-2">应用名称</text>
        <text class="text-14px wtu-1xrmo7y-3 wtu-7t1zi1-4">{{ appTitle }}</text>
      </view>
      <view class="wtu-1wn3kuh-0 wtu-x1ltc0-1 mb-10px">
        <text class="text-14px wtu-y0qx9p-2">应用版本</text>
        <text class="text-14px wtu-1xrmo7y-3 wtu-7t1zi1-4">{{ appVersion }}</text>
      </view>
      <view class="wtu-1wn3kuh-0 wtu-x1ltc0-1 mb-10px">
        <text class="text-14px wtu-y0qx9p-2">编译环境</text>
        <text class="text-14px wtu-1xrmo7y-3" :style="{ color: envColor }">{{ envLabel }}</text>
      </view>
      <view class="wtu-1wn3kuh-0 wtu-x1ltc0-1 mb-10px">
        <text class="text-14px wtu-y0qx9p-2">环境标识</text>
        <text class="text-12px wtu-1a0szfl-5">{{ envTypeText }}</text>
      </view>
      <view class="wtu-1wn3kuh-0 wtu-x1ltc0-1">
        <text class="text-14px wtu-y0qx9p-2">接口地址</text>
        <text class="text-12px wtu-1a0szfl-5 wtu-10cqf12-6 ml-8px wtu-1exppl3-7">{{ apiBaseUrl }}</text>
      </view>
    </view>
  </Card>
</template>

<script setup lang="uts">
import Card from '../../basic/components/Card.uvue';
import { computed } from 'vue';

// 应用名称 / 版本（.env 公用配置，全端读取）
const appTitle: string = `${import.meta.env.VITE_APP_TITLE}`;
const appVersion: string = `${import.meta.env.VITE_APP_VERSION}`;

// 编译期环境识别（只读展示，运行期不支持切换）：
// 全端（App / H5 / 微信小程序）均支持读取 .env 的 VITE_ENV_TYPE（development / test / production），
// 与 src/http/request.uts 读取 VITE_SERVER_BASEURL 的方式一致
type EnvType = 'development' | 'test' | 'production';

const buildEnvType: string = `${import.meta.env.VITE_ENV_TYPE ?? ''}`;
const systemEnv: EnvType = buildEnvType == 'test' ? 'test' : (process.env.NODE_ENV == 'development' ? 'development' : 'production');

// 与 src/http/request.uts 保持一致的实际接口地址（全端读取 VITE_SERVER_BASEURL）
const apiBaseUrl: string = `${import.meta.env.VITE_SERVER_BASEURL ?? 'https://ukw0y1.laf.run'}`;
// 原始环境标识（用于核对当前构建产物属于哪个环境）
const envTypeText: string = systemEnv;

const envLabel = computed((): string => {
  if (systemEnv === 'test') {
    return '测试';
  }
  if (systemEnv === 'production') {
    return '生产';
  }
  return '开发';
});

const envColor = computed((): string => {
  if (systemEnv === 'test') {
    return '#f59e0b';
  }
  if (systemEnv === 'production') {
    return '#ef4444';
  }
  return '#10b981';
});
</script>

