  <Card title="时间日期操作 (lime-dayuts)">
    <!-- 实时时间与自定义格式化展示 -->
    <view class="wtu-4kmwrd-0 wtu-1jdh43a-1 wtu-dtibgf-2 wtu-1h5kt0c-3 wtu-4rnkc-4 wtu-11f339e-5">
      <text class="wtu-1iqtm2m-6 wtu-1oju4iv-7 wtu-115tbw1-8 wtu-c3b92s-9">实时高精度时钟 (更新于每一百毫秒)</text>
      <text class="wtu-110ukgw-a wtu-1oju4iv-7 wtu-i1z22m-b wtu-1mdi86u-c" style="font-family: monospace;">
        {{ currentFullTime }}
      </text>
      <text class="wtu-19je0nn-d wtu-1bwkk92-e">
        格式模板: YYYY-MM-DD HH:mm:ss.SSS dddd
      </text>
    </view>

    <!-- 日期加减偏移计算 -->
    <view class="wtu-4kmwrd-0 wtu-1jdh43a-1 wtu-dtibgf-2 wtu-1h5kt0c-3 wtu-4rnkc-4 wtu-11f339e-5">
      <text class="wtu-1iqtm2m-6 wtu-1oju4iv-7 wtu-115tbw1-8 wtu-136pgjf-f">日期偏移操作</text>

      <view class="wtu-av7f06-g wtu-484t6y-h wtu-avfu85-i wtu-136pgjf-f">
        <text class="wtu-2fc1j5-j wtu-v9onga-k">当前偏移天数:</text>
        <text class="wtu-1r68wxj-l wtu-1oju4iv-7 wtu-lavu4m-m">{{ offsetDays > 0 ? '+' : '' }}{{ offsetDays }} 天</text>
      </view>

      <view class="wtu-av7f06-g wtu-avfu85-i wtu-136pgjf-f">
        <view class="wtu-1qpd44h-n wtu-1oyi3ms-o">
          <view class="wtu-173zvjd-p wtu-t2tdnc-q wtu-1qs4qj6-r wtu-16xqvqb-s wtu-1jd3mn7-t wtu-av7f06-g wtu-484t6y-h wtu-7vso4e-u" @click="adjustOffset(-7)">
            <text class="wtu-ee1xhe-v wtu-19je0nn-d wtu-1oju4iv-7">-7 天</text>
          </view>
        </view>
        <view class="wtu-1qpd44h-n wtu-1oyi3ms-o">
          <view class="wtu-173zvjd-p wtu-t2tdnc-q wtu-1qs4qj6-r wtu-16xqvqb-s wtu-1jd3mn7-t wtu-av7f06-g wtu-484t6y-h wtu-7vso4e-u" @click="adjustOffset(-1)">
            <text class="wtu-ee1xhe-v wtu-19je0nn-d wtu-1oju4iv-7">-1 天</text>
          </view>
        </view>
        <view class="wtu-1qpd44h-n wtu-1oyi3ms-o">
          <view class="wtu-173zvjd-p wtu-t2tdnc-q wtu-1qs4qj6-r wtu-16xqvqb-s wtu-1jd3mn7-t wtu-av7f06-g wtu-484t6y-h wtu-7vso4e-u" @click="adjustOffset(1)">
            <text class="wtu-ee1xhe-v wtu-19je0nn-d wtu-1oju4iv-7">+1 天</text>
