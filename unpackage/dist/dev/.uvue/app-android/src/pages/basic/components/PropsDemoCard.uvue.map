<template>
  <Card title="父子组件传参 & 具名插槽演示">
    <!-- 父组件状态展示面板 -->
    <view class="wtu-vxgnz7-0 wtu-bzagc8-1 wtu-b66ka1-2 wtu-74ncny-3 wtu-1owovkx-4 wtu-1pdwtsl-5 wtu-cwe6v6-6">
      <text class="wtu-1a5l072-7 wtu-sv7fhw-8 wtu-44jmxl-9 wtu-bhsfe3-a">👨‍👩‍👧 父组件状态管理面板</text>

      <view class="wtu-1qcvxlr-b wtu-i6zy5z-c wtu-1vkc6z9-d">
        <text class="wtu-1hmoe0k-e wtu-1581zln-f">父组件 Count 变量: </text>
        <text class="wtu-1a5l072-7 wtu-sv7fhw-8 wtu-1cwqag0-g wtu-1cbwlqp-h">{{ parentCount }}</text>
      </view>

      <view class="wtu-1qcvxlr-b wtu-i6zy5z-c wtu-hqsngi-i">
        <text class="wtu-1hmoe0k-e wtu-1581zln-f">接收到的子组件消息: </text>
        <text class="wtu-1hmoe0k-e wtu-sv7fhw-8 wtu-cj9lbh-j wtu-1cbwlqp-h">{{ childMessage }}</text>
      </view>

      <!-- 父组件主动修改数据操作组 -->
      <view class="wtu-1qcvxlr-b wtu-i6zy5z-c">
        <view class="wtu-1t9ug01-k wtu-1qt2m0f-l wtu-hvwz4r-m wtu-bf75hz-n wtu-1qcvxlr-b wtu-i6zy5z-c wtu-19aj3kn-o wtu-6ebfap-p" @click="addFiveFromParent">
          <text class="wtu-1c2l3ni-q wtu-1hmoe0k-e">父组件直接 Count + 5</text>
        </view>
        <view class="wtu-1h73awj-r wtu-1qt2m0f-l wtu-hvwz4r-m wtu-bf75hz-n wtu-1qcvxlr-b wtu-i6zy5z-c wtu-19aj3kn-o" @click="resetParent">
          <text class="wtu-1c2l3ni-q wtu-1hmoe0k-e">父组件重置状态</text>
        </view>
      </view>
    </view>

    <!-- 子组件嵌套调用区 -->
    <ChildDemoBox
      title="组件通信演示子节点"
      :count="parentCount"
      :tags="tagList"
      @add="onChildAdd"
      @reset="onChildReset"
      @send-msg="onChildSendMsg"
    >
      <!-- 1. 具名头部插槽 #header -->
      <template #header>
        <view class="wtu-1qcvxlr-b wtu-i6zy5z-c wtu-16203my-s">
          <text class="wtu-1a5l072-7 wtu-sv7fhw-8 wtu-161zm7w-t">🏷️ 父组件填入的具名 Header 插槽</text>
          <text class="wtu-1j9rfuf-u wtu-1581zln-f wtu-v9l0kh-v wtu-zb8dsk-w wtu-1y4fkff-x wtu-1jbz86x-y">自定义 Header</text>
        </view>
      </template>

      <!-- 2. 具名传参/作用域插槽 #itemSlot (从子组件接收 item & index) -->
      <template #itemSlot="{ item, index }">
        <view class="wtu-1qcvxlr-b wtu-i6zy5z-c wtu-1ue7bt4-z wtu-1qt2m0f-l wtu-1932lzo-10 wtu-1owovkx-4 wtu-1pdwtsl-5 wtu-16vqpiu-11">
          <text class="wtu-1j9rfuf-u wtu-sv7fhw-8 wtu-1gdtqyh-12 wtu-1ys92t7-13">#{{ (index as number) + 1 }}</text>
          <text class="wtu-1hmoe0k-e wtu-165ep59-14 wtu-1nu791o-15">{{ item }}</text>
          <text class="wtu-1sh719e-16 wtu-1qit6r8-17 wtu-1aizezg-18">具名Slot传参: {{ item }}</text>
        </view>
      </template>

      <!-- 3. 具名底部插槽 #footer -->
      <template #footer>
        <view class="wtu-1qcvxlr-b wtu-i6zy5z-c wtu-16203my-s wtu-1y4fkff-x">
          <text class="wtu-1hmoe0k-e wtu-ntizu3-19">📌 父组件填入的具名 Footer 插槽</text>
          <text class="wtu-1j9rfuf-u wtu-cj9lbh-j wtu-5777z3-1a wtu-zb8dsk-w wtu-1y4fkff-x wtu-1jbz86x-y wtu-1nu791o-15">双向通信验证成功</text>
        </view>
      </template>
    </ChildDemoBox>
  </Card>
</template>

<script setup lang="uts">
import { ref } from 'vue';
import Card from './Card.uvue';
import ChildDemoBox from './ChildDemoBox.uvue';

const parentCount = ref<number>(10);
const childMessage = ref<string>('暂无子组件消息');
const tagList = ref<Array<string>>(['响应式 Props 传递', 'Emits 事件监听与回传', '具名 Header/Footer 插槽', '具名 Slot 作用域传参']);

function onChildAdd(delta: number) {
  parentCount.value += delta;
}

function onChildReset() {
  parentCount.value = 0;
  childMessage.value = '已被子组件重置为 0';
}

function onChildSendMsg(msg: string) {
  childMessage.value = msg;
}

function addFiveFromParent() {
  parentCount.value += 5;
}

function resetParent() {
  parentCount.value = 10;
  childMessage.value = '已重置为初始状态';
}
</script>

