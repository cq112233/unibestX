<template>
  <view class="wtu-gcabbq-0 rounded-12px p-14px border-width-1px border-style-solid border-color-[#cbd5e1]">
    <!-- 1. 具名插槽：头部 -->
    <view class="mb-10px border-b-width-1px border-b-style-solid border-b-color-[#cbd5e1] pb-8px">
      <slot name="header">
        <!-- 具名插槽默认内容 -->
        <text class="text-14px wtu-1nivbe9-1 wtu-15nsgd4-2">📦 {{ title }}（默认 Header）</text>
      </slot>
    </view>

    <!-- 2. 父传子 Props 展示区域 -->
    <view class="mb-12px wtu-182oteh-3 rounded-8px p-10px">
      <text class="text-12px wtu-1nivbe9-1 wtu-c3ez2v-4 mb-4px">【父传子 Props 动态接收】</text>
      <view class="wtu-x7nkyg-5 wtu-ix6v4k-6">
        <text class="text-12px wtu-grng8o-7">父组件传递的 Count: </text>
        <text class="text-14px wtu-1nivbe9-1 wtu-18ekrle-8 ml-6px">{{ count }}</text>
      </view>
    </view>

    <!-- 3. 具名传参插槽 / 作用域插槽展示 -->
    <view class="mb-12px wtu-182oteh-3 rounded-8px p-10px">
      <text class="text-12px wtu-1nivbe9-1 wtu-c3ez2v-4 mb-6px">【具名作用域插槽 (Slot 向父组件传参)】</text>
      <view v-for="(item, index) in tags" :key="index" class="mb-6px">
        <!-- 具名传参插槽 itemSlot：向父组件暴露 item 和 index 参数 -->
        <slot name="itemSlot" :item="item" :index="index">
          <!-- 默认渲染逻辑 -->
          <view class="wtu-zipktt-9 rounded-4px p-6px">
            <text class="text-12px wtu-grng8o-7">Tag {{ index + 1 }}: {{ item }}</text>
          </view>
        </slot>
      </view>
    </view>

    <!-- 4. 子传父 Emits 触发按钮区域 -->
    <view class="mb-10px wtu-182oteh-3 rounded-8px p-10px">
      <text class="text-12px wtu-1nivbe9-1 wtu-c3ez2v-4 mb-8px">【子传父 Emits 事件触发】</text>
      <view class="wtu-x7nkyg-5 wtu-jpge2z-a wtu-ix6v4k-6 mb-8px">
        <view class="wtu-812ws7-b wtu-s60y7a-c rounded-6px h-32px wtu-x7nkyg-5 wtu-ix6v4k-6 wtu-1pd1px4-d mr-6px" @click="handleAdd">
          <text class="wtu-ih0clp-e text-12px">触发 Count + 1</text>
        </view>
        <view class="wtu-812ws7-b wtu-4dipnu-f rounded-6px h-32px wtu-x7nkyg-5 wtu-ix6v4k-6 wtu-1pd1px4-d ml-6px" @click="handleReset">
          <text class="wtu-ih0clp-e text-12px">触发 重置事件</text>
        </view>
      </view>

      <view class="wtu-zipktt-9 rounded-6px p-8px border-width-1px border-style-solid border-color-[#e2e8f0] wtu-x7nkyg-5 wtu-ix6v4k-6 wtu-jpge2z-a">
        <input v-model="inputMsg" placeholder="输入要送回父组件的消息" class="text-12px wtu-812ws7-b h-30px px-8px wtu-182oteh-3 rounded-4px border-width-1px border-style-solid border-color-[#cbd5e1]" />
        <view class="wtu-aufsc6-g rounded-6px h-30px px-10px wtu-x7nkyg-5 wtu-ix6v4k-6 wtu-1pd1px4-d ml-8px" @click="handleSendMsg">
          <text class="wtu-ih0clp-e text-12px">发送给父组件</text>
        </view>
      </view>
    </view>

    <!-- 5. 具名插槽：底部 -->
    <view class="pt-6px border-t-width-1px border-t-style-solid border-t-color-[#cbd5e1]">
      <slot name="footer">
        <text class="text-11px wtu-1xb3h6w-h">（默认 Footer）</text>
      </slot>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue';
import type { PropType } from 'vue';

defineProps({
  title: {
    type: String,
    default: '通信子组件'
  },
  count: {
    type: Number,
    default: 0
  },
  tags: {
    type: Array as PropType<Array<string>>,
    default: (): Array<string> => ['Vue3', 'uni-app X', 'UTS'] as Array<string>
  }
});

const emit = defineEmits(['add', 'reset', 'send-msg']);

const inputMsg = ref('Hello Parent from Child!');

function handleAdd() {
  emit('add', 1);
}

function handleReset() {
  emit('reset');
}

function handleSendMsg() {
  if (inputMsg.value.trim() == '') {
    uni.showToast({
      title: '请输入消息内容',
      icon: 'none'
    });
    return;
  }
  emit('send-msg', inputMsg.value);
  uni.showToast({
    title: '消息已发送',
    icon: 'success'
  });
}
</script>

