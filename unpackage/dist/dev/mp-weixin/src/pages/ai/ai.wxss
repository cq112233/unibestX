page {
  height: 100%;
  display: flex;
}
.page-root[class] {
  height: 100%;
  display: flex;
  flex-direction: column;
}
.footer-fixed[class] {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
}
.msg-row-start[class] {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}
.msg-row-end[class] {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: flex-end;
}
.msg-content-left[class] {
  display: flex;
  flex-direction: column;

  max-width: 70%;
}
.msg-content-right[class] {
  display: flex;
  flex-direction: column;
  align-items: flex-end;

  max-width: 70%;
}
