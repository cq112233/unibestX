.tabbar-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 1;
  background-color: transparent;
  flex-direction: column;
}

/* 【底板层】覆盖「固定高度 + 安全区」的白色底板，绑定高度动态设定 */
.tabbar-bg {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  border-top-width: 1rpx;
  border-top-style: solid;
  z-index: 1;
}

