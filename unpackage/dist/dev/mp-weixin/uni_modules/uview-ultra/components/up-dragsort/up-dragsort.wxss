/* 覆盖 uview-ultra 的 SCSS 变量，使其编译为 CSS 变量 */
.up-dragsort.data-v-c77c530d {
  width: 100%;
  height: auto;
}
.up-dragsort-area.data-v-c77c530d {
  width: 100%;
  height: 100%;
  position: relative;
}
.up-dragsort-item.data-v-c77c530d {
  position: absolute;
  width: 100%;
  /* 仅在 Web/小程序端保留过渡动画；App 端（尤其 iOS）transition 不支持 box-shadow，
     原生过渡会卡在起始帧导致拖拽结束后阴影残留 */
  transition: box-shadow 0.45s ease-out;
}
.dragging.data-v-c77c530d {
  z-index: 1000;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
}
.up-dragsort-item-content.data-v-c77c530d {
  position: relative;
  padding: 0;
  box-sizing: border-box;
}
.ui-dragSort-item-handler--enabled.data-v-c77c530d {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}
.ui-dragSort-item-handler--left.data-v-c77c530d {
  right: auto;
  left: 0;
}
.up-dragsort-item--vertical.data-v-c77c530d {
  height: auto;
}
.up-dragsort--horizontal .up-dragsort-area.data-v-c77c530d {
  display: flex;
  white-space: nowrap;
}
.up-dragsort-item--horizontal.data-v-c77c530d {
  width: auto;
  height: auto;
}
.up-dragsort-item--all.data-v-c77c530d {
  width: auto;
  height: auto;
}