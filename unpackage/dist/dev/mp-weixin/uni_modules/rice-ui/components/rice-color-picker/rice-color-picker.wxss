.rice-color-picker.data-v-7188e107 {
  padding: 12px;
  border-top-left-radius: 12px;
  border-top-right-radius: 12px;
  background-color: var(--rice-color-picker-background);
}
.rice-color-picker__panel.data-v-7188e107 {
  position: relative;
  height: 150px;
  border-radius: 4px;
  margin-bottom: 16px;
}
.rice-color-picker__panel--base.data-v-7188e107, .rice-color-picker__panel--white.data-v-7188e107, .rice-color-picker__panel--black.data-v-7188e107 {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}
.rice-color-picker__panel--white.data-v-7188e107 {
  background-image: linear-gradient(to right, white, rgba(255, 255, 255, 0));
}
.rice-color-picker__panel--black.data-v-7188e107 {
  background-image: linear-gradient(to top, black, rgba(0, 0, 0, 0));
}
.rice-color-picker__panel--cursor.data-v-7188e107 {
  position: absolute;
  width: 20px;
  height: 20px;
  transform: translate(-50%, -50%);
  border-radius: 999px;
  border: 2px solid #fff;
}
.rice-color-picker__slider.data-v-7188e107 {
  flex-direction: row;
  align-items: center;
}
.rice-color-picker__slider__preview.data-v-7188e107 {
  height: 36px;
