.rice-notice-bar.data-v-2bbdd2d2 {
  position: relative;
  flex-direction: row;
  align-items: center;
  height: 45px;
  padding: 0 16px;
}
.rice-notice-bar--primary.data-v-2bbdd2d2 {
  background-color: var(--rice-primary-color-1);
  color: var(--rice-primary-color);
}
.rice-notice-bar--warning.data-v-2bbdd2d2 {
  background-color: var(--rice-warning-color-1);
  color: var(--rice-warning-color);
}
.rice-notice-bar--success.data-v-2bbdd2d2 {
  background-color: var(--rice-success-color-1);
  color: var(--rice-success-color);
}
.rice-notice-bar--error.data-v-2bbdd2d2 {
  background-color: var(--rice-error-color-1);
  color: var(--rice-error-color);
}
.rice-notice-bar__wrapper.data-v-2bbdd2d2 {
  flex: 1;
  flex-direction: row;
  align-items: center;
  height: 100%;
}
.rice-notice-bar__content.data-v-2bbdd2d2 {
  position: absolute;
  white-space: nowrap;
  transform: translateX(0px);
  transition-property: transform;
  transition-timing-function: linear;
  font-size: 15px;
}
.rice-notice-bar__content--wrapable.data-v-2bbdd2d2 {
  position: relative;
  white-space: normal;
  word-wrap: break-word;
  max-width: 100%;
}
.rice-notice-bar__content--ellipsis.data-v-2bbdd2d2 {
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 100%;
}
.rice-notice-bar--wrapable.data-v-2bbdd2d2 {
  height: auto;
  padding: 14px 16px;
}