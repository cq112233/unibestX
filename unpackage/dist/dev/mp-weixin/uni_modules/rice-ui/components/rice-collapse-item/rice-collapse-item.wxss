.rice-collapse-item.data-v-ee1d9933 {
  background-color: var(--rice-collapse-background);
}
.rice-collapse-item__header.data-v-ee1d9933 {
  position: relative;
  justify-content: space-between;
  align-items: center;
  flex-direction: row;
  padding: 14px 16px;
}
.rice-collapse-item__header--border.data-v-ee1d9933 {
  position: absolute;
  left: 0;
  bottom: 0;
  height: 1px;
  width: 100%;
  transform: scale(1, 0.5);
  background-color: var(--rice-border-color);
}
.rice-collapse-item__title.data-v-ee1d9933 {
  flex: 1;
  padding-right: 2px;
}
.rice-collapse-item__title--text.data-v-ee1d9933 {
  color: var(--rice-text-color);
  font-size: 15px;
  word-wrap: break-word;
}
.rice-collapse-item__title--disabled.data-v-ee1d9933 {
  color: var(--rice-text-color-3);
}
.rice-collapse-item__value.data-v-ee1d9933 {
  flex: 1;
  padding-right: 2px;
  text-align: right;
  word-break: break-all;
}
.rice-collapse-item__value--text.data-v-ee1d9933 {
  color: var(--rice-text-color-2);
  font-size: 15px;
  text-align: right;
  word-wrap: break-word;
}
.rice-collapse-item__value--disabled.data-v-ee1d9933 {
  color: var(--rice-text-color-3);
}
.rice-collapse-item__wrapper.data-v-ee1d9933 {
  position: relative;
  height: 0px;
  transition-property: height;
  transition-timing-function: ease-in-out;
  will-change: height;
}
.rice-collapse-item__content.data-v-ee1d9933 {
  position: relative;
  padding: 12px 16px;
}
.rice-collapse-item__content--text.data-v-ee1d9933 {
  color: var(--rice-text-color-2);
  font-size: 14px;
  word-wrap: break-word;
  word-break: break-all;
}
.rice-collapse-item--border.data-v-ee1d9933 {
  position: absolute;
  bottom: 0;
  left: 0;
  height: 1px;
  transform: scale(1, 0.5);
  width: 100%;
  background-color: var(--rice-border-color);
  opacity: 0;
  transition: opacity 0.3s;
}
.rice-collapse-item--border--show.data-v-ee1d9933 {
  opacity: 1;
}
.rice-collapse-item--hover.data-v-ee1d9933 {
  background-color: var(--rice-hover-color);
}