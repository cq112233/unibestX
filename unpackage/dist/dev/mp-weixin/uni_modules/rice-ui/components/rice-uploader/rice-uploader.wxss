.rice-uploader.data-v-087e45b0 {
  position: relative;
  flex-direction: row;
  flex-wrap: wrap;
}
.rice-uploader__preview.data-v-087e45b0 {
  height: 80px;
  width: 80px;
  border-radius: 4px;
  background-color: var(--rice-uploader-background);
  margin: 0 8px 8px 0;
  position: relative;
}
.rice-uploader__preview__image.data-v-087e45b0 {
  width: 100%;
  height: 100%;
}
.rice-uploader__preview__file.data-v-087e45b0 {
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
}
.rice-uploader__preview__play.data-v-087e45b0 {
  position: absolute;
  z-index: 1;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
}
.rice-uploader__preview__text.data-v-087e45b0 {
  width: 100%;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: var(--rice-text-color-2);
  font-size: 12px;
  text-align: center;
}
.rice-uploader__item.data-v-087e45b0 {
  height: 80px;
  width: 80px;
  border-radius: 4px;
  background-color: var(--rice-uploader-background);
  margin: 0 8px 8px 0;
  align-items: center;
  justify-content: center;
}
.rice-uploader__item__text.data-v-087e45b0 {
  color: var(--rice-text-color-2);
  font-size: 12px;
}
.rice-uploader__status.data-v-087e45b0 {
  position: absolute;
  z-index: 2;
  align-items: center;
  justify-content: center;
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: rgba(0, 0, 0, 0.4);
  padding: 0 2px;
}
.rice-uploader__status__text.data-v-087e45b0 {
  color: #fff;
  font-size: 12px;
  margin-top: 4px;
  text-align: center;
  word-break: break-all;
}
.rice-uploader__success.data-v-087e45b0, .rice-uploader__delete.data-v-087e45b0 {
  position: absolute;
  z-index: 3;
  right: 0;
  align-items: center;
  justify-content: center;
  height: 18px;
  width: 18px;
}
.rice-uploader__success.data-v-087e45b0 {
  bottom: 0;
  background-color: var(--rice-success-color);
  border-top-left-radius: 6px;
}
.rice-uploader__delete.data-v-087e45b0 {
  top: 0;
  background-color: rgba(0, 0, 0, 0.4);
  border-bottom-left-radius: 6px;
}
.rice-uploader--disabled.data-v-087e45b0 {
  opacity: 0.6;
}