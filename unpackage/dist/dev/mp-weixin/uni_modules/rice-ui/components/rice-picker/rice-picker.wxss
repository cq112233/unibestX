.rice-picker.data-v-1a2696a4 {
  position: relative;
  background-color: var(--rice-picker-background);
}
.rice-picker--popup.data-v-1a2696a4 {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  border-radius: 12px 12px 0 0;
  transition-property: transform;
  transform: translateY(100%);
}
.rice-picker__top.data-v-1a2696a4 {
  position: relative;
  flex-direction: row;
  height: 48px;
  align-items: center;
  justify-content: space-between;
}
.rice-picker__title.data-v-1a2696a4 {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  max-width: 50%;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 16px;
  color: var(--rice-text-color);
  font-weight: bold;
}
.rice-picker__text.data-v-1a2696a4 {
  width: 100%;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
  color: var(--rice-text-color);
  font-size: 16px;
}
.rice-picker__text--disabled.data-v-1a2696a4 {
  color: var(--rice-picker-disabled-text-color);
}
.rice-picker--padding-top.data-v-1a2696a4 {
  padding-top: 16px;
}
.rice-picker__cancel.data-v-1a2696a4, .rice-picker__confirm.data-v-1a2696a4 {
  padding: 5px 16px;
  font-size: 15px;
}
.rice-picker__cancel.data-v-1a2696a4 {
  color: var(--rice-text-color-2);
}
.rice-picker__confirm.data-v-1a2696a4 {
  color: var(--rice-primary-color);
}
.rice-picker__bottom.data-v-1a2696a4 {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 16px;
}
.rice-picker__empty.data-v-1a2696a4 {
  padding: 0 16px;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
}
.rice-picker__empty__text.data-v-1a2696a4 {
  text-align: center;
  font-size: 15px;
  color: var(--rice-text-color-2);
}
.rice-picker__loading.data-v-1a2696a4 {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9;
  align-items: center;
  justify-content: center;
  background-color: var(--rice-picker-loading-background);
}
.rice-picker--loading.data-v-1a2696a4 {
  width: 24px;
  height: 24px;
  border-color: #1989fa;
}