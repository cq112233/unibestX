.rice-signature__wrapper.data-v-295a4f22 {
  position: relative;
  width: 100%;
  height: 200px;
  background-color: var(--rice-signature-background);
  border-radius: 8px;
  border: 1px solid var(--rice-signature-border-color);
}
.rice-signature__canvas.data-v-295a4f22 {
  position: relative;
  z-index: 9;
  width: 100%;
  height: 100%;
}
.rice-signature__tips.data-v-295a4f22 {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  width: 100%;
  transform: translateY(-50%);
  pointer-events: none;
  z-index: 10;
  text-align: center;
}
.rice-signature__tips__text.data-v-295a4f22 {
  font-weight: bold;
  text-align: center;
  letter-spacing: 3;
  font-size: 28px;
  color: rgba(204, 204, 204, 0.3);
}
.rice-signature__footer.data-v-295a4f22 {
  width: 100%;
  flex-direction: row;
  justify-content: flex-end;
  margin-top: 10px;
}
.rice-signature__footer__btn.data-v-295a4f22 {
  margin: 0 5px;
