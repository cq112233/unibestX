.rice-back-top.data-v-f88d1ec2 {
  position: fixed;
  align-items: center;
  justify-content: center;
  opacity: 1;
  z-index: 998;
  transition-property: transform, opacity;
  transition-duration: 0.3s;
  transition-timing-function: cubic-bezier(0.25, 0.8, 0.5, 1);
  border: 1px solid var(--rice-border-color);
  opacity: 0;
  bottom: calc(var(--uni-safe-area-inset-bottom) + 100px);
  right: calc(var(--uni-safe-area-inset-right) + 20px);
  color: var(--rice-text-color);
  background-color: var(--rice-back-top-background);
}
.rice-back-top--round.data-v-f88d1ec2 {
  border-radius: 999px;
  right: calc(var(--uni-safe-area-inset-right) + 20px);
  height: 48px;
  width: 48px;
}
.rice-back-top--half-round.data-v-f88d1ec2 {
  flex-direction: row;
  right: 0;
  width: 64px;
  height: 40px;
  border-radius: 999px 0 0 999px;
}
.rice-back-top--half-round__text.data-v-f88d1ec2 {
  width: 25px;
  margin-left: 2px;
}
.rice-back-top--zoom.data-v-f88d1ec2 {
  transform: scale(0);
}
.rice-back-top--show.data-v-f88d1ec2 {
  transform: scale(1);
  opacity: 1;
}
.rice-back-top__text.data-v-f88d1ec2 {
  color: var(--rice-text-color);
  font-size: 10px;
}