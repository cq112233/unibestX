.rice-cascader.data-v-3fda1236 {
  position: relative;
  background-color: var(--rice-cascader-background);
  height: 480px;
}
.rice-cascader--popup.data-v-3fda1236 {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  border-radius: 12px 12px 0 0;
  transition-property: transform;
  transform: translateY(100%);
}
.rice-cascader__header.data-v-3fda1236 {
  position: relative;
  height: 48px;
  align-items: center;
  justify-content: center;
  padding: 0 16px;
}
.rice-cascader__header__title.data-v-3fda1236 {
  font-size: 18px;
  font-weight: bold;
  color: var(--rice-text-color);
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 100%;
}
.rice-cascader__header__title--left.data-v-3fda1236 {
  text-align: left;
}
.rice-cascader__swiper.data-v-3fda1236 {
  flex: 1;
}
.rice-cascader__swiper__item.data-v-3fda1236 {
  height: 100%;
}
.rice-cascader__list.data-v-3fda1236 {
  flex: 1;
}
.rice-cascader__option.data-v-3fda1236 {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 10px 16px;
}
.rice-cascader__option__text.data-v-3fda1236 {
  font-size: 16px;
  color: var(--rice-text-color);
}
.rice-cascader__option__text--disabled.data-v-3fda1236 {
  color: var(--rice-cascader-disabled-text-color);
}
.rice-cascader__option--border.data-v-3fda1236 {
  position: relative;
}
.rice-cascader__option--border.data-v-3fda1236::after {
  content: "";
  position: absolute;
  box-sizing: border-box;
  pointer-events: none;
  left: 0;
  right: 0;
  bottom: 0;
  border-bottom: 1px solid var(--rice-border-color);
  transform: scaleY(0.5);
}
.rice-cascader__option--first.data-v-3fda1236 {
  padding-top: 20px;
}
