.rice-stepper.data-v-9c9cdab4 {
  flex-direction: row;
}
.rice-stepper__input.data-v-9c9cdab4 {
  box-sizing: border-box;
  text-align: center;
  margin: 0 2px;
  height: 30px;
  width: 36px;
  color: var(--rice-text-color);
  background-color: var(--rice-stepper-background);
}
.rice-stepper__input--round.data-v-9c9cdab4 {
  background-color: transparent;
}
.rice-stepper__input--outline.data-v-9c9cdab4 {
  margin: 0px;
  border-top: 1px solid var(--rice-stepper-background);
  border-bottom: 1px solid var(--rice-stepper-background);
  background-color: transparent;
}
.rice-stepper__minus.data-v-9c9cdab4, .rice-stepper__plus.data-v-9c9cdab4 {
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  height: 30px;
  width: 30px;
  background-color: var(--rice-stepper-background);
}
.rice-stepper__minus--disabled.data-v-9c9cdab4, .rice-stepper__plus--disabled.data-v-9c9cdab4 {
  opacity: 0.6;
}
.rice-stepper__minus--outline.data-v-9c9cdab4, .rice-stepper__plus--outline.data-v-9c9cdab4 {
  border: 1px solid var(--rice-stepper-background);
  background-color: transparent;
}
.rice-stepper__minus.data-v-9c9cdab4 {
  border-radius: 4px 0 0 4px;
}
.rice-stepper__minus--round.data-v-9c9cdab4 {
  border-radius: 999px;
  border: 1px solid var(--rice-primary-color);
  background-color: transparent;
}
.rice-stepper__plus.data-v-9c9cdab4 {
  border-radius: 0 4px 4px 0;
}
.rice-stepper__plus--round.data-v-9c9cdab4 {
  border-radius: 999px;
  border: 1px solid var(--rice-primary-color);
  background-color: var(--rice-primary-color);
}
.rice-stepper--outline.data-v-9c9cdab4 {
  border-radius: 4px;
}
.rice-stepper--disabled.data-v-9c9cdab4 {
  opacity: 0.6;
}