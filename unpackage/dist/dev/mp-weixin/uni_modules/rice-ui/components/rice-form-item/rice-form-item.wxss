.rice-form-item.data-v-2151614f {
  padding: 15px 0;
}
.rice-form-item__inner.data-v-2151614f {
  flex-direction: row;
}
.rice-form-item__inner--top.data-v-2151614f {
  flex-direction: column;
}
.rice-form-item__label.data-v-2151614f {
  flex-direction: row;
  align-items: center;
  padding-right: 12px;
}
.rice-form-item__label__text.data-v-2151614f {
  flex: 0 1 auto;
  font-size: 15px;
  color: var(--rice-text-color);
}
.rice-form-item__label--top.data-v-2151614f {
  margin-bottom: 8px;
}
.rice-form-item__label--right.data-v-2151614f {
  justify-content: flex-end;
}
.rice-form-item__wrapper.data-v-2151614f {
  flex: 1;
  flex-direction: row;
  align-items: center;
}
.rice-form-item__content.data-v-2151614f {
  flex: 1;
}
.rice-form-item__error.data-v-2151614f {
  margin-top: 5px;
}
.rice-form-item__error__text.data-v-2151614f {
  color: var(--rice-form-error-color);
  font-size: 12px;
  word-break: break-all;
}
.rice-form-item--required.data-v-2151614f {
  color: var(--rice-form-error-color);
  font-size: 15px;
}
.rice-form-item--border.data-v-2151614f {
  position: relative;
}
.rice-form-item--border.data-v-2151614f::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  border-bottom: 1px solid var(--rice-form-item-border);
  transform: scale(1, 0.5);
}
.rice-form-item--border--error.data-v-2151614f {
  position: relative;
}
.rice-form-item--border--error.data-v-2151614f::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  border-bottom: 1px solid var(--rice-form-error-color);
  transform: scale(1, 0.5);
}