.rice-calendar.data-v-9a99c562 {
  background-color: var(--rice-calendar-background);
}
.rice-calendar--popup.data-v-9a99c562 {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  border-radius: 12px 12px 0 0;
  transition-property: transform;
  transform: translateY(100%);
}
.rice-calendar__title.data-v-9a99c562 {
  position: relative;
  height: 48px;
  align-items: center;
  justify-content: center;
  padding: 0 16px;
}
.rice-calendar__title__text.data-v-9a99c562 {
  padding: 8px 16px;
  font-size: 16px;
  font-weight: bold;
  color: var(--rice-text-color);
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 100%;
}
.rice-calendar__switch.data-v-9a99c562 {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 12px;
}
.rice-calendar__switch__action.data-v-9a99c562 {
  flex-direction: row;
}
.rice-calendar__switch__text.data-v-9a99c562 {
  color: var(--rice-text-color);
  font-size: 14px;
  font-weight: bold;
  flex: 1;
  text-align: center;
}
.rice-calendar__header.data-v-9a99c562 {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 46px;
  border-bottom: 1px solid var(--rice-border-color);
  border-top: 1px solid var(--rice-border-color);
}
.rice-calendar__week.data-v-9a99c562 {
  font-size: 14px;
  color: var(--rice-calendar-info-text);
  flex: 1;
  text-align: center;
}
.rice-calendar__body.data-v-9a99c562 {
  position: relative;
  margin: 0 2px 4px;
}
.rice-calendar__body__mark.data-v-9a99c562 {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 0;
  color: var(--rice-calendar-mark-color);
  font-size: 160px;
  pointer-events: none;
}
.rice-calendar__footer.data-v-9a99c562 {
  padding: 12px 16px 16px;
}
.rice-calendar__days.data-v-9a99c562 {
  z-index: 2;
  flex-direction: row;
  margin-top: 4px;
}
.rice-calendar__day.data-v-9a99c562 {
  position: relative;
  align-items: center;
  justify-content: center;
  width: 14.285%;
  height: 60px;
}
.rice-calendar__day__text.data-v-9a99c562 {
  color: var(--rice-text-color);
  font-size: 16px;
}
.rice-calendar__day__top.data-v-9a99c562, .rice-calendar__day__bottom.data-v-9a99c562 {
  position: absolute;
  color: var(--rice-calendar-info-text);
  font-size: 11px;
  left: 0;
  width: 100%;
  text-align: center;
}
.rice-calendar__day__top.data-v-9a99c562 {
  top: 6px;
}
.rice-calendar__day__bottom.data-v-9a99c562 {
  bottom: 6px;
}
.rice-calendar__day--selected.data-v-9a99c562 {
  border-radius: 4px;
  background-color: var(--rice-primary-color);
}
.rice-calendar__day--selected__text.data-v-9a99c562 {
  color: #f5f5f5;
}
.rice-calendar__day--range--end.data-v-9a99c562 {
  border-top-left-radius: 0px;
  border-bottom-left-radius: 0px;
}
.rice-calendar__day--range--start.data-v-9a99c562 {
  border-top-right-radius: 0px;
  border-bottom-right-radius: 0px;
}
.rice-calendar__day--middle.data-v-9a99c562 {
  color: var(--rice-primary-color);
}
.rice-calendar__day--middle__text.data-v-9a99c562 {
  color: var(--rice-primary-color);
}
.rice-calendar__day--middle.data-v-9a99c562::after {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  opacity: 0.1;
  background-color: currentColor;
}
.rice-calendar__day--disabled__text.data-v-9a99c562 {
  color: var(--rice-calendar-disabled-text);
}