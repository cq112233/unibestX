.rice-slider.data-v-10808707 {
  padding: 4px 0;
  flex-direction: column;
}
.rice-slider__content.data-v-10808707 {
  position: relative;
  justify-content: center;
}
.rice-slider__content--aside--value.data-v-10808707 {
  flex: 1;
}
.rice-slider__track.data-v-10808707 {
  width: 100%;
  height: 4px;
  border-radius: 99px;
  background-color: var(--rice-slider-inactive-background);
}
.rice-slider__track--capsule.data-v-10808707 {
  height: 18px;
}
.rice-slider__active.data-v-10808707 {
  position: absolute;
  background-color: var(--rice-primary-color);
  border-radius: 99px;
}
.rice-slider__top.data-v-10808707 {
  position: relative;
  height: 25px;
  padding: 0 2px;
}
.rice-slider__value.data-v-10808707 {
  color: var(--rice-text-color);
  font-size: 14px;
  white-space: nowrap;
  word-break: keep-all;
}
.rice-slider__value__top.data-v-10808707 {
  position: absolute;
  top: 0;
  z-index: 2;
  transform: translateX(-50%);
}
.rice-slider__value__left.data-v-10808707 {
  padding-right: 4px;
  width: 45px;
  text-align: right;
}
.rice-slider__value__right.data-v-10808707 {
  padding-left: 4px;
  width: 45px;
  text-align: left;
}
.rice-slider__button.data-v-10808707 {
  position: absolute;
  width: 25px;
  height: 25px;
  border-radius: 999px;
  background-color: #fff;
  border: 1px solid var(--rice-border-color);
}
.rice-slider--disabled.data-v-10808707 {
  opacity: 0.6;
}
.rice-slider--aside.data-v-10808707 {
  flex-direction: row;
  align-items: center;
}