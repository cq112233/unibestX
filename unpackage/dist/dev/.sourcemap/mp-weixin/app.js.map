<style>

</style>
<script setup lang="uts">
import { checkDirectEntry } from './src/router/interceptor'

onLaunch(() => {

  // 微信小程序真机 @font-face 不生效，使用 uni.loadFontFace 加载 uni-icons 字体
  uni.loadFontFace({
    global: true,
    family: 'UniIconsFontFamily',
    source: 'url(\'/static/uniicons.ttf\')',
    success() {
      uni.__f__('log','at App.uvue:12','global loadFontFace uniicons.ttf success')
    },
    fail(error) {
      uni.__f__('warn','at App.uvue:15','global loadFontFace uniicons.ttf fail', error.errMsg)
    },
  })

})


onShow((options?) => {
  checkDirectEntry(options)
})

</script>

<style lang="scss">
/* uni.scss */
@import '@/uni_modules/rice-ui/libs/style/index.css';
