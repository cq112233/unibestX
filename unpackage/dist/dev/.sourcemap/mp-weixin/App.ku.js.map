<style>

</style>
<template>
  <!-- 应用全局骨架与皮肤容器，通过 CSS 变量绑定响应式主题色与 Rice UI 变量 -->
  <view
    class="flex flex-col flex-1"
    style="flex: 1;"
    :class="[isDarkMode ? 'rice-theme-dark rice-variables' : 'rice-theme-light rice-variables', currentThemeClass]"
    :style="rootThemeStyle"
  >
    <!-- 页面内容滚动容器 -->
    <scroll-view direction="vertical" class="flex-1" style="flex: 1;">
      <slot></slot>
    </scroll-view>
    <!-- 仅在当前页面为底部 Tabbar 页面时渲染自定义导航栏 -->
    <Tabbar v-if="isCurrentPageTabbar" />
  </view>
</template>

<script setup lang="uts">
import Tabbar from '@/src/tabbar/index.uvue'
import { useAppStore } from '@/src/store'
import { isPageTabbar, syncCurIdxByCurrentPage } from '@/src/tabbar/store'
import { isDark } from '@/uni_modules/rice-ui'
import { computed, onBeforeMount, ref } from 'vue'

// 激活应用状态管理 Store
const appStore = useAppStore()

// Rice UI 暗黑模式响应式计算
const isDarkMode = computed((): boolean => isDark.value)

// 响应式计算当前主题类名 (支持 5 套主题无缝切换)
const currentThemeClass = computed((): string => {
  const theme = appStore.state.theme
  if (theme == '#37c2bc') {
    return 'theme-teal'
  }
  if (theme == '#0957DE' || theme == '#0957de') {
    return 'theme-blue'
  }
  if (theme == '#10b981') {
    return 'theme-green'
  }
  if (theme == '#f43f5e') {
    return 'theme-rose'
  }
  if (theme == '#f97316') {
    return 'theme-orange'
  }
  return 'theme-teal'
})

// 动态计算根视图样式变量
const rootThemeStyle = computed((): UTSJSONObject => {
  const theme = appStore.state.theme
  return {
    '--theme-color': theme,
    '--rice-primary-color': theme,
  } as UTSJSONObject
})

// 控制当前页面是否需要显示底部导航栏
const isCurrentPageTabbar = ref(false)

// 页面显示钩子：解析当前路由，动态控制导航栏显示及同步选中索引
onBeforeMount(() => {
  const pages = getCurrentPages()
  if (pages.length > 0) {
    const route = pages[pages.length - 1].route
    if (route != null && route.length > 0) {
      const path = route.startsWith('/') ? route : `/${route}`
      const isTabbar = isPageTabbar(path)
      isCurrentPageTabbar.value = isTabbar
      // 如果是 Tabbar 路由，同步底部导航的激活索引
      if (isTabbar) {
        syncCurIdxByCurrentPage()
      }
    }
  }
})
</script>
