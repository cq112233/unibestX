			}

			&__text {
				color: var(--rice-text-color);
				font-size: 14px;
				font-weight: bold;
				flex: 1;
				text-align: center;
			}
		}


		&__header {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
			height: 46px;
			border-bottom: 1px solid var(--rice-border-color);
			border-top: 1px solid var(--rice-border-color);
		}

		&__week {
			font-size: 14px;
			color: var(--rice-calendar-info-text);
			flex: 1;
			text-align: center;
		}



		&__body {
			position: relative;



			margin: 0 2px 4px;

			&--week {



			}


			&__mark {
				position: absolute;
				top: 50%;
				left: 50%;
				transform: translate(-50%, -50%);




				z-index: 0;

				color: var(--rice-calendar-mark-color);
				font-size: 160px;
				pointer-events: none;

			}
		}

		&__footer {
			padding: 12px 16px 16px;
		}


		&__days {
			z-index: 2;
			flex-direction: row;
			margin-top: 4px;
		}

		&__day {
			position: relative;
			align-items: center;
			justify-content: center;
			width: 14.285%;
			height: 60px;

			&__text {
				color: var(--rice-text-color);
				font-size: 16px;
			}


			&__top,
			&__bottom {
				position: absolute;
				color: var(--rice-calendar-info-text);
				font-size: 11px;
				left: 0;
				width: 100%;
				text-align: center;

			}

			&__top {
				top: 6px;
			}

			&__bottom {
				bottom: 6px;
			}

			&--selected {
				border-radius: 4px;
				background-color: var(--rice-primary-color);

				&__text {
					color: #f5f5f5;
				}
			}


			&--range--end {
				border-top-left-radius: 0px;
				border-bottom-left-radius: 0px;
			}

			&--range--start {
				border-top-right-radius: 0px;
				border-bottom-right-radius: 0px;
			}


			&--middle {

				color: var(--rice-primary-color);


				&__text {
					color: var(--rice-primary-color);
				}


				&::after {
					content: '';
					position: absolute;
					top: 0;
					left: 0;
					right: 0;
					bottom: 0;
					opacity: .1;
					background-color: currentColor;
				}


			}


			&--disabled {
				&__text {
					color: var(--rice-calendar-disabled-text);
				}
			}
		}




	}
</style>