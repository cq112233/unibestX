			border-radius: 12px 12px 0 0;
			transition-property: transform;
			transform: translateY(100%);
		}



		&__title {
			position: relative;
			height: 48px;
			align-items: center;
			justify-content: center;
			padding: 0 16px;

			&__text {
				padding: 8px 16px;
				font-size: 16px;
				font-weight: bold;
				color: var(--rice-text-color);
				text-align: center;
				text-overflow: ellipsis;
				white-space: nowrap;
				width: 100%;
			}
		}


		&__switch {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
			padding: 12px;

			&__action {
