<template>
	<up-transition
		mode="slide-down"
		:customStyle="containerStyle"
		:show="open"
	>
		<view
			class="up-notify"
			:class="[`up-notify--${tmpConfig['type']}`]"
			:style="[backgroundColor, addStyle(customStyle)]"
		>
			<up-status-bar v-if="tmpConfig['safeAreaInsetTop']"></up-status-bar>
			<view class="up-notify__warpper">
				<slot name="icon">
					<up-icon
						v-if="['success', 'warning', 'error'].includes(tmpConfig['type'].toString())"
						:name="tmpConfig['icon']"
						:color="tmpConfig['color']"
						:size="1.3 * parseFloat(getPx(tmpConfig['fontSize'] ?? '0').toString())"
						:customStyle="{marginRight: '4px'}"
					></up-icon>
				</slot>
				<text
					class="up-notify__warpper__text"
					:style="{
						fontSize: addUnit(tmpConfig['fontSize'] ?? '0'),
						color: tmpConfig['color'] ?? ''
					}"
				>{{ tmpConfig['message'] }}</text>
			</view>
		</view>
	</up-transition>
</template>

<script setup lang="uts">
import { computed, ref, onBeforeUnmount } from 'vue'
import { addUnit, addStyle, deepMerge, getPx } from '../../libs/function/index.uts'

defineOptions({
  name: 'up-notify'
})

const props = defineProps({
  customStyle: {
    type: Object,
    default: () => ({})
  }
})

const open = ref<boolean>(false)
const timer = ref<number | null>(null)

const config = {
  top: 0,
  type: 'primary',
  color: '#ffffff',
  bgColor: '',
  message: '',
  duration: 3000,
  fontSize: 15,
  safeAreaInsetTop: false
}

const tmpConfig = ref<UTSJSONObject>({
  top: 0,
  type: 'primary',
  color: '#ffffff',
  bgColor: '',
  message: '',
  duration: 3000,
  fontSize: 15,
  safeAreaInsetTop: false
} as UTSJSONObject)

const containerStyle = computed<UTSJSONObject>(() => {
  let top: any = 0
  const topValue = tmpConfig.value['top']
  const isTopZero = topValue != null && parseFloat(topValue.toString()) == 0
  if (isTopZero) {



  }
  return {
    top: addUnit(isTopZero ? top : topValue),
    position: 'fixed',
    left: 0,
    right: 0,
    zIndex: 10076
  } as UTSJSONObject
})

const backgroundColor = computed<UTSJSONObject>(() => {
  const style = {} as UTSJSONObject
  const bg = tmpConfig.value['bgColor']?.toString() ?? ''
  if (bg != '') {
    style['backgroundColor'] = bg
  }
  return style
})

function clearTimer() {
  open.value = false
  if (timer.value != null) {
    clearTimeout(timer.value!)
    timer.value = null
  }
}

function show(options: UTSJSONObject) {
  tmpConfig.value = deepMerge(config, options)
  clearTimer()
  open.value = true
  const dur = parseInt((tmpConfig.value['duration'] ?? 3000).toString())
  if (dur > 0) {
    timer.value = setTimeout(() => {
      open.value = false
      clearTimer()
      const complete = tmpConfig.value['complete']
      if (typeof complete === 'function') {
        ;(complete as () => void)()
      }
    }, dur)
  }
}

function close() {
  clearTimer()
}

function primary(message: string) {
  show({ type: 'primary', message } as UTSJSONObject)
}

function success(message: string) {
  show({ type: 'success', message } as UTSJSONObject)
}

function error(message: string) {
  show({ type: 'error', message } as UTSJSONObject)
}

function warning(message: string) {
  show({ type: 'warning', message } as UTSJSONObject)
}

onBeforeUnmount(() => {
  clearTimer()
})

defineExpose({
  show,
  close,
  primary,
  success,
  error,
  warning
})
</script>

<style lang="scss" scoped>
	@import "../../libs/css/components.scss";

	$up-notify-padding: 8px 10px !default;
	$up-notify-text-font-size: 15px !default;
	$up-notify-primary-bgColor: $up-primary !default;
	$up-notify-success-bgColor: $up-success !default;
	$up-notify-error-bgColor: $up-error !default;
	$up-notify-warning-bgColor: $up-warning !default;

	.up-notify {
		padding: $up-notify-padding;

		&__warpper {
			@include flex;
			align-items: center;
			text-align: center;
			justify-content: center;

			&__text {
				font-size: $up-notify-text-font-size;
				text-align: center;
			}
		}

		&--primary {
			background-color: $up-notify-primary-bgColor;
		}

		&--success {
			background-color: $up-notify-success-bgColor;
		}

		&--error {
			background-color: $up-notify-error-bgColor;
		}

		&--warning {
			background-color: $up-notify-warning-bgColor;
		}
	}
</style>
