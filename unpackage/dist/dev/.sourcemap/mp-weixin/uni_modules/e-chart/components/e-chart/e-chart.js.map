<script setup lang="uts">
import { computed, ref, watch, onMounted, getCurrentInstance } from 'vue'


import * as echarts from './js/echarts.esm.min.js'
import UniCanvas from './js/UniCanvas.js'
import UniImg from './js/UniImg.js'
import { getRandomId, addUnitRpx, getWindowInfo } from './js/util.js'







defineOptions({
  name: 'e-chart'
})

const emit = defineEmits(['ready'])

const props = defineProps({
  width: {
    type: [Number, String],
    default: '100%',
  },
  height: {
    type: [Number, String],
    default: 600,
  },
  disableScroll: {
    type: Boolean,
    default: false,
  },
  theme: {
    type: String,
    default: '',
  }
})





let echartObj: any = null
let echartCanvas: any = null
let _resizeTimer: any = null
const instance = getCurrentInstance()


const canvasId = getRandomId()

const canvasStyle = computed<string>(() => {
  return `width:${addUnitRpx(props.width)};height:${addUnitRpx(props.height)}`
})

function onCanvasReady() {
  emit('ready')
}
































function getCanvasQuery(): any {
  let query = uni.createSelectorQuery()

  if (instance != null && instance.proxy != null) {
    // @ts-ignore
    query = query.in(instance.proxy)
  }

  return query.select(`#${canvasId}`)
}



async function initMP(option: UTSJSONObject) {
  const { node, ctx, width, height, devicePixelRatio } = await getMpCanvas()

  const canvas = node ? new UniCanvas(ctx, canvasId, true, node) : new UniCanvas(ctx, canvasId, false)
  
  echarts.registerPreprocessor((opt) => {
    if (opt && opt.series) {
      if (opt.series.length > 0) {
        opt.series.forEach((series) => {
          series.progressive = 0
        })
      } else if (typeof opt.series === 'object') {
        opt.series.progressive = 0
      }
    }
  })

  if (echarts.setPlatformAPI) {
    echarts.setPlatformAPI({
      createCanvas: () => canvas,
      loadImage: (src, onload, onerror) => {
        const image = node ? node.createImage() : new UniImg()
        image.onload = onload
        image.onerror = onerror
        image.src = src
        return image
      },
    })
  } else {
    echarts.setCanvasCreator(() => canvas)
  }

  echartObj = echarts.init(canvas, props.theme, {
    devicePixelRatio,
    width,
    height,
  })

  canvas.setChart(echartObj)
  setOption(option)
  echartCanvas = node

  return { echartCanvas: node, echartObj, canvasId, width, height }
}

function getMpCanvas(): Promise<any> {
  return new Promise((resolve) => {
    getCanvasQuery().fields({ node: true, size: true }).exec((res) => {
      const { width, height, node } = res[0]
      let devicePixelRatio = 1
      if (node && node.getContext) {
        const ctxV2 = node.getContext('2d')

        devicePixelRatio = getWindowInfo().pixelRatio

        resolve({ ctx: ctxV2, width, height, node, devicePixelRatio })
      } else {
        const ctxV1 = uni.createCanvasContext(canvasId)



        resolve({ ctx: ctxV1, width, height, devicePixelRatio })
      }
    })
  })
}
















async function init(option: UTSJSONObject): Promise<any> {





  return await initMP(option)





}

function getEchartObj(): any | null {




  return echartObj

}

function setOption(option: UTSJSONObject) {




  echartObj?.setOption(option)

}

function getOption(): Promise<UTSJSONObject> {
  return new Promise<UTSJSONObject>(resolve => {




    resolve(echartObj!.getOption())

  })
}

function getWidth(): Promise<number> {
  return new Promise<number>(resolve => {






    resolve(echartObj!.getWidth())

  })
}

function getHeight(): Promise<number> {
  return new Promise<number>(resolve => {






    resolve(echartObj!.getHeight())

  })
}

function resize() {




  _resizeTimer && clearTimeout(_resizeTimer)
  _resizeTimer = setTimeout(() => {
    getCanvasQuery().boundingClientRect().exec(res => {
      const { width, height } = res[0]
      echartObj.resize({ width, height })
    })
  }, 30)

}


function onTouchstart(e: UTSJSONObject) {
  const event = wrapTouch(e)
  const zrxy = getZrXy(event.touches)
  const handler = echartObj.getZr().handler
  handler.dispatch('mousedown', zrxy)
  handler.dispatch('mousemove', zrxy)
  handler.processGesture(event, 'start')
}

function onTouchmove(e: UTSJSONObject) {
  const event = wrapTouch(e)
  const zrxy = getZrXy(event.touches)
  const handler = echartObj.getZr().handler
  handler.dispatch('mousemove', zrxy)
  handler.processGesture(event, 'change')
}

function onTouchend(e: UTSJSONObject) {
  const event = wrapTouch(e)
  const zrxy = getZrXy(event.changedTouches)
  const handler = echartObj.getZr().handler
  handler.dispatch('mouseup', zrxy)
  handler.dispatch('click', zrxy)
  handler.processGesture(event, 'end')
}

function wrapTouch(e: UTSJSONObject) {
  wrapTouches(e.changedTouches)
  wrapTouches(e.touches)
  return e
}

function wrapTouches(touches: UTSJSONObject[] = []) {
  for (const touch of touches) {







    touch.offsetX = touch.x
    touch.offsetY = touch.y
  }
}

function getZrXy(touches: UTSJSONObject[] = []): UTSJSONObject {
  const touch = touches[0] || {}
  return {
    zrX: touch.x,
    zrY: touch.y,
    preventDefault: () => {},
    stopImmediatePropagation: () => {},
    stopPropagation: () => {}
  }
}


function canvasToTempFilePath(): Promise<string> {
  return new Promise<string>((resolve, reject) => {
    const fail = (e: UTSJSONObject) => {
      uni.showModal({ title: '保存失败', content: JSON.stringify(e), showCancel: false })
      reject(e)
    }






















    const option = echartCanvas ? { canvas: echartCanvas } : { canvasId }
    uni.canvasToTempFilePath({
      ...option,
      success(res) {
        resolve(res.tempFilePath)
      },
      fail
    })























  })
}

function showLoading(option: UTSJSONObject) {




  echartObj?.showLoading(option)

}

function hideLoading() {




  echartObj?.hideLoading()

}











watch((): any => props.width, () => {
  resize()
})

watch((): any => props.height, () => {
  resize()
})

onMounted(() => {

  onCanvasReady()

})

defineExpose({
  init,
  setOption,
  getOption,
  getWidth,
  getHeight,
  resize,
  getEchartObj,
  canvasToTempFilePath,
  showLoading,
  hideLoading,
  onCanvasReady
})
</script>

<template>










  

  <canvas
    v-if="canvasId"
    type="2d"
    :id="canvasId"
    :style="canvasStyle"
    :canvas-id="canvasId"
    :disable-scroll="disableScroll"
    @touchstart="onTouchstart"
    @touchmove="onTouchmove"
    @touchend="onTouchend"
    @touchcancel="onTouchend"
    @ready="onCanvasReady"
  />
















</template>