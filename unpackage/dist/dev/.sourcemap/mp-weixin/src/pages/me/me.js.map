<template>
  <AppKu>

  <view class="wtu-1hohpe6-0 wtu-kfqmh9-1 wtu-tikv1r-2 wtu-ivlko1-3 wtu-nw53rz-4">
    <!-- 头部卡片：用户头像及状态 -->
    <view class="wtu-v9mcu4-5 wtu-4q8au6-6 wtu-4hefdc-7 wtu-8ywmhi-8 wtu-eogvvs-9 wtu-ugiijb-a wtu-1hohpe6-0 wtu-kfqmh9-1 wtu-tikv1r-2">
      <image class="wtu-1xovv6-b wtu-1h6ymxp-c wtu-152xqwk-d wtu-r07p60-e wtu-19juoov-f wtu-1ypllkc-g wtu-1q8anq5-h" :src="avatarUrl" />
      <text class="wtu-1fov80n-i wtu-58fnu4-j wtu-1c3ypac-k wtu-tminbx-l">
        {{ userStore.state.userInfo.username.length > 0 ? userStore.state.userInfo.username : '未登录用户' }}
      </text>
      <text v-if="userStore.state.userInfo.username.length > 0" class="wtu-1n331w6-m wtu-1ya1no3-n wtu-kjtkcs-o">
