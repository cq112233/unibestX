      </view>

      <!-- 亮点标签点缀 -->
      <view class="flex-row items-center mb-4px flex-wrap">
        <view class="mr-6px mb-4px px-10px py-3px rounded-20px bg-__e0edff_ border-width-1px border-solid border-color-__bfdbfe_">
          <text class="text-11px text-__2563eb_ font-medium">48+ 丰富组件</text>
        </view>
        <view class="mr-6px mb-4px px-10px py-3px rounded-20px bg-__d1fae5_ border-width-1px border-solid border-color-__a7f3d0_">
          <text class="text-11px text-__059669_ font-medium">支持蒸汽模式</text>
        </view>
        <view class="mb-4px px-10px py-3px rounded-20px bg-__fef3c7_ border-width-1px border-solid border-color-__fde68a_">
