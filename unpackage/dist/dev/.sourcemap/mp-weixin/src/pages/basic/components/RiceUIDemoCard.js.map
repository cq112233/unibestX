    <!-- 进入演示页面按钮 -->
    <view
      class="w-full h-44px rounded-8px flex flex-row items-center justify-center"
      :style="{ backgroundColor: currentTheme }"
      @click="navigateToShowcase"
    >
      <text class="text-__ffffff_ text-14px font-bold">进入 Rice UI 示例</text>
    </view>
  </Card>
