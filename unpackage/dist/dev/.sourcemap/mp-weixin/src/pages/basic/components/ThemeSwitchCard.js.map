<template>
  <Card :title="$t('basic.themeTitle')">
    <!-- 预览区域 -->
    <view class="rounded-12px p-16px mb-16px border-width-1px border-style-solid border-color-[#e2e8f0] wtu-1vbahwj-0">
      <text class="text-12px wtu-i5demr-1 mb-8px">{{ $t('basic.themePreview') }}</text>

      <view
        class="mt-10px wtu-7gvrw-2 w-200px h-44px rounded-8px wtu-27v8zu-3 wtu-1q091sr-4 wtu-1vbahwj-0 wtu-1r3uoj-5"
        :style="{ backgroundColor: appStore.state.theme }"
      >
        <text class="wtu-g3vc06-6 text-14px">{{ $t('basic.themeButton') }}</text>
      </view>
    </view>

    <!-- 颜色选择区 -->
    <view class="wtu-1q091sr-4 wtu-1o0f0um-7 py-10px">
      <view
        v-for="(item, index) in colorOptions"
        :key="index"
        class="w-40px h-40px rounded-20px wtu-1vbahwj-0 wtu-1r3uoj-5"
        :style="{
          backgroundColor: item,
          borderWidth: appStore.state.theme === item ? '3px' : '0px',
          borderStyle: 'solid',
          borderColor: '#1e293b'
        }"
        @click="changeTheme(item)"
      >
        <text
          v-if="appStore.state.theme === item"
          class="text-16px wtu-19gexn6-8 wtu-1x7cgzs-9"
        >✓</text>
      </view>
    </view>
  </Card>
</template>

<script setup lang="uts">
import Card from './Card.uvue'
import { useAppStore } from '@/src/store/index.uts'
import { t } from '@/src/utils/i18n'

const appStore = useAppStore()

const colorOptions = [
  '#37c2bc',
  '#0957DE',
  '#10b981',
  '#f43f5e',
  '#f97316',
]

function changeTheme(color: string) {
  appStore.setTheme(color)

  uni.showToast({
    title: t('basic.themeSuccess', null),
    icon: 'none',
    duration: 1500,
  })
}
</script>

