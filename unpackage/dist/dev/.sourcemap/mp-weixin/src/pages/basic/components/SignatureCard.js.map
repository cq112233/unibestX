<template>
  <Card title="签名板 lime-signature">
    <!-- 签名画布区域 -->
    <view class="rounded-12px mb-16px border-width-1px border-style-solid border-color-__e2e8f0_ overflow-hidden" style="width: 100%; height: 300px;">
      <l-signature
        ref="signatureRef"
        :penColor="penColor"
        :penSize="penSize"
        :openSmooth="openSmooth"
        disableScroll
        backgroundColor="#ffffff"
      />
    </view>

    <!-- 操作按钮 -->
    <view class="rounded-12px p-16px mb-16px border-width-1px border-style-solid border-color-__e2e8f0_">
      <text class="text-12px text-__94a3b8_ mb-12px">画板操作</text>
      <view class="flex-row gap-10px mb-12px">
        <view class="flex-1 h-36px rounded-8px bg-__10b981_ flex flex-row items-center justify-center" @click="handleSave">
          <text class="text-__ffffff_ text-13px font-bold">保存图片</text>
        </view>
        <view class="flex-1 h-36px rounded-8px bg-__f59e0b_ flex flex-row items-center justify-center" @click="handleUndo">
          <text class="text-__ffffff_ text-13px font-bold">撤销</text>
        </view>
        <view class="flex-1 h-36px rounded-8px bg-__3b82f6_ flex flex-row items-center justify-center" @click="handleRedo">
          <text class="text-__ffffff_ text-13px font-bold">重做</text>
        </view>
        <view class="flex-1 h-36px rounded-8px bg-__ef4444_ flex flex-row items-center justify-center" @click="handleClear">
          <text class="text-__ffffff_ text-13px font-bold">清空</text>
        </view>
      </view>
    </view>

    <!-- 画笔设置 -->
    <view class="rounded-12px p-16px mb-16px border-width-1px border-style-solid border-color-__e2e8f0_">
      <text class="text-12px text-__94a3b8_ mb-12px">画笔设置</text>

      <!-- 画笔颜色 -->
      <view class="flex-row justify-between items-center mb-12px">
        <text class="text-13px text-__475569_">画笔颜色</text>
        <view class="flex-row">
          <view
            v-for="(item, _index) in colorList"
            :key="item.color"
            class="w-28px h-28px rounded-14px ml-6px border-width-2px border-style-solid items-center justify-center"
            :style="{
              backgroundColor: item.color,
              borderColor: penColor === item.color ? '#1e293b' : 'transparent',
            }"
            @click="penColor = item.color"
          >
          </view>
        </view>
      </view>

      <!-- 画笔粗细 -->
      <view class="flex-row justify-between items-center mb-12px">
        <text class="text-13px text-__475569_">画笔粗细</text>
        <text class="text-12px text-__94a3b8_">{{ penSize }}px</text>
      </view>
      <view class="flex-row items-center mb-12px">
        <text class="text-12px text-__94a3b8_ w-30px">1</text>
        <slider
          class="flex-1"
          :min="1"
          :max="12"
          :value="penSize"
          @change="onPenSizeChange"
        />
        <text class="text-12px text-__94a3b8_ w-30px text-right">12</text>
      </view>

      <!-- 压感开关（APP 不支持） -->

      <view class="flex-row justify-between items-center">
        <text class="text-13px text-__475569_">模拟压感</text>
        <switch :checked="openSmooth" @change="onSmoothChange" />
      </view>

    </view>

    <!-- 保存预览 -->
    <view v-if="signUrl !== ''" class="rounded-12px p-16px mb-16px border-width-1px border-style-solid border-color-__e2e8f0_ items-center">
      <text class="text-12px text-__94a3b8_ mb-8px">签名预览</text>
      <image
        :src="signUrl"
        class="w-full h-120px rounded-8px border-width-1px border-style-solid border-color-__e2e8f0_"
        mode="aspectFit"
      />
    </view>
  </Card>
</template>

<script setup lang="uts">
import Card from './Card.uvue'
import { ref } from 'vue'
import type { LimeSignatureToTempFilePathOptions, LimeSignatureToFileSuccess } from '@/uni_modules/lime-signature'

// 签名组件 ref
const signatureRef = ref<any>(null)

// 画笔状态
const penColor = ref('red')
const penSize = ref(4)
const openSmooth = ref(true)

// 签名预览
const signUrl = ref('')

// 颜色列表
const colorList = [
  { color: '#ef4444' },
  { color: '#000000' },
  { color: '#3b82f6' },
  { color: '#10b981' },
  { color: '#f59e0b' },
]

// 画笔粗细变化
function onPenSizeChange(e: any) {
  penSize.value = e.detail.value as number
}

// 压感开关
function onSmoothChange(e: any) {
  openSmooth.value = e.detail.value as boolean
}

// 清空画板
function handleClear() {
  const el = signatureRef.value
  if (el != null) {
    el.clear()
    signUrl.value = ''
  }
}

// 撤销
function handleUndo() {
  const el = signatureRef.value
  if (el != null) {
    el.undo()
  }
}

// 重做
function handleRedo() {
  const el = signatureRef.value
  if (el != null) {
    el.redo()
  }
}

// 保存签名图片
function handleSave() {
  const el = signatureRef.value
  if (el == null) {
    uni.showToast({ title: '签名组件未就绪', icon: 'none' })
    return
  }
  el.canvasToTempFilePath({
    success: (res: LimeSignatureToFileSuccess) => {
      if (res.isEmpty) {
        uni.showToast({ title: '请先签名', icon: 'none' })
        return
      }
      signUrl.value = res.tempFilePath
      uni.showToast({ title: '签名保存成功', icon: 'success' })
    },
    fail: (_err: any) => {
      uni.showToast({ title: '保存失败', icon: 'error' })
    },
  } as LimeSignatureToTempFilePathOptions)
}
</script>

