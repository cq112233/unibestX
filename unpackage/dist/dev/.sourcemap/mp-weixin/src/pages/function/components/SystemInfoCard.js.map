<template>
  <Card title="设备系统信息">
    <view class="rounded-12px p-16px mb-16px border-width-1px border-style-solid border-color-[#e2e8f0]">
      <view class="wtu-2dnwdx-0 wtu-y6hc1g-1 mb-10px">
        <text class="text-14px wtu-2prjq9-2">手机品牌</text>
        <text class="text-14px wtu-10grseq-3 wtu-14btyn8-4">{{ sysBrand !== '' ? sysBrand : '暂无数据' }}</text>
      </view>
      <view class="wtu-2dnwdx-0 wtu-y6hc1g-1 mb-10px">
        <text class="text-14px wtu-2prjq9-2">手机型号</text>
        <text class="text-14px wtu-10grseq-3 wtu-14btyn8-4">{{ sysModel !== '' ? sysModel : '暂无数据' }}</text>
      </view>
      <view class="wtu-2dnwdx-0 wtu-y6hc1g-1 mb-10px">
        <text class="text-14px wtu-2prjq9-2">操作系统</text>
        <text class="text-14px wtu-10grseq-3 wtu-14btyn8-4">{{ sysSystem !== '' ? sysSystem : '暂无数据' }}</text>
      </view>
      <view class="wtu-2dnwdx-0 wtu-y6hc1g-1">
        <text class="text-14px wtu-2prjq9-2">运行平台</text>
        <text class="text-14px wtu-10grseq-3 wtu-14btyn8-4">{{ sysPlatform !== '' ? sysPlatform : '暂无数据' }}</text>
      </view>
    </view>
    <view class="wtu-1tlvelu-5 h-44px rounded-8px wtu-17j8w31-6 wtu-o8ie9c-7 wtu-2dnwdx-0 wtu-1ie67qt-8 wtu-1d5n1t1-9" @click="fetchSystemInfo">
      <text class="wtu-tl526o-a text-14px wtu-10grseq-3">获取系统信息</text>
    </view>
  </Card>
</template>

<script setup lang="uts">
import Card from '../../basic/components/Card.uvue'
import { onMounted, ref } from 'vue'

const sysBrand = ref('')
const sysModel = ref('')
const sysSystem = ref('')
const sysPlatform = ref('')

function fetchSystemInfo() {
  try {
    const info = uni.getSystemInfoSync()
    sysBrand.value = info.brand ?? ''
    sysModel.value = info.model ?? ''
    sysSystem.value = info.system ?? ''
    sysPlatform.value = info.uniPlatform ?? ''
  }
  catch (err) {
    uni.__f__('error','at src/pages/function/components/SystemInfoCard.uvue:45',err)
  }
}

onMounted(() => {
  fetchSystemInfo()
})
</script>

