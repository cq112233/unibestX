<template>
  <Card title="全局 Toast 提示调用">
    <!-- 说明区域 -->
    <view class="rounded-12px p-16px mb-16px border-width-1px border-style-solid border-color-__e2e8f0_">
      <text class="text-12px text-__64748b_ leading-20px">
        演示从功能页调用 App.ku.uvue 全局挂载的 &lt;up-toast ref="uToastRef" /&gt;，支持自定义消息、类型与轻提示反馈。
      </text>
    </view>

    <!-- 自定义输入内容 -->
    <view class="mb-12px">
      <text class="text-12px text-__94a3b8_ mb-6px">自定义 Toast 内容</text>
      <input
        v-model="customMsg"
        placeholder="请输入要提示的文字内容"
        class="h-38px bg-white rounded-6px px-12px border-width-1px border-style-solid border-color-__cbd5e1_ text-14px text-__334155_"
      />
    </view>

    <!-- 按钮操作组 -->
    <view class="flex flex-row">
      <view
        class="flex-1 mr-10px bg-__3b82f6_ rounded-8px h-40px flex flex-row items-center justify-center"
        @click="showCustomToast"
      >
        <text class="text-__ffffff_ text-13px font-bold">弹出自定义 Toast</text>
      </view>
      <view
        class="flex-1 bg-__10b981_ rounded-8px h-40px flex flex-row items-center justify-center"
        @click="showSuccessToast"
      >
        <text class="text-__ffffff_ text-13px font-bold">弹出成功 Toast</text>
      </view>
    </view>
  </Card>
</template>

<script setup lang="uts">
import Card from '../../basic/components/Card.uvue';
import { ref } from 'vue';
import { toast, toastSuccess } from '@/src/utils/toast';

const customMsg = ref<string>('来自 Function 功能页的 Toast 消息！');

function showCustomToast() {
  if (customMsg.value.trim() == '') {
    toast('请输入提示内容');
    return;
  }
  toast(customMsg.value);
}

function showSuccessToast() {
  toastSuccess('Function 页面全局 Toast 触发成功！');
}
</script>

