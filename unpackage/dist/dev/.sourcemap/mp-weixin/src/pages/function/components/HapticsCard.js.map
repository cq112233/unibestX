<template>
  <Card title="触感与工具">
    <view class="wtu-1pqljrd-0 wtu-1nsrzwm-1 wtu-z7ly8f-2 wtu-cu4oh8-3 wtu-1ae0mn0-4 wtu-1dpq0lu-5">
      <text class="wtu-1e3pw8z-6 wtu-xlfis6-7 wtu-1174kp0-8">剪贴板测试文本</text>
      <input
        v-model="copyText"
        placeholder="请输入要复制的文本"
        class="wtu-14leste-9 wtu-44c3cb-a wtu-rkq1ns-b wtu-3rena2-c wtu-cu4oh8-3 wtu-1ae0mn0-4 wtu-17e4xae-d wtu-wgd06p-e wtu-lwq7o6-f wtu-7zqqiz-g"
      />
      <view class="wtu-1phhh09-h wtu-14leste-9 wtu-18u1qwy-i wtu-1km86q6-j wtu-snabsj-k wtu-1e9fgzq-l wtu-15f70xm-m wtu-1kekspa-n" @click="handleCopy">
        <text class="wtu-199nxoz-o wtu-wgd06p-e wtu-17exkt3-p">复制测试文本</text>
      </view>
    </view>

    <view class="wtu-1phhh09-h wtu-1i30ucf-q wtu-18u1qwy-i wtu-nwcnqo-r wtu-snabsj-k wtu-1e9fgzq-l wtu-15f70xm-m wtu-1kekspa-n" @click="triggerVibration">
      <text class="wtu-199nxoz-o wtu-wgd06p-e wtu-17exkt3-p">短震动反馈</text>
    </view>
  </Card>
</template>

<script setup lang="uts">
import Card from '../../basic/components/Card.uvue';
import { ref } from 'vue';

const copyText = ref('Hello unibestX!');

function triggerVibration() {

  uni.vibrateShort({
    type: 'light',
    success: () => {
      uni.showToast({ title: '已触发短震动', icon: 'none' });
    },
    fail: () => {
      uni.showToast({ title: '震动触发失败', icon: 'none' });
    }
  });







}

function handleCopy() {
  if (copyText.value === '')
    return;
  uni.setClipboardData({
    data: copyText.value,
    success: () => {
      uni.showToast({
        title: '复制成功',
        icon: 'success'
      });
    }
  });
}
</script>

