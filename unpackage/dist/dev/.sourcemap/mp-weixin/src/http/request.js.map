import { Request } from '@/uni_modules/lime-request';
import type { LimeRequestConfig, LimeRequestFail, LimeRequestResponse } from '@/uni_modules/lime-request';
import { useTokenStore } from '../store/token';
import { toLoginPage } from '../utils/toLoginPage';
import { ContentTypeEnum, ResultEnum, ShowMessage } from './tools/enum';

// ==========================================
// 域名配置（所有端统一从 Vite 环境变量读取）
// ==========================================
// H5：VITE_H5_USE_PROXY=true 走 /api 反向代理，false 直连（默认）
// 小程序 / App：固定直连，不支持 /api，误配时回退默认完整域名

const DEFAULT_API_URL: string = 'https://ukw0y1.laf.run';
const directBaseUrl: string = `${import.meta.env.VITE_SERVER_BASEURL ?? DEFAULT_API_URL}`;
const directSecondaryUrl: string = `${import.meta.env.VITE_SERVER_BASEURL_SECONDARY ?? DEFAULT_API_URL}`;

// #ifdef H5
// H5：VITE_H5_USE_PROXY=true 时走 /api 反向代理
const useH5Proxy: boolean = `${import.meta.env.VITE_H5_USE_PROXY ?? 'false'}` == 'true';
const defaultUrl: string = useH5Proxy ? '/api' : directBaseUrl;
const secondaryUrl: string = useH5Proxy ? '/api' : directSecondaryUrl;
// #endif
// #ifndef H5
// 小程序 / App：固定直连，误配 /api 时回退默认完整域名
const defaultUrl: string = directBaseUrl.startsWith('/') ? DEFAULT_API_URL : directBaseUrl;
const secondaryUrl: string = directSecondaryUrl.startsWith('/') ? DEFAULT_API_URL : directSecondaryUrl;
// #endif

interface ApiDomainConfig {
  DEFAULT: string;
  SECONDARY: string;
}

export const API_DOMAINS: ApiDomainConfig = {
  DEFAULT: defaultUrl,
  SECONDARY: secondaryUrl
};

// ==========================================
// 创建底层 lime-request 实例
// ==========================================
const requestInstance = new Request({
  baseURL: API_DOMAINS.DEFAULT,
  timeout: 5000,
  header: {
    'Content-Type': ContentTypeEnum.AppJson,
    'Accept': 'application/json, text/plain, */*'
  }
} as LimeRequestConfig);

// ==========================================
// 1. 请求拦截器
// ==========================================
requestInstance.interceptors.request.use(
  (config: LimeRequestConfig): LimeRequestConfig => {
    if (config.header === null) {
      config.header = {} as UTSJSONObject;
    }
    const header = config.header as UTSJSONObject;
    if (header['Content-Type'] == null) {
      header['Content-Type'] = ContentTypeEnum.AppJson;
    }
    if (header.Accept == null) {
      header.Accept = 'application/json, text/plain, */*';
    }

    const extra = config.extra;
    let ignoreAuth = false;
    if (extra !== null) {
      const authVal = (extra as UTSJSONObject).getBoolean('ignoreAuth');
      if (authVal == true) {
        ignoreAuth = true;
      }
    }

    if (!ignoreAuth) {
      const tokenStore = useTokenStore();
      const token = tokenStore.getToken();
      if (token === '') {
        throw new Error('[请求错误]：未登录');
      }
      header.token = token;
    }

    if (extra !== null) {
      const domain = (extra as UTSJSONObject).domain as string | null;
      if (domain != null) {
        config.baseURL = domain;
      }
    }

    return config;
  },
  (error: LimeRequestFail): Promise<LimeRequestFail> => {
    return Promise.reject(error) as Promise<LimeRequestFail>;
  }
);

// ==========================================
// 2. 响应拦截器
// ==========================================
requestInstance.interceptors.response.use(
  (response: LimeRequestResponse<any>): LimeRequestResponse<any> => {
    const config = response.config;
    const extra = config.extra;
    const method = config.method;

    if (method === 'UPLOAD' || method === 'DOWNLOAD') {
      return response;
    }

    const statusCode = response.statusCode;
    if (statusCode != 200) {
      const errorMessage = ShowMessage(statusCode);
      console.error('errorMessage===>', errorMessage);
      uni.showToast({ title: errorMessage, icon: 'error' });
      if (statusCode == 401) {
        const tokenStore = useTokenStore();
        tokenStore.clearToken();
        toLoginPage({ mode: 'reLaunch' } as UTSJSONObject);
      }
      throw new Error(`${errorMessage}：${response.errMsg}`);
    }

    const rawData = response.data;
    if (rawData === null) {
      throw new Error('返回的响应数据为空');
    }

    const resultObj = JSON.parseObject(JSON.stringify(rawData));
    if (resultObj !== null) {
      const code = resultObj.getNumber('code');
      const msgByKey = resultObj.message as string | null;
      const msgByMsg = resultObj.msg as string | null;
      const message: string = msgByKey != null ? msgByKey : (msgByMsg != null ? msgByMsg : '未知错误');

      if (code !== null) {
        const codeVal = code as number;
        if (codeVal !== ResultEnum.Success0 && codeVal !== ResultEnum.Success200) {
          let toastEnabled = true;
          if (extra !== null) {
            const toastVal = (extra as UTSJSONObject).getBoolean('toast');
            if (toastVal == false) {
              toastEnabled = false;
            }
          }
          if (toastEnabled) {
            uni.showToast({ title: message, icon: 'none' });
          }
          if (codeVal === ResultEnum.Unauthorized) {
            const tokenStore = useTokenStore();
            tokenStore.clearToken();
            toLoginPage({ mode: 'reLaunch' } as UTSJSONObject);
          }
          throw new Error(`请求错误[${codeVal}]：${message}`);
        }
      }
    }

    return response;
  },
  (error: LimeRequestFail): Promise<LimeRequestFail> => {
    console.error('request error ===>', error);
    uni.showToast({ title: '网络错误，请稍后再试', icon: 'none' });
    return Promise.reject(error) as Promise<LimeRequestFail>;
  }
);

// ==========================================
// 3. 封装 http 类（class 支持泛型方法 + this + 默认参数）
//    Android 端泛型方法需要 inline + reified 注解
// ==========================================
export class HttpClient {
  request<T>(config: LimeRequestConfig): Promise<T> {
    return requestInstance.request<any>(config).then((res: LimeRequestResponse<any>): T => {
      const rawData = res.data;
      if (rawData === null) {
        throw new Error('响应数据为空');
      }
      const obj = JSON.parseObject(JSON.stringify(rawData));
      if (obj !== null) {
        const code = obj.getNumber('code');
        if (code !== null) {
          const innerData = obj.get('data');
          if (innerData !== null) {
            const innerStr = JSON.stringify(innerData);
            const parsedData = JSON.parse(innerStr);
            if (parsedData !== null) {
              return parsedData as T;
            }
            else {
              throw new Error(`响应 data 字段无法解析为指定的类型，请检查数据结构是否匹配。数据：${innerStr}`);
            }
          }
          // 如果外层有 code 但没有 data 字段，或者 data 为 null
          // 有些接口可能只返回 code 和 msg，不返回 data。此时如果 T 是 any 可以，否则应该报错
          throw new Error('响应结构包含 code，但 data 字段为空');
        }
      }

      // 如果没有 code，说明不是外层包装格式
      const rawStr = JSON.stringify(rawData);
      const parsedRaw = JSON.parse(rawStr);
      if (parsedRaw !== null) {
        return parsedRaw as T;
      }

      // 无法反序列化为 T，直接强转必定导致 Kotlin NPE
      throw new Error(`原始响应数据无法解析为指定类型。原始数据：${rawStr}`);
    });
  }

  get<T>(url: string, config: LimeRequestConfig | null = null): Promise<T> {
    const _config = (config ?? {}) as LimeRequestConfig;
    _config.url = url;
    _config.method = 'GET';
    return this.request<T>(_config);
  }

  post<T>(url: string, data: any | null = null, config: LimeRequestConfig | null = null): Promise<T> {
    const _config = (config ?? {}) as LimeRequestConfig;
    _config.url = url;
    _config.data = data;
    _config.method = 'POST';
    return this.request<T>(_config);
  }

  put<T>(url: string, data: any | null = null, config: LimeRequestConfig | null = null): Promise<T> {
    const _config = (config ?? {}) as LimeRequestConfig;
    _config.url = url;
    _config.data = data;
    _config.method = 'PUT';
    return this.request<T>(_config);
  }

  delete<T>(url: string, data: any | null = null, config: LimeRequestConfig | null = null): Promise<T> {
    const _config = (config ?? {}) as LimeRequestConfig;
    _config.url = url;
    _config.data = data;
    _config.method = 'DELETE';
    return this.request<T>(_config);
  }
}

export const http = new HttpClient();
export default http;
