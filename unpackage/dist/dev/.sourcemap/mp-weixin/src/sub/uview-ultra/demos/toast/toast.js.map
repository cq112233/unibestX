<template>
  <AppKu>

  <LayoutComponent :navigation-style="'custom'" :navigation-bar-title-text="'up-toast 消息提示'">

  <view class="page-container bg-_b_hf8fafc_B min-h-screen pb-_b30px_B">
    <NavBar title="up-toast 消息提示" :auto-back="true" :safe-area-inset-top="true" bg-color="#ffffff"></NavBar>
    <view class="p-_b16px_B">
      <view class="demo-block">
        <text class="demo-label">基础用法</text>
        <view class="flex-row items-center">
          <up-button type="primary" text="成功提示" size="mini" @click="showToast('success')"></up-button>
          <view class="w-_b10px_B"></view>
          <up-button type="error" text="错误提示" size="mini" @click="showToast('error')"></up-button>
        </view>
      </view>
      <view class="demo-block mt-_b12px_B">
        <text class="demo-label">更多类型</text>
        <view class="flex-row items-center">
          <up-button type="warning" text="警告提示" size="mini" @click="showToast('warning')"></up-button>
          <view class="w-_b10px_B"></view>
          <up-button type="default" text="默认提示" size="mini" @click="showToast('default')"></up-button>
        </view>
      </view>
    </view>
    <up-toast ref="uToast"></up-toast>
  </view>

  </LayoutComponent>

  </AppKu>
</template>

<script setup lang="uts">
import AppKu from '@/App.ku.uvue'
import LayoutComponent from '@/src/layouts/default.uvue'
import { ref } from 'vue';
;

const uToast = ref(null as ComponentPublicInstance | null);
function showToast(type: string) {
  const toast = uToast.value;
  if (toast != null) {
    const configs = {
      success: { message: '操作成功！', type: 'success' },
      error: { message: '操作失败！', type: 'error' },
      warning: { message: '请注意风险！', type: 'warning' },
      default: { message: '这是一条提示', type: 'default' }
    } as UTSJSONObject;
    const config = configs[type] as UTSJSONObject;
    toast.$callMethod('show', {
      message: config.message as string,
      type: config.type as string
    });
  }
}
</script>

