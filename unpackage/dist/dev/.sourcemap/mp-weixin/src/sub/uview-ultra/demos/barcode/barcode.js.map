<template>
  <AppKu>

  <LayoutComponent :navigation-style="'custom'" :navigation-bar-title-text="'up-barcode 条形码'">

  <view class="page-container bg-_b_hf8fafc_B min-h-screen pb-_b30px_B">
    <NavBar title="up-barcode 条形码"></NavBar>
    <view class="p-_b16px_B">
      <!-- 1. 基础用法 -->
      <view class="demo-block">
        <up-title class="demo-title">
          <text class="demo-title-text">基础用法（自动识别格式）</text>
        </up-title>
        <view class="barcode-box">
          <up-barcode value="123456789012"></up-barcode>
        </view>
      </view>

      <!-- 2. 常用格式 -->
      <view class="demo-block mt-_b12px_B">
        <up-title class="demo-title">
          <text class="demo-title-text">常用格式</text>
        </up-title>
        <view class="barcode-box">
          <text class="barcode-name">EAN13</text>
          <up-barcode value="6922233612192" format="EAN13"></up-barcode>
        </view>
        <view class="barcode-box">
          <text class="barcode-name">CODE39</text>
          <up-barcode value="UVIEW-ULTRA" format="CODE39"></up-barcode>
        </view>
        <view class="barcode-box">
          <text class="barcode-name">UPCA</text>
          <up-barcode value="012345678905" format="UPCA"></up-barcode>
        </view>
      </view>

      <!-- 3. 自定义样式 -->
      <view class="demo-block mt-_b12px_B">
        <up-title class="demo-title">
          <text class="demo-title-text">自定义样式（颜色/尺寸/文字位置）</text>
        </up-title>
        <view class="barcode-box">
          <up-barcode
            value="20260820"
            format="CODE128"
            :width="260"
            :height="90"
            :margin="12"
            background="#f0f9ff"
            line-color="#0957de"
            text-position="top"
            :font-size="12"
          ></up-barcode>
        </view>
      </view>

      <!-- 4. ref 重新生成 + 事件 -->
      <view class="demo-block mt-_b12px_B">
        <up-title class="demo-title">
          <text class="demo-title-text">ref 重新生成 + 事件</text>
        </up-title>
        <view class="barcode-box">
          <up-barcode
            ref="barcodeRef"
            :value="barcodeValue"
            format="CODE128"
            @rendered="onRendered"
            @error="onError"
          ></up-barcode>
        </view>
        <view class="btn-row mt-_b10px_B">
          <up-button text="重新生成" type="primary" size="small" class="demo-btn" @click="onRegenerate"></up-button>
          <up-button text="换一个值" type="primary" size="small" class="demo-btn" @click="onChangeValue"></up-button>
        </view>
        <text class="log-text mt-_b10px_B">{{ eventLog }}</text>
      </view>
    </view>
  </view>

  </LayoutComponent>

  </AppKu>
</template>

<script setup lang="uts">
import AppKu from '@/App.ku.uvue'
import LayoutComponent from '@/src/layouts/default.uvue'
import { ref } from 'vue';
;

const barcodeValue = ref<string>('123456789012');
const eventLog = ref<string>('');

const barcodeRef = ref(null as ComponentPublicInstance | null);

function onRendered(event: UTSJSONObject) {
  const format = event.format;
  eventLog.value = `rendered => format: ${format == null ? '' : format.toString()}`;
}

function onError(event: UTSJSONObject) {
  const message = event.message;
  eventLog.value = `error => ${message == null ? '' : message.toString()}`;
}

function onRegenerate() {
  const barcode = barcodeRef.value;
  if (barcode != null) {
    barcode.$callMethod('generateBarcode');
    eventLog.value = '已调用 generateBarcode()';
  }
}

function onChangeValue() {
  barcodeValue.value = barcodeValue.value == '123456789012' ? '987654321098' : '123456789012';
  eventLog.value = `value 已改为 ${barcodeValue.value}`;
}
</script>

<style lang="scss" scoped>
.demo-block {
  margin-bottom: 12px;
  padding: 12px;
  background-color: #ffffff;
  border-radius: 8px;
}
.demo-title {
  margin-bottom: 10px;
}
.demo-title-text {
  font-size: 14px;
  font-weight: bold;
  color: #606266;
}
.barcode-box {
  margin-bottom: 10px;
}
.barcode-name {
  font-size: 12px;
  color: #909399;
  margin-bottom: 6px;
}
.log-text {
  font-size: 13px;
  color: #475569;
  line-height: 20px;
}
.btn-row {
  display: flex;
  flex-direction: row;
}
.demo-btn {
  margin-right: 10px;
}
</style>
