<template>
  <AppKu>

  <LayoutComponent :navigation-style="'custom'" :navigation-bar-title-text="'up-transition 动画'">

  <view class="page-container bg-_b_hf8fafc_B min-h-screen pb-_b30px_B">
    <NavBar title="Transition 动画" :auto-back="true" :safe-area-inset-top="true" bg-color="#ffffff"></NavBar>
    <view class="p-_b16px_B">
      <view class="demo-block">
        <text class="demo-label">内置过渡动画</text>
        <view class="transition-demo-wrapper">
          <up-transition :show="transitionShow" mode="fade">
            <view class="transition-demo-box transition-demo-blue">
              <text class="text-_b14px_B text-white font-_b500_B">fade 淡入淡出</text>
            </view>
          </up-transition>
          <view class="mt-_b10px_B">
            <up-button type="primary" :text="transitionShow ? '隐藏动画' : '显示动画'" size="mini" @click="transitionShow = !transitionShow"></up-button>
          </view>
        </view>
      </view>
      <view class="demo-block mt-_b12px_B">
        <text class="demo-label">缩放动画</text>
        <view class="transition-demo-wrapper">
          <up-transition :show="transitionShow" mode="zoom">
            <view class="transition-demo-box bg-_b_h19be6b_B">
              <text class="text-_b14px_B text-white font-_b500_B">zoom 缩放</text>
            </view>
          </up-transition>
        </view>
      </view>
      <view class="demo-block mt-_b12px_B">
        <text class="demo-label">滑动动画</text>
        <view class="transition-demo-wrapper">
          <up-transition :show="slideShow" :mode="slideMode">
            <view class="transition-demo-box bg-_b_hf56c6c_B">
              <text class="text-_b14px_B text-white font-_b500_B">slide 滑动</text>
            </view>
          </up-transition>
        </view>
        <view class="flex-row items-center justify-around mt-_b10px_B">
          <up-button type="primary" text="上滑" size="mini" custom-style="margin: 0 4px;" @click="triggerSlide('slide-up')"></up-button>
          <up-button type="success" text="下滑" size="mini" custom-style="margin: 0 4px;" @click="triggerSlide('slide-down')"></up-button>
          <up-button type="warning" text="左滑" size="mini" custom-style="margin: 0 4px;" @click="triggerSlide('slide-left')"></up-button>
          <up-button type="error" text="右滑" size="mini" custom-style="margin: 0 4px;" @click="triggerSlide('slide-right')"></up-button>
        </view>
      </view>
    </view>
  </view>

  </LayoutComponent>

  </AppKu>
</template>

<script setup lang="uts">
import AppKu from '@/App.ku.uvue'
import LayoutComponent from '@/src/layouts/default.uvue'
import { ref } from 'vue';

const transitionShow = ref(true);

const slideMode = ref('slide-up');
const slideShow = ref(false);

function triggerSlide(mode: string) {
  slideMode.value = mode;
  slideShow.value = true;
  setTimeout(() => {
    slideShow.value = false;
  }, 1500);
}
</script>

