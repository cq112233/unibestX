<template>
  <AppKu>

  <LayoutComponent :navigation-bar-title-text="'我的'">

  <view class="wtu-1hohpe6-0 wtu-kfqmh9-1 wtu-tikv1r-2 px-16px py-24px wtu-umklo8-3">
    <!-- 头部卡片：用户头像及状态 -->
    <view class="wtu-v9mcu4-4 wtu-4q8au6-5 rounded-12px px-20px py-30px mb-20px wtu-1hohpe6-0 wtu-kfqmh9-1 wtu-tikv1r-2">
      <image class="w-90px h-90px rounded-45px mb-16px border-width-3px border-color-[#f1f5f9] wtu-1q8anq5-6" :src="avatarUrl" />
      <text class="text-20px wtu-58fnu4-7 wtu-1c3ypac-8 mb-4px">
        {{ userStore.state.userInfo.username.length > 0 ? userStore.state.userInfo.username : '未登录用户' }}
      </text>
      <text v-if="userStore.state.userInfo.username.length > 0" class="text-14px wtu-1ya1no3-9 mb-12px">
        {{ userStore.state.userInfo.nickname }}
      </text>
      <view class="wtu-1hohpe6-0 wtu-1pllh87-a">
        <text
          class="text-12px px-12px py-4px rounded-20px wtu-17lenqs-b wtu-j5499y-c"
          :class="tokenStore.hasValidLogin() ? 'wtu-1x8u93y-d wtu-1obvnxf-e' : 'wtu-11a9dql-f wtu-1ya1no3-9'"
        >
          {{ tokenStore.hasValidLogin() ? '已登录' : '未登录' }}
        </text>
      </view>
    </view>

    <!-- 信息区域：序列化数据展示 -->
    <view class="wtu-v9mcu4-4 wtu-4q8au6-5 rounded-12px p-20px mb-24px wtu-1hohpe6-0 wtu-kfqmh9-1">
      <view class="border-bottom-width-1px border-bottom-style-solid border-bottom-color-[#f1f5f9] pb-8px mb-12px wtu-1hohpe6-0 wtu-1pllh87-a">
        <text class="text-15px wtu-4yhcom-g wtu-wy5oxr-h">用户信息 (JSON)</text>
      </view>
      <scroll-view class="wtu-1p4csuv-i rounded-8px p-12px h-180px" scroll-y="true">
        <text class="text-13px wtu-1f6mdr3-j leading-20px" style="font-family: monospace;">{{ userInfoJson }}</text>
      </scroll-view>
    </view>

    <!-- 按钮区域 -->
    <view class="wtu-v9mcu4-4 px-8px wtu-1hohpe6-0 wtu-kfqmh9-1">
      <view v-if="tokenStore.hasValidLogin()" class="wtu-v9mcu4-4 h-48px rounded-8px wtu-1l9wu4z-k wtu-1hohpe6-0 wtu-1pllh87-a wtu-tikv1r-2 wtu-1rnqkyn-l" @click="handleLogout">
        <text class="wtu-amc2mi-m text-14px wtu-58fnu4-7">退出登录</text>
      </view>
      <view v-else class="wtu-v9mcu4-4 h-48px rounded-8px wtu-1y6dimz-n wtu-1hohpe6-0 wtu-1pllh87-a wtu-tikv1r-2 wtu-1rnqkyn-l" @click="handleLogin">
        <text class="wtu-amc2mi-m text-14px wtu-58fnu4-7">登录</text>
      </view>
    </view>
  </view>

  </LayoutComponent>

  </AppKu>
</template>

<script setup lang="uts">
import AppKu from '@/App.ku.uvue'
import LayoutComponent from '@/src/layouts/default.uvue'
import { useTokenStore, useUserStore } from '../../store'
import { LOGIN_PAGE } from '../../router/config'
import { handleBackPressExit } from '@/src/utils/backPress'
import { setCurIdxByPath } from '@/src/tabbar/store'

onBackPress((options: OnBackPressOptions): boolean => {

  if (options.from == 'backbutton') {
    return handleBackPressExit()
  }

  return false
})

const userStore = useUserStore()
const tokenStore = useTokenStore()

// 计算头像
const avatarUrl = computed((): string => {
  if (userStore.state.userInfo.avatar.length > 0) {
    return userStore.state.userInfo.avatar
  }
  return '/static/logo.png'
})

// 序列化用户信息为 JSON
const userInfoJson = computed((): string => {
  const info = {
    userId: userStore.state.userInfo.userId,
    username: userStore.state.userInfo.username,
    nickname: userStore.state.userInfo.nickname,
    avatar: userStore.state.userInfo.avatar,
  }
  return JSON.stringify(info, null, 2)
})

onShow(() => {
  console.log('All storage keys:', uni.getStorageInfoSync().keys)
  console.log('pinia:token:', uni.getStorageSync('pinia:token'))
  console.log('pinia:user:', uni.getStorageSync('pinia:user'))
})

// 登录
function handleLogin() {
  uni.navigateTo({
    url: LOGIN_PAGE,
  })
}

// 退出登录
function handleLogout() {
  uni.showModal({
    title: '提示',
    content: '确定要退出登录吗？',
    success: (res) => {
      if (res.confirm) {
        tokenStore.clearToken()
        userStore.clearUserInfo()
        uni.showToast({
          title: '退出登录成功',
          icon: 'success',
        })
        // 退出后跳回首页（me 页需要登录，不能停留）
        setTimeout(() => {
          const targetUrl = '/src/pages/index/index'
          setCurIdxByPath(targetUrl)
          uni.switchTab({ url: targetUrl })
        }, 0)
      }
    },
  })
}
</script>

