      <text class="text-13px wtu-16mxvjr-0 wtu-19n0869-1 mb-8px">6. RSA 非对称加密 / 签名 (示例密钥 1024 位)</text>
      <input
        v-model="rsaText"
        placeholder="请输入要加密 / 签名的文本"
        class="h-38px wtu-im8kej-2 rounded-6px px-12px border-width-1px border-style-solid border-color-[#cbd5e1] text-13px wtu-1jg4z3q-3 mb-8px"
      />
      <view class="wtu-19z8y3q-4 wtu-hj68nu-5 mb-8px">
        <view class="wtu-1vkw08h-6 h-36px rounded-8px wtu-1j7sztc-n wtu-qbc0lv-8 wtu-19z8y3q-4 wtu-hj68nu-5 wtu-1i4ccha-9 mr-8px" @click="handleRsaGenerateKeyPair">
          <text class="wtu-7s6w8j-a text-13px wtu-16mxvjr-0">生成密钥对</text>
        </view>
        <view class="wtu-1vkw08h-6 h-36px rounded-8px wtu-s6x1vz-o wtu-qbc0lv-8 wtu-19z8y3q-4 wtu-hj68nu-5 wtu-1i4ccha-9" @click="handleRsaEncrypt">
          <text class="wtu-7s6w8j-a text-13px wtu-16mxvjr-0">公钥加密</text>
        </view>
      </view>
      <input
        v-model="rsaPublicKey"
        placeholder="RSA 公钥（PKCS#1 / SPKI，PEM 或 Base64）"
        class="h-38px wtu-im8kej-2 rounded-6px px-12px border-width-1px border-style-solid border-color-[#cbd5e1] text-13px wtu-1jg4z3q-3 mb-8px"
      />
      <input
        v-model="rsaPrivateKey"
        placeholder="RSA 私钥（PKCS#1 / PKCS#8，PEM 或 Base64）"
        class="h-38px wtu-im8kej-2 rounded-6px px-12px border-width-1px border-style-solid border-color-[#cbd5e1] text-13px wtu-1jg4z3q-3 mb-12px"
      />
      <view class="wtu-19z8y3q-4 wtu-hj68nu-5 mb-8px">
        <view class="wtu-1vkw08h-6 h-36px rounded-8px wtu-6rbxlm-p wtu-qbc0lv-8 wtu-19z8y3q-4 wtu-hj68nu-5 wtu-1i4ccha-9 mr-8px" @click="handleRsaDecrypt">
          <text class="wtu-7s6w8j-a text-13px wtu-16mxvjr-0">私钥解密</text>
        </view>
        <view class="wtu-1vkw08h-6 h-36px rounded-8px wtu-1ac3pue-q wtu-qbc0lv-8 wtu-19z8y3q-4 wtu-hj68nu-5 wtu-1i4ccha-9 mr-8px" @click="handleRsaSign">
