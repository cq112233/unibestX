<template>
  <Card title="全局 Toast 提示调用">
    <!-- 说明区域 -->
    <view class="rounded-12px p-16px mb-16px border-width-1px border-style-solid border-color-[#e2e8f0]">
      <text class="text-12px wtu-1pd9yl-0 leading-20px">
        演示从功能页调用 App.ku.uvue 全局挂载的 &lt;up-toast ref="uToastRef" /&gt;，支持自定义消息、类型与轻提示反馈。
      </text>
    </view>

    <!-- 自定义输入内容 -->
    <view class="mb-12px">
      <text class="text-12px wtu-b5uul9-1 mb-6px">自定义 Toast 内容</text>
      <input
        v-model="customMsg"
        placeholder="请输入要提示的文字内容"
        class="h-38px wtu-19clxu8-2 rounded-6px px-12px border-width-1px border-style-solid border-color-[#cbd5e1] text-14px wtu-12c53hp-3"
      />
    </view>

    <!-- 按钮操作组 -->
    <view class="wtu-1yca3x4-4 wtu-clldfh-5">
      <view
        class="wtu-bte5oa-6 mr-10px wtu-zsktp1-7 rounded-8px h-40px wtu-1yca3x4-4 wtu-clldfh-5 wtu-xpmuf1-8 wtu-164irp9-9"
        @click="showCustomToast"
      >
        <text class="wtu-pubmk8-a text-13px wtu-bj9ji2-b">弹出自定义 Toast</text>
      </view>
      <view
        class="wtu-bte5oa-6 wtu-zhey3t-c rounded-8px h-40px wtu-1yca3x4-4 wtu-clldfh-5 wtu-xpmuf1-8 wtu-164irp9-9"
        @click="showSuccessToast"
      >
        <text class="wtu-pubmk8-a text-13px wtu-bj9ji2-b">弹出成功 Toast</text>
      </view>
    </view>
  </Card>
</template>

<script setup lang="uts">
import Card from '../../basic/components/Card.uvue';
import { ref } from 'vue';
import { toast, toastSuccess } from '@/src/utils/toast';

const customMsg = ref<string>('来自 Function 功能页的 Toast 消息！');

function showCustomToast() {
  if (customMsg.value.trim() == '') {
    toast('请输入提示内容');
    return;
  }
  toast(customMsg.value);
}

function showSuccessToast() {
  toastSuccess('Function 页面全局 Toast 触发成功！');
}
</script>

