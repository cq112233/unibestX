<template>
  <Card title="环境变量">
    <!-- 当前环境信息 -->
    <view class="rounded-12px p-16px mb-16px border-width-1px border-style-solid border-color-[#e2e8f0]">
      <view class="wtu-1wn3kuh-0 wtu-x1ltc0-1 mb-10px">
        <text class="text-14px wtu-y0qx9p-2">编译环境</text>
        <text class="text-14px wtu-1xrmo7y-3 wtu-pfwwnc-4">{{ systemEnvLabel }}</text>
      </view>
      <view class="wtu-1wn3kuh-0 wtu-x1ltc0-1 mb-10px">
        <text class="text-14px wtu-y0qx9p-2">当前环境</text>
        <text class="text-14px wtu-1xrmo7y-3" :style="{ color: envColor }">{{ currentEnvLabel }}</text>
      </view>
      <view class="wtu-1wn3kuh-0 wtu-x1ltc0-1 mb-10px">
        <text class="text-14px wtu-y0qx9p-2">接口地址</text>
        <text class="text-12px wtu-1a0szfl-5 wtu-10cqf12-6 ml-8px wtu-1exppl3-7">{{ envConfig.baseURL }}</text>
      </view>
      <view class="wtu-1wn3kuh-0 wtu-x1ltc0-1">
        <text class="text-14px wtu-y0qx9p-2">是否已覆盖</text>
        <text class="text-14px wtu-1xrmo7y-3 wtu-pfwwnc-4">{{ isOverridden ? '是' : '否' }}</text>
      </view>
    </view>

    <!-- 环境切换 -->
    <view class="rounded-12px p-16px mb-16px border-width-1px border-style-solid border-color-[#e2e8f0]">
      <text class="text-12px wtu-1otqyah-8 mb-12px">切换环境（仅当前运行生效）</text>
      <view class="wtu-1wn3kuh-0 mt-12px">
        <!-- 开发 -->
        <view
          class="wtu-10cqf12-6 h-38px rounded-8px wtu-1hgp7bw-9 wtu-1wn3kuh-0 wtu-1njuza1-a wtu-szxrt-b ml-5px mr-5px"
          :style="{ backgroundColor: devBtnBg }"
          @click="switchEnv('development')"
        >
          <text class="text-14px wtu-1xrmo7y-3" :style="{ color: devBtnText }">开发</text>
        </view>
        <!-- 测试 -->
        <view
          class="wtu-10cqf12-6 h-38px rounded-8px wtu-1hgp7bw-9 wtu-1wn3kuh-0 wtu-1njuza1-a wtu-szxrt-b ml-5px mr-5px"
          :style="{ backgroundColor: testBtnBg }"
          @click="switchEnv('test')"
        >
          <text class="text-14px wtu-1xrmo7y-3" :style="{ color: testBtnText }">测试</text>
        </view>
        <!-- 生产 -->
        <view
          class="wtu-10cqf12-6 h-38px rounded-8px wtu-1hgp7bw-9 wtu-1wn3kuh-0 wtu-1njuza1-a wtu-szxrt-b ml-5px mr-5px"
          :style="{ backgroundColor: prodBtnBg }"
          @click="switchEnv('production')"
        >
          <text class="text-14px wtu-1xrmo7y-3" :style="{ color: prodBtnText }">生产</text>
        </view>
      </view>
    </view>

    <!-- 重置按钮 -->
    <view class="wtu-zeam06-c h-44px rounded-8px wtu-thuvft-d wtu-1hgp7bw-9 wtu-1wn3kuh-0 wtu-1njuza1-a wtu-szxrt-b" @click="handleReset">
      <text class="wtu-1bkp4ss-e text-14px wtu-1xrmo7y-3">重置为系统默认</text>
    </view>
  </Card>
</template>

<script setup lang="uts">
import Card from '../../basic/components/Card.uvue';
import { computed, ref } from 'vue';
import {
  getCurrentEnv,
  getEnvConfigFor,
  getEnvLabel,
  getSystemEnv,
  resetEnv,
  setCurrentEnv
} from '@/src/utils/env.uts';
import type { EnvType } from '@/src/utils/env.uts';

const COLOR_DEV: string = '#10b981';
const COLOR_TEST: string = '#f59e0b';
const COLOR_PROD: string = '#ef4444';
const COLOR_BG: string = '#e2e8f0';
const COLOR_WHITE: string = '#ffffff';
const COLOR_DARK: string = '#475569';

const systemEnv: EnvType = getSystemEnv();

const systemEnvLabel = computed((): string => {
  return systemEnv === 'development' ? '开发' : '生产';
});

// 当前环境（响应式，切换后可驱动 UI 更新）
const currentEnv = ref<EnvType>(getCurrentEnv());

const isOverridden = computed((): boolean => {
  return currentEnv.value !== systemEnv;
});

const currentEnvLabel = computed((): string => {
  return getEnvLabel(currentEnv.value);
});

const envColor = computed((): string => {
  if (currentEnv.value === 'development') {
    return COLOR_DEV;
  }
  if (currentEnv.value === 'test') {
    return COLOR_TEST;
  }
  return COLOR_PROD;
});

const envConfig = computed(() => {
  return getEnvConfigFor(currentEnv.value);
});

// 按钮颜色 computed（避免模板中三元运算类型问题）
const devBtnBg = computed((): string => {
  return currentEnv.value === 'development' ? COLOR_DEV : COLOR_BG;
});
const devBtnText = computed((): string => {
  return currentEnv.value === 'development' ? COLOR_WHITE : COLOR_DARK;
});
const testBtnBg = computed((): string => {
  return currentEnv.value === 'test' ? COLOR_TEST : COLOR_BG;
});
const testBtnText = computed((): string => {
  return currentEnv.value === 'test' ? COLOR_WHITE : COLOR_DARK;
});
const prodBtnBg = computed((): string => {
  return currentEnv.value === 'production' ? COLOR_PROD : COLOR_BG;
});
const prodBtnText = computed((): string => {
  return currentEnv.value === 'production' ? COLOR_WHITE : COLOR_DARK;
});

function switchEnv(type: string) {
  const env = type as EnvType;
  setCurrentEnv(env);
  currentEnv.value = env;
  const label = getEnvLabel(env);
  uni.showToast({
    title: `已切换至${label}环境`,
    icon: 'none',
    duration: 1500
  });
}

function handleReset() {
  resetEnv();
  currentEnv.value = systemEnv;
  uni.showToast({
    title: '已重置为系统默认环境',
    icon: 'none',
    duration: 1500
  });
}
</script>

