<template>
	<view class="up-circle-progress" :style="rootStyle">
		<view class="up-circle-progress__track" :style="trackStyle"></view>
		<view v-if="percent > 0" class="up-circle-progress__mask up-circle-progress__mask--right">
			<view
				class="up-circle-progress__fill up-circle-progress__fill--right"
				:class="[isDefaultColor ? 'up-circle-progress__fill--primary' : '']"
				:style="rightStyle"
			></view>
		</view>
		<view v-if="percent > 50" class="up-circle-progress__mask up-circle-progress__mask--left">
			<view
				class="up-circle-progress__fill up-circle-progress__fill--left"
				:class="[isDefaultColor ? 'up-circle-progress__fill--primary' : '']"
				:style="leftStyle"
			></view>
		</view>
		<view class="up-circle-progress__content">
			<slot>
				<text
					class="up-circle-progress__text"
					:class="[isDefaultColor ? 'up-circle-progress__text--primary' : '']"
					:style="textStyle"
				>{{ percent }}%</text>
			</slot>
		</view>
	</view>
</template>

<script setup lang="uts">
import { computed } from 'vue'
import { addStyle, addUnit, deepMerge, range } from '../../libs/function/index.uts'

defineOptions({
	name: 'up-circle-progress'
})

function normalizeNumber(value: any | null, defaultValue: number = 0): number {
	if (typeof value == 'number') {
		return value as number
	}
	if (value == null) {
		return defaultValue
	}
	const parsed = parseFloat(value.toString())
	return isNaN(parsed) ? defaultValue : parsed
}

const props = defineProps({
	percentage: {
		type: [String, Number],
		default: 30
	},
	activeColor: {
		type: String,
		default: ''
	},
	inactiveColor: {
		type: String,
		default: '#e5e9f2'
	},
	width: {
		type: [String, Number],
		default: 80
	},
	strokeWidth: {
		type: [String, Number],
		default: 6
	},
	customStyle: {
		type: Object,
		default: () : UTSJSONObject => ({})
	}
})

const isDefaultColor = computed<boolean>((): boolean => {
	return props.activeColor == ''
})

const percent = computed<number>(() => {
	return range(0, 100, normalizeNumber(props.percentage, 30))
})

const size = computed<string>(() => {
	return addUnit(props.width)
})

const stroke = computed<string>(() => {
	return addUnit(props.strokeWidth)
})

const rootStyle = computed((): UTSJSONObject => {
	const base = {} as UTSJSONObject
	base['width'] = size.value
	base['height'] = size.value
	const custom = addStyle(props.customStyle) as UTSJSONObject
	return deepMerge(base, custom) as UTSJSONObject
})

const trackStyle = computed((): UTSJSONObject => {
	return {
		width: size.value,
		height: size.value,
		borderWidth: stroke.value,
		borderColor: props.inactiveColor
	} as UTSJSONObject
})

const textStyle = computed((): UTSJSONObject => {
	const style = {} as UTSJSONObject
	if (props.activeColor != '') {
		style['color'] = props.activeColor
	}
	return style
})

function buildFillStyle(deg: number): UTSJSONObject {
	const style = {} as UTSJSONObject
	style['width'] = size.value
	style['height'] = size.value
	style['borderWidth'] = stroke.value
	if (props.activeColor != '') {
		style['borderTopColor'] = props.activeColor
		style['borderRightColor'] = props.activeColor
	}
	style['borderBottomColor'] = 'transparent'
	style['borderLeftColor'] = 'transparent'
	style['transform'] = `rotate(${deg.toString()}deg)`
	return style
}

const rightStyle = computed((): UTSJSONObject => {
	let deg: number = percent.value * 3.6 - 135
	if (deg > 45) {
		deg = 45
	}
	if (deg < -135) {
		deg = -135
	}
	return buildFillStyle(deg)
})

const leftStyle = computed((): UTSJSONObject => {
	let deg: number = percent.value * 3.6 - 135
	if (deg < 45) {
		deg = 45
	}
	if (deg > 225) {
		deg = 225
	}
	return buildFillStyle(deg)
})
</script>

<style lang="scss" scoped>
.up-circle-progress {
	position: relative;
	display: flex;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;

	&__track {
		position: absolute;
		top: 0;
		left: 0;
		box-sizing: border-box;
		border-radius: 50%;
		border-style: solid;
	}

	&__mask {
		position: absolute;
		top: 0;
		width: 50%;
		height: 100%;
		overflow: hidden;
		box-sizing: border-box;

		&--right {
			right: 0;
		}

		&--left {
			left: 0;
		}
	}

	&__fill {
		position: absolute;
		top: 0;
		box-sizing: border-box;
		border-radius: 50%;
		border-style: solid;
		border-bottom-color: transparent;
		border-left-color: transparent;

		&--primary {
			border-top-color: $up-primary;
			border-right-color: $up-primary;
		}

		&--right {
			right: 0;
		}

		&--left {
			left: 0;
		}
	}

	&__content {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		z-index: 2;
	}

	&__text {
		font-size: 14px;
		font-weight: 500;

		&--primary {
			color: $up-primary;
		}
	}
}
</style>
