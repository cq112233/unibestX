<template>
	<view class="up-circle-progress" :style="rootCircleStyle">
		<view class="up-circle-progress__inner" :style="innerStyle">
			<slot>
				<text class="up-circle-progress__text" :style="{ color: activeColor }">{{ percent }}%</text>
			</slot>
		</view>
	</view>
</template>

<script setup vapor lang="uts">
import { computed } from 'vue'
import { addStyle, addUnit, deepMerge } from '../../libs/function/index.uts'

defineOptions({
	name: 'up-circle-progress'
})

const props = defineProps({
	percentage: {
		type: [String, Number],
		default: 30
	},
	activeColor: {
		type: String,
		default: '#2979ff'
	},
	inactiveColor: {
		type: String,
		default: '#e5e9f2'
	},
	width: {
		type: [String, Number],
		default: 80
	},
	strokeWidth: {
		type: [String, Number],
		default: 6
	},
	customStyle: {
		type: Object,
		default: () : UTSJSONObject => ({})
	}
})

const percent = computed<number>(() => {
	const val = typeof props.percentage === 'number' ? (props.percentage as number) : parseFloat(props.percentage.toString())
	return isNaN(val) ? 0 : Math.max(0, Math.min(100, val))
})

const sizePx = computed<number>(() => {
	const raw = props.width
	if (typeof raw === 'number') return raw as number
	const parsed = parseFloat(raw.toString())
	return isNaN(parsed) ? 80 : parsed
})

const strokePx = computed<number>(() => {
	const raw = props.strokeWidth
	if (typeof raw === 'number') return raw as number
	const parsed = parseFloat(raw.toString())
	return isNaN(parsed) ? 6 : parsed
})

const circleStyle = computed<UTSJSONObject>(() => {
	const style = {} as UTSJSONObject
	const size = sizePx.value.toString() + 'px'
	style['width'] = size
	style['height'] = size
	style['borderRadius'] = size
	style['borderWidth'] = strokePx.value.toString() + 'px'
	style['borderStyle'] = 'solid'
	style['borderColor'] = percent.value > 0 ? props.activeColor : props.inactiveColor
	return style
})

const rootCircleStyle = computed((): UTSJSONObject => {
	const custom = addStyle(props.customStyle) as UTSJSONObject
	const circle = circleStyle.value
	return deepMerge(circle, custom) as UTSJSONObject
})

const innerStyle = computed<UTSJSONObject>(() => {
	const style = {} as UTSJSONObject
	return style
})
</script>

<style lang="scss" scoped>
.up-circle-progress {
	display: flex;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;

	&__inner {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	&__text {
		font-size: 14px;
		font-weight: 500;
	}
}
</style>
