<script setup vapor lang="uts">
import { computed, ref, watch, onMounted } from 'vue'









import WebviewEchart from './uts/WebviewEchart.uts'
import { getRandomId, addUnitRpx } from './uts/util.uts'


defineOptions({
  name: 'e-chart'
})

const emit = defineEmits(['ready'])

const props = defineProps({
  width: {
    type: [Number, String],
    default: '100%',
  },
  height: {
    type: [Number, String],
    default: 600,
  },
  disableScroll: {
    type: Boolean,
    default: false,
  },
  theme: {
    type: String,
    default: '',
  }
})


const echartObj = ref<WebviewEchart | null>(null)







const canvasId = getRandomId()

const canvasStyle = computed<string>(() => {
  return `width:${addUnitRpx(props.width)};height:${addUnitRpx(props.height)}`
})

function onCanvasReady() {
  emit('ready')
}














































































































function initAPP(option: UTSJSONObject): any {
  const ctx = uni.createWebviewContext(canvasId)
  if (ctx == null) {
    uni.__f__('error','at uni_modules/e-chart/components/e-chart/e-chart.uvue:172','初始化echart的webview失败')
    return null
  }
  echartObj.value = new WebviewEchart(ctx)
  echartObj.value!.init(props.theme)
  setOption(option)
  return { echartObj: echartObj.value }
}


async function init(option: UTSJSONObject): Promise<any> {









  return initAPP(option) as UTSJSONObject

}

function getEchartObj(): any {

  return echartObj.value




}

function setOption(option: UTSJSONObject) {

  echartObj.value?.setOption(option)




}

function getOption(): Promise<UTSJSONObject> {
  return new Promise<UTSJSONObject>(resolve => {

    echartObj.value!.getOption(resolve)




  })
}

function getWidth(): Promise<number> {
  return new Promise<number>(resolve => {

    echartObj.value!.getWidth((e: UTSJSONObject) => {
      resolve(e['width'] as number)
    })




  })
}

function getHeight(): Promise<number> {
  return new Promise<number>(resolve => {

    echartObj.value!.getHeight((e: UTSJSONObject) => {
      resolve(e['height'] as number)
    })




  })
}

function resize() {

  echartObj.value?.resize()










}




























































function canvasToTempFilePath(): Promise<string> {
  return new Promise<string>((resolve, reject) => {
    const fail = (e: UTSJSONObject) => {
      uni.showModal({ title: '保存失败', content: JSON.stringify(e), showCancel: false })
      reject(e)
    }

































    echartObj.value?.canvasToTempFilePath({
      success: (e: UTSJSONObject) => {
        const base64 = e['base64'] as string
        const fileSystemManager = uni.getFileSystemManager()
        const filePath = `${uni.env.USER_DATA_PATH}/${Date.now()}.png`
        fileSystemManager.writeFile({
          filePath,
          encoding: "base64",
          data: base64.replace('data:image/png;base64,', ''),
          success: (_res) => {
            resolve(filePath)
          },
          fail: (err) => {
            fail(err as UTSJSONObject)
          }
        } as WriteFileOptions)
      },
      fail
    })

  })
}

function showLoading(option: UTSJSONObject) {

  echartObj.value?.showLoading(option)




}

function hideLoading() {

  echartObj.value?.hideLoading()




}


function onWebviewMsg(e: UniWebViewMessageEvent) {
  echartObj.value?.onWebviewMsg(e)
}

function onWebviewError(e: UniWebViewErrorEvent) {
  uni.__f__('error','at uni_modules/e-chart/components/e-chart/e-chart.uvue:411','onWebviewError:', e)
}


watch(() => props.width, () => {
  resize()
})

watch(() => props.height, () => {
  resize()
})

onMounted(() => {

  onCanvasReady()

})

defineExpose({
  init,
  setOption,
  getOption,
  getWidth,
  getHeight,
  resize,
  getEchartObj,
  canvasToTempFilePath,
  showLoading,
  hideLoading,
  onCanvasReady
})
</script>

<template>










  

















  <web-view 
    :id="canvasId"
    :style="canvasStyle"
    :bounces="false"
    :horizontalScrollBarAccess="false"
    :verticalScrollBarAccess="false"
    :webview-styles="{progress: false}"
    src="/uni_modules/e-chart/static/app/webview.html"
    @load="onCanvasReady"
    @error="onWebviewError"
    @message="onWebviewMsg"
   />

</template>