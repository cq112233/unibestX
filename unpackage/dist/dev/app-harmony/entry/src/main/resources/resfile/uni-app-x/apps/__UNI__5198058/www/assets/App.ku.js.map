<style>

</style>
<template>
  <!-- 应用全局骨架与皮肤容器，通过 CSS 变量绑定响应式主题色 / 暗黑模式 -->
  <view class="root-container flex flex-col flex-1" style="flex: 1;" :style="themeStyle">
    <!-- 页面内容滚动容器 -->
    <scroll-view direction="vertical" class="flex-1" style="flex: 1;">
      <slot></slot>
    </scroll-view>
    <!-- 仅在当前页面为底部 Tabbar 页面时渲染自定义导航栏 -->
    <Tabbar v-if="isCurrentPageTabbar" />
    <!-- 全局统一绑定的 Toast 轻提示弹窗组件 -->
    <up-toast ref="uToastRef" />
  </view>
</template>

<script setup lang="uts">
import Tabbar from '@/src/tabbar/index.uvue';
import { useAppStore } from '@/src/store';
import { isPageTabbar, syncCurIdxByCurrentPage } from '@/src/tabbar/store';
import { registerToast, unregisterToast } from '@/src/utils/toast';
import { getThemeTokens } from '@/src/utils/theme';
import type { ComponentPublicInstance } from 'vue';
import { computed, nextTick, onBeforeMount, onMounted, onUnmounted, ref, watch } from 'vue';

// 激活应用状态管理 Store
const appStore = useAppStore();

// 主题样式变量：亮 / 暗两套，跟随 appStore.state.isDark 响应式切换
const themeStyle = computed((): UTSJSONObject => {
  const dark = appStore.state.isDark;
  return {
    '--theme-color': appStore.state.theme,
    '--bg-color': getThemeTokens(dark).bgContent,
    '--text-color': dark ? '#e2e8f0' : '#1e293b',
    '--text-secondary': dark ? '#94a3b8' : '#64748b',
    '--card-bg': dark ? '#1e293b' : '#ffffff',
    '--border-color': dark ? '#334155' : '#e2e8f0'
  } as UTSJSONObject;
});

// 控制当前页面是否需要显示底部导航栏
const isCurrentPageTabbar = ref(false);
// 挂载全局 Toast 组件的 DOM/组件实例引用
const uToastRef = ref<ComponentPublicInstance | null>(null);

// 监听 uToastRef 变化，第一时间注册到全局 Toast 栈
watch(uToastRef, (val: ComponentPublicInstance | null) => {
  if (val != null) {
    registerToast(val!);
  }
}, { immediate: true });

// 页面显示钩子：解析当前路由，动态控制导航栏显示及同步选中索引
onBeforeMount(() => {
  const pages = getCurrentPages();
  if (pages.length > 0) {
    const route = pages[pages.length - 1].route;
    if (route != null && route.length > 0) {
      const path = route.startsWith('/') ? route : `/${route}`;
      const isTabbar = isPageTabbar(path);
      isCurrentPageTabbar.value = isTabbar;
      // 如果是 Tabbar 路由，同步底部导航的激活索引
      if (isTabbar) {
        syncCurIdxByCurrentPage();
      }
    }
  }
  if (uToastRef.value != null) {
    registerToast(uToastRef.value!);
  }
});

// 组件挂载钩子：注册全局 Toast
onMounted(() => {
  if (uToastRef.value != null) {
    registerToast(uToastRef.value!);
  }
  nextTick(() => {
    if (uToastRef.value != null) {
      registerToast(uToastRef.value!);
    }
  });
});

// 组件销毁钩子：反注册 Toast 以释放内存防内存泄漏
onUnmounted(() => {
  if (uToastRef.value != null) {
    unregisterToast(uToastRef.value!);
  }
});
</script>

<style lang="scss" scoped>
.root-container {
  background-color: var(--bg-color, #f5f6fa);
}
</style>
