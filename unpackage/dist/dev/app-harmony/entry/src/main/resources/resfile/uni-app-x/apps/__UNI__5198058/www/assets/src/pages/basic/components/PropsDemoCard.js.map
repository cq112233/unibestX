<template>
  <Card title="父子组件传参 & 具名插槽演示">
    <!-- 父组件状态展示面板 -->
    <view class="wtu-vxgnz7-0 rounded-12px p-14px mb-14px border-width-1px border-style-solid border-color-[#bfdbfe]">
      <text class="text-14px wtu-sv7fhw-1 wtu-44jmxl-2 mb-6px">👨‍👩‍👧 父组件状态管理面板</text>

      <view class="wtu-1qcvxlr-3 wtu-i6zy5z-4 mb-4px">
        <text class="text-12px wtu-1581zln-5">父组件 Count 变量: </text>
        <text class="text-14px wtu-sv7fhw-1 wtu-1cwqag0-6 ml-6px">{{ parentCount }}</text>
      </view>

      <view class="wtu-1qcvxlr-3 wtu-i6zy5z-4 mb-10px">
        <text class="text-12px wtu-1581zln-5">接收到的子组件消息: </text>
        <text class="text-12px wtu-sv7fhw-1 wtu-cj9lbh-7 ml-6px">{{ childMessage }}</text>
      </view>

      <!-- 父组件主动修改数据操作组 -->
      <view class="wtu-1qcvxlr-3 wtu-i6zy5z-4">
        <view class="wtu-1t9ug01-8 rounded-6px px-10px h-30px wtu-1qcvxlr-3 wtu-i6zy5z-4 wtu-19aj3kn-9 mr-8px" @click="addFiveFromParent">
          <text class="wtu-1c2l3ni-a text-12px">父组件直接 Count + 5</text>
        </view>
        <view class="wtu-1h73awj-b rounded-6px px-10px h-30px wtu-1qcvxlr-3 wtu-i6zy5z-4 wtu-19aj3kn-9" @click="resetParent">
          <text class="wtu-1c2l3ni-a text-12px">父组件重置状态</text>
        </view>
      </view>
    </view>

    <!-- 子组件嵌套调用区 -->
    <ChildDemoBox
      title="组件通信演示子节点"
      :count="parentCount"
      :tags="tagList"
      @add="onChildAdd"
      @reset="onChildReset"
      @send-msg="onChildSendMsg"
    >
      <!-- 1. 具名头部插槽 #header -->
      <template #header>
        <view class="wtu-1qcvxlr-3 wtu-i6zy5z-4 wtu-16203my-c">
          <text class="text-14px wtu-sv7fhw-1 wtu-161zm7w-d">🏷️ 父组件填入的具名 Header 插槽</text>
          <text class="text-11px wtu-1581zln-5 wtu-v9l0kh-e px-6px py-2px rounded-4px">自定义 Header</text>
        </view>
      </template>

      <!-- 2. 具名传参/作用域插槽 #itemSlot (从子组件接收 item & index) -->
      <template #itemSlot="{ item, index }">
        <view class="wtu-1qcvxlr-3 wtu-i6zy5z-4 wtu-1ue7bt4-f rounded-6px p-8px border-width-1px border-style-solid border-color-[#bbf7d0]">
          <text class="text-11px wtu-sv7fhw-1 wtu-1gdtqyh-g mr-6px">#{{ (index as number) + 1 }}</text>
          <text class="text-12px wtu-165ep59-h wtu-1nu791o-i">{{ item }}</text>
          <text class="text-10px wtu-1qit6r8-j wtu-1aizezg-k">具名Slot传参: {{ item }}</text>
        </view>
      </template>

      <!-- 3. 具名底部插槽 #footer -->
      <template #footer>
        <view class="wtu-1qcvxlr-3 wtu-i6zy5z-4 wtu-16203my-c">
          <text class="text-11px wtu-ntizu3-l">📌 父组件填入的具名 Footer 插槽</text>
          <text class="text-11px wtu-1eoi3xb-m">双向通信验证成功</text>
        </view>
      </template>
    </ChildDemoBox>
  </Card>
</template>

<script setup lang="uts">
import { ref } from 'vue';
import Card from './Card.uvue';
import ChildDemoBox from './ChildDemoBox.uvue';

const parentCount = ref<number>(10);
const childMessage = ref<string>('暂无子组件消息');
const tagList = ref<Array<string>>(['响应式 Props 传递', 'Emits 事件监听与回传', '具名 Header/Footer 插槽', '具名 Slot 作用域传参']);

function onChildAdd(delta: number) {
  parentCount.value += delta;
}

function onChildReset() {
  parentCount.value = 0;
  childMessage.value = '已被子组件重置为 0';
}

function onChildSendMsg(msg: string) {
  childMessage.value = msg;
}

function addFiveFromParent() {
  parentCount.value += 5;
}

function resetParent() {
  parentCount.value = 10;
  childMessage.value = '已重置为初始状态';
}
</script>

