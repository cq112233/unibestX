.demo-list-cell {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16px;
  background-color: #ffffff;
  border-bottom: 1px solid #f5f5f5;
}
.demo-list-cell-avatar {
  width: 40px;
  height: 40px;
  border-radius: 4px;
