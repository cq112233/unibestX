<template>
	<view
	    v-if="show"
	    :style="finalStyle"
	    class="up-back-top"
	    @click="backToTop"
	>
		<slot>
			<up-icon
			    :name="icon"
			    size="22"
			    color="#2563eb"
			></up-icon>
			<text
			    v-if="text != ''"
			    class="up-back-top__text"
			>{{text}}</text>
		</slot>
	</view>
</template>

<script setup vapor lang="uts">
import { computed } from 'vue'
import { addStyle, deepMerge } from '../../libs/function/index'

defineOptions({
  name: 'up-back-top'
})

const props = defineProps({
  mode: {
    type: String,
    default: 'circle'
  },
  icon: {
    type: String,
    default: 'arrow-upward'
  },
  text: {
    type: String,
    default: ''
  },
  duration: {
    type: [String, Number],
    default: 100
  },
  scrollTop: {
    type: [String, Number],
    default: 0
  },
  top: {
    type: [String, Number],
    default: 100
  },
  bottom: {
    type: [String, Number],
    default: 80
  },
  right: {
    type: [String, Number],
    default: 20
  },
  zIndex: {
    type: [String, Number],
    default: 999
  },
  iconStyle: {
    type: Object,
    default: () => ({})
  },
  customStyle: {
    type: Object,
    default: () => ({})
  }
})

const emit = defineEmits(['click'])

const show = computed<boolean>(() => {
  const sVal = (props.scrollTop ?? 0).toString()
  const tVal = (props.top ?? 100).toString()
  const sTop = parseFloat(sVal)
  const targetTop = parseFloat(tVal)
  if (isNaN(sTop)) return false
  const threshold = isNaN(targetTop) ? 100 : targetTop
  return sTop >= threshold
})

const finalStyle = computed<UTSJSONObject>(() => {
  const bStr = (props.bottom ?? 80).toString()
  const rStr = (props.right ?? 20).toString()
  const bVal = bStr.includes('px') ? bStr : (bStr + 'px')
  const rVal = rStr.includes('px') ? rStr : (rStr + 'px')
  const zVal = parseInt((props.zIndex ?? 999).toString())

  const style = {
    position: 'fixed',
    bottom: bVal,
    right: rVal,
    width: '44px',
    height: '44px',
    zIndex: isNaN(zVal) ? 999 : zVal,
    display: 'flex',
    flexDirection: 'column',
    alignItems: 'center',
    justifyContent: 'center',
    backgroundColor: '#ffffff',
    borderRadius: props.mode === 'circle' ? '100px' : '8px',
    boxShadow: '0 4px 12px rgba(0, 0, 0, 0.15)',
    borderWidth: '1px',
    borderStyle: 'solid',
    borderColor: '#e2e8f0'
  } as UTSJSONObject

  return deepMerge(style, addStyle(props.customStyle as UTSJSONObject)) as UTSJSONObject
})

function backToTop(e: any) {
  uni.pageScrollTo({
    scrollTop: 0,
    duration: parseInt(props.duration.toString()),
    fail: (_: any) => {}
  })
  emit('click', e)
}
</script>

<style scoped>
.up-back-top__text {
	font-size: 10px;
	color: #2563eb;
	margin-top: 2px;
}
</style>