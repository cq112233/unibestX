<template>
  <Card title="触感与工具">
    <view class="rounded-12px p-16px mb-16px border-width-1px border-style-solid border-color-[#e2e8f0]">
      <text class="text-12px wtu-xlfis6-0 mb-8px">剪贴板测试文本</text>
      <input
        v-model="copyText"
        placeholder="请输入要复制的文本"
        class="h-38px wtu-44c3cb-1 rounded-6px px-12px border-width-1px border-style-solid border-color-[#cbd5e1] text-14px wtu-lwq7o6-2 mb-12px"
      />
      <view class="wtu-1phhh09-3 h-38px rounded-8px wtu-1km86q6-4 wtu-snabsj-5 wtu-1e9fgzq-6 wtu-15f70xm-7 wtu-1kekspa-8" @click="handleCopy">
        <text class="wtu-199nxoz-9 text-14px wtu-17exkt3-a">复制测试文本</text>
      </view>
    </view>

    <view class="wtu-1phhh09-3 h-44px rounded-8px wtu-nwcnqo-b wtu-snabsj-5 wtu-1e9fgzq-6 wtu-15f70xm-7 wtu-1kekspa-8" @click="triggerVibration">
      <text class="wtu-199nxoz-9 text-14px wtu-17exkt3-a">短震动反馈</text>
    </view>
  </Card>
</template>

<script setup lang="uts">
import Card from '../../basic/components/Card.uvue';
import { ref } from 'vue';

const copyText = ref('Hello unibestX!');

function triggerVibration() {

  uni.vibrateShort({
    type: 'light',
    success: () => {
      uni.showToast({ title: '已触发短震动', icon: 'none' });
    },
    fail: () => {
      uni.showToast({ title: '震动触发失败', icon: 'none' });
    }
  });







}

function handleCopy() {
  if (copyText.value === '')
    return;
  uni.setClipboardData({
    data: copyText.value,
    success: () => {
      uni.showToast({
        title: '复制成功',
        icon: 'success'
      });
    }
  });
}
</script>

