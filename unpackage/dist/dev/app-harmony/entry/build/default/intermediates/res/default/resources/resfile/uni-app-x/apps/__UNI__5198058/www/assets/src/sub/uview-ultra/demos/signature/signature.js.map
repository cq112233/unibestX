  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  margin-top: 10px;
}
.sig-btn {
  margin-left: 10px;
}
.preview-image {
  width: 100%;
  height: 160px;
  background-color: #f8fafc;
  border-width: 1px;
  border-style: solid;
  border-color: #e2e8f0;
  border-radius: 8px;
}
.log-box {
  padding: 10px;
