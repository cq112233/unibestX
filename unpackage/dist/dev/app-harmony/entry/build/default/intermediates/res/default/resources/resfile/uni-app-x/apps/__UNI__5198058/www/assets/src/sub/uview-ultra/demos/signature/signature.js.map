<template>
  <AppKu>

  <LayoutComponent :navigation-style="'custom'" :navigation-bar-title-text="'up-signature 签名'">

  <view class="page-container bg-_b_hf8fafc_B min-h-screen pb-_b30px_B">
    <NavBar title="up-signature 签名"></NavBar>
    <view class="p-_b16px_B">
      <!-- 1. 基本用法 -->
      <view class="demo-block">
        <up-title class="demo-title">
          <text class="demo-title-text">基本用法（带工具栏，可撤销/清空/调粗细/换颜色/导出）</text>
        </up-title>
        <up-signature
          ref="sigRef1"
          :width="300"
          :height="200"
          :bg-color="bgColor"
          @confirm="onConfirm"
          @error="onError"
          @clear="onClear"
        ></up-signature>
      </view>

      <!-- 2. 自定义样式（无工具栏） -->
      <view class="demo-block mt-_b12px_B">
        <up-title class="demo-title">
          <text class="demo-title-text">自定义样式（红色笔、粗细 5、隐藏工具栏）</text>
        </up-title>
        <up-signature
          ref="sigRef2"
          :width="300"
          :height="160"
          bg-color="#fff7e6"
          color="#ff4d4f"
          :thickness="5"
          :show-toolbar="false"
          @confirm="onConfirm"
          @error="onError"
        ></up-signature>
        <view class="sig-actions">
          <up-button text="清空" type="primary" plain size="small" class="sig-btn" @click="clearSig2"></up-button>
          <up-button text="导出" type="primary" size="small" class="sig-btn" @click="exportSig2"></up-button>
        </view>
      </view>

      <!-- 3. 导出预览 -->
      <view class="demo-block mt-_b12px_B" v-if="exportPath != ''">
        <up-title class="demo-title">
          <text class="demo-title-text">导出结果预览</text>
        </up-title>
        <image :src="exportPath" class="preview-image" mode="aspectFit"></image>
      </view>

      <!-- 4. 说明 -->
      <view class="demo-block mt-_b12px_B">
        <up-title class="demo-title">
          <text class="demo-title-text">说明</text>
        </up-title>
        <text class="demo-text">
          up-signature 已适配 vdom/vapor 双模式：App 端（安卓/iOS）基于 DrawableContext 原生绘制，鸿蒙基于 canvas 组件，H5 支持触摸与鼠标绘制、小程序沿用 canvas 2d 实现；支持 undo / clearCanvas / redraw / exportSignature 实例方法，confirm 事件返回导出的图片路径，error 事件返回错误信息。
        </text>
      </view>

      <view class="log-box mt-_b10px_B">
        <text class="log-text">{{ eventLog }}</text>
      </view>
    </view>
  </view>

  </LayoutComponent>

  </AppKu>
</template>

<script setup vapor lang="uts">
import AppKu from '@/App.ku.uvue'
import LayoutComponent from '@/src/layouts/default.uvue'
import { ref } from 'vue';
const bgColor = ref<string>('#ffffff');

const sigRef1 = ref(null as ComponentPublicInstance | null);
const sigRef2 = ref(null as ComponentPublicInstance | null);
const exportPath = ref<string>('');
const eventLog = ref<string>('绘制完成后点击工具栏对勾导出，confirm 事件返回图片路径');

function onConfirm(path: string) {
  exportPath.value = path;
  eventLog.value = `confirm => ${path}`;
}

function onError(msg: any | null) {
  const text = msg == null ? 'unknown' : msg.toString();
  eventLog.value = `error => ${text}`;
}

function onClear() {
  eventLog.value = 'clear => 已清空';
}

function clearSig2() {
  const sig = sigRef2.value;
  if (sig != null) {
    sig.$callMethod('clearCanvas');
    eventLog.value = 'clear => 第二块签名已清空';
  }
}

function exportSig2() {
  const sig = sigRef2.value;
  if (sig != null) {
    sig.$callMethod('exportSignature');
  }
}
</script>

<style lang="scss" scoped>
