<template>
  <Card :title="cardTitle">
    <!-- 预览区域 -->
    <view class="rounded-12px p-16px mb-16px border-width-1px border-style-solid border-color-__e2e8f0_ items-center">
      <text class="text-12px text-__94a3b8_ mb-12px">{{ themePreviewText }}</text>

      <!-- Rice UI 组件联动展示 (绑定 currentTheme 响应式换肤) -->
      <view class="flex-row items-center justify-around w-full mb-12px">
        <rice-button type="primary" size="small" :color="currentTheme">
          主要按钮
        </rice-button>
        <rice-tag type="primary" :color="currentTheme">
          彩色标签
        </rice-tag>
        <rice-switch :model-value="switchVal" :active-color="currentTheme" @change="onSwitchChange" />
      </view>

      <view
        class="mt-6px mx-auto w-full h-40px rounded-8px flex flex-row items-center justify-center"
        :style="{ backgroundColor: currentTheme }"
      >
        <text class="text-__ffffff_ text-14px font-bold">{{ themeButtonText }}</text>
      </view>
    </view>

    <!-- 暗黑/明亮模式切换 -->
    <view class="flex-row items-center justify-between py-10px px-4px mb-8px border-width-1px border-solid border-color-__f1f5f9_ rounded-8px bg-__f8fafc_">
      <view class="flex-row items-center">
        <text class="text-14px mr-6px">{{ isDarkMode ? '🌙' : '☀️' }}</text>
        <text class="text-13px text-__334155_ font-medium">{{ isDarkMode ? '当前：暗黑模式' : '当前：明亮模式' }}</text>
      </view>
      <view
        class="px-12px py-6px rounded-6px"
        :class="isDarkMode ? 'bg-__3b82f6_' : 'bg-__e2e8f0_'"
        @click="toggleDarkMode"
      >
        <text class="text-12px font-bold" :class="isDarkMode ? 'text-white' : 'text-__475569_'">
          {{ isDarkMode ? '切换为明亮' : '切换为暗黑' }}
        </text>
      </view>
    </view>

    <!-- 品牌主色选择区 -->
    <text class="text-12px text-__64748b_ font-medium mb-8px">选择主题主色调（响应式驱动）：</text>
    <view class="flex-row justify-between py-6px mb-12px">
      <view
        v-for="(item, index) in colorOptions"
        :key="index"
        class="w-40px h-40px rounded-20px items-center justify-center"
        :style="{
          backgroundColor: item,
          borderWidth: currentTheme == item ? '3px' : '0px',
          borderStyle: 'solid',
          borderColor: '#1e293b',
        }"
        @click="changeTheme(item)"
      >
        <text
          v-if="currentTheme == item"
          class="text-16px text-white font-bold"
        >
          ✓
        </text>
      </view>
    </view>

    <!-- 原生平台换肤原理与限制说明 -->
    <view class="p-12px rounded-8px bg-__f1f5f9_ border-width-1px border-solid border-color-__e2e8f0_">
      <view class="flex-row items-center mb-6px">
        <text class="text-13px font-bold text-__1e293b_">💡 uni-app X 原生换肤机制说明</text>
      </view>
      <text class="text-11px text-__64748b_ leading-18px mb-4px">
        1. 【App原生限制】Android/iOS原生渲染引擎下，组件映射为原生控件，不支持:root伪类且CSS变量无法跨组件穿透触发重绘。
      </text>
      <text class="text-11px text-__64748b_ leading-18px mb-4px">
        2. 【动态换肤做法】组件需通过Vue响应式属性传递（如 :color="currentTheme"、:active-color="currentTheme"）以实现跨端响应。
      </text>
      <text class="text-11px text-__64748b_ leading-18px">
        3. 【静态默认色修改】直接在 src/style/theme.css 的 .rice-theme-light 中修改 --rice-primary-color。
      </text>
    </view>
  </Card>
</template>

<script setup vapor lang="uts">
import Card from './Card.uvue'
import { useAppStore } from '@/src/store/index.uts'
import { $t, t } from '@/src/utils/i18n'
import { isDark, setTheme as setRiceTheme } from '@/uni_modules/rice-ui'
import { computed, ref } from 'vue'

const appStore = useAppStore()
const switchVal = ref<boolean>(true)

const cardTitle = computed((): string => $t('basic.themeTitle'))
const themePreviewText = computed((): string => $t('basic.themePreview'))
const themeButtonText = computed((): string => $t('basic.themeButton'))

const currentTheme = computed((): string => {
  return appStore.state.theme
})

const isDarkMode = computed((): boolean => {
  return isDark.value
})

const colorOptions = [
  '#37c2bc',
  '#0957DE',
  '#10b981',
  '#f43f5e',
  '#f97316',
]

function toggleDarkMode() {
  if (isDarkMode.value) {
    setRiceTheme('light')
  }
  else {
    setRiceTheme('dark')
  }
}

function onSwitchChange(val: boolean) {
  switchVal.value = val
}

function changeTheme(color: string) {
  appStore.setTheme(color)

  uni.showToast({
    title: t('basic.themeSuccess', null),
    icon: 'none',
    duration: 1500,
  })
}
</script>

<style data-scoped="gdhidab61o1k04ghnp2">
