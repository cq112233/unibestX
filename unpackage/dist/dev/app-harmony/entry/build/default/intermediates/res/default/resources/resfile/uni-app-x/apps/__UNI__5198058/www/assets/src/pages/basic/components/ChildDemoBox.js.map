<template>
  <view class="wtu-gcabbq-0 wtu-1v0f2ef-1 wtu-j5w8hi-2 wtu-1oapzb6-3 wtu-efe1oe-4 wtu-tbqpp4-5">
    <!-- 1. 具名插槽：头部 -->
    <view class="wtu-1k2269n-6 wtu-1qjt5t5-7 wtu-efe1oe-4 wtu-vp8uuf-8 wtu-1cjjz3f-9">
      <slot name="header">
        <!-- 具名插槽默认内容 -->
        <text class="wtu-5zjli3-a wtu-1nivbe9-b wtu-15nsgd4-c">📦 {{ title }}（默认 Header）</text>
