    </view>

    <!-- 2. 父传子 Props 展示区域 -->
    <view class="wtu-ucwwyt-d wtu-182oteh-e wtu-1kpj8o8-f wtu-1adrg6y-g">
      <text class="wtu-1pxnoyx-h wtu-1nivbe9-b wtu-c3ez2v-i wtu-yp9fxe-j">【父传子 Props 动态接收】</text>
      <view class="wtu-x7nkyg-k wtu-ix6v4k-l">
        <text class="wtu-1pxnoyx-h wtu-grng8o-m">父组件传递的 Count: </text>
        <text class="wtu-5zjli3-a wtu-1nivbe9-b wtu-18ekrle-n wtu-9yebru-o">{{ count }}</text>
      </view>
    </view>

    <!-- 3. 具名传参插槽 / 作用域插槽展示 -->
    <view class="wtu-ucwwyt-d wtu-182oteh-e wtu-1kpj8o8-f wtu-1adrg6y-g">
      <text class="wtu-1pxnoyx-h wtu-1nivbe9-b wtu-c3ez2v-i wtu-hisbzo-p">【具名作用域插槽 (Slot 向父组件传参)】</text>
      <view v-for="(item, index) in tags" :key="index" class="wtu-hisbzo-p">
        <!-- 具名传参插槽 itemSlot：向父组件暴露 item 和 index 参数 -->
        <slot name="itemSlot" :item="item" :index="index">
          <!-- 默认渲染逻辑 -->
          <view class="wtu-zipktt-q wtu-l9uwt0-r wtu-2vrnhv-s">
            <text class="wtu-1pxnoyx-h wtu-grng8o-m">Tag {{ index + 1 }}: {{ item }}</text>
          </view>
        </slot>
      </view>
    </view>

    <!-- 4. 子传父 Emits 触发按钮区域 -->
    <view class="wtu-1k2269n-6 wtu-182oteh-e wtu-1kpj8o8-f wtu-1adrg6y-g">
      <text class="wtu-1pxnoyx-h wtu-1nivbe9-b wtu-c3ez2v-i wtu-1rszb3q-t">【子传父 Emits 事件触发】</text>
      <view class="wtu-x7nkyg-k wtu-jpge2z-u wtu-ix6v4k-l wtu-1rszb3q-t">
        <view class="wtu-812ws7-v wtu-s60y7a-w wtu-1uy7k1u-x wtu-1i4pv7e-y wtu-x7nkyg-k wtu-ix6v4k-l wtu-1pd1px4-z wtu-1udz6jo-10" @click="handleAdd">
          <text class="wtu-ih0clp-11 wtu-1pxnoyx-h">触发 Count + 1</text>
        </view>
        <view class="wtu-812ws7-v wtu-4dipnu-12 wtu-1uy7k1u-x wtu-1i4pv7e-y wtu-x7nkyg-k wtu-ix6v4k-l wtu-1pd1px4-z wtu-9yebru-o" @click="handleReset">
          <text class="wtu-ih0clp-11 wtu-1pxnoyx-h">触发 重置事件</text>
        </view>
      </view>

      <view class="wtu-zipktt-q wtu-1uy7k1u-x wtu-1y1vdmh-13 wtu-1oapzb6-3 wtu-efe1oe-4 wtu-6plw78-14 wtu-x7nkyg-k wtu-ix6v4k-l wtu-jpge2z-u">
        <input v-model="inputMsg" placeholder="输入要送回父组件的消息" class="wtu-1pxnoyx-h wtu-812ws7-v wtu-8x6qng-15 wtu-1w52wo5-16 wtu-182oteh-e wtu-l9uwt0-r wtu-1oapzb6-3 wtu-efe1oe-4 wtu-tbqpp4-5" />
        <view class="wtu-aufsc6-17 wtu-1uy7k1u-x wtu-8x6qng-15 wtu-xmcsy6-18 wtu-x7nkyg-k wtu-ix6v4k-l wtu-1pd1px4-z wtu-lfb8b4-19" @click="handleSendMsg">
          <text class="wtu-ih0clp-11 wtu-1pxnoyx-h">发送给父组件</text>
        </view>
      </view>
    </view>

    <!-- 5. 具名插槽：底部 -->
    <view class="wtu-c2r1er-1a wtu-11ta45z-1b wtu-efe1oe-4 wtu-1k4o3ax-1c">
      <slot name="footer">
        <text class="wtu-1h5fdje-1d wtu-1xb3h6w-1e">（默认 Footer）</text>
      </slot>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue';
import type { PropType } from 'vue';

defineProps({
  title: {
    type: String,
    default: '通信子组件'
  },
  count: {
    type: Number,
    default: 0
  },
  tags: {
    type: Array as PropType<Array<string>>,
    default: (): Array<string> => ['Vue3', 'uni-app X', 'UTS'] as Array<string>
  }
});

const emit = defineEmits(['add', 'reset', 'send-msg']);

const inputMsg = ref('Hello Parent from Child!');

function handleAdd() {
  emit('add', 1);
}

function handleReset() {
  emit('reset');
}

function handleSendMsg() {
  if (inputMsg.value.trim() == '') {
    uni.showToast({
      title: '请输入消息内容',
      icon: 'none'
    });
    return;
  }
  emit('send-msg', inputMsg.value);
  uni.showToast({
    title: '消息已发送',
    icon: 'success'
  });
}
</script>

