      />
      <view class="flex-row items-center mb-8px">
        <view class="flex-1 h-36px rounded-8px bg-__14b8a6_ flex flex-row items-center justify-center mr-8px" @click="handleDesEncrypt">
          <text class="text-__ffffff_ text-13px font-bold">加密</text>
        </view>
        <view class="flex-1 h-36px rounded-8px bg-__f97316_ flex flex-row items-center justify-center" @click="handleDesDecrypt">
          <text class="text-__ffffff_ text-13px font-bold">解密</text>
        </view>
      </view>
      <text class="text-12px text-__64748b_">加密结果 (hex):</text>
      <text class="result-text text-12px font-medium text-__334155_ mt-2px" style="font-family: monospace;">{{ desEncryptResult }}</text>
      <text class="text-12px text-__64748b_ mt-8px">解密结果:</text>
      <text class="result-text text-12px font-medium text-__334155_ mt-2px" style="font-family: monospace;">{{ desDecryptResult }}</text>
    </view>

    <!-- 6. RSA 非对称加密 / 签名 -->
    <view class="rounded-12px p-16px mb-16px border-width-1px border-style-solid border-color-__e2e8f0_">
      <text class="text-13px font-bold text-__1e293b_ mb-8px">6. RSA 非对称加密 / 签名 (示例密钥 1024 位)</text>
      <input
        v-model="rsaText"
        placeholder="请输入要加密 / 签名的文本"
        class="h-38px bg-white rounded-6px px-12px border-width-1px border-style-solid border-color-__cbd5e1_ text-13px text-__334155_ mb-8px"
      />
      <view class="flex-row items-center mb-8px">
        <view class="flex-1 h-36px rounded-8px bg-__0d9488_ flex flex-row items-center justify-center mr-8px" @click="handleRsaGenerateKeyPair">
          <text class="text-__ffffff_ text-13px font-bold">生成密钥对</text>
        </view>
        <view class="flex-1 h-36px rounded-8px bg-__0284c7_ flex flex-row items-center justify-center" @click="handleRsaEncrypt">
          <text class="text-__ffffff_ text-13px font-bold">公钥加密</text>
        </view>
      </view>
      <input
        v-model="rsaPublicKey"
        placeholder="RSA 公钥（PKCS#1 / SPKI，PEM 或 Base64）"
        class="h-38px bg-white rounded-6px px-12px border-width-1px border-style-solid border-color-__cbd5e1_ text-13px text-__334155_ mb-8px"
      />
      <input
        v-model="rsaPrivateKey"
        placeholder="RSA 私钥（PKCS#1 / PKCS#8，PEM 或 Base64）"
        class="h-38px bg-white rounded-6px px-12px border-width-1px border-style-solid border-color-__cbd5e1_ text-13px text-__334155_ mb-12px"
      />
      <view class="flex-row items-center mb-8px">
        <view class="flex-1 h-36px rounded-8px bg-__7c3aed_ flex flex-row items-center justify-center mr-8px" @click="handleRsaDecrypt">
          <text class="text-__ffffff_ text-13px font-bold">私钥解密</text>
        </view>
        <view class="flex-1 h-36px rounded-8px bg-__db2777_ flex flex-row items-center justify-center mr-8px" @click="handleRsaSign">
          <text class="text-__ffffff_ text-13px font-bold">SHA-256 签名</text>
        </view>
        <view class="flex-1 h-36px rounded-8px bg-__65a30d_ flex flex-row items-center justify-center" @click="handleRsaVerify">
          <text class="text-__ffffff_ text-13px font-bold">验签</text>
        </view>
      </view>
      <text class="text-12px text-__64748b_">密钥对结果:</text>
      <text class="result-text text-12px font-medium text-__334155_ mt-2px" style="font-family: monospace;">{{ rsaKeyPairResult }}</text>
      <text class="text-12px text-__64748b_ mt-8px">加密结果 (hex):</text>
      <text class="result-text text-12px font-medium text-__334155_ mt-2px" style="font-family: monospace;">{{ rsaEncryptResult }}</text>
      <text class="text-12px text-__64748b_ mt-8px">解密结果:</text>
      <text class="result-text text-12px font-medium text-__334155_ mt-2px" style="font-family: monospace;">{{ rsaDecryptResult }}</text>
      <text class="text-12px text-__64748b_ mt-8px">签名结果 (hex):</text>
      <text class="result-text text-12px font-medium text-__334155_ mt-2px" style="font-family: monospace;">{{ rsaSignResult }}</text>
      <text class="text-12px text-__64748b_ mt-8px">验签结果:</text>
      <text class="result-text text-12px font-medium text-__334155_ mt-2px" style="font-family: monospace;">{{ rsaVerifyResult }}</text>
    </view>

    <!-- 7. UUID 生成 -->
    <view class="rounded-12px p-16px mb-16px border-width-1px border-style-solid border-color-__e2e8f0_">
      <text class="text-13px font-bold text-__1e293b_ mb-8px">7. UUID 生成 (v4)</text>
      <view class="w-full h-36px rounded-8px bg-__2563eb_ flex flex-row items-center justify-center mb-8px" @click="handleGenerateUUID">
        <text class="text-__ffffff_ text-13px font-bold">生成 UUID</text>
      </view>
      <text class="text-12px text-__64748b_">生成的 UUID:</text>
      <text class="result-text text-12px font-medium text-__2563eb_ mt-2px" style="font-family: monospace;">{{ uuidResult }}</text>
    </view>
  </Card>
