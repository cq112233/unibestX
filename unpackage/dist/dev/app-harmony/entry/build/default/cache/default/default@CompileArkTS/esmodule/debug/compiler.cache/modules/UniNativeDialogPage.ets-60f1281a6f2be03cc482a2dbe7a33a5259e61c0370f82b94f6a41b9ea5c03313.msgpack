export class UniNativeDialogPageImpl extends UniNativePageImpl {
    get type() {
        return 'dialog';
    }
    getWindowSize() {
        if (this.parentPage) {
            // dialogPage éœ€è¦è¦†ç›–æ•´ä¸ªçˆ¶é¡µé¢ï¼Œä¸èƒ½ç»§æ‰¿å†…å®¹åŒºé«˜åº¦
            return this.parentPage.getWindowSize();
        }
        return super.getWindowSize();
    }
    onWindowSizeChange(callback) {
        let stopWindowSizeChange = null;
        const bindWindowSizeChange = (parentPage) => {
            stopWindowSizeChange?.();
            if (parentPage) {
                stopWindowSizeChange = parentPage.onWindowSizeChange(callback);
                return;
            }
            const onWindowSizeChange = (size) => {
                callback({
                    width: px2vp(size.width),
                    height: px2vp(size.height),
                });
            };
            this.app.window.on('windowSizeChange', onWindowSizeChange);
            stopWindowSizeChange = () => {
                this.app.window.off('windowSizeChange', onWindowSizeChange);
            };
        };
        bindWindowSizeChange(this.parentPage);
        const stopParentPageChange = this.onParentPageChange((parentPage) => {
            bindWindowSizeChange(parentPage);
            if (parentPage) {
                callback(this.getWindowSize());
            }
        });
        return () => {
            stopWindowSizeChange?.();
            stopParentPageChange();
        };
    }
    constructor(pageUrl, pageId, pageStyle, parentPage, dialogOptions, pageOptions) {
        // dialogPageçš„èƒŒæ™¯ä¸€å®šæ˜¯é€æ˜çš„
        pageStyle.set('backgroundColor', 'transparent');
        super(pageUrl, pageId, pageStyle);
        // åªæœ‰é¦–é¡µåˆ›å»ºä¹‹å‰è°ƒç”¨ï¼Œæ‰å¯èƒ½ä¸å­˜åœ¨parentPage
        if (parentPage) {
            // å¦‚æœæœ‰çˆ¶ï¼Œå–çˆ¶é¡µé¢ï¼ˆtabBaré¡µé¢ï¼‰
            // dialogPageä¹Ÿæœ‰çˆ¶ï¼Œä½†æ­¤å¤„ä¼ è¿›æ¥çš„ parentPage è‚¯å®šä¸æ˜¯ dialogPageï¼Œå› ä¸º dialogPage çš„ parentä¸€å®šæ˜¯æ™®é€šé¡µé¢
            (parentPage.parentPage || parentPage).addDialogPage(this);
        }
        else {
            // ç­‰å¾…é¦–é¡µå®Œæˆåï¼Œå† add + show
        }
    }
    showWithAnimation(animationType, duration, callback) {
        if (this.parentPage) {
            this.parentPage.showDialogPage(this, animationType, duration);
        }
        else {
            homeDialogPages.set(this, new Map([['animationType', animationType || 'none'], ['animationDuration', duration]]));
        }
        if (callback) {
            setTimeout(callback, duration);
        }
    }
    closeWithAnimation(animationType, duration, callback) {
        if (this.isRendering) {
            if (this.parentPage) {
                this.parentPage.closeDialogPage(this, animationType, duration);
            }
            else if (homeDialogPages.size) {
                // ä»å¾…åˆ›å»ºåˆ—è¡¨ä¸­åˆ é™¤
                homeDialogPages.delete(this);
            }
        }
        if (callback) {
            setTimeout(callback, duration);
        }
    }
}
