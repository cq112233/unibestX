import { navigator } from "@dcloudio/uni-app-framework";
class SetNavigationBarColorOptions extends UTSObject {
    constructor() {
        super(...arguments);
        this.success = null;
        this.fail = null;
        this.complete = null;
    }
}
class SetNavigationBarTitleOptions extends UTSObject {
    constructor() {
        super(...arguments);
        this.success = null;
        this.fail = null;
        this.complete = null;
    }
}
class ShowNavigationBarLoadingOptions extends UTSObject {
    constructor() {
        super(...arguments);
        this.success = null;
        this.fail = null;
        this.complete = null;
    }
}
class HideNavigationBarLoadingOptions extends UTSObject {
    constructor() {
        super(...arguments);
        this.success = null;
        this.fail = null;
        this.complete = null;
    }
}
const FRONT_COLORS = [
    '#ffffff',
    '#000000'
];
const API_SET_NAVIGATION_BAR_COLOR = 'setNavigationBarColor';
const SetNavigationBarColorProtocol = new Map([
    [
        'frontColor',
        {
            type: 'string',
            required: true,
            validator(frontColor) {
                if (FRONT_COLORS.indexOf(frontColor) === -1) {
                    return `invalid frontColor "${frontColor}"`;
                }
                return;
            }
        }
    ],
    [
        'backgroundColor',
        {
            type: 'string',
            required: true
        }
    ]
]);
const API_SET_NAVIGATION_BAR_TITLE = 'setNavigationBarTitle';
const SetNavigationBarTitleProtocol = new Map([
    [
        'title',
        {
            type: 'string',
            required: true
        }
    ]
]);
const getWebview = (page) => {
    const webview = page.$getAppWebview();
    return webview;
};
const setNavigationBarColor = defineAsyncApi(API_SET_NAVIGATION_BAR_COLOR, (options, executor) => {
    const frontColor = options.frontColor, backgroundColor = options.backgroundColor;
    const pages = globalThis.getCurrentPages();
    const page = pages[pages.length - 1];
    if (!page) {
        executor.reject(`getCurrentPages is empty`);
        return;
    }
    const statusBarStyle = frontColor === '#000000' ? 'dark' : 'light';
    try {
        navigator.setStatusBarStyle(statusBarStyle);
    }
    catch (error) { }
    const appPage = page.vm.$nativePage;
    appPage.updateStyle(new Map([
        [
            'navigationBarTextStyle',
            frontColor == '#000000' ? 'black' : 'white'
        ],
        [
            'navigationBarBackgroundColor',
            backgroundColor
        ]
    ]));
    executor.resolve();
}, SetNavigationBarColorProtocol);
const setNavigationBarTitle = defineAsyncApi(API_SET_NAVIGATION_BAR_TITLE, (args, executor) => {
    const pages = globalThis.getCurrentPages();
    const page = pages[pages.length - 1];
    if (!page) {
        executor.reject(`getCurrentPages is empty`);
        return;
    }
    const webview = getWebview(page);
    if (webview) {
        const style = webview.getStyle();
        if (style && style.titleNView) {
            webview.setStyle({
                titleNView: {
                    titleText: args.title
                }
            });
        }
        executor.resolve();
    }
    else {
        executor.reject();
    }
}, SetNavigationBarTitleProtocol);
const showNavigationBarLoading = defineAsyncApi(API_SET_NAVIGATION_BAR_TITLE, (options, executor) => {
    const pages = globalThis.getCurrentPages();
    const page = pages[pages.length - 1];
    if (!page) {
        executor.reject(`getCurrentPages is empty`);
        return;
    }
    const appPage = page.vm.$nativePage;
    appPage.updateStyle(new Map([
        [
            'navigationBarLoading',
            true
        ]
    ]));
    executor.resolve();
});
const hideNavigationBarLoading = defineAsyncApi(API_SET_NAVIGATION_BAR_TITLE, (args, executor) => {
    const pages = globalThis.getCurrentPages();
    const page = pages[pages.length - 1];
    if (!page) {
        return executor.reject(`getCurrentPages is empty`);
    }
    const appPage = page.vm.$nativePage;
    appPage.updateStyle(new Map([
        [
            'navigationBarLoading',
            false
        ]
    ]));
    executor.resolve();
});
export { HideNavigationBarLoadingOptions as HideNavigationBarLoadingOptions, SetNavigationBarColorOptions as SetNavigationBarColorOptions, SetNavigationBarTitleOptions as SetNavigationBarTitleOptions, ShowNavigationBarLoadingOptions as ShowNavigationBarLoadingOptions };
export { setNavigationBarColor as setNavigationBarColor };
export { setNavigationBarTitle as setNavigationBarTitle };
export { showNavigationBarLoading as showNavigationBarLoading };
export { hideNavigationBarLoading as hideNavigationBarLoading };
