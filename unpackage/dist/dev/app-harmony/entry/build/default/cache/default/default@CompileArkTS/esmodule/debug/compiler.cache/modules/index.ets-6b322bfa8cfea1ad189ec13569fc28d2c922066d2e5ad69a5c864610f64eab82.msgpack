        this._width = value;
    }
    get height() {
        return this._height != 0 ? this._height : vp2px(this.offsetHeight);
    }
    set height(value) {
        this._height = value;
    }
    getContext(_) {
        return this.context2D;
    }
    toDataURL(type = null, quality = null) {
        return this.context.toDataURL(type, quality);
    }
}
