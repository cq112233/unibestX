  get type() {
    return 'default'
  }

  _nativeElement: UniElement | null = null

  get bodyElement() {
    if (!this._nativeElement && this.page) {
      this._nativeElement = new UniElementImpl(0, this, 'BODY')
    }
    return this._nativeElement
  }

  document: ESObject
  protected isRendering = false
  /**
   * å…³è”çš„ UniApp å®ä¾‹
   * @internal
   */
