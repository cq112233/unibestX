import abilityAccessCtrl from "@ohos.abilityAccessCtrl";
import bundleManager from "@ohos.bundle.bundleManager";
import notificationManager from "@ohos.notificationManager";
class GetAppAuthorizeSettingResult extends UTSObject {
    constructor() {
        super(...arguments);
        this.locationAccuracy = null;
        this.locationReducedAccuracy = null;
        this.notificationAlertAuthorized = null;
        this.notificationBadgeAuthorized = null;
        this.notificationSoundAuthorized = null;
        this.phoneCalendarAuthorized = null;
        this.readPhoneCalendarAuthorized = null;
        this.writePhoneCalendarAuthorized = null;
        this.pasteboardAuthorized = null;
    }
