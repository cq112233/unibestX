class PreviewImageSuccess extends UTSObject {
}
class LongPressActionsSuccessResult extends UTSObject {
}
class LongPressActionsOptions extends UTSObject {
    constructor() {
        super(...arguments);
        this.itemColor = null;
        this.success = null;
        this.fail = null;
        this.complete = null;
    }
}
class PreviewImageOptions extends UTSObject {
    constructor() {
        super(...arguments);
        this.current = null;
        this.showmenu = null;
        this.indicator = null;
        this.loop = null;
        this.longPressActions = null;
        this.success = null;
        this.fail = null;
        this.complete = null;
    }
}
class ClosePreviewImageSuccess extends UTSObject {
}
class ClosePreviewImageOptions extends UTSObject {
    constructor() {
        super(...arguments);
        this.success = null;
        this.fail = null;
        this.complete = null;
    }
}
const UniErrorPreviewImage = 'uni-previewImage';
const PreviewImageUniErrors = new Map([
    [
        1101001,
        'user cancel'
    ],
    [
        1001,
        'fail parameter error: parameter.urls should have at least 1 item'
    ],
    [
        1101003,
        "file not find"
    ],
    [
        1101004,
        "Failed to load resource"
    ],
    [
        1101005,
        "No Permission"
    ],
    [
        1101010,
        "unexpect error:please check previewImage.uvue is in pages.json"
    ]
]);
class PreviewImageErrorImpl extends UniError {
    constructor(errCode, uniErrorSubject) {
        super();
        this.errSubject = uniErrorSubject;
        this.errCode = errCode;
        this.errMsg = UTS.mapGet(PreviewImageUniErrors, errCode) ?? "";
    }
}
function __previewImage(option) {
    if (option.urls.length == 0) {
        let error = new PreviewImageErrorImpl(1001, UniErrorPreviewImage);
        option.fail?.(error);
        option.complete?.(error);
        return;
    }
    uni.$once("__onPreviewLoad", () => {
        let object = new UTSJSONObject({
            current: option.current,
            urls: option.urls,
            indicator: option.indicator,
            loop: option.loop
        });
        if (option.longPressActions != null) {
            object["longPressActions"] = new UTSJSONObject({
                itemList: option.longPressActions.itemList,
                itemColor: option.longPressActions.itemColor
            });
        }
        uni.$emit("__onPreviewLoadCallback", object);
    });
    uni.$on("__UNIPREVIEWLONGPRESS", (value) => {
        if (option.longPressActions != null) {
            let type = value["type"];
            let tapIndex = value["tapIndex"];
            let index = value["index"];
            if (type == "success") {
                let success = {
                    tapIndex: tapIndex,
                    index: index
                };
                option.longPressActions?.success?.(success);
                option.longPressActions?.complete?.(success);
            }
            else {
                let fail = new PreviewImageErrorImpl(1101001, UniErrorPreviewImage);
                option.longPressActions?.fail?.(fail);
                option.longPressActions?.complete?.(fail);
            }
        }
    });
    uni.openDialogPage({
        url: 'uni:previewImage',
        animationType: "fade-in",
        success(_) {
            let success = {
                errMsg: 'ok',
                "errSubject": UniErrorPreviewImage
            };
            option.success?.(success);
            option.complete?.(success);
        },
        fail(_) {
            let error = new PreviewImageErrorImpl(1101010, UniErrorPreviewImage);
            option.fail?.(error);
            option.complete?.(error);
        }
    });
}
function __closePreviewImage(option) {
    uni.$emit("__CLOSEPREVIEWIMAGE", null);
    let callback = {
        errMsg: "ok"
    };
    option.success?.(callback);
    option.complete?.(callback);
}
const previewImage = (option) => {
    __previewImage(option);
};
const closePreviewImage = (option) => {
    __closePreviewImage(option);
};
export { ClosePreviewImageOptions as ClosePreviewImageOptions, ClosePreviewImageSuccess as ClosePreviewImageSuccess, LongPressActionsOptions as LongPressActionsOptions, LongPressActionsSuccessResult as LongPressActionsSuccessResult, PreviewImageOptions as PreviewImageOptions, PreviewImageSuccess as PreviewImageSuccess };
export { previewImage as previewImage };
export { closePreviewImage as closePreviewImage };
