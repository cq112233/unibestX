                this.layoutNode['setStyleHeight'](height);
            }
            else {
                this.layoutNode['setStyleWidth'](height);
                this.layoutNode['setStyleHeight'](width);
            }
        }
        else {
            if (width < height) {
                this.layoutNode['setStyleWidth'](height);
                this.layoutNode['setStyleHeight'](width);
            }
            else {
                this.layoutNode['setStyleWidth'](width);
                this.layoutNode['setStyleHeight'](height);
