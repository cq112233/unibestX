      return true;
    }
    return false;
  }

  private static parseMediaList(scan: CSSTextScanner): Array<string> {
    let typeList: Array<string> = new Array();
    while (!scan.empty()) {
      let type: string = scan.nextWord();
      if (type == null)
      break;
      try {
        typeList.push(type);
      } catch (e) {

      }

      if (!scan.skipCommaWhitespace())
      break;
    }
    return typeList;
  }

