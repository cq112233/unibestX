    updateInputEvent(event: InputEvent) {
        this.inputEvent = event;
    }
    dispatchInput(value: string, cursor: number | null = null) {
        this.value = value;
        this.params.value = value;
        if (cursor != null) {
            this.cursor = cursor;
        }
    }
