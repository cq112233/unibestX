} from './UniWebViewEvent'
import { createDownloadDelegate } from '../helper';
import { buffer, util } from '@kit.ArkTS';

const BASE64_ENCODING = 'base64'

@Builder
export function WebViewBuilder(options: WebViewOptions) {
  WebView(options)
}

class WebViewFrameNode extends UniFrameNode {
  componentInstance!: WebView
}

export class UniWebViewElementImpl
  extends UniElementImpl<WebViewFrameNode>
implements IUniWebViewElement {
  private options!: WebViewOptions
