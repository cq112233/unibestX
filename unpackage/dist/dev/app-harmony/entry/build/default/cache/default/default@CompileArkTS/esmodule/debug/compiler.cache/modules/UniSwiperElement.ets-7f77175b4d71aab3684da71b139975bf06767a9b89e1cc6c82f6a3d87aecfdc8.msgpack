const EASING_FUNCTION_TYPES = new Map<string, Curve>([
  ['default', Curve.Ease],
  ['linear', Curve.Linear],
  ['easeInCubic', Curve.EaseIn],
  ['easeOutCubic', Curve.EaseOut],
  ['easeInOutCubic', Curve.EaseInOut],
])

interface ChangeEventDetail {
  current: number
  currentItemId?: string
