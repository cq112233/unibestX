        if (ch.charCodeAt(0) == -1)
        continue;
        if (ch.charCodeAt(0) == '\n'.charCodeAt(0) || ch.charCodeAt(0) == '\r'.charCodeAt(0) || ch.charCodeAt(0) == '\f'.charCodeAt(0)) {
          ch = this.nextChar();
          continue;
        }
        let hc = this.hexChar(ch);
        if (hc != -1) {
          let codepoint = hc;
          for (let i = 1; i <= 5; i++) {
            ch = this.nextChar();
            hc = this.hexChar(ch);
            if (hc == -1)
            break;
            codepoint = codepoint * 16 + hc;
