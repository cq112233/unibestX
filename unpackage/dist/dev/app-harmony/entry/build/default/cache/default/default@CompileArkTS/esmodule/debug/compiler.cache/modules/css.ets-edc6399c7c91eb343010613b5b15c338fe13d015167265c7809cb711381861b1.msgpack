      case 'none':
        res1 = UniCssBorderStyle.None
        res2 = undefined
        break
      case 'solid':
        res1 = UniCssBorderStyle.Border
        res2 = BorderStyle.Solid
        break
      case 'dashed':
        res1 = UniCssBorderStyle.Border
        res2 = BorderStyle.Dashed
        break
      case 'dotted':
        res1 = UniCssBorderStyle.Border
        res2 = BorderStyle.Dotted
        break
