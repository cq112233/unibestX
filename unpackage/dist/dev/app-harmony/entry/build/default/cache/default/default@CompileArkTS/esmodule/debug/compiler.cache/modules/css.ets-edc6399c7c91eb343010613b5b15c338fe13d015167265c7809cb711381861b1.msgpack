export function formatBorderStyle(value: Object,
  success: (val1: UniCssBorderStyle, val2: BorderStyle | undefined) => void,
  fail?: () => void) {
  let res1: UniCssBorderStyle
  let res2: BorderStyle | undefined
  if (typeof value === 'string') {
