export function formatFontWeight(value: Object, success: (val: FontWeight | number | string) => void,
  fail?: () => void) {
  if (typeof value === 'string') {
    switch (value) {
      case 'normal':
        success(FontWeight.Normal)
        return
      case 'bold':
        success(FontWeight.Bold)
        return
      case 'bolder':
        success(FontWeight.Bolder)
        return
      case 'lighter':
        success(FontWeight.Lighter)
        return
    }
  }
  formatNumber(value, value => {
    success(value)
  }, fail)
}

export function formatFontFamily(value: Object, success: (val: string) => void, fail?: () => void) {
  if (typeof value === 'string') {
    success(value)
    return
