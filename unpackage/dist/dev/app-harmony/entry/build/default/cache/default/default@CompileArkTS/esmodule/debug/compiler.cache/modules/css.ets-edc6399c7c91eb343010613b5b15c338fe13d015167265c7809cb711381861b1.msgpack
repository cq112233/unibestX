export function formatFontStyle(value: Object, success: (val: FontStyle) => void, fail?: () => void) {
  if (typeof value === 'string') {
    switch (value) {
      case 'normal':
        success(FontStyle.Normal)
        return
      case 'italic':
        success(FontStyle.Italic)
        return
    }
  }
  fail?.()
