}
const API_REQUEST_PAYMENT = 'requestPayment';
const requestPayment = defineAsyncApi(API_REQUEST_PAYMENT, (options, exec) => {
    const provider = getUniProvider('payment', options.provider);
    if (!provider) {
        exec.reject('Provider not found.');
        return;
    }
    provider.requestPayment({
        orderInfo: options.orderInfo,
        success: (result) => {
            exec.resolve(result);
