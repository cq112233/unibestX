export function toLayoutNodeLength(value) {
    if (value instanceof CSSKeywordValue) {
        if (value.value === 'auto') {
            return {
                value: NaN,
                unit: UniLengthUnit.Auto
            };
        }
    }
    if (value instanceof CSSUnitValue) {
        switch (value.unit) {
            case LengthUnit.px:
                return {
                    value: value.value,
                    unit: UniLengthUnit.PXPoint
                };
            case LengthUnit.rpx:
            case LengthUnit.upx:
                return {
                    value: value.value,
                    unit: UniLengthUnit.RPXPoint
                };
            case LengthUnit.in:
                return {
                    value: value.value * 96,
                    unit: UniLengthUnit.PXPoint
                };
            case LengthUnit.cm:
                return {
                    value: value.value * 37.8,
                    unit: UniLengthUnit.PXPoint
                };
            case PercentUnit.percent:
                return {
                    value: value.value,
                    unit: UniLengthUnit.Percent
                };
            default:
                break;
        }
    }
    if (isLayoutVar(value)) {
        return {
            value: value.toString(),
            unit: UniLengthUnit.Function
        };
    }
    return;
}
export function toLayoutNodeNumber(value) {
    if (value instanceof CSSUnitValue) {
        switch (value.unit) {
            case NumberUnit.number:
                return value.value;
            default:
                break;
        }
    }
    return;
}
