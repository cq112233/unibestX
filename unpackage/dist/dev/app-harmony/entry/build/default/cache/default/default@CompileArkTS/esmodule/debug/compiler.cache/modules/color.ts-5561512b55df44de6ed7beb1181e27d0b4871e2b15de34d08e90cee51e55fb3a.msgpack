// TODO ç®€å•å®ç°ï¼Œä¸ºæ”¯æŒ DrawableContext
export function toColor(colorString: string): common2D.Color {
  let r = 0, g = 0, b = 0, a = 255;
  if (colorString.startsWith('#')) {
    if (colorString.length == 7) {
      r = parseInt(colorString.substring(1, 3), 16)
      g = parseInt(colorString.substring(3, 5), 16)
      b = parseInt(colorString.substring(5, 7), 16)
    } else if (colorString.length == 4) {
      r = parseInt(colorString.substring(1, 2).repeat(2), 16)
      g = parseInt(colorString.substring(2, 3).repeat(2), 16)
      b = parseInt(colorString.substring(3, 4).repeat(2), 16)
    } else if (colorString.length == 9) {
      r = parseInt(colorString.substring(1, 3), 16)
      g = parseInt(colorString.substring(3, 5), 16)
      b = parseInt(colorString.substring(5, 7), 16)
      a = parseInt(colorString.substring(7, 9), 16) * 255
    }
  } else if (colorString.startsWith('rgba')) {
    const array = colorString.substring(5, colorString.lastIndexOf(')')).split(',')
    r = Number(array[0])
    g = Number(array[1])
    b = Number(array[2])
    a = Number(array[3]) * 255
  } else if (colorString.startsWith('rgb')) {
    const array = colorString.substring(4, colorString.lastIndexOf(')')).split(',')
    r = Number(array[0])
    g = Number(array[1])
    b = Number(array[2])
  } else {
    const colorName: string | undefined = EXTENDED_COLOR_KEYWORDS[colorString]
    if (colorName != null && colorName.startsWith('#')) {
      return toColor(colorName)
    } else {
      switch (colorString) {
        case 'transparent':
          a = 0
          break;
      }
    }
  }

  const color: common2D.Color = {
    alpha: a,
    red: r,
    green: g,
    blue: b
  }
  return color
}
