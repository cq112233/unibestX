import { UTSObject, UTS, defineSyncApi } from "@dcloudio/uni-app-framework";
class UniWebviewContextLoadDataOptions extends UTSObject {
    constructor() {
        super(...arguments);
        this.baseURL = null;
        this.mimeType = null;
        this.encoding = null;
    }
}
const getWebViewContext = (id, component = null) => {
    let webViewElement = null;
    if (component == null) {
        const pages = globalThis.getCurrentPages();
        if (pages.length > 0) {
            const page = pages[pages.length - 1];
            if (!page) {
                UTS.console.error(`getCurrentPages is empty`);
                return null;
            }
            webViewElement = page.vm.$el?.parentElement?.querySelector('#' + id);
            if (webViewElement == null) {
                const dialogPages = page.getDialogPages();
                if (dialogPages.length > 0) {
                    const topDialogPage = dialogPages[dialogPages.length - 1];
                    if (!topDialogPage) {
                        UTS.console.error(`getDialogPages is empty`);
                        return null;
                    }
                    webViewElement = topDialogPage.vm.$el?.parentElement?.querySelector('#' + id);
                }
            }
        }
    }
    else {
        webViewElement = component.$el?.parentElement?.querySelector('#' + id);
    }
    if (webViewElement == null)
        return null;
    return new WebViewContextImpl(webViewElement);
};
const createWebViewContext = defineSyncApi('createWebViewContext', (id, component = null) => {
    return getWebViewContext(id, component);
});
const createWebviewContext = defineSyncApi('createWebviewContext', (id, component = null) => {
    return getWebViewContext(id, component);
});
class WebViewContextImpl {
    constructor(webviewElement) {
        this.webviewElement = null;
        this.webviewElement = webviewElement;
    }
    back() {
        this.webviewElement?.back();
    }
    forward() {
        this.webviewElement?.forward();
    }
    reload() {
        this.webviewElement?.reload();
    }
    stop() {
        this.webviewElement?.stop();
    }
    evalJS(js) {
        this.webviewElement?.evalJS(js);
    }
    getContentHeight() {
        return this.webviewElement?.getContentHeight() ?? 0;
    }
    loadData(options) {
        this.webviewElement?.loadData(options);
    }
}
export { UniWebviewContextLoadDataOptions as UniWebviewContextLoadDataOptions };
export { createWebViewContext as createWebViewContext };
export { createWebviewContext as createWebviewContext };
