export function colorWithString(colorString: string): string {
  /**
   * è¾“å…¥å€¼ä¸ºwebè§„èŒƒå­é›†
   * - é¢œè‰²åç§°ç¤ºä¾‹ï¼š'red'ã€'blue'ã€'green'ã€‚
   * - rgbæ ¼å¼é¢œè‰²ç¤ºä¾‹ï¼š'#fff'ã€'#ffffff'ã€'rgb(255, 100, 255)'ã€‚
   * - rgbaæ ¼å¼é¢œè‰²ç¤ºä¾‹ï¼š'rgba(255, 100, 255, 0.5)'ã€‚
   * - rgbaæ ¼å¼é¢œè‰²ç¤ºä¾‹ï¼š'#000f'ã€'#000000ff'ã€‚
