   * - argbæ ¼å¼é¢œè‰²ç¤ºä¾‹ï¼š'#ff000000'ã€‚
   */
  if (EXTENDED_COLOR_KEYWORDS.has(colorString)) {
    return EXTENDED_COLOR_KEYWORDS.get(colorString) as string
  }
  if (colorString.startsWith('#')) {
    if (colorString.length === 4) {
      // #rgb -> #rrggbb
      const r = colorString[1]
