        const isNetworkUrl = src.startsWith('http://') || src.startsWith('https://') || src.startsWith('rtmp://') || src.startsWith('rtsp://');
        try {
            const avMetadataExtractor = await media.createAVMetadataExtractor();
            let metadata: media.AVMetadata | null = null;
            try {
                if (isNetworkUrl) {
                    avMetadataExtractor.setUrlSource(src);
