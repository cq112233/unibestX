        let closest = validValues[0];
        let closestDiff = Math.abs(rate - closest);
        for(let i = 1; i < validValues.length; i++){
            let diff = Math.abs(rate - validValues[i]);
            if (diff < closestDiff) {
                closest = validValues[i];
                closestDiff = diff;
