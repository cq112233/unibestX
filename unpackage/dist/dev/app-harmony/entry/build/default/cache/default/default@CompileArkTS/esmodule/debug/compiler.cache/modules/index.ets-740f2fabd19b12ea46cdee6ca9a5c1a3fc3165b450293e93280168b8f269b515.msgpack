            } finally {
                await avMetadataExtractor.release();
            }
            if (requestId !== this.fullscreenOrientationRequestId || src !== this.params.options.src || metadata == null) return;
            let width = Number(metadata.videoWidth);
            let height = Number(metadata.videoHeight);
            const orientation = metadata.videoOrientation != null ? Number(metadata.videoOrientation) : 0;
            if (orientation === 90 || orientation === 270) {
                const originWidth = width;
                width = height;
