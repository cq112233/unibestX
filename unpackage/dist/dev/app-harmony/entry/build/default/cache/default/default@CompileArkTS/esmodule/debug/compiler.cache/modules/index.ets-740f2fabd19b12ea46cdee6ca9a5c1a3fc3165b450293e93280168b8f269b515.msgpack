const createVideoContext = defineSyncApi('createVideoContext', (videoId, component = null) => {
    let videoElement = null;
    if (component == null) {
        const pages = getCurrentPages();
        if (pages.length > 0) {
            const page = pages[pages.length - 1];
            if (!page) {
                UTS.console.error(`getCurrentPages is empty`);
                return null;
            }
            videoElement = page.vm.$el?.parentElement?.querySelector('#' + videoId);
            if (videoElement == null) {
                const dialogPages = page.getDialogPages();
                if (dialogPages.length > 0) {
                    const topDialogPage = dialogPages[dialogPages.length - 1];
                    if (!topDialogPage) {
                        UTS.console.error(`getDialogPages is empty`);
                        return null;
                    }
                    videoElement = topDialogPage.vm.$el?.parentElement?.querySelector('#' + videoId);
                }
            }
        }
    }
    else {
        videoElement = component.$el?.parentElement?.querySelector('#' + videoId);
    }
    if (videoElement == null)
        return null;
    return new VideoContextImpl(videoElement.getVideo());
