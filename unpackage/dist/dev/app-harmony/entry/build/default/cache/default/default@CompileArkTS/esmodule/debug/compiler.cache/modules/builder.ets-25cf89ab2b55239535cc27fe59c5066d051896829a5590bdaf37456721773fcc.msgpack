//# sourceMappingURL=builder.js.mapÂÚ/Users/chenqi/Documents/chenqi-front/unibestX/unpackage/dist/dev/app-harmony/oh_modules/.ohpm/@dcloudio+uni-app-x-runtime@vua5rno56y+lxsl9gh9s+khc6tt+o3phvo4zcfixbck=/oh_modules/@dcloudio/uni-app-x-runtime/src/main/ets/modules/uni_modules/uni-loading/utssdk/app-harmony/builder.etsÔrB˜±isLocalDependency¯isNodeEntryFile§pkgPath§pkgNameªpkgVersion±belongProjectPath±dependencyPkgInfo¬shouldEmitJsÂÂÙâ/Users/chenqi/Documents/chenqi-front/unibestX/unpackage/dist/dev/app-harmony/oh_modules/.ohpm/@dcloudio+uni-app-x-runtime@vua5rno56y+lxsl9gh9s+khc6tt+o3phvo4zcfixbck=/oh_modules/@dcloudio/uni-app-x-runtime/src/main/ets/modules¹@dcloudio/uni-app-modules¥1.0.0ÙL/Users/chenqi/Documents/chenqi-front/unibestX/unpackage/dist/dev/app-harmonyÔrC’§pkgNameªpkgVersion¹@dcloudio/uni-app-modules¥1.0.0ÃÃÚÕ@Component
struct CanvasCircle {
  private settings: RenderingContextSettings = new RenderingContextSettings(true)
  private context: CanvasRenderingContext2D = new CanvasRenderingContext2D(this.settings)
  private uiContext: UIContext | undefined = undefined;
  lineWidthBase: number = 16
  @Prop duration: number = 1333
  @Prop easing: string = 'linear'
  @Prop @Watch('draw') color: string | number = 0x000000
  @Prop @Watch('draw') coefficient: number = 1
  @Prop @Watch('draw') degrees: number = 270
  @Prop @Watch('pauseAnimate') paused: boolean = false
  @State rotate_: number = 0
  private animateParam: AnimateParam = {
    duration: this.duration,
    curve: this.easing,
    iterations: -1
  }

  draw() {
    const canvasWidth = this.context.width
    const canvasHeight = this.context.height
    const realSize = Math.min(canvasWidth, canvasHeight)
    const realLineWidth = (realSize / this.lineWidthBase) * this.coefficient

    const angleDegrees = this.degrees

    const angleRadians = (angleDegrees * Math.PI) / 180;

    this.context.clearRect(0, 0, canvasWidth, canvasHeight);

    this.context.strokeStyle = this.color;
    this.context.lineWidth = realLineWidth;

    this.context.beginPath();

    const centerX = canvasWidth / 2; // åœ†å¿ƒ X åæ ‡
    const centerY = canvasHeight / 2; // åœ†å¿ƒ Y åæ ‡
    const radius = realSize / 2 - realLineWidth / 2; // åŠå¾„

    // ä½¿ç”¨ arc() æ–¹æ³•ç»˜åˆ¶å¼§çº¿
    // arc(x, y, radius, startAngle, endAngle, anticlockwise)
    // x, y: åœ†å¿ƒåæ ‡
    // radius: åŠå¾„
    // startAngle: èµ·å§‹å¼§åº¦ (0 åº¦åœ¨ 3 ç‚¹é’Ÿæ–¹å‘)
    // endAngle: ç»“æŸå¼§åº¦
    // anticlockwise: æ˜¯å¦é€†æ—¶é’ˆ (false ä¸ºé¡ºæ—¶é’ˆ)
    this.context.arc(centerX, centerY, radius, 0, angleRadians, false);

    this.context.stroke();
  }

  play() {
    animateToImmediately(this.animateParam, () => {
      this.rotate_ = 360;
    })
  }

  pause() {
    animateToImmediately({ duration: 0 }, () => {
      this.rotate_ = 0;
    })
  }

  pauseAnimate() {
    if (this.paused) {
      this.pause()
    } else {
      this.play()
    }
  }

  build() {
    Canvas(this.context)
      .rotate({
        angle: this.rotate_
      })
      .width('100%')
      .height('100%')
      .onAppear(() => {
        this.uiContext = this.getUIContext();
        if (!this.uiContext) {
          return;
        }
      })
      .onReady(() => {
        this.draw()
        setTimeout(() => {
          if (this.rotate_ === 0 && !this.paused) {
            this.play()
          }
        }, 0)
      })
  }
}

// è®¡ç®—ç²—ç»†çš„å€æ•° (æœ€å°è¾¹ / 16 * coefficient)
function getLineCoefficient(borderWidth: string | undefined) {
  if (borderWidth == null) {
    return 1
  }
  // TODO ä¸æ”¯æŒå…·ä½“ px å€¼
  /* if (borderWidth.endsWith('px')) {
    const num = parseFloat(borderWidth.replace('px', ''))
    return isNaN(num) ? 1 : num
  } */
  switch (borderWidth) {
    case 'medium':
    case 'normal':
      return 1
    case 'thick':
    case 'bold':
      return 2
  }
  return 1
}

@Builder
export function buildLoading(params: ESObject) {
  Flex({ alignItems: ItemAlign.Center, justifyContent: FlexAlign.Center }) {
    CanvasCircle({
      degrees: params.degrees ?? 270,
      color: params.color as number | string, //formatColorSync(params.color) as string,
      coefficient: getLineCoefficient(params.borderWidth),
      duration: params.duration ?? 1333,
      easing: params.animationTimingFunction,
      paused: params.paused
    })
  }
  .width('100%')
  .height('100%')
}
