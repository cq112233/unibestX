import { NumberParser } from './NumberParser';
import { Length, Unit } from './SVGBase';
import { Character } from './Character';
export class TextScanner {
    constructor(input) {
        this.position = 0;
        this.numberParser = new NumberParser();
        this.input = input.trim();
        this.inputLength = this.input.length;
    }
    empty() {
        return (this.position == this.inputLength);
    }
    isWhitespace(c) {
        return (c == ' '.charCodeAt(0) || c == '\n'.charCodeAt(0) || c == '\r'.charCodeAt(0) || c == '\t'.charCodeAt(0));
    }
    skipWhitespace() {
        while (this.position < this.inputLength) {
            if (!this.isWhitespace(this.input.charAt(this.position).charCodeAt(0)))
                break;
            this.position++;
        }
    }
    isEOL(c) {
        return (c == '\n'.charCodeAt(0) || c == '\r'.charCodeAt(0));
    }
    skipCommaWhitespace() {
        this.skipWhitespace();
        if (this.position == this.inputLength)
            return false;
        if (!(this.input.charAt(this.position).charCodeAt(0) == ','.charCodeAt(0))) {
            return false;
        }
        this.position++;
        this.skipWhitespace();
        return true;
    }
    nextFloat() {
        let val = this.numberParser.parseNumber(this.input, this.position, this.inputLength);
        if (!Number.isNaN(val)) {
            this.position = this.numberParser.getEndPos();
        }
        return val;
    }
    possibleNextFloat() {
        this.skipCommaWhitespace();
        let val = this.numberParser.parseNumber(this.input, this.position, this.inputLength);
        if (!Number.isNaN(val))
            this.position = this.numberParser.getEndPos();
        return val;
    }
    checkedNextFloat(lastRead) {
        if (typeof lastRead == 'number') {
            if (Number.isNaN(lastRead)) {
                return Number.NaN;
            }
            this.skipCommaWhitespace();
            return this.nextFloat();
        }
        else {
            if (lastRead == null) {
                return Number.NaN;
            }
            this.skipCommaWhitespace();
            return this.nextFloat();
        }
    }
    nextChar() {
        if (this.position == this.inputLength)
            return null;
        return this.input.charAt(this.position++);
    }
    nextLength() {
        let scalar = this.nextFloat();
        console.log('scalar = ' + scalar);
        if (Number.isNaN(scalar))
            return null;
        let unit = this.nextUnit();
        if (unit == null)
            return new Length(scalar, Unit.px);
        else
            return new Length(scalar, unit);
    }
    nextFlag() {
        if (this.position == this.inputLength)
            return null;
        let ch = this.input.charAt(this.position).charCodeAt(0);
        if (ch == '0'.charCodeAt(0) || ch == '1'.charCodeAt(0)) {
            this.position++;
            return (ch == '1'.charCodeAt(0));
        }
        return null;
    }
    checkedNextFlag(lastRead) {
        if (lastRead == null) {
            return null;
        }
        this.skipCommaWhitespace();
        return this.nextFlag();
    }
    consume(str) {
        if (str.length == 1) {
            let found = (this.position < this.inputLength && this.input.charAt(this.position).charCodeAt(0) == str.charCodeAt(0));
            if (found)
                this.position++;
            return found;
        }
        else {
            let len = str.length;
            let found = (this.position <= (this.inputLength - len) && this.input.charAt(this.position) == (str));
            if (found)
                this.position++;
            return found;
        }
    }
    advanceChar() {
        if (this.position == this.inputLength)
            return -1;
        this.position++;
        if (this.position < this.inputLength)
            return this.input.charAt(this.position).charCodeAt(0);
        else
            return -1;
    }
    nextTokenWithWhitespace(terminator) {
        return this.nextToken(terminator, true);
    }
    nextToken(terminator, allowWhitespace) {
        terminator = terminator == undefined ? ' ' : terminator;
        allowWhitespace = allowWhitespace == undefined ? false : allowWhitespace;
        if (this.empty())
            return null;
        let ch = this.input.charAt(this.position).charCodeAt(0);
        if ((!allowWhitespace && this.isWhitespace(ch)) || ch == terminator.charCodeAt(0))
            return null;
        let start = this.position;
        ch = this.advanceChar();
        while (ch != -1) {
            if (ch == terminator.charCodeAt(0))
                break;
            if (!allowWhitespace && this.isWhitespace(ch))
                break;
            ch = this.advanceChar();
        }
        return this.input.substring(start, this.position);
    }
    nextWord() {
        if (this.empty())
            return null;
        let start = this.position;
        let ch = this.input.charAt(this.position).charCodeAt(0);
        if ((ch >= 'A'.charCodeAt(0) && ch <= 'Z'.charCodeAt(0)) || (ch >= 'a'.charCodeAt(0) && ch <= 'z'.charCodeAt(0))) {
            ch = this.advanceChar();
            while ((ch >= 'A'.charCodeAt(0) && ch <= 'Z'.charCodeAt(0)) || (ch >= 'a'.charCodeAt(0) && ch <= 'z'.charCodeAt(0)))
                ch = this.advanceChar();
            return this.input.substring(start, this.position);
        }
        this.position = start;
        return null;
    }
    nextFunction() {
        if (this.empty())
            return null;
        let start = this.position;
        let ch = this.input.charAt(this.position).charCodeAt(0);
        while ((ch >= 'a'.charCodeAt(0) && ch <= 'z'.charCodeAt(0)) || (ch >= 'A'.charCodeAt(0) && ch <= 'Z'.charCodeAt(0)))
            ch = this.advanceChar();
        let end = this.position;
        while (this.isWhitespace(ch))
            ch = this.advanceChar();
        if (ch == '('.charCodeAt(0)) {
            this.position++;
            return this.input.substring(start, end);
        }
        this.position = start;
        return null;
    }
    ahead() {
        let start = this.position;
        while (!this.empty() && !this.isWhitespace(this.input.charAt(this.position).charCodeAt(0)))
            this.position++;
        let str = this.input.substring(start, this.position);
        this.position = start;
        return str;
    }
    nextUnit() {
        if (this.empty())
            return null;
        let ch = this.input.charAt(this.position);
        if (ch.charCodeAt(0) == '%'.charCodeAt(0)) {
            this.position++;
            return Unit.percent;
        }
        if (this.position > (this.inputLength - 2))
            return null;
        try {
            let str = this.input.substring(this.position, this.position + 2);
            if (Character.isLetter(str)) {
                let result = str.toLocaleLowerCase('en-US');
                this.position += 2;
                return result;
            }
            else {
                return null;
            }
        }
        catch (e) {
            return null;
        }
    }
    hasLetter() {
        if (this.position == this.inputLength)
            return false;
        let ch = this.input.charAt(this.position).charCodeAt(0);
        return ((ch >= 'a'.charCodeAt(0) && ch <= 'z'.charCodeAt(0)) || (ch >= 'A'.charCodeAt(0) && ch <= 'Z'.charCodeAt(0)));
    }
    nextQuotedString() {
        if (this.empty())
            return null;
        let start = this.position;
        let ch = this.input.charAt(this.position).charCodeAt(0);
        let endQuote = ch;
        if (ch != '\''.charCodeAt(0) && ch != '"'.charCodeAt(0))
            return null;
        ch = this.advanceChar();
        while (ch != -1 && ch != endQuote)
            ch = this.advanceChar();
        if (ch == -1) {
            this.position = start;
            return null;
        }
        this.position++;
        return this.input.substring(start + 1, this.position - 1);
    }
    restOfText() {
        if (this.empty())
            return null;
        let start = this.position;
        this.position = this.inputLength;
        return this.input.substring(start);
    }
}
