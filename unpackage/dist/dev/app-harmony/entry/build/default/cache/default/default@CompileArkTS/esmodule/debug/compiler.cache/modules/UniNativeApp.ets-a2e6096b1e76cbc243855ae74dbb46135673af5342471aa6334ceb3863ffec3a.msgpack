    }
    observeResizeObserver(observerId, pageId, elemId) {
        throw new Error('Method not implemented.');
    }
    unobserveResizeObserver(observerId, pageId, elemId) {
        throw new Error('Method not implemented.');
    }
    disconnectResizeObserver(observerId) {
        throw new Error('Method not implemented.');
    }
    getLaunchOptionsSync() {
        // TODO implement
        return {
            appScheme: '',
            appLink: '',
        };
    }
    getAndroidApplication() {
        throw new Error('Method not implemented.');
    }
    initPrivacyAuthorization() {
        if (getPrivacyAgree()) {
            return;
        }
        let appHarmony = this.manifest['app-harmony'];
        if (appHarmony) {
            let privacyValue = appHarmony['initPrivacyAuthorization'];
            if (privacyValue && privacyValue == 'agree') {
                setPrivacyAgree(true);
            }
            else {
                setPrivacyAgree(false);
            }
        }
    }
}
export function openUniApp(appID, config) {
    const app = new UniNativeAppImpl(appID, config);
    return app;
}
export function closeUniApp() {
    const mainApp = getUniApp();
    if (mainApp) {
        mainApp.quit();
    }
}
