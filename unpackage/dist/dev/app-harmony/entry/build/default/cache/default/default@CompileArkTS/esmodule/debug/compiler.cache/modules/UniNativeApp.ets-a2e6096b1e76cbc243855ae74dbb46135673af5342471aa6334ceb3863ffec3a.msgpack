                    globalThis.document = this.globalDocument;
                    // TODO ç§»å‡ºå…¨å±€ __mount__
                    const mount = globalThis.__mount__;
                    genApp();
                    // è·å–çª—å£å¤§å°ä¹‹åå†æ‰§è¡Œ mount
                    const windowSizeChange = (size) => {
                        window.off('windowSizeChange', windowSizeChange);
                        mount();
                    };
                    window.on('windowSizeChange', windowSizeChange);
                }
                catch (e) {
                    // TODO æš‚æ—¶ä¸ä½¿ç”¨ tag
                    console.error(e);
                }
                if (config?.isMain) {
                    let errorCallback = {
                        onUnhandledException: (errMsg) => {
                            console.error('onUnhandledException', errMsg);
                        },
                        onException: (errorObj) => {
                            // TODO æš‚æ—¶ä¸ä½¿ç”¨ tag
                            console.error('onException', errorObj.message);
                        }
                    };
                    errorManager.on('error', errorCallback);
                    this.appStartDuration = Date.now() - getEntryAbility().startTime;
                }
                // ç”¨äºè§¦å‘ C å±‚ SafeAreaInsetsChange äº‹ä»¶
                this.safeAreaInsetsChangeCallback = () => {
                    bridge.emitSafeAreaInsetsChange();
                };
                window.on('avoidAreaChange', this.safeAreaInsetsChangeCallback);
                window.showWindow();
            });
        };
        if (config?.isMain) {
            windowStage.getMainWindow(initWindow);
        }
        else {
            windowStage.createSubWindow(`uni-mp-${id}`, initWindow);
        }
        this.initPrivacyAuthorization();
        bridge.__uni__app_Create(this.id);
        bridge.__uni__app_AddEventListener(this.id, 'onBackButton', () => {
            this._emitter.emit('onBackButton');
        });
    }
    onEvent(event) {
