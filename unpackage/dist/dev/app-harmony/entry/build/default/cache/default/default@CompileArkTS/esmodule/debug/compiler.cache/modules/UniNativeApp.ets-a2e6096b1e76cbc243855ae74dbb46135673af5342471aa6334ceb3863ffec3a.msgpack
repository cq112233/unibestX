    getAppStartDuration() {
        return this.appStartDuration;
    }
    loadFontFace(options) {
        registerFont(formatFontFaceSrc(options.source), options, this.context);
    }
    getRedirectInfo() {
        // TODO implement
        return new Map();
    }
