}import { UniViewElementImpl } from "@dcloudio/uni-app-framework";
import { buildLoading } from "./builder";
import { formatColorSync } from "@dcloudio/uni-app-framework";
const DEFAULT_COLOR = '#000000';
const DEFAULT_BORDER_WIDTH = 'normal';
const DEFAULT_ANIMATION_TIMING_FUNCTION = 'linear';
class NativeLoading {
    constructor(element, params = {
        color: DEFAULT_COLOR,
        borderWidth: DEFAULT_BORDER_WIDTH,
        animationTimingFunction: DEFAULT_ANIMATION_TIMING_FUNCTION,
        paused: false
    }) {
        this.__v_skip = true;
        this.harmonyBuilderNode = null;
        this.params = params;
        if (this.params.color) {
            this.params.color = formatColorSync(this.params.color);
        }
        element.bindHarmonyWrappedBuilder(wrapBuilder(buildLoading), this.params);
        if (typeof element['getHarmonyComponentContent'] === 'function') {
            this.harmonyBuilderNode = element.getHarmonyComponentContent();
        }
        else {
            this.harmonyBuilderNode = element.getHarmonyBuilderNode();
        }
        element.bindHarmonyController(this);
    }
    updateStyle(color = DEFAULT_COLOR, borderWidth = DEFAULT_BORDER_WIDTH, animationTimingFunction = DEFAULT_ANIMATION_TIMING_FUNCTION) {
        if (color !== null) {
            if (this.params.color) {
                this.params.color = formatColorSync(color);
            }
        }
        else {
            color = DEFAULT_COLOR;
        }
        if (borderWidth !== null) {
            this.params.borderWidth = borderWidth;
        }
        else {
            borderWidth = DEFAULT_BORDER_WIDTH;
        }
        if (animationTimingFunction !== null) {
            this.params.animationTimingFunction = animationTimingFunction;
        }
        else {
            animationTimingFunction = DEFAULT_ANIMATION_TIMING_FUNCTION;
        }
        this.updateParams();
    }
    updateDegrees(degrees) {
        if (degrees !== this.params.degrees) {
            this.params.degrees = degrees;
            this.updateParams();
        }
    }
    updatePaused(paused) {
        if (paused !== this.params.paused) {
            this.params.paused = paused;
            this.updateParams();
        }
    }
    updateParams() {
        this.harmonyBuilderNode?.update(this.params);
    }
    destroy() {
        this.harmonyBuilderNode?.dispose();
    }
}
