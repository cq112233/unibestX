export class UniNativeTabBarPage extends UniNativePageImpl {
    get type() {
        return 'tabBar';
    }
    constructor(pageUrl, pageId, pageStyle) {
        super(pageUrl, pageId, pageStyle);
        this.tabBarController = new TabBarController();
        this.currentItemId = null;
        this.requestFullscreenRestore = false;
        this.onTabBarVisibleChangeCallbacks = null;
        this.tabBarVisibilityChangeVersion = 0;
        this.tabBarDocument = new UniTabBarDocumentImpl(this);
        this.document = this.tabBarDocument;
        this.tabBarController.onTabItemClick = (index) => {
            this.tabBarDocument.emitTabBarItemTap(index);
        };
    }
    init(page) {
        super.init(page);
