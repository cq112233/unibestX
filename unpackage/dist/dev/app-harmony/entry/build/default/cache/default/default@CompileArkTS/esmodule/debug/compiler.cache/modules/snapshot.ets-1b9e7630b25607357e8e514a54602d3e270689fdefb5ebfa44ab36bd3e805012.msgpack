            // æˆªå›¾åæ¢å¤æ»šåŠ¨ä½ç½®
            scroller.scrollTo({
                xOffset: 0,
                yOffset: originOffsetY,
                animation: {
                    duration: 0
                }
            });
            await sleep(SCROLL_VIEW_SCROLL_TIMEOUT);
            // é‡ç½®å…ƒç´ id
            el.frameNode.commonAttribute.id(undefined);
            resolve(pixelMap);
