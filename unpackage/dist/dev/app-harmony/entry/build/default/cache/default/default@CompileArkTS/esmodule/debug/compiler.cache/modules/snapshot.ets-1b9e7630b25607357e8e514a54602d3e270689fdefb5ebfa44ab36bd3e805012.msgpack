        const scrollYOffsets = [];
        const screenShotId = getSnapshotId();
        el.frameNode.commonAttribute.id(screenShotId);
        // æ»šåŠ¨åˆ°é¡¶éƒ¨, ä»¥ä¾¿æˆªå›¾
        controller.scrollTo(0, 0);
        await sleep(WEB_VIEW_SCROLL_TIMEOUT);
