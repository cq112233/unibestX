const WEB_VIEW_SCROLL_TIMEOUT = 800;
async function webViewScrollSnapshot(el) {
    return new Promise(async (resolve, reject) => {
        const controller = el['controller'];
        const originOffsetY = el['curOffsetY'];
        const componentWidth = el['widthByAreaChange'];
        const componentHeight = el['heightByAreaChange'];
        const scrollHeight = componentHeight * 0.7;
