        // æ»šåŠ¨ç»“æŸï¼Œåˆå¹¶æ‰€æœ‰æˆªå›¾
        return await mergeImage(areaArray, scrollYOffsets[scrollYOffsets.length - 1], componentWidth, componentHeight);
    }
