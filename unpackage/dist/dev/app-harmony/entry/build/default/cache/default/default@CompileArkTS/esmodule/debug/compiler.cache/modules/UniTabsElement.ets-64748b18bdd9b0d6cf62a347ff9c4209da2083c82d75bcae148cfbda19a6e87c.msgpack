    removeTabBarBadge(op) {
        this.page.removeTabBarBadge(op);
    }
    showTabBarRedDot(op) {
        this.page.showTabBarRedDot(op);
    }
    hideTabBarRedDot(op) {
        this.page.hideTabBarRedDot(op);
    }
    setTabBarItem(op) {
        this.page.setTabBarItem(op);
    }
    setTabBarStyle(tabBar) {
        this.page.setTabBarStyle(tabBar);
