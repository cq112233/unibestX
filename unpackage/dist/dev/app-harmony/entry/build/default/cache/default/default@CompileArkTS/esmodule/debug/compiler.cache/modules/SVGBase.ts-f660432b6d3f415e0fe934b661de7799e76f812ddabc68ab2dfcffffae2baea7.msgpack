    super()
    this.text = text;
  }

  public toString(): string {
    return "TextChild: '" + this.text + "'";
  }

  public setTextRoot(obj: TextRoot) {
    this.textRoot = obj;
  }

  public getTextRoot(): TextRoot {
    return this.textRoot;
  }
}


