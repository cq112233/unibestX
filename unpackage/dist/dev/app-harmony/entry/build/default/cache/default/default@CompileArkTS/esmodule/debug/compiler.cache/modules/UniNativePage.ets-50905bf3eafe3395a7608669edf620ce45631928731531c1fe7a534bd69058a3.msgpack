    showWithAnimation(animationType, duration) {
        const router = this.app.router;
        if (!this.isRendering) {
            // é¡µé¢åŠ¨ç”»æš‚æ—¶ä»…æ”¯æŒ pop-in none
            router.pushPathByName(this.pageId, undefined, duration !== 0);
        }
        else {
            // å·²æ˜¾ç¤ºçš„éTabé¡µé¢ç§»åŠ¨åˆ°é¡¶å±‚
            if (this.page) {
                router.moveToTop(this.page.name, false);
            }
        }
    }
    close(options, callback) {
        let animationType = checkAnimationOutType(options?.get('animationType'));
        const animationDuration = options?.has('animationDuration') ? options?.get('animationDuration') : this.showDuration;
        if (animationType === 'auto') {
            animationType = resolveAnimationOutType(this.showAnimationType);
        }
        let duration = animationType === 'none' ? 0 : animationDuration || 300;
        pagesMap.delete(this.pageId);
        const index = pagesArray.indexOf(this);
        if (index !== -1) {
            pagesArray.splice(index, 1);
        }
        this.stopRender();
        if (!this.isRendering) {
            duration = 0;
        }
        this.closeWithAnimation(animationType, duration);
        this.isRendering = false;
        // TODO clean
        // TODO ä½¿ç”¨é¡µé¢æ˜¾ç¤ºåŠ¨ç”»å®Œæˆæ—¶æœº
        if (callback) {
            setTimeout(() => {
                try {
                    callback();
                }
                catch (e) {
                    console.error(e);
                }
                this.dispose();
            }, duration);
        }
        // è§¦å‘onUnload
        this._emitter.emit('onUnload');
        if (!callback) {
            this.dispose();
        }
    }
    // é¿å…å†…å­˜æ³„æ¼
    dispose() {
        this.navBarFrameNode.disposeTree();
