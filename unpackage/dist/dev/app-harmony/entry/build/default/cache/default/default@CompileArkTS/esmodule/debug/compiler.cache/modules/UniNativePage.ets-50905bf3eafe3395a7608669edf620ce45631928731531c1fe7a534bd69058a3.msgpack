        const animationType = this.pageId.startsWith('tabBar') ? 'none' :
            checkAnimationInType(options?.get('animationType'));
        const animationDuration = options?.get('animationDuration');
        let duration = animationType === 'none' ? 0 : animationDuration || 300;
        if (this.isRendering) {
            duration = 0;
        }
        this.showAnimationType = animationType;
        this.showDuration = duration;
        this.showWithAnimation(animationType, duration);
        this.isRendering = true;
        if (callback) {
            if (duration > 0) {
                // TODO ä½¿ç”¨é¡µé¢æ˜¾ç¤ºåŠ¨ç”»å®Œæˆæ—¶æœº
                setTimeout(callback, duration);
