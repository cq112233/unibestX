  get type() {
    return 'default'
  }

  document: UniDocumentImpl
  protected isRendering = false
  /**
   * å…³è”çš„ UniApp å®ä¾‹
   * @internal
   */
  app: UniNativeAppImpl
  /**
   * é¡µé¢å®ä¾‹
   * @internal
   */
