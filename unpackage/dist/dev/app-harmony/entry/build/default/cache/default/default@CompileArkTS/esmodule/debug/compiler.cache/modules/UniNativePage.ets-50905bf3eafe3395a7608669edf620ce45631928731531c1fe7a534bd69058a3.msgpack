  private _emitter = new TinyEmitter()
  protected dialogPagesFrameNode: typeNode.Stack | null = null
  protected fullscreenFrameNode: typeNode.Stack | null = null
  /**
   * @internal
   */
  contentFrameNode: typeNode.Stack
