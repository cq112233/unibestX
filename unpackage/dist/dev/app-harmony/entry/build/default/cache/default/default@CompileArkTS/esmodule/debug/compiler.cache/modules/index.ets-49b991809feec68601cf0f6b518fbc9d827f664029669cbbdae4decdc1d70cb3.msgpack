    registerCallback(cbId, options) {
        if (this.disposed) {
            return;
        }
        this.pendingCallbacks.set(cbId, options);
    }
    handleCallback(cbId, result) {
        const callbacks = UTS.mapGet(this.pendingCallbacks, cbId);
        this.pendingCallbacks.delete(cbId);
        if (callbacks == null) {
            LOG('Callback not found for id:', cbId.toString());
            return;
        }
        const errMsg = result['errMsg'];
        const isSuccess = errMsg != null && errMsg.indexOf(':ok') > -1;
        if (isSuccess) {
            const success = callbacks['success'];
            if (success != null) {
                success(result);
            }
        }
        else {
            const fail = callbacks['fail'];
            if (fail != null) {
                fail(result);
            }
        }
        const complete = callbacks['complete'];
        if (complete != null) {
            complete(result);
        }
    }
    dispose() {
        if (this.disposed) {
            return;
        }
        this.disposed = true;
        this.pendingCallbacks.clear();
        uni.$off(createEditorEventName('callback', this.id));
    }
}
