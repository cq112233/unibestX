<style>
.weapp-tw-border {
    border-width: 0
}
</style>
<!--
  ========================================================================
  TabBar 悬浮胶囊 UI 组件 (Custom Floating Capsule TabBar)
  作者：cq112233
  ========================================================================
-->
<script setup lang="uts">
import { computed, onMounted, onUnmounted } from 'vue';
import {
  activeThemeColor,
  curIdx,
  customTabbarConfig,
  formatTabbarText,
  handleTabbarClick,
  isDark,
  resetTabSwitchThrottle,
  safeHideNativeTabBar,
  safeRestoreNativeTabBar,
  syncCurIdxByCurrentPage,
  tabbarList,
  themeTokens
} from '@/src/tabbar/index.uts';
import { safeAreaInsets } from '@/src/utils/systemInfo/index.uts';

const props = defineProps({
  /** 悬浮 TabBar 容器高度（默认 64px） */
  height: {
    type: Number,
    default: 64
  },
  /** 底部与屏幕边缘的间距（默认 12px） */
  bottomOffset: {
    type: Number,
    default: 12
  },
  /** 是否渲染底部占位块（默认 false） */
  showPlaceholder: {
    type: Boolean,
    default: false
  },
  /** 是否开启毛玻璃效果（默认 false） */
  glassEffect: {
    type: Boolean,
    default: false
  }
});

/** 是否开启毛玻璃效果（优先取 prop，未传或为 false 时降级读取 config.uts 中的 glassEffect 配置） */
const isGlass = computed<boolean>((): boolean => {
  if (props.glassEffect) {
    return true;
  }
  return customTabbarConfig.glassEffect == true;
});

/** 胶囊底座背景色（开启毛玻璃时使用半透明色值，未开启使用实色） */
const tabBgColor = computed<string>((): string => {
  if (isGlass.value) {
    return isDark.value ? 'rgba(30, 41, 59, 0.8)' : 'rgba(255, 255, 255, 0.82)';
  }
  return themeTokens.value.tabBg;
});

/** 胶囊底座边框色（开启毛玻璃时使用半透明通透边框） */
const tabBorderColor = computed<string>((): string => {
  if (isGlass.value) {
    return isDark.value ? 'rgba(255, 255, 255, 0.12)' : 'rgba(255, 255, 255, 0.6)';
  }
  return themeTokens.value.tabBorder;
});

/** 安全区底部高度 */
const safeAreaBottom = computed<number>((): number => {
  const insets = safeAreaInsets.value;
  return insets != null ? insets.bottom : 0;
});

/** 激活项的高亮胶囊底色（暗黑模式白色，浅色模式主题色，透明度由 pill 节点通过 opacity 控制，杜绝 8 位 hex 在 iOS 原生下变成实心红） */
const activeItemBgColor = computed<string>((): string => {
  if (isDark.value) {
    return '#ffffff';
  }
  return activeThemeColor.value;
});

/** 激活项高亮胶囊的不透明度 */
const activeItemBgOpacity = computed<number>((): number => {
  return isDark.value ? 0.15 : 0.12;
});

/** 滑块单项宽度占比（百分比） */
const sliderWidthPercent = computed<number>((): number => {
  if (tabbarList.length == 0) {
    return 25;
  }
  return 100 / tabbarList.length;
});

/**
 * 滑块平滑过渡动画：开关已下沉到样式层，由条件编译分流，无需 JS 参与。
 *
 * - 非 App 端（H5 / Web / 各小程序）：`.capsule-slider` 保留 220ms transform 过渡，平滑滑动；
 * - App 原生端（APP-ANDROID / APP-IOS / APP-HARMONY）：由样式里的 `#ifndef APP` 条件编译
 *   整段剔除过渡，滑块直接跳到目标位置 —— 规避快速连续切换 Tab 时 transition 被反复打断、
 *   滑块有几率停在中间位置 / 与 curIdx 不一致的问题。
 */

/**
 * 动态滑块平移动画样式（transition 声明在静态类里，此处只下发 transform）
 *
 * ⚠️ 必须返回字符串：App 端（5.31 蒸汽模式 / 字节码，真机与云打包均复现）把
 * 「值类型为 UTSJSONObject 的 computed/ref」直接绑给 :style 时，整条样式会被静默丢弃，
 * 滑块恒定停在第 0 项；返回字符串、或把对象字面量内联进模板，均正常。
 */
const sliderStyle = computed<string>((): string => {
  const widthPct = sliderWidthPercent.value;
  const offsetPct = curIdx.value * 100;
  // uni.__log__('log','at src/tabbar/ui/capsule/index.uvue:123','[SLIDER] calc curIdx=', curIdx.value, '=>', `translateX(${offsetPct}%)`);
  return `width: ${widthPct}%;transform: translateX(${offsetPct}%);`;
});

let isMounted = false;

// 挂载时同步激活索引并确保原生 TabBar 隐藏
onMounted(() => {
  isMounted = true;
  syncCurIdxByCurrentPage();
  safeHideNativeTabBar();
});

// 卸载时彻底清理异步资源、还原原生 TabBar 并重置切换节流锁
onUnmounted(() => {
  isMounted = false;
  safeRestoreNativeTabBar();
  resetTabSwitchThrottle();
});

/** 处理 Tab 点击 */
function onTabClick(index: number) {
  if (!isMounted) {
    return;
  }
  handleTabbarClick(index);
}

/** 获取多语言翻译文本 */
function getText(text: string): string {
  return formatTabbarText(text);
}

/** 获取图标字体名称 */
function getItemIcon(index: number): string {
  if (tabbarList.length <= index) {
    return '';
  }
  const item = tabbarList[index];
  if (curIdx.value == index && item.iconActive.length > 0) {
    return item.iconActive;
  }
  return item.icon;
}

/** 获取图标图片路径 */
function getItemIconPath(index: number): string {
  if (tabbarList.length <= index) {
    return '';
  }
  const item = tabbarList[index];
  if (curIdx.value == index && item.selectedIconPath != null && item.selectedIconPath!.length > 0) {
    return item.selectedIconPath!;
  }
  return item.iconPath != null ? item.iconPath! : '';
}

/** 获取图标颜色 */
function getItemIconColor(index: number): string {
  return curIdx.value == index ? activeThemeColor.value : themeTokens.value.tabColor;
}

/** 获取文字颜色 */
function getItemTextColor(index: number): string {
  return curIdx.value == index ? activeThemeColor.value : themeTokens.value.tabColor;
}

/** 获取文字字重 */
function getItemFontWeight(index: number): string {
  return curIdx.value == index ? '600' : 'normal';
}

/** 适配 iOS 和 Android 底部安全区高度，iOS 默认 -12px */
const bottom = computed(() => {
  // 0 代表没有获取到安全区高度，直接使用 props.bottomOffset
  if (safeAreaBottom.value == 0) {
    return `${props.bottomOffset}`;
  }
  // 12px 是悬浮胶囊底座和底部内容的间距
  return `${props.bottomOffset + safeAreaBottom.value - 12}`;
});
</script>

<template>
  <view class="weapp-tw-border custom-capsule-wrapper">
    <!-- 底部占位块：防止页面底部内容被悬浮 Tab 栏遮挡 -->
    <view
      v-if="showPlaceholder" class="weapp-tw-border custom-capsule-placeholder"
      :style="{ height: `${height + bottomOffset * 2 + safeAreaBottom}px` }"
    />

    <!-- 悬浮胶囊底座主容器 -->
    <view
      class="weapp-tw-border custom-capsule-container"
      :class="{ 'capsule-glass': isGlass }"
      :style="{
        bottom: `${bottom}px`,
        height: `${height}px`,
        backgroundColor: tabBgColor,
        borderColor: tabBorderColor
      }"
    >
      <!-- 滑动滑块：在各 Tab 底部平滑移动 (Animated Slider Pill) -->
      <view class="weapp-tw-border capsule-slider-track">
        <view
          class="weapp-tw-border capsule-slider"
          :style="sliderStyle"
        >
          <view class="weapp-tw-border capsule-slider-pill" :style="{ backgroundColor: activeItemBgColor, opacity: activeItemBgOpacity }" />
        </view>
      </view>

      <!-- 各 Tab 交互格位 -->
      <view
        v-for="(item, index) in tabbarList"
        :key="item.pagePath.length > 0 ? item.pagePath : `${item.text}_${index}`"
        class="weapp-tw-border capsule-item-slot"
        @click="onTabClick(index)"
      >
        <!-- 胶囊项包装块 -->
        <view class="weapp-tw-border capsule-item-inner">
          <!-- 图标与角标容器 -->
          <view class="weapp-tw-border capsule-icon-wrap">
            <!-- uni-icons 字体图标 -->
            <uni-icons
              v-if="item.iconType == 'icon'" :type="getItemIcon(index)" :size="20"
              :color="getItemIconColor(index)"
            />
            <!-- 图片图标 -->
            <image v-else :src="getItemIconPath(index)" class="capsule-icon-image" />

            <!-- 小红点角标 -->
            <view v-if="item.badge != null && `${item.badge}` == 'dot'" class="weapp-tw-border capsule-badge-dot" />
            <!-- 文本数字角标 -->
            <view v-else-if="item.badge != null && `${item.badge}` != 'dot'" class="weapp-tw-border capsule-badge-text">
              <text class="weapp-tw-border capsule-badge-label">{{ item.badge }}</text>
            </view>
          </view>

          <!-- 标签文字（支持 i18n 翻译） -->
          <text
            class="weapp-tw-border capsule-item-text" :style="{
              color: getItemTextColor(index),
              fontWeight: getItemFontWeight(index)
            }"
          >
            {{ getText(item.text) }}
          </text>
        </view>
      </view>
    </view>
  </view>
</template>

<style>
.custom-capsule-wrapper {
  /* 作为内部 absolute 胶囊的定位基准：本容器位于内容流末尾（flex 剩余空间之外），
     其底边即页面可用区域底边，胶囊据此贴底悬浮 */
  position: relative;
  width: 100%;
  overflow: visible;
}

/* 占位容器 */
.custom-capsule-placeholder {
  width: 100%;
}

/* 悬浮胶囊主底座 */
.custom-capsule-container {
  /* 相对 .custom-capsule-wrapper 定位；垂直位置由模板绑定的 bottom（含安全区）决定，
     此处不可再写 top，否则 top 胜出会把胶囊顶出可视区 */
  position: absolute;
  right: 16px;
  left: 16px;
  z-index: 999;
  flex-direction: row;
  justify-content: space-around;
  align-items: center;
  padding: 4px 6px;
  border-width: 1px;
  border-style: solid;
  border-radius: 34px;
  /* 轻量弱阴影，避免在原生 Android 端阴影重绘掉帧 */
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

/* 毛玻璃磨砂滤镜效果（Web / 小程序） */
.capsule-glass {



}

/* 动态滑块滑动轨道（与外层 4px 6px padding 区域对齐） */
.capsule-slider-track {
  position: absolute;
  top: 4px;
  right: 6px;
  bottom: 4px;
  left: 6px;
  z-index: 1;
  flex-direction: row;
  pointer-events: none;
}

/* 滑块单元：非 App 端【220ms 平滑过渡】，App 原生端【无过渡】直接定位 */
.capsule-slider {
  justify-content: center;
  align-items: center;
  width: 25%;
  height: 100%;
  /* ⚠️ App 原生端（APP-ANDROID / APP-IOS / APP-HARMONY）关闭过渡动画：
     快速连续切换 Tab 时 transform 的 transition 会被反复打断，有几率停在中间位置 / 与 curIdx 不一致。
     故用 #ifndef APP 把整段过渡从 App 端产物中剔除，只有 H5 / Web / 小程序保留 220ms 平滑滑动。 */





}

/* 动态滑块本体胶囊（高亮背景） */
.capsule-slider-pill {
  width: 90%;
  height: 84%;
  border-radius: 20px;
}

/* 单个 Tab 格位 */
.capsule-item-slot {
  position: relative;
  z-index: 2;
  justify-content: center;
  align-items: center;
  flex: 1;
  height: 100%;
  background-color: transparent;
}

/* 原生点击轻触反馈态 */
.capsule-item-hover {
  opacity: 0.75;
}

/* 胶囊内容项 */
.capsule-item-inner {
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 90%;
  height: 84%;
  padding: 2px 0;
  border-radius: 20px;
}

/* 图标包裹器（含绝对定位徽标） */
.capsule-icon-wrap {
  position: relative;
  justify-content: center;
  align-items: center;
  height: 22px;
}

.capsule-icon-image {
  width: 20px;
  height: 20px;
}

/* 标签文本 */
.capsule-item-text {
  margin-top: 2px;
  font-size: 11px;
  line-height: 14px;
}

/* 徽标小红点 */
.capsule-badge-dot {
  position: absolute;
  top: -2px;
  right: -6px;
  width: 7px;
  height: 7px;
  border-radius: 999px;
  background-color: #ef4444;
}

/* 徽标数字/文字胶囊 */
.capsule-badge-text {
  position: absolute;
  top: -4px;
  right: -12px;
  justify-content: center;
  align-items: center;
  height: 14px;
  padding: 0 4px;
  border-radius: 999px;
  background-color: #ef4444;
}

.capsule-badge-label {
  color: #ffffff;
  font-size: 9px;
  font-weight: bold;
}
</style>
