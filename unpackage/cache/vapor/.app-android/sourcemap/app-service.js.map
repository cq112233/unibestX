<style>
.weapp-tw-border {
    border-width: 0
}
</style>
<template>
  <AppKu :layout="'navbar'" :show-back="true" :hide-navbar="false" :enable-pull-down-refresh="false" :page-style="{'navigationBarTitleText':'WebView 双向通讯','navigationStyle':'custom','mp-alipay':{'transparentTitle':'always','titlePenetrate':'YES','defaultTitle':''}}">

  <LayoutComponent :show-back="true" :hide-navbar="false" :enable-pull-down-refresh="false" :page-style="{'navigationBarTitleText':'WebView 双向通讯','navigationStyle':'custom','mp-alipay':{'transparentTitle':'always','titlePenetrate':'YES','defaultTitle':''}}">

  <view class="weapp-tw-border wtu-1gjaf63-0 wtu-4q77rs-1 wtu-12od5l-2" :style="{ height: `${availableHeight}px` }">
    <web-view
      class="wtu-12od5l-2 wtu-1m59e2p-3 wtu-1auky92-4"
      style="flex: 1;"
      :src="targetUrl"
      @message="onWebviewMessage"
    />
  </view>

  </LayoutComponent>

  </AppKu>
</template>

<script setup lang="uts">
import AppKu from '@/App.ku.uvue'
import LayoutComponent from '@/src/layouts/navbar/navbar.uvue'
/* eslint-disable dot-notation */
import { ref } from 'vue';
import { availableHeight } from '@/src/utils/systemInfo/index.uts';
;

// 默认加载项目内置的双向通讯演示网页
const defaultDemoUrl = '/static/webview/index.html';
const targetUrl = ref<string>(defaultDemoUrl);

// 参数解析：优先使用传入的 url（供隐私协议等外链使用），未传时回退到默认演示页面
onLoad((options: UTSJSONObject | null) => {
  if (options != null) {
    const raw = options['url'] as string | null;
    if (raw != null && raw != '') {
      const decoded = decodeURIComponent(raw);
      targetUrl.value = decoded != null ? decoded : raw;
      return;
    }
  }
  targetUrl.value = defaultDemoUrl;
});

function onWebviewMessage(event: UniWebViewMessageEvent): void {
  const detail = event.detail;
  const data = detail.data;
  if (data != null && data.length > 0) {
    const lastItem = data[data.length - 1] as UTSJSONObject;
    const msgType = lastItem['type'] as string | null;
    if (msgType === 'NAVIGATE_BACK') {
      uni.navigateBack();
      return;
    }
    const title = (lastItem['title'] as string | null) ?? (lastItem['content'] as string | null) ?? '收到网页消息';
    uni.showToast({
      title,
      icon: 'none'
    });
  }
}
</script>

