<style>
.weapp-tw-border {
    border-width: 0
}
</style>
<template>
  <AppKu :custom-page-class="'page-container'" :custom-page-style="'background-color: transparent;'" :layout="'navbar'" :show-back="false" :hide-status-bar="false" :hide-navbar="false" :enable-pull-down-refresh="false" :page-style="{'navigationBarTitleText':'隐私政策','navigationStyle':'custom','mp-alipay':{'transparentTitle':'always','titlePenetrate':'YES','defaultTitle':''}}">

  <LayoutComponent :custom-page-class="'page-container'" :custom-page-style="'background-color: transparent;'" :show-back="false" :hide-status-bar="false" :hide-navbar="false" :enable-pull-down-refresh="false" :page-style="{'navigationBarTitleText':'隐私政策','navigationStyle':'custom','mp-alipay':{'transparentTitle':'always','titlePenetrate':'YES','defaultTitle':''}}">

  <!-- 页面根容器：view + flex-1 弹性撑满，滚动交给内部 scroll-view；白底简约风格 -->
  <view class="weapp-tw-border wtu-1o1n9yz-0 wtu-1pr8w94-1 wtu-7ps76x-2 wtu-izzeb5-3 wtu-1im2oxp-4 wtu-cf1v5z-5">
    <!-- 协议正文区（可滚动）：标题 / 摘要 / 协议入口 / 底部说明 -->
    <scroll-view direction="vertical" class="wtu-7ps76x-2 wtu-1o1n9yz-0 wtu-1pr8w94-1" :show-scrollbar="false">
      <!-- 标题 -->
      <view class="weapp-tw-border wtu-tvxms1-6">
        <text class="weapp-tw-border wtu-ytg9ml-7 wtu-reo5un-8 wtu-1d8v6s9-9">{{ title }}</text>
      </view>

      <!-- 摘要：按首启 / 再确认两种语境切换措辞 -->
      <view class="weapp-tw-border wtu-tvxms1-6 wtu-1maix56-a">
        <text class="weapp-tw-border wtu-dnj5q1-b wtu-k77ddp-c wtu-2ac2hq-d">{{ summaryText }}</text>
      </view>

      <!-- 协议入口列表（L2 纯展示块，点击抛 openAgreement）；文字用主题色 -->
      <view class="weapp-tw-border wtu-tvxms1-6 wtu-1t87zq9-e">
        <view
          v-for="item in agreements"
          :key="item.key"
          class="weapp-tw-border wtu-1o1n9yz-0 wtu-g8ocem-f wtu-1ki0k1u-g wtu-1f88bt-h"
          @click="openAgreement(item)"
        >
          <text class="weapp-tw-border wtu-dnj5q1-b wtu-8n0dhm-i">{{ `《${item.label}》` }}</text>
        </view>
      </view>

      <!-- 底部说明 -->
      <view class="weapp-tw-border wtu-tvxms1-6 wtu-1maix56-a">
        <text class="weapp-tw-border wtu-11xypna-j wtu-2walbn-k wtu-tci2ki-l">{{ footerTip }}</text>
      </view>
    </scroll-view>

    <!-- 底部操作区：主按钮常显；拒绝按钮仅在首启场景展示，避免把老用户挡死 -->
    <view class="weapp-tw-border wtu-tvxms1-6 wtu-1maix56-a wtu-xvahoz-m">
      <view
        class="weapp-tw-border wtu-tvxms1-6 wtu-qrfeld-n wtu-xij1pm-o wtu-1o1n9yz-0 wtu-g8ocem-f wtu-1ki0k1u-g wtu-yf682u-p wtu-dbd1ti-q"
        @click="onAgree"
      >
        <text class="weapp-tw-border wtu-yd5c63-r wtu-kn1xl8-s wtu-reo5un-8">{{ agreeText }}</text>
      </view>
      <view
        v-if="!isReconfirm"
        class="weapp-tw-border wtu-tvxms1-6 wtu-qrfeld-n wtu-129xl1l-t wtu-xij1pm-o wtu-12h06is-u wtu-dx7rf8-v wtu-xwb10q-w wtu-1o1n9yz-0 wtu-g8ocem-f wtu-1ki0k1u-g wtu-yf682u-p"
        @click="onReject"
      >
        <text class="weapp-tw-border wtu-kn1xl8-s wtu-tci2ki-l">{{ rejectText }}</text>
      </view>
    </view>
  </view>

  </LayoutComponent>

  </AppKu>
</template>

<script setup lang="uts">
import AppKu from '@/App.ku.uvue'
import LayoutComponent from '@/src/layouts/navbar/navbar.uvue'
/* eslint-disable dot-notation */
/**
 * 隐私合规页（src/sub/privacy/privacy.uvue）
 *
 * 两种打开方式：
 * 1. 首启闸门：未同意过时由 App.onLaunch 跳入，按钮为「同意并进入应用」，提供「不同意并退出」
 * 2. 版本再确认：已同意但 policyVersion 变更时跳入（?mode=reconfirm），
 *    按钮为「同意并继续」，且不展示拒绝按钮，避免把老用户挡在门外
 */
import { computed, ref } from 'vue';
import { fetchPrivacyContent } from '@/src/api/privacy/privacy.uts';
import type { PrivacyContent } from '@/src/api/privacy/privacy.uts';
import { getAppTitle, MODE_RECONFIRM, privacyConfig, setPrivacyAgreed } from '@/src/config/index.uts';
import { toast } from '@/src/utils/toast/index.uts';

// 协议条目：key 用于 v-for 的 :key，url 由隐私配置注入（空串表示未配置）
type AgreementItem = {
  key: string;
  label: string;
  url: string;
};

// 兜底文案：接口返回前首帧即有内容，避免标题 / 按钮闪空
const FALLBACK_CONTENT: PrivacyContent = {
  title: '用户协议与隐私政策',
  summary: '',
  reconfirmSummary: '',
  agreeText: '同意',
  reconfirmAgreeText: '同意并继续',
  rejectText: '不同意并退出'
};
;

/** 是否处于「协议版本变更后再确认」场景 */
const isReconfirm = ref<boolean>(false);

// —— 页面文案：走页面接口层（@/src/api/privacy/privacy.uts），开发期返回本地数据
const content = ref<PrivacyContent>(FALLBACK_CONTENT);

function loadContent(): void {
  fetchPrivacyContent()
    .then((data: PrivacyContent): void => {
      content.value = data;
    }, (err: any): void => {
      uni.__log__('error','at src/sub/privacy/privacy.uvue:118','隐私页文案加载失败:', err);
    });
}

// —— 以下文案均由接口数据派生，页面不再硬编码任何合规话术
const title = computed((): string => content.value.title);

const summaryText = computed((): string => {
  return isReconfirm.value ? content.value.reconfirmSummary : content.value.summary;
});

const agreeText = computed((): string => {
  return isReconfirm.value ? content.value.reconfirmAgreeText : content.value.agreeText;
});

const rejectText = computed((): string => content.value.rejectText);

// —— 协议列表：链接来自隐私配置，未配置时为空串，点击时提示
const agreements = computed((): Array<AgreementItem> => {
  return [
    { key: 'user', label: '用户协议', url: privacyConfig.userAgreementUrl } as AgreementItem,
    { key: 'policy', label: '隐私政策', url: privacyConfig.privacyPolicyUrl } as AgreementItem
  ];
});

const footerTip = computed((): string => {
  const company = privacyConfig.companyName != '' ? privacyConfig.companyName : getAppTitle();
  return `点击「同意」即表示你已阅读并同意上述协议，${company}将依法保护你的个人信息。`;
});

// —— 交互：打开协议文档
/** 未配置链接时明确提示，避免开发期漏配却无感 */
function openAgreement(item: AgreementItem): void {
  if (item.url == '') {
    toast(`请在 src/config/privacy/privacy.uts 配置《${item.label}》地址`);
    return;
  }
  uni.navigateTo({
    url: `/src/sub/webview/webview?url=${encodeURIComponent(item.url)}&title=${encodeURIComponent(item.label)}`
  });
}

// —— 交互：同意 / 拒绝
function onAgree(): void {
  setPrivacyAgreed();
  uni.reLaunch({ url: '/src/pages/index/index' });
}

/** App 端直接退出；其它端无法退出应用，提示后停留 */
function onReject(): void {

  uni.exit();




}

onLoad((options: UTSJSONObject | null) => {
  loadContent();
  if (options == null) {
    return;
  }
  const mode = options['mode'] as string | null;
  if (mode != null && mode == MODE_RECONFIRM) {
    isReconfirm.value = true;
  }
});
</script>

