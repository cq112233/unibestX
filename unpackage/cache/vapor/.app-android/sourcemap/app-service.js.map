<style>
.weapp-tw-border {
    border-width: 0
}
</style>
<!--
  TabContent.uvue - 单页面 TabBar 容器子视图包裹组件

  【核心职责】
  1. 承载模式 4（单页面 TabBar 容器模式）下各 Tab 项（首页、基础、功能、我的等）的视图内容与插槽；
  2. 独立管理各 Tab 专属的滚动容器（scroll-view）、局部下拉刷新状态机与触底事件；
  3. 负责当前激活 Tab 的顶部导航栏标题（多语言 $t 同步）与状态栏显隐联动；
  4. 实现全端保活机制（移出视口 + visibility），并解决微信小程序与原生端切 Tab 时下拉刷新卡死问题。
-->
<template>
  <!-- 根视图容器：当该 Tab 首次被激活并完成初始渲染后常驻保活，非激活状态通过 rootStyle 移出视口 -->
  <view
    v-if="hasRendered"
    :style="rootStyle"
    class="weapp-tw-border tab-content-wrapper"
    :class="customPageClass"
  >
    <!--
      纵向滚动容器：各 Tab 独立拥有独立的滚动区域
      :key="refresherKey" - 在刷新中途强行切走 Tab 时，通过改变 key 彻底重构组件，清除小程序/原生端卡死的转圈
      :refresher-enabled - 是否开启自定义下拉刷新能力（保持稳定，严禁受 isActive 控制导致拔插头冻结）
      :refresher-triggered - 下拉刷新动画状态（true 刷新中，false 已复位收起）
      @refresherrefresh - 用户手势下拉达到阈值后触发的刷新事件
      @refresherrestore - 下拉刷新控件动画彻底复位收起事件
      @refresherabort - 手势异常中断或下拉未达阈值释放事件（鸿蒙/小程序兜底复位）
      @scroll - 页面滚动监听，向上派发 onNavbarPageScroll 事件
      @scrolltolower - 滚动触底监听，向上派发 onNavbarReachBottom 事件
    -->
    <!-- 1. 支付宝小程序专享：手势模拟下拉刷新（解决支付宝小程序无原生 refresher 问题） -->
    <scroll-view
      v-if="isMpAlipay"
      :key="`alipay-${refresherKey}`"
      direction="vertical"
      class="tab-content-scroll"
      style="flex: 1;"
      :lower-threshold="50"
      @scroll="handleScroll"
      @scrolltolower="handleScrollToLower"
      @touchstart="handleAlipayTouchStart"
      @touchmove="handleAlipayTouchMove"
      @touchend="handleAlipayTouchEnd"
      @touchcancel="handleAlipayTouchEnd"
    >
      <!-- 微信小程序同款：三个小圆点手势下拉刷新 Header -->
      <view
        class="weapp-tw-border alipay-pull-header"
        :style="alipayHeaderStyle"
      >
        <view class="weapp-tw-border wechat-pull-dots" :class="{ 'wechat-pull-dots--active': isTriggered }">
          <view class="weapp-tw-border wechat-pull-dot wechat-pull-dot--1"></view>
          <view class="weapp-tw-border wechat-pull-dot wechat-pull-dot--2"></view>
          <view class="weapp-tw-border wechat-pull-dot wechat-pull-dot--3"></view>
        </view>
      </view>
      <!-- 插槽：放置对应 Tab 的具体业务视图组件（如 IndexView、BasicView 等） -->
      <slot />

      <!-- 底部 TabBar 统一占位垫高组件：根据 VITE_TABBAR_MODE、风格形态及安全区动态计算高度 -->
      <TabbarPlaceholder />
    </scroll-view>

    <!-- 2. 原生全端（Android VDOM / iOS / Web / 微信小程序）：原生高性能极速滚动，无任何 touch 事件干扰 -->
    <scroll-view
      v-else
      :key="`native-${refresherKey}`"
      direction="vertical"
      class="tab-content-scroll"
      style="flex: 1;"
      :refresher-enabled="isRefresherEnabled"
      :refresher-triggered="isTriggered"
      :refresher-background="themeTokens.bgContent"
      :lower-threshold="50"
      @refresherrefresh="handleRefresherRefresh"
      @refresherrestore="handleRefresherRestore"
      @refresherabort="handleRefresherRestore"
      @scroll="handleScroll"
      @scrolltolower="handleScrollToLower"
    >
      <!-- 插槽：放置对应 Tab 的具体业务视图组件（如 IndexView、BasicView 等） -->
      <slot />

      <!-- 底部 TabBar 统一占位垫高组件：根据 VITE_TABBAR_MODE、风格形态及安全区动态计算高度 -->
      <TabbarPlaceholder />
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import { computed, onMounted, onUnmounted, provide, ref, watch } from 'vue';
import { activeTabTitle, curIdx, formatTabbarText, themeTokens } from '@/src/tabbar/index.uts';
import TabbarPlaceholder from './TabbarPlaceholder.uvue';
import { isMpAlipay } from '@/src/config/env/platform.uts';
import {
  isPageRefresherDisabled,
  isPageScrollDisabled,
  setHideNavbar,
  setHideStatusBar,
  stopNavbarPullDownRefresh
} from '@/src/layouts/navbar/utils/index.uts';

// ==========================================
// 1. 组件 Props 属性定义
// ==========================================
const props = defineProps({
  /** 当前 Tab 对应的索引下标（0: 首页, 1: 基础, 2: 功能, 3: 我的 等） */
  contentIndex: {
    type: Number,
    required: true
  },
  /** 可选的自定义导航栏标题（若未指定，默认自动读取当前 Tab 项的多语言配置文案） */
  title: {
    type: String,
    default: ''
  },
  /** 当前 Tab 是否隐藏顶部导航栏（各 Tab 独立控制显隐，true 隐藏，false 正常显示） */
  hideNavbar: {
    type: Boolean,
    default: false
  },
  /** 当前 Tab 是否隐藏状态栏占位（默认 false，true 为隐藏不占位，完全沉浸式体验） */
  hideStatusBar: {
    type: Boolean,
    default: false
  },
  /** 当前 Tab 是否启用自定义下拉刷新（默认 true） */
  enablePullDownRefresh: {
    type: Boolean,
    default: true
  },
  /** 当前 Tab 页面根容器自定义类名（对应 definePage 的 customPageClass） */
  customPageClass: {
    type: String,
    default: ''
  },
  /** 当前 Tab 页面根容器自定义行内样式（对应 definePage 的 customPageStyle） */
  customPageStyle: {
    type: String,
    default: ''
  }
});

// ==========================================
// 2. Tab 核心状态与激活控制
// ==========================================
/** 当前 Tab 是否已挂载渲染（按需懒渲染，首次点击激活后即常驻保活，避免重复销毁重挂载开销） */
const hasRendered = ref(false);

/** 计算当前 Tab 是否正处于激活显示状态 */
const isActive = computed<boolean>((): boolean => curIdx.value == props.contentIndex);

/** 标题与显隐相关的响应式计算属性（用于 watch 深度监听变更，支持多语言响应式联动） */
const contentTitle = computed((): string => {
  if (props.title.length > 0) {
    return formatTabbarText(props.title);
  }
  return '';
});
const shouldHideNavbar = computed((): boolean => props.hideNavbar);
const shouldHideStatusBar = computed((): boolean => props.hideStatusBar);

/**
 * 向下跨层级注入当前 Tab 激活状态：
 * 供子组件内使用的 fixed 定位元素通过 inject('isTabActive') 配合 v-if 彻底在切走时销毁，
 * 避免 iOS 原生引擎将 position: fixed 提升至 Page Root 无法被父级 CSS 隐藏的问题。
 */
provide('isTabActive', isActive);

// ==========================================
// 3. 样式布局
// ==========================================

/**
 * 根节点行内样式：
 * 非激活 Tab 采用「left: -9999px + visibility: hidden」移出可视区域方案；
 * 相比直接 v-if 销毁或 display: none，能完美保证 Tab 视图层 DOM 与滚动状态全端常驻保活，0ms 丝滑秒切；
 * 并融合当前 Tab 页面自定义行内样式（customPageStyle）。
 */
const rootStyle = computed((): string => {
  let s = isActive.value ? 'left: 0px; visibility: visible;' : 'left: -9999px; visibility: hidden;';
  if (props.customPageStyle.length > 0) {
    s += (s.endsWith(';') ? ' ' : '; ') + props.customPageStyle;
  }
  return s;
});

// ==========================================
// 4. 下拉刷新状态机与 Tab 切换容灾
// ==========================================
/** 下拉刷新状态控制：true 表示刷新中（展示 Loading 菊花），false 表示已复位收起 */
const isTriggered = ref(false);

/**
 * 刷新重置 key：
 * 在刷新中途用户点击切换 Tab 时，通过递增该 key 强制重新构建 scroll-view，
 * 彻底消除微信小程序及原生端因不可见或 enabled 冲突导致的原生转圈卡死死锁。
 */
const refresherKey = ref(0);

/** 标记当前 Tab 是否在刷新中途被切换 Tab 强行中断 */
let wasRefreshInterrupted: boolean = false;

/** 记录最近一次 Tab 激活或切走的时间戳，用于防范视图重现时残余手势的误触发 */
let lastTabSwitchTime: number = 0;

/**
 * 当前 Tab 是否允许下拉刷新：
 * ⚠️ 极其关键设计：此处严禁绑定 isActive！
 * 若切走 Tab 时将 enabled 动态变为 false，原生端与小程序会直接冻结正在运行的状态机，
 * 导致切回时永久卡在转圈中；保持 enabled 稳定，依靠 left: -9999px 防误触即可。
 */
const isRefresherEnabled = computed<boolean>((): boolean => {
  return props.enablePullDownRefresh && !isPageScrollDisabled.value && !isPageRefresherDisabled.value;
});

/**
 * 下拉刷新触发事件回调（用户手势下拉超过阈值时触发）
 */
function handleRefresherRefresh(): void {
  // 容灾拦截：若当前 Tab 未激活，或刚切 Tab 350ms 内触发（视图恢复时的残余 offset 误报），坚决丢弃并复位
  if (!isActive.value || (Date.now() - lastTabSwitchTime < 350)) {
    isTriggered.value = false;
    return;
  }
  isTriggered.value = true;
  // 向外全局派发页面下拉刷新通知，通知业务代码开始拉取最新数据
  uni.$emit('onPagePullDownRefresh');
}

/**
 * 下拉刷新复位完成 / 异常中断事件回调
 */
function handleRefresherRestore(): void {
  isTriggered.value = false;
}

const alipayPullHeight = ref(0);

/**
 * 监听外部业务代码发出的停止刷新通知（对应 stopNavbarPullDownRefresh()）
 */
function onStopRefresh(): void {
  isTriggered.value = false;
  alipayPullHeight.value = 0;
}

/**
 * 主动中断并彻底终止当前 Tab 的下拉刷新状态（切 Tab 或组件卸载时调用）
 */
function abortPullDownRefresh(): void {
  wasRefreshInterrupted = true;
  isTriggered.value = false;
  alipayPullHeight.value = 0;
  refresherKey.value++;
  stopNavbarPullDownRefresh();
}

let alipayTouchStartY: number = 0;
const isAlipayTouching = ref(false);
let currentScrollTop: number = 0;

/**
 * 支付宝手势下拉刷新 Header 动态样式
 */
const alipayHeaderStyle = computed((): string => {
  if (!isMpAlipay) {
    return 'height: 0px;';
  }
  const trans = isAlipayTouching.value ? 'none' : 'height 0.25s ease';
  return `height: ${alipayPullHeight.value}px; transition: ${trans};`;
});

function handleAlipayTouchStart(e: UniTouchEvent) {
  if (!isMpAlipay || !isActive.value || !props.enablePullDownRefresh) {
    return;
  }
  if (currentScrollTop <= 2 && !isTriggered.value) {
    const touches = e.touches;
    if (touches.length > 0) {
      const t = touches[0];
      alipayTouchStartY = t.clientY;
      isAlipayTouching.value = true;
    }
  }
}

function handleAlipayTouchMove(e: UniTouchEvent) {
  if (!isMpAlipay || !isAlipayTouching.value || isTriggered.value || currentScrollTop > 2) {
    return;
  }
  const touches = e.touches;
  if (touches.length > 0) {
    const t = touches[0];
    const deltaY = t.clientY - alipayTouchStartY;
    if (deltaY > 0) {
      alipayPullHeight.value = Math.min(Math.floor(deltaY * 0.45), 75);
    }
    else {
      alipayPullHeight.value = 0;
    }
  }
}

function handleAlipayTouchEnd() {
  if (!isMpAlipay || !isAlipayTouching.value) {
    return;
  }
  isAlipayTouching.value = false;
  if (alipayPullHeight.value >= 45) {
    alipayPullHeight.value = 45;
    handleRefresherRefresh();
  }
  else {
    alipayPullHeight.value = 0;
  }
}

// ==========================================
// 5. 导航栏与状态栏同步
// ==========================================
/**
 * 设置/同步当前激活 Tab 的导航栏标题
 * 直接响应式更新 activeTabTitle，不发全局事件广播，彻底杜绝跨页面事件污染与返回时序闪变
 */
function updateNavbarTitle(): void {
  if (isActive.value) {
    activeTabTitle.value = props.title.length > 0 ? props.title : contentTitle.value;
  }
}

/**
 * 完整同步当前 Tab 的导航栏标题、状态栏与导航栏显隐配置
 */
function syncNavbarState(): void {
  updateNavbarTitle();
  setHideNavbar(props.hideNavbar);
  setHideStatusBar(props.hideStatusBar);
}

// ==========================================
// 6. 滚动与触底事件派发
// ==========================================
/**
 * 滚动事件回调：统一向页面层派发 onNavbarPageScroll，保证 navbar 布局与页面监听正常工作
 */
function handleScroll(e: UniScrollEvent): void {
  if (!isActive.value) {
    return;
  }
  const scrollTop = e.detail.scrollTop;
  if (isMpAlipay) {
    currentScrollTop = Math.ceil(scrollTop);
  }
  uni.$emit('onNavbarPageScroll', {
    scrollTop: Math.ceil(scrollTop)
  } as UTSJSONObject);
}

/**
 * 滚动触底事件回调：向页面层派发 onNavbarReachBottom 事件，驱动长列表触底分页加载
 */
function handleScrollToLower(): void {
  if (!isActive.value) {
    return;
  }
  uni.$emit('onNavbarReachBottom');
}

// ==========================================
// 7. 响应式监听与生命周期
// ==========================================
/**
 * 组件初次挂载：若当前项正是默认激活项，立即标记已渲染并同步导航栏
 */
onMounted(() => {
  if (curIdx.value == props.contentIndex) {
    hasRendered.value = true;
    syncNavbarState();
  }
});

/**
 * 监听当前 Tab 激活状态切换
 */
watch(isActive, (newVal: boolean) => {
  // 记录切 Tab 时间戳，激活 350ms 内拦截任何偶发的残余刷新误触发
  lastTabSwitchTime = Date.now();
  if (newVal) {
    // 首次激活时触发懒挂载
    if (!hasRendered.value) {
      hasRendered.value = true;
    }
    // 切换进入当前 Tab 时：若之前在刷新中被切走中断，强制递增 key 彻底重置底层状态机并确保收起
    if (wasRefreshInterrupted) {
      wasRefreshInterrupted = false;
      refresherKey.value++;
      isTriggered.value = false;
      stopNavbarPullDownRefresh();
    }
    else {
      isTriggered.value = false;
    }
    // 同步本 Tab 专属的导航栏配置
    syncNavbarState();
  }
  else {
    // 切换离开当前 Tab 时：若当前正处于下拉刷新中，立即强制终止并递增 key 重构
    if (isTriggered.value) {
      abortPullDownRefresh();
    }
  }
});

/**
 * 监听自定义标题属性动态变化（仅更新内部响应式 activeTabTitle，不发全局事件）
 */
watch(contentTitle, (_newTitle: string) => {
  if (isActive.value) {
    updateNavbarTitle();
  }
});

/**
 * 监听导航栏显隐动态变化
 */
watch(shouldHideNavbar, (newVal: boolean) => {
  if (isActive.value) {
    setHideNavbar(newVal);
  }
});

/**
 * 监听状态栏显隐动态变化
 */
watch(shouldHideStatusBar, (newVal: boolean) => {
  if (isActive.value) {
    setHideStatusBar(newVal);
  }
});

// 全局监听停止刷新通知（如业务异步请求完成调用 stopNavbarPullDownRefresh()）
uni.$on('stopPagePullDownRefresh', onStopRefresh);

/**
 * 组件销毁注销生命周期：停止可能存在的刷新，注销事件监听
 */
onUnmounted(() => {
  if (isTriggered.value) {
    abortPullDownRefresh();
  }
  uni.$off('stopPagePullDownRefresh', onStopRefresh);
});

// ==========================================
// 8. 对外暴露的方法接口
// ==========================================
defineExpose({
  updateNavbarTitle,
  syncNavbarState
});
</script>

<style lang="scss" scoped>
/* Tab 视图绝对定位铺满容器，配合 left: -9999px 实现无感后台保活 */
.tab-content-wrapper {
  position: absolute;
  top: 0;
  flex-direction: column;
  width: 100%;
  height: 100%;
}

.tab-content-scroll {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.alipay-pull-header {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  width: 100%;
  overflow: hidden;
}

.wechat-pull-dots {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  padding: 10px 0;
}

.wechat-pull-dot {
  width: 7px;
  height: 7px;
  margin: 0 4px;
  border-radius: 4px;
  background-color: #94a3b8;
}

.wechat-pull-dots--active .wechat-pull-dot--1 {
  animation: wechat-dot-bounce 1.1s infinite ease-in-out;
  animation-delay: 0s;
}

.wechat-pull-dots--active .wechat-pull-dot--2 {
  animation: wechat-dot-bounce 1.1s infinite ease-in-out;
  animation-delay: 0.18s;
}

.wechat-pull-dots--active .wechat-pull-dot--3 {
  animation: wechat-dot-bounce 1.1s infinite ease-in-out;
  animation-delay: 0.36s;
}

@keyframes wechat-dot-bounce {
  0%,
  80%,
  100% {
    opacity: 0.35;
    transform: scale(0.6);
  }
  40% {
    opacity: 1;
    transform: scale(1.15);
  }
}
</style>
