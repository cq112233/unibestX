              >
                <text class="weapp-tw-border wtu-189xnz9-k wtu-142bgcr-10 wtu-1l895rj-i">恢复重置</text>
              </view>
              <view
                class="weapp-tw-border wtu-1o5z4jd-2 wtu-1cquwjz-12 wtu-1tykl4g-14 wtu-sg9a58-b wtu-q7k9xu-e wtu-efmgja-16"
