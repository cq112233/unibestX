        <text class="weapp-tw-border wtu-1a5iixk-1l wtu-akbvri-1m wtu-1ddzeyk-1n wtu-gr960d-n" style="font-family: monospace;">{{ tetradText }}</text>

        <text class="weapp-tw-border wtu-1jhonv-i wtu-1044d4i-k">analogous(6) 相似色</text>
        <view class="weapp-tw-border wtu-1ir8mq3-0 wtu-w5ot0e-m wtu-qn08vm-2 wtu-l7g8m0-l wtu-1cvf80e-y">
          <view v-for="(item, idx) in analogousColors" :key="idx" class="weapp-tw-border wtu-q7dlqx-3 wtu-1wjxgi5-1j wtu-1dvp4ls-15 wtu-fle9f4-1k" :style="{ backgroundColor: item }" />
        </view>
        <text class="weapp-tw-border wtu-1a5iixk-1l wtu-akbvri-1m wtu-1ddzeyk-1n wtu-gr960d-n" style="font-family: monospace;">{{ analogousText }}</text>

        <text class="weapp-tw-border wtu-1jhonv-i wtu-1044d4i-k">monochromatic(6) 单色系列</text>
        <view class="weapp-tw-border wtu-1ir8mq3-0 wtu-w5ot0e-m wtu-qn08vm-2 wtu-l7g8m0-l wtu-1cvf80e-y">
