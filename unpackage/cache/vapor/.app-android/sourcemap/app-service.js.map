<script setup lang="uts">
import { checkDirectEntry } from '@/src/router/interceptor/interceptor.uts';
import { useI18nStore, useThemeStore } from '@/src/store/index.uts';
import { initNativeMidButtonTap, setTabbarItem } from '@/src/tabbar/index.uts';
import { applyThemeColor, themeColor } from '@/src/theme/index.uts';
import { reportError } from '@/src/utils/report/index.uts';
// 隐私闸门仅 App 端启用，导入同步条件编译，避免其它端留下未使用导入

import { runPrivacyGate } from '@/src/config/index.uts';


onLaunch(() => {
  // 提前实例化 Theme Store（含持久化还原），并初始化外观模式：跟随系统 / 浅色 / 深色
  const themeStore = useThemeStore();
  themeStore.initThemeMode();
  // 确保全局 themeColor 与运行环境同步为持久化恢复的主题色
  if (themeStore.state.theme.length > 0) {
    themeColor.value = themeStore.state.theme;
    applyThemeColor(themeStore.state.theme);
  }

  // 提前实例化 i18n Store（含持久化还原），同步当前应用语言与原生 TabBar 文本
  const i18nStore = useI18nStore();
  i18nStore.initLocale();
  setTabbarItem();

  // 注册原生 TabBar 中间按钮监听（仅在原生模式且配置了 midButton 时生效）
  initNativeMidButtonTap();

  // 隐私合规闸门：未同意走首启页；已同意但协议版本落后走再确认
  // 放在 TabBar / 主题初始化之后，保证隐私页本身也能拿到主题与布局
  // 仅 App 端启用：H5 / 小程序在 onLaunch 期间调 reLaunch 会被启动护栏入队（页面栈尚未建立），
  // 跳转时机不可控，故这两端不在此处拦截

  if (!runPrivacyGate()) {
    return;
  }
















});

onShow((options?) => {



});

// 全局错误监听：仅可在 App.uvue 中生效
// onError 覆盖 Web / 小程序 / Android / iOS / 鸿蒙全平台（App 端 4.33+ 亦覆盖异步逻辑错误）
onError((error) => {
  reportError(error, 'App.onError');
});

// onUnhandledRejection 仅 Web 与小程序支持，App 原生端（Android / iOS / 鸿蒙）不支持，须条件编译隔离





</script>

