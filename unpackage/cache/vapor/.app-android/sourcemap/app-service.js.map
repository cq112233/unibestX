            </view>
            <view class="weapp-tw-border wtu-127m6rl-3 wtu-bj4pv9-2u">
              <view
                class="weapp-tw-border wtu-cyzcm6-3f wtu-8rmi9e-1u wtu-1xs9whh-1v wtu-i9xle1-6 wtu-q9841v-0 wtu-24spi-b wtu-74hrsa-2 wtu-yilz26-1w"
                @click="refreshListRequest"
              >
                <text class="weapp-tw-border wtu-kqj0gz-1x wtu-un2fvl-1y">refresh()</text>
              </view>
            </view>
            <view class="weapp-tw-border wtu-127m6rl-3">
              <view
                class="weapp-tw-border wtu-g66s3a-3g wtu-8rmi9e-1u wtu-1xs9whh-1v wtu-i9xle1-6 wtu-q9841v-0 wtu-24spi-b wtu-74hrsa-2 wtu-yilz26-1w"
                @click="abortListRequest"
              >
                <text class="weapp-tw-border wtu-kqj0gz-1x wtu-un2fvl-1y">abort()</text>
              </view>
            </view>
          </view>

          <!-- 5.2 失败与取消路径：真实接口 + 重试 -->
          <view class="weapp-tw-border wtu-13qns1b-1m wtu-qgas0q-1n wtu-u35y1n-3e wtu-1ij1qbg-1c wtu-147bovg-1d wtu-19jsgrm-1o">
            <view class="weapp-tw-border wtu-24spi-b wtu-1x339wl-1p wtu-74hrsa-2 wtu-7tzjme-2j">
              <text class="weapp-tw-border wtu-47z866-s wtu-8v2ggq-t">fetchFooRemote（真实接口 · retry 2）</text>
              <view class="weapp-tw-border wtu-cedmrr-y wtu-7hwrmm-p wtu-13qns1b-1m" :class="remoteStatusBgClass">
                <text class="weapp-tw-border wtu-1u1noqb-1k" :class="remoteStatusTextClass">{{ remoteStatusText }}</text>
              </view>
            </view>
            <text class="weapp-tw-border wtu-1u1noqb-1k wtu-1my4lbx-35">{{ remoteDetailText }}</text>
            <text class="weapp-tw-border wtu-jzqbgw-l wtu-18une7a-m">onError 已触发 {{ remoteErrorTick }} 次 · 请求函数实际被调用 {{ remoteCalls }} 次</text>
          </view>
          <view class="weapp-tw-border wtu-24spi-b wtu-u35y1n-3e">
            <view class="weapp-tw-border wtu-127m6rl-3 wtu-bj4pv9-2u">
              <view
                class="weapp-tw-border wtu-8aa1fa-21 wtu-8rmi9e-1u wtu-1xs9whh-1v wtu-i9xle1-6 wtu-q9841v-0 wtu-24spi-b wtu-74hrsa-2 wtu-yilz26-1w"
                @click="sendRemoteRequest"
              >
                <text class="weapp-tw-border wtu-kqj0gz-1x wtu-un2fvl-1y">发起请求</text>
              </view>
            </view>
            <view class="weapp-tw-border wtu-127m6rl-3">
              <view
                class="weapp-tw-border wtu-g66s3a-3g wtu-8rmi9e-1u wtu-1xs9whh-1v wtu-i9xle1-6 wtu-q9841v-0 wtu-24spi-b wtu-74hrsa-2 wtu-yilz26-1w"
                @click="abortRemoteRequest"
              >
                <text class="weapp-tw-border wtu-kqj0gz-1x wtu-un2fvl-1y">abort() 取消</text>
              </view>
            </view>
          </view>

          <!-- 5.3 防抖：连续输入只发一次 -->
          <view class="weapp-tw-border wtu-13qns1b-1m wtu-qgas0q-1n wtu-u35y1n-3e wtu-1ij1qbg-1c wtu-147bovg-1d wtu-19jsgrm-1o">
            <text class="weapp-tw-border wtu-47z866-s wtu-8v2ggq-t wtu-wkwmhg-11">防抖 400ms —— 连续输入只在停手后发一次</text>
            <input
              v-model="searchKeyword"
              placeholder="输入关键字，观察下方只发一次"
              class="wtu-1p87l3m-1q wtu-14tekpn-8 wtu-1qjeuzc-x wtu-lkl65m-1r wtu-1ij1qbg-1c wtu-147bovg-1d wtu-mxceye-1s wtu-47z866-s wtu-147ecx2-1t wtu-wkwmhg-11"
              @input="handleSearchInput"
            />
            <text class="weapp-tw-border wtu-1u1noqb-1k wtu-1my4lbx-35">请求函数实际被调用 {{ searchCalls }} 次</text>
            <text class="weapp-tw-border wtu-jzqbgw-l wtu-18une7a-m">最后一次发出的关键字「{{ searchLastKeyword }}」</text>
          </view>

          <!-- 5.4 轮询：不翻 loading、失败静默 -->
          <view class="weapp-tw-border wtu-13qns1b-1m wtu-qgas0q-1n wtu-1ij1qbg-1c wtu-147bovg-1d wtu-19jsgrm-1o">
            <view class="weapp-tw-border wtu-24spi-b wtu-1x339wl-1p wtu-74hrsa-2 wtu-wkwmhg-11">
              <text class="weapp-tw-border wtu-47z866-s wtu-8v2ggq-t">轮询 3s（不翻 loading、失败静默）</text>
              <text class="weapp-tw-border wtu-1u1noqb-1k wtu-1my4lbx-35">已轮询 {{ pollingTick }} 次</text>
            </view>
            <view
              class="weapp-tw-border wtu-1xs9whh-1v wtu-i9xle1-6 wtu-8rmi9e-1u wtu-q9841v-0 wtu-24spi-b wtu-74hrsa-2 wtu-yilz26-1w"
