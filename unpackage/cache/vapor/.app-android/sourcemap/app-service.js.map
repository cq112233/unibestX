.wtu-1v4d3yt-0 {
  @apply flex;
}
/*! weapp-tailwindcss local-utility */
.wtu-xri2te-1 {
  @apply flex-col;
}
/*! weapp-tailwindcss local-utility */
.wtu-vrv923-2 {
  @apply flex-1;
}
/*! weapp-tailwindcss local-utility */
.wtu-1vpt528-3 {
  @apply h-full;
}
