<style>
.weapp-tw-border {
    border-width: 0
}
</style>
<template>
  <AppKu :custom-page-class="'init-page'" :custom-page-style="'background-color: transparent;'" :layout="'navbar'" :show-back="false" :hide-status-bar="false" :hide-navbar="false" :enable-pull-down-refresh="true" :page-style="{'navigationBarTitleText':'tabbar.home','navigationStyle':'custom','mp-alipay':{'transparentTitle':'always','titlePenetrate':'YES','defaultTitle':''}}">

  <LayoutComponent :custom-page-class="'init-page'" :custom-page-style="'background-color: transparent;'" :name="'index'" :show-back="false" :hide-status-bar="false" :hide-navbar="false" :enable-pull-down-refresh="true" :page-style="{'navigationBarTitleText':'tabbar.home','navigationStyle':'custom','mp-alipay':{'transparentTitle':'always','titlePenetrate':'YES','defaultTitle':''}}">

  <view class="weapp-tw-border wtu-1v4d3yt-0 wtu-xri2te-1" :class="[{ 'wtu-vrv923-2': isSinglePageTabbar, 'wtu-1vpt528-3': isSinglePageTabbar }]">
    <!-- 模式 4：单页面 TabBar 容器模式 (零闪烁、0ms 秒切、Tab 状态常驻保活) -->
    <template v-if="isSinglePageTabbar">
      <!-- 自动挂载各 Tab 视图容器（由插件配合 config.uts 自动生成） -->
      <TabViews />

      <!-- 底部常驻 TabBar (同页渲染免路由跳转) -->
      <Tabbar />
    </template>

    <!-- 模式 0-3：独立页面模式 -->
    <HomeView v-else />
  </view>

  </LayoutComponent>

  </AppKu>
</template>

<script setup lang="uts">
import AppKu from '@/App.ku.uvue'
import LayoutComponent from '@/src/layouts/navbar/navbar.uvue'
import HomeView from './views/IndexView.uvue';
import TabViews from '@/src/tabbar/components/TabViews.uvue';
import Tabbar from '@/src/tabbar/tabbar.uvue';
import { isSinglePageTabbar, notifyPageHide, notifyPageShow, setCurIdxByKey } from '@/src/tabbar/index.uts';
import { handleBackPressExit } from '@/src/utils/backPress/index.uts';
;

// 把页面 onShow / onHide 桥接给 TabBar：onTabPageShow 靠它覆盖「从子页面返回 / 前台恢复」
onShow(() => {








  if (!isSinglePageTabbar) {
    setCurIdxByKey('index');
  }
  notifyPageShow();
});

onHide(() => {
  notifyPageHide();
});

onBackPress((options: OnBackPressOptions): boolean => {

  if (options.from == 'backbutton') {
    return handleBackPressExit();
  }

  return false;
});
</script>

<style lang="scss" scoped>
