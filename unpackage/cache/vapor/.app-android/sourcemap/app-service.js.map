<template>
  <AppKu :layout="'navbar'" :show-back="true" :hide-navbar="false" :enable-pull-down-refresh="false" :page-style="{'navigationBarTitleText':'z-paging-x 原生分页','navigationStyle':'custom','mp-alipay':{'transparentTitle':'always','titlePenetrate':'YES','defaultTitle':''}}">

  <LayoutComponent :show-back="true" :hide-navbar="false" :enable-pull-down-refresh="false" :page-style="{'navigationBarTitleText':'z-paging-x 原生分页','navigationStyle':'custom','mp-alipay':{'transparentTitle':'always','titlePenetrate':'YES','defaultTitle':''}}">

  <view class="weapp-tw-border wtu-p3r1pn-0 wtu-x0r3nc-1 wtu-1o5z4jd-2 wtu-18yh8lj-3">
    <!-- 核心分页滚动场景 -->
    <view class="weapp-tw-border wtu-1o5z4jd-2 wtu-p3r1pn-0 wtu-x0r3nc-1 wtu-ux259g-4">
