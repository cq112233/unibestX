<template>
  <view class="weapp-tw-border wtu-esa9zh-0 wtu-gfyl56-1 wtu-1n30lgw-2 wtu-1s07fk0-3 wtu-ccxw59-4">
    <!-- 头部卡片：用户头像及状态 -->
    <view class="weapp-tw-border wtu-e5npdz-5 wtu-rj2i5-6 wtu-mahxoz-7 wtu-6281tb-8 wtu-1kfu0be-9 wtu-1wmhax9-a wtu-esa9zh-0 wtu-gfyl56-1 wtu-1n30lgw-2">
      <image class="wtu-1qu75na-b wtu-12drxbd-c wtu-1lmscgu-d wtu-xo7msx-e wtu-38fcjc-f wtu-1f3n9gf-g wtu-1gywhw2-h" :src="avatarUrl" />
      <text class="weapp-tw-border wtu-1ipvsyr-i wtu-agh7s5-j wtu-p2o8ej-k wtu-fw6osu-l">
        {{ userStore.state.userInfo.username.length > 0 ? userStore.state.userInfo.username : '未登录用户' }}
      </text>
      <text v-if="userStore.state.userInfo.username.length > 0" class="weapp-tw-border wtu-1b88y6w-m wtu-1wii8sc-n wtu-1wyff53-o">
        {{ userStore.state.userInfo.nickname }}
      </text>
      <view class="weapp-tw-border wtu-esa9zh-0 wtu-1dq6yp0-p">
        <text
          class="weapp-tw-border wtu-148q6bp-q wtu-1keauv8-r wtu-1avups1-s wtu-14ztp7o-t wtu-19a7g9d-u wtu-qfn3l3-v"
          :class="tokenStore.hasValidLogin() ? 'wtu-giefxt-w wtu-miyra4-x' : 'wtu-2511oa-y wtu-1wii8sc-n'"
        >
          {{ tokenStore.hasValidLogin() ? '已登录' : '未登录' }}
        </text>
      </view>
    </view>

    <!-- 信息区域：序列化数据展示 -->
    <view class="weapp-tw-border wtu-e5npdz-5 wtu-rj2i5-6 wtu-mahxoz-7 wtu-18enp7g-z wtu-1wmhax9-a wtu-esa9zh-0 wtu-gfyl56-1">
      <view class="weapp-tw-border wtu-19rfo9z-10 wtu-esa9zh-0 wtu-1dq6yp0-p">
        <text class="weapp-tw-border wtu-14koajj-11 wtu-12cth1z-12 wtu-18od990-13">用户信息 (JSON)</text>
      </view>
      <view class="weapp-tw-border wtu-fxtog-14 wtu-2511oa-y wtu-1wyff53-o" />
      <scroll-view class="wtu-147mpuw-15 wtu-1jmod9o-16 wtu-17y9wva-17 wtu-1ue7am9-18" direction="vertical">
        <text class="weapp-tw-border wtu-148q6bp-q wtu-mp1vgs-19 wtu-dxq2eg-1a" style="font-family: monospace;">{{ userInfoJson }}</text>
      </scroll-view>
    </view>

    <!-- 按钮区域 -->
    <view class="weapp-tw-border wtu-e5npdz-5 wtu-14r24p1-1b wtu-esa9zh-0 wtu-gfyl56-1">
      <view v-if="tokenStore.hasValidLogin()" class="weapp-tw-border wtu-e5npdz-5 wtu-9sjbdd-1c wtu-1jmod9o-16 wtu-1mehle8-1d wtu-esa9zh-0 wtu-1dq6yp0-p wtu-1n30lgw-2 wtu-nvl58k-1e" @click="handleLogout">
        <text class="weapp-tw-border wtu-1cwfuix-1f wtu-14koajj-11 wtu-agh7s5-j">退出登录</text>
      </view>
      <view v-else class="weapp-tw-border wtu-e5npdz-5 wtu-9sjbdd-1c wtu-1jmod9o-16 wtu-4uhl2w-1g wtu-esa9zh-0 wtu-1dq6yp0-p wtu-1n30lgw-2 wtu-nvl58k-1e" @click="handleLogin">
        <text class="weapp-tw-border wtu-1cwfuix-1f wtu-14koajj-11 wtu-agh7s5-j">登录</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed } from 'vue';
import { useTokenStore, useUserStore } from '@/src/store/index.uts';
import { LOGIN_PAGE } from '@/src/router/config/config.uts';
import { curIdx, onTabPageShow, onTabShow, resolveTabIndexByKey, switchTabbar } from '@/src/tabbar/index.uts';
import { onNavbarPullDownRefresh, stopNavbarPullDownRefresh } from '@/src/layouts/navbar/utils/index.uts';

// 页面数据加载/刷新方法
function refreshData(): void {
  uni.__log__('log','at src/pages/me/views/MeView.uvue:59','我的页面刷新中...');
  setTimeout(() => {
    // 门控检查：若刷新完成时用户已切到其他 Tab 则忽略
    if (curIdx.value != resolveTabIndexByKey('me')) {
      return;
    }
    uni.__log__('log','at src/pages/me/views/MeView.uvue:65','我的页面刷新成功');
    // 数据加载完毕后，手动停止下拉刷新动画状态
    stopNavbarPullDownRefresh();
  }, 1000);
}

// 监听 navbar 自定义下拉刷新事件（在 enablePullDownRefresh: true 且处于当前 Tab 时生效）
onNavbarPullDownRefresh(() => {
  if (curIdx.value == resolveTabIndexByKey('me')) {
    refreshData();
  }
});

const userStore = useUserStore();
const tokenStore = useTokenStore();

/** 本视图所属的「我的」页面路由：退出登录后固定回到此页（该页无需登录，未登录态自身渲染） */
const ME_PAGE_PATH: string = '/src/pages/me/me';

// 计算头像
const avatarUrl = computed((): string => {
  if (userStore.state.userInfo.avatar.length > 0) {
    return userStore.state.userInfo.avatar;
  }
  return '/static/logo.png';
});

// 序列化用户信息为 JSON
const userInfoJson = computed((): string => {
  const info = {
    userId: userStore.state.userInfo.userId,
    username: userStore.state.userInfo.username,
    nickname: userStore.state.userInfo.nickname,
    avatar: userStore.state.userInfo.avatar
  };
  return JSON.stringify(info, null, 2);
});

// 登录
function handleLogin() {
  uni.navigateTo({
    url: LOGIN_PAGE
  });
}

// 退出登录
function handleLogout() {
  uni.showModal({
    title: '提示',
    content: '确定要退出登录吗？',
    cancelText: '取消',
    confirmText: '确定',
    success: (res) => {
      if (res.confirm) {
        tokenStore.clearToken();
        userStore.clearUserInfo();
        uni.showToast({
          title: '退出登录成功',
          icon: 'success'
        });
        // 退出后留在「我的」页面（me 页无需登录，未登录态自身渲染）
        // 统一走 switchTabbar 回到本页：mode 4 只切激活索引不跳路由，mode 0-3 按各自策略 switchTab / redirectTo
        setTimeout(() => {
          switchTabbar(ME_PAGE_PATH);
        }, 0);
      }
    }
  });
}

// 监听 Tab 切换到当前功能页（config.uts 中 type: 'me'）时触发
onTabShow('me', () => {
  uni.__log__('log','at src/pages/me/views/MeView.uvue:137','onTabShow 我 Tab 显示');
}, true);

// 监听我 Tab 页面显示（切 Tab、从子页面返回、前台恢复都会触发）
onTabPageShow('me', () => {
  uni.__log__('log','at src/pages/me/views/MeView.uvue:142','onTabPageShow 我 Tab 显示');
}, true);

onMounted(() => {
  uni.__log__('log','at src/pages/me/views/MeView.uvue:146','我 Tab 挂载了');
});

onUnmounted(() => {
  uni.__log__('log','at src/pages/me/views/MeView.uvue:150','我 Tab 卸载了');
});
</script>

