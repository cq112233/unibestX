            <text class="weapp-tw-border wtu-19x42cr-i wtu-1ew9un3-g wtu-e1x0th-16">取消</text>
          </view>
        </view>
      </view>

      <!-- 4. useZIndex：统一分配弹层层级，避免各处手写魔数 -->
      <view class="weapp-tw-border wtu-vfmic1-7 wtu-1mmmp4d-8 wtu-19vjnt3-9 wtu-1umrqkk-a wtu-zy2638-b wtu-z4caei-c wtu-1vgr90u-d wtu-jv9a8j-e">
        <view class="weapp-tw-border wtu-1rtuuez-0 wtu-1etbbm6-m wtu-k262q-2 wtu-u5ggt9-n">
          <view class="weapp-tw-border wtu-5kmhbe-o wtu-rs1s6e-p wtu-10m4vms-q wtu-8v8wl8-r wtu-alpbw-1p" />
          <text class="weapp-tw-border wtu-uu43uh-t wtu-1ew9un3-g wtu-j6pg7t-h">4. useZIndex 层级分配</text>
        </view>
        <text class="weapp-tw-border wtu-19x42cr-i wtu-122jvku-j wtu-1me3hhe-k">每个弹层打开时 increase() 抬升一档、关闭时 decrease() 回落，zIndex 变量可直接绑定到弹层的 :style 上。</text>
        <view class="weapp-tw-border wtu-1rtuuez-0 wtu-1etbbm6-m wtu-k262q-2 wtu-1dr7tgd-1e wtu-1w5pax5-1c">
          <text class="weapp-tw-border wtu-sgk0na-x wtu-1ew9un3-g wtu-12kfloo-1q" style="font-family: monospace;">z-index = {{ zIndex }}</text>
          <view class="weapp-tw-border wtu-1rtuuez-0 wtu-1etbbm6-m wtu-k262q-2">
            <view class="weapp-tw-border wtu-1lfrreu-1r wtu-g6taf8-1s wtu-1rtuuez-0 wtu-1etbbm6-m wtu-k262q-2 wtu-5k8j6u-12 wtu-49b82y-13 wtu-1mhfvnb-15 wtu-8v8wl8-r" @click="onDecreaseZIndex">
