<script setup lang="uts">
import AppKu from '@/App.ku.uvue'
import LayoutComponent from '@/src/layouts/navbar/navbar.uvue'
import { onMounted, onUnmounted, ref } from 'vue';
import { onNavbarPullDownRefresh, stopNavbarPullDownRefresh } from '@/src/layouts/navbar/utils/index.uts';
;

// ==================== 1. 通信与分享 ====================
const phoneNumber = ref<string>('10086');
const shareSummary = ref<string>('unibestX - 高性能跨端原生开发框架');
const shareHref = ref<string>('https://github.com/cq112233/unibestX');

function handleMakePhoneCall(): void {
  if (phoneNumber.value == '') {
    uni.showToast({ title: '请输入电话号码', icon: 'none' });
    return;
  }
  uni.makePhoneCall({
    phoneNumber: phoneNumber.value,
    success: () => {
      uni.__log__('log','at src/sub/deviceFunctionDemo/deviceFunctionDemo.uvue:373','拨号成功');
    },
    fail: () => {
      uni.showToast({ title: '已取消或拨号失败', icon: 'none' });
    }
  });
}

function handleShareWithSystem(): void {
  // shareWithSystem 是 App 专有 API，小程序端为 x（且小程序不允许 API 调起分享，
  // 只能由用户点 <button open-type="share"> 触发）—— 这里不能带上 MP-WEIXIN，
  // 否则小程序产物会编译进一个不存在的 API 并在点击时报 TypeError。

  uni.shareWithSystem({
    summary: shareSummary.value,
    href: shareHref.value,
    success: () => {
      uni.showToast({ title: '分享调用成功', icon: 'success' });
    },
    fail: () => {
      uni.showToast({ title: '已取消或分享失败', icon: 'none' });
    }
  });









}

// ==================== 2. 文件与文档 ====================
const selectedFileName = ref<string>('');
const selectedFileSizeText = ref<string>('');
const selectedFilePath = ref<string>('');

function formatFileSize(bytes: number): string {
  if (bytes <= 0) {
    return '0 B';
  }
  if (bytes < 1024) {
    return `${bytes} B`;
  }
  if (bytes < 1024 * 1024) {
    const kb = (bytes / 1024.0).toFixed(1);
    return `${kb} KB`;
  }
  const mb = (bytes / (1024.0 * 1024.0)).toFixed(1);
  return `${mb} MB`;
}

type LocalChosenFile = {
  name?: string;
  size?: number;
  path?: string;
};

function handleChooseFile(): void {

  try {
    uni.chooseFile({
      count: 1,
      type: 'all',
      success: (res) => {
        const rawFiles = res.tempFiles as any;
        const fileList = (Array.isArray(rawFiles) ? rawFiles : [rawFiles]) as Array<LocalChosenFile>;
        if (fileList.length > 0 && fileList[0] != null) {
          const fileObj = fileList[0];
          const fileName = `${fileObj.name ?? ''}`;
          selectedFileName.value = fileName.length > 0 ? fileName : '已选文件';
          selectedFileSizeText.value = formatFileSize((fileObj.size ?? 0) as number);
          selectedFilePath.value = `${fileObj.path ?? ''}`;
          uni.showToast({ title: '文件选择成功', icon: 'success' });
        }
        else {
          const rawPaths = res.tempFilePaths as any;
          const pathList = (Array.isArray(rawPaths) ? rawPaths : [rawPaths]) as Array<string>;
          if (pathList.length > 0 && pathList[0] != null && pathList[0].length > 0) {
            selectedFilePath.value = pathList[0];
            selectedFileName.value = '已选文件';
            uni.showToast({ title: '文件选择成功', icon: 'success' });
          }
        }
      },
      fail: () => {
        uni.showToast({ title: '已取消选择文件', icon: 'none' });
      }
    });
  }
  catch (_e: any) {
    uni.__log__('error','at src/sub/deviceFunctionDemo/deviceFunctionDemo.uvue:466',_e);
    uni.showToast({ title: '当前环境不支持选文件', icon: 'none' });
  }

}

function handleOpenSelectedDoc(): void {
  if (selectedFilePath.value == '') {
    uni.showToast({ title: '请先选择文档文件', icon: 'none' });
    return;
  }
  uni.openDocument({
    filePath: selectedFilePath.value,
    success: () => {
      uni.__log__('log','at src/sub/deviceFunctionDemo/deviceFunctionDemo.uvue:480','文档打开成功');
    },
    fail: () => {
      uni.showToast({ title: '文档预览失败，请检查文件格式', icon: 'none' });
    }
  });
}

function handleDownloadAndOpenSampleDoc(): void {
  uni.showLoading({ title: '下载示例文档中...' });
  uni.downloadFile({
    url: 'https://raw.githubusercontent.com/mozilla/pdf.js/master/examples/learning/helloworld.pdf',
    success: (res) => {
      uni.hideLoading();
      if (res.statusCode == 200 && res.tempFilePath != '') {
        uni.openDocument({
          filePath: res.tempFilePath,
          fileType: 'pdf',
          success: () => {
            uni.showToast({ title: '文档已打开', icon: 'success' });
          },
          fail: () => {
            uni.showToast({ title: '系统暂无法打开该格式文档', icon: 'none' });
          }
        });
      }
      else {
        uni.showToast({ title: '文档下载失败', icon: 'none' });
      }
    },
    fail: () => {
      uni.hideLoading();
      uni.showToast({ title: '下载示例文档超时或失败', icon: 'none' });
    }
  });
}

// ==================== 3. 系统缓存管理 (getFileSystemManager) ====================
const fileCacheBytes = ref<number>(0);
const storageCacheBytes = ref<number>(0);
const cacheFileCount = ref<number>(0);
const cacheDirPath = ref<string>('');

const fileCacheSizeText = computed((): string => formatFileSize(fileCacheBytes.value));
const storageSizeText = computed((): string => formatFileSize(storageCacheBytes.value));
const totalCacheSizeText = computed((): string => formatFileSize(fileCacheBytes.value + storageCacheBytes.value));

function getCachePath(): string {
  try {
    const uniEnv = uni.env;
    if (uniEnv != null) {
      const p = `${uniEnv.CACHE_PATH ?? ''}`;
      if (p.length > 0) {
        return p;
      }
    }
  }
  catch (e) {
    uni.__log__('warn','at src/sub/deviceFunctionDemo/deviceFunctionDemo.uvue:538',e);
  }
  try {
    const uniEnv = uni.env;
    if (uniEnv != null) {
      const u = `${uniEnv.USER_DATA_PATH ?? ''}`;
      if (u.length > 0) {
        return u;
      }
    }
  }
  catch (e) {
    uni.__log__('warn','at src/sub/deviceFunctionDemo/deviceFunctionDemo.uvue:550',e);
  }
  return '';
}

function calculateCacheSize(showToast: boolean): void {
  // 1. 读取 Storage 大小 (KB 转 Byte)
  try {
    uni.getStorageInfo({
      success: (res) => {
        storageCacheBytes.value = res.currentSize * 1024;
      },
      fail: () => {
        storageCacheBytes.value = 0;
      }
    });
  }
  catch (e) {
    uni.__log__('warn','at src/sub/deviceFunctionDemo/deviceFunctionDemo.uvue:568',e);
  }

  // 2. 使用 FileSystemManager 统计 CACHE_PATH
  let totalBytes = 0;
  const path = getCachePath();
  cacheDirPath.value = path.length > 0 ? path : '系统临时沙盒';

  if (path.length == 0) {
    fileCacheBytes.value = 0;
    cacheFileCount.value = 0;
    if (showToast) {
      uni.showToast({ title: '已刷新缓存信息', icon: 'none' });
    }
    return;
  }

  try {
    const fsm = uni.getFileSystemManager();
    fsm.readdir({
      dirPath: path,
      success: (res: ReadDirSuccessResult) => {
        const files = res.files;
        cacheFileCount.value = files.length;

        if (files.length == 0) {
          fileCacheBytes.value = 0;
          if (showToast) {
            uni.showToast({ title: '当前文件缓存为 0 B', icon: 'none' });
          }
          return;
        }

        let pending = files.length;
        for (let i = 0; i < files.length; i++) {
          const fileName = files[i];
          const fullPath = `${path}/${fileName}`;
          fsm.getFileInfo({
            filePath: fullPath,
            success: (info: GetFileInfoSuccessResult) => {
              totalBytes += info.size;
              pending--;
              if (pending <= 0) {
                fileCacheBytes.value = totalBytes;
                if (showToast) {
                  uni.showToast({ title: `缓存统计完成: ${totalCacheSizeText.value}`, icon: 'none' });
                }
              }
            },
            fail: () => {
              pending--;
              if (pending <= 0) {
                fileCacheBytes.value = totalBytes;
                if (showToast) {
                  uni.showToast({ title: `缓存统计完成: ${totalCacheSizeText.value}`, icon: 'none' });
                }
              }
            }
          } as GetFileInfoOptions);
        }
      },
      fail: (err) => {
        uni.__log__('warn','at src/sub/deviceFunctionDemo/deviceFunctionDemo.uvue:630','readdir fail:', err);
        fileCacheBytes.value = 0;
        cacheFileCount.value = 0;
        if (showToast) {
          uni.showToast({ title: '已刷新缓存信息', icon: 'none' });
        }
      }
    } as ReadDirOptions);
  }
  catch (e) {
    uni.__log__('error','at src/sub/deviceFunctionDemo/deviceFunctionDemo.uvue:640','getFileSystemManager error:', e);
    fileCacheBytes.value = 0;
    cacheFileCount.value = 0;
  }
}

function handleClearFileCache(): void {
  if (fileCacheBytes.value == 0) {
    uni.showModal({
      title: '文件缓存已为 0 B',
      content: `当前文件缓存目录已无临时文件。\n\n上方显示的 ${storageSizeText.value} 是本地 Storage 存储数据（如登录Token、Pinia状态、主题与字体偏好）。若需彻底清空，请点击【清空 Storage】或【一键清空全部】。`,
      showCancel: false,
      confirmText: '我知道了'
    });
    return;
  }

  uni.showModal({
    title: '清除文件缓存',
    content: `确认清理 ${cacheFileCount.value} 个文件缓存 (${fileCacheSizeText.value}) 吗？此操作将清空临时与下载文件。`,
    confirmText: '立即清理',
    cancelText: '取消',
    confirmColor: '#f97316',
    success: (modalRes) => {
      if (!modalRes.confirm) {
        return;
      }

      uni.showLoading({ title: '正在清理文件缓存...' });

      const path = getCachePath();
      if (path.length == 0) {
        uni.hideLoading();
        fileCacheBytes.value = 0;
        cacheFileCount.value = 0;
        uni.showToast({ title: '文件缓存已清空', icon: 'success' });
        return;
      }

      try {
        const fsm = uni.getFileSystemManager();
        fsm.readdir({
          dirPath: path,
          success: (res: ReadDirSuccessResult) => {
            const files = res.files;
            if (files.length == 0) {
              uni.hideLoading();
              fileCacheBytes.value = 0;
              cacheFileCount.value = 0;
              uni.showToast({ title: '文件缓存已清空', icon: 'success' });
              return;
            }

            let remaining = files.length;
            const onFileDone = () => {
              remaining--;
              if (remaining <= 0) {
                uni.hideLoading();
                fileCacheBytes.value = 0;
                cacheFileCount.value = 0;
                calculateCacheSize(false);
                uni.showToast({ title: '文件缓存已彻底清空', icon: 'success' });
              }
            };

            for (let i = 0; i < files.length; i++) {
              const fileName = files[i];
              if (fileName.startsWith('DCloud') || fileName.startsWith('uni')) {
                onFileDone();
                continue;
              }

              const fullPath = `${path}/${fileName}`;
              fsm.unlink({
                filePath: fullPath,
                success: () => {
                  onFileDone();
                },
                fail: () => {
                  fsm.rmdir({
                    dirPath: fullPath,
                    recursive: true,
                    complete: () => {
                      onFileDone();
                    }
                  } as RmDirOptions);
                }
              } as UnLinkOptions);
            }
          },
          fail: () => {
            uni.hideLoading();
            fileCacheBytes.value = 0;
            cacheFileCount.value = 0;
            uni.showToast({ title: '文件缓存清理完成', icon: 'success' });
          }
        } as ReadDirOptions);
      }
      catch (e) {
        uni.hideLoading();
        uni.__log__('error','at src/sub/deviceFunctionDemo/deviceFunctionDemo.uvue:740','clear file cache error:', e);
        uni.showToast({ title: '清理完成', icon: 'none' });
      }
    }
  });
}

function handleClearAll(): void {
  uni.showModal({
    title: '一键清空全部缓存与数据',
    content: `将同时清理文件缓存 (${fileCacheSizeText.value}) 和本地 Storage 键值对 (${storageSizeText.value})。\n\n清空后应用状态将被重置为初始状态，确定执行吗？`,
    confirmText: '彻底清空',
    cancelText: '取消',
    confirmColor: '#ef4444',
    success: (modalRes) => {
      if (!modalRes.confirm) {
        return;
      }

      uni.showLoading({ title: '正在清理全部数据...' });
      try {
        uni.clearStorageSync();
        storageCacheBytes.value = 0;
      }
      catch (e) {
        uni.__log__('warn','at src/sub/deviceFunctionDemo/deviceFunctionDemo.uvue:765',e);
      }

      const path = getCachePath();
      if (path.length == 0) {
        uni.hideLoading();
        fileCacheBytes.value = 0;
        cacheFileCount.value = 0;
        calculateCacheSize(false);
        uni.showToast({ title: '全部缓存与数据已清空', icon: 'success' });
        return;
      }

      try {
        const fsm = uni.getFileSystemManager();
        fsm.readdir({
          dirPath: path,
          success: (res: ReadDirSuccessResult) => {
            const files = res.files;
            if (files.length == 0) {
              uni.hideLoading();
              fileCacheBytes.value = 0;
              cacheFileCount.value = 0;
              calculateCacheSize(false);
              uni.showToast({ title: '全部缓存与数据已清空', icon: 'success' });
              return;
            }

            let remaining = files.length;
            const onAllDone = () => {
              remaining--;
              if (remaining <= 0) {
                uni.hideLoading();
                fileCacheBytes.value = 0;
                cacheFileCount.value = 0;
                calculateCacheSize(false);
                uni.showToast({ title: '全部缓存与数据已清空', icon: 'success' });
              }
            };

            for (let i = 0; i < files.length; i++) {
              const fileName = files[i];
              if (fileName.startsWith('DCloud') || fileName.startsWith('uni')) {
                onAllDone();
                continue;
              }

              const fullPath = `${path}/${fileName}`;
              fsm.unlink({
                filePath: fullPath,
                success: () => {
                  onAllDone();
                },
                fail: () => {
                  fsm.rmdir({
                    dirPath: fullPath,
                    recursive: true,
                    complete: () => {
                      onAllDone();
                    }
                  } as RmDirOptions);
                }
              } as UnLinkOptions);
            }
          },
          fail: () => {
            uni.hideLoading();
            fileCacheBytes.value = 0;
            cacheFileCount.value = 0;
            calculateCacheSize(false);
            uni.showToast({ title: '清理完成', icon: 'success' });
          }
        } as ReadDirOptions);
      }
      catch (e) {
        uni.hideLoading();
        uni.__log__('warn','at src/sub/deviceFunctionDemo/deviceFunctionDemo.uvue:841',e);
        calculateCacheSize(false);
        uni.showToast({ title: '清理完成', icon: 'none' });
      }
    }
  });
}

function handleClearStorage(): void {
  uni.showModal({
    title: '清空本地 Storage',
    content: `当前 Storage 占用 ${storageSizeText.value}。清空将重置所有本地持久化键值（包括字体记忆与登录偏好），确定清空吗？`,
    confirmText: '立即清空',
    cancelText: '取消',
    confirmColor: '#f97316',
    success: (modalRes) => {
      if (!modalRes.confirm) {
        return;
      }
      try {
        uni.clearStorageSync();
        storageCacheBytes.value = 0;
        calculateCacheSize(false);
        uni.showToast({ title: 'Storage 缓存已全部清空', icon: 'success' });
      }
      catch (e) {
        uni.__log__('warn','at src/sub/deviceFunctionDemo/deviceFunctionDemo.uvue:867',e);
        uni.showToast({ title: '清空失败', icon: 'none' });
      }
    }
  });
}

function handleGenerateTestCache(): void {
  const path = getCachePath();
  if (path.length == 0) {
    uni.showToast({ title: '当前环境无可用缓存路径', icon: 'none' });
    return;
  }

  uni.showLoading({ title: '正在写入测试缓存...' });
  try {
    const fsm = uni.getFileSystemManager();
    const testFileName = `test_cache_${Date.now()}.tmp`;
    const targetFile = `${path}/${testFileName}`;

    let dummy = 'unibestX_Cache_TestData_0123456789ABCDEF\n';
    for (let i = 0; i < 10; i++) {
      dummy = dummy + dummy;
    }

    fsm.writeFile({
      filePath: targetFile,
      data: dummy,
      encoding: 'utf-8',
      success: () => {
        uni.hideLoading();
        uni.showToast({ title: '已成功生成测试缓存', icon: 'success' });
        calculateCacheSize(false);
      },
      fail: (err) => {
        uni.hideLoading();
        uni.__log__('warn','at src/sub/deviceFunctionDemo/deviceFunctionDemo.uvue:903','writeFile fail:', err);
        uni.showToast({ title: '写入测试缓存失败', icon: 'none' });
      }
    } as WriteFileOptions);
  }
  catch (e) {
    uni.hideLoading();
    uni.__log__('warn','at src/sub/deviceFunctionDemo/deviceFunctionDemo.uvue:910',e);
    uni.showToast({ title: '写入异常', icon: 'none' });
  }
}

// ==================== 4. 键盘感知与避让 ====================
const keyboardInputText = ref<string>('');
const keyboardHeight = ref<number>(0);
let keyboardChangeCallback: ((res: OnKeyboardHeightChangeCallbackResult) => void) | null = null;
let keyboardListenerId: number = -1;

function handleKeyboardHeightChange(event: UniInputKeyboardHeightChangeEvent): void {
  keyboardHeight.value = Math.ceil(event.detail.height);
}

function handleHideKeyboard(): void {
  uni.hideKeyboard();
}

onMounted(() => {









  calculateCacheSize(false);
});

onUnmounted(() => {










});

// ==================== 4. 触感与震动 ====================
const copyText = ref<string>('Hello unibestX!');

function triggerShortVibration(): void {

  uni.vibrateShort({
    type: 'light',
    success: () => {
      uni.showToast({ title: '已触发短震动反馈', icon: 'none' });
    },
    fail: () => {
      uni.showToast({ title: '短震动触发失败', icon: 'none' });
    }
  });







}

function triggerLongVibration(): void {

  uni.vibrateLong({
    success: () => {
      uni.showToast({ title: '已触发长震动反馈', icon: 'none' });
    },
    fail: () => {
      uni.showToast({ title: '长震动触发失败', icon: 'none' });
    }
  });







}

function handleCopy(): void {
  if (copyText.value == '')
    return;
  uni.setClipboardData({
    data: copyText.value,
    success: () => {
      uni.showToast({
        title: '复制成功',
        icon: 'success'
      });
    }
  });
}

// ==================== 5. 相机与多媒体 ====================
const photoUrl = ref<string>('');
const scanResult = ref<string>('');

function chooseImage(): void {
  uni.chooseImage({
    count: 1,
    success: (res) => {
      const paths = res.tempFilePaths;
      if (paths.length > 0) {
        photoUrl.value = paths[0];
      }
    },
    fail: (err) => {
      uni.__log__('error','at src/sub/deviceFunctionDemo/deviceFunctionDemo.uvue:1025',err);
    }
  });
}

function scanCode(): void {
  uni.scanCode({
    success: (res) => {
      scanResult.value = res.result;
    },
    fail: (err) => {
      uni.__log__('error','at src/sub/deviceFunctionDemo/deviceFunctionDemo.uvue:1036',err);
    }
  });
}

onNavbarPullDownRefresh(() => {
  setTimeout(() => {
    stopNavbarPullDownRefresh();
  }, 800);
});
</script>

