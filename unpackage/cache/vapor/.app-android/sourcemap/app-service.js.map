          <text class="weapp-tw-border wtu-1czdygq-o wtu-95nag4-j wtu-otx4hk-q wtu-qdftam-r" :style="{ fontFamily: 'monospace' }">watchThemeChange(() => themeStore.refreshIsDark());</text>
