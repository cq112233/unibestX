.weapp-tw-border {
    border-width: 0
}
</style>
<template>
  <AppKu :layout="'navbar'" :show-back="true" :hide-navbar="false" :enable-pull-down-refresh="false" :page-style="{'navigationBarTitleText':'登录','navigationStyle':'custom','mp-alipay':{'transparentTitle':'always','titlePenetrate':'YES','defaultTitle':''}}">

  <LayoutComponent :show-back="true" :hide-navbar="false" :enable-pull-down-refresh="false" :page-style="{'navigationBarTitleText':'登录','navigationStyle':'custom','mp-alipay':{'transparentTitle':'always','titlePenetrate':'YES','defaultTitle':''}}">

  <view class="weapp-tw-border wtu-13j0im2-0 wtu-19oilw5-1 wtu-qbp9q5-2 wtu-1002bwd-3">
    <view class="weapp-tw-border wtu-1igkamy-4">
      <text class="weapp-tw-border wtu-1ulponl-5 wtu-18o3ym2-6 wtu-1vpzs7q-7">登录页</text>
    </view>
    <view
      class="weapp-tw-border wtu-1wfx4t9-8 wtu-1fz3gdo-9 wtu-1a1uxzb-a wtu-sen905-b wtu-p97ihk-c wtu-1gc7znh-d wtu-qbp9q5-2 wtu-1002bwd-3"
      @click="doLogin"
    >
      <text class="weapp-tw-border wtu-jpv6rc-e wtu-138ffsc-f wtu-18o3ym2-6">点击模拟登录</text>
    </view>
  </view>

  </LayoutComponent>

  </AppKu>
</template>

<script setup lang="uts">
import AppKu from '@/App.ku.uvue'
import LayoutComponent from '@/src/layouts/navbar/navbar.uvue'
/* eslint-disable dot-notation */
import { ref } from 'vue';
import type { IDoubleTokenRes, IUserInfo } from '@/src/store/index.uts';
import { useTokenStore, useUserStore } from '@/src/store/index.uts';
import { isPageTabbar, switchTabbar } from '@/src/tabbar/index.uts';
import { login } from '@/src/api/auth/auth.uts';
import type { LoginQuery, LoginResult } from '@/src/api/auth/auth.uts';

const tokenStore = useTokenStore();
const userStore = useUserStore();
const redirectUrl = ref<string>('');
;

onLoad((options: UTSJSONObject | null) => {
  if (options != null) {
    const redirect = options['redirect'] as string | null;
    if (redirect != null) {
      redirectUrl.value = redirect;
    }
  }
});

function doLogin() {
  if (tokenStore.hasValidLogin()) {
    if (redirectUrl.value != '') {
      const targetUrl = decodeURIComponent(redirectUrl.value) ?? '';
      if (isPageTabbar(targetUrl)) {
        switchTabbar(targetUrl);
      }
      else {
        uni.redirectTo({ url: targetUrl });
      }
    }
    else {
      uni.navigateBack();
    }
    return;
  }
  login({
    username: 'UNIX',
    password: 'admin'
  } as LoginQuery).then((res: LoginResult) => {
    tokenStore.setDoubleToken({
      accessToken: res.token,
      accessExpiresIn: res.expiresIn,
      refreshToken: res.refreshToken,
      refreshExpiresIn: res.refreshExpiresIn
    } as IDoubleTokenRes);
    userStore.setUserInfo({
      userId: res.userInfo.userId,
      username: res.userInfo.username,
      nickname: res.userInfo.nickname,
      avatar: res.userInfo.avatar
    } as IUserInfo);
    uni.showToast({
      title: '登录成功',
      icon: 'success'
    });
    setTimeout(() => {
      if (redirectUrl.value != '') {
        const targetUrl = decodeURIComponent(redirectUrl.value) ?? '';
        if (isPageTabbar(targetUrl)) {
          switchTabbar(targetUrl);
        }
        else {
          uni.redirectTo({ url: targetUrl });
        }
      }
      else {
        uni.navigateBack();
      }
    }, 1000);
  });
}
</script>

