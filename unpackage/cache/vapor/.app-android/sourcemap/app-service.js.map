            >
              {{ item.title }}
            </text>
            <text class="weapp-tw-border wtu-1ynu22j-1m wtu-8v3pbi-2b wtu-3s9xle-2c wtu-qgrsws-2d">
              {{ item.summary }}
            </text>
            <view class="weapp-tw-border wtu-p3r1pn-0 wtu-nq2i7y-d wtu-q7k9xu-e wtu-1dl9v2l-f wtu-dbcapt-1a wtu-1krvpu1-1b wtu-178oatg-9 wtu-c4bo0l-2e">
              <text class="weapp-tw-border wtu-1f9gfug-w wtu-pbzpim-21">z-paging-x 触底自动追加</text>
              <text class="weapp-tw-border wtu-1f9gfug-w wtu-1l895rj-i wtu-9kd7sr-1n">序号 #{{ item.id }} ➜</text>
            </view>
          </view>
        </list-item>

        <!-- 自定义底部加载状态：完全对齐 nested-scroll 演示逻辑与视觉 -->
        <template #loadMore>
          <!-- 1. 自定义正在加载中插槽演示 -->
          <view
            v-if="isLoadMoreLoading"
            class="weapp-tw-border wtu-13zoqyv-23 wtu-1jj94ku-2f wtu-sdq8i8-25 wtu-103otcx-26 wtu-1bodrp0-8 wtu-aw8h0s-2g wtu-p3r1pn-0 wtu-nq2i7y-d wtu-q7k9xu-e wtu-efmgja-16 wtu-179jfne-a wtu-akfxta-2h wtu-1inphpg-2i"
          >
            <text class="weapp-tw-border wtu-1qljp1l-u wtu-10wwopq-v">⚡</text>
            <text
              class="weapp-tw-border wtu-1ynu22j-1m wtu-1rfuwtp-2j wtu-9kd7sr-1n"
            >
              自定义加载中：z-paging-x 正在流式计算数据...
            </text>
          </view>

          <!-- 2. 自定义加载报错与重试插槽演示 -->
          <view
            v-else-if="isLoadMoreError"
            class="weapp-tw-border wtu-13zoqyv-23 wtu-lsyd6t-s wtu-uxl69u-2k wtu-103otcx-26 wtu-1bodrp0-8 wtu-178oatg-9 wtu-p3r1pn-0 wtu-nq2i7y-d wtu-q7k9xu-e wtu-1dl9v2l-f wtu-179jfne-a wtu-1fa6npg-2l wtu-kd7xw9-2m"
          >
            <view class="weapp-tw-border wtu-p3r1pn-0 wtu-nq2i7y-d wtu-q7k9xu-e wtu-1o5z4jd-2 wtu-14sw859-2n">
              <text class="weapp-tw-border wtu-15862od-2o wtu-11urcek-1l">🚨</text>
              <view class="weapp-tw-border wtu-p3r1pn-0 wtu-x0r3nc-1">
                <text class="weapp-tw-border wtu-1ynu22j-1m wtu-1l895rj-i wtu-lmmgqo-z">自定义报错：服务连接暂时中断</text>
                <text class="weapp-tw-border wtu-189xnz9-k wtu-1ussj02-2p wtu-x3aiu4-2q">请检查网络环境或轻触右侧按钮重新拉取</text>
              </view>
            </view>
            <view
              class="weapp-tw-border wtu-1hwkusy-1o wtu-1lyahyy-2r wtu-1tykl4g-14 wtu-36toas-2s wtu-q7k9xu-e wtu-efmgja-16"
              @click="onRetryLoad"
            >
              <text class="weapp-tw-border wtu-1f9gfug-w wtu-1l895rj-i wtu-ailyyz-1u" style="color: #ffffff;">立即重试</text>
            </view>
          </view>

          <!-- 3. 自定义没有更多数据插槽演示 -->
          <view
            v-else-if="isLoadMoreFinished"
            class="weapp-tw-border wtu-1aw9fvl-1i wtu-t9p3ep-2t wtu-p3r1pn-0 wtu-nq2i7y-d wtu-q7k9xu-e wtu-efmgja-16"
          >
            <view class="weapp-tw-border wtu-1b65m7f-2u wtu-1jhrs62-2v wtu-xfjwe3-2w" />
            <view class="weapp-tw-border wtu-mctuoz-2x wtu-p3r1pn-0 wtu-nq2i7y-d wtu-q7k9xu-e">
              <text class="weapp-tw-border wtu-1ynu22j-1m wtu-1gons0g-13">🎉</text>
              <text
                class="weapp-tw-border wtu-1ynu22j-1m wtu-1fyx163-x wtu-pbzpim-21"
              >
                已展示完全部数据内容
              </text>
            </view>
            <view class="weapp-tw-border wtu-1b65m7f-2u wtu-1jhrs62-2v wtu-xfjwe3-2w" />
          </view>
        </template>
      </z-paging-x>
    </view>
  </view>

  </LayoutComponent>

  </AppKu>
</template>

<script setup lang="uts">
import AppKu from '@/App.ku.uvue'
import LayoutComponent from '@/src/layouts/navbar/navbar.uvue'
import { computed, ref } from 'vue';
import type { ComponentPublicInstance } from 'vue';
;

// 数据模型定义（遵循规范：严格使用 type，禁止 interface）
type ArticleItem = {
  id: number;
  title: string;
  summary: string;
  category: string;
  categoryBg: string;
  categoryColor: string;
  time: string;
};

const pagingRef = ref<ComponentPublicInstance | null>(null);
const articleList = ref<ArticleItem[]>([]);
const isSimEmpty = ref<boolean>(false);
const customBottom = ref<number>(120);
const windowWidth = ref<number>(uni.getWindowInfo().windowWidth);

// 回顶样式：解除原生 76rpx (38px) 宽高的死限制，允许胶囊自然伸展并支持动态响应 bottom
const backToTopStyle = computed((): UTSJSONObject => {
  return {
    width: 'auto',
    height: 'auto',
    bottom: `${customBottom.value}px`,
    right: '20px'
  } as UTSJSONObject;
});

// 状态机核心控制变量（完全对齐 nested-scroll：1=首批不足一屏, 2=自动调接口补齐中, 3=铺满待触底报错, 4=报错重试中, 5=全部加载完成）
const simStep = ref<number>(1);
const simStatusText = ref<string>('【第 1 步】首次加载 2 条数据（未超出底部），800ms后将自动调接口补齐...');
const isLoadMoreLoading = ref<boolean>(false);
const isLoadMoreError = ref<boolean>(false);
const isLoadMoreFinished = ref<boolean>(false);

// 下拉刷新状态跟踪
const refresherStatus = ref<string>('default');

const refresherIcon = computed((): string => {
  if (refresherStatus.value == 'release-to-refresh') {
    return '🚀';
  }
  if (refresherStatus.value == 'loading') {
    return '⏳';
  }
  if (refresherStatus.value == 'complete') {
    return '✅';
  }
  return '⚓';
});

const refresherStatusText = computed((): string => {
  if (refresherStatus.value == 'release-to-refresh') {
    return '松开手指立即开始极速刷新...';
  }
  if (refresherStatus.value == 'loading') {
    return '自定义下拉中：数据正在极速吞吐...';
  }
  if (refresherStatus.value == 'complete') {
    return '刷新成功，数据已更新！';
  }
  return '松开手指立即触发自定义刷新';
});

function onRefresherStatusChange(status: string): void {
  refresherStatus.value = status;
  if (status == 'loading' && isSimEmpty.value) {
    isSimEmpty.value = false;
  }
}

function onUpdateList(val: any[]): void {
  articleList.value = val as ArticleItem[];
}

// 辅助函数：生成标准文章数据项
function generateArticlesData(start: number, count: number, stageName: string): ArticleItem[] {
  const list: ArticleItem[] = [];
  const categories = ['原生渲染', '性能调优', '工程化', 'UTS深度解析'];
  const bgs = ['#e0e7ff', '#fef3c7', '#dcfce7', '#f3e8ff'];
  const colors = ['#4338ca', '#d97706', '#16a34a', '#7e22ce'];

  for (let i = start; i < start + count; i++) {
    const cIdx = i % 4;
    list.push({
      id: i,
      title: `uni-app X 极速体验与架构实践 #${i}（${stageName}）`,
      summary: `流式数据单元 #${i}，手势平滑通透，支持超高刷流畅滑动，无缝流式分页。`,
      category: categories[cIdx],
      categoryBg: bgs[cIdx],
      categoryColor: colors[cIdx],
      time: '刚刚'
    } as ArticleItem);
  }
  return list;
}

// 第 2 步：自动调用接口补齐数据（超出底部一屏）
function autoLoadFillScreen(): void {
  simStep.value = 2;
  isLoadMoreLoading.value = true;
  simStatusText.value = '【第 2 步】检测到数据未超出底部，正在自动调用接口追加数据...';

  setTimeout(() => {
    // 追加 6 条数据，累计达到 8 条（总高度逾 1000px，页面已铺满并超出底部）
    const nextData = generateArticlesData(3, 6, '自动补齐数据');
    isLoadMoreLoading.value = false;
    simStep.value = 3;
    simStatusText.value = '【第 2 步完成】数据已超出屏幕！请向上滑动触底，第3次加载将模拟报错(500)';

    // 调用 z-paging-x completeByNoMore 追加这 6 条数据，告知仍有更多数据
    pagingRef.value?.$callMethod('completeByNoMore', nextData as any[], false);
  }, 1000);
}

// 启动完整生命周期演示
function startFullSimulation(): void {
  isSimEmpty.value = false;
  isLoadMoreError.value = false;
  isLoadMoreFinished.value = false;
  isLoadMoreLoading.value = false;
  simStep.value = 1;
  simStatusText.value = '【第 1 步】首批返回 2 条数据（未超出底部），正在启动自动补齐...';

  // 首批生成 2 条数据并送给 z-paging-x
  const initialData = generateArticlesData(1, 2, '首批数据');
  pagingRef.value?.$callMethod('completeByNoMore', initialData as any[], false);

  // 400ms 后自动触发第 2 步展示 loading UI 补齐超出底部
  setTimeout(() => {
    if (simStep.value == 1) {
      autoLoadFillScreen();
    }
  }, 400);
}

// 错误点击「立即重试」处理
function onRetryLoad(): void {
  if (isLoadMoreLoading.value) {
    return;
  }
  isLoadMoreError.value = false;
  isLoadMoreLoading.value = true;
  simStep.value = 4;
  simStatusText.value = '【第 4 步】已发起重试请求，正在重新拉取接口数据...';

  setTimeout(() => {
    // 成功拉取最后 2 条终态数据
    const finalItems = generateArticlesData(9, 2, '终态数据');
    isLoadMoreLoading.value = false;
    isLoadMoreFinished.value = true;
    simStep.value = 5;
    simStatusText.value = '【全部完成】🎉 重试成功！没有更多数据了（下拉列表可重新再来一遍）';

    // 告知 z-paging-x 没有更多数据了 (nomore = true)
    pagingRef.value?.$callMethod('completeByNoMore', finalItems as any[], true);

    uni.showToast({
      title: '重试成功！数据已全部加载',
      icon: 'success'
    });
  }, 800);
}

// z-paging-x query 事件响应
function onQuery(pageNo: number, _pageSize: number): void {
  // 处于空数据演示状态
  if (isSimEmpty.value) {
    pagingRef.value?.$callMethod('complete', [] as any[]);
    return;
  }

  // 第一页初次拉取或重置
  if (pageNo == 1) {
    startFullSimulation();
    return;
  }

  // 场景 1：如果当前处于错误态，严格禁止手势上拉/触底自动触发重试（必须手动点击「立即重试」按钮）
  if (isLoadMoreError.value) {
    pagingRef.value?.$callMethod('completeByError');
    return;
  }

  // 场景 2：正在加载中或已经加载完成，忽略重复触底触发
  if (isLoadMoreLoading.value || isLoadMoreFinished.value || simStep.value == 4) {
    return;
  }

  // 场景 3：第 3 步触底，模拟 500 接口异常
  if (simStep.value == 3) {
    isLoadMoreLoading.value = true;
    simStatusText.value = '【第 3 步进行中】正在发起第 3 次请求... 模拟网络 500 异常';

    setTimeout(() => {
      isLoadMoreLoading.value = false;
      isLoadMoreError.value = true;
      simStatusText.value = '【第 3 步报错】模拟 500 接口异常！请点击底部「立即重试」再次加载';
      pagingRef.value?.$callMethod('completeByError');
      uni.showToast({
        title: '模拟接口异常：500 Internal Error',
        icon: 'none'
      });
    }, 700);
    return;
  }

  // 兜底完成
  pagingRef.value?.$callMethod('completeByNoMore', [] as any[], true);
}

// 控制操作栏动作函数
function triggerEmpty(): void {
  isSimEmpty.value = true;
  articleList.value = [];
  isLoadMoreError.value = false;
  isLoadMoreFinished.value = true;
  isLoadMoreLoading.value = false;
  simStep.value = 5;
  simStatusText.value = '【已清空数据】触发空列表缺省兜底展示';
  pagingRef.value?.$callMethod('reload');
  uni.showToast({ title: '已清空数据，触发空态兜底', icon: 'none' });
}

function triggerReset(): void {
  isSimEmpty.value = false;
  pagingRef.value?.$callMethod('reload');
  uni.showToast({ title: '已重新开始完整流程模拟', icon: 'success' });
}

function triggerScrollToTop(): void {
  pagingRef.value?.$callMethod('scrollToTop', true);
  uni.showToast({ title: '已平滑滚动返回顶部', icon: 'none' });
}

function toggleBottomPosition(): void {
  if (customBottom.value == 120) {
    customBottom.value = 160;
  }
  else {
    customBottom.value = 120;
  }
  uni.showToast({
    title: `回顶按钮底部边距设为 ${customBottom.value}px`,
    icon: 'none'
  });
}
</script>

