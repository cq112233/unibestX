<style>
.weapp-tw-border {
    border-width: 0
}
</style>
<template>
  <AppKu :layout="'navbar'" :show-back="true" :enable-pull-down-refresh="false" :hide-navbar="false" :hide-status-bar="false" :page-style="{'navigationBarTitleText':'浏览网页','navigationStyle':'custom','mp-alipay':{'transparentTitle':'always','titlePenetrate':'YES','defaultTitle':''}}">

  <LayoutComponent :show-back="true" :enable-pull-down-refresh="false" :hide-navbar="false" :hide-status-bar="false" :page-style="{'navigationBarTitleText':'浏览网页','navigationStyle':'custom','mp-alipay':{'transparentTitle':'always','titlePenetrate':'YES','defaultTitle':''}}">

  <view class="weapp-tw-border wtu-11b9fh7-0 wtu-1we9y20-1 wtu-nphvwp-2">
    <web-view
      class="wtu-nphvwp-2 wtu-1gwcwz5-3 wtu-nscxo6-4"
      style="flex: 1;"
      :src="targetUrl"
      @message="onWebviewMessage"
    />
  </view>

  </LayoutComponent>

  </AppKu>
</template>

<script setup lang="uts">
import AppKu from '@/App.ku.uvue'
import LayoutComponent from '@/src/layouts/navbar/navbar.uvue'
import { ref } from 'vue';
;

const defaultUrl = 'https://github.com/cq112233/unibestX';
const targetUrl = ref<string>(defaultUrl);

onLoad((options: UTSJSONObject | null) => {
  if (options != null) {
    const raw = options.url as string | null;
    if (raw != null && raw != '') {
      const decoded = decodeURIComponent(raw);
      targetUrl.value = decoded != null ? decoded : raw;
    }
    const pageTitle = options.title as string | null;
    if (pageTitle != null && pageTitle != '') {
      uni.setNavigationBarTitle({
        title: pageTitle
      });
    }
  }
});

function onWebviewMessage(event: UniWebViewMessageEvent): void {
  const detail = event.detail;
  const data = detail.data;
  if (data != null && data.length > 0) {
    const lastItem = data[data.length - 1] as UTSJSONObject;
    const msgType = lastItem.type as string | null;
    if (msgType === 'NAVIGATE_BACK') {
      uni.navigateBack();
      return;
    }
    const title = (lastItem.title as string | null) ?? (lastItem.content as string | null) ?? '收到网页消息';
    uni.showToast({
      title,
      icon: 'none'
    });
  }
}
</script>

