<style>
.weapp-tw-border {
    border-width: 0
}
</style>
<!-- [z-paging-x]空数据&加载失败view -->
<template name="z-paging-x-empty">
  <view class="weapp-tw-border" :class="{'zpx-container':true}" :style="[emptyStyle]" @click="emptyClick">
    <view class="weapp-tw-border zpx-main">
      <image v-if="emptyImg.length > 0" class="zpx-main-image" :style="[emptyImgStyle]" :src="emptyImg" />
      <image v-else class="zpx-main-image" mode="aspectFit" :style="[emptyImgStyle]" :src="localEmptyImg" />
      <text class="weapp-tw-border zpx-main-title" :style="[emptyTitleStyle]">{{emptyText}}</text>
      <text v-if="showEmptyReload" class="weapp-tw-border zpx-main-error-btn" :style="[emptyReloadStyle]" @click.stop="reloadClick">{{emptyReloadText}}</text>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { computed } from 'vue'
  import { base64Empty, base64Error } from '../z-paging-x/static/index.uts'

  defineOptions({
    name: 'z-paging-x-empty'
  })

  const props = defineProps({
    // 空数据描述文字
    emptyText: {
      type: String,
      default: '没有数据哦~'
    },
    // 空数据图片
    emptyImg: {
      type: String,
      default: ''
    },
    // 是否显示空数据图重新加载按钮
    showEmptyReload: {
      type: Boolean,
      default: false
    },
    // 空数据点击重新加载文字
    emptyReloadText: {
      type: String,
      default: '重新加载'
    },
    // 是否是加载失败
    isLoadFailed: {
      type: Boolean,
      default: false
    },
    // 空数据图样式
    emptyStyle: {
      type: Object
    },
    // 空数据图img样式
    emptyImgStyle: {
      type: Object
    },
    // 空数据图描述文字样式
    emptyTitleStyle: {
      type: Object
    },
    // 空数据图重新加载按钮样式
    emptyReloadStyle: {
      type: Object
    }
  })

  const emit = defineEmits<{
    (e: 'reload'): void
    (e: 'viewClick'): void
  }>()

  const localEmptyImg = computed((): string => {
    return props.isLoadFailed ? base64Error : base64Empty;
  })

  const reloadClick = () => {
    emit('reload');
  }
  const emptyClick = () => {
    emit('viewClick');
  }
</script>

<style scoped>
  .zpx-container{
    flex: 1;
    align-items: center;
    justify-content: center;
  }

  .zpx-main{
    flex-direction: column;
    align-items: center;
        padding: 25px 0px;
  }

  .zpx-main-image {
    width: 120px;
    height: 120px;
  }

  .zpx-main-title {
    font-size: 14px;
    color: #aaaaaa;
    text-align: center;
    margin-top: 5px;
    padding: 0px 10px;
  }

  .zpx-main-error-btn {
    font-size: 14px;
    padding: 4px 12px;
    border: solid 1px #dddddd;
    border-radius: 3px;
    color: #aaaaaa;
    margin-top: 25px;
  }
</style>
