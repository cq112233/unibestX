<style>
.weapp-tw-border {
    border-width: 0
}
</style>
<template>
  <AppKu :layout="'navbar'" :show-back="false" :enable-pull-down-refresh="true" :hide-status-bar="false" :hide-navbar="false" :page-style="{'navigationBarTitleText':'tabbar.function','navigationStyle':'custom','mp-alipay':{'transparentTitle':'always','titlePenetrate':'YES','defaultTitle':''}}">

  <LayoutComponent :show-back="false" :enable-pull-down-refresh="true" :hide-status-bar="false" :hide-navbar="false" :page-style="{'navigationBarTitleText':'tabbar.function','navigationStyle':'custom','mp-alipay':{'transparentTitle':'always','titlePenetrate':'YES','defaultTitle':''}}">

  <FunctionView />

  </LayoutComponent>

  </AppKu>
</template>

<script setup lang="uts">
import AppKu from '@/App.ku.uvue'
import LayoutComponent from '@/src/layouts/navbar/navbar.uvue'
import FunctionView from './views/FunctionView.uvue';
import { handleBackPressExit } from '@/src/utils/backPress/index.uts';
import { notifyPageHide, notifyPageShow, setCurIdxByKey } from '@/src/tabbar/index.uts';
;

// 独立页面模式下，切到当前功能页时同步当前 Tab 激活索引并通知页面可见
onShow(() => {
  setCurIdxByKey('function');
  notifyPageShow();
});

onHide(() => {
  notifyPageHide();
});

onBackPress((options: OnBackPressOptions): boolean => {

  if (options.from == 'backbutton') {
    return handleBackPressExit();
  }

  return false;
});
</script>

