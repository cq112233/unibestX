  <view class="weapp-tw-border page-root wtu-ef8xmr-0 wtu-yyghql-1 wtu-11pvnwq-2">
    <!-- 消息滚动区 -->
    <scroll-view
      class="wtu-ef8xmr-0 wtu-o744bn-3 wtu-1yjyoev-4"
