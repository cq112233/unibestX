      <view class="weapp-tw-border wtu-vfmic1-7 wtu-1mmmp4d-8 wtu-19vjnt3-9 wtu-1umrqkk-a wtu-zy2638-b wtu-z4caei-c wtu-1vgr90u-d wtu-jv9a8j-e">
        <view class="weapp-tw-border wtu-1rtuuez-0 wtu-1etbbm6-m wtu-k262q-2 wtu-u5ggt9-n">
          <view class="weapp-tw-border wtu-5kmhbe-o wtu-rs1s6e-p wtu-10m4vms-q wtu-8v8wl8-r wtu-pmqviu-1o" />
          <text class="weapp-tw-border wtu-uu43uh-t wtu-1ew9un3-g wtu-j6pg7t-h">3. useTimeout 延时执行</text>
        </view>
        <view class="weapp-tw-border wtu-1rtuuez-0 wtu-1etbbm6-m wtu-k262q-2 wtu-1dr7tgd-1e">
          <text class="weapp-tw-border wtu-19x42cr-i wtu-1me3hhe-k">定时器状态：{{ timeoutPending ? '等待中…' : '空闲' }}</text>
