// 适用编辑器（VSCode 及其二次开发版本）
const ideNameList: Array<string> = ['VSCode', 'Trae', 'Cursor', 'Antigravity'];

const systemInfo = computed<SystemInfoType | null>((): SystemInfoType | null => systemInfoRef.value);

// 复制 create-unibestx 脚手架命令
function copyCliCommand(): void {
  uni.setClipboardData({
    data: 'pnpm create unibestx my-app',
    success: () => {
      uni.showToast({
        title: '已复制 CLI 命令',
        icon: 'success'
      });
    }
  });
}

// 打开 GitHub 官方仓库地址
function openGithub(): void {
  const url = 'https://github.com/cq112233/unibestX';




  uni.navigateTo({
    url: `/src/sub/webview/webview?url=${encodeURIComponent(url)}&title=unibestX`,
    fail: () => {
      uni.setClipboardData({
        data: url,
        success: () => {
          uni.showToast({
            title: '已复制 GitHub 链接',
            icon: 'none'
          });
        }
      });
    }
  });

}

// 页面数据加载/刷新方法
function refreshData(): void {
  uni.__log__('log','at src/pages/index/views/IndexView.uvue:564','首页刷新中...');
  setTimeout(() => {
    // 门控检查：若刷新完成时用户已切到其他 Tab 则忽略
    if (curIdx.value != resolveTabIndexByKey('index')) {
      return;
    }
    uni.__log__('log','at src/pages/index/views/IndexView.uvue:570','首页刷新成功');
    // 数据加载完毕后，手动停止下拉刷新动画状态
    stopNavbarPullDownRefresh();
  }, 1000);
}

// 监听 navbar 自定义下拉刷新事件（在 enablePullDownRefresh: true 且处于当前 Tab 时生效）
onNavbarPullDownRefresh(() => {
  if (curIdx.value == resolveTabIndexByKey('index')) {
    refreshData();
  }
});

// 监听 Tab 切换到当前首页（config.uts 中 type: 'index'）时触发
onTabShow('index', () => {
  uni.__log__('log','at src/pages/index/views/IndexView.uvue:585','onTabShow 首页 Tab 显示');
}, true);

// 监听首页 Tab 页面显示（切 Tab、从子页面返回、前台恢复都会触发）
onTabPageShow('index', () => {
  uni.__log__('log','at src/pages/index/views/IndexView.uvue:590','onTabPageShow 首页 Tab 显示');
}, true);

onMounted(() => {
  uni.__log__('log','at src/pages/index/views/IndexView.uvue:594','首页 Tab 挂载了');
});

onUnmounted(() => {
  uni.__log__('log','at src/pages/index/views/IndexView.uvue:598','首页 Tab 卸载了');
});
</script>

