import { availableHeight } from '@/src/utils/systemInfo/index.uts';
import { resetNavbarTitle, setNavbarTitle } from '@/src/layouts/navbar/utils/index.uts';
;

/**
 * 开发者可写区域高度（框架已按当前布局算好，navbar / default 通用）
