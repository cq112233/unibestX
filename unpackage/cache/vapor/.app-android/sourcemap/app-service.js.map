<script setup lang="uts">
import AppKu from '@/App.ku.uvue'
import LayoutComponent from '@/src/layouts/navbar/navbar.uvue'
import { computed } from 'vue';
import { onNavbarPullDownRefresh, stopNavbarPullDownRefresh } from '@/src/layouts/navbar/utils/index.uts';
import { useRoute } from '@/src/router/index.uts';
;

// 参数统一从 useRoute() 读，不再写 onLoad((options) => {...})：
// 两者都能拿到 query，但 route.query 口径与其它页面一致（Map<string, string>，值已 URL 解码）；
// 而且它是**本页自己的快照** —— 本页重新显示（onPageShow）/ 同名路径落地提交时刷新，
// 别的页面跳转改不到它（见 src/router/hooks/route-state.uts 的「谁读到什么」）。
const route = useRoute();

/** query 键值对展示行 */
type QueryRow = {
  key: string;
  value: string;
};

/** route.query 是 Map，先摊成数组再交给 v-for（Map 直接遍历拿不到稳定的下标渲染） */
const queryRows = computed((): QueryRow[] => {
  const rows: QueryRow[] = [];
  route.query.forEach((value: string, key: string): void => {
    rows.push({ key, value } as QueryRow);
  });
  return rows;
});

const countLabel = computed((): string => {
  return queryRows.value.length > 0 ? '已解析' : '待解析';
});

onNavbarPullDownRefresh(() => {
  setTimeout(() => {
    stopNavbarPullDownRefresh();
  }, 800);
});
</script>

