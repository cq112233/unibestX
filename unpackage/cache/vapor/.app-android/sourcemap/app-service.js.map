<style>
.weapp-tw-border {
    border-width: 0
}
</style>
<script setup lang="uts">
import { onMounted, onUnmounted } from 'vue';
import {
  handleTabbarClick,
  isVersionGte525,
  resetTabSwitchThrottle,
  safeAreaBottom,
  safeHideNativeTabBar,
  safeRestoreNativeTabBar,
  syncCurIdxByCurrentPage,
  TABBAR_CONTAINER_HEIGHT,
  TABBAR_HEIGHT,
  tabbarList,
  tabbarPlaceholderHeight,
  themeTokens
} from '@/src/tabbar/index.uts';
import TabbarItem from './TabbarItem.uvue';

let isMounted = false;

// 首次挂载时同步索引并隐藏原生 TabBar
onMounted(() => {
  isMounted = true;
  syncCurIdxByCurrentPage();
  safeHideNativeTabBar();
});

// 卸载时彻底清理异步资源、还原原生 TabBar 并重置切换节流锁
onUnmounted(() => {
  isMounted = false;
  safeRestoreNativeTabBar();
  resetTabSwitchThrottle();
});

/** 处理 Tab 点击 */
function onTabClick(index: number) {
  if (!isMounted) {
    return;
  }
  handleTabbarClick(index);
}
</script>

<template>
  <!-- 占位块：仅在 5.25 及以上版本 H5 时使用 position: absolute，5.24及以下和App/小程序保持正常文档流占位 -->
  <view
    class="weapp-tw-border tabbar-placeholder"
    :class="{ 'tabbar-placeholder-absolute': isVersionGte525 }"
    :style="{ height: `${tabbarPlaceholderHeight}px` }"
  >
    <view
      class="weapp-tw-border tabbar-container"
      :style="{ height: `${TABBAR_CONTAINER_HEIGHT + safeAreaBottom}px` }"
    >
      <!-- 【整体底板】覆盖「固定高度 + 安全区」的全部区域 -->
      <view
        class="weapp-tw-border tabbar-bg"
        :style="{ height: `${TABBAR_HEIGHT + safeAreaBottom}px`, backgroundColor: themeTokens.tabBg, borderTopColor: themeTokens.tabBorder }"
      ></view>

      <!-- 【固定高度】tab 图标按钮区 -->
      <view class="weapp-tw-border tabbar-inner">
        <view
          v-for="(item, index) in tabbarList"
          :key="item.pagePath.length > 0 ? item.pagePath : `${item.text}_${index}`"
          class="weapp-tw-border tabbar-item"
          :style="{ height: `${item.isBulge ? TABBAR_CONTAINER_HEIGHT : TABBAR_HEIGHT}px` }"
          @click="onTabClick(index)"
        >
          <TabbarItem :item="item" :index="index" :is-bulge="item.isBulge" />
        </view>
      </view>

      <!-- 【安全区】底部安全区填充块 -->
      <view class="weapp-tw-border safe-area-bg" :style="{ height: `${safeAreaBottom}px`, backgroundColor: themeTokens.tabBg }" />
    </view>
  </view>
</template>

<style>
.tabbar-placeholder {
  /* 高度通过 :style 动态绑定，占据正常文档流防止遮挡页面内容 */
  width: 100%;
}

/* 仅在 5.25 及以上版本 H5 时脱离文档流 */
.tabbar-placeholder-absolute {



}

/* 固定在底部的容器，内部级联展示三个层 */
.tabbar-container {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
  flex-direction: column;
  background-color: transparent;
}

/* 【底板层】覆盖「固定高度 + 安全区」的底板，绑定高度动态设定 */
.tabbar-bg {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
  border-top-width: 1rpx;
  border-top-style: solid;
}

/* 【固定高度层】tab 图标按钮区，与底板同高；鼓包由 TabbarItem 内绝对定位向上突出 */
.tabbar-inner {
  z-index: 2;
  flex-direction: row;
  align-items: flex-end;
  height: 80px;
}

/* 单个 tab 项：flex 平分宽度；高度通过 :style 动态绑定（普通项 TABBAR_HEIGHT / 鼓包项 TABBAR_CONTAINER_HEIGHT） */
.tabbar-item {
  justify-content: center;
  align-items: center;
  flex: 1;
}

/* 【安全区层】底部安全区填充，高度动态设定 */
.safe-area-bg {
  z-index: 1;
}
</style>
