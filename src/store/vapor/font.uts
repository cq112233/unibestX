import { reactive } from 'vue';
import { defineStore } from 'pinia';
import {
  DEFAULT_FONT_FAMILY,
  DEFAULT_FONT_ID,
  DEFAULT_FONT_SCALE,
  getFontOption,
  normalizeFontScale
} from '@/src/config/font/font.uts';

/**
 * 字体状态（类型镜像自唯一真源 `../types.uts`）
 *
 * ⚠️ 为什么不 `import type` 那个 `.uts`：见 `src/types/uts-shim.d.ts` 说明（会报 TS2709）。
 */
type IFontState = {
  fontId: string;
  fontFamily: string;
  fontScale: number;
  status: string;
};

/**
 * 全局字体 Store（Vapor 分支：官方 Pinia）
 *
 * 负责字体选择、远程字体注册、字号缩放与持久化；具体文本渲染由 AppText 读取 state 完成。
 */
export const useFontStore = defineStore('font', () => {
  const state = reactive<IFontState>({
    fontId: DEFAULT_FONT_ID,
    fontFamily: DEFAULT_FONT_FAMILY,
    fontScale: DEFAULT_FONT_SCALE,
    status: 'idle'
  });

  let _fontInited = false;
  // 字体切换存在异步下载，用序号丢弃过期的加载结果，避免旧字体的回调覆盖新选择
  let _loadSeq = 0;

  /**
   * 注册远程字体
   * @param family uni.loadFontFace 使用的字体名称
   * @param source 字体文件地址
   * @returns 注册成功返回 true；失败返回 false，由调用方保留系统兜底
   */
  function loadRemoteFont(family: string, source: string): Promise<boolean> {
    return new Promise<boolean>((resolve) => {
      uni.loadFontFace({
        global: true,
        family,
        source,
        success: () => {
          resolve(true);
        },
        fail: (_err: any) => {
          resolve(false);
        }
      });
    });
  }

  /**
   * 切换全局字体
   * @param fontId 字体 id，对应 src/config/font/font.uts 的 fontOptions
   * @returns 切换完成返回 true；id 不存在或远程字体加载失败返回 false
   */
  function setFont(fontId: string): Promise<boolean> {
    const option = getFontOption(fontId);
    if (option == null) {
      return Promise.resolve(false);
    }

    const previousFontId = state.fontId;
    const previousFontFamily = state.fontFamily;
    const currentSeq = _loadSeq + 1;
    _loadSeq = currentSeq;
    state.fontId = option.id;

    if (option.source == '') {
      state.fontFamily = option.family;
      state.status = option.id == DEFAULT_FONT_ID ? 'idle' : 'loaded';
      return Promise.resolve(true);
    }
    if (option.loadFamily == '') {
      state.fontId = previousFontId;
      state.fontFamily = previousFontFamily;
      state.status = 'error';
      return Promise.resolve(false);
    }

    state.status = 'loading';
    return loadRemoteFont(option.loadFamily, option.source).then((ok: boolean): boolean => {
      if (currentSeq == _loadSeq) {
        if (ok) {
          // 注册成功后再切 font-family，确保 AppText 重算并真正用上远程字体
          state.fontFamily = option.family;
          state.status = 'loaded';
        }
        else {
          state.fontId = previousFontId;
          state.fontFamily = previousFontFamily;
          state.status = 'error';
        }
      }
      return ok;
    }, (_err: any): boolean => {
      if (currentSeq == _loadSeq) {
        state.fontId = previousFontId;
        state.fontFamily = previousFontFamily;
        state.status = 'error';
      }
      return false;
    });
  }

  /**
   * 设置全局字号缩放比例
   * @param scale 缩放比例，内部会限制到安全区间
   */
  function setFontScale(scale: number): void {
    state.fontScale = normalizeFontScale(scale);
  }

  /**
   * 应用启动时恢复字体：持久化状态已由 Pinia 插件还原，这里负责重新注册远程字体。
   */
  function initFont(): void {
    if (_fontInited) {
      return;
    }
    _fontInited = true;

    const option = getFontOption(state.fontId);
    if (option == null) {
      state.fontId = DEFAULT_FONT_ID;
      state.fontFamily = DEFAULT_FONT_FAMILY;
      state.status = 'idle';
      return;
    }

    state.fontScale = normalizeFontScale(state.fontScale);
    if (option.source == '') {
      state.fontFamily = option.family;
      state.status = option.id == DEFAULT_FONT_ID ? 'idle' : 'loaded';
      return;
    }
    if (option.loadFamily == '') {
      state.fontFamily = DEFAULT_FONT_FAMILY;
      state.status = 'error';
      return;
    }

    // 远程字体注册完成前先使用系统兜底，避免启动首屏使用未注册字体
    state.fontFamily = DEFAULT_FONT_FAMILY;
    const currentSeq = _loadSeq + 1;
    _loadSeq = currentSeq;
    state.status = 'loading';
    loadRemoteFont(option.loadFamily, option.source).then((ok: boolean): void => {
      if (currentSeq == _loadSeq) {
        if (ok) {
          state.fontFamily = option.family;
          state.status = 'loaded';
        }
        else {
          state.status = 'error';
        }
      }
    }, (_err: any): void => {
      if (currentSeq == _loadSeq) {
        state.status = 'error';
      }
    });
  }

  /** 恢复系统默认字体与默认字号 */
  function resetFont(): void {
    _loadSeq = _loadSeq + 1;
    state.fontId = DEFAULT_FONT_ID;
    state.fontFamily = DEFAULT_FONT_FAMILY;
    state.fontScale = DEFAULT_FONT_SCALE;
    state.status = 'idle';
  }

  return {
    state,
    initFont,
    setFont,
    setFontScale,
    resetFont
  };
}, {
  persist: true
});
