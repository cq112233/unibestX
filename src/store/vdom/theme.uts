import { defineStore, PiniaStoreBase } from '@/uni_modules/x-pinia-s';
import {
  applyThemeColor,
  applyThemeMode,
  getDefaultTheme,
  getDefaultThemeMode,
  getSystemTheme,
  isDarkMode,
  themeColor
} from '@/src/theme/index.uts';
import type { IThemeState } from '../types.uts';

const defaultMode = getDefaultThemeMode();

const defaultThemeState: IThemeState = {
  theme: getDefaultTheme(),
  themeMode: defaultMode,
  isDark: isDarkMode(defaultMode)
};

function getStoredThemeState(): UTSJSONObject | null {
  try {
    const raw = uni.getStorageSync('pinia:theme');
    if (raw != null && typeof raw == 'string' && (raw as string) != '') {
      const parsed = JSON.parseObject(raw as string);
      if (parsed != null) {
        return (parsed.state != null ? parsed.state : parsed) as UTSJSONObject;
      }
    }
  }
  catch {
    // ignore
  }
  return null;
}

/**
 * 主题与外观管理 Store（支持主题色换肤、浅色/暗黑模式及跟随系统）
 */
export class ThemeStore extends PiniaStoreBase {
  state: IThemeState = reactive<IThemeState>({
    theme: getDefaultTheme(),
    themeMode: defaultMode,
    isDark: isDarkMode(defaultMode)
  });

  _themeModeInited: boolean = false;

  constructor() {
    super();
    this.bindState(this.state);
    const stored = getStoredThemeState();
    if (stored != null) {
      if (stored.theme != null) {
        const themeVal = stored.theme as string;
        if (themeVal.length > 0) {
          this.state.theme = themeVal;
        }
      }
      if (stored.themeMode != null) {
        const modeVal = stored.themeMode as string;
        if (modeVal == 'auto' || modeVal == 'light' || modeVal == 'dark') {
          this.state.themeMode = modeVal;
        }
      }
      else if (stored.isDark != null) {
        this.state.themeMode = (stored.isDark as boolean) ? 'dark' : 'light';
      }
      if (stored.isDark != null) {
        this.state.isDark = stored.isDark as boolean;
      }
      else {
        this.refreshIsDark();
      }
    }
    themeColor.value = this.state.theme;
    applyThemeColor(this.state.theme);
    applyThemeMode(this.state.themeMode, this.state.isDark);
  }

  /**
   * 重置主题状态为环境默认配置
   */
  override _doReset(): void {
    this.state.theme = defaultThemeState.theme;
    this.state.themeMode = defaultThemeState.themeMode;
    this.state.isDark = defaultThemeState.isDark;
    themeColor.value = defaultThemeState.theme;
    applyThemeColor(defaultThemeState.theme);
    applyThemeMode(defaultThemeState.themeMode, defaultThemeState.isDark);
  }

  /**
   * 从本地缓存数据中反序列化还原主题与外观配置
   */
  override _hydrate(data: UTSJSONObject): void {
    const _data = (data.state != null ? data.state : data) as UTSJSONObject;
    if (_data.theme != null) {
      const colorVal = _data.theme as string;
      this.state.theme = colorVal;
      themeColor.value = colorVal;
      applyThemeColor(colorVal);
    }
    if (_data.themeMode != null) {
      const modeVal = _data.themeMode as string;
      if (modeVal == 'auto' || modeVal == 'light' || modeVal == 'dark') {
        this.state.themeMode = modeVal;
      }
      else {
        this.state.themeMode = defaultMode;
      }
    }
    else if (_data.isDark != null) {
      this.state.themeMode = (_data.isDark as boolean) ? 'dark' : 'light';
    }
    this.refreshIsDark();
  }

  /**
   * 序列化主题状态用于持久化存储
   */
  override _serialize(): UTSJSONObject {
    return {
      theme: this.state.theme,
      themeMode: this.state.themeMode,
      isDark: this.state.isDark
    } as UTSJSONObject;
  }

  /**
   * 切换品牌主题色（如海蓝色、翡翠绿、紫罗兰等），同步更新全局 CSS 变量与响应式引用
   * @param theme 目标主题色名（如 'theme-blue'）
   */
  setTheme(theme: string): void {
    this.state.theme = theme;
    themeColor.value = theme;
    applyThemeColor(theme);
    this.$patch({ theme } as UTSJSONObject);
    try {
      uni.setStorageSync('pinia:theme', JSON.stringify(this._serialize()));
    }
    catch {
      // ignore
    }
  }

  /**
   * 初始化外观模式监听器，监听操作系统、应用或宿主环境的深浅色变化事件并自动同步
   */
  initThemeMode(): void {
    if (!this._themeModeInited) {
      this._themeModeInited = true;
      // #ifdef APP
      uni.onAppThemeChange((res: AppThemeChangeResult) => {
        if (this.state.themeMode != 'auto') {
          this.state.isDark = res.appTheme == 'dark';
        }
      });
      uni.onOsThemeChange((res: OsThemeChangeResult) => {
        if (this.state.themeMode == 'auto') {
          this.state.isDark = res.osTheme == 'dark';
        }
      });
      // #endif
      // #ifdef H5
      const darkMql = window.matchMedia('(prefers-color-scheme: dark)');
      darkMql.addEventListener('change', () => {
        if (this.state.themeMode == 'auto') {
          this.refreshIsDark();
        }
      });
      // #endif
      // #ifdef MP-WEIXIN
      uni.onHostThemeChange((_res: OnHostThemeChangeCallbackResult) => {
        if (this.state.themeMode == 'auto') {
          this.refreshIsDark();
        }
      });
      // #endif
    }
    // #ifdef APP
    uni.setAppTheme({ theme: this.state.themeMode as 'light' | 'dark' | 'auto' });
    // #endif
    this.refreshIsDark();
  }

  /**
   * 切换外观显示模式，支持跟随系统、强制浅色或强制暗黑
   * @param mode 外观模式：'auto'（跟随系统）| 'light'（浅色）| 'dark'（暗黑）
   */
  setThemeMode(mode: string): void {
    this.state.themeMode = mode;
    // #ifdef APP
    uni.setAppTheme({ theme: mode as 'light' | 'dark' | 'auto' });
    // #endif
    this.refreshIsDark();
    this.$patch({ themeMode: mode, isDark: this.state.isDark } as UTSJSONObject);
    try {
      uni.setStorageSync('pinia:theme', JSON.stringify(this._serialize()));
    }
    catch {
      // ignore
    }
  }

  /**
   * 重新计算并应用深浅色状态（在外观模式切换或系统深色模式发生变化时调用）
   */
  refreshIsDark(): void {
    const mode = this.state.themeMode;
    if (mode == 'light') {
      this.state.isDark = false;
    }
    else if (mode == 'dark') {
      this.state.isDark = true;
    }
    else {
      this.state.isDark = getSystemTheme() == 'dark';
    }
    applyThemeMode(mode, this.state.isDark);
  }
}

export const useThemeStore = defineStore<ThemeStore>('theme', (): ThemeStore => new ThemeStore());
