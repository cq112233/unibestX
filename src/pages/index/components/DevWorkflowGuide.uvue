            <span class="text-[10px] text-[#c4b5fd] mb-[2px]" style="font-family: monospace;">
              VITE_DEV_SANDBOX=true
            </span>
            <span class="text-[10px] text-[#c4b5fd]" style="font-family: monospace;">
