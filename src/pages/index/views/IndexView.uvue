  },
  {
    id: 'lime-use',
    title: '🧩 lime-use',
    tag: '组合式函数',
    desc: '基于 Vue3 组合式 API 的常用逻辑封装，内置倒计时、验证码计时、精准定时器与层级管理，可直接在业务页面中复用，无需重复造轮子。',
    chips: ['useCountDown', 'useCodeTimer', 'useTimeout', 'useZIndex'],
    configPath: 'uni_modules/lime-use',
    bgColor: '#b453090f',
    borderColor: '#b4530926',
    textColor: '#b45309'
  },
  {
    id: 'lime-color',
    title: '🎨 lime-color',
    tag: '颜色工具',
    desc: '颜色格式互转、亮度与饱和度调整、配色方案生成与 Ant Design 主题色阶，可直接用于换肤、主题推导与图表配色等场景。',
    chips: ['格式互转', '亮度调整', '配色方案', 'Ant 色阶'],
    configPath: 'uni_modules/lime-color',
    bgColor: '#db27770f',
    borderColor: '#db277726',
    textColor: '#db2777'
  },
  {
    id: 'lime-dayuts',
    title: '📅 lime-dayuts',
    tag: '日期时间库',
    desc: 'dayjs 的 UTS 移植版，几乎保持一致的调用风格，覆盖日期解析、格式化与取值赋值、加减与起止（startOf / endOf）、时间差计算与比较查询，并内置中英双语 locale。',
    chips: ['解析/格式化', '加减与起止', 'diff 时间差', '比较查询', '中英 locale'],
    configPath: 'uni_modules/lime-dayuts',
    bgColor: '#4338ca0f',
    borderColor: '#4338ca26',
    textColor: '#4338ca'
  },
  {
    id: 'unix-Bignumber',
    title: '🧮 unix-Bignumber',
    tag: '大数据运算',
    desc: '任意精度十进制运算库，覆盖加减乘除、取模、幂与开方，支持 2~36 进制、九种舍入模式与千分位格式化，彻底解决 0.1 + 0.2 ≠ 0.3 的浮点误差。',
    chips: ['任意精度', '四则运算', '幂与开方', '2~36 进制', '九种舍入', '千分位'],
    configPath: 'uni_modules/unix-Bignumber',
    bgColor: '#7c3aed0f',
    borderColor: '#7c3aed26',
    textColor: '#7c3aed'
  },
  {
    id: 'unix-crypto',
    title: '🔐 unix-crypto',
    tag: '加密解密',
    desc: '跨端加密解密套件，涵盖 Base64 编解码、MD5 与 SHA-256 摘要、HMAC 签名、AES / DES 对称加解密、RSA 非对称加解密与验签，以及 UUID 生成。',
    chips: ['Base64', 'MD5 / SHA-256', 'HMAC', 'AES / DES', 'RSA 验签', 'UUID'],
    configPath: 'uni_modules/unix-crypto',
    bgColor: '#15803d0f',
    borderColor: '#15803d26',
    textColor: '#15803d'
  }
];

const systemInfo = computed<SystemInfoType | null>((): SystemInfoType | null => systemInfoRef.value);

// 复制 create-unibestx 脚手架命令
function copyCliCommand(): void {
  uni.setClipboardData({
    data: 'pnpm create unibestx my-app',
    success: () => {
      uni.showToast({
        title: '已复制 CLI 命令',
        icon: 'success'
      });
    }
  });
}

// 打开 GitHub 官方仓库地址
function openGithub(): void {
  const url = 'https://github.com/cq112233/unibestX';
  // #ifdef WEB
  window.open(url, '_blank');
  // #endif
  // #ifndef WEB
  uni.navigateTo({
    url: `/src/sub/webview/webview?url=${encodeURIComponent(url)}&title=unibestX`,
    fail: () => {
      uni.setClipboardData({
        data: url,
        success: () => {
          uni.showToast({
            title: '已复制 GitHub 链接',
            icon: 'none'
          });
        }
      });
    }
  });
  // #endif
}

// 页面数据加载/刷新方法
function refreshData(): void {
  console.log('首页刷新中...');
  setTimeout(() => {
    // 门控检查：若刷新完成时用户已切到其他 Tab 则忽略
    if (curIdx.value != resolveTabIndexByKey('index')) {
      return;
    }
    console.log('首页刷新成功');
    // 数据加载完毕后，手动停止下拉刷新动画状态
    stopNavbarPullDownRefresh();
  }, 1000);
}

// 监听 navbar 自定义下拉刷新事件（在 enablePullDownRefresh: true 且处于当前 Tab 时生效）
onNavbarPullDownRefresh(() => {
  if (curIdx.value == resolveTabIndexByKey('index')) {
    refreshData();
  }
});

// 监听 Tab 切换到当前首页（config.uts 中 type: 'index'）时触发
onTabShow('index', () => {
  console.log('onTabShow 首页 Tab 显示');
}, true);

// 监听首页 Tab 页面显示（切 Tab、从子页面返回、前台恢复都会触发）
onTabPageShow('index', () => {
  console.log('onTabPageShow 首页 Tab 显示');
}, true);

onMounted(() => {
  console.log('首页 Tab 挂载了');
});

onUnmounted(() => {
  console.log('首页 Tab 卸载了');
});
</script>

<style scoped>
.content-container {
  width: 100%;
}
</style>
