    </text>

    <!-- 运行环境状态卡片 -->
    <view
      class="mx-[16px] mt-[14px] px-[6px] py-[10px] rounded-[12px] border-[1px] border-solid border-[#e2e8f0] bg-[#ffffff] flex flex-row items-center justify-between"
    >
      <view class="flex-1 items-center justify-center">
        <text class="text-[10px] text-[#94a3b8] mb-[2px]">编译平台</text>
        <text class="text-[12px] font-bold text-[#4f46e5]">{{ systemInfo?.platformName ?? '' }}</text>
