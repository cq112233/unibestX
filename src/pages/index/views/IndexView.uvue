// 复制 create-unibestx 脚手架命令
function copyCliCommand(): void {
  uni.setClipboardData({
    data: 'pnpm create unibestx my-app',
    success: () => {
      uni.showToast({
        title: '已复制 CLI 命令',
        icon: 'success'
      });
    }
  });
}

// 复制 openapi 客户端生成命令
function copyApiGenCommand(): void {
  uni.setClipboardData({
    data: 'pnpm api:gen',
    success: () => {
      uni.showToast({
        title: '已复制 api:gen 命令',
        icon: 'success'
      });
    }
  });
}

