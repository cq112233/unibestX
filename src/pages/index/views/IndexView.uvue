    borderColor: '#14b8a626',
    textColor: '#0f766e'
  }
];

type ToolLibItem = {
  id: string;
  title: string;
  tag: string;
  desc: string;
  chips: Array<string>;
  configPath: string;
  bgColor: string;
  borderColor: string;
  textColor: string;
};

const toolLibList: Array<ToolLibItem> = [
