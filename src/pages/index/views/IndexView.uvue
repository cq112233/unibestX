    id: 'lime-shared',
    title: '🧰 lime-shared',
    tag: '工具函数库',
    desc: '零依赖的纯函数集合，覆盖浮点精度运算、序列生成与编号补齐、唯一标识、数组去重与切片分组、对象路径安全取值、命名转换、深比较，以及防抖与随机数。',
    chips: ['浮点精度', '去重切片', '路径取值', '深比较', '防抖'],
    configPath: 'uni_modules/lime-shared',
