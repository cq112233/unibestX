<script setup lang="uts">
import {
  curIdx,
  resolveTabIndexByKey,
  useTabPage,
  useTabPageShell
} from '@/src/tabbar/index.uts';
import { onNavbarPullDownRefresh, stopNavbarPullDownRefresh } from '@/src/layouts/navbar/utils/index.uts';

import TabPageHost from '@/src/tabbar/components/TabPageHost.uvue';
import IndexHeader from './components/IndexHeader.uvue';
import AiSkillSection from './components/AiSkillSection.uvue';
import IdeSection from './components/IdeSection.uvue';
import FeatureGrid from './components/FeatureGrid.uvue';
import EngineeringSection from './components/EngineeringSection.uvue';
import ToolLibSection from './components/ToolLibSection.uvue';
import DevWorkflowGuide from './components/DevWorkflowGuide.uvue';
import IndexFooter from './components/IndexFooter.uvue';
import { router } from '@/src/router/index.uts';

// 👇 这段基本可以满足随意搭配，满足基本的业务需求啦！
// 💡 tabbar模式4的情况下,映射关系
// / ----> /src/pages/index/index
// /?tab=basic&a=1 ----> /src/pages/basic/basic?a=1
// 🔔 可以使用统一tabbar路径，router统一调用，这样切换模式页不会影响业务
// router.push({
//   path: '/src/pages/index/index',
//   query: {
//     a: '1'
//   }
// });
definePage((options) => {
  const { platform, appName: _appName } = options;
  const { isH5, isAppIOS, isAppAndroid, isAppHarmony, isMpAlipay, isMpWeixin } = platform;
  return {
    // --- 1. 页面标识与基础路由 ---
    name: 'index', // 路由名：useRoute().name 优先读取此值，未显式声明时默认读取路径最后一个单词（如 index）
    type: 'home', // 页面类型标识（仅首页配置 'home'，标记当前页面为应用全局启动首页，自动排在 pages.json 第 1 位）
    needLogin: false, // 登录拦截标记：配置为 true 时，路由守卫拦截未登录访问并重定向至登录页,⚠️ 要重启

    // --- 2. 本地沙盒独立调试 ---
    debug: false, // 是否开启当前页面沙盒独立调试（设为 true 可单独编译此页；⚠️ 调试完成后改回 false）
    debugHome: false, // 沙盒调试模式下是否将当前页面指定为启动首页（全局仅允许 1 个页面设为 true，排在 pages[0]）

    // --- 3. 布局与容器外观 ---
    layout: 'navbar', // 页面通用布局模板（'navbar' | 'default' | 'empty' | false | string）
    customPageClass: 'init-page', // 页面根容器自定义类名（配合 layout 布局使用，支持配置全局样式类）
    customPageStyle: 'background-color: transparent;', // 页面根容器自定义行内样式（穿透任何样式隔离，全端绝对生效）

    // --- 4. 导航栏与交互控制（配合 navbar 布局） ---
    showBack: false, // 导航栏左侧是否显示返回箭头（TabBar 首页无需返回按钮）
    hideStatusBar: false, // 是否隐藏手机顶部系统状态栏占位（true 为隐藏占位）
    hideNavbar: false, // 是否隐藏顶部导航栏（false 为正常显示）
    showNavbar: true, // 是否显示顶部导航栏（hideNavbar 的反向语义配置项）
    enablePullDownRefresh: !isH5, // 是否开启自定义下拉刷新（由 navbar 布局内的 scroll-view 驱动）

    // --- 5. 窗口原生底层表现配置（写入 pages.json 中的 style） ---
    style: {
      navigationBarTitleText: isH5
        ? 'h5'
        : isAppIOS
          ? 'ios'
          : isAppAndroid
            ? 'android'
            : isAppHarmony
              ? 'harmony'
              : isMpAlipay
                ? 'alipay'
                : isMpWeixin
                  ? 'weixin'
                  : 'tabbar.home', // 页面与导航栏标题文本（支持 i18n 自动翻译）
      navigationStyle: 'custom', // 导航栏样式设为自定义（隐藏系统原生固定导航栏，每页必须配置）
      navigationBarBackgroundColor: '#ffffff', // 原生导航栏背景颜色
      navigationStatusBarBackgroundColor: 'transparent', // 状态栏区域背景色（如设为透明）
      navigationContentBackgroundColor: 'transparent', // 内容区域背景色（如深绿色）
      navigationBarTextStyle: 'black', // 标题文字颜色
      navigationBackIconColor: '#000000' // 返回按钮图标独立颜色（如浅蓝色）
    }
  };
});

// 页面生命周期、入口深链、可见性桥接、模式判断与 Android 返回键统一由 TabBar hook 处理
useTabPageShell('index');

const {
  onLoad: onIndexLoad,
  onShow: onIndexShow,
  onHide: onIndexHide
} = useTabPage();

// 监听 navbar 自定义下拉刷新事件（在 enablePullDownRefresh: true 且处于当前 Tab 时生效）
onNavbarPullDownRefresh(() => {
  // 所有已挂载 Tab 都会收到全局刷新事件，只处理当前激活的首页
  if (curIdx.value != resolveTabIndexByKey('index')) {
    return;
  }
  console.log('首页刷新中...');
  setTimeout(() => {
    stopNavbarPullDownRefresh();
    // 异步完成时再次门控：刷新期间若已切走则忽略后续业务逻辑
    if (curIdx.value != resolveTabIndexByKey('index')) {
      return;
    }
    console.log('首页刷新成功');
  }, 1000);
});

// 与普通页面一致的首次进入 / 显示 / 隐藏生命周期
// onMounted
onIndexLoad(() => {
  console.log('onIndexLoad', '首页挂载了👋');
});

// onPageShow
onIndexShow(() => {
  console.log('onIndexShow', '首页显示了👀');
});

// onPageHide
onIndexHide(() => {
  stopNavbarPullDownRefresh();
  console.log('onIndexHide', '首页隐藏了👉');
});

function goBasic() {
  router.push({
    path: '/src/sub/modalBasicDemo/modalBasicDemo',
    query: {
      a: 1
    }
  });
}
function goBasic1() {
  router.push({
    path: '/src/pages/basic/basic',
    query: {
      a: 2
    }
  });
}
function goBasic2() {
  router.push({
    path: '/src/pages/basic/basic',
    query: {
      a: 3
    }
  });
}
</script>

<template>
  <TabPageHost>
    <div class="flex flex-col w-full">
      <button @click="goBasic">
        去modalBasicDemo
      </button>
      <button @click="goBasic1">
        去basic1
      </button>
      <button @click="goBasic2">
        去basic1
      </button>
      <!-- 1. 顶部 Header、环境信息卡片与简介 -->
      <IndexHeader />

      <!-- 2. 🤖 内置 unibestX-skill（AI 极速开发与 Token 节流引擎） -->
      <AiSkillSection />

      <!-- 3. 推荐 IDE 与开发环境 -->
      <IdeSection />

      <!-- 3. ⚡ 核心特性网格 -->
      <FeatureGrid />

      <!-- 4. 🧬 OpenAPI 接口生成与工程化套件 -->
      <EngineeringSection />

      <!-- 5. 🧰 内置与生态工具库 -->
      <ToolLibSection />

      <!-- 6. ⚡ 多端热重载与调试体验指南 -->
      <DevWorkflowGuide />

      <!-- 7. 底部提示 -->
      <IndexFooter />
    </div>
  </TabPageHost>
</template>

<style scoped lang="scss"></style>
