<template>
  <view class="flex flex-col flex-1 relative" style="flex: 1; height: 100%;">
    <!-- 模式 4：单页面 TabBar 容器模式 (零闪烁、0ms 秒切、Tab 状态常驻保活) -->
    <template v-if="isSinglePageTabbar">
      <!-- 自动挂载各 Tab 视图容器（由插件配合 config.uts 自动生成） -->
      <TabViews />
      <!-- 底部常驻 TabBar (同页渲染免路由跳转) -->
      <Tabbar />
    </template>

    <!-- 模式 0-3：独立页面模式 -->
    <HomeView v-else />
  </view>
</template>

<script setup lang="uts">
import HomeView from './views/IndexView.uvue';
import TabViews from '@/src/tabbar/components/TabViews.uvue';
import Tabbar from '@/src/tabbar/tabbar.uvue';
import { isSinglePageTabbar } from '@/src/tabbar';
import { handleBackPressExit } from '@/src/utils/backPress.uts';
import { onNavbarPullDownRefresh, stopNavbarPullDownRefresh } from '@/src/utils/refresh.uts';

definePage({
  customPageClass: 'init-page', // 页面根容器自定义类名（配合 layout 布局使用，支持配置全局样式类）
  customPageStyle: 'background-color: transparent;', // 页面根容器自定义行内样式（穿透任何样式隔离，全端绝对生效）
  debug: false, // 是否开启当前页面沙盒独立调试（设为 true 可单独调试此页；⚠️ 调试完成后改回 false）
  debugHome: false, // 沙盒调试模式下是否将当前页面指定为启动首页（全局仅允许 1 个页面设为 true，排在 pages[0]）
  type: 'home', // 页面类型标识（仅首页配置 'home'，标记当前页面为应用全局启动首页，自动排在 pages[0]）
  layout: 'navbar', // 页面通用布局模板（采用 navbar 布局接管顶部导航与下拉滚动容器）
  showBack: false, // 导航栏左侧是否显示返回箭头（TabBar 首页无需返回按钮）
  hideStatusBar: false, // 是否隐藏状态栏（true 为隐藏）
  hideNavbar: false, // 是否隐藏顶部导航栏（false 为正常显示）
  enablePullDownRefresh: true, // 是否开启自定义下拉刷新（由 navbar 布局内的 scroll-view 驱动）
  style: {
    navigationBarTitleText: '首页', // 页面与导航栏标题文本
    navigationStyle: 'custom' // 导航栏样式设为自定义（隐藏系统原生导航栏）
  }
});

// 监听 navbar 自定义下拉刷新事件（在 enablePullDownRefresh: true 时生效）
onNavbarPullDownRefresh(() => {
  console.log('刷新中');
  setTimeout(() => {
    console.log('刷新成功');
    // 数据加载完毕后，手动停止下拉刷新动画状态
    stopNavbarPullDownRefresh();
  }, 1000);
});

onBackPress((options: OnBackPressOptions): boolean => {
  // #ifdef APP
  if (options.from == 'backbutton') {
    return handleBackPressExit();
  }
  // #endif
  return false;
});
</script>

<style lang="scss" scoped></style>
