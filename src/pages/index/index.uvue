<template>
  <view class="flex flex-col flex-1 relative overflow-hidden" style="flex: 1; height: 100%;">
    <!-- 模式 4：单页面 TabBar 容器模式 (零闪烁、0ms 秒切、Tab 状态常驻保活) -->
    <template v-if="isSinglePageTabbar">
      <view class="flex-1 relative" style="flex: 1; position: relative;">
        <TabContent :content-index="0">
          <HomeView />
        </TabContent>
        <TabContent :content-index="1">
          <BasicView />
        </TabContent>
        <TabContent :content-index="2">
          <FunctionView />
        </TabContent>
        <TabContent :content-index="3">
          <MeView />
        </TabContent>
      </view>
      <!-- 底部常驻 TabBar (同页渲染免路由跳转) -->
      <CustomCapsuleTabbar v-if="isCapsuleTabbar" />
      <Tabbar v-else />
    </template>

    <!-- 模式 0-3：独立页面模式 -->
    <HomeView v-else />
  </view>
</template>

<script setup lang="uts">
import { onMounted } from 'vue';
import HomeView from './components/HomeView.uvue';
import BasicView from '../basic/components/BasicView.uvue';
import FunctionView from '../function/components/FunctionView.uvue';
import MeView from '../me/components/MeView.uvue';
import TabContent from '@/src/tabbar/components/TabContent.uvue';
import Tabbar from '@/src/tabbar/index.uvue';
import CustomCapsuleTabbar from '@/src/tabbar/custom/index.uvue';
import { isCapsuleTabbar, isSinglePageTabbar } from '@/src/tabbar/helper';
import { handleBackPressExit } from '@/src/utils/backPress.uts';
import { onNavbarPullDownRefresh, stopNavbarPullDownRefresh } from '@/src/utils/refresh.uts';
import { setPageScrollEnabled } from '@/src/utils/pageScroll.uts';

definePage({
  customPageClass: 'border-radius-12', // 页面根容器自定义类名（配合 layout 布局使用，支持配置全局样式类）
  customPageStyle: 'background-color: transparent;', // 页面根容器自定义行内样式（穿透任何样式隔离，全端绝对生效）
  debug: false, // 是否开启当前页面沙盒独立调试（设为 true 可单独调试此页；⚠️ 调试完成后改回 false）
  debugHome: false, // 沙盒调试模式下是否将当前页面指定为启动首页（全局仅允许 1 个页面设为 true，排在 pages[0]）
  type: 'home', // 页面类型标识（仅首页配置 'home'，标记当前页面为应用全局启动首页，自动排在 pages[0]）
  layout: 'navbar', // 页面通用布局模板（采用 navbar 布局接管顶部导航与下拉滚动容器）
  showBack: false, // 导航栏左侧是否显示返回箭头（TabBar 首页无需返回按钮）
  hideNavbar: false, // 是否隐藏顶部导航栏（false 为正常显示）
  enablePullDownRefresh: true, // 是否开启自定义下拉刷新（由 navbar 布局内的 scroll-view 驱动）
  style: {
    navigationBarBackgroundColor: '#ffffff', // 导航栏背景颜色（十六进制颜色值）
    navigationBarTitleText: '首页', // 页面与导航栏标题文本
    navigationStyle: 'custom' // 导航栏样式设为自定义（隐藏系统原生导航栏）
  }
});

// 当处于单页面模式时，禁用外层 layout 的总体滚动，改由各 TabContent 内部的 scroll-view 独立滚动以保活滚动位置
onMounted(() => {
  if (isSinglePageTabbar) {
    setPageScrollEnabled(false);
  }
});

// 监听 navbar 自定义下拉刷新事件（在 enablePullDownRefresh: true 时生效）
onNavbarPullDownRefresh(() => {
  setTimeout(() => {
    // 数据加载完毕后，手动停止下拉刷新动画状态
    stopNavbarPullDownRefresh();
  }, 1000);
});

onBackPress((options: OnBackPressOptions): boolean => {
  // #ifdef APP
  if (options.from == 'backbutton') {
    return handleBackPressExit();
  }
  // #endif
  return false;
});
</script>

<style lang="scss" scoped></style>
