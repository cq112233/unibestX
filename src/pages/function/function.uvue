<template>
  <FunctionView />
</template>

<script setup lang="uts">
import FunctionView from './views/FunctionView.uvue';
import { handleBackPressExit } from '@/src/utils/backPress/index.uts';
import { onNavbarPullDownRefresh, stopNavbarPullDownRefresh } from '@/src/utils/refresh/index.uts';
import { notifyPageHide, notifyPageShow, setCurIdx } from '@/src/tabbar/index.uts';

definePage({
  debug: false,
  layout: 'navbar',
  showBack: false,
  enablePullDownRefresh: true,
  hideStatusBar: false,
  hideNavbar: false,
  style: {
    navigationBarTitleText: '功能',
    navigationStyle: 'custom'
  }
});

// 独立页面模式下，切到当前功能页时同步当前 Tab 激活索引并通知页面可见
onShow(() => {
  setCurIdx(2);
  notifyPageShow();
});

onHide(() => {
  notifyPageHide();
});

onNavbarPullDownRefresh(() => {
  new Promise((resolve) => {
    setTimeout(() => {
      resolve(true);
    }, 1000);
  }).then(() => {
    stopNavbarPullDownRefresh();
  });
});

onBackPress((options: OnBackPressOptions): boolean => {
  // #ifdef APP
  if (options.from == 'backbutton') {
    return handleBackPressExit();
  }
  // #endif
  return false;
});
</script>

<style></style>
