<template>
  <view class="flex-col p-[16px]">
    <!-- 顶部开发指引提示（正式业务可直接移除） -->
    <view class="rounded-[12px] p-[12px] mb-[16px] bg-[#eff6ff] border-[1px] border-solid border-[#bfdbfe] flex flex-row items-start">
      <text class="text-[14px] mr-[6px]">💡</text>
      <view class="flex-1 flex flex-col">
        <text class="text-[13px] font-bold text-[#1d4ed8] mb-[2px]">开发指引（可删除）：</text>
        <text class="text-[12px] leading-[18px] text-[#2563eb]">
          本页面所有卡片均为 unibestX 扩展功能演示 Demo。开发正式业务时，可直接删除本列表与对应的 /src/sub/*FunctionDemo 分包目录。
        </text>
        <text class="text-[12px] leading-[18px] mt-[2px] text-[#2563eb]">
          也可执行下方命令一键清除全部 Demo 内容（含演示页面目录、分包路由与各 Tab 页的卡片列表），加 --dry-run 可先预览删除范围。
        </text>
        <!-- 一键清除 Demo 命令（点击复制，样式对齐首页 CLI 命令块） -->
        <view
          class="mt-[8px] px-[10px] py-[8px] rounded-[6px] bg-[#0f172a] flex flex-row items-center justify-between active:opacity-90"
          @click="copyCleanDemoCommand"
        >
          <text class="text-[11px] text-[#38bdf8] flex-1" style="font-family: monospace;">
            pnpm clean:demo
          </text>
          <text class="text-[10px] text-[#94a3b8] ml-[8px]">
            点击复制
          </text>
        </view>
      </view>
    </view>

    <!-- 功能能力演示列表（Card + 一行描述 + sub路径展示 + 原生按钮跳转） -->
    <view
      v-for="item in demoList"
      :key="item.id"
      class="rounded-[16px] p-[20px] mb-[16px] border-[1px] border-solid border-[#edf2f7] bg-[#ffffff]"
    >
      <!-- 标题区域 -->
      <view class="flex flex-row items-center justify-between mb-[12px]">
        <view class="flex flex-row items-center flex-1">
          <view
            class="w-[4px] h-[16px] rounded-[2px] mr-[8px] bg-[#3b82f6]"
          />
          <text class="text-[16px] font-bold text-[#2d3748]">
            {{ item.title }}
          </text>
        </view>
        <!-- 可删除标识 -->
        <view class="px-[6px] py-[2px] rounded-[4px] bg-[#fef2f2] border-[1px] border-solid border-[#fee2e2]">
          <text class="text-[11px] font-medium text-[#ef4444]">
            可删除 Demo
          </text>
        </view>
      </view>

      <!-- 一行功能描述 -->
      <view class="flex-col mb-[12px]">
        <text
          class="text-[13px] leading-[18px] text-[#64748b]"
        >
          {{ item.desc }}
        </text>
      </view>

      <!-- 对应 sub 路径及删除指引 -->
      <view class="p-[10px] rounded-[8px] bg-[#f8fafc] border-[1px] border-solid border-[#e2e8f0] mb-[16px]">
        <view class="flex flex-row items-center mb-[4px]">
          <text class="text-[11px] font-bold text-[#475569] mr-[6px]">
            对应 sub 路径:
          </text>
          <text class="text-[11px] text-[#2563eb]" style="font-family: monospace;">
            {{ item.path }}
          </text>
        </view>
        <text class="text-[11px] leading-[16px] text-[#94a3b8]">
          提示：正式业务开发时，可删除此卡片及对应的 sub 演示目录与 pages.json 路由。
        </text>
      </view>

      <!-- 跳转按钮 -->
      <view
        class="w-full h-[42px] flex flex-row items-center justify-center rounded-[8px] bg-[#3b82f6] active:opacity-90"
        @click="navigateToDemo(item.path)"
      >
        <text class="text-[#ffffff] text-[14px] font-bold">
          {{ item.btnText }}
        </text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { curIdx, resolveTabIndexByKey, useTabPage, useTabPageShell } from '@/src/tabbar/index.uts';
import { onNavbarPullDownRefresh, stopNavbarPullDownRefresh } from '@/src/layouts/navbar/utils/index.uts';
import { useRouter } from '@/uni_modules/route-bestX/index.uts';

definePage(() => {
  return {
    customPageClass: 'init-page', // 页面根容器自定义类名（配合 layout 布局使用，支持配置全局样式类）
    customPageStyle: 'background-color: transparent;', // 页面根容器自定义行内样式（穿透任何样式隔离，全端绝对生效）
    name: 'function', // 路由名：useRoute().name 优先读取此值，未显式声明时默认读取路径最后一个单词（如 index）
    debug: false, // 是否开启当前页面沙盒独立调试（设为 true 可单独调试此页；⚠️ 调试完成后改回 false）
    debugHome: false, // 沙盒调试模式下是否将当前页面指定为启动首页（全局仅允许 1 个页面设为 true，排在 pages[0]）
    layout: 'navbar', // 页面通用布局模板（采用 navbar 布局接管顶部导航与下拉滚动容器）
    showBack: false, // 导航栏左侧是否显示返回箭头（TabBar 首页无需返回按钮）
    hideStatusBar: false, // 是否隐藏状态栏（true 为隐藏）
    hideNavbar: false, // 是否隐藏顶部导航栏（false 为正常显示）
    style: {
      navigationBarTitleText: 'tabbar.function',
      navigationStyle: 'custom'
    }
  };
});

// 页面文件同时可作为模式 4 的 Tab 子页使用：嵌套时由 useTabPage() 接管页面生命周期
useTabPageShell('function');

const {
  route: functionRoute,
  onLoad: onFunctionLoad,
  onShow: onFunctionShow,
  onHide: onFunctionHide
} = useTabPage();

const router = useRouter();

// 监听 navbar 自定义下拉刷新事件
onNavbarPullDownRefresh(() => {
  // 所有已挂载 Tab 都会收到全局刷新事件，只处理当前激活的功能页
  if (curIdx.value != resolveTabIndexByKey('function')) {
    return;
  }
  console.log('功能页面刷新中...');
  setTimeout(() => {
    stopNavbarPullDownRefresh();
    // 异步完成时再次门控：刷新期间若已切走则忽略后续业务逻辑
    if (curIdx.value != resolveTabIndexByKey('function')) {
      return;
    }
    console.log('功能页面刷新成功');
  }, 1000);
});

// 与普通页面一致的首次进入 / 显示 / 隐藏生命周期
onFunctionLoad(() => {
  // 💡 模式4的映射关系中，/function.uvue 映射到的实际页面路由是/tab/index，这是因为tabbar/index.uts中定义了映射关系
  // 💡 模式4 useRoute 获取的还是index的
  // 🔔 模式4，tabbar切换时，不会走beforeEach，因为是index，是根容器, 如需拦截请自行处理src/tabbar/adapters/tab-navigation.uts，一般业务用不动，无需修改
  console.log('功能页面路径', functionRoute.value.fullPath);
  console.log('onFunctionLoad', '功能 Tab 挂载了👋');
});

onFunctionShow(() => {
  console.log('onFunctionShow', '功能 Tab 显示了👀');
});

onFunctionHide(() => {
  stopNavbarPullDownRefresh();
  console.log('onFunctionHide', '功能 Tab 隐藏了👉');
});

// =========================================================================
// 【可选删除】以下数据与方法仅供脚手架扩展功能演示使用。
// 接入真实业务时可整段删除，并同步清理对应 sub 分包与 pages.json 路由：
// - zpaging:      /src/sub/zpagingFunctionDemo/
// - nestedScroll: /src/sub/nestedScrollFunctionDemo/
// - signature:    /src/sub/signatureFunctionDemo/
// - qrcode:       /src/sub/qrcodeFunctionDemo/
// - editor:       /src/sub/editorFunctionDemo/
// - richText:     /src/sub/richTextFunctionDemo/
// - chart:        /src/sub/chartFunctionDemo/
// - webview:      /src/sub/webviewFunctionDemo/
// =========================================================================
type FunctionDemoItem = {
  id: string;
  title: string;
  desc: string;
  btnText: string;
  path: string;
};

const demoList: Array<FunctionDemoItem> = [
  {
    id: 'zpaging',
    title: 'z-paging-x 原生分页',
    desc: '演示 120Hz 极速列表、原生阻尼下拉刷新与高性能复用加载。',
    btnText: '进入 z-paging-x 原生分页功能',
    path: '/src/sub/zpagingFunctionDemo/zpagingFunctionDemo'
  },
  {
    id: 'nestedScroll',
    title: 'NestedScroll 嵌套滚动',
    desc: '自研原生手势联通与平滑衔接，彻底消除双重滚动冲突。',
    btnText: '进入 NestedScroll 嵌套滚动功能',
    path: '/src/sub/nestedScrollFunctionDemo/nestedScrollFunctionDemo'
  },
  {
    id: 'xtfCharts',
    title: 'XTF-Charts 原生图表',
    desc: '基于 Canvas 2D 零依赖跨端渲染，支持折线、柱状、环形饼图、雷达与仪表盘。',
    btnText: '进入 XTF-Charts 图表功能',
    path: '/src/sub/chartsFunctionDemo/chartsFunctionDemo'
  },
  {
    id: 'echarts',
    title: 'ECharts 跨端图表',
    desc: '基于 e-chart 组件，演示折线图、柱状图、饼图动态切换与交互。',
    btnText: '进入 ECharts 跨端图表功能',
    path: '/src/sub/echartsFunctionDemo/echartsFunctionDemo'
  },
  {
    id: 'signature',
    title: 'lime-signature 签名板',
    desc: '演示平滑笔迹书写、画笔粗细与颜色调节、撤销重做与图片保存。',
    btnText: '进入 lime-signature 签名板功能',
    path: '/src/sub/signatureFunctionDemo/signatureFunctionDemo'
  },
  {
    id: 'rxjs',
    title: 'RxJS 响应式流',
    desc: 'UTS 自研 rxjs-bestX，演示防抖节流、流式接收与订阅管理。',
    btnText: '进入 RxJS 响应式流功能',
    path: '/src/sub/rxjsFunctionDemo/rxjsFunctionDemo'
  },
  {
    id: 'device',
    title: '原生设备与系统能力',
    desc: '演示拨号分享、文件文档预览、触感震动、键盘避让与相机扫码。',
    btnText: '进入原生设备与系统能力功能',
    path: '/src/sub/deviceFunctionDemo/deviceFunctionDemo'
  },
  {
    id: 'limeShared',
    title: 'lime-shared 工具函数',
    desc: '演示浮点精度、序列生成、唯一标识、数组去重切片、路径取值、命名转换、深比较与防抖随机数。',
    btnText: '进入 lime-shared 工具函数功能',
    path: '/src/sub/limeSharedFunctionDemo/limeSharedFunctionDemo'
  },
  {
    id: 'limeUse',
    title: 'lime-use 组合式函数',
    desc: '演示 useCountDown、useCodeTimer、useTimeout 与 useZIndex 四个常用组合式函数。',
    btnText: '进入 lime-use 组合式函数功能',
    path: '/src/sub/limeUseFunctionDemo/limeUseFunctionDemo'
  },
  {
    id: 'limeColor',
    title: 'lime-color 颜色工具',
    desc: '演示颜色格式互转、亮度饱和度调整、配色方案生成与 Ant Design 主题色阶。',
    btnText: '进入 lime-color 颜色工具功能',
    path: '/src/sub/limeColorFunctionDemo/limeColorFunctionDemo'
  },
  {
    id: 'bignumber',
    title: 'BigNumber 大数据运算',
    desc: '演示任意精度加减乘除、浮点误差对照、除法精度、幂与开方、比较判定、进制转换与九种舍入模式。',
    btnText: '进入 BigNumber 大数据运算功能',
    path: '/src/sub/bignumberFunctionDemo/bignumberFunctionDemo'
  },
  {
    id: 'crypto',
    title: 'Crypto 加密解密',
    desc: '演示 Base64、MD5、SHA-256、HMAC、AES 与 DES 常用加解密套件。',
    btnText: '进入 Crypto 加密解密功能',
    path: '/src/sub/cryptoFunctionDemo/cryptoFunctionDemo'
  },
  {
    id: 'time',
    title: 'Time 时间日期操作',
    desc: '基于 lime-dayuts，演示时间格式化、增减计算、相对时间与时间戳转换。',
    btnText: '进入 Time 时间日期操作功能',
    path: '/src/sub/timeFunctionDemo/timeFunctionDemo'
  },
  {
    id: 'webview',
    title: 'WebView 双向通讯',
    desc: '演示网页容器内嵌、postMessage 跨端消息收发与 evalJS 动态交互。',
    btnText: '进入 WebView 双向通讯功能',
    path: '/src/sub/webviewFunctionDemo/webviewFunctionDemo'
  }
];

function navigateToDemo(url: string): void {
  router.push(url);
}

// 复制一键清除 Demo 命令
function copyCleanDemoCommand(): void {
  uni.setClipboardData({
    data: 'pnpm clean:demo',
    success: () => {
      uni.showToast({
        title: '已复制清除命令',
        icon: 'success'
      });
    }
  });
}
// =================== 【可选删除】功能演示 Demo 数据与跳转方法 结束 ===================
</script>

<style scoped></style>
