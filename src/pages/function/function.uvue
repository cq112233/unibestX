<template>
  <FunctionView />
</template>

<script setup lang="uts">
import FunctionView from './views/FunctionView.uvue';
import { useBackPressExit } from '@/src/hooks/useBackPressExit.uts';
import { notifyPageHide, notifyPageShow, setCurIdxByKey } from '@/src/tabbar/index.uts';

definePage({
  debug: false,
  layout: 'navbar',
  showBack: false,
  enablePullDownRefresh: true,
  hideStatusBar: false,
  hideNavbar: false,
  style: {
    navigationBarTitleText: 'tabbar.function',
    navigationStyle: 'custom'
  }
});

// 独立页面模式下，切到当前功能页时同步当前 Tab 激活索引并通知页面可见
onShow(() => {
  setCurIdxByKey('function');
  notifyPageShow();
});

onHide(() => {
  notifyPageHide();
});

// Android 物理返回键：再按一次退出应用
useBackPressExit();
</script>

<style></style>
