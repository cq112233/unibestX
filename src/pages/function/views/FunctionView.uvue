<template>
  <view>
    <!-- 标题头 -->
    <view class="pt-[20px] px-[16px] pb-[10px]">
      <text class="text-[20px] font-bold text-[#1a202c]">功能组件库演示</text>
      <text class="text-[13px] text-[#718096] mt-[4px]">演示原生设备 API 调用、常用工具库与组件集成</text>
    </view>

    <!-- 数据分页列表示例组件 (z-paging-x) -->
    <ZPagingDemoCard />

    <!-- 触感与工具卡片 -->
    <HapticsCard />

    <!-- 全局 Toast 提示调用卡片 -->
    <ToastCard />

    <!-- 相机与多媒体卡片 -->
    <MediaCard />

    <!-- Lodash 工具库 (iRainna-lodash) 示例组件 -->
    <LodashDemoCard />

    <!-- 加密解密工具 (crypto) 示例组件 -->
    <CryptoDemoCard />

    <!-- 时间日期操作 (lime-dayuts) 演示组件 -->
    <TimeDemoCard />

    <!-- 签名板 lime-signature 示例组件 -->
    <SignatureCard />

    <!-- ECharts 图表示例组件 -->
    <EchartsDemoCard />
  </view>
</template>

<script setup lang="uts">
import CryptoDemoCard from '../components/CryptoDemoCard.uvue';
import EchartsDemoCard from '../components/EchartsDemoCard.uvue';
import HapticsCard from '../components/HapticsCard.uvue';
import LodashDemoCard from '../components/LodashDemoCard.uvue';
import MediaCard from '../components/MediaCard.uvue';
import SignatureCard from '../components/SignatureCard.uvue';
import TimeDemoCard from '../components/TimeDemoCard.uvue';
import ToastCard from '../components/ToastCard.uvue';
import ZPagingDemoCard from '../components/ZPagingDemoCard.uvue';
import { onNavbarPullDownRefresh, stopNavbarPullDownRefresh } from '@/src/utils/refresh.uts';
import { curIdx, onTabShow } from '@/src/tabbar';

// 页面数据加载/刷新方法
function refreshData(): void {
  console.log('功能页面刷新中...');
  setTimeout(() => {
    console.log('功能页面刷新成功');
    // 数据加载完毕后，手动停止下拉刷新动画状态
    stopNavbarPullDownRefresh();
  }, 1000);
}

// 监听 Tab 切换到当前功能页（索引 2）时触发刷新
onTabShow(2, () => {
  console.log('切换到了功能 Tab');
  refreshData();
});

// 监听 navbar 自定义下拉刷新事件（在 enablePullDownRefresh: true 且处于当前 Tab 时生效）
onNavbarPullDownRefresh(() => {
  if (curIdx.value == 2) {
    refreshData();
  }
});
</script>

<style scoped></style>
