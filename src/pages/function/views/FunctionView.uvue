<template>
  <view class="flex-col p-[16px]">
    <!-- 功能能力演示列表（Card + 一行描述 + 原生按钮跳转） -->
    <view
      v-for="item in demoList"
      :key="item.id"
      class="rounded-[16px] p-[20px] mb-[16px] border-[1px] border-solid border-[#edf2f7] bg-[#ffffff]"
    >
      <!-- 标题区域 -->
      <view class="flex flex-row items-center mb-[12px]">
        <view
          class="w-[4px] h-[16px] rounded-[2px] mr-[8px] bg-[#3b82f6]"
        />
        <text class="text-[16px] font-bold text-[#2d3748]">
          {{ item.title }}
        </text>
      </view>

      <!-- 一行功能描述 -->
      <view class="flex-col mb-[16px]">
        <text
          class="text-[13px] leading-[18px] text-[#64748b]"
        >
          {{ item.desc }}
        </text>
      </view>

      <!-- 跳转按钮 -->
      <view
        class="w-full h-[42px] flex flex-row items-center justify-center rounded-[8px] bg-[#3b82f6] active:opacity-90"
        @click="navigateToDemo(item.path)"
      >
        <text class="text-[#ffffff] text-[14px] font-bold">
          {{ item.btnText }}
        </text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { curIdx, onTabPageShow, onTabShow, resolveTabIndexByKey } from '@/src/tabbar/index.uts';
import { onNavbarPullDownRefresh, stopNavbarPullDownRefresh } from '@/src/layouts/navbar/utils/index.uts';
import { systemInfo } from '@/src/utils/systemInfo/index.uts';

type FunctionDemoItem = {
  id: string;
  title: string;
  desc: string;
  btnText: string;
  path: string;
};

const demoList: Array<FunctionDemoItem> = [
  {
    id: 'zpaging',
    title: 'z-paging-x 原生分页 Demo',
    desc: '演示 120Hz 极速列表、原生阻尼下拉刷新与高性能复用加载。',
    btnText: '进入 z-paging-x 原生分页功能',
    path: '/src/sub/zpagingFunctionDemo/zpagingFunctionDemo'
  },
  {
    id: 'nestedScroll',
    title: 'NestedScroll 嵌套滚动 Demo',
    desc: '自研原生手势联通与平滑衔接，彻底消除双重滚动冲突。',
    btnText: '进入 NestedScroll 嵌套滚动功能',
    path: '/src/sub/nestedScrollFunctionDemo/nestedScrollFunctionDemo'
  },
  {
    id: 'echarts',
    title: 'ECharts 跨端图表 Demo',
    desc: '基于 e-chart 组件，演示折线图、柱状图、饼图动态切换与交互。',
    btnText: '进入 ECharts 跨端图表功能',
    path: '/src/sub/echartsFunctionDemo/echartsFunctionDemo'
  },
  {
    id: 'signature',
    title: 'lime-signature 签名板 Demo',
    desc: '演示平滑笔迹书写、画笔粗细与颜色调节、撤销重做与图片保存。',
    btnText: '进入 lime-signature 签名板功能',
    path: '/src/sub/signatureFunctionDemo/signatureFunctionDemo'
  },
  {
    id: 'rxjs',
    title: 'RxJS 响应式流 Demo',
    desc: 'UTS 自研 rxjs-lite，演示防抖节流、流式接收与订阅管理。',
    btnText: '进入 RxJS 响应式流功能',
    path: '/src/sub/rxjsFunctionDemo/rxjsFunctionDemo'
  },
  {
    id: 'device',
    title: '原生设备与系统能力 Demo',
    desc: '演示拨号分享、文件文档预览、触感震动、键盘避让与相机扫码。',
    btnText: '进入原生设备与系统能力功能',
    path: '/src/sub/deviceFunctionDemo/deviceFunctionDemo'
  },
  {
    id: 'lodash',
    title: 'Lodash 工具库 Demo',
    desc: '演示数组切片去重、对象深拷贝、驼峰转换与函数防抖节流。',
    btnText: '进入 Lodash 工具库功能',
    path: '/src/sub/lodashFunctionDemo/lodashFunctionDemo'
  },
  {
    id: 'crypto',
    title: 'Crypto 加密解密 Demo',
    desc: '演示 Base64、MD5、SHA-256、HMAC、AES 与 DES 常用加解密套件。',
    btnText: '进入 Crypto 加密解密功能',
    path: '/src/sub/cryptoFunctionDemo/cryptoFunctionDemo'
  },
  {
    id: 'time',
    title: 'Time 时间日期操作 Demo',
    desc: '基于 lime-dayuts，演示时间格式化、增减计算、相对时间与时间戳转换。',
    btnText: '进入 Time 时间日期操作功能',
    path: '/src/sub/timeFunctionDemo/timeFunctionDemo'
  },
  {
    id: 'webview',
    title: 'WebView 双向通讯 Demo',
    desc: '演示网页容器内嵌、postMessage 跨端消息收发与 evalJS 动态交互。',
    btnText: '进入 WebView 双向通讯功能',
    path: '/src/sub/webviewFunctionDemo/webviewFunctionDemo'
  }
];

function navigateToDemo(url: string): void {
  uni.navigateTo({
    url,
    fail: (err) => {
      console.error('navigateToDemo fail:', err);
    }
  });
}

// 页面数据加载/刷新方法
function refreshData(): void {
  console.log('功能页面刷新中...');
  setTimeout(() => {
    if (curIdx.value != resolveTabIndexByKey('function')) {
      return;
    }
    console.log('功能页面刷新成功');
    stopNavbarPullDownRefresh();
  }, 1000);
}

// 监听 navbar 自定义下拉刷新事件
onNavbarPullDownRefresh(() => {
  if (curIdx.value == resolveTabIndexByKey('function')) {
    refreshData();
  }
});

// 监听 Tab 切换到当前功能页（config.uts 中 type: 'function'）
onTabShow('function', () => {
  console.log('onTabShow 功能 Tab 显示');
}, true);

// 监听功能 Tab 页面显示
onTabPageShow('function', () => {
  console.log('onTabPageShow 功能 Tab 显示');
}, true);

onMounted(() => {
  console.log(systemInfo.value?.availableHeight, 'systemInfo.value?.availableHeight');
  console.log('功能 Tab 挂载了');
});

onUnmounted(() => {
  console.log('功能 Tab 卸载了');
});
</script>

<style scoped></style>
