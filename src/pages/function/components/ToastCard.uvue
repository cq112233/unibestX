<template>
  <view
    class="rounded-[16px] p-[20px] m-[16px] border-[1px] border-solid"
    :style="{
      backgroundColor: 'var(--card-bg, #ffffff)',
      borderColor: 'var(--border-color, #edf2f7)'
    }"
  >
    <!-- 标题区域 -->
    <view class="flex flex-row items-center mb-[16px]">
      <view
        class="w-[4px] h-[16px] rounded-[2px] mr-[8px]"
        :style="{ backgroundColor: 'var(--theme-color, #3182ce)' }"
      />
      <text class="text-[16px] font-bold" :style="{ color: 'var(--text-color, #2d3748)' }">全局 Toast 提示调用</text>
    </view>

    <!-- 说明区域 -->
    <view class="rounded-[12px] p-[16px] mb-[16px] border-[1px] border-solid border-[#e2e8f0]">
      <text class="text-[12px] text-[#64748b] leading-[20px]">
        演示从功能页调用 App.ku.uvue 全局挂载的 &lt;up-toast ref="uToastRef" /&gt;，支持自定义消息、类型与轻提示反馈。
      </text>
    </view>

    <!-- 自定义输入内容 -->
    <view class="mb-[12px]">
      <text class="text-[12px] text-[#94a3b8] mb-[6px]">自定义 Toast 内容</text>
      <input
        v-model="customMsg"
        placeholder="请输入要提示的文字内容"
        class="h-[38px] bg-white rounded-[6px] px-[12px] border-[1px] border-solid border-[#cbd5e1] text-[14px] text-[#334155]"
      />
    </view>

    <!-- 按钮操作组 -->
    <view class="flex flex-row">
      <view
        class="flex-1 mr-[10px] bg-[#3b82f6] rounded-[8px] h-[40px] flex flex-row items-center justify-center"
        @click="showCustomToast"
      >
        <text class="text-[#ffffff] text-[13px] font-bold">弹出自定义 Toast</text>
      </view>
      <view
        class="flex-1 bg-[#10b981] rounded-[8px] h-[40px] flex flex-row items-center justify-center"
        @click="showSuccessToast"
      >
        <text class="text-[#ffffff] text-[13px] font-bold">弹出成功 Toast</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue';
import { toast, toastSuccess } from '@/src/utils/toast';

const customMsg = ref<string>('来自 Function 功能页的 Toast 消息！');

function showCustomToast() {
  if (customMsg.value.trim() == '') {
    toast('请输入提示内容');
    return;
  }
  toast(customMsg.value);
}

function showSuccessToast() {
  toastSuccess('Function 页面全局 Toast 触发成功！');
}
</script>

<style>
</style>
