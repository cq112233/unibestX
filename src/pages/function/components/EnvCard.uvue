<template>
  <Card title="环境变量">
    <view class="rounded-[12px] p-[16px] border-[1px] border-solid border-[#e2e8f0]">
      <view class="flex-row justify-between mb-[10px]">
        <text class="text-[14px] text-[#718096]">应用名称</text>
        <text class="text-[14px] font-bold text-[#334155]">{{ systemInfo?.appTitle ?? 'unibestX' }}</text>
      </view>
      <view class="flex-row justify-between mb-[10px]">
        <text class="text-[14px] text-[#718096]">应用版本</text>
        <text class="text-[14px] font-bold text-[#334155]">v{{ systemInfo?.appVersion ?? '1.0.0' }}</text>
      </view>
      <view class="flex-row justify-between mb-[10px]">
        <text class="text-[14px] text-[#718096]">编译环境</text>
        <text class="text-[14px] font-bold" :style="{ color: envColor }">{{ systemInfo?.envName ?? '开发环境' }}</text>
      </view>
      <view class="flex-row justify-between mb-[10px]">
        <text class="text-[14px] text-[#718096]">环境标识</text>
        <text class="text-[12px] text-[#64748b]">{{ systemInfo?.env ?? 'development' }}</text>
      </view>
      <view class="flex-row justify-between">
        <text class="text-[14px] text-[#718096]">接口地址</text>
        <text class="text-[12px] text-[#64748b] flex-1 ml-[8px] text-right">{{ systemInfo?.apiBaseUrl ?? '' }}</text>
      </view>
    </view>
  </Card>
</template>

<script setup lang="uts">
import Card from '../../basic/components/Card.uvue';
import { systemInfo } from '../../../utils/systemInfo.uts';
import { computed } from 'vue';

const envColor = computed((): string => {
  const env = systemInfo.value?.env ?? '';
  if (env == 'test') {
    return '#f59e0b';
  }
  if (env == 'production') {
    return '#ef4444';
  }
  return '#10b981';
});
</script>

