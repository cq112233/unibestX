<template>
  <Card title="设备系统信息">
    <view class="rounded-[12px] p-[16px] mb-[16px] border-[1px] border-solid border-[#e2e8f0]">
      <view class="flex-row justify-between mb-[10px]">
        <text class="text-[14px] text-[#718096]">手机品牌</text>
        <text class="text-[14px] font-bold text-[#2d3748]">{{ sysBrand !== '' ? sysBrand : '暂无数据' }}</text>
      </view>
      <view class="flex-row justify-between mb-[10px]">
        <text class="text-[14px] text-[#718096]">手机型号</text>
        <text class="text-[14px] font-bold text-[#2d3748]">{{ sysModel !== '' ? sysModel : '暂无数据' }}</text>
      </view>
      <view class="flex-row justify-between mb-[10px]">
        <text class="text-[14px] text-[#718096]">操作系统</text>
        <text class="text-[14px] font-bold text-[#2d3748]">{{ sysSystem !== '' ? sysSystem : '暂无数据' }}</text>
      </view>
      <view class="flex-row justify-between mb-[10px]">
        <text class="text-[14px] text-[#718096]">运行平台</text>
        <text class="text-[14px] font-bold text-[#2d3748]">{{ sysPlatform != '' ? sysPlatform : '暂无数据' }}</text>
      </view>
      <view class="flex-row justify-between">
        <text class="text-[14px] text-[#718096]">编译器版本</text>
        <text class="text-[14px] font-bold text-[#2d3748]">{{ sysCompileVersion != '' ? sysCompileVersion : '暂无数据' }}</text>
      </view>
    </view>
    <view class="w-full h-[44px] rounded-[8px] bg-[#3b82f6] flex flex-row items-center justify-center" @click="fetchSystemInfo">
      <text class="text-[#ffffff] text-[14px] font-bold">获取系统信息</text>
    </view>
  </Card>
</template>

<script setup lang="uts">
import Card from '../../basic/components/Card.uvue';
import { onMounted, ref } from 'vue';

const sysBrand = ref('');
const sysModel = ref('');
const sysSystem = ref('');
const sysPlatform = ref('');
const sysCompileVersion = ref('');

function fetchSystemInfo() {
  try {
    const info = uni.getSystemInfoSync();
    sysBrand.value = info.brand ?? '';
    sysModel.value = info.model ?? '';
    sysSystem.value = info.system ?? '';
    sysPlatform.value = info.uniPlatform ?? '';
    let ver = info.uniCompileVersion ?? '';
    // #ifdef MP-WEIXIN
    if (ver == '') {
      try {
        const baseInfo = uni.getAppBaseInfo() as any;
        ver = `${baseInfo.appCompilerVersion ?? baseInfo.SDKVersion ?? ''}`;
      }
      catch {}
    }
    // #endif
    // #ifdef H5
    if (ver == '') {
      try {
        const g = globalThis as any;
        const conf = g.__uniConfig as any;
        if (conf != null && conf.compilerVersion != null) {
          ver = `${conf.compilerVersion}`;
        }
      }
      catch {}
    }
    // #endif
    sysCompileVersion.value = ver;
  }
  catch (err) {
    console.error(err);
  }
}

onMounted(() => {
  fetchSystemInfo();
});
</script>

<style>
</style>
