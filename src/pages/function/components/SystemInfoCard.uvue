<template>
  <Card title="设备系统信息">
    <view class="rounded-[12px] p-[16px] mb-[16px] border-[1px] border-solid border-[#e2e8f0]">
      <view class="flex-row justify-between mb-[10px]">
        <text class="text-[14px] text-[#718096]">手机品牌</text>
        <text class="text-[14px] font-bold text-[#2d3748]">{{ (systemInfo?.brand ?? '') !== '' ? systemInfo?.brand : '暂无数据' }}</text>
      </view>
      <view class="flex-row justify-between mb-[10px]">
        <text class="text-[14px] text-[#718096]">手机型号</text>
        <text class="text-[14px] font-bold text-[#2d3748]">{{ (systemInfo?.model ?? '') !== '' ? systemInfo?.model : '暂无数据' }}</text>
      </view>
      <view class="flex-row justify-between mb-[10px]">
        <text class="text-[14px] text-[#718096]">操作系统</text>
        <text class="text-[14px] font-bold text-[#2d3748]">{{ (systemInfo?.system ?? '') !== '' ? systemInfo?.system : '暂无数据' }}</text>
      </view>
      <view class="flex-row justify-between mb-[10px]">
        <text class="text-[14px] text-[#718096]">运行平台</text>
        <text class="text-[14px] font-bold text-[#2d3748]">{{ systemInfo?.platformName ?? '未知平台' }}</text>
      </view>
      <view class="flex-row justify-between mb-[10px]">
        <text class="text-[14px] text-[#718096]">编译器版本</text>
        <text class="text-[14px] font-bold text-[#2d3748]">{{ (systemInfo?.compilerVersion ?? '') !== '' ? systemInfo?.compilerVersion : '1.0.0' }}</text>
