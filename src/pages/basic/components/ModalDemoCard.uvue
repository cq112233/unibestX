<template>
  <Card title="全屏遮罩弹窗（覆盖 TabBar）">
    <view
      class="rounded-[10px] p-[12px] border-[1px] border-solid"
      :class="isDark ? 'bg-[#1e293b]/70 border-[#334155]' : 'bg-[#f8fafc] border-[#e2e8f0]'"
    >
      <view class="flex flex-row items-center justify-between mb-[6px]">
        <text class="text-[13px] font-bold" :class="isDark ? 'text-[#f1f5f9]' : 'text-[#1e293b]'">🎭 TabBar 全局覆盖机制</text>
        <text class="text-[10px] font-medium px-[6px] py-[2px] rounded-[4px] text-[#38bdf8] bg-[#0284c71f]">z-index: 9999</text>
      </view>
      <text
        class="text-[12px] leading-[20px] mb-[10px]"
        :class="isDark ? 'text-[#94a3b8]' : 'text-[#64748b]'"
      >
        演示全屏遮罩覆盖 TabBar 机制。在模式 0、2、3、4（推荐模式 4 单页保活）下，TabBar 为组件层渲染（z-index: 999），弹窗遮罩（z-index: 9999）可在全端 100% 完美覆盖；在模式 1 原生 TabBar 下，H5 端可遮挡，App/小程序原生底座层级高于页面需配合 hideTabBar API。
      </text>
      <view
        class="h-[36px] rounded-[8px] bg-[#4f46e5] flex flex-row items-center justify-center active:opacity-85"
        @click="openModal"
      >
        <text class="text-[#ffffff] text-[13px] font-medium">打开遮罩弹窗（遮住 TabBar）</text>
      </view>
    </view>

    <!-- 封装的弹窗遮罩组件 -->
    <TabbarMaskModal
      :visible="showModal"
      @close="closeModal"
    />
  </Card>
</template>

<script setup lang="uts">
import { computed, ref } from 'vue';
import { useAppStore } from '@/src/store';
import Card from './Card.uvue';
import TabbarMaskModal from './TabbarMaskModal.uvue';

const appStore = useAppStore();
const isDark = computed((): boolean => appStore.state.isDark);

const showModal = ref(false);

function openModal(): void {
  showModal.value = true;
}

function closeModal(): void {
  showModal.value = false;
}
</script>

