<template>
  <view
    class="rounded-[16px] p-[20px] m-[16px] border-[1px] border-solid"
    :style="{
      backgroundColor: 'var(--card-bg, #ffffff)',
      borderColor: 'var(--border-color, #edf2f7)'
    }"
  >
    <!-- 标题区域 -->
    <view class="flex flex-row items-center mb-[16px]">
      <view
        class="w-[4px] h-[16px] rounded-[2px] mr-[8px]"
        :style="{ backgroundColor: 'var(--theme-color, #3182ce)' }"
      />
      <text class="text-[16px] font-bold" :style="{ color: 'var(--text-color, #2d3748)' }">状态管理与 src/store 模式演示</text>
    </view>
    <!-- 模式与状态展示 -->
    <view
      class="rounded-[12px] p-[16px] mb-[16px] border-[1px] border-solid"
      :style="{ borderColor: 'var(--border-color, #e2e8f0)' }"
    >
      <view class="flex-row justify-between items-center mb-[8px]">
        <text class="text-[14px]" :style="{ color: 'var(--text-secondary, #64748b)' }">Store 实现模式:</text>
        <text class="text-[14px] font-bold" :style="{ color: storeModeColor }">
          {{ storeImplementation }}
        </text>
      </view>

      <view class="flex-row justify-between items-center mb-[8px]">
        <text class="text-[14px]" :style="{ color: 'var(--text-secondary, #64748b)' }">编译运行模式:</text>
        <text class="text-[14px]" :style="{ color: 'var(--text-color, #2d3748)' }">{{ compileMode }}</text>
      </view>

      <text class="text-[12px] leading-normal mt-[10px]" :style="{ color: 'var(--text-secondary, #94a3b8)' }">
        说明：三个 store 统一从门面 @/src/store 导出，编译期按「VUE3-VAPOR || H5 || WEB || MP」条件自动切换「Vapor 官方 Pinia」与「VDOM x-pinia-s」，业务调用写法完全一致；写入的数据会持久化到本地 Storage，重启后仍在。
      </text>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed } from 'vue';
import { useAppStore } from '@/src/store';
import { getCompileMode } from '@/src/utils/env/index.uts';

const appStore = useAppStore();

const storeImplementation = computed((): string => appStore.state.mode == 'vapor' ? 'Vapor 官方 Pinia' : 'VDOM x-pinia-s');
const storeModeColor = computed((): string => appStore.state.mode == 'vapor' ? '#10b981' : '#3b82f6');
const compileMode = computed((): string => getCompileMode());
</script>
