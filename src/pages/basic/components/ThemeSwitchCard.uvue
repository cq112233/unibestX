<template>
  <view
    class="rounded-[16px] p-[20px] m-[16px] border-[1px] border-solid"
    :style="{
      backgroundColor: 'var(--card-bg, #ffffff)',
      borderColor: 'var(--border-color, #edf2f7)'
    }"
  >
    <!-- 标题区域 -->
    <view class="flex flex-row items-center mb-[16px]">
      <view
        class="w-[4px] h-[16px] rounded-[2px] mr-[8px]"
        :style="{ backgroundColor: 'var(--theme-color, #3182ce)' }"
      />
      <text class="text-[16px] font-bold" :style="{ color: 'var(--text-color, #2d3748)' }">主题设置</text>
    </view>
    <!-- 预览区域 -->
    <view
      class="rounded-[12px] p-[16px] mb-[16px] border-[1px] border-solid items-center"
      :style="{ borderColor: 'var(--border-color, #e2e8f0)' }"
    >
      <text
        class="text-[12px] mb-[8px]"
        :style="{ color: 'var(--text-secondary, #94a3b8)' }"
      >
        主题色效果预览
      </text>

      <view
        class="mt-[10px] mx-auto w-[200px] h-[44px] rounded-[8px] flex flex-row items-center justify-center"
        :style="{ backgroundColor: currentTheme }"
      >
        <text class="text-[#ffffff] text-[14px] font-medium">主题按钮</text>
      </view>
    </view>

    <!-- 颜色选择区 -->
    <view class="flex flex-row justify-between py-[10px]">
      <view
        v-for="(item, index) in THEME_COLOR_PRESETS"
        :key="index"
        class="w-[40px] h-[40px] rounded-[20px] items-center justify-center"
        :style="{
          backgroundColor: item,
          borderWidth: currentTheme == item ? '3px' : '0px',
          borderStyle: 'solid',
          borderColor: appStore.state.isDark ? '#ffffff' : '#1e293b'
        }"
        @click="changeTheme(item)"
      >
        <text
          v-if="currentTheme == item"
          class="text-[16px] text-[#ffffff] font-bold"
        >
          ✓
        </text>
      </view>
    </view>

    <!-- 外观模式：跟随系统 / 浅色 / 深色 -->
    <view class="flex flex-row justify-between items-center mt-[10px] pt-[10px]">
      <text
        class="text-[14px]"
        :style="{ color: 'var(--text-color, #2d3748)' }"
      >
        外观模式
      </text>
      <view
        class="flex flex-row rounded-[8px] overflow-hidden"
        :style="{
          borderWidth: '1px',
          borderStyle: 'solid',
          borderColor: 'var(--border-color, #e2e8f0)'
        }"
      >
        <view
          v-for="(item, index) in themeModeOptions"
          :key="index"
          class="px-[14px] py-[8px]"
          :style="{
            backgroundColor: currentMode == item.value ? currentTheme : 'transparent'
          }"
          @click="changeThemeMode(item.value)"
        >
          <text
            class="text-[12px]"
            :style="{
              color: currentMode == item.value ? '#ffffff' : 'var(--text-secondary, #64748b)'
            }"
          >
            {{ item.label }}
          </text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed } from 'vue';
import { useAppStore } from '@/src/store';
import { THEME_COLOR_PRESETS } from '@/src/utils/theme/index.uts';
import { toast } from '@/src/utils/toast/index.uts';

// 外观模式选项：auto（跟随系统）/ light（浅色）/ dark（深色）
type ThemeModeOption = {
  label: string;
  value: string;
};

const appStore = useAppStore();

const currentTheme = computed((): string => appStore.state.theme);
const currentMode = computed((): string => appStore.state.themeMode);

const themeModeOptions: ThemeModeOption[] = [
  { label: '跟随系统', value: 'auto' },
  { label: '浅色', value: 'light' },
  { label: '深色', value: 'dark' }
];

function changeTheme(color: string) {
  appStore.setTheme(color);
  toast('主题色切换成功');
}

function changeThemeMode(value: string) {
  appStore.setThemeMode(value);
  toast('外观模式切换成功');
}
</script>
