<template>
  <view
    class="rounded-[16px] p-[20px] m-[16px] border-[1px] border-solid"
    :style="{
      backgroundColor: 'var(--card-bg, #ffffff)',
      borderColor: 'var(--border-color, #edf2f7)'
    }"
  >
    <!-- 标题区域 -->
    <view class="flex flex-row items-center mb-[16px]">
      <view
        class="w-[4px] h-[16px] rounded-[2px] mr-[8px]"
        :style="{ backgroundColor: 'var(--theme-color, #3182ce)' }"
      />
      <text class="text-[16px] font-bold" :style="{ color: 'var(--text-color, #2d3748)' }">{{ iconDemoTitle }}</text>
    </view>
    <!-- uni-icon 示例 -->
    <view class="flex-row items-center justify-between py-[12px]">
      <view class="flex-row items-center">
        <view class="w-[6px] h-[6px] rounded-[3px] bg-[#3b82f6] mr-[8px]" />
        <text
          class="text-[14px] font-medium"
          :style="{ color: 'var(--text-color, #475569)' }"
        >
          uni-icon
        </text>
      </view>
      <view class="flex-row items-center">
        <uni-icons type="contact" size="26" style="color: #3b82f6; margin-right: 8px;" />
        <text class="text-[12px]" :style="{ color: 'var(--text-secondary, #94a3b8)' }">contact</text>
      </view>
    </view>

    <view class="h-[1px]" :style="{ backgroundColor: 'var(--border-color, #f1f5f9)' }" />

    <!-- lime-icon 示例 -->
    <view class="flex-row items-center justify-between py-[12px]">
      <view class="flex-row items-center">
        <view class="w-[6px] h-[6px] rounded-[3px] bg-[#10b981] mr-[8px]" />
        <view class="flex-col">
          <text
            class="text-[14px] font-medium"
            :style="{ color: 'var(--text-color, #475569)' }"
          >
            lime-icon
          </text>
          <view class="bg-[#fff1f2] rounded-[4px] py-[2px] px-[6px] mt-[4px] self-start border-[1px] border-solid border-[#ffe4e6]">
            <text class="text-[10px] text-[#f43f5e]">{{ svgAuthWarning }}</text>
          </view>
        </view>
      </view>
      <view class="flex-row items-center">
        <l-icon name="circle" size="24" style="color: #10b981; margin-right: 8px;" />
        <text class="text-[12px]" :style="{ color: 'var(--text-secondary, #94a3b8)' }">circle</text>
      </view>
    </view>

    <view class="h-[1px]" :style="{ backgroundColor: 'var(--border-color, #f1f5f9)' }" />

    <!-- 阿里 iconfont 示例（图标库/链接见插件根目录的 iconfont.config.mjs）
         图标统一交给 AliIconfontIcon：Web / 小程序端走字体渲染，
         App 端同一套图标改用 web-view 渲染本地演示页。 -->
    <view class="flex-row items-center justify-between py-[12px]">
      <view class="flex-row items-center">
        <view class="w-[6px] h-[6px] rounded-[3px] bg-[#f59e0b] mr-[8px]" />
        <text
          class="text-[14px] font-medium"
          :style="{ color: 'var(--text-color, #475569)' }"
        >
          {{ alibabaIconfontLabel }}
        </text>
      </view>
      <view class="flex-row items-center">
        <view class="mr-[8px]">
          <AliIconfontIcon name="gear" :size="24" color="#f59e0b" :theme="iconTheme" />
        </view>
        <text class="text-[12px]" :style="{ color: 'var(--text-secondary, #94a3b8)' }">ali:gear</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed } from 'vue';
import { $t } from '@/src/utils/i18n/index.uts';
import { useAppStore } from '@/src/store';
import AliIconfontIcon from '@/uni_modules/ali-iconfont/components/AliIconfontIcon/AliIconfontIcon.uvue';

const iconDemoTitle = computed((): string => $t('basic.iconDemoTitle'));
const svgAuthWarning = computed((): string => $t('basic.svgAuthWarning'));
const alibabaIconfontLabel = computed((): string => $t('basic.alibabaIconfontLabel'));

/**
 * 阿里图标在 App 端由 web-view 渲染，web-view 读不到宿主的 CSS 变量，
 * 深浅色只能显式传进去 —— 组件刻意不引 store（否则插件没法整体复用），
 * 所以由调用方（这里）自己读当前主题。
 */
const appStore = useAppStore();
const iconTheme = computed((): string => appStore.state.isDark ? 'dark' : 'light');
</script>
