<template>
  <Card title="weapp-tailwindcss Demo">
    <view class="flex-col mb-[16px]">
      <text
        class="text-[13px] leading-[18px] mb-[12px]"
        :style="{ color: 'var(--text-secondary, #64748b)' }"
      >
        项目已接入 Tailwind CSS v4 + weapp-tailwindcss，支持方括号任意值（如 text-[14px]、mt-[12px]）、dark:
        暗黑变体与多端平台变体，一套类名全端生效，写法与 Web 端完全一致。
      </text>

      <!-- 官网网址提示 -->
      <view
        class="flex-row items-center p-[8px] rounded-[6px] mb-[12px] border-[1px] border-solid"
        :style="{ backgroundColor: 'var(--card-bg, #f1f5f9)', borderColor: 'var(--border-color, #e2e8f0)' }"
        @click="copyWebsiteUrl"
      >
        <text
          class="text-[12px] font-medium mr-[4px]"
          :style="{ color: 'var(--text-color, #475569)' }"
        >
          官网：
        </text>
        <text class="text-[12px] text-[#2563eb] underline flex-1">https://tw.icebreaker.top/zh-cn/</text>
        <text class="text-[11px]" :style="{ color: 'var(--text-secondary, #94a3b8)' }">点击复制</text>
      </view>

      <!-- 特性标签 -->
      <view class="flex-row items-center flex-wrap">
        <view class="mr-[6px] mb-[4px] px-[10px] py-[3px] rounded-[20px] bg-[#e0edff] border-[1px] border-solid border-[#bfdbfe]">
          <text class="text-[11px] text-[#2563eb] font-medium">Tailwind CSS v4</text>
        </view>
        <view class="mr-[6px] mb-[4px] px-[10px] py-[3px] rounded-[20px] bg-[#d1fae5] border-[1px] border-solid border-[#a7f3d0]">
          <text class="text-[11px] text-[#059669] font-medium">方括号任意值</text>
        </view>
        <view class="mb-[4px] px-[10px] py-[3px] rounded-[20px] bg-[#fef3c7] border-[1px] border-solid border-[#fde68a]">
          <text class="text-[11px] text-[#d97706] font-medium">dark: 暗黑变体</text>
        </view>
      </view>
    </view>

    <!-- 进入演示页面按钮 -->
    <view
      class="w-full h-[44px] rounded-[8px] flex flex-row items-center justify-center"
      :style="{ backgroundColor: 'var(--theme-color, #3b82f6)' }"
      @click="navigateToDemo"
    >
      <text class="text-[#ffffff] text-[14px] font-bold">进入 weapp-tailwindcss 示例</text>
    </view>
  </Card>
</template>

<script setup lang="uts">
import Card from './Card.uvue';
import { toast } from '@/src/utils/toast.uts';

function copyWebsiteUrl() {
  uni.setClipboardData({
    data: 'https://tw.icebreaker.top/zh-cn/',
    success: () => {
      toast('官网网址已复制到剪贴板');
    }
  });
}

function navigateToDemo() {
  uni.navigateTo({
    url: '/src/sub/tailwindcss/tailwindcss',
    fail: (err) => {
      console.error('navigateToDemo fail:', err);
    }
  });
}
</script>
