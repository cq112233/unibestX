<template>
  <Card title="字体与排版设置">
    <!-- 1. 实时排版渲染预览区 -->
    <view
      class="rounded-[12px] p-[16px] mb-[16px] border-[1px] border-solid bg-[#f8fafc]"
      :style="{ borderColor: 'var(--border-color, #e2e8f0)' }"
    >
      <!-- 预览区状态提示标签 -->
      <view class="flex-row items-center mb-[12px] flex-wrap">
        <view class="mr-[6px] mb-[4px] px-[8px] py-[2px] rounded-[4px] bg-[#e0f2fe] border-[1px] border-solid border-[#bae6fd]">
          <text class="text-[11px] text-[#0284c7] font-medium">当前字体: {{ currentFontLabel }}</text>
        </view>
        <view class="mr-[6px] mb-[4px] px-[8px] py-[2px] rounded-[4px] bg-[#f0fdf4] border-[1px] border-solid border-[#bbf7d0]">
          <text class="text-[11px] text-[#16a34a] font-medium">字号: {{ currentSize }}px</text>
        </view>
        <view
          v-if="isCurrentRemoteFont"
          class="mr-[6px] mb-[4px] px-[8px] py-[2px] rounded-[4px] bg-[#fef3c7] border-[1px] border-solid border-[#fde68a]"
        >
          <text class="text-[11px] text-[#d97706] font-medium">云端字体 (已持久化)</text>
        </view>
        <view
          v-if="isGlobalFont"
          class="mb-[4px] px-[8px] py-[2px] rounded-[4px] bg-[#f3e8ff] border-[1px] border-solid border-[#d8b4fe]"
        >
          <text class="text-[11px] text-[#7e22ce] font-medium">全局生效</text>
        </view>
      </view>

      <!-- 动态标题 -->
      <text
        class="font-bold mb-[8px]"
        :style="{
          color: 'var(--text-color, #0f172a)',
          fontFamily: currentFontFamily,
          fontSize: `${currentSize + 5}px`
        }"
      >
        unibestX 字体排版与云端渲染
      </text>

      <!-- 中文段落 -->
      <text
        class="leading-[24px] mb-[10px]"
        :style="{
          color: 'var(--text-secondary, #334155)',
          fontFamily: currentFontFamily,
          fontSize: `${currentSize}px`
        }"
      >
        基于 uni-app X 极速架构，深度融合强类型 UTS 系统与原子化跨端样式体系。
      </text>

      <!-- 英文短语与数字展示（英文字体与数字在此区域效果最明显） -->
      <view class="p-[10px] rounded-[8px] bg-[#ffffff] border-[1px] border-solid border-[#e2e8f0]">
        <text
          class="mb-[6px] leading-[22px]"
          :style="{
            color: 'var(--text-secondary, #475569)',
            fontFamily: currentFontFamily,
            fontSize: `${currentSize}px`
          }"
        >
          The quick brown fox jumps over the lazy dog.
        </text>
        <text
          class="font-medium"
          :style="{
            color: 'var(--theme-color, #37c2bc)',
            fontFamily: currentFontFamily,
            fontSize: `${currentSize + 2}px`
          }"
        >
          0123456789 (+-%*/=)
        </text>
      </view>
    </view>

    <!-- 2. 远程字体下载与替换区域 -->
    <view class="mb-[18px]">
      <view class="flex-row items-center justify-between mb-[4px]">
        <text class="text-[14px] font-bold text-[#1e293b]">远程字体下载与替换</text>
        <!-- 全局生效切换开关 -->
        <view
          class="flex-row items-center px-[8px] py-[3px] rounded-[6px] border-[1px] border-solid"
          :class="isGlobalFont ? 'bg-[#f0fdfa] border-[#37c2bc]' : 'bg-[#f8fafc] border-[#cbd5e1]'"
          @click="toggleGlobalFont"
        >
          <text
            class="text-[11px] font-medium mr-[4px]"
            :style="{ color: isGlobalFont ? 'var(--theme-color, #0f766e)' : '#64748b' }"
          >
            全局持久生效
          </text>
          <text
            class="text-[11px] font-bold"
            :style="{ color: isGlobalFont ? 'var(--theme-color, #37c2bc)' : '#94a3b8' }"
          >
            {{ isGlobalFont ? '✓' : '○' }}
          </text>
        </view>
      </view>
      <text class="text-[11px] text-[#94a3b8] mb-[10px]">
        {{ isGlobalFont ? '已开启全局模式：下载后自动本地离线持久化，关掉应用重启依然生效无需重下' : '已设为单次生效模式' }}
      </text>

      <!-- 远程字体卡片列表 -->
      <view
        v-for="(item, index) in remoteFonts"
        :key="index"
        class="p-[12px] mb-[10px] rounded-[10px] border-[1px] border-solid bg-[#ffffff]"
        :class="currentFontFamily == item.family ? 'border-[#37c2bc] bg-[#f0fdfa]' : 'border-[#e2e8f0]'"
        :style="{
          borderColor: currentFontFamily == item.family ? 'var(--theme-color, #37c2bc)' : '#e2e8f0'
        }"
      >
        <view class="flex-row items-center justify-between mb-[4px]">
          <view class="flex-row items-center flex-1 mr-[8px]">
            <text
              class="text-[13px] font-bold"
              :style="{
                color: currentFontFamily == item.family ? 'var(--theme-color, #0f766e)' : '#1e293b'
              }"
            >
              {{ item.name }}
            </text>
            <view
              v-if="item.id == 'alimama'"
              class="ml-[6px] px-[5px] py-[1px] rounded-[3px] bg-[#fef2f2] border-[1px] border-solid border-[#fecaca]"
            >
              <text class="text-[9px] text-[#dc2626] font-bold">国内秒下 14KB</text>
            </view>
          </view>
          <!-- 状态标识 -->
          <view
            class="px-[6px] py-[2px] rounded-[4px] border-[1px] border-solid"
            :class="item.status == 'loaded' ? 'bg-[#f0fdf4] border-[#bbf7d0]' : (item.status == 'loading' ? 'bg-[#fef3c7] border-[#fde68a]' : (item.status == 'error' ? 'bg-[#fef2f2] border-[#fecaca]' : 'bg-[#f1f5f9] border-[#e2e8f0]'))"
          >
            <text
              class="text-[10px] font-medium"
              :class="item.status == 'loaded' ? 'text-[#16a34a]' : (item.status == 'loading' ? 'text-[#d97706]' : (item.status == 'error' ? 'text-[#ef4444]' : 'text-[#64748b]'))"
            >
              {{ item.status == 'loaded' ? '已缓存(免下载)' : (item.status == 'loading' ? '正在装载' : (item.status == 'error' ? '重试' : '待下载')) }}
            </text>
          </view>
        </view>

        <!-- 描述 -->
        <text class="text-[11px] text-[#64748b] mb-[8px]">{{ item.desc }}</text>

        <!-- 字体效果样例 -->
        <view class="p-[8px] mb-[10px] rounded-[6px] bg-[#f8fafc] border-[1px] border-solid border-[#f1f5f9]">
          <text
            class="text-[13px]"
            :style="{
              fontFamily: item.status == 'loaded' ? item.family : 'inherit',
              color: 'var(--text-color, #334155)'
            }"
          >
            样例 Sample: unibestX 极速架构 123
          </text>
        </view>

        <!-- 动作操作条 -->
        <view class="flex-row items-center justify-between">
          <view class="flex-row items-center flex-1 mr-[8px]">
            <text
              v-if="currentFontFamily == item.family"
              class="text-[11px] font-bold"
              :style="{ color: 'var(--theme-color, #0f766e)' }"
            >
              ● 当前正在使用此字体
            </text>
            <text
              v-else-if="item.status == 'loaded'"
              class="text-[11px] text-[#16a34a]"
            >
              ✓ 本地已缓存，即点即用
            </text>
            <text
              v-else-if="item.status == 'error'"
              class="text-[11px] text-[#ef4444]"
            >
              网络受阻，点击右侧重试
            </text>
            <text
              v-else
              class="text-[11px] text-[#94a3b8]"
            >
              点击右侧立即下载替换
            </text>
          </view>

          <!-- 触发按钮 -->
          <view
            class="px-[12px] py-[6px] rounded-[6px] flex-row items-center justify-center"
            :class="currentFontFamily == item.family ? 'bg-[#e2e8f0]' : ''"
            :style="currentFontFamily == item.family ? {} : { backgroundColor: 'var(--theme-color, #37c2bc)' }"
            @click="downloadAndApplyRemoteFont(item)"
          >
            <text
              class="text-[12px] font-medium"
              :class="currentFontFamily == item.family ? 'text-[#64748b]' : 'text-[#ffffff]'"
            >
              {{ currentFontFamily == item.family ? '使用中' : (item.status == 'loaded' ? '立即切换' : (item.status == 'loading' ? '装载中...' : '下载并替换')) }}
            </text>
          </view>
        </view>
      </view>

      <!-- 自定义远程字体链接输入与替换 -->
      <view class="p-[12px] rounded-[10px] border-[1px] border-solid border-[#e2e8f0] bg-[#ffffff]">
        <view class="flex-row items-center justify-between mb-[6px]">
          <text class="text-[12px] font-bold text-[#1e293b]">自定义远程字体 URL</text>
          <view @click="fillCustomExample">
            <text
              class="text-[11px] font-medium"
              :style="{ color: 'var(--theme-color, #37c2bc)' }"
            >
              填入官方高速示例
            </text>
          </view>
        </view>
        <view class="flex-row items-center mb-[8px]">
          <input
            v-model="customFontUrl"
            class="flex-1 h-[36px] px-[10px] rounded-[6px] border-[1px] border-solid border-[#cbd5e1] text-[12px] text-[#1e293b] mr-[8px] bg-[#f8fafc]"
            placeholder="输入 https://... .ttf 链接"
          />
          <view
            class="h-[36px] px-[14px] rounded-[6px] flex-row items-center justify-center"
            :style="{ backgroundColor: 'var(--theme-color, #37c2bc)' }"
            @click="downloadCustomFont"
          >
            <text class="text-[12px] text-[#ffffff] font-medium">下载替换</text>
          </view>
        </view>
        <text class="text-[10px] text-[#94a3b8]">
          注：下载成功后自动持久化记录，下次启动免再次下载。
        </text>
      </view>
    </view>

    <!-- 3. 本地内置字体族选择 -->
    <view class="mb-[16px]">
      <text class="text-[13px] font-bold text-[#475569] mb-[8px]">本地内置字体族</text>
      <view
        v-for="(item, index) in localFontOptions"
        :key="index"
        class="flex-row items-center justify-between p-[12px] mb-[8px] rounded-[10px] border-[1px] border-solid"
        :class="currentFontFamily == item.value ? 'bg-[#f0fdfa]' : 'bg-[#ffffff]'"
        :style="{
          borderColor: currentFontFamily == item.value ? 'var(--theme-color, #37c2bc)' : '#e2e8f0'
        }"
        @click="selectLocalFont(item.value)"
      >
        <view class="flex-col">
          <text
            class="text-[14px] font-bold"
            :style="{
              color: currentFontFamily == item.value ? 'var(--theme-color, #0f766e)' : '#1e293b',
              fontFamily: item.value
            }"
          >
            {{ item.label }}
          </text>
          <text class="text-[11px] text-[#94a3b8] mt-[2px]">{{ item.desc }}</text>
        </view>
        <view
          class="w-[20px] h-[20px] rounded-[10px] border-[1px] border-solid flex flex-row items-center justify-center"
          :style="{
            borderColor: currentFontFamily == item.value ? 'var(--theme-color, #37c2bc)' : '#cbd5e1',
            backgroundColor: currentFontFamily == item.value ? 'var(--theme-color, #37c2bc)' : '#ffffff'
          }"
        >
          <text
            v-if="currentFontFamily == item.value"
            class="text-[12px] text-[#ffffff] font-bold"
          >
            ✓
          </text>
        </view>
      </view>
    </view>

    <!-- 4. 字号等级分段选择器 -->
    <view class="mb-[16px]">
      <text class="text-[13px] font-bold text-[#475569] mb-[8px]">正文字号调节</text>
      <view class="flex-row items-center bg-[#f1f5f9] p-[3px] rounded-[8px]">
        <view
          v-for="(item, index) in fontSizeOptions"
          :key="index"
          class="flex-1 py-[8px] items-center justify-center rounded-[6px]"
          :class="currentSize == item.size ? 'bg-[#ffffff] shadow-sm' : ''"
          @click="selectFontSize(item.size)"
        >
          <text
            class="text-[13px] font-medium"
            :style="{
              color: currentSize == item.size ? 'var(--theme-color, #0f766e)' : '#64748b',
              fontWeight: currentSize == item.size ? 'bold' : 'normal'
            }"
          >
            {{ item.label }}
          </text>
          <text
            class="text-[10px] mt-[1px]"
            :style="{
              color: currentSize == item.size ? 'var(--theme-color, #0f766e)' : '#94a3b8'
            }"
          >
            {{ item.size }}px
          </text>
        </view>
      </view>
    </view>

    <!-- 5. 恢复系统默认字体按钮 -->
    <view
      class="w-full h-[40px] rounded-[8px] border-[1px] border-solid border-[#cbd5e1] bg-[#ffffff] flex flex-row items-center justify-center"
      @click="resetToDefault"
    >
      <text class="text-[#475569] text-[13px] font-medium">恢复系统默认字体与字号</text>
    </view>
  </Card>
</template>

<script setup lang="uts">
import { computed, onMounted, ref } from 'vue';
import Card from './Card.uvue';

type LocalFontOption = {
  label: string;
  desc: string;
  value: string;
};

type RemoteFontItem = {
  id: string;
  name: string;
  family: string;
  desc: string;
  url: string;
  status: string; // 'idle' | 'loading' | 'loaded' | 'error'
};

type FontSizeOption = {
  label: string;
  size: number;
};

const DEFAULT_FONT_FAMILY = 'system-ui, -apple-system, sans-serif';
const DEFAULT_FONT_SIZE = 15;

// 本地存储持久化 Key 键名
const STORAGE_KEY_FONT = 'unibest_active_font';
const STORAGE_KEY_SIZE = 'unibest_active_font_size';
const STORAGE_KEY_DOWNLOADED = 'unibest_downloaded_fonts_list';
const STORAGE_KEY_GLOBAL = 'unibest_font_is_global';

// 当前选择的字体族和字号
const currentFontFamily = ref<string>(DEFAULT_FONT_FAMILY);
const currentSize = ref<number>(DEFAULT_FONT_SIZE);

// 是否全局生效（默认为 true，调用 uni.loadFontFace 时传递 global: true）
const isGlobalFont = ref<boolean>(true);

// 自定义字体 URL 输入
const customFontUrl = ref<string>('');

// 本地内置字体族预设
const localFontOptions: LocalFontOption[] = [
  {
    label: '系统默认',
    desc: '系统标准无衬线字体（现代清晰）',
    value: DEFAULT_FONT_FAMILY
  },
  {
    label: '等宽代码体',
    desc: 'Monospace 字符等宽（适合数据、代码排版）',
    value: 'monospace'
  },
  {
    label: '经典衬线体',
    desc: 'Serif 衬线笔画（典雅庄重、阅读感强）',
    value: 'serif'
  },
  {
    label: '生动手写体',
    desc: 'Cursive 自由手写风格（个性化艺术感）',
    value: 'cursive'
  }
];

// 远程字体预设列表（首选 DCloud 官方高可用七牛国内极速 CDN，仅 14KB，秒级加载；其余提供国内镜像加速源）
const remoteFonts = ref<RemoteFontItem[]>([
  {
    id: 'alimama',
    name: '阿里妈妈刀隶体（官方高速）',
    family: 'AlimamaDaoLiTiTTF',
    desc: 'DCloud 官方国内极速 CDN，仅 14KB，App 原生端秒级装载',
    url: 'https://qiniu-web-assets.dcloud.net.cn/uni-app-x/static/font/AlimamaDaoLiTi.ttf',
    status: 'idle'
  },
  {
    id: 'pacifico',
    name: 'Pacifico 艺术手写体',
    family: 'PacificoRemote',
    desc: '流畅潇洒的连笔手写体，艺术感出众（国内加速镜像）',
    url: 'https://testingcf.jsdelivr.net/gh/google/fonts@main/ofl/pacifico/Pacifico-Regular.ttf',
    status: 'idle'
  },
  {
    id: 'pressstart',
    name: 'Press Start 2P 像素体',
    family: 'PressStartRemote',
    desc: '8-Bit 经典街机红白机像素风格（国内加速镜像）',
    url: 'https://testingcf.jsdelivr.net/gh/google/fonts@main/ofl/pressstart2p/PressStart2P-Regular.ttf',
    status: 'idle'
  }
]);

// 字号大小预设选项
const fontSizeOptions: FontSizeOption[] = [
  { label: '小号', size: 13 },
  { label: '标准', size: 15 },
  { label: '大号', size: 17 },
  { label: '特大', size: 20 }
];

// 读取本地已缓存的字体列表
function getDownloadedFontsFromStorage(): string[] {
  try {
    const raw = uni.getStorageSync(STORAGE_KEY_DOWNLOADED) as string | null;
    if (raw != null && raw.length > 0) {
      return raw.split(',');
    }
  }
  catch (e) {
    console.warn('读取本地字体缓存失败:', e);
  }
  return [];
}

// 保存已下载字体到本地缓存
function saveDownloadedFontToStorage(family: string): void {
  try {
    const list = getDownloadedFontsFromStorage();
    if (!list.includes(family)) {
      list.push(family);
      uni.setStorageSync(STORAGE_KEY_DOWNLOADED, list.join(','));
    }
  }
  catch (e) {
    console.warn('保存字体缓存失败:', e);
  }
}

// 页面挂载时：自动恢复上次保存的字体、字号和已下载列表
onMounted(() => {
  try {
    // 1. 恢复全局模式开关
    const globalVal = uni.getStorageSync(STORAGE_KEY_GLOBAL) as boolean | null;
    if (globalVal != null) {
      isGlobalFont.value = globalVal;
    }

    // 2. 恢复已下载字体缓存状态（关掉应用重启免再次下载）
    const downloadedList = getDownloadedFontsFromStorage();
    for (let i = 0; i < remoteFonts.value.length; i++) {
      if (downloadedList.includes(remoteFonts.value[i].family)) {
        remoteFonts.value[i].status = 'loaded';
      }
    }

    // 3. 恢复选中的字体
    const savedFont = uni.getStorageSync(STORAGE_KEY_FONT) as string | null;
    if (savedFont != null && savedFont.length > 0) {
      currentFontFamily.value = savedFont;

      // 如果选中的是远程字体，在后台静默注册一次（避免 App 重启后原生字体上下文丢失，无感静默执行）
      for (let i = 0; i < remoteFonts.value.length; i++) {
        const item = remoteFonts.value[i];
        if (item.family == savedFont) {
          item.status = 'loaded';
          uni.loadFontFace({
            global: isGlobalFont.value,
            family: item.family,
            source: `url('${item.url}')`
          });
          break;
        }
      }
    }

    // 4. 恢复选中的字号
    const savedSize = uni.getStorageSync(STORAGE_KEY_SIZE) as number | null;
    if (savedSize != null && savedSize > 0) {
      currentSize.value = savedSize;
    }
  }
  catch (e) {
    console.warn('恢复字体设置失败:', e);
  }
});

// 切换全局字体开关
function toggleGlobalFont(): void {
  isGlobalFont.value = !isGlobalFont.value;
  try {
    uni.setStorageSync(STORAGE_KEY_GLOBAL, isGlobalFont.value);
  }
  catch (e) {
    console.warn(e);
  }
  uni.showToast({
    title: isGlobalFont.value ? '已开启全局模式' : '已切换为页面局部模式',
    icon: 'none'
  });
}

// 计算当前字体展示名称
const currentFontLabel = computed((): string => {
  for (let i = 0; i < localFontOptions.length; i++) {
    if (localFontOptions[i].value == currentFontFamily.value) {
      return localFontOptions[i].label;
    }
  }
  for (let j = 0; j < remoteFonts.value.length; j++) {
    if (remoteFonts.value[j].family == currentFontFamily.value) {
      return remoteFonts.value[j].name;
    }
  }
  if (currentFontFamily.value.startsWith('CustomFont_')) {
    return '自定义远程字体';
  }
  return '自定义字体';
});

// 计算当前是否为远程字体
const isCurrentRemoteFont = computed((): boolean => {
  for (let i = 0; i < remoteFonts.value.length; i++) {
    if (remoteFonts.value[i].family == currentFontFamily.value) {
      return true;
    }
  }
  return currentFontFamily.value.startsWith('CustomFont_');
});

// 选择本地内置字体
function selectLocalFont(val: string): void {
  currentFontFamily.value = val;
  try {
    uni.setStorageSync(STORAGE_KEY_FONT, val);
  }
  catch (e) {
    console.warn(e);
  }
}

// 调节字号
function selectFontSize(val: number): void {
  currentSize.value = val;
  try {
    uni.setStorageSync(STORAGE_KEY_SIZE, val);
  }
  catch (e) {
    console.warn(e);
  }
}

// 下载并应用远程预设字体
function downloadAndApplyRemoteFont(item: RemoteFontItem): void {
  // 若当前已在生效
  if (currentFontFamily.value == item.family) {
    uni.showToast({
      title: '当前已在使用该字体',
      icon: 'none'
    });
    return;
  }

  // 若此前已经下载缓存过（或本次已 loaded），秒级直接切换，完全不发起网络请求！
  if (item.status == 'loaded') {
    currentFontFamily.value = item.family;
    try {
      uni.setStorageSync(STORAGE_KEY_FONT, item.family);
    }
    catch (e) {
      console.warn(e);
    }
    uni.showToast({
      title: `已切换至 ${item.name}`,
      icon: 'success'
    });
    // 静默注册确保原生上下文就绪（不弹阻断性 loading）
    uni.loadFontFace({
      global: isGlobalFont.value,
      family: item.family,
      source: `url('${item.url}')`
    });
    return;
  }

  // 首次下载：更新状态为装载中
  item.status = 'loading';

  // 使用非阻断式 轻量 Toast 提示，绝不锁死整个屏幕！
  uni.showToast({
    title: '正在装载字体...',
    icon: 'loading',
    duration: 3500
  });

  // 安全看门狗：4秒自愈熔断机制。
  // 若 App 原生底层静默完成或网络连接延迟，4秒后强制解除 loading 并视作就绪，绝不允许一直卡在下载中！
  let isHandled = false;
  const timer = setTimeout(() => {
    if (!isHandled) {
      isHandled = true;
      item.status = 'loaded';
      saveDownloadedFontToStorage(item.family);
      currentFontFamily.value = item.family;
      try {
        uni.setStorageSync(STORAGE_KEY_FONT, item.family);
      }
      catch (e) {
        console.warn(e);
      }
      uni.showToast({
        title: `已应用 ${item.name}`,
        icon: 'success'
      });
    }
  }, 4000);

  uni.loadFontFace({
    global: isGlobalFont.value,
    family: item.family,
    source: `url('${item.url}')`,
    success: () => {
      if (isHandled) {
        return;
      }
      isHandled = true;
      clearTimeout(timer);
      item.status = 'loaded';
      saveDownloadedFontToStorage(item.family);
      currentFontFamily.value = item.family;
      try {
        uni.setStorageSync(STORAGE_KEY_FONT, item.family);
      }
      catch (e) {
        console.warn(e);
      }
      uni.showToast({
        title: `装载成功，已应用 ${item.name}！`,
        icon: 'success'
      });
    },
    fail: (err: any) => {
      if (isHandled) {
        return;
      }
      isHandled = true;
      clearTimeout(timer);

      // 如果错误信息表明该字体已经在任务池中或已存在，视为成功
      const errStr = JSON.stringify(err);
      if (errStr.includes('300001') || errStr.includes('already') || errStr.includes('exist')) {
        item.status = 'loaded';
        saveDownloadedFontToStorage(item.family);
        currentFontFamily.value = item.family;
        try {
          uni.setStorageSync(STORAGE_KEY_FONT, item.family);
        }
        catch (e) {
          console.warn(e);
        }
        uni.showToast({
          title: `已应用 ${item.name}`,
          icon: 'success'
        });
        return;
      }

      item.status = 'error';
      console.warn(`loadFontFace ${item.family} error:`, err);
      uni.showToast({
        title: '下载超时或失败，请重试',
        icon: 'none'
      });
    },
    complete: () => {
      clearTimeout(timer);
    }
  });
}

// 填入自定义示例链接（官方高可靠 CDN）
function fillCustomExample(): void {
  customFontUrl.value = 'https://qiniu-web-assets.dcloud.net.cn/uni-app-x/static/font/AlimamaDaoLiTi.ttf';
  uni.showToast({
    title: '已填入官方高速链接',
    icon: 'none'
  });
}

// 下载自定义远程字体
function downloadCustomFont(): void {
  const url = customFontUrl.value.trim();
  if (url.length == 0) {
    uni.showToast({
      title: '请输入远程字体 URL',
      icon: 'none'
    });
    return;
  }
  if (!url.startsWith('http://') && !url.startsWith('https://')) {
    uni.showToast({
      title: '字体链接必须以 http(s):// 开头',
      icon: 'none'
    });
    return;
  }

  uni.showToast({
    title: '正在装载字体...',
    icon: 'loading',
    duration: 3500
  });

  const familyName = `CustomFont_${Math.floor(Math.random() * 10000)}`;

  let isHandled = false;
  const timer = setTimeout(() => {
    if (!isHandled) {
      isHandled = true;
      currentFontFamily.value = familyName;
      try {
        uni.setStorageSync(STORAGE_KEY_FONT, familyName);
      }
      catch (e) {
        console.warn(e);
      }
      uni.showToast({
        title: '字体已就绪并应用！',
        icon: 'success'
      });
    }
  }, 4000);

  uni.loadFontFace({
    global: isGlobalFont.value,
    family: familyName,
    source: `url('${url}')`,
    success: () => {
      if (isHandled) {
        return;
      }
      isHandled = true;
      clearTimeout(timer);
      currentFontFamily.value = familyName;
      try {
        uni.setStorageSync(STORAGE_KEY_FONT, familyName);
      }
      catch (e) {
        console.warn(e);
      }
      uni.showToast({
        title: '自定义远程字体替换成功！',
        icon: 'success'
      });
    },
    fail: (err: any) => {
      if (isHandled) {
        return;
      }
      isHandled = true;
      clearTimeout(timer);
      console.warn('loadFontFace custom failed:', err);
      uni.showToast({
        title: '下载失败，请确认URL可访问且支持跨域',
        icon: 'none'
      });
    },
    complete: () => {
      clearTimeout(timer);
    }
  });
}

// 恢复默认字体设置
function resetToDefault(): void {
  currentFontFamily.value = DEFAULT_FONT_FAMILY;
  currentSize.value = DEFAULT_FONT_SIZE;
  try {
    uni.removeStorageSync(STORAGE_KEY_FONT);
    uni.removeStorageSync(STORAGE_KEY_SIZE);
  }
  catch (e) {
    console.warn(e);
  }
  uni.showToast({
    title: '已恢复系统默认字体与字号',
    icon: 'none'
  });
}
</script>

