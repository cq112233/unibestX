    >
      <text class="text-[#ffffff] text-[14px] font-bold">进入布局页面骨架实测</text>
    </view>
  </Card>
</template>

<script setup lang="uts">
import Card from './Card.uvue';
import {
  availableHeight,
  NAVBAR_CONTENT_HEIGHT,
  safeAreaBottom,
  statusBarHeight,
  windowHeight,
  windowWidth
} from '@/src/utils/systemInfo.uts';

function navigateToDemo() {
  uni.navigateTo({
