<template>
  <Card :title="langTitle">
    <!-- 当前语言预览 -->
    <view class="rounded-[12px] p-[16px] mb-[16px] border-[1px] border-solid border-[#e2e8f0]">
      <text class="text-[12px] text-[#94a3b8] mb-[6px]">{{ langPreview }}</text>

      <text class="text-[16px] font-bold text-[#1e293b]">
        {{ welcomeText }}
      </text>

      <text class="text-[14px] text-[#475569] mt-[8px]">
        {{ helloText }}
      </text>
    </view>

    <!-- 选项列表 -->
    <!-- 简体中文 -->
    <view class="flex-row items-center justify-between py-[12px]" @click="switchLanguage('zh-CN')">
      <view class="flex-row items-center">
        <text class="text-[15px] text-[#334155] font-medium">简体中文</text>
      </view>
      <view class="flex-row items-center">
        <uni-icons v-if="isZhCN" type="checkmarkempty" size="20" style="color: #3b82f6;" />
      </view>
    </view>

    <view class="h-[1px] bg-[#f1f5f9]" />

    <!-- English -->
    <view class="flex-row items-center justify-between py-[12px]" @click="switchLanguage('en-US')">
      <view class="flex-row items-center">
        <text class="text-[15px] text-[#334155] font-medium">English</text>
      </view>
      <view class="flex-row items-center">
        <uni-icons v-if="isEnUS" type="checkmarkempty" size="20" style="color: #3b82f6;" />
      </view>
    </view>
  </Card>
</template>

<script setup lang="uts">
import Card from './Card.uvue';
import { computed } from 'vue';
import { useAppStore } from '@/src/store/index.uts';
import { $t, setTabbarItem } from '@/src/utils/i18n';

const appStore = useAppStore();

const langTitle = computed((): string => $t('basic.langTitle'));
const langPreview = computed((): string => $t('basic.langPreview'));
const welcomeText = computed((): string => $t('message.welcome'));
const helloText = computed((): string => $t('message.hello', { msg: 'hi' }));

// 使用 computed 响应式获取当前 i18n 对象的语言环境
const currentLocale = computed((): string => {
  return appStore.state.locale;
});

const isZhCN = computed((): boolean => {
  return currentLocale.value == 'zh-CN';
});

const isEnUS = computed((): boolean => {
  return currentLocale.value == 'en-US';
});

function switchLanguage(lang: string) {
  appStore.setLocale(lang);
  setTabbarItem();

  uni.showToast({
    title: $t('message.switch_success'),
    icon: 'none',
    duration: 1500
  });
}
</script>

<style>
</style>
