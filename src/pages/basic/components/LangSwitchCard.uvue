<template>
  <Card :title="langTitle">
    <!-- 当前语言预览 -->
    <view
      class="rounded-[12px] p-[16px] mb-[16px] border-[1px] border-solid"
      :style="{ borderColor: 'var(--border-color, #e2e8f0)' }"
    >
      <text
        class="text-[12px] mb-[6px]"
        :style="{ color: 'var(--text-secondary, #94a3b8)' }"
      >
        {{ langPreview }}
      </text>

      <text
        class="text-[16px] font-bold"
        :style="{ color: 'var(--text-color, #1e293b)' }"
      >
        {{ welcomeText }}
      </text>

      <text
        class="text-[14px] mt-[8px]"
        :style="{ color: 'var(--text-secondary, #475569)' }"
      >
        {{ helloText }}
      </text>

      <!-- 组件库多语言同步预览 -->
      <view class="h-[1px] bg-[#f1f5f9] my-[12px]" />
      <view>
        <text class="text-[12px] text-[#94a3b8] mb-[6px]">{{ uviewPreview }}</text>
        <view class="flex-row items-center flex-wrap">
          <text class="text-[13px] text-[#2563eb] bg-[#eff6ff] px-[8px] py-[4px] rounded-[4px] font-medium mr-[8px] mb-[4px]">{{ uViewChooseDates }}</text>
          <text class="text-[13px] text-[#059669] bg-[#ecfdf5] px-[8px] py-[4px] rounded-[4px] font-medium mr-[8px] mb-[4px]">{{ uViewConfirm }}</text>
          <text class="text-[13px] text-[#d97706] bg-[#fffbe2] px-[8px] py-[4px] rounded-[4px] font-medium mb-[4px]">{{ uViewStart }} / {{ uViewEnd }}</text>
        </view>
      </view>
    </view>

    <!-- 选项列表 -->
    <view
      v-for="(item, index) in languageOptions"
      :key="index"
    >
      <view
        class="flex-row items-center justify-between py-[12px]"
        @click="switchLanguage(item.value)"
      >
        <view class="flex-row items-center">
          <text
            class="text-[15px] font-medium"
            :style="{ color: currentLocale == item.value ? 'var(--theme-color, #3b82f6)' : 'var(--text-color, #334155)' }"
          >
            {{ item.label }}
          </text>
        </view>
        <view class="flex-row items-center">
          <uni-icons
            v-if="currentLocale == item.value"
            type="checkmarkempty"
            size="20"
            :color="appStore.state.theme"
          />
        </view>
      </view>
      <view
        v-if="index < languageOptions.length - 1"
        class="h-[1px]"
        :style="{ backgroundColor: 'var(--border-color, #f1f5f9)' }"
      />
    </view>
  </Card>
</template>

<script setup lang="uts">
import Card from './Card.uvue';
import { computed } from 'vue';
import { useAppStore } from '@/src/store';
import { $t, setTabbarItem } from '@/src/utils/i18n';
import { toast } from '@/src/utils/toast.uts';

type LanguageOption = {
  label: string;
  value: string;
};
import { t as uViewT } from '@/uni_modules/uview-ultra/libs/i18n/index.uts';

const appStore = useAppStore();

const langTitle = computed((): string => $t('basic.langTitle'));
const langPreview = computed((): string => $t('basic.langPreview'));
const welcomeText = computed((): string => $t('message.welcome'));
const helloText = computed((): string => $t('message.hello', { msg: 'hi' }));
const uviewPreview = computed((): string => $t('basic.uviewPreview'));

const currentLocale = computed((): string => appStore.state.locale);

const languageOptions: LanguageOption[] = [
  { label: '简体中文', value: 'zh-CN' },
  { label: 'English', value: 'en-US' }
];

const uViewChooseDates = computed((): string => {
  const _dummy = currentLocale.value;
  return uViewT('up.calendar.chooseDates', {} as UTSJSONObject);
});

const uViewConfirm = computed((): string => {
  const _dummy = currentLocale.value;
  return uViewT('up.common.confirm', {} as UTSJSONObject);
});

const uViewStart = computed((): string => {
  const _dummy = currentLocale.value;
  return uViewT('up.common.start', {} as UTSJSONObject);
});

const uViewEnd = computed((): string => {
  const _dummy = currentLocale.value;
  return uViewT('up.common.end', {} as UTSJSONObject);
});

function switchLanguage(lang: string) {
  appStore.setLocale(lang);
  setTabbarItem();
  toast($t('message.switch_success'));
}
</script>
