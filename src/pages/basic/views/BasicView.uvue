<template>
  <view class="flex-col p-[16px]">
    <!-- 顶部开发指引提示（正式业务可直接移除） -->
    <view class="rounded-[12px] p-[12px] mb-[16px] bg-[#eff6ff] border-[1px] border-solid border-[#bfdbfe] flex flex-row items-start">
      <text class="text-[14px] mr-[6px]">💡</text>
      <view class="flex-1 flex flex-col">
        <text class="text-[13px] font-bold text-[#1d4ed8] mb-[2px]">开发指引（可删除）：</text>
        <text class="text-[12px] leading-[18px] text-[#2563eb]">
          本页面所有卡片均为 unibestX 基础能力演示 Demo。开发正式业务时，可直接删除本列表与对应的 /src/sub/*BasicDemo 分包目录。
        </text>
      </view>
    </view>

    <!-- 基础能力演示列表（Card + 一行描述 + sub路径展示 + 原生按钮跳转） -->
    <view
      v-for="item in demoList"
      :key="item.id"
      class="rounded-[16px] p-[20px] mb-[16px] border-[1px] border-solid border-[#edf2f7] bg-[#ffffff]"
    >
      <!-- 标题区域 -->
      <view class="flex flex-row items-center justify-between mb-[12px]">
        <view class="flex flex-row items-center flex-1">
          <view
            class="w-[4px] h-[16px] rounded-[2px] mr-[8px] bg-[#3b82f6]"
          />
          <text class="text-[16px] font-bold text-[#2d3748]">
            {{ item.title }}
          </text>
        </view>
        <!-- 可删除标识 -->
        <view class="px-[6px] py-[2px] rounded-[4px] bg-[#fef2f2] border-[1px] border-solid border-[#fee2e2]">
          <text class="text-[11px] font-medium text-[#ef4444]">
            可删除 Demo
          </text>
        </view>
      </view>

      <!-- 一行功能描述 -->
      <view class="flex-col mb-[12px]">
        <text
          class="text-[13px] leading-[18px] text-[#64748b]"
        >
          {{ item.desc }}
        </text>
      </view>

      <!-- 对应 sub 路径及删除指引 -->
      <view class="p-[10px] rounded-[8px] bg-[#f8fafc] border-[1px] border-solid border-[#e2e8f0] mb-[16px]">
        <view class="flex flex-row items-center mb-[4px]">
          <text class="text-[11px] font-bold text-[#475569] mr-[6px]">
            对应 sub 路径:
          </text>
          <text class="text-[11px] text-[#2563eb]" style="font-family: monospace;">
            {{ item.path }}
          </text>
        </view>
        <text class="text-[11px] leading-[16px] text-[#94a3b8]">
          提示：正式业务开发时，可删除此卡片及对应的 sub 演示目录与 pages.json 路由。
        </text>
      </view>

      <!-- 跳转按钮 -->
      <view
        class="w-full h-[42px] flex flex-row items-center justify-center rounded-[8px] bg-[#3b82f6] active:opacity-90"
        @click="navigateToDemo(item.path)"
      >
        <text class="text-[#ffffff] text-[14px] font-bold">
          {{ item.btnText }}
        </text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { curIdx, onTabPageShow, onTabShow, resolveTabIndexByKey } from '@/src/tabbar/index.uts';
import { onNavbarPullDownRefresh, stopNavbarPullDownRefresh } from '@/src/layouts/navbar/utils/index.uts';
import { systemInfo } from '@/src/utils/systemInfo/index.uts';

// =========================================================================
// 【可选删除】以下数据与方法仅供脚手架基础功能演示使用。
// 接入真实业务时可整段删除，并同步清理对应 sub 分包与 pages.json 路由：
// - modal:       /src/sub/modalBasicDemo/
// - layout:      /src/sub/layoutBasicDemo/
// - tailwindcss: /src/sub/tailwindcssBasicDemo/
// - theme:       /src/sub/themeBasicDemo/
// - router:      /src/sub/routerBasicDemo/
// - lang:        /src/sub/langBasicDemo/
// - font:        /src/sub/fontBasicDemo/
// - icon:        /src/sub/iconBasicDemo/
// - http:        /src/sub/httpBasicDemo/
// =========================================================================
type BasicDemoItem = {
  id: string;
  title: string;
  desc: string;
  btnText: string;
  path: string;
};

const demoList: Array<BasicDemoItem> = [
  {
    id: 'modal',
    title: '全屏弹窗与遮罩 Demo',
    desc: '演示全屏遮罩弹窗、覆盖原生 TabBar 穿透及层级管理。',
    btnText: '进入全屏弹窗与遮罩功能',
    path: '/src/sub/modalBasicDemo/modalBasicDemo'
  },
  {
    id: 'layout',
    title: '页面布局骨架 Demo',
    desc: '演示 navbar 与 default 布局下滚动容器与可用高度规范。',
    btnText: '进入页面布局骨架功能',
    path: '/src/sub/layoutBasicDemo/layoutBasicDemo'
  },
  {
    id: 'tailwindcss',
    title: 'Tailwind CSS 样式 Demo',
    desc: '演示 weapp-tailwindcss v4 原子化类名、动态主题与样式规范。',
    btnText: '进入 Tailwind CSS 样式功能',
    path: '/src/sub/tailwindcssBasicDemo/tailwindcssBasicDemo'
  },
  {
    id: 'theme',
    title: '主题换肤与暗黑模式 Demo',
    desc: '演示主题主色调切换、跟随系统外观及暗黑模式实时响应。',
    btnText: '进入主题换肤与暗黑模式功能',
    path: '/src/sub/themeBasicDemo/themeBasicDemo'
  },
  {
    id: 'router',
    title: '路由跳转与路由拦截 Demo',
    desc: '演示自定义路由拦截器、黑白名单鉴权守卫与跨页传参。',
    btnText: '进入路由跳转与路由拦截功能',
    path: '/src/sub/routerBasicDemo/routerBasicDemo'
  },
  {
    id: 'lang',
    title: 'i18n 多语言国际化 Demo',
    desc: '演示基于 vue-i18n 的中英文多语言即时动态切换。',
    btnText: '进入 i18n 多语言国际化功能',
    path: '/src/sub/langBasicDemo/langBasicDemo'
  },
  {
    id: 'font',
    title: '字体族与字号调节 Demo',
    desc: '演示跨端字体族规约与多级动态字号调节渲染。',
    btnText: '进入字体族与字号调节功能',
    path: '/src/sub/fontBasicDemo/fontBasicDemo'
  },
  {
    id: 'icon',
    title: '通用图标库集成 Demo',
    desc: '演示 easycom 图标库自动化导入、彩色图标与状态绑定。',
    btnText: '进入通用图标库集成功能',
    path: '/src/sub/iconBasicDemo/iconBasicDemo'
  },
  {
    id: 'http',
    title: 'HTTP 网络请求 Demo',
    desc: '基于 lime-request 封装，包含 Mock、真实接口与文件上传。',
    btnText: '进入 HTTP 网络请求功能',
    path: '/src/sub/httpBasicDemo/httpBasicDemo'
  },
  {
    id: 'uviewUltra',
    title: 'uView-ultra 组件库 Demo',
    desc: '专为 uni-app X 打造的 uView 原生重构版，提供全套跨端组件演示。',
    btnText: '进入 uView-ultra 组件库功能',
    path: '/src/sub/uviewUltraBasicDemo/uviewUltraBasicDemo'
  }
];

function navigateToDemo(url: string): void {
  uni.navigateTo({
    url,
    fail: (err) => {
      console.error('navigateToDemo fail:', err);
    }
  });
}
// =================== 【可选删除】基础演示 Demo 数据与跳转方法 结束 ===================

// 页面数据加载/刷新方法
function refreshData(): void {
  console.log('基础页面刷新中...');
  setTimeout(() => {
    if (curIdx.value != resolveTabIndexByKey('basic')) {
      return;
    }
    console.log('基础页面刷新成功');
    stopNavbarPullDownRefresh();
  }, 1000);
}

// 监听 navbar 自定义下拉刷新事件
onNavbarPullDownRefresh(() => {
  if (curIdx.value == resolveTabIndexByKey('basic')) {
    refreshData();
  }
});

// 监听 Tab 切换到当前基础页（config.uts 中 type: 'basic'）
onTabShow('basic', () => {
  console.log('onTabShow 基础 Tab 显示');
}, true);

// 监听基础 Tab 页面显示
onTabPageShow('basic', () => {
  console.log('onTabPageShow 基础 Tab 显示');
}, true);

onMounted(() => {
  console.log(systemInfo.value?.availableHeight, 'systemInfo.value?.availableHeight');
  console.log('基础 Tab 挂载了');
});

onUnmounted(() => {
  console.log('基础 Tab 卸载了');
});
</script>

<style scoped></style>
