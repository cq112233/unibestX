<template>
  <view class="flex-col">
    <view class="flex-col pb-[80px]">
      <!-- 全屏弹窗遮罩（覆盖 TabBar）演示组件 -->
      <ModalDemoCard />

      <!-- 布局页面示例组件 -->
      <LayoutDemoCard />

      <!-- weapp-tailwindcss 样式引擎示例 -->
      <TailwindcssDemoCard />

      <!-- 使用 uview-ultra 组件库 -->
      <UViewUltraDemoCard />

      <!-- 使用封装的主题切换组件 -->
      <ThemeSwitchCard />

      <!-- 使用路由拦截与传参演示组件 -->
      <RouterDemoCard />

      <!-- 使用 src/store 双模式门面的状态管理演示组件 -->
      <StoreDemoCard />

      <!-- 使用封装的多语言切换组件 -->
      <LangSwitchCard />

      <!-- 字体族与字号调节演示组件 -->
      <FontDemoCard />

      <!-- 使用封装的图标示例组件 -->
      <IconDemoCard />

      <!-- HTTP 请求 Demo（独立页面入口） -->
      <HttpDemoCard />

      <!-- rxjs 流式演示（独立页面入口） -->
      <RxjsDemoCard />

      <!-- 父子组件传参 & 具名插槽演示组件 -->
      <PropsDemoCard />
    </view>
  </view>
</template>

<script setup lang="uts">
import { systemInfo } from '@/src/utils/systemInfo/index.uts';
import FontDemoCard from '../components/FontDemoCard.uvue';
import HttpDemoCard from '../components/HttpDemoCard.uvue';
import IconDemoCard from '../components/IconDemoCard.uvue';
import LangSwitchCard from '../components/LangSwitchCard.uvue';
import LayoutDemoCard from '../components/LayoutDemoCard.uvue';
import ModalDemoCard from '../components/ModalDemoCard.uvue';
import PropsDemoCard from '../components/PropsDemoCard.uvue';
import RouterDemoCard from '../components/RouterDemoCard.uvue';
import RxjsDemoCard from '../components/RxjsDemoCard.uvue';
import StoreDemoCard from '../components/StoreDemoCard.uvue';
import TailwindcssDemoCard from '../components/TailwindcssDemoCard.uvue';
import ThemeSwitchCard from '../components/ThemeSwitchCard.uvue';
import UViewUltraDemoCard from '../components/UViewUltraDemoCard.uvue';
import { curIdx, onTabPageShow, onTabShow } from '@/src/tabbar/index.uts';
import { onNavbarPullDownRefresh, stopNavbarPullDownRefresh } from '@/src/utils/refresh/index.uts';

// 页面数据加载/刷新方法
function refreshData(): void {
  console.log('基础页面刷新中...');
  setTimeout(() => {
    // 门控检查：若刷新完成时用户已切到其他 Tab 则忽略
    if (curIdx.value != 1) {
      return;
    }
    console.log('基础页面刷新成功');
    // 数据加载完毕后，手动停止下拉刷新动画状态
    stopNavbarPullDownRefresh();
  }, 1000);
}

// 监听 navbar 自定义下拉刷新事件（在 enablePullDownRefresh: true 且处于当前 Tab 时生效）
onNavbarPullDownRefresh(() => {
  if (curIdx.value == 1) {
    refreshData();
  }
});

// 监听 Tab 切换到当前基础页（索引 1）时触发
onTabShow(1, () => {
  console.log('onTabShow 基础 Tab 显示');
}, true);

// 监听基础 Tab 页面显示（切 Tab、从子页面返回、前台恢复都会触发）
onTabPageShow(1, () => {
  console.log('onTabPageShow 基础 Tab 显示');
}, true);

onMounted(() => {
  console.log(systemInfo.value?.availableHeight, 'systemInfo.value?.availableHeight');
  console.log('基础 Tab 挂载了');
});

onUnmounted(() => {
  console.log('基础 Tab 卸载了');
});
</script>

<style scoped></style>
