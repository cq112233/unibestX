<template>
  <view class="flex flex-col items-center px-[16px] pt-[8px]">
    <!-- 头部卡片：用户头像及状态 -->
    <view class="w-full bg-white rounded-[12px] px-[20px] py-[20px] mb-[16px] flex flex-col items-center">
      <image class="w-[80px] h-[80px] rounded-[40px] mb-[12px] border-[3px] border-[#f1f5f9] border-solid" :src="avatarUrl" />
      <text class="text-[18px] font-bold text-[#1e293b] mb-[4px]">
        {{ userStore.state.userInfo.username.length > 0 ? userStore.state.userInfo.username : '未登录用户' }}
      </text>
      <text v-if="userStore.state.userInfo.username.length > 0" class="text-[13px] text-[#64748b] mb-[10px]">
        {{ userStore.state.userInfo.nickname }}
      </text>
      <view class="flex flex-row">
        <text
          class="text-[12px] px-[12px] py-[3px] rounded-[20px] font-medium overflow-hidden"
          :class="tokenStore.hasValidLogin() ? 'bg-[#d1fae5] text-[#065f46]' : 'bg-[#f1f5f9] text-[#64748b]'"
        >
          {{ tokenStore.hasValidLogin() ? '已登录' : '未登录' }}
        </text>
      </view>
    </view>

    <!-- 信息区域：序列化数据展示 -->
    <view class="w-full bg-white rounded-[12px] p-[16px] mb-[16px] flex flex-col">
      <view class="pb-[8px] flex flex-row">
        <text class="text-[14px] font-semibold text-[#334155]">用户信息 (JSON)</text>
      </view>
      <view class="h-[1px] bg-[#f1f5f9] mb-[10px]" />
      <scroll-view class="bg-[#0f172a] rounded-[8px] p-[10px] h-[130px]" direction="vertical">
        <text class="text-[12px] text-[#38bdf8] leading-[18px]" style="font-family: monospace;">{{ userInfoJson }}</text>
      </scroll-view>
    </view>

    <!-- 按钮区域 -->
    <view class="w-full px-[4px] flex flex-col">
      <view v-if="tokenStore.hasValidLogin()" class="w-full h-[44px] rounded-[8px] bg-[#ef4444] flex flex-row items-center justify-center" @click="handleLogout">
        <text class="text-[#ffffff] text-[14px] font-bold">退出登录</text>
      </view>
      <view v-else class="w-full flex flex-col">
        <!-- App 微信一键登录 -->
        <view
          class="w-full h-[44px] rounded-[8px] bg-[#07c160] flex flex-row items-center justify-center mb-[12px]"
          @click="handleWechatLogin"
        >
          <text class="text-[#ffffff] text-[14px] font-bold">App 微信一键登录</text>
        </view>
        <!-- 钉钉一键登录 -->
        <view
          class="w-full h-[44px] rounded-[8px] bg-[#0089ff] flex flex-row items-center justify-center mb-[12px]"
          @click="handleDingTalkLogin"
        >
          <text class="text-[#ffffff] text-[14px] font-bold">钉钉一键登录</text>
        </view>
        <!-- 支付宝一键登录 -->
        <view
          class="w-full h-[44px] rounded-[8px] bg-[#1677ff] flex flex-row items-center justify-center mb-[12px]"
          @click="handleAlipayLogin"
        >
          <text class="text-[#ffffff] text-[14px] font-bold">支付宝一键登录</text>
        </view>
        <!-- 原有账号密码登录 -->
        <view
          class="w-full h-[44px] rounded-[8px] border-[1px] border-solid border-[#cbd5e1] bg-[#ffffff] flex flex-row items-center justify-center"
          @click="handleLogin"
        >
          <text class="text-[#334155] text-[14px] font-bold">账号密码登录</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed } from 'vue';
import type { ISingleTokenRes, IUserInfo } from '@/src/store';
import { useTokenStore, useUserStore } from '@/src/store';
import { LOGIN_PAGE } from '@/src/router/config';
import { curIdx, onTabPageShow, onTabShow, switchTabbar } from '@/src/tabbar/index.uts';
import { onNavbarPullDownRefresh, stopNavbarPullDownRefresh } from '@/src/utils/refresh/index.uts';
import { dingTalkLogin, isDingTalkInstalled } from '@/uni_modules/uts-dingtalk-login';
import { alipayLogin, isAlipayInstalled } from '@/uni_modules/uts-alipay-login';

// 页面数据加载/刷新方法
function refreshData(): void {
  console.log('我的页面刷新中...');
  setTimeout(() => {
    // 门控检查：若刷新完成时用户已切到其他 Tab 则忽略
    if (curIdx.value != 3) {
      return;
    }
    console.log('我的页面刷新成功');
    // 数据加载完毕后，手动停止下拉刷新动画状态
    stopNavbarPullDownRefresh();
  }, 1000);
}

// 监听 navbar 自定义下拉刷新事件（在 enablePullDownRefresh: true 且处于当前 Tab 时生效）
onNavbarPullDownRefresh(() => {
  if (curIdx.value == 3) {
    refreshData();
  }
});

const userStore = useUserStore();
const tokenStore = useTokenStore();

// 计算头像
const avatarUrl = computed((): string => {
  if (userStore.state.userInfo.avatar.length > 0) {
    return userStore.state.userInfo.avatar;
  }
  return '/static/logo.png';
});

// 序列化用户信息为 JSON
const userInfoJson = computed((): string => {
  const info = {
    userId: userStore.state.userInfo.userId,
    username: userStore.state.userInfo.username,
    nickname: userStore.state.userInfo.nickname,
    avatar: userStore.state.userInfo.avatar
  };
  return JSON.stringify(info, null, 2);
});

// App 微信登录
function handleWechatLogin(): void {
  // #ifdef APP
  uni.showLoading({
    title: '微信授权中...',
    mask: true
  });

  // 1. 检查当前客户端运行环境是否支持微信登录服务
  uni.getProvider({
    service: 'oauth',
    success: (providerRes) => {
      const providers = providerRes.provider;
      if (!providers.includes('weixin')) {
        uni.hideLoading();
        uni.showToast({
          title: '当前环境未检测到微信登录模块',
          icon: 'none'
        });
        return;
      }

      // 2. 调用 App 原生微信登录获取授权凭证
      uni.login({
        provider: 'weixin',
        onlyAuthorize: true,
        success: (loginRes) => {
          uni.hideLoading();
          const authCode = loginRes.code;
          console.log('App 微信授权成功，code:', authCode);

          // 3. 将微信凭证提交保存，更新业务 token 与用户信息
          const tokenStr = `wx-token-${Date.now()}`;
          tokenStore.setSingleToken({
            token: tokenStr,
            expiresIn: 7200
          } as ISingleTokenRes);

          userStore.setUserInfo({
            userId: 6666,
            username: 'WeChat_User',
            nickname: '微信授权用户',
            avatar: '/static/logo.png'
          } as IUserInfo);

          uni.showToast({
            title: '微信登录成功',
            icon: 'success'
          });
        },
        fail: (err) => {
          uni.hideLoading();
          console.error('App 微信登录失败:', err);
          uni.showModal({
            title: '微信登录提示',
            content: err.errMsg ?? '请检查是否已安装微信客户端，或微信开放平台 AppID 签名配置',
            showCancel: false
          });
        }
      });
    },
    fail: (err) => {
      uni.hideLoading();
      console.error('获取登录服务提供商失败:', err);
      uni.showToast({
        title: '获取登录服务提供商失败',
        icon: 'none'
      });
    }
  });
  // #endif

  // #ifndef APP
  uni.showModal({
    title: '平台提示',
    content: 'App 微信原生登录需在手机端基座中运行。当前非 App 环境，是否执行微信模拟授权登录？',
    success: (res) => {
      if (res.confirm) {
        tokenStore.setSingleToken({
          token: `mock-wx-token-${Date.now()}`,
          expiresIn: 7200
        } as ISingleTokenRes);

        userStore.setUserInfo({
          userId: 6666,
          username: 'WeChat_User',
          nickname: '微信用户 (模拟)',
          avatar: '/static/logo.png'
        } as IUserInfo);

        uni.showToast({
          title: '微信登录成功',
          icon: 'success'
        });
      }
    }
  });
  // #endif
}

// 钉钉授权登录（基于 uts-dingtalk-login 原生插件）
function handleDingTalkLogin(): void {
  // #ifdef APP-ANDROID
  // 1. 检查是否安装钉钉客户端
  const installed = isDingTalkInstalled();
  if (!installed) {
    uni.showToast({
      title: '未安装钉钉客户端',
      icon: 'none'
    });
    return;
  }

  uni.showLoading({
    title: '钉钉授权中...',
    mask: true
  });

  // 2. 调用 uts-dingtalk-login 原生插件拉起钉钉授权
  dingTalkLogin({
    appId: 'dingoae0123456789', // 钉钉开放平台申请的 AppId
    success: (res) => {
      uni.hideLoading();
      console.log('钉钉授权成功，authCode:', res.authCode);

      // 将 authCode 提交给后端服务换取业务 token 与用户信息
      const tokenStr = `dd-token-${Date.now()}`;
      tokenStore.setSingleToken({
        token: tokenStr,
        expiresIn: 7200
      } as ISingleTokenRes);

      userStore.setUserInfo({
        userId: 9999,
        username: 'DingTalk_User',
        nickname: '钉钉授权用户',
        avatar: '/static/logo.png'
      } as IUserInfo);

      uni.showToast({
        title: '钉钉登录成功',
        icon: 'success'
      });
    },
    fail: (err) => {
      uni.hideLoading();
      console.error('钉钉登录失败:', err.errCode, err.errMsg);
      uni.showModal({
        title: '钉钉登录提示',
        content: `[${err.errCode}] ${err.errMsg}`,
        showCancel: false
      });
    },
    complete: () => {
      uni.hideLoading();
    }
  });
  // #endif

  // #ifndef APP-ANDROID
  uni.showModal({
    title: '平台提示',
    content: '钉钉原生插件需在 Android 自定义基座真机环境下运行。当前非 Android 原生环境，是否执行模拟授权登录？',
    success: (res) => {
      if (res.confirm) {
        tokenStore.setSingleToken({
          token: `mock-dd-token-${Date.now()}`,
          expiresIn: 7200
        } as ISingleTokenRes);

        userStore.setUserInfo({
          userId: 9999,
          username: 'DingTalk_User',
          nickname: '钉钉用户 (模拟)',
          avatar: '/static/logo.png'
        } as IUserInfo);

        uni.showToast({
          title: '钉钉登录成功',
          icon: 'success'
        });
      }
    }
  });
  // #endif
}

// 支付宝授权登录（基于 uts-alipay-login 原生插件）
function handleAlipayLogin(): void {
  // #ifdef APP-ANDROID
  // 1. 检查是否安装支付宝客户端
  const installed = isAlipayInstalled();
  if (!installed) {
    uni.showToast({
      title: '未检测到支付宝客户端，将拉起网页授权',
      icon: 'none'
    });
  }

  uni.showLoading({
    title: '支付宝授权中...',
    mask: true
  });

  // 2. 调用 uts-alipay-login 原生插件发起授权
  // 生产环境中 authInfo 由业务后端调用支付宝开放平台 alipay.open.auth.sdk.code.get 签名生成
  const mockAuthInfo = 'apiname=com.alipay.account.auth&app_id=2021000000000000&auth_type=AUTHACCOUNT&biz_type=openservice&pid=2088000000000000&product_id=APP_FAST_LOGIN&scope=kuaijie&target_id=unibestX_user';

  alipayLogin({
    authInfo: mockAuthInfo,
    showLoading: false,
    success: (res) => {
      uni.hideLoading();
      console.log('支付宝授权成功，authCode:', res.authCode, 'userId:', res.userId);

      // 将 authCode 提交给后端服务换取系统业务 Token 与用户信息
      const tokenStr = `alipay-token-${Date.now()}`;
      tokenStore.setSingleToken({
        token: tokenStr,
        expiresIn: 7200
      } as ISingleTokenRes);

      userStore.setUserInfo({
        userId: 7777,
        username: 'Alipay_User',
        nickname: '支付宝授权用户',
        avatar: '/static/logo.png'
      } as IUserInfo);

      uni.showToast({
        title: '支付宝登录成功',
        icon: 'success'
      });
    },
    fail: (err) => {
      uni.hideLoading();
      console.error('支付宝登录失败:', err.errCode, err.errMsg);
      uni.showModal({
        title: '支付宝登录提示',
        content: `[${err.errCode}] ${err.errMsg}`,
        showCancel: false
      });
    },
    complete: () => {
      uni.hideLoading();
    }
  });
  // #endif

  // #ifndef APP-ANDROID
  uni.showModal({
    title: '平台提示',
    content: '支付宝原生插件需在 Android 自定义基座真机环境下运行。当前非 Android 原生环境，是否执行模拟授权登录？',
    success: (res) => {
      if (res.confirm) {
        tokenStore.setSingleToken({
          token: `mock-alipay-token-${Date.now()}`,
          expiresIn: 7200
        } as ISingleTokenRes);

        userStore.setUserInfo({
          userId: 7777,
          username: 'Alipay_User',
          nickname: '支付宝用户 (模拟)',
          avatar: '/static/logo.png'
        } as IUserInfo);

        uni.showToast({
          title: '支付宝登录成功',
          icon: 'success'
        });
      }
    }
  });
  // #endif
}

// 登录
function handleLogin() {
  uni.navigateTo({
    url: LOGIN_PAGE
  });
}

// 退出登录
function handleLogout() {
  uni.showModal({
    title: '提示',
    content: '确定要退出登录吗？',
    success: (res) => {
      if (res.confirm) {
        tokenStore.clearToken();
        userStore.clearUserInfo();
        uni.showToast({
          title: '退出登录成功',
          icon: 'success'
        });
        // 退出后跳回首页（me 页需要登录，不能停留）
        setTimeout(() => {
          switchTabbar('/src/pages/index/index');
        }, 0);
      }
    }
  });
}

// 监听 Tab 切换到当前功能页（索引 3）时触发
onTabShow(3, () => {
  console.log('onTabShow 我 Tab 显示');
}, true);

// 监听我 Tab 页面显示（切 Tab、从子页面返回、前台恢复都会触发）
onTabPageShow(3, () => {
  console.log('onTabPageShow 我 Tab 显示');
}, true);

onMounted(() => {
  console.log('我 Tab 挂载了');
});

onUnmounted(() => {
  console.log('我 Tab 卸载了');
});
</script>

<style scoped lang="scss"></style>
