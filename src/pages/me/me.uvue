<template>
  <view class="flex flex-col items-center px-[16px] pt-[8px]">
    <!-- 头部卡片：用户头像及状态 -->
    <view class="w-full bg-white rounded-[12px] px-[20px] py-[20px] mb-[16px] flex flex-col items-center">
      <image class="w-[80px] h-[80px] rounded-[40px] mb-[12px] border-[3px] border-[#f1f5f9] border-solid" :src="avatarUrl" />
      <text class="text-[18px] font-bold text-[#1e293b] mb-[4px]">
        {{ userStore.state.userInfo.username.length > 0 ? userStore.state.userInfo.username : '未登录用户' }}
      </text>
      <text v-if="userStore.state.userInfo.username.length > 0" class="text-[13px] text-[#64748b] mb-[10px]">
        {{ userStore.state.userInfo.nickname }}
      </text>
      <view class="flex flex-row">
        <text
          class="text-[12px] px-[12px] py-[3px] rounded-[20px] font-medium overflow-hidden"
          :class="tokenStore.hasValidLogin() ? 'bg-[#d1fae5] text-[#065f46]' : 'bg-[#f1f5f9] text-[#64748b]'"
        >
          {{ tokenStore.hasValidLogin() ? '已登录' : '未登录' }}
        </text>
      </view>
    </view>

    <!-- 信息区域：序列化数据展示 -->
    <view class="w-full bg-white rounded-[12px] p-[16px] mb-[16px] flex flex-col">
      <view class="pb-[8px] flex flex-row">
        <text class="text-[14px] font-semibold text-[#334155]">用户信息 (JSON)</text>
      </view>
      <view class="h-[1px] bg-[#f1f5f9] mb-[10px]" />
      <scroll-view class="bg-[#0f172a] rounded-[8px] p-[10px] h-[130px]" direction="vertical">
        <text class="text-[12px] text-[#38bdf8] leading-[18px]" style="font-family: monospace;">{{ userInfoJson }}</text>
      </scroll-view>
    </view>

    <!-- 按钮区域 -->
    <view class="w-full px-[4px] flex flex-col">
      <view v-if="tokenStore.hasValidLogin()" class="w-full h-[44px] rounded-[8px] bg-[#ef4444] flex flex-row items-center justify-center" @click="handleLogout">
        <text class="text-[#ffffff] text-[14px] font-bold">退出登录</text>
      </view>
      <view v-else class="w-full h-[44px] rounded-[8px] bg-[#3b82f6] flex flex-row items-center justify-center" @click="handleLogin">
        <text class="text-[#ffffff] text-[14px] font-bold">登录</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed } from 'vue';
import { useTokenStore, useUserStore } from '@/src/store/index.uts';
import { LOGIN_PAGE } from '@/src/utils/auth/toLoginPage.uts';
import { curIdx, resolveTabIndexByKey, switchTabbar, useTabPage, useTabPageShell } from '@/src/tabbar/index.uts';
import { onNavbarPullDownRefresh, stopNavbarPullDownRefresh } from '@/src/layouts/navbar/utils/index.uts';
import { useRouter } from '@/uni_modules/route-bestX/index.uts';

definePage({
  debug: false,
  layout: 'navbar',
  showBack: false,
  enablePullDownRefresh: true,
  hideStatusBar: false,
  hideNavbar: false,
  style: {
    navigationBarTitleText: 'tabbar.me',
    navigationStyle: 'custom'
  }
});

const router = useRouter();

const {
  route: meRoute,
  onLoad: onMeLoad,
  onShow: onMeShow,
  onHide: onMeHide
} = useTabPage();

// 监听 navbar 自定义下拉刷新事件（在 enablePullDownRefresh: true 且处于当前 Tab 时生效）
onNavbarPullDownRefresh(() => {
  // 所有已挂载 Tab 都会收到全局刷新事件，只处理当前激活的「我的」页
  if (curIdx.value != resolveTabIndexByKey('me')) {
    return;
  }
  console.log('我的页面刷新中...');
  setTimeout(() => {
    // 异步完成时再次门控：刷新期间若已切走则忽略结果
    if (curIdx.value != resolveTabIndexByKey('me')) {
      return;
    }
    console.log('我的页面刷新成功');
    stopNavbarPullDownRefresh();
  }, 1000);
});

const userStore = useUserStore();
const tokenStore = useTokenStore();

/** 本视图所属的「我的」页面路由：退出登录后固定回到此页（该页无需登录，未登录态自身渲染） */
const ME_PAGE_PATH: string = '/src/pages/me/me';

// 计算头像
const avatarUrl = computed((): string => {
  if (userStore.state.userInfo.avatar.length > 0) {
    return userStore.state.userInfo.avatar;
  }
  return '/static/logo.png';
});

// 序列化用户信息为 JSON
const userInfoJson = computed((): string => {
  const info = {
    userId: userStore.state.userInfo.userId,
    username: userStore.state.userInfo.username,
    nickname: userStore.state.userInfo.nickname,
    avatar: userStore.state.userInfo.avatar,
    permissions: userStore.state.userInfo.permissions
  };
  return JSON.stringify(info, null, 2);
});

// 登录
function handleLogin(): void {
  // 模式 4 的真实页面栈只有宿主首页，登录成功后必须依靠 redirect 恢复来源虚拟 Tab。
  router.push({
    path: LOGIN_PAGE,
    query: { redirect: meRoute.value.fullPath != '' ? meRoute.value.fullPath : ME_PAGE_PATH }
  });
}

// 退出登录
function handleLogout() {
  uni.showModal({
    title: '提示',
    content: '确定要退出登录吗？',
    cancelText: '取消',
    confirmText: '确定',
    success: (res) => {
      if (res.confirm) {
        tokenStore.clearToken();
        userStore.clearUserInfo();
        uni.showToast({
          title: '退出登录成功',
          icon: 'success'
        });
        // 退出后留在「我的」页面（me 页无需登录，未登录态自身渲染）
        // 统一走 switchTabbar 回到本页：mode 4 只切激活索引不跳路由，mode 0-3 按各自策略 switchTab / redirectTo
        setTimeout(() => {
          switchTabbar(ME_PAGE_PATH);
        }, 0);
      }
    }
  });
}

// 与普通页面一致的首次进入 / 显示 / 隐藏生命周期
onMeLoad(() => {
  console.log('onMeLoad', '我 Tab 挂载了👋', meRoute.value.fullPath);
});

onMeShow(() => {
  console.log('onMeShow', '我 Tab 显示了👀', meRoute.value.fullPath);
});

onMeHide(() => {
  console.log('onMeHide', '我 Tab 隐藏了👉');
});

// 页面文件同时可作为模式 4 的 Tab 子页使用：嵌套时由 useTabPage() 接管页面生命周期
useTabPageShell('me');
</script>

<style scoped lang="scss"></style>
