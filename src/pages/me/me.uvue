<template>
  <MeView />
</template>

<script setup lang="uts">
import MeView from './views/MeView.uvue';
import { useBackPressExit } from '@/src/hooks/useBackPressExit.uts';
import { notifyPageHide, notifyPageShow, setCurIdxByKey } from '@/src/tabbar/index.uts';

definePage({
  debug: false,
  layout: 'navbar',
  showBack: false,
  enablePullDownRefresh: true,
  hideStatusBar: false,
  hideNavbar: false,
  style: {
    navigationBarTitleText: 'tabbar.me',
    navigationStyle: 'custom'
  }
});

// 独立页面模式下，切到当前我的页时同步当前 Tab 激活索引并通知页面可见
onShow(() => {
  setCurIdxByKey('me');
  notifyPageShow();
});

onHide(() => {
  notifyPageHide();
});

// Android 物理返回键：再按一次退出应用
useBackPressExit();
</script>

<style scoped lang="scss"></style>
