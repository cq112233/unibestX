<script setup lang="uts">
import Tabbar from '@/src/tabbar/tabbar.uvue';
import { customTabbarEnable, isPageTabbar, isSinglePageTabbar, selectedTabbarStrategy, syncCurIdxByCurrentPage } from '@/src/tabbar/index.uts';
import { getCurrentPath, isSamePath } from '@/src/tabbar/core/path.uts';
import { useThemeStore } from '@/src/store/index.uts';
import { applyNavbarTheme, getRootThemeStyle } from '@/src/theme/index.uts';
import { computed, onMounted, onUnmounted, ref, watch } from 'vue';
import { updateAvailableHeight } from '@/src/utils/systemInfo/index.uts';
// #ifdef VUE3-VAPOR
import { onBackPress } from '@dcloudio/uni-app';
import { consumeNavigateBackInterceptorVerdict, interceptNativeBack } from '@/uni_modules/route-bestX/index.uts';
// #endif

/**
 * 页面参数 Props：由 autoRootPlugin 编译时从 pages.json 提取（与 LayoutComponent 同一套、全量注入），
 * 每页一个 AppKu 实例，各自拿到自己页面的参数，供挂载阶段按页面做可用高度等计算。
 * 注：layout 也随页面注入（default 布局不扣状态栏/导航栏）；type/debug 等 definePage 私有键不会写入 pages.json，收不到。
 */
const props = defineProps({
  /** 是否显示左侧返回按钮（默认 true） */
  showBack: {
    type: Boolean,
    default: true
  },
  /** 是否隐藏导航栏（默认 false） */
  hideNavbar: {
    type: Boolean,
    default: false
  },
  /** 是否隐藏状态栏占位（默认 false，为 true 时不占用状态栏空间） */
  hideStatusBar: {
    type: Boolean,
    default: false
  },
  /** 页面布局模板标识（非 navbar 布局按无导航处理，参与可用高度计算时不扣状态栏/导航栏） */
  layout: {
    type: String,
    default: ''
  },
  /** 是否启用内容区域的自定义下拉刷新 */
  enablePullDownRefresh: {
    type: Boolean,
    default: false
  },
  /** 页面根容器自定义类名（页面 customPageClass） */
  customPageClass: {
    type: String,
    default: ''
  },
  /** 页面根容器自定义行内样式（页面 customPageStyle） */
  customPageStyle: {
    type: String,
    default: ''
  },
  /** 页面 style 完整配置对象（未拍平：navigationStyle / navigationBarTitleText / navigationBarBackgroundColor 等） */
  pageStyle: {
    type: Object,
    default: () => ({})
  },
  /** 当前页面是否是 TabBar 页面（编译期由 rootPlugin 注入，首帧即刻生效消除闪烁） */
  isTabbar: {
    type: Boolean,
    default: false
  }
});

// AppRoot 是 autoRootPlugin 注入到每个页面的统一根组件；Vapor 不支持 app.mixin，
// 因此在这里注册页面级 onBackPress，在原生出栈前补跑路由返回守卫。
// #ifdef VUE3-VAPOR
onBackPress((options: OnBackPressOptions): boolean => {
  const navigateBackVerdict = consumeNavigateBackInterceptorVerdict();
  if (options.from != 'backbutton') {
    return false;
  }
  if (getCurrentPages().length <= 1) {
    return false;
  }
  if (navigateBackVerdict != null) {
    return !navigateBackVerdict;
  }
  return !interceptNativeBack();
});
// #endif

// 激活主题状态管理 Store
const themeStore = useThemeStore();

/**
 * 获取 pageStyle 对象
 */
const _pageStyleObj = computed((): UTSJSONObject => {
  return (props.pageStyle ?? {}) as UTSJSONObject;
});

// 主题样式变量：亮 / 暗两套，跟随 themeStore.state.isDark 响应式切换
const themeStyle = computed((): UTSJSONObject => {
  return getRootThemeStyle(themeStore.state.theme, themeStore.state.isDark);
});

// 控制当前页面是否需要显示底部导航栏（首帧即刻生效，杜绝延迟到 onMounted 造成的空白跳动闪烁）
const isCurrentPageTabbar = ref(props.isTabbar);

// 是否展示自定义 TabBar（收敛为单值计算属性以符合跨端模板规范）
const showTabbar = computed((): boolean => {
  return customTabbarEnable && isCurrentPageTabbar.value;
});

// 组件挂载时：同步 H5 / 小程序原生导航栏主题与路由状态
onMounted(() => {
  applyNavbarTheme(themeStore.state.isDark);
  try {
    const pages = getCurrentPages();
    if (pages.length > 0) {
      const route = pages[pages.length - 1].route;
      if (route != null && route.length > 0) {
        const path = route.startsWith('/') ? route : `/${route}`;
        const isTabbar = isPageTabbar(path);
        isCurrentPageTabbar.value = isTabbar;
        if (isTabbar) {
          syncCurIdxByCurrentPage();
        }
      }
    }
  }
  catch { }
});

// 主题模式 / 系统深浅色变化时，当前页面不切换也实时同步导航栏
watch((): boolean => themeStore.state.isDark, (newVal: boolean) => {
  applyNavbarTheme(newVal);
});

let activeHideNavbar: boolean = props.hideNavbar;
let activeHideStatusBar: boolean = props.hideStatusBar;

/**
 * 执行可用高度重新计算
 */
function doUpdateHeight(overrideHideNavbar: boolean | null = null, overrideHideStatusBar: boolean | null = null): void {
  if (overrideHideNavbar != null) {
    activeHideNavbar = overrideHideNavbar as boolean;
  }
  if (overrideHideStatusBar != null) {
    activeHideStatusBar = overrideHideStatusBar as boolean;
  }
  updateAvailableHeight(
    activeHideNavbar,
    activeHideStatusBar,
    (props.pageStyle ?? {}) as UTSJSONObject,
    props.layout,
    selectedTabbarStrategy
  );
}

// 挂载时立即执行一次可用高度计算
onShow(() => {
  setTimeout(() => {
    doUpdateHeight();
  }, 100);
});

// 监听 props.hideStatusBar 变化自动重新计算
watch((): boolean => props.hideStatusBar, (newVal: boolean) => {
  doUpdateHeight(null, newVal);
});

// 监听 props.hideNavbar 变化自动重新计算
watch((): boolean => props.hideNavbar, (newVal: boolean) => {
  doUpdateHeight(newVal, null);
});

function onSetHideStatusBar(hide: any) {
  if (typeof hide == 'boolean') {
    doUpdateHeight(null, hide as boolean);
  }
}

function onSetHideNavbar(hide: any) {
  if (typeof hide == 'boolean') {
    doUpdateHeight(hide as boolean, null);
  }
}

/**
 * 模式 4 宿主专用：仅宿主页根组件响应 TabBar 的显隐配置。
 */
function onTabbarSetHideStatusBar(hide: any): void {
  if (!isSinglePageTabbar || typeof hide != 'boolean') {
    return;
  }
  const currentPath = getCurrentPath();
  if (currentPath.length == 0 || !isSamePath(currentPath, '/src/pages/index/index')) {
    return;
  }
  doUpdateHeight(null, hide as boolean);
}

function onTabbarSetHideNavbar(hide: any): void {
  if (!isSinglePageTabbar || typeof hide != 'boolean') {
    return;
  }
  const currentPath = getCurrentPath();
  if (currentPath.length == 0 || !isSamePath(currentPath, '/src/pages/index/index')) {
    return;
  }
  doUpdateHeight(hide as boolean, null);
}

// 挂载时监听单页 TabBar 切换或全局发出的显隐变更事件
onMounted(() => {
  uni.$on('setHideStatusBar', onSetHideStatusBar);
  uni.$on('setHideNavbar', onSetHideNavbar);
  uni.$on('tabbarSetHideStatusBar', onTabbarSetHideStatusBar);
  uni.$on('tabbarSetHideNavbar', onTabbarSetHideNavbar);
});

// 卸载时严格移除全局事件监听，彻底消除 IndexKt.emitter 持有页面导致的 Activity 内存泄漏
onUnmounted(() => {
  uni.$off('setHideStatusBar', onSetHideStatusBar);
  uni.$off('setHideNavbar', onSetHideNavbar);
  uni.$off('tabbarSetHideStatusBar', onTabbarSetHideStatusBar);
  uni.$off('tabbarSetHideNavbar', onTabbarSetHideNavbar);
});
</script>

<template>
  <!-- 应用全局骨架与皮肤容器，通过 CSS 变量绑定响应式主题色 / 暗黑模式 -->
  <view
    class="root-container"
    style="display: flex; flex-direction: column;flex: 1;"
    :class="themeStore.state.isDark ? 'dark' : ''"
    :style="themeStyle"
  >
    <!-- 页面内容滚动容器 -->
    <scroll-view direction="vertical" class="root-scroll-view" style="flex: 1;">
      <slot></slot>
    </scroll-view>
    <!-- 自定义 TabBar：根据 config.uts 中的 type 配置切换形态（胶囊或标准底座） -->
    <Tabbar v-if="showTabbar" />
  </view>
</template>

<style lang="scss" scoped>
.root-container {
  display: flex;
  flex-direction: column;
  flex: 1;
  background-color: var(--bg-color, #f5f6fa);
}

.root-scroll-view {
  flex: 1;
}
</style>
