/**
 * 环境变量与运行环境工具库
 * 统一收敛所有 import.meta.env 读取、环境类型判断、平台与编译模式获取方法
 *
 * ⚠️ 平台判断常量（platform / isH5 / isAppAndroid / isMpWeixin …）不在这里，统一收敛在
 *    `@/src/config/env/platform.uts`（零依赖叶子模块，变量名对齐 @uni-helper/uni-env）。
 *    需要平台判断时请精准导入该文件，不要经由本文件转发。
 */

import { isAppXVapor, platform } from '@/src/config/env/platform.uts';

/**
 * 获取当前应用名称（全端从 import.meta.env 读取）
 */
export function getAppTitle(): string {
  return `${import.meta.env.VITE_APP_TITLE ?? 'unibestX'}`;
}

/**
 * 获取当前业务应用版本号（来自 .env 的 VITE_APP_VERSION 或兜底 1.0.0）
 */
export function getAppVersion(): string {
  return `${import.meta.env.VITE_APP_VERSION ?? '1.0.0'}`;
}

/**
 * 获取当前模板工程版本号（来自 package.json 的 version）
 */
export function getTemplateVersion(): string {
  return `${import.meta.env.VITE_TEMPLATE_VERSION ?? import.meta.env.VITE_PKG_VERSION ?? '1.0.0'}`;
}

/**
 * 获取打包构建时间（全端从 import.meta.env 读取）
 */
export function getBuildTime(): string {
  return `${import.meta.env.VITE_BUILD_TIME ?? ''}`;
}

/**
 * 获取 Git Commit 简写哈希（全端从 import.meta.env 读取）
 */
export function getGitCommitHash(): string {
  return `${import.meta.env.VITE_GIT_COMMIT_HASH ?? ''}`;
}

/**
 * 获取 Git 当前打包分支名称（全端从 import.meta.env 读取）
 */
export function getGitBranch(): string {
  return `${import.meta.env.VITE_GIT_BRANCH ?? ''}`;
}

/**
 * 获取接口 BaseURL 地址（全端从 import.meta.env 读取）
 */
export function getApiBaseUrl(): string {
  return `${import.meta.env.VITE_SERVER_BASEURL ?? 'https://ukw0y1.laf.run'}`;
}

/**
 * 获取备用接口 BaseURL 地址（全端从 import.meta.env 读取）
 */
export function getApiSecondaryUrl(): string {
  return `${import.meta.env.VITE_SERVER_BASEURL_SECONDARY ?? 'https://ukw0y1.laf.run'}`;
}

/**
 * 获取网关/微服务接口 BaseURL 地址（VITE_GATEWAY_BASEURL，未单独配置时自动兜底主服务 BaseURL）
 */
export function getGatewayBaseUrl(): string {
  const custom = `${import.meta.env.VITE_GATEWAY_BASEURL ?? ''}`.trim();
  return custom != '' ? custom : getApiBaseUrl();
}

/**
 * 获取认证微服务接口 BaseURL 地址（VITE_AUTH_BASEURL，未单独配置时自动兜底主服务 BaseURL）
 */
export function getAuthBaseUrl(): string {
  const custom = `${import.meta.env.VITE_AUTH_BASEURL ?? ''}`.trim();
  return custom != '' ? custom : getApiBaseUrl();
}

/**
 * 获取 H5 是否开启反向代理（VITE_H5_USE_PROXY 开关：true 走 /api，false 直连；本地 Mock 开启时强制为 true）
 */
export function getH5UseProxy(): boolean {
  return `${import.meta.env.VITE_H5_USE_PROXY ?? 'false'}` == 'true'
    || `${import.meta.env.VITE_USE_MOCK ?? 'false'}` == 'true';
}

/**
 * 获取是否开启本地 Mock 模式（VITE_USE_MOCK 开关）
 */
export function getUseMock(): boolean {
  return `${import.meta.env.VITE_USE_MOCK ?? 'false'}` == 'true';
}

/**
 * 获取默认主题主色调（全端从 import.meta.env 读取）
 */
export function getDefaultTheme(): string {
  const envTheme = `${import.meta.env.VITE_DEFAULT_THEME ?? ''}`.trim();
  return envTheme.length > 0 ? envTheme : '#37c2bc';
}

/**
 * 获取默认外观模式（全端从 import.meta.env 读取，合法值：auto | light | dark，兜底 auto）
 */
export function getDefaultThemeMode(): string {
  const envMode = `${import.meta.env.VITE_DEFAULT_THEME_MODE ?? ''}`.trim().toLowerCase();
  if (envMode == 'light' || envMode == 'dark') {
    return envMode;
  }
  return 'auto';
}

/**
 * 获取默认国际化语言（全端从 import.meta.env 读取，未配置时自动识别系统语言，最后兜底 zh-CN）
 */
export function getDefaultLocale(): string {
  const envLocale = `${import.meta.env.VITE_DEFAULT_LOCALE ?? ''}`.trim();
  if (envLocale.length > 0) {
    return envLocale;
  }
  try {
    // ⚠️ 用 uni.getAppBaseInfo().appLanguage，不再调用已废弃的 uni.getSystemInfoSync()（微信小程序基础库会打印废弃告警）
    const appLang = uni.getAppBaseInfo().appLanguage;
    if (appLang != null && appLang.toLowerCase().includes('zh')) {
      return 'zh-CN';
    }
    if (appLang != null && appLang.toLowerCase().includes('en')) {
      return 'en-US';
    }
  }
  catch {
    // ignore
  }
  return 'zh-CN';
}

/**
 * 获取流式演示接口地址（VITE_STREAM_URL）
 *
 * 支持两种写法：
 * - 相对路径（如 /stream/chat）：自动拼接 getApiBaseUrl() 成为完整地址
 * - 完整域名（https://...）：直接使用
 *
 * 配置为空时返回空字符串，此时演示页会自动使用本地模拟流。
 */
export function getStreamUrl(): string {
  const raw = `${import.meta.env.VITE_STREAM_URL ?? ''}`.trim();
  if (raw == '') {
    return '';
  }
  if (raw.startsWith('http://') || raw.startsWith('https://')) {
    return raw;
  }
  return `${getApiBaseUrl()}${raw}`;
}

/**
 * 获取 OSS 上传基础域名（VITE_UPLOAD_BASEURL）
 */
export function getOssBaseUrl(): string {
  return `${import.meta.env.VITE_UPLOAD_BASEURL ?? 'https://xxx.com'}`;
}

/**
 * 获取 OSS 上传接口路径（VITE_UPLOAD_PATH）
 */
export function getOssUploadPath(): string {
  return `${import.meta.env.VITE_UPLOAD_PATH ?? '/gateway/user/sys/oss/upload/xxx'}`;
}

/**
 * 获取 OSS 上传完整接口地址
 */
export function getOssUploadUrl(): string {
  return `${getOssBaseUrl()}${getOssUploadPath()}`;
}

/**
 * 获取环境变量中配置的 TabBar 策略模式（0: 无, 1: 原生, 2: 带原生自定义, 3: 纯自定义, 4: 单页保活）
 */
export function getTabBarMode(): string {
  return `${import.meta.env.VITE_TABBAR_MODE ?? '1'}`.trim();
}

/**
 * 解析并获取当前环境变量中配置的 TabBar 策略模式数值（0:无, 1:原生, 2:带原生自定义, 3:纯自定义, 4:单页TabBar）
 */
export function getTabbarStrategyNum(): number {
  const envMode = getTabBarMode();
  if (envMode == '0' || envMode == 'NO_TABBAR') {
    return 0;
  }
  if (envMode == '2' || envMode == 'CUSTOM_TABBAR' || envMode == 'CUSTOM_TABBAR_WITH_NATIVE') {
    return 2;
  }
  if (envMode == '3' || envMode == 'CUSTOM_TABBAR_WITHOUT_NATIVE') {
    return 3;
  }
  if (envMode == '4' || envMode == 'SINGLE_PAGE_TABBAR') {
    return 4;
  }
  return 1;
}

/**
 * 判断当前是否为原生 TabBar 模式（VITE_TABBAR_MODE 为 1 或 NATIVE_TABBAR）
 */
export function isNativeTabBar(): boolean {
  const mode = getTabBarMode();
  return mode == '1' || mode == 'NATIVE_TABBAR';
}

/**
 * 获取当前是否为 Vapor 渲染模式（使用 uni-app X 原生编译条件 VUE3-VAPOR 判定）
 *
 * 真源是 `platform.uts` 的 `isAppXVapor` 编译期常量，这里只做函数式转发，
 * 以便与 `getCompileMode()` 等既有函数式 API 保持一致。
 */
export function isVaporMode(): boolean {
  return isAppXVapor;
}

/**
 * 获取当前运行环境类型标识（'development' | 'test' | 'production'）
 */
export function getCurrentEnv(): string {
  const buildEnvType = `${import.meta.env.VITE_ENV_TYPE ?? ''}`;
  if (buildEnvType == 'test') {
    return 'test';
  }
  return process.env.NODE_ENV == 'development' ? 'development' : 'production';
}

/**
 * 获取当前运行环境中文名称（'开发环境' | '测试环境' | '生产环境'）
 */
export function getCurrentEnvName(): string {
  // 优先从环境变量读取中文名称（.env.* 中配置 VITE_ENV_NAME）
  const envName = `${import.meta.env.VITE_ENV_NAME ?? ''}`;
  if (envName != '') {
    return envName;
  }
  return '';
}

/**
 * 便捷判断：是否为开发环境
 */
export function isDev(): boolean {
  return getCurrentEnv() == 'development';
}

/**
 * 便捷判断：是否为测试环境
 */
export function isTest(): boolean {
  return getCurrentEnv() == 'test';
}

/**
 * 便捷判断：是否为生产环境
 */
export function isProd(): boolean {
  return getCurrentEnv() == 'production';
}

/**
 * 获取当前编译目标平台中文名（如 "H5"、"Android"、"iOS"、"微信小程序" 等）
 *
 * 直接由编译期常量 `platform` 映射，不再自己铺一套条件编译：既避免与 `platform` 出现两份口径不一致的
 * 分流，也顺带绕开「只写 H5 会漏掉 Web 构建」的坑（本项目 `pnpm dev` 的 platform 是 `web` 而非 `h5`）。
 */
export function getCompilePlatform(): string {
  if (platform == 'web' || platform == 'h5') {
    return 'H5';
  }
  if (platform == 'app-android') {
    return 'Android';
  }
  if (platform == 'app-ios') {
    return 'iOS';
  }
  if (platform == 'app-harmony') {
    return 'HarmonyOS';
  }
  if (platform == 'mp-weixin') {
    return '微信小程序';
  }
  if (platform == 'mp-alipay') {
    return '支付宝小程序';
  }
  if (platform == 'mp-baidu') {
    return '百度小程序';
  }
  if (platform == 'mp-toutiao') {
    return '字节小程序';
  }
  if (platform == 'mp-kuaishou') {
    return '快手小程序';
  }
  if (platform == 'mp-qq') {
    return 'QQ小程序';
  }
  if (platform == 'mp-lark') {
    return '飞书小程序';
  }
  if (platform == 'mp-jd') {
    return '京东小程序';
  }
  if (platform == 'mp-xhs') {
    return '小红书小程序';
  }
  if (platform == 'mp-360') {
    return '360小程序';
  }
  if (platform == 'mp-harmony') {
    return '鸿蒙元服务';
  }
  try {
    // 兜底：未收录的平台按运行时 uniPlatform 原样显示
    // ⚠️ 用 uni.getAppBaseInfo().uniPlatform，不再调用已废弃的 uni.getSystemInfoSync()
    return uni.getAppBaseInfo().uniPlatform ?? '未知平台';
  }
  catch {
    return '未知平台';
  }
}

/**
 * 获取当前编译运行模式（如 "Vapor 模式 (开发)" / "VDOM 模式 (生产)"）
 */
export function getCompileMode(): string {
  const isVapor = isVaporMode();
  const modeName = isVapor ? 'Vapor 模式' : 'VDOM 模式';
  const envText = getCurrentEnv() == 'test' ? '测试' : (process.env.NODE_ENV == 'production' ? '生产' : '开发');
  return `${modeName} (${envText})`;
}

/**
 * 是否为调试态（对标 uni-env 的 `debug`）
 *
 * uni-env 的 `debug` 读的是 manifest.json 的 `debug` 字段（构建期注入），该值在 uni-app X 原生端
 * 取不到，这里落到等价语义：非生产构建即视为调试态。
 */
export const debug: boolean = !isProd();

// ==========================================
// 环境变量与运行环境工具聚合类（全端一目了然速查与单例）
// ==========================================

/**
 * 环境变量与运行环境工具聚合类
 *
 * 集中呈现所有环境变量与运行模式获取方法，一目了然；同时支持面向对象式 `env.xxx()` 调用。
 *
 * @example
 * ```uts
 * // 方式 1：标准具名导入
 * import { getApiBaseUrl, isDev } from '@/src/config/index.uts';
 *
 * // 方式 2：对象单例导入（一目了然）
 * import { env } from '@/src/config/index.uts';
 * console.log(env.getApiBaseUrl());
 * ```
 */
export class EnvUtils {
  /** 获取当前应用名称（全端从 import.meta.env 读取） */
  getAppTitle(): string {
    return getAppTitle();
  }

  /** 获取当前业务应用版本号（来自 .env 的 VITE_APP_VERSION 或兜底 1.0.0） */
  getAppVersion(): string {
    return getAppVersion();
  }

  /** 获取当前模板工程版本号（来自 package.json 的 version） */
  getTemplateVersion(): string {
    return getTemplateVersion();
  }

  /** 获取接口 BaseURL 地址（全端从 import.meta.env 读取） */
  getApiBaseUrl(): string {
    return getApiBaseUrl();
  }

  /** 获取备用接口 BaseURL 地址（全端从 import.meta.env 读取） */
  getApiSecondaryUrl(): string {
    return getApiSecondaryUrl();
  }

  /** 获取网关/微服务接口 BaseURL 地址（VITE_GATEWAY_BASEURL） */
  getGatewayBaseUrl(): string {
    return getGatewayBaseUrl();
  }

  /** 获取认证微服务接口 BaseURL 地址（VITE_AUTH_BASEURL） */
  getAuthBaseUrl(): string {
    return getAuthBaseUrl();
  }

  /** 获取 H5 是否开启反向代理（VITE_H5_USE_PROXY 开关：true 走 /api，false 直连） */
  getH5UseProxy(): boolean {
    return getH5UseProxy();
  }

  /** 获取默认主题主色调（全端从 import.meta.env 读取） */
  getDefaultTheme(): string {
    return getDefaultTheme();
  }

  /** 获取默认外观模式（全端从 import.meta.env 读取） */
  getDefaultThemeMode(): string {
    return getDefaultThemeMode();
  }

  /** 获取默认国际化语言（全端从 import.meta.env 读取，未配置时自动识别系统语言，最后兜底 zh-CN） */
  getDefaultLocale(): string {
    return getDefaultLocale();
  }

  /** 获取流式演示接口地址（VITE_STREAM_URL，相对路径会自动拼接 baseURL） */
  getStreamUrl(): string {
    return getStreamUrl();
  }

  /** 获取 OSS 上传基础域名（VITE_UPLOAD_BASEURL） */
  getOssBaseUrl(): string {
    return getOssBaseUrl();
  }

  /** 获取 OSS 上传接口路径（VITE_UPLOAD_PATH） */
  getOssUploadPath(): string {
    return getOssUploadPath();
  }

  /** 获取 OSS 上传完整接口地址 */
  getOssUploadUrl(): string {
    return getOssUploadUrl();
  }

  /** 获取环境变量中配置的 TabBar 策略模式（0: 无, 1: 原生, 2: 带原生自定义, 3: 纯自定义, 4: 单页保活） */
  getTabBarMode(): string {
    return getTabBarMode();
  }

  /** 解析并获取当前环境变量中配置的 TabBar 策略模式数值（0:无, 1:原生, 2:带原生自定义, 3:纯自定义, 4:单页TabBar） */
  getTabbarStrategyNum(): number {
    return getTabbarStrategyNum();
  }

  /** 判断当前是否为原生 TabBar 模式（VITE_TABBAR_MODE 为 1 或 NATIVE_TABBAR） */
  isNativeTabBar(): boolean {
    return isNativeTabBar();
  }

  /** 获取当前是否为 Vapor 渲染模式（使用 uni-app X 原生编译条件 VUE3-VAPOR 判定） */
  isVaporMode(): boolean {
    return isVaporMode();
  }

  /** 获取当前运行环境类型标识（'development' | 'test' | 'production'） */
  getCurrentEnv(): string {
    return getCurrentEnv();
  }

  /** 获取当前运行环境中文名称（'开发环境' | '测试环境' | '生产环境'） */
  getCurrentEnvName(): string {
    return getCurrentEnvName();
  }

  /** 便捷判断：是否为开发环境 */
  isDev(): boolean {
    return isDev();
  }

  /** 便捷判断：是否为测试环境 */
  isTest(): boolean {
    return isTest();
  }

  /** 便捷判断：是否为生产环境 */
  isProd(): boolean {
    return isProd();
  }

  /** 获取当前编译目标平台（如 "H5"、"Android"、"iOS"、"微信小程序" 等） */
  getCompilePlatform(): string {
    return getCompilePlatform();
  }

  /** 获取当前编译运行模式（如 "Vapor 模式 (开发)" / "VDOM 模式 (生产)"） */
  getCompileMode(): string {
    return getCompileMode();
  }

  /** 获取打包构建时间 */
  getBuildTime(): string {
    return getBuildTime();
  }

  /** 获取 Git Commit 简写哈希 */
  getGitCommitHash(): string {
    return getGitCommitHash();
  }

  /** 获取 Git 当前打包分支名称 */
  getGitBranch(): string {
    return getGitBranch();
  }
}

/** 环境变量与运行环境工具全局单例 */
export const env = new EnvUtils();

/** 别名导出 */
export const envUtils = env;

export default env;
