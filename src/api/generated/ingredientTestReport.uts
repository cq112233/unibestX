// @ts-ignore
import { request, buildBodyRequestConfig } from '@/src/http/openapi.uts';
import type { OpenApiRequestOptions } from '@/src/http/openapi.uts';

import * as API from './types.uts';

/** 食材检测记录报表 POST /gateway/ingredientTestReport/page */
export type IngredientTestReportPageUsingPostRequestParams = {
  body: API.IngredientTestReportPageUsingPostBody;
  options?: OpenApiRequestOptions;
};

export function ingredientTestReportPageUsingPost(requestParams: IngredientTestReportPageUsingPostRequestParams) {
  return request<API.IngredientTestReportPageUsingPostResponse>(
    '/gateway/ingredientTestReport/page',
    buildBodyRequestConfig('POST', requestParams.body, requestParams.options, 'application/x-www-form-urlencoded')
  );
}
