// @ts-ignore
import { request, buildBodyRequestConfig } from '@/src/http/openapi.uts';
import type { OpenApiRequestOptions } from '@/src/http/openapi.uts';

import * as API from './types.uts';

/** 晨间记录 POST /gateway/morningCheckReport/page */
export type MorningCheckReportPageUsingPostRequestParams = {
  body: API.MorningCheckReportPageUsingPostBody;
  options?: OpenApiRequestOptions;
};

export function morningCheckReportPageUsingPost(requestParams: MorningCheckReportPageUsingPostRequestParams) {
  return request<API.MorningCheckReportPageUsingPostResponse>(
    '/gateway/morningCheckReport/page',
    buildBodyRequestConfig('POST', requestParams.body, requestParams.options)
  );
}
