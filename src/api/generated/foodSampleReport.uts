// @ts-ignore
import { request, buildBodyRequestConfig } from '@/src/http/openapi.uts';
import type { OpenApiRequestOptions } from '@/src/http/openapi.uts';

import * as API from './types.uts';

/** 留样记录菜品明细 POST /gateway/foodSampleReport/dishDetail */
export type FoodSampleReportDishDetailUsingPostRequestParams = {
  body: API.FoodSampleReportDishDetailUsingPostBody;
  options?: OpenApiRequestOptions;
};

export function foodSampleReportDishDetailUsingPost(requestParams: FoodSampleReportDishDetailUsingPostRequestParams) {
  return request<API.FoodSampleReportDishDetailUsingPostResponse>(
    '/gateway/foodSampleReport/dishDetail',
    buildBodyRequestConfig('POST', requestParams.body, requestParams.options)
  );
}

/**  留样记录报表分页列表 POST /gateway/foodSampleReport/page */
export type FoodSampleReportPageUsingPostRequestParams = {
  body: API.FoodSampleReportPageUsingPostBody;
  options?: OpenApiRequestOptions;
};

export function foodSampleReportPageUsingPost(requestParams: FoodSampleReportPageUsingPostRequestParams) {
  return request<API.FoodSampleReportPageUsingPostResponse>(
    '/gateway/foodSampleReport/page',
    buildBodyRequestConfig('POST', requestParams.body, requestParams.options)
  );
}
