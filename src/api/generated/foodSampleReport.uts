}: {
  body: API.FoodSampleReportPageUsingPostBody;
  options?: OpenApiRequestOptions;
}) {
  return request<API.FoodSampleReportPageUsingPostResponse>(
    '/gateway/foodSampleReport/page',
    {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      data: body,
      ...(options || {
      }),
    }
  );
}
