import { request, buildBodyRequestConfig } from '@/src/http/openapi.uts';
import type { OpenApiRequestOptions } from '@/src/http/openapi.uts';

import * as API from './types.uts';

/** 专间消毒记录报表 POST /gateway/roomDisinfectionReport/page */
export type RoomDisinfectionReportPageUsingPostRequestParams = {
  body: API.RoomDisinfectionReportPageUsingPostBody;
  options?: OpenApiRequestOptions;
};

export function roomDisinfectionReportPageUsingPost(requestParams: RoomDisinfectionReportPageUsingPostRequestParams) {
  return request<API.RoomDisinfectionReportPageUsingPostResponse>(
    '/gateway/roomDisinfectionReport/page',
    buildBodyRequestConfig('POST', requestParams.body, requestParams.options)
  );
}
