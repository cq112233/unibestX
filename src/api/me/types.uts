/**
 * 个人中心契约类型
 * 遵循 unibestX-skill 规范：一律使用 type，严禁 interface，空值一律 null
 */

/**
 * 个人信息展示模型
 */
export type UserProfile = {
  userId: number;
  username: string;
  nickname: string;
  avatar: string;
  isLogin: boolean;
};

/**
 * 个人中心功能菜单项
 */
export type UserMenuItem = {
  id: string;
  title: string;
  icon: string;
  badge?: string | null;
  route?: string | null;
};
