import { secondaryHttp } from '@/src/http/index.uts';
import type { HttpRequestConfig } from '@/uni_modules/request-bestX/index.uts';

// ==========================================
// 1. 类型定义（遵循规范：一律使用 type，严禁 interface）
// ==========================================

/**
 * 图形验证码响应数据结构
 */
export type CaptchaResult = {
  /** 验证码唯一标识 ID */
  captchaId: string;
  /** 验证码明文文本 */
  captchaCode: string;
  /** 验证码 SVG 图像文本 */
  captchaImage: string;
};

/** 兼容别名 */
export type BigScreenData = CaptchaResult;
export type bigScreenData = CaptchaResult;

/**
 * 登录请求参数
 */
export type LoginParams = {
  username: string;
  password: string;
  captchaId: string;
  captchaCode: string;
};

/**
 * 登录用户信息
 */
export type UserInfo = {
  id: number;
  username: string;
  email?: string | null;
  isSuperAdmin?: boolean | null;
  createdAt?: string | null;
  updatedAt?: string | null;
};

/**
 * 登录响应数据结构
 */
export type LoginResult = {
  access_token: string;
  refresh_token: string;
  user: UserInfo;
};

// ==========================================
// 2. 内部工具函数
// ==========================================

function toJsonObject(raw: UTSJSONObject): UTSJSONObject {
  if (raw instanceof UTSJSONObject) {
    return raw;
  }
  const parsed = JSON.parseObject(JSON.stringify(raw));
  return parsed != null ? parsed : raw;
}

// ==========================================
// 3. API 接口函数
// ==========================================

/**
 * 获取图形验证码
 *
 * 请求地址：GET http://localhost:3000/api/auth/captcha
 * 请求实例：secondaryHttp（基础地址配置为 http://localhost:3000，H5 代理前缀为 /api-bigScreen）
 *
 * @returns 包含 captchaId、captchaCode 与 captchaImage(SVG) 的强类型 DTO
 */
export function fetchBigScreenData(): Promise<CaptchaResult> {
  return secondaryHttp.get<UTSJSONObject>('/api/auth/captcha', {
    extra: { ignoreAuth: true } as UTSJSONObject
  } as HttpRequestConfig).then((raw: UTSJSONObject): CaptchaResult => {
    const obj = toJsonObject(raw);
    return {
      captchaId: obj.getString('captchaId') ?? '',
      captchaCode: obj.getString('captchaCode') ?? '',
      captchaImage: obj.getString('captchaImage') ?? ''
    } as CaptchaResult;
  });
}

/** 语义化别名：获取验证码 */
export const fetchCaptcha = fetchBigScreenData;

/**
 * 用户登录接口
 *
 * 请求地址：POST http://localhost:3000/api/auth/login
 * @param params 登录请求参数（包含 username、password、captchaId、captchaCode）
 * @returns 包含 access_token、refresh_token 与 user 信息的强类型 DTO
 */
export function loginBigScreen(params: LoginParams): Promise<LoginResult> {
  const requestData: UTSJSONObject = {
    username: params.username,
    password: params.password,
    captchaId: params.captchaId,
    captchaCode: params.captchaCode
  };
  const requestConfig: HttpRequestConfig = {
    extra: { ignoreAuth: true, toast: false } as UTSJSONObject
  };

  return secondaryHttp.post<UTSJSONObject>('/api/auth/login', requestData, requestConfig).then((raw: UTSJSONObject): LoginResult => {
    const obj = toJsonObject(raw);
    const userRaw = obj.get('user') as UTSJSONObject | null;
    const userObj = userRaw != null ? toJsonObject(userRaw) : null;

    const user: UserInfo = {
      id: userObj != null ? (userObj.getNumber('id') ?? 0) : 0,
      username: userObj != null ? (userObj.getString('username') ?? '') : '',
      email: userObj != null ? userObj.getString('email') : null,
      isSuperAdmin: userObj != null ? userObj.getBoolean('isSuperAdmin') : null,
      createdAt: userObj != null ? userObj.getString('createdAt') : null,
      updatedAt: userObj != null ? userObj.getString('updatedAt') : null
    };

    return {
      access_token: obj.getString('access_token') ?? '',
      refresh_token: obj.getString('refresh_token') ?? '',
      user
    } as LoginResult;
  });
}

/** 语义化别名：用户登录 */
export const login = loginBigScreen;
