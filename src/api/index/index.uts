import { MOCK_FEATURES, MOCK_TEMPLATE_META } from './mock/feature.uts';
import type { FeatureItem, TemplateMeta } from './types.uts';

export type { FeatureItem, TemplateMeta } from './types.uts';

// ==========================================
// 首页 API 接口（对应 src/pages/index/）
// 遵循规范：开发期返回本地 Mock，后端就绪只换函数体
// ==========================================

// ------------------------------------------
// 【特性列表段】
// ------------------------------------------

/**
 * 获取首页核心特性列表
 */
export function fetchFeatureList(): Promise<Array<FeatureItem>> {
  return Promise.resolve(MOCK_FEATURES);
}

// ------------------------------------------
// 【模板元数据段】
// ------------------------------------------

/**
 * 获取模板简介与官方元数据
 */
export function fetchTemplateMeta(): Promise<TemplateMeta> {
  return Promise.resolve(MOCK_TEMPLATE_META);
}
