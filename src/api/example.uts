// ==========================================
// 接口层写法参照（非页面接口层，不对应任何页面）
//
// 本文件不对应具体页面，因此不受分册 7 的「一页一目录」落位约束；
// 它的用途是演示 api 层的标准写法：契约类型 / mock 数据集 / 接口函数三块，
// 以及 http.get / http.upload / http.download 的正确调用方式，供新增页面时照抄。
//
// 新增真实页面请一律建 src/api/<页面目录名>/<页面目录名>.uts，不要改本文件。
// ==========================================

import { getOssUploadPath } from '@/src/config/index.uts';
import { API_DOMAINS, http } from '@/src/http/index.uts';
import type { DownloadResult } from '@/src/http/index.uts';
import type { LimeRequestConfig, LimeRequestTask } from '@/uni_modules/lime-request';

export const FOO_UPLOAD_PATH: string = getOssUploadPath();

/**
 * 下载演示用的示例资源地址（公开可访问的图片，供下载 Demo 直接使用）
 */
export const FOO_DOWNLOAD_URL: string = 'https://web-assets.dcloud.net.cn/unidoc/zh/unicloudlogo.png';

// ==========================================
// 1. 类型定义（遵循规范：一律使用 type，严禁 interface）
// ==========================================

export type FooItem = {
  id: number;
  name: string;
  desc: string;
};

export type PageResult<T> = {
  list: Array<T>;
  hasMore: boolean;
  total: number;
};

// ==========================================
// 2. 本地模拟数据集（模块内私有闭环）
// ==========================================

const MOCK_FOO_LIST: Array<FooItem> = [
  { id: 1, name: 'unix', desc: 'uni-app X 核心架构' },
  { id: 2, name: 'UnibestX', desc: '最好用的 uni-app X 跨端开发模板' },
  { id: 3, name: 'lime-request', desc: '高性能轻量级网络请求库' },
  { id: 4, name: 'weapp-tailwindcss', desc: '全平台原子化样式解决方案' },
  { id: 5, name: 'vitest', desc: '极速轻量单元测试框架' }
];

// ==========================================
// 3. API 接口函数
// 遵循规范：开发期返回本地 Mock，后端就绪只换函数体，签名冻结
// ==========================================

/**
 * 分页查询 Foo 列表（支持关键字筛选与分页）
 * 分页三件套按规范顺序 (pageNo, pageSize, keyword)，默认值齐全、后端就绪不改签名
 * @param pageNo 当前页码（默认 1）
 * @param pageSize 分页大小（默认 10）
 * @param keyword 搜索关键字（默认空字符串）
 */
export function fetchFooList(pageNo: number = 1, pageSize: number = 10, keyword: string = ''): Promise<PageResult<FooItem>> {
  let filtered = MOCK_FOO_LIST;
  if (keyword.length > 0) {
    filtered = MOCK_FOO_LIST.filter((item: FooItem): boolean => {
      return item.name.toLowerCase().includes(keyword.toLowerCase());
    });
  }

  const offset = (pageNo - 1) * pageSize;
  const list = offset < filtered.length
    ? filtered.slice(offset, offset + pageSize)
    : [] as Array<FooItem>;

  // ⚠️ 断言必须直接写泛型本体、实参写全 `PageResult<FooItem>`，严禁改用泛型实例化别名：
  // 若定义 `type FooPageResult = PageResult<FooItem>` 后写 `as FooPageResult`，UTS 会把该断言
  // 编译成构造调用 `new FooPageResult({...})`，而产物里只生成了 `class PageResult`
  // （别名只是编译期 type、没有运行期绑定）⇒ 小程序 / App 端抛 `ReferenceError: FooPageResult is not defined`。
  // 口诀：`as` / `new` 后面不许出现泛型实例化别名，类型位置（返回值标注 / 回调参数标注）才可以用别名。
  return Promise.resolve({
    list,
    hasMore: offset + pageSize < filtered.length,
    total: filtered.length
  } as PageResult<FooItem>);
}

/**
 * 根据 ID 查询单条 Foo 详情
 * @param id Foo 的主键；**查不到时 resolve 为 null 而非 reject**，调用方必须自行判空
 */
export function fetchFooById(id: number): Promise<FooItem | null> {
  const found = MOCK_FOO_LIST.find((item: FooItem): boolean => item.id == id);
  return Promise.resolve(found != null ? found : null);
}

/**
 * 新增 Foo
 * @param data 待新增的 Foo；`id <= 0` 时由本地用 `Date.now()` 兜底生成，大于 0 则沿用传入值
 */
export function createFoo(data: FooItem): Promise<FooItem> {
  const newItem: FooItem = {
    id: data.id > 0 ? data.id : Date.now(),
    name: data.name,
    desc: data.desc
  };
  MOCK_FOO_LIST.unshift(newItem);
  return Promise.resolve(newItem);
}

/**
 * 更新 Foo
 * @param id 目标 Foo 主键；**匹配不到时不做报错，直接把入参 data 原样返回**
 * @param data 新字段值（整条替换 name / desc，最终 id 以形参 id 为准）
 */
export function updateFoo(id: number, data: FooItem): Promise<FooItem> {
  const index = MOCK_FOO_LIST.findIndex((item: FooItem): boolean => item.id == id);
  if (index >= 0) {
    MOCK_FOO_LIST[index] = { id, name: data.name, desc: data.desc } as FooItem;
    return Promise.resolve(MOCK_FOO_LIST[index]);
  }
  return Promise.resolve(data);
}

/**
 * 删除 Foo
 * @param id 目标 Foo 主键；**主键不存在时同样 resolve(true)** —— mock 阶段不区分「删成功」与「本就不存在」
 */
export function deleteFoo(id: number): Promise<boolean> {
  const index = MOCK_FOO_LIST.findIndex((item: FooItem): boolean => item.id == id);
  if (index >= 0) {
    MOCK_FOO_LIST.splice(index, 1);
  }
  return Promise.resolve(true);
}

/**
 * 真实远程接口调用示范（http.get）
 */
export function fetchFooRemote(): Promise<FooItem> {
  return http.get<UTSJSONObject>('/foo', {
    params: {
      name: 'unix',
      page: 1,
      pageSize: 10
    } as UTSJSONObject,
    baseURL: API_DOMAINS.SECONDARY,
    extra: {
      ignoreAuth: true
    } as UTSJSONObject
  } as LimeRequestConfig).then((data: UTSJSONObject): FooItem => {
    // ⚠️ `??` 兜底不可省：getNumber / getString 返回的是可空类型（`Number?` / `String?`），
    // 直接赋给 FooItem 的非空字段会被 Kotlin 编译拒绝（error17 参数类型不匹配）。
    return {
      id: data.getNumber('id') ?? 1,
      name: data.getString('name') ?? '',
      desc: data.getString('desc') ?? ''
    } as FooItem;
  });
}

/**
 * 上传文件示例
 * @param filePath 本地文件路径
 * @param ignoreAuth 是否跳过鉴权
 * @param uploadPathOrUrl 上传目标路径
 */
export function uploadFooFile(
  filePath: string,
  ignoreAuth: boolean = false,
  uploadPathOrUrl: string = FOO_UPLOAD_PATH
): Promise<string> {
  const extra = {} as UTSJSONObject;
  if (ignoreAuth) {
    extra.set('ignoreAuth', true);
  }
  const config = {
    filePath,
    name: 'file',
    extra
  } as LimeRequestConfig;
  return http.upload<string>(uploadPathOrUrl, config);
}

/**
 * 下载文件示例（http.downloadFile）
 *
 * 底层走 lime-request 的 DOWNLOAD 分支（内部 uni.downloadFile），
 * 自动复用统一的鉴权头注入、错误提示与完成钩子，成功后返回
 * DownloadResult（临时文件路径 + HTTP 状态码）。
 *
 * @param url 下载地址（支持完整 http(s) 地址；相对路径会与 baseURL 拼接）
 * @param onProgress 下载进度回调（progress 为 0~100 的百分比），不需要进度时传 null
 */
export function downloadFooFile(
  url: string,
  onProgress: ((progress: number) => void) | null = null
): Promise<DownloadResult> {
  const extra = {} as UTSJSONObject;
  extra.set('ignoreAuth', true);
  // 先把回调落到局部常量：嵌套 lambda 内直接对可空参数做智能转换在原生端不可靠
  const progressCallback = onProgress;
  const config = {
    extra,
    getTask: (task: LimeRequestTask): void => {
      // 仅 DOWNLOAD 任务具备进度监听能力，把原生进度回调给业务层
      const downloadTask = task as DownloadTask;
      if (progressCallback != null) {
        downloadTask.onProgressUpdate((res: OnProgressDownloadResult): void => {
          progressCallback(res.progress);
        });
      }
    }
  } as LimeRequestConfig;
  return http.downloadFile(url, config);
}
