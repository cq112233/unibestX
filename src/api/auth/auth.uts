import { http } from '@/src/http/index.uts';
import type { HttpRequestConfig } from '@/uni_modules/request-bestX/index.uts';

// ==========================================
// 1. 类型定义（遵循规范：一律使用 type，严禁 interface）
// ==========================================

export type LoginQuery = {
  username: string;
  password: string;
};

export type AuthUserInfo = {
  userId: number;
  username: string;
  nickname: string;
  avatar: string;
  roles: Array<string>;
  permissions?: Array<string> | null;
};

export type LoginResult = {
  token: string;
  expiresIn: number;
  /** 双 token 模式：用于 401 时静默换取新 accessToken */
  refreshToken: string;
  refreshExpiresIn: number;
  userInfo: AuthUserInfo;
};

export type RefreshTokenQuery = {
  refreshToken: string;
};

export type RefreshTokenResult = {
  accessToken: string;
  accessExpiresIn: number;
  refreshToken: string;
  refreshExpiresIn: number;
};

// ==========================================
// 2. 本地模拟数据集
// ==========================================

const MOCK_USER_INFO: AuthUserInfo = {
  userId: 1001,
  username: 'UNIX',
  nickname: 'UNIX 开发者',
  avatar: '/static/logo.png',
  roles: ['admin', 'developer'],
  permissions: ['*']
};

const MOCK_LOGIN_RESULT: LoginResult = {
  token: 'mock-token-UNIX-123456',
  expiresIn: 7200,
  refreshToken: 'mock-refresh-UNIX-654321',
  refreshExpiresIn: 604800,
  userInfo: MOCK_USER_INFO
};

// ==========================================
// 3. API 接口函数
// ==========================================

/**
 * 用户登录接口
 * 运行 pnpm dev:mock 时发起网络请求并由根目录 mock/auth.ts 拦截响应
 * 离线无服务时平滑降级回退到本地 UTS Mock 数据
 * @param params 登录表单（username / password，两者都不可为空）；
 *               该请求带 `extra.ignoreAuth`，**不注入 token、401 也不会触发刷新**
 */
export function loginApi(params: LoginQuery): Promise<LoginResult> {
  return http.post<UTSJSONObject>('/auth/login', params, {
    extra: {
      ignoreAuth: true
    } as UTSJSONObject
  } as HttpRequestConfig).then((data: UTSJSONObject): LoginResult => {
    const rawUser = data.get('userInfo') as UTSJSONObject | null;
    // ⚠️ 必须写 `getArray<string>(...)`：UTS 无法从默认值反推元素类型，省略泛型实参会被
    // Kotlin 编译拒绝（`推断类型是 UTSArray<*>`，预期 `UTSArray<String>?`，实测于 app-android）。
    // 代价：TS 侧 UTSJSONObject 是纯索引签名声明（见 src/types/uni.d.ts），其 getArray 为 any，
    // 对 any 传类型实参报 TS2347 —— 故用 @ts-expect-error 抑制；UTS 编译不受影响。
    // @ts-expect-error UTS 编译要求显式泛型实参；TS 侧 getArray 为 any 会报 TS2347
    const rawRoles = rawUser?.getArray<string>('roles', [] as Array<string>) ?? ([] as Array<string>);

    return {
      token: data.getString('token') ?? `mock-token-${Date.now()}`,
      expiresIn: data.getNumber('expiresIn') ?? 7200,
      refreshToken: data.getString('refreshToken') ?? `mock-refresh-${Date.now()}`,
      refreshExpiresIn: data.getNumber('refreshExpiresIn') ?? 604800,
      userInfo: {
        userId: rawUser?.getNumber('userId') ?? 1001,
        username: rawUser?.getString('username') ?? params.username,
        nickname: rawUser?.getString('nickname') ?? (params.username == 'admin' ? '超级管理员' : 'UNIX 开发者'),
        avatar: rawUser?.getString('avatar') ?? '/static/logo.png',
        roles: rawRoles.length > 0 ? rawRoles : ['admin']
      } as AuthUserInfo
    } as LoginResult;
  }, (_err: any): LoginResult => {
    const fallback: LoginResult = {
      token: MOCK_LOGIN_RESULT.token,
      expiresIn: MOCK_LOGIN_RESULT.expiresIn,
      refreshToken: MOCK_LOGIN_RESULT.refreshToken,
      refreshExpiresIn: MOCK_LOGIN_RESULT.refreshExpiresIn,
      userInfo: {
        userId: MOCK_USER_INFO.userId,
        username: params.username.length > 0 ? params.username : MOCK_USER_INFO.username,
        nickname: params.username == 'admin' ? '超级管理员' : MOCK_USER_INFO.nickname,
        avatar: MOCK_USER_INFO.avatar,
        roles: MOCK_USER_INFO.roles
      } as AuthUserInfo
    };
    return fallback;
  });
}

/**
 * 获取当前登录用户信息
 */
export function fetchUserInfoApi(): Promise<AuthUserInfo> {
  return http.get<UTSJSONObject>('/user/info').then((data: UTSJSONObject): AuthUserInfo => {
    // ⚠️ 同上：必须写 `getArray<string>(...)`（UTS 要求显式泛型实参，TS 侧靠 @ts-expect-error 抑制 TS2347）
    // @ts-expect-error UTS 编译要求显式泛型实参；TS 侧 getArray 为 any 会报 TS2347
    const rawRoles = data.getArray<string>('roles', [] as Array<string>) ?? ([] as Array<string>);
    return {
      userId: data.getNumber('userId') ?? 1001,
      username: data.getString('username') ?? 'admin',
      nickname: data.getString('nickname') ?? 'UNIX 极客开发者',
      avatar: data.getString('avatar') ?? '/static/logo.png',
      roles: rawRoles.length > 0 ? rawRoles : ['admin', 'developer']
    } as AuthUserInfo;
  }, (_err: any): AuthUserInfo => {
    return MOCK_USER_INFO;
  });
}

/**
 * 刷新 accessToken
 *
 * ⚠️ extra.skipRefresh 必须保留：该标记让 request.uts 的拦截器在本次请求 401 时
 * 直接失败、不再触发刷新，否则刷新接口自身 401 会形成无限递归。
 * @param params 刷新凭证，只需 `refreshToken`（一般取自 tokenStore 里持久化的那一份）
 */
export function refreshAccessTokenApi(params: RefreshTokenQuery): Promise<RefreshTokenResult> {
  return http.post<UTSJSONObject>('/auth/refresh', params, {
    extra: {
      skipRefresh: true,
      ignoreAuth: true,
      toast: false
    } as UTSJSONObject
  } as HttpRequestConfig).then((data: UTSJSONObject): RefreshTokenResult => {
    return {
      accessToken: data.getString('accessToken') ?? data.getString('token') ?? '',
      accessExpiresIn: data.getNumber('accessExpiresIn') ?? 7200,
      refreshToken: data.getString('refreshToken') ?? params.refreshToken,
      refreshExpiresIn: data.getNumber('refreshExpiresIn') ?? 604800
    } as RefreshTokenResult;
  }, (_err: any): RefreshTokenResult => {
    const fallback: RefreshTokenResult = {
      accessToken: `mock-token-refreshed-${Date.now()}`,
      accessExpiresIn: 7200,
      refreshToken: params.refreshToken,
      refreshExpiresIn: 604800
    };
    return fallback;
  });
}

/**
 * 退出登录接口
 */
export function logoutApi(): Promise<boolean> {
  return http.post<any>('/auth/logout').then((_data: any): boolean => {
    return true;
  }, (_err: any): boolean => {
    return true;
  });
}
