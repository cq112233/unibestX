import { API_DOMAINS, http } from '@/src/http/request.uts';
import type { LimeRequestConfig } from '@/uni_modules/lime-request';
import { DEFAULT_OSS_UPLOAD_PATH, uploadFile } from '@/src/utils/upload/index.uts';
import type { UploadFileOptions } from '@/src/utils/upload/index.uts';
import { MOCK_FOO_LIST } from './mock/foo.uts';
import type { FooItem, FooPageResult } from './types.uts';

export const FOO_UPLOAD_PATH: string = DEFAULT_OSS_UPLOAD_PATH;

// ==========================================
// Foo 模块 API 函数
// 遵循规范：开发期返回本地 Mock，后端就绪只换函数体
// ==========================================

/**
 * 分页获取 Foo 列表（支持关键字筛选与分页）
 * @param keyword 搜索关键字（默认空字符串）
 * @param pageNo 当前页码（默认 1）
 * @param pageSize 分页大小（默认 10）
 */
export function fetchFooList(keyword: string = '', pageNo: number = 1, pageSize: number = 10): Promise<FooPageResult> {
  // 【Mock 实现】：支持真实过滤与分页逻辑
  let filtered = MOCK_FOO_LIST;
  if (keyword.length > 0) {
    filtered = MOCK_FOO_LIST.filter((item: FooItem): boolean => {
      return item.name.toLowerCase().includes(keyword.toLowerCase());
    });
  }

  const offset = (pageNo - 1) * pageSize;
  const list = offset < filtered.length
    ? filtered.slice(offset, offset + pageSize)
    : [] as Array<FooItem>;

  const hasMore = offset + pageSize < filtered.length;

  return Promise.resolve({
    list,
    hasMore,
    total: filtered.length
  } as FooPageResult);
}

/**
 * 根据 ID 查询单个 Foo 详情
 */
export function fetchFooById(id: number): Promise<FooItem | null> {
  const found = MOCK_FOO_LIST.find((item: FooItem): boolean => item.id == id);
  return Promise.resolve(found != null ? found : null);
}

/**
 * 新建 Foo 实体
 */
export function createFoo(data: FooItem): Promise<FooItem> {
  const newId = data.id > 0 ? data.id : Date.now();
  const newItem: FooItem = {
    id: newId,
    name: data.name,
    desc: data.desc
  };
  MOCK_FOO_LIST.unshift(newItem);
  return Promise.resolve(newItem);
}

/**
 * 更新 Foo 实体
 */
export function updateFoo(id: number, data: FooItem): Promise<FooItem> {
  const index = MOCK_FOO_LIST.findIndex((item: FooItem): boolean => item.id == id);
  if (index >= 0) {
    MOCK_FOO_LIST[index] = { id, name: data.name, desc: data.desc } as FooItem;
    return Promise.resolve(MOCK_FOO_LIST[index]);
  }
  return Promise.resolve(data);
}

/**
 * 删除 Foo 实体
 */
export function deleteFoo(id: number): Promise<boolean> {
  const index = MOCK_FOO_LIST.findIndex((item: FooItem): boolean => item.id == id);
  if (index >= 0) {
    MOCK_FOO_LIST.splice(index, 1);
  }
  return Promise.resolve(true);
}

// ------------------------------------------
// 【远程真实对接示例】：后端就绪时只需将上述函数体切换为下列实现
// ------------------------------------------

/**
 * GET 请求真实接口示范
 */
export function fetchFooRemote(): Promise<FooItem> {
  return http.get<UTSJSONObject>('/foo', {
    params: {
      name: 'unix',
      page: 1,
      pageSize: 10
    } as UTSJSONObject,
    baseURL: API_DOMAINS.SECONDARY,
    extra: {
      ignoreAuth: true
    } as UTSJSONObject
  } as LimeRequestConfig).then((data: UTSJSONObject): FooItem => {
    return {
      id: data.getNumber('id') ?? 1,
      name: data.getString('name') ?? '',
      desc: data.getString('desc') ?? ''
    } as FooItem;
  });
}

/**
 * POST 远程真实创建接口示范
 */
export function createFooRemote(data: FooItem): Promise<FooItem> {
  return http.post<UTSJSONObject>('/foo', data).then((res: UTSJSONObject): FooItem => {
    return {
      id: res.getNumber('id') ?? Date.now(),
      name: res.getString('name') ?? data.name,
      desc: res.getString('desc') ?? data.desc
    } as FooItem;
  });
}

/**
 * PUT 远程真实更新接口示范
 */
export function updateFooRemote(id: number, data: FooItem): Promise<FooItem> {
  return http.put<UTSJSONObject>(`/foo/${id}`, data).then((res: UTSJSONObject): FooItem => {
    return {
      id: res.getNumber('id') ?? id,
      name: res.getString('name') ?? data.name,
      desc: res.getString('desc') ?? data.desc
    } as FooItem;
  });
}

/**
 * DELETE 远程真实删除接口示范
 */
export function deleteFooRemote(id: number): Promise<boolean> {
  return http.delete<any>(`/foo/${id}`).then((_res: any): boolean => {
    return true;
  });
}

/**
 * 上传文件示例
 * @param filePath 本地文件路径
 * @param ignoreAuth 是否跳过鉴权
 * @param uploadPathOrUrl 上传目标路径
 */
export function uploadFooFile(
  filePath: string,
  ignoreAuth: boolean = false,
  uploadPathOrUrl: string = FOO_UPLOAD_PATH
): Promise<string> {
  return uploadFile({
    url: uploadPathOrUrl,
    filePath,
    formData: null,
    ignoreAuth
  } as UploadFileOptions);
}

// ==========================================
// 历史兼容别名函数（保障既有工程平滑过渡）
// ==========================================

export function getFooList(params: UTSJSONObject | null = null): Promise<Array<FooItem>> {
  const keyword = params?.getString('name') ?? '';
  return fetchFooList(keyword, 1, 100).then((res: FooPageResult): Array<FooItem> => res.list);
}

export function getFooById(id: number): Promise<FooItem | null> {
  return fetchFooById(id);
}

export function foo(): Promise<FooItem> {
  return fetchFooRemote();
}
