/**
 * 【规则 1】登录规则 + 登录态装配 —— 业务开发者主战场
 *
 * 「什么算已登录、哪些页面要登录、未登录往哪跳、已登录又点进登录页怎么办」全在本文件。
 * 框架侧（../interceptor/interceptor.uts）只做管道：归一化 URL → 调 ./index.uts 的
 * runRouterGuard() 拿回裁决；那一个入口内部才转到这里 —— 先 buildGuardContext() 装配上下文
 * （本文件下面的函数），再交给 guardRoute() 编排。**框架侧看不到「登录」二字**。
 *
 * ## 改规则改哪儿
 * - 免登录名单（`EXCLUDE_LOGIN_PATH_LIST`）、登录页路径（`LOGIN_PAGE`）、黑白名单策略开关
 *   （`isNeedLoginMode`）在 ../config/config.uts；
 * - **「什么算已登录」的口径在 store**：src/store/vdom/token.uts 与 vapor/token.uts 的
 *   `hasValidLogin()`（token 存在且未过期）。要改成「游客也算登录」「必须有用户信息才算」，
 *   改 store 那个方法；
 * - 把口径读进上下文 = 下面的 buildGuardContext()，**全项目只有它读 store**；
 * - 裁决逻辑 = 下面的 guardLogin()（六种组合见它的注释）。
 *
 * ## 要加别的规则
 * 别在这个文件里加分支。新建 `./guardXxx.uts`（形状照抄本文件的 guardLogin），再到 ./index.uts
 * 的 guardRoute() 里按优先级链上去 —— 一条规则一个文件，各自可单测。
 * 新规则要用的业务信号（如 isVip）：给 ./types.uts 的 RouteGuardContext 补字段 + 在下面的
 * buildGuardContext() 里取值（信号多到塞不下时，再把装配单独拆一个文件）。
 *
 * ## 四条必须守住的约束
 * 1. **规则只返回决策，不许自己调 `uni.navigateTo` / `uni.switchTab`**：拦截器只在**放行**时
 *    才把目标路由写进 useRoute 状态（见 ../interceptor/interceptor.uts 的 markTargetRoute），
 *    规则自己跳转会绕过这个不变量 —— 新页面首帧会读到上一页的路由。返回 `block('url')` 即可：
 *    框架会替你跳，并自动识别 TabBar 页面改走 switchTab。
 * 2. **只能是同步的**：`uni.addInterceptor` 的 invoke 必须同步返回 boolean，规则既不能 `async`
 *    也不能返回 Promise。需要异步（如先拉用户信息再判权限）时，只能「先拦下、异步完成后再重新
 *    发起跳转」—— 该模式本次不提供，别以为是漏了。
 * 3. **规则必须是纯函数**：只看 ctx、只返回裁决；不改入参、不读写模块级状态 —— 所以「取 store」
 *    这件事留在 buildGuardContext()（框架每跳一次调一次，结果作为快照塞进 ctx），别挪进
 *    guardLogin()。否则 ./index.uts 那边「整条链的裁决 == 本规则的裁决」的等价测试就废了。
 * 4. **禁止 `interface`、空值一律 `null`、基础类型比较一律 `==` / `!=`**（UTS 强类型铁律）。
 */
import { useTokenStore } from '@/src/store/index.uts';
import { EXCLUDE_LOGIN_PATH_LIST, isNeedLoginMode, LOGIN_PAGE } from '../config/config.uts';
import type { GuardResult, RouteGuardContext } from './types.uts';

/** 已登录却又点进登录页、且没带 redirect 参数时的兜底目标 */
export const DEFAULT_HOME_PAGE = '/src/pages/index/index';

/**
 * 判断路径是否符合排除登录校验名单 (EXCLUDE_LOGIN_PATH_LIST)
 * @param path 页面路径，可省略前导斜杠（`src/xxx` 会补成 `/src/xxx` 后再比）；
 *             与名单做**全等匹配**，不支持前缀 / 通配 —— 加白名单必须写完整路径
 */
export function judgeIsExcludePath(path: string): boolean {
  let normalizedPath = path;
  if (normalizedPath.startsWith('src/')) {
    normalizedPath = `/${normalizedPath}`;
  }
  return EXCLUDE_LOGIN_PATH_LIST.includes(normalizedPath);
}

/**
 * 登录规则：裁决本次导航是否放行（登录态 × 黑白名单策略）
 *
 * 登录态直接由本业务守卫调用 tokenStore 获取，不污染通用的 RouteGuardContext 契约。
 * 要改登录口径就改 store（hasValidLogin），别在别处加登录判断。
 *
 * @param ctx 守卫上下文（目标路由 / 触发 API / next 构造器）
 * @returns 放行或拦截裁决（对齐 vue-router 的 next()）；拦截时 redirect 为改跳目标，null 为静默拦截
 *
 * ## 裁决矩阵
 * | 登录态 | 策略 | 目标页面 | 结果 |
 * | --- | --- | --- | --- |
 * | 已登录 | — | 非登录页 | `next()` |
 * | 已登录 | — | 登录页 | `next(redirect 参数 ?? DEFAULT_HOME_PAGE)` |
 * | 未登录 | 白名单 | 名单内页面 / 登录页 | `next()` |
 * | 未登录 | 白名单 | 其余页面 | `next(登录页?redirect=原地址)` |
 * | 未登录 | 黑名单 | 名单内页面 | `next(登录页?redirect=原地址)` |
 * | 未登录 | 黑名单 | 其余页面 | `next()` |
 */
export function guardLogin(ctx: RouteGuardContext): GuardResult {
  const { from: _from, to, next } = ctx;
  const path = to.path;

  console.log(ctx, 'ctx');

  const isLoggedIn = useTokenStore().hasValidLogin();

  // 1. 已登录
  if (isLoggedIn) {
    // 1.1 目标不是登录页 → 直接放行
    if (path != LOGIN_PAGE) {
      return next();
    }
    // 1.2 已登录却又点进登录页 → 送回来源页（redirect 参数），没带就回首页
    const redirect = to.query.get('redirect');
    if (redirect != null && redirect != '') {
      return next(redirect);
    }
    return next(DEFAULT_HOME_PAGE);
  }

  // 2. 未登录：备好「登录页 + 回跳原地址」。整串（连 ? = 一起）encodeURIComponent 是刻意的：
  //    登录页那边 query.get('redirect') 会整体解码一次（见 ../utils/utils.uts 的 decodeQueryValue），
  //    正好还原成本项目统一的「解码态」口径，不会二次转义 —— 别改成只编码值或改用 decodeURI
  const loginUrl = `${LOGIN_PAGE}?redirect=${encodeURIComponent(to.fullPath)}`;

  // 2.1 白名单策略：默认全拦，仅名单内页面与登录页本身放行
  if (isNeedLoginMode) {
    if (judgeIsExcludePath(path) || path == LOGIN_PAGE) {
      return next();
    }
    return next(loginUrl);
  }

  // 2.2 黑名单策略（默认）：默认放行，仅名单内页面需要登录
  if (judgeIsExcludePath(path)) {
    return next(loginUrl);
  }
  return next();
}
