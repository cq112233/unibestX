import { getCurrentPath } from '@/src/utils/route/index.uts';
import { LOGIN_PAGE } from './config.uts';

let lastRedirectTime = 0;

/**
 * 跳转到登录页面，带防抖与节流保护，避免并发请求时重复打开多个登录页。
 * - 权威引用 config.uts 中的 LOGIN_PAGE 配置
 * - 使用 getCurrentPath() 精准判断当前页面，避免重复打开自身
 * - 默认 1000ms 节流窗口
 *
 * @param options 可选配置项（mode: 'navigateTo' | 'reLaunch', queryString: string）
 */
export function toLoginPage(options: UTSJSONObject | null = null) {
  const now = Date.now();
  if (now - lastRedirectTime < 1000) {
    return;
  }
  lastRedirectTime = now;

  const opts = options ?? ({} as UTSJSONObject);
  const mode = (opts.getString('mode') ?? 'navigateTo') as string;
  const queryString = (opts.getString('queryString') ?? '') as string;

  const url = `${LOGIN_PAGE}${queryString}`;

  // 判断当前页面是否已是登录页，避免重复跳转
  const currentPath = getCurrentPath();
  if (currentPath == LOGIN_PAGE || currentPath.endsWith(LOGIN_PAGE)) {
    return;
  }

  if (mode == 'navigateTo') {
    uni.navigateTo({ url });
  }
  else {
    uni.reLaunch({ url });
  }
}

export default toLoginPage;
