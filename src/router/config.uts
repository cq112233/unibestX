/**
 * 业务路由配置中心（黑白名单策略与页面路径）
 * 默认黑名单策略 (默认无需登录，只在特定页面拦截)
 */

export type LoginStrategyMap = {
  /** 黑名单策略：默认无需登录，只在特定页面拦截 */
  DEFAULT_NO_NEED_LOGIN: number;
  /** 白名单策略：默认全部拦截，仅在特定免登录页面直接放行 */
  DEFAULT_NEED_LOGIN: number;
};

/**
 * 登录拦截策略映射
 */
export const LOGIN_STRATEGY_MAP: LoginStrategyMap = {
  /** 黑名单策略：默认无需登录，只在特定页面拦截 */
  DEFAULT_NO_NEED_LOGIN: 0,
  /** 白名单策略：默认全部拦截，仅在特定免登录页面直接放行 */
  DEFAULT_NEED_LOGIN: 1
};

/**
 * 选中的全局登录策略（默认采用黑名单策略）
 */
export const LOGIN_STRATEGY: number = LOGIN_STRATEGY_MAP.DEFAULT_NO_NEED_LOGIN;

/**
 * 是否启用强制登录策略（白名单策略）
 */
export const isNeedLoginMode: boolean = LOGIN_STRATEGY == LOGIN_STRATEGY_MAP.DEFAULT_NEED_LOGIN;

/**
 * 登录页面绝对路由路径
 */
export const LOGIN_PAGE: string = '/src/sub/auth/login';

/**
 * 注册页面绝对路由路径
 */
export const REGISTER_PAGE: string = '/src/sub/auth/register';

/**
 * 登录认证相关页面路径列表（登录、注册等）
 */
export const LOGIN_PAGE_LIST: string[] = [LOGIN_PAGE, REGISTER_PAGE];

/**
 * 已登录访问登录页时的兜底回跳首页路径
 */
export const DEFAULT_HOME_PAGE: string = '/src/pages/index/index';

/**
 * 需登录黑名单列表（在黑名单模式 isNeedLoginMode = false 下生效）：
 * - 默认所有页面均直接放行；
 * - 仅在名单内的页面必须登录才能访问，未登录访问将被拦截并跳转登录页。
 */
export const NEED_LOGIN_BLACK_LIST: string[] = [
  '/src/pages/index/index'
];

/**
 * 免登录白名单列表（在白名单模式 isNeedLoginMode = true 下生效）：
 * - 默认所有页面均强制登录；
 * - 仅在名单内的公开页面直接放行，免登录即可访问。
 */
export const NO_NEED_LOGIN_WHITE_LIST: string[] = [
  '/src/pages/index/index'
];

/**
 * 语义化别名与向下兼容导出
 */
export const BLACK_LIST: string[] = NEED_LOGIN_BLACK_LIST;
export const WHITE_LIST: string[] = NO_NEED_LOGIN_WHITE_LIST;
/**
 * @deprecated 建议优先使用语义明确的 NEED_LOGIN_BLACK_LIST 或 NO_NEED_LOGIN_WHITE_LIST
 */
export const EXCLUDE_LOGIN_PATH_LIST: string[] = NEED_LOGIN_BLACK_LIST;
