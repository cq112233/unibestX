/**
 * 路由位置对象（`RouteLocation`）的定义与空值构造
 *
 * **纯叶子文件**：不 import 任何东西，只被 ./route-state.uts（全局那份）、./route-snapshot.uts
 * （每个调用点的快照）、./useRoute.uts（返回类型）引用。
 *
 * ⚠️ 为什么单独一个文件、而不是把 `RouteLocation` 留在 route-state.uts 里：
 *    UTS 的 `import type` **不会**被擦除 —— 对象字面量的类型别名会生成**真的运行期 class**
 *    （产物里是 `class RouteLocation extends UTS.UTSType` + `new RouteLocation({...})`）。
 *    若 route-snapshot 从 route-state 取这个类型，两边就形成**运行期互相引用**，
 *    正撞规则 1.22 的 Kotlin `<clinit>` 循环死锁。提成本文件后依赖是单向 DAG：
 *
 *    route-types.uts  ←  route-snapshot.uts  ←  route-state.uts
 *                     ←  useRoute.uts
 */
export type RouteLocation = {
  /** 规范化路径（带前导 `/`，不含 query），如 `/src/pages/index/index` */
  path: string;
  /** 完整路径（path + 原始 query 串），如 `/src/pages/index/index?tab=2` */
  fullPath: string;
  /** 查询参数（键值均为 string，值已 URL 解码） */
  query: Map<string, string>;
  /** 恒为空 Map：uni-app X 无动态路由段，仅为与 vue-router 形态保持一致 */
  params: Map<string, string>;
  /** 路由元信息：优先取 setRouteMeta() 注册值，未注册时回退到 pages.json 里该页面的配置项，都没有为 null */
  meta: UTSJSONObject | null;
  /** 路由名：取自 meta 的 `name` 字段（在页面 definePage 里声明），未声明为 null */
  name: string | null;
  /** 当前栈顶页面实例（UniPage，栈空时为 null） */
  page: any | null;
  /** 当前页面栈实例数组（等价于 getCurrentPages()） */
  pages: any[];
};

/**
 * 构造一个空路由（保持与 RouteLocation 同构）
 *
 * 全局那份用它做 reactive 初始化，快照那份用它承接全局值 —— 字段清单只在这里维护一份。
 *
 * @returns 各字段为初始值的 `RouteLocation`（`path` / `fullPath` 为空串，`query` / `params` 为空 Map，
 *          `meta` / `name` / `page` 为 null，`pages` 为页面栈数组）
 */
export function createEmptyRoute(): RouteLocation {
  let initialPages: any[] = [];
  try {
    initialPages = getCurrentPages();
  }
  catch {
    initialPages = [];
  }
  return {
    path: '',
    fullPath: '',
    query: new Map<string, string>(),
    params: new Map<string, string>(),
    meta: null,
    name: null,
    page: initialPages.length > 0 ? initialPages[initialPages.length - 1] : null,
    pages: initialPages
  } as RouteLocation;
}
