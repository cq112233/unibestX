import { isPageTabbar, switchTabbar } from '@/src/tabbar/index.uts';
import { runRouterGuard } from '../guard/index.uts';
import type { RouteTarget } from '../guard/types.uts';
import { applyRouteFromUrl, installRouteStateListener, syncRouteState } from '../hooks/route-state.uts';
import { getQueryString, parseUrlToObj } from '../utils/utils.uts';

/**
 * 本文件是**框架侧**：只负责「读 uni 导航入参 → 归一化 URL → 交给业务守卫裁决 →
 * 按裁决放行 / 改跳 → 维护 useRoute() 路由状态」。
 *
 * 准入校验这类**业务规则一律不写在这里**，统一去 ../guard/（业务开发者主战场：一条规则一个文件，
 * 目录约定见 ../guard/index.uts；模板升级不覆盖）。加一条路由规则 = 在 ../guard/ 里新建一个
 * guardXxx.uts 并挂进编排，本文件不动。
 *
 * ⚠️ 本文件**只认 ../guard/index.uts 的 runRouterGuard() 这一个符号**，且注释里不出现任何业务名词
 *    （本文件通篇只谈 URL、路由状态、跳转派发这些管道概念）。一旦这里开始写得出某个具体业务
 *    的名字，就说明它漏回框架侧了 —— 有回归测试盯着。
 */

/**
 * 路由状态兜底回读（延后一拍，等页面栈稳定）
 *
 * 只用在**跳转失败**的时候：跳转没发生，当前页没变，回读栈顶一定是对的，
 * 用来把 invoke 阶段提前写入的目标路由回滚掉。
 *
 * ⚠️ 不要拿它当「跳转成功后同步路由」用：App 端页面栈有滞后（新页面入栈后
 *    栈顶还会停在上一页一段时间），success 阶段回读到的仍是**上一页**，
 *    会把刚写好的目标路由覆盖回去。详见 ../hooks/route-state.uts 头部说明。
 */
function syncRouteStateDeferred(): void {
  setTimeout(() => {
    syncRouteState();
  }, 0);
}

/**
 * 把「即将跳转到的目标路由」写进 useRoute() 的状态（useRoute 状态源的第一层）
 *
 * 为什么必须在**跳转发起时**写，而不是等页面起来再回读页面栈：
 * 1. `uni.onAppRoute` 在**目标页 onShow 之后**才触发（官方事件时序），目标页 setup 时事件还没到，
 *    状态里存的仍是上一页 —— 只靠事件，新页面首帧会读到上一页的路由；
 * 2. App 端页面栈有滞后 —— 新页面 setup 时 `getCurrentPages()` 栈顶仍是上一页，
 *    回读必然整体慢一页（曾经的表现：进入 routerBasicDemo 后 path 恒为 /src/pages/index/index）。
 * 发起方自己知道目标 url，直接写上最可靠，且三端行为一致。事件到达后会写入同样的值，互为兜底。
 *
 * ⚠️ 只在**确实放行**时写：被业务守卫拦下并改跳时，路由状态交给**那次改跳**自己写 ——
 *    写这里反而是错的（这里写的是用户其实没去成的页面）。
 * ⚠️ `plugin://` / `http(s)://` 不是本应用页面，不进路由状态。
 */
function markTargetRoute(url: string): void {
  const resolved = resolveAbsoluteUrl(url);
  if (resolved == '') {
    return;
  }
  if (resolved.startsWith('plugin://') || resolved.startsWith('http://') || resolved.startsWith('https://')) {
    return;
  }
  applyRouteFromUrl(resolved);
}

/**
 * 守卫裁决通过则放行并写入目标路由；被拦下时不写（框架已改跳守卫给出的目标页，
 * 那次跳转自己会把路由写成目标页，写这里反而是错的）
 * @param url 导航 url
 * @param api 触发本次跳转的 uni API 名，透传给守卫
 */
function allowNavigation(url: string, api: string): boolean {
  const allowed = doIntercept(url, api);
  if (allowed) {
    markTargetRoute(url);
  }
  return allowed;
}

// #ifndef APP
export type Interceptor = {
  invoke: (options: any) => boolean;
  success?: (res: any) => void;
  fail?: (err: any) => void;
  complete?: (res: any) => void;
};
// #endif

/**
 * 把 query Map 还原成 query 串（值已是解码态，这里不做任何编解码）
 *
 * 存在的意义：守卫可能需要「原地址」去拼改跳参数，且必须与 path / query **同口径**
 * （都经 parseUrlToObj 解过一次码）；直接拿原始 url 串会让下游多编一次码。
 */
function joinQueryString(query: Map<string, string>): string {
  if (query.size == 0) {
    return '';
  }
  const paramsList: Array<string> = [];
  query.forEach((val, key) => {
    paramsList.push(`${key}=${val}`);
  });
  return paramsList.join('&');
}

/**
 * 把导航 url 归一化为「绝对路径 + 原始 query 串」的形式（相对路径按当前页面所在目录解析）
 *
 * 抽取出来的原因：守卫裁决（doIntercept）与「跳转时写入目标路由」（markTargetRoute）
 * 必须用**同一套**路径口径，否则会出现「拦截器按 A 页面放行、路由状态写的是 B 页面」的错位。
 *
 * @param url 导航 url，如 `/src/pages/me/me?tab=1`、`subDetail?id=1`
 * @returns 归一化后的 url；入参为空返回空串，`plugin://` / `http(s)://` 原样返回
 */
function resolveAbsoluteUrl(url: string): string {
  if (url == null || url == '') {
    return '';
  }
  const urlObj = parseUrlToObj(url);
  let path = urlObj.path;

  // 1. 规范化路径：如果以 'src/' 开头，补充前导 '/' 使其变为 '/src/'
  if (path.startsWith('src/')) {
    path = `/${path}`;
  }

  // 2. 相对路径解析：将 "subpage" 转换为基于当前页面所在目录的绝对路径
  if (!path.startsWith('/') && !path.startsWith('plugin://') && !path.startsWith('http://') && !path.startsWith('https://')) {
    const pages = getCurrentPages();
    let currentPath = '';
    if (pages.length > 0) {
      // route 在 npm @dcloudio/types 侧被标为可选（不兜底会报 TS2322），
      // 真源（HBuilderX dts）里是非空 string，故沿用 router/utils、layouts/navbar 的 `?? ''` 写法兼顾两侧
      currentPath = pages[pages.length - 1].route ?? '';
    }
    let normalizedCurrentPath = currentPath;
    if (normalizedCurrentPath.startsWith('src/')) {
      normalizedCurrentPath = `/${normalizedCurrentPath}`;
    }
    if (!normalizedCurrentPath.startsWith('/')) {
      normalizedCurrentPath = `/${normalizedCurrentPath}`;
    }
    const lastSlashIdx = normalizedCurrentPath.lastIndexOf('/');
    let baseDir = '';
    if (lastSlashIdx >= 0) {
      baseDir = normalizedCurrentPath.substring(0, lastSlashIdx);
    }
    path = `${baseDir}/${path}`;
  }

  // 确保最终 path 也是以 '/' 开头的绝对路径形式
  if (path.startsWith('src/')) {
    path = `/${path}`;
  }

  // query 串原样保留（不做编解码，避免二次转义）
  const queryStr = getQueryString(url);
  if (queryStr == '') {
    return path;
  }
  return `${path}?${queryStr}`;
}

/**
 * 执行守卫给出的改跳目标
 *
 * 守卫只表达意图（`block('url')`），跳转一律由这里发出。原因：拦截器只在**放行**时才写
 * 路由状态（见 allowNavigation / markTargetRoute），守卫自己调 uni API 会绕过这个不变量。
 *
 * ⚠️ TabBar 页面必须走 switchTab：`uni.navigateTo` 跳 TabBar 页面会被框架直接拒绝。
 * ⚠️ `redirect` 为 null / 空串 → 静默拦截，不做任何跳转。
 */
function dispatchRedirect(target: string | null): void {
  if (target == null || target == '') {
    return;
  }
  if (isPageTabbar(target)) {
    switchTabbar(target);
    return;
  }
  uni.navigateTo({ url: target });
}

/**
 * 核心拦截流程：归一化 url → 交给业务守卫裁决 → 放行或改跳
 *
 * 本函数**不含任何业务规则**：上下文里装哪些业务信号、什么条件算通过、被拦下跳哪儿，全在
 * ../guard/（`runRouterGuard()` 是那边的唯一入口，装配与规则链都在它后面收口）——
 * 业务开发者改那个目录，本文件不动，也读不到任何业务细节。
 *
 * @param url 导航 url（可能带 query、可能是相对路径）
 * @param api 触发本次跳转的 uni API 名，透传给守卫（守卫可按 API 差异化裁决）
 */
function doIntercept(url: string, api: string): boolean {
  if (url == null || url == '') {
    return true;
  }
  const resolvedUrl = resolveAbsoluteUrl(url);
  const urlObj = parseUrlToObj(resolvedUrl);

  // fullPath 由 path + 解码后的 query 重拼（而不是直接用 resolvedUrl）：保持「解码态」口径，
  // 守卫拿它去 encodeURIComponent 时正好只编码一次
  const queryStr = joinQueryString(urlObj.query);
  let fullPath = urlObj.path;
  if (queryStr != '') {
    fullPath += `?${queryStr}`;
  }

  // 对象字面量按仓库既有先例写成「类型化变量 + as」（如 tabbar 的 buildFullTabbarList）：
  // 嵌套字面量直传给 type 字段没有先例，Kotlin 侧推断不可靠，这里显式落到具体类型上
  const target: RouteTarget = {
    path: urlObj.path,
    query: urlObj.query,
    fullPath
  } as RouteTarget;

  // 框架交出的只有两样中立的输入（归一化后的 URL 事实 + api 名），拿回来的只有裁决：
  // 上下文怎么装配、有哪些业务信号、按什么顺序判，全在 ../guard/ 里，框架不碰也不想知道
  const decision = runRouterGuard(target, api);

  if (decision.pass) {
    return true;
  }
  dispatchRedirect(decision.redirect);
  return false;
}

/**
 * 路由 API 独立拦截器
 *
 * 各 API 的差异只有「怎么从 options 里取 url」（App 原生端需按各自的 Options 强转），
 * 取到 url 后一律走 allowNavigation(url, api)；api 名透传给业务守卫，便于按 API 差异化裁决。
 */
export const navigateToInterceptor: Interceptor = {
  invoke(options: any): boolean {
    let url = '';
    if (options != null) {
      // #ifdef APP
      const opt = options as NavigateToOptions;
      url = opt.url;
      // #endif
      // #ifndef APP
      const urlObj = options as UTSJSONObject;
      url = (urlObj.url != null) ? (urlObj.url as string) : '';
      // #endif
    }
    return allowNavigation(url, 'navigateTo');
  },
  fail(_err: any): void {
    syncRouteStateDeferred();
  }
};

export const redirectToInterceptor: Interceptor = {
  invoke(options: any): boolean {
    let url = '';
    if (options != null) {
      // #ifdef APP
      const opt = options as RedirectToOptions;
      url = opt.url;
      // #endif
      // #ifndef APP
      const urlObj = options as UTSJSONObject;
      url = (urlObj.url != null) ? (urlObj.url as string) : '';
      // #endif
    }
    return allowNavigation(url, 'redirectTo');
  },
  fail(_err: any): void {
    syncRouteStateDeferred();
  }
};

export const reLaunchInterceptor: Interceptor = {
  invoke(options: any): boolean {
    let url = '';
    if (options != null) {
      // #ifdef APP
      const opt = options as ReLaunchOptions;
      url = opt.url;
      // #endif
      // #ifndef APP
      const urlObj = options as UTSJSONObject;
      url = (urlObj.url != null) ? (urlObj.url as string) : '';
      // #endif
    }
    return allowNavigation(url, 'reLaunch');
  },
  fail(_err: any): void {
    syncRouteStateDeferred();
  }
};

export const switchTabInterceptor: Interceptor = {
  invoke(options: any): boolean {
    let url = '';
    if (options != null) {
      // #ifdef APP
      const opt = options as SwitchTabOptions;
      url = opt.url;
      // #endif
      // #ifndef APP
      const urlObj = options as UTSJSONObject;
      url = (urlObj.url != null) ? (urlObj.url as string) : '';
      // #endif
    }
    return allowNavigation(url, 'switchTab');
  },
  fail(_err: any): void {
    syncRouteStateDeferred();
  }
};

/**
 * 地图选点调用拦截器（默认直接放行）
 */
export const chooseLocationInterceptor: Interceptor = {
  invoke(_options: any): boolean {
    return true;
  }
};

/**
 * 全局路由拦截安装器
 */
export function installRouteInterceptor() {
  // 路由状态监听在本处（main.uts 创建应用时）安装：必须早于任何页面 setup，
  // 否则首个页面要靠 ensureRouteReady 冷启动回读才拿到路由
  installRouteStateListener();
  uni.addInterceptor('navigateTo', navigateToInterceptor);
  uni.addInterceptor('reLaunch', reLaunchInterceptor);
  uni.addInterceptor('redirectTo', redirectToInterceptor);
  uni.addInterceptor('switchTab', switchTabInterceptor);
  uni.addInterceptor('chooseLocation', chooseLocationInterceptor);
}

/**
 * 校验并处理直接进入（如 H5 直链、小程序分享链接等）的路由场景，补充权限校验
 * @param options 直链参数对象，取 `options.path` 作为目标路径（不带前导 `/` 时会补上）；
 *                H5 端随后会用 `location.hash` / `pathname` 覆盖它，直链地址优先以免丢查询串；
 *                传 null 或 path 为空时**直接返回**，不触发任何拦截校验
 */
export function checkDirectEntry(options: UTSJSONObject | null) {
  if (options != null) {
    const pathVal = options.path as string | null;
    if (pathVal != null && pathVal != '') {
      let url = `/${pathVal}`;
      // #ifdef H5
      let h5Url = '';
      const hash = window.location.hash;
      if (hash.startsWith('#/')) {
        h5Url = hash.substring(1);
      }
      else {
        h5Url = window.location.pathname + window.location.search;
      }
      if (h5Url != '' && h5Url != '/') {
        url = h5Url;
      }
      // #endif
      navigateToInterceptor.invoke({ url } as any);
    }
  }
}
