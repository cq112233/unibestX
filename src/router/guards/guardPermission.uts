import type { GuardResult, RouteGuardContext } from '@/uni_modules/route-bestX/index.uts';

/**
 * 无权限提示/升级页面绝对路由路径
 */
export const PERMISSION_DENIED_PAGE: string = '/src/sub/permission/denied';

/**
 * 需要特定权限/角色准入的页面名单列表（默认空，由业务动态配置）
 */
let permissionRequiredPaths: string[] = [];

/**
 * 当前用户具备的权限/角色标记列表
 */
let currentUserPermissions: string[] = [];

/**
 * 设置需要权限准入的页面路径列表
 */
export function setPermissionRequiredPaths(paths: string[]): void {
  permissionRequiredPaths = paths;
}

/**
 * 获取需要权限准入的页面路径列表
 */
export function getPermissionRequiredPaths(): string[] {
  return permissionRequiredPaths;
}

/**
 * 设置当前用户的权限/角色列表
 */
export function setCurrentUserPermissions(permissions: string[]): void {
  currentUserPermissions = permissions;
}

/**
 * 获取当前用户的权限/角色列表
 */
export function getCurrentUserPermissions(): string[] {
  return currentUserPermissions;
}

/**
 * 校验当前用户是否具备指定页面的访问权限
 */
export function checkUserPermission(path: string): boolean {
  // 如果页面不在受控名单内，默认放行
  if (!permissionRequiredPaths.includes(path)) {
    return true;
  }
  // 如果在受控名单内，检查用户是否拥有对应路径的访问权限或 admin 超管权限
  return currentUserPermissions.includes(path) || currentUserPermissions.includes('admin');
}

/**
 * 权限与角色准入守卫（纯函数）：后置于登录认证守卫
 *
 * 裁决逻辑：
 * 1. 目标页面若不在受限名单中，直接放行；
 * 2. 目标页面在受限名单中：
 *    - 用户拥有权限 (checkUserPermission == true) -> 放行
 *    - 用户未拥有权限 -> 重定向至无权访问提示页 (PERMISSION_DENIED_PAGE)
 */
export function guardPermission(ctx: RouteGuardContext): GuardResult {
  const { to, next } = ctx;
  const path = to.path;

  // 1. 无需权限校验的常规页面直接放行
  if (!permissionRequiredPaths.includes(path)) {
    return next();
  }

  // 2. 校验权限
  if (checkUserPermission(path)) {
    return next();
  }

  // 3. 权限不足，改跳无权访问提示页
  return next(PERMISSION_DENIED_PAGE);
}
