/**
 * 每个调用点各自的路由快照（`useRoute()` 返回的就是它）
 *
 * ## 为什么不能所有调用点共用全局 `routeState` 那一份
 *
 * 全局那份在**跳转请求发出时**就被写成了目标路由（第 1 层数据源，见 route-state.uts 头部），
 * 而上一页此刻还挂在页面栈上、还在屏幕上（App 端要等新页盖上来）—— 两边共用一份的话，
 * 上一页的 `route.fullPath` 会在新页进入动画期间就翻成新页的值，同页带参重进尤其明显
 * （path / name / meta 全一样，只有 fullPath / query 当场变）。拆成快照后：
 *
 * - **上一页**：导航**请求**发出时的那次预写（或路径 / 可见性不符的落地提交）一律动不了它 →
 *   新页进入期间纹丝不动，直到自己重新显示；
 * - **新页**：创建快照时全局里已经是它的目标路由（拦截器在请求时就写了）→ 首帧就准，
 *   不需要任何回调兜底。
 *
 * ## 两道闸（都在 publishRoute，缺一不可）
 *
 * 1. **提交来源**：`applyTargetRouteFromUrl()` = 导航请求预写（拦截器专用），**只喂未认领路径
 *    的快照**；同页重进时上一页还没 onPageHide（可见性拦不住），靠的就是这条。
 *    `applyRouteFromUrl()` / onAppRoute 事件 / 页面栈回读（`syncRouteState`）= 落地真值。
 * 2. **可见性 + 路径一致**：已认领的快照只在「本页 visible（onPageShow 置真 / onPageHide 置假）
 *    且提交路径 == 本页路径」时才吃落地提交。
 *
 * 快照未认领（`path == ''`，创建时全局还空：冷启动 / H5 直链）时**一律跟随全局**，
 * 等本页首次 onPageShow 认领路径。`onUnmounted` 里 `closeRouteSnapshot(id)` 注销
 * （没有组件实例时不注册，见 useRoute.uts）。
 *
 * ## 依赖方向（单向 DAG，别改回去）
 *
 * ```
 * route-types.uts  ←  route-snapshot.uts  ←  route-state.uts  ←  useRoute.uts
 * ```
 *
 * `RouteLocation` 与 `createEmptyRoute` 放在 route-types.uts 这个**零依赖叶子**里。
 * 别图省事改成从 route-state.uts 取：UTS 的 `import type` **不会**被擦除，对象字面量类型别名
 * 会生成**真的运行期 class**（产物里是 `require('./route-state.js')` + `new RouteLocation(...)`），
 * 而 route-state.uts 反向 import 本文件的函数，两边立刻构成运行期互相引用 —— 正撞
 * `unibestX-skill` 1.22 的 Kotlin `<clinit>` 循环死锁红线。
 */
import { reactive } from 'vue';
import { createEmptyRoute } from './route-types.uts';
import type { RouteLocation } from './route-types.uts';

/**
 * 一份 `useRoute()` 快照
 *
 * 为什么不能所有调用点共用全局 `routeState` 那一份：全局状态在**跳转请求发出时**就被写成了
 * 目标路由（第 1 层数据源），而上一页此刻还挂在页面栈上、还在屏幕上，共用一份就会让上一页
 * 提前翻（详见文件头）。所以每个调用点持有**属于自己的快照**：只吃「本页路径」的
 * **落地**提交（请求预写一律不吃），且只在本页可见时吃（两道闸都在 publishRoute）。
 */
type RouteSnapshot = {
  /** 本调用点读到的路由（reactive，模板直接读它的字段） */
  route: RouteLocation;
  /** 本页路径：认领后即定格（页面实例存活期内不变）；空串 = 还没认领 */
  path: string;
  /** 本页当前是否在前台：onPageShow 置真、onPageHide 置假 */
  visible: boolean;
};

/**
 * 快照登记表：key 为自增 id
 *
 * 用数字 id 而不是对象本身作 key —— reactive 返回的是代理对象，跨运行时（H5 的 Proxy /
 * Kotlin 侧的包装类）比较身份不可靠，id 两端都稳。
 */
const snapshots: Map<number, RouteSnapshot> = new Map<number, RouteSnapshot>();
let snapshotSeq: number = 0;

/**
 * 把全局路由的字段整体拷进快照
 *
 * `query` / `params` 直接共用同一个 Map 实例：提交时是**整体替换**（见 route-state.uts 的
 * commitRoute），不是原地改，所以共享引用不会被别处写脏。
 *
 * @param target 要被改写的目标路由（快照那份 / 新建的空路由）
 * @param source 数据源（恒为全局 `routeState`）
 */
function copyRoute(target: RouteLocation, source: RouteLocation): void {
  target.path = source.path;
  target.fullPath = source.fullPath;
  target.query = source.query;
  target.params = source.params;
  target.meta = source.meta;
  target.name = source.name;
  let currentStack: any[] = [];
  try {
    currentStack = getCurrentPages();
  }
  catch {
    currentStack = source.pages;
  }
  target.pages = currentStack;
  target.page = currentStack.length > 0 ? currentStack[currentStack.length - 1] : null;
}

/**
 * 把刚提交的路由推给「该收到它的」快照（「上一页不提前翻」的全部实现）
 *
 * 提交分两类，只有**落地**类才是「这就是当前路由了」的真值：
 *
 * - **导航请求**发出时的预写（`includeClaimed == false`，见 applyTargetRouteFromUrl）：此刻全局里是
 *   「正要盖到自己头上的下一页」的目标路由 —— 只喂还没认领路径的快照（冷启动 / H5 直链靠它兜底），
 *   已认领的一律不动。同页带参重进时上一页不提前翻靠的就是这一条：那时上一页还没 onPageHide
 *   （可见性仍是真），光靠可见性拦不住；
 * - **落地**（`includeClaimed == true`：onAppRoute 事件 / 页面栈回读 / 业务主动刷新）：推给
 *   「未认领」（还不知道自己属于哪一页，先跟着全局走，等本页首次 onPageShow 认领路径）或
 *   「已认领 + 本页在前台 + 路径与本次提交一致」的快照。
 *
 * @param globalRoute 本次提交后的全局路由（由 route-state.uts 传入，本文件不去读全局那份）
 * @param path 本次提交的规范化路径
 * @param includeClaimed 本次提交是不是「落地」真值（见上）
 */
export function publishRoute(globalRoute: RouteLocation, path: string, includeClaimed: boolean): void {
  snapshots.forEach((snapshot: RouteSnapshot, _id: number): void => {
    if (snapshot.path == '') {
      copyRoute(snapshot.route, globalRoute);
      return;
    }
    if (includeClaimed && snapshot.visible && snapshot.path == path) {
      copyRoute(snapshot.route, globalRoute);
    }
  });
}

/**
 * 为当前调用点新建一份路由快照（`useRoute()` 内部调用，业务侧不要直接用）
 *
 * 初始值 = 此刻的全局路由。新页面的 setup 里调用时，全局里已经是它的目标路由
 * （拦截器在请求发出时就写了），所以**新页首帧就是对的**，不依赖任何回调时序。
 *
 * @param globalRoute 此刻的全局路由（由 useRoute.uts 传入）
 * @returns 快照 id（`showRouteSnapshot` / `hideRouteSnapshot` / `closeRouteSnapshot` 用）
 */
export function openRouteSnapshot(globalRoute: RouteLocation): number {
  snapshotSeq += 1;
  const id = snapshotSeq;
  const route = reactive(createEmptyRoute());
  copyRoute(route, globalRoute);
  const snapshot: RouteSnapshot = {
    route,
    path: globalRoute.path,
    // 此刻本页还没显示（onPageShow 时才置真）：创建到显示之间不吃任何提交也够用 ——
    // 初始值已经从全局拷过来了，就是本次导航的目标路由
    visible: false
  } as RouteSnapshot;
  snapshots.set(id, snapshot);
  return id;
}

/**
 * 取快照对象（调用方长期持有它，模板直接读字段）
 *
 * @param id `openRouteSnapshot()` 返回的快照 id
 * @returns 快照里的路由；id 已注销时返回 null（正常不会：onUnmounted 早于任何后续读取），
 *          由调用方决定退化成什么（`useRoute()` 退化成全局那份，宁可读到全局也别崩）
 */
export function readRouteSnapshot(id: number): RouteLocation | null {
  const snapshot = snapshots.get(id);
  if (snapshot == null) {
    return null;
  }
  return snapshot.route;
}

/**
 * 本页重新显示：认领路径（创建时全局还是空的那种）+ 从此刻的全局路由刷新一次
 *
 * 调用时机：`useRoute()` 注册的 onPageShow 里，**先** `syncRouteState()` 回读页面栈（返回上一页 /
 * 物理返回键 / App 回前台 / 直链进入只有这个时机看得到），**再**调本函数。
 *
 * ⚠️ 已认领的快照只在「全局路径与自己一致」时才刷新：页面栈回读滞后、或本页刚显示就被又一次
 *    跳转顶掉时，全局里可能是别的页面 —— 那种情况下本页宁可保持自己那份（拦截器写进来的目标
 *    路由），也不能把别人的路由灌进来。
 *
 * @param id `openRouteSnapshot()` 返回的快照 id
 * @param globalRoute 此刻的全局路由（由 useRoute.uts 传入）
 */
export function showRouteSnapshot(id: number, globalRoute: RouteLocation): void {
  const snapshot = snapshots.get(id);
  if (snapshot == null) {
    return;
  }
  const globalPath = globalRoute.path;
  if (snapshot.path == '') {
    // 还没认领：以此刻的全局路由为准（全局也还空就先不动，等下一次 onPageShow）
    if (globalPath == '') {
      return;
    }
    snapshot.path = globalPath;
    snapshot.visible = true;
    copyRoute(snapshot.route, globalRoute);
    return;
  }
  snapshot.visible = true;
  if (globalPath == snapshot.path) {
    copyRoute(snapshot.route, globalRoute);
  }
}

/**
 * 本页不再显示（被新页盖住 / 切到后台 / 切了 Tab）
 *
 * 冻结快照：此后**落地**提交也改不到它 —— 哪怕「同一路径再进一层」（提交的路径与本页相同），
 * 因为那次的落地只该由新那层页面收（它是唯一还 visible 的那个）。
 * 请求预写那一道闸不依赖本函数（那时本页可能还没 onPageHide）。
 *
 * @param id `openRouteSnapshot()` 返回的快照 id
 */
export function hideRouteSnapshot(id: number): void {
  const snapshot = snapshots.get(id);
  if (snapshot != null) {
    snapshot.visible = false;
  }
}

/**
 * 注销快照（页面 / 组件 onUnmounted 时调用，避免登记表随往返次数越积越长）
 *
 * @param id `openRouteSnapshot()` 返回的快照 id
 */
export function closeRouteSnapshot(id: number): void {
  snapshots.delete(id);
}
