/**
 * 路由响应式状态（等价 vue-router 的 currentRoute）
 *
 * 页面/组件通过 `useRoute()`（见 ./useRoute.uts）读取当前路由，读取到的是响应式对象，
 * 路由变化时依赖它的模板 / computed 会自动更新。
 *
 * ## 状态从哪来（四层，互为兜底）
 *
 * 1. **主**：导航发起方在跳转前写入目标 url（见 ../interceptor/interceptor.uts 的 invoke）——
 *    「发起方知道自己要去哪」，不依赖任何平台回调时序，App / H5 / 小程序一致。
 *    必要原因见下方「onAppRoute 在目标页 onShow 之后才触发」。
 * 2. **主**：`uni.onAppRoute` 官方「路由完成」事件 —— 全端支持：App-Android / App-iOS /
 *    Web / 微信 / 支付宝 / 鸿蒙 均为 unixVer 5.25 起（本项目基座 5.26，真机实测**会触发**）。
 *    类型声明不在项目的 `node_modules/@dcloudio/*` 里（那里没有 uni-app-x 包），真源在
 *    HBuilderX 内置 dts：`builtin-dts/uniappx/node_modules/@dcloudio/uni-app-x/types/
 *    uni/uts-plugin-api/lib/uni-route/utssdk/interface.d.ts`（`OnAppRoute` / `AppRouteEvent`）。
 *    事件载荷带 `path`（不含前导斜杠）、`query`、`openType`（navigateTo / navigateBack /
 *    redirectTo / reLaunch / switchTab / appLaunch）、`notFound`、`routeEventId`、`timeStamp`，
 *    因此**返回上一页、切 Tab、reLaunch 也会触发**，是这些场景最可靠的校正源。
 * 3. **兜底**：页面栈回读 `syncRouteState()` —— 读栈顶页面的 `route` + `options`，
 *    用于冷启动 / 返回上一页 / 导航失败回滚 / 页面重新显示（`useRoute()` 里注册的 onPageShow）。
 * 4. **兜底**：`useRoute()` 首次调用时的页面栈回读（仅在状态还是空的时候，见 ensureRouteReady）。
 *
 * 四层写入的是同一个 `routeState`，写入点唯一收敛在 `commitRoute()`。
 *
 * ⚠️ **onAppRoute 在目标页 onShow 之后才触发**（官方事件时序：请求 → onBeforeAppRoute →
 * 执行路由 → 目标页 onShow → onAppRoute）。也就是说**目标页 setup 的那一刻，事件还没到**，
 * 状态里存的仍是上一页 —— 单靠事件，新页面首帧会读到上一页的路由（曾经的 BUG：
 * 进入 routerBasicDemo 后 route.path 恒为 /src/pages/index/index）。所以导航发起方必须
 * 在请求时就写入目标路由（第 1 层），onAppRoute 只负责「事后校正」。
 *
 * ⚠️ **App 端页面栈有滞后**（实测 5.26 基座）：页面刚入栈的那一小段时间里，
 * `getCurrentPages()` 栈顶仍指向**上一页** —— 页面 setup 时读到的是上一页、
 * `navigateTo` 的 success 回调 + `setTimeout(0)` 读到的还是上一页。
 * 因此「页面 setup / 导航 success 时回读页面栈」这种写法在 App 上必然**整体慢一页**，
 * 页面栈只能在「确定的稳定时机」读：冷启动、返回、页面 onPageShow。
 *
 * ## 路径口径
 *
 * `path` 统一走 `cleanPath()`：带前导 `/`、不带 query、不做 `src/` 前缀的增删
 * （页面栈原始 route 为 `src/pages/index/index`，onAppRoute 的 path 为 `src/pages/index/index`
 * 之外还可能不带 `src/`，两者都以调用方传入的原文为准、只补前导斜杠）。
 *
 * ## query 口径
 *
 * `route.query` 的值**一律是解码态**。四个数据源里，url 字符串（拦截器）与平台给出的参数对象
 * （onAppRoute 的 `event.query`、页面 `options`）编码态并不一致 —— 后者在微信小程序上是
 * URL 编码态 —— 故**所有入口统一过 `decodeQueryValue()`**（见 utils.uts），
 * 页面侧拿到 `route.query.get('name')` 即是可直接展示的中文。
 */
import { reactive } from 'vue';
import { PAGE_META_JSON } from '../generated/page-meta.uts';
import {
  cleanPath,
  decodeQueryValue,
  getCurrentPageOptions,
  getCurrentPath,
  getQueryString,
  parseUrlToObj,
  queryValueToString
} from '../utils/utils.uts';

/**
 * 路由位置对象（对齐 vue-router 的 RouteLocationNormalized）
 */
export type RouteLocation = {
  /** 规范化路径（带前导 `/`，不含 query），如 `/src/pages/index/index` */
  path: string;
  /** 完整路径（path + 原始 query 串），如 `/src/pages/index/index?tab=2` */
  fullPath: string;
  /** 查询参数（键值均为 string，值已 URL 解码） */
  query: Map<string, string>;
  /** 恒为空 Map：uni-app X 无动态路由段，仅为与 vue-router 形态保持一致 */
  params: Map<string, string>;
  /** 路由元信息：优先取 setRouteMeta() 注册值，未注册时回退到 pages.json 里该页面的配置项，都没有为 null */
  meta: UTSJSONObject | null;
  /** 路由名：取自 meta 的 `name` 字段（在页面 definePage 里声明），未声明为 null */
  name: string | null;
};

/** 构造一个空路由（保持与 RouteLocation 同构，供 reactive 初始化） */
function createEmptyRoute(): RouteLocation {
  return {
    path: '',
    fullPath: '',
    query: new Map<string, string>(),
    params: new Map<string, string>(),
    meta: null,
    name: null
  } as RouteLocation;
}

/**
 * 当前路由（响应式）
 *
 * ⚠️ 只读：外部**不要**直接赋值/改字段，那会让状态与真实页面栈脱节；
 *    请通过 `router.push()` 等导航方法或 `syncRouteState()` 驱动它更新。
 */
export const routeState: RouteLocation = reactive(createEmptyRoute());

// ==========================================
// 路由元信息注册表（可选的轻量路由表）
// ==========================================

/** 路径 → meta 的注册表（key 为 cleanPath 规范化后的路径） */
const routeMetaMap: Map<string, UTSJSONObject> = new Map<string, UTSJSONObject>();

/**
 * 注册某个页面的路由元信息，注册后 `useRoute().meta / .name` 即可读到
 *
 * @param path 页面路径，可省略前导 `/` 与 `src/` 前缀
 * @param meta 元信息对象字面量，约定字段：`name`（路由名）、`title`（页面标题）、
 *             `requireAuth`（是否需要登录）等，字段可自由扩展
 *
 * @example
 * ```uts
 * setRouteMeta('/src/pages/me/me', { name: 'me', title: '我的', requireAuth: true });
 * ```
 */
export function setRouteMeta(path: string, meta: UTSJSONObject): void {
  const key = cleanPath(path);
  if (key == '') {
    return;
  }
  routeMetaMap.set(key, meta);
}

/**
 * 移除某个页面的路由元信息注册
 *
 * ⚠️ 两种 `src/` 前缀写法都要删：注册时按调用方原文存 key，而查询（getRouteMeta）两种写法都能命中，
 *    只删一种会留下「换一种写法注册过、按另一种写法撤不掉」的幽灵注册值。
 */
export function removeRouteMeta(path: string): void {
  const key = cleanPath(path);
  routeMetaMap.delete(key);
  routeMetaMap.delete(swapSrcPrefix(key));
}

/**
 * 把路径换成另一种 `src/` 前缀写法（`/src/pages/x` ↔ `/pages/x`），用于兼容历史路径写法
 */
function swapSrcPrefix(key: string): string {
  return key.startsWith('/src/') ? key.substring(4) : `/src${key}`;
}

// ==========================================
// pages.json 页面配置（route.meta 的默认数据源）
// ==========================================

/**
 * pages.json 页面配置表：路径 → 该页面的完整配置项
 *
 * 内容由构建期插件生成（plugins/vite-plugin-uni-pages.ts → src/router/generated/page-meta.uts），
 * 即「页面的 definePage 里写了什么，这里就是什么」，所以**不需要**在业务页面里手写 setRouteMeta。
 * 首次使用时解析一次并缓存；表为空（老工程未接入生成器）时静默退化为 null。
 */
let pageConfigTable: Map<string, UTSJSONObject> | null = null;

/** 从生成的 JSON 常量解析出页面配置表（懒加载，只解析一次） */
function ensurePageConfigTable(): Map<string, UTSJSONObject> {
  // ⚠️ 必须先拷进局部 const 再判空：`pageConfigTable` 是模块级可变属性，Kotlin 不对
  //    「可能被并发改写的属性」做智能转换，直接写 `return pageConfigTable` 会报
  //    `Smart cast to 'Map<String, UTSJSONObject>' is impossible`（Android 编译期）。
  const cached = pageConfigTable;
  if (cached != null) {
    return cached;
  }
  const table = new Map<string, UTSJSONObject>();
  pageConfigTable = table;
  if (PAGE_META_JSON == '') {
    return table;
  }
  const parsed = JSON.parseObject(PAGE_META_JSON);
  if (parsed == null) {
    return table;
  }
  // ⚠️ 遍历用「UTSJSONObject.keys() + 下标访问」而非实例方法：H5 / 蒸汽模式跑的是 JS 运行时，
  //    这里的值可能是纯 JS 对象（无 getJSON/getAny 等实例方法），下标访问两端都成立。
  const keys = UTSJSONObject.keys(parsed);
  for (let i = 0; i < keys.length; i++) {
    const oneKey = keys[i];
    const oneValue = parsed[oneKey];
    if (oneValue == null) {
      continue;
    }
    table.set(oneKey, oneValue as UTSJSONObject);
  }
  return table;
}

/**
 * 读取某个页面在 pages.json 里的配置项（页面 definePage 声明的字段）
 *
 * @param path 页面路径
 * @returns 该页面的配置项；查不到返回 null
 */
export function getPageConfig(path: string): UTSJSONObject | null {
  const key = cleanPath(path);
  if (key == '') {
    return null;
  }
  const table = ensurePageConfigTable();
  const exact = table.get(key);
  if (exact != null) {
    return exact;
  }
  // 先落局部变量再判空：Map.get 的类型是 `T | undefined`，直接 return 会报 TS2322
  const swapped = table.get(swapSrcPrefix(key));
  if (swapped != null) {
    return swapped;
  }
  return null;
}

/**
 * 从 meta 对象里读一个字符串字段
 *
 * ⚠️ 用下标访问 + queryValueToString，而不是 `meta.getString()`：
 *    meta 可能来自 JSON.parseObject（H5 侧为普通 JS 对象），实例方法不保证存在。
 */
function readMetaString(meta: UTSJSONObject, key: string): string | null {
  const value = meta[key];
  if (value == null) {
    return null;
  }
  const text = queryValueToString(value);
  return text == '' ? null : text;
}

/**
 * 按路径读取路由元信息
 *
 * 两级数据源，就近优先：
 * 1. `setRouteMeta()` 手写注册（可覆盖 / 补充 pages.json 里的配置）；
 * 2. pages.json 里该页面的配置项（构建期生成，见 ./route-state.uts 顶部说明）。
 *
 * @param path 页面路径
 * @returns 元信息对象；两级都没命中返回 null
 */
export function getRouteMeta(path: string): UTSJSONObject | null {
  const key = cleanPath(path);
  if (key == '') {
    return null;
  }
  const registered = routeMetaMap.get(key);
  if (registered != null) {
    return registered;
  }
  const registeredSwapped = routeMetaMap.get(swapSrcPrefix(key));
  if (registeredSwapped != null) {
    return registeredSwapped;
  }
  return getPageConfig(key);
}

// ==========================================
// 状态写入（唯一收敛点）
// ==========================================

/** 把 query Map 拼回 query 串（值做 URL 编码） */
function buildFullPath(path: string, query: Map<string, string>): string {
  if (query.size == 0) {
    return path;
  }
  const parts: Array<string> = [];
  query.forEach((value: string, key: string): void => {
    parts.push(`${key}=${encodeURIComponent(value)}`);
  });
  return `${path}?${parts.join('&')}`;
}

/**
 * 唯一的状态写入点：路径 + query + meta 一次性落盘
 *
 * 路径为空时整体忽略（避免页面栈尚未建立时把状态清空）。
 */
function commitRoute(path: string, query: Map<string, string>, fullPath: string): void {
  const normalizedPath = cleanPath(path);
  if (normalizedPath == '') {
    return;
  }
  const meta = getRouteMeta(normalizedPath);
  routeState.path = normalizedPath;
  routeState.fullPath = fullPath;
  routeState.query = query;
  routeState.meta = meta;
  if (meta == null) {
    routeState.name = null;
  }
  else {
    routeState.name = readMetaString(meta, 'name');
  }
}

/**
 * 用 url 字符串同步路由状态（导航拦截器与业务侧手动刷新用）
 *
 * @param url 目标 url，如 `/src/pages/detail/detail?id=1`、`src/pages/index/index?tab=2`
 */
export function applyRouteFromUrl(url: string): void {
  if (url == '') {
    return;
  }
  const urlObj = parseUrlToObj(url);
  const normalizedPath = cleanPath(urlObj.path);
  if (normalizedPath == '') {
    return;
  }
  const queryStr = getQueryString(url);
  if (queryStr == '') {
    commitRoute(normalizedPath, urlObj.query, normalizedPath);
    return;
  }
  commitRoute(normalizedPath, urlObj.query, `${normalizedPath}?${queryStr}`);
}

/**
 * 把 `{ key: value }` 形态的对象（onAppRoute 事件载荷 / UniPage.options）转成 query Map
 *
 * ⚠️ 这里必须用「UTSJSONObject.keys() + 下标访问」，**不要**用实例方法 getAny()/getJSON()：
 *    H5 / 蒸汽模式的运行时下发的是纯 JS 对象（uni-h5 内部 `Object.assign({}, event.query)`），
 *    没有 UTSJSONObject 的实例方法，getAny() 会抛 `rawQuery.getAny is not a function`；
 *    该异常又被运行时的 try/catch 吞掉（只在 console.error 出现），
 *    表现为「路由状态整体不更新、query 恒为空」（2026-10-13 实测，见分册 1 的 getJSON/getAny 说明）。
 *    UTSJSONObject.keys 在 H5 侧就是 Object.keys，下标访问两端都成立。
 *
 * ⚠️ 各端交来的**值编码态不一致**，必须过 decodeQueryValue 归一（只对字符串解）：
 *    微信小程序的页面 `options` 是 URL 编码态（微信官方口径「路由参数以 URL 编码传递，
 *    需自行 decodeURIComponent」，MP 运行时 `this.options = onLoad(query)` 原样转存），
 *    而 `onAppRoute` 事件 / App 页面 options 多为解码态 —— 不归一就会出现
 *    「小程序上中文 name 参数显示成 `%E5%AF%B9%E8%B1%A1...`」。
 *    非字符串值（number / boolean / JSON 串）走 stringify 后不再解码。
 *
 * @param raw 参数对象；为 null 时返回空 Map
 */
function queryMapFromObject(raw: UTSJSONObject | null): Map<string, string> {
  const query = new Map<string, string>();
  if (raw == null) {
    return query;
  }
  const keys = UTSJSONObject.keys(raw);
  for (let i = 0; i < keys.length; i++) {
    const key = keys[i];
    const value = raw[key];
    if (value == null) {
      continue;
    }
    const text = queryValueToString(value);
    query.set(key, typeof value == 'string' ? decodeQueryValue(text) : text);
  }
  return query;
}

/**
 * 从页面栈回读当前路由（冷启动 / 返回上一页 / 导航失败回滚 / 页面重新显示时的兜底）
 *
 * 路径与参数都来自**同一个**栈顶页面：`route` 给路径、`options` 给参数（UniPage 的官方属性，
 * 见 utils 的 getCurrentPageOptions），因此不再有「回读必然丢失 query」的先天缺陷。
 *
 * ⚠️ **调用时机必须落在页面栈已稳定的时刻**：App 端页面刚入栈时栈顶仍是上一页
 *    （详见本文件头部说明），此刻回读会把状态改回上一页。所以本函数**不**在页面 setup /
 *    导航 success 时调用，新增页面的初始状态由导航发起方直接写入（`applyRouteFromUrl`）。
 *
 * ⚠️ 「同一页面且这次没读到参数」时跳过：否则会用空 query 抹掉导航发起方写入的参数。
 */
export function syncRouteState(): void {
  const currentPath = getCurrentPath();
  if (currentPath == '') {
    return;
  }
  const query = queryMapFromObject(getCurrentPageOptions());
  if (currentPath == routeState.path && query.size == 0) {
    return;
  }
  commitRoute(currentPath, query, buildFullPath(currentPath, query));
}

// ==========================================
// 全局路由完成监听（主数据源）
// ==========================================

/**
 * 处理 onAppRoute 事件：把官方事件载荷落进 routeState
 *
 * 注意 `event.path` 官方口径为「不含开头的斜杠」，由 cleanPath 统一补上。
 */
function handleAppRoute(event: AppRouteEvent): void {
  const rawPath = event.path;
  if (rawPath == '') {
    return;
  }
  const normalizedPath = cleanPath(rawPath);
  const query = queryMapFromObject(event.query);
  commitRoute(normalizedPath, query, buildFullPath(normalizedPath, query));
}

/** 监听是否已安装（幂等标记，避免重复注册导致回调叠加） */
let routeListenerInstalled: boolean = false;

/**
 * 安装全局「路由完成」监听（幂等，由 useRoute / useRouter 自动调用）
 */
export function installRouteStateListener(): void {
  if (routeListenerInstalled) {
    return;
  }
  routeListenerInstalled = true;
  uni.onAppRoute((event: AppRouteEvent): void => {
    console.log(event, 'event');
    handleAppRoute(event);
  });
}

/**
 * 卸载全局「路由完成」监听（一般无需调用，主要供单测复位）
 *
 * ⚠️ 这里按官方签名不传回调，会移除**所有** onAppRoute 监听；
 *    若业务另有 onAppRoute 监听，请勿调用本方法。
 */
export function uninstallRouteStateListener(): void {
  if (!routeListenerInstalled) {
    return;
  }
  routeListenerInstalled = false;
  uni.offAppRoute();
}

/**
 * 确保路由状态已就绪：安装监听 + （仅状态为空时）从页面栈回读
 * （useRoute / useRouter 内部调用，业务侧一般不需要直接调用）
 *
 * ⚠️ 回读**只在状态还是空的时候**做。理由见本文件头部「App 端页面栈有滞后」：
 *    页面 setup 时栈顶可能还停在上一页，无条件回读会把刚由导航发起方写好的目标路由
 *    覆盖回上一页（这正是「安卓上进入新页面却显示上一页路由信息」的直接成因）。
 *    状态非空说明已经有人写过当前路由，就不要再读了。
 */
export function ensureRouteReady(): void {
  installRouteStateListener();
  if (routeState.path != '') {
    return;
  }
  // 冷启动 / 直链进入：还没有任何导航写入过状态，此时栈顶就是当前页，回读是安全的
  syncRouteState();
  // App 端首个页面入栈可能晚于本函数执行，延后一拍再补一次（仍以「状态为空」为前提）
  setTimeout((): void => {
    if (routeState.path == '') {
      syncRouteState();
    }
  }, 0);
}
