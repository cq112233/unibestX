/**
 * useRouter —— 路由导航器（对标 vue-router 的 useRouter）
 *
 * 底层仍然走 uni 原生跳转 API，**因此 main.uts 里安装的全局路由拦截器（登录校验等）照常生效**。
 *
 * ## 用法
 *
 * ```uts
 * import { useRouter } from '@/src/router/index.uts';
 *
 * const router = useRouter();
 * router.push('/src/sub/auth/login');
 * router.push({ path: '/src/pages/detail/detail', query: { id: 1, tab: 'a' } });
 * router.push({ name: 'modalBasicDemo', params: { id: 1 } }); // 自动匹配路径并将 params 转为 query
 * router.replace({ name: 'index' });
 * router.back();          // 等价 back(1)
 * ```
 *
 * ## 两条必须知道的约束
 *
 * 1. **对象形态收 `RouteLocationRaw`**（`@/src/router/utils/utils.uts`）：
 *    支持 `{ path, query }` 或 `{ name, params }` 字面量与 `RouteLocationRaw` 变量，
 *    按 `name` 会自动检索页面完整路径并将 `params` 转为 query 拼接到 url 上。
 *    参数标成 `any` 时编辑器给不出字段补全，标 `UTSJSONObject` 只弹它的成员方法，
 *    所以这里必须是具名类型（VSCode / Volar 里 `na` 能补出 `name`，`pa` 能补出 `path` / `params`）。
 *    反过来说，**裸的 `UTSJSONObject`（如 `JSON.parseObject()` 的返回值）不再被接受**，
 *    会被类型检查挡在编译期 —— 这是有意的收紧。
 * 2. **TabBar 页面必须用 `switchTab()`**，`push()` 走的是 `uni.navigateTo`，
 *    跳 TabBar 页面会被框架拒绝（TabBar 页面列表由 `src/tabbar` 维护，这里不反向依赖它）。
 */
import { resolveUrl } from '../utils/utils.uts';
import type { RouteLocationRaw } from '../utils/utils.uts';
import { ensureRouteReady } from './route-state.uts';
import { useRoute } from './useRoute.uts';
import type { RouteLocation } from './route-types.uts';

/**
 * 路由导航器
 *
 * 每个方法都返回该 uni API 的 Promise（入参为空、什么都没做时返回 null），
 * 调用方需要处理失败时可以用 `.then(onFulfilled, onRejected)`。
 */
export class Router {
  /**
   * 当前页面路由对象（等价于调用 useRoute() 的返回值）
   */
  get currentRoute(): RouteLocation {
    return useRoute();
  }

  /**
   * 新页面入栈（保留当前页，可返回）
   *
   * @param to 字符串 url 或 `{ path, name, query, params }` 字面量 / `RouteLocationRaw` 变量
   * @returns `uni.navigateTo` 的 Promise；入参为空 / 无法解析路径时返回 null
   */
  push(to: string | RouteLocationRaw | null): any | null {
    const url = resolveUrl(to);
    if (url == '') {
      return null;
    }
    return uni.navigateTo({ url });
  }

  /**
   * 关闭当前页并打开新页（当前页不保留）
   *
   * @param to 字符串 url 或 `{ path, name, query, params }` 字面量 / `RouteLocationRaw` 变量
   * @returns `uni.redirectTo` 的 Promise；入参为空 / 无法解析路径时返回 null
   */
  replace(to: string | RouteLocationRaw | null): any | null {
    const url = resolveUrl(to);
    if (url == '') {
      return null;
    }
    return uni.redirectTo({ url });
  }

  /**
   * 关闭所有页面再打开目标页
   *
   * @param to 字符串 url 或 `{ path, name, query, params }` 字面量 / `RouteLocationRaw` 变量
   * @returns `uni.reLaunch` 的 Promise；入参为空 / 无法解析路径时返回 null
   */
  relaunch(to: string | RouteLocationRaw | null): any | null {
    const url = resolveUrl(to);
    if (url == '') {
      return null;
    }
    return uni.reLaunch({ url });
  }

  /**
   * 跳转到 TabBar 页面（目标必须在 pages.json 的 tabBar 中声明）
   *
   * @param to 字符串 url 或 `{ path, name, query, params }` 字面量 / `RouteLocationRaw` 变量
   * @returns `uni.switchTab` 的 Promise；入参为空 / 无法解析路径时返回 null
   */
  switchTab(to: string | RouteLocationRaw | null): any | null {
    const url = resolveUrl(to);
    if (url == '') {
      return null;
    }
    return uni.switchTab({ url });
  }

  /**
   * 返回上一页 / 前 n 页
   *
   * @param delta 返回的层数，默认 1；超出页面栈层数时回到首页
   */
  back(delta: number = 1): void {
    uni.navigateBack({ delta });
  }

  /**
   * vue-router 形态的 `go()`：只支持**负数**（等价 `back(-delta)`）
   *
   * uni-app X 没有「前进」API，`go()` 传正数时打印一条告警后忽略，不做任何跳转。
   *
   * @param delta 负数表示后退层数，默认 -1
   */
  go(delta: number = -1): void {
    if (delta < 0) {
      uni.navigateBack({ delta: -delta });
      return;
    }
    console.warn('[router] uni-app X 无「前进」API，router.go(正数) 已忽略：', delta);
  }

  /**
   * 把导航目标解析为 uni 可用的 url 字符串（不执行跳转）
   *
   * @param to 字符串 url 或 `{ path, name, query, params }` 字面量 / `RouteLocationRaw` 变量
   * @returns 归一化后的 url；入参为空或无法解析路径时返回空串 ""
   */
  resolve(to: string | RouteLocationRaw | null): string {
    return resolveUrl(to);
  }
}

/** 路由导航器全局单例 */
export const router = new Router();

/**
 * 获取路由导航器（全局单例，可在任意 setup / 普通函数中调用）
 *
 * 首次调用会顺带确保路由状态已就绪（安装全局路由完成监听 + 回读一次当前路由）。
 *
 * @returns 全局唯一的 `Router` 实例（每次都返回同一个，可安全长期持有）
 */
export function useRouter(): Router {
  ensureRouteReady();
  return router;
}
