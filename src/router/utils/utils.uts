/**
 * 路由与页面路径工具库
 * 统一收敛页面路径规范化、清洗、当前页面路径获取与比对、以及 URL 解析方法
 */

/**
 * URL 解析结构体
 */
export type UrlObj = {
  /** 页面路由路径（不含参数） */
  path: string;
  /** 路由参数键值对 Map */
  query: Map<string, string>;
};

/**
 * 解析 URL 字符串为路径与参数键值对
 * 例如: "/src/pages/login?redirect=index" -> { path: "/src/pages/login", query: { redirect: "index" } }
 *
 * @param url 待解析的 URL 字符串
 * @returns 包含 path 和 query Map 的 UrlObj
 */
export function parseUrlToObj(url: string): UrlObj {
  const parts = url.split('?');
  const path = parts[0];
  const query = new Map<string, string>();
  if (parts.length > 1) {
    const queryStr = parts[1];
    const pairs = queryStr.split('&');
    for (let i = 0; i < pairs.length; i++) {
      const pair = pairs[i].split('=');
      if (pair.length > 1) {
        const key = pair[0];
        let value = pair[1];
        // 解码包含百分号转义的参数值
        if (value.includes('%')) {
          value = decodeURIComponent(value) ?? '';
        }
        query.set(key, value);
      }
      else if (pair.length > 0) {
        query.set(pair[0], '');
      }
    }
  }
  return { path, query } as UrlObj;
}

/**
 * 保证路径以前导斜杠 "/" 开头
 * 例如："pages/index" -> "/pages/index"
 *
 * @param path 原始路径
 * @returns 以前导斜杠开头的路径
 */
export function ensureLeadingSlash(path: string): string {
  if (path.length == 0) {
    return '/';
  }
  return path.startsWith('/') ? path : `/${path}`;
}

/**
 * 去除路径前导斜杠 "/"
 * 例如："/pages/index" -> "pages/index"
 *
 * @param path 原始路径
 * @returns 去除前导斜杠后的路径
 */
export function removeLeadingSlash(path: string): string {
  if (path.startsWith('/')) {
    return path.substring(1);
  }
  return path;
}

/**
 * 清洗并规范化页面路径（去除 ? 及后面的查询参数，统一保证前导 /）
 * 例如：
 * - "src/pages/index/index?foo=1" -> "/src/pages/index/index"
 * - "/pages/index/index?tab=2" -> "/pages/index/index"
 * - "pages/index/index" -> "/pages/index/index"
 *
 * @param path 原始路径或包含参数的 URL
 * @returns 规范化后的路径（以 / 开头，不含 query 参数）
 */
export function cleanPath(path: string): string {
  if (path.length == 0) {
    return '';
  }
  let p = path.trim();
  const queryIdx = p.indexOf('?');
  if (queryIdx >= 0) {
    p = p.substring(0, queryIdx);
  }
  return p.startsWith('/') ? p : `/${p}`;
}

/**
 * 比较两个页面路径是否指向同一页面
 * 自动去除 query 参数与前导斜杠，支持完整匹配与结尾路由匹配
 * 例如：
 * - "/pages/index/index" 与 "pages/index/index?foo=1" -> true
 * - "/src/pages/index/index" 与 "pages/index/index" -> true
 * - "pages/index/index" 与 "/pages/index/index" -> true
 *
 * @param path1 路径1
 * @param path2 路径2
 * @returns 是否指向同一页面
 */
export function isSamePath(path1: string, path2: string): boolean {
  const p1 = cleanPath(path1);
  const p2 = cleanPath(path2);
  if (p1 == p2) {
    return true;
  }
  // 去除前导斜杠后再比一次
  const raw1 = removeLeadingSlash(p1);
  const raw2 = removeLeadingSlash(p2);
  if (raw1 == raw2) {
    return true;
  }
  // 支持末尾路由包含匹配（处理带或不带 src/ 前缀的场景）
  return raw1.endsWith(raw2) || raw2.endsWith(raw1);
}

/**
 * 获取当前栈顶页面的原生 route 路径字符串（如 "pages/index/index"）
 * @returns 页面路由字符串，未获取到时返回空字符串 ""
 */
export function getCurrentRoute(): string {
  try {
    const pages = getCurrentPages();
    if (pages.length > 0) {
      const page = pages[pages.length - 1];
      return page.route ?? '';
    }
  }
  catch {
    // ignore
  }
  return '';
}

/**
 * 获取当前栈顶页面的规范化路径（统一带前导 "/"，且去除 URL 参数）
 * 例如："/pages/index/index"
 * @returns 规范化路径字符串，未获取到时返回空字符串 ""
 */
export function getCurrentPath(): string {
  const route = getCurrentRoute();
  if (route.length == 0) {
    return '';
  }
  return cleanPath(route);
}

/**
 * 获取 URL 中的查询参数字符串（去除 ?）
 * 例如："/pages/login?from=home&tab=1" -> "from=home&tab=1"
 *
 * @param url 完整 URL 字符串
 * @returns 查询参数字符串，无参数时返回空字符串 ""
 */
export function getQueryString(url: string): string {
  const idx = url.indexOf('?');
  if (idx >= 0 && idx < url.length - 1) {
    return url.substring(idx + 1);
  }
  return '';
}

/**
 * 获取当前页面栈的深度（当前打开的页面数）
 * @returns 页面栈数量
 */
export function getPageStackLength(): number {
  try {
    return getCurrentPages().length;
  }
  catch {
    return 0;
  }
}

/**
 * query 值的字符串化：string / number / boolean 直转，数组用 `,` 连接，其余走 JSON
 *
 * @param value 任意 query 值
 * @returns 字符串形态；对象序列化失败时返回空串
 */
export function queryValueToString(value: any): string {
  if (Array.isArray(value)) {
    const arr = value as Array<any>;
    const items: Array<string> = [];
    for (let i = 0; i < arr.length; i++) {
      items.push(queryValueToString(arr[i]));
    }
    return items.join(',');
  }
  const valueType = typeof value;
  if (valueType == 'string') {
    return value as string;
  }
  if (valueType == 'number') {
    return `${value as number}`;
  }
  if (valueType == 'boolean') {
    return (value as boolean) ? 'true' : 'false';
  }
  if (valueType == 'object') {
    return JSON.stringify(value) ?? '';
  }
  return '';
}

/**
 * 把 `{ key: value }` 形态的 query 对象序列化为 query 串（值做 URL 编码）
 *
 * ⚠️ 键遍历必须用 `UTSJSONObject.keys()` + `getAny()`：写成
 *    `query.toMap().forEach((value: any, key: string) => {})` 会因给 any 值参数
 *    显式标注类型而在 Kotlin 端报 error17（详见分册 1.14）。
 *
 * @param query query 对象，值为 null 的键按「忽略」处理
 * @returns 形如 `id=1&tab=home` 的 query 串，无有效键时返回空串
 */
export function serializeQuery(query: UTSJSONObject | null): string {
  if (query == null) {
    return '';
  }
  const parts: Array<string> = [];
  const keys = UTSJSONObject.keys(query);
  for (let i = 0; i < keys.length; i++) {
    const key = keys[i];
    const value = query.getAny(key);
    if (value == null) {
      continue;
    }
    parts.push(`${key}=${encodeURIComponent(queryValueToString(value))}`);
  }
  return parts.join('&');
}

/**
 * 把导航目标归一化为 uni 导航 API 可直接使用的 url 字符串
 * 支持两种形态（与 vue-router 的 router.push 一致）：
 * - 字符串：`'/src/pages/index/index'`、`'subDetail?id=1'`
 * - 对象：`{ path: '/src/pages/detail/detail', query: { id: 1 } }`
 *
 * ⚠️ 对象形态**必须写成对象字面量**：字面量在 UTS 里编译为 `UTSJSONObject`；
 *    若先声明成带 `type` 标注的变量再传，会编译成原生对象（Kotlin data class），
 *    这里 `as UTSJSONObject` 会在真机抛 ClassCastException（H5 / 单测不复现）。
 *    因此本模块**不导出**对象形态的类型别名，避免诱导出那种写法。
 *
 * @param to 导航目标（字符串 url 或 `{ path, query }` 字面量）
 * @returns 归一化后的 url；空对象或缺 path 时返回空串 ""
 */
export function resolveUrl(to: any | null): string {
  if (to == null) {
    return '';
  }
  if (typeof to == 'string') {
    return to as string;
  }
  const obj = to as UTSJSONObject;
  const path = obj.getString('path') ?? '';
  if (path == '') {
    return '';
  }
  const queryStr = serializeQuery(obj.getJSON('query'));
  if (queryStr == '') {
    return path;
  }
  return `${path}?${queryStr}`;
}

// ==========================================
// 路由工具统一聚合类（全端一目了然速查与单例）
// ==========================================

/**
 * 路由工具聚合类
 *
 * 集中呈现所有路由与路径处理方法，一目了然；同时支持面向对象式 `route.xxx()` 调用。
 *
 * @example
 * ```uts
 * // 方式 1：标准具名导入
 * import { cleanPath, getCurrentPath, parseUrlToObj } from '@/src/router';
 *
 * // 方式 2：对象单例导入（一目了然）
 * import { route } from '@/src/router';
 * console.log(route.getCurrentPath());
 * ```
 */
export class RouteUtils {
  /** 解析 URL 为路径与参数 Map */
  parseUrlToObj(url: string): UrlObj {
    return parseUrlToObj(url);
  }

  /** 清洗并规范化页面路径（去除 ? 参数，统一补全前导 /） */
  cleanPath(path: string): string {
    return cleanPath(path);
  }

  /** 保证路径以前导斜杠 "/" 开头 */
  ensureLeadingSlash(path: string): string {
    return ensureLeadingSlash(path);
  }

  /** 获取当前栈顶页面的规范化路径（带前导 /，不含 query） */
  getCurrentPath(): string {
    return getCurrentPath();
  }

  /** 获取当前栈顶页面的原生 route 字符串 */
  getCurrentRoute(): string {
    return getCurrentRoute();
  }

  /** 获取当前页面栈层数 */
  getPageStackLength(): number {
    return getPageStackLength();
  }

  /** 获取 URL 中的 query 参数字符串 */
  getQueryString(url: string): string {
    return getQueryString(url);
  }

  /** 比较两个页面路径是否指向同一页面 */
  isSamePath(path1: string, path2: string): boolean {
    return isSamePath(path1, path2);
  }

  /** 去除路径的前导斜杠 "/" */
  removeLeadingSlash(path: string): string {
    return removeLeadingSlash(path);
  }

  /** 把 `{ path, query }` 对象序列化为 query 串（值做 URL 编码） */
  serializeQuery(query: UTSJSONObject | null): string {
    return serializeQuery(query);
  }

  /** query 值的字符串化（string / number / boolean / 数组 / 对象 通用） */
  queryValueToString(value: any): string {
    return queryValueToString(value);
  }

  /** 把导航目标（字符串 url 或 `{ path, query }` 字面量）归一化为 url 字符串 */
  resolveUrl(to: any | null): string {
    return resolveUrl(to);
  }
}

/** 路由工具全局单例 */
export const route = new RouteUtils();

/** 别名导出 */
export const routerUtils = route;
export const routeUtils = route;

export default route;
