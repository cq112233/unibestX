/**
 * 业务路由配置模块 (src/router)
 *
 * 底层基于 @/uni_modules/route-bestX 极简高性能路由引擎，
 * 负责组装应用的全局前置守卫（登录态拦截）、TabBar 代理桥接与初始化。
 */
import {
  createRouter,
  setPageMetaJson
} from '@/uni_modules/route-bestX/index.uts';
import { isPageTabbar, setupTabNavigationGuard, switchTabbar } from '@/src/tabbar/index.uts';
import { setupRouteGuards } from './guards/index.uts';
// 通过插件uni-pages-route-table自动获取页面路由表,依赖插件vite-plugin-uni-pages，如果不使用vite-plugin-uni-pages，不能根据PLATFORM做页面归一
import { PAGES_ROUTE_TABLE_JSON } from 'virtual:uni-pages-route-table';

// 0. 初始化页面路由表（支持 pages.json 静态配置与 useRoute() 的页面配置 / name）
setPageMetaJson(PAGES_ROUTE_TABLE_JSON);

// 模式 4 的虚拟 Tab 切换前置钩子（第三方来源处理、参数换取、数据预取等）
setupTabNavigationGuard();

// 1. 全局单例路由器（桥接业务 TabBar 动态判定与切换，内部全自动调度与兜底）
// 💡 1. 为什么不能去掉 isTabbar 后，router.push('/src/pages/index/index') 无法识别这是 TabBar 页面，会走 uni.navigateTo。原生 TabBar 模式下通常直接跳转失败。
// 💡 2. 为什么去掉 switchTab 后，虽然 route-bestX 会退化为 uni.switchTab，但会绕过 src/tabbar 的 switchTabbar()，导致：
// - 当前 Tab 高亮 curIdx 不更新；
// - 自定义 TabBar 模式（0/3）可能跳转失败；
// - 单页 TabBar 保活、沙盒降级、中间鼓包等逻辑不生效。
export const router = createRouter({
  isTabbar: (url: string): boolean => isPageTabbar(url),
  switchTab: (url: string): void => {
    switchTabbar(url, 'router');
  }
});

// 2. 自动注册业务全局守卫与生命周期钩子
setupRouteGuards(router);

// 3. 导出核心路由组合式 Hooks，支持 import { useRoute, useRouter } from '@/src/router/index.uts'
export {
  useRoute,
  useRouter
} from '@/uni_modules/route-bestX/index.uts';

export default router;
