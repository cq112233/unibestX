/**
 * 业务路由配置模块 (src/router)
 *
 * 底层基于 @/uni_modules/route-bestX 极简高性能路由引擎，
 * 负责组装应用的全局前置守卫（登录态拦截）、TabBar 代理桥接与初始化。
 */
import {
  createRouter,
  setPageMetaJson
} from '@/uni_modules/route-bestX/index.uts';
import { isPageTabbar, switchTabbar } from '@/src/tabbar/index.uts';
import { setupRouteGuards } from './guards/index.uts';
// 通过插件获取页面路由表
import { PAGES_ROUTE_TABLE_JSON } from 'virtual:uni-pages-route-table';

// 0. 初始化页面路由表（支持 pages.json 静态配置与 useRoute() 的页面配置 / name）
setPageMetaJson(PAGES_ROUTE_TABLE_JSON);

// 1. 全局单例路由器（桥接业务 TabBar 动态判定与切换，内部全自动调度与兜底）
export const router = createRouter({
  isTabbar: (url: string): boolean => isPageTabbar(url),
  switchTab: (url: string): void => {
    switchTabbar(url);
  }
});

// 2. 自动注册业务全局守卫与生命周期钩子
setupRouteGuards(router);

// 3. 导出核心路由组合式 Hooks，支持 import { useRoute, useRouter } from '@/src/router/index.uts'
export {
  useRoute,
  useRouter
} from '@/uni_modules/route-bestX/index.uts';

export default router;
