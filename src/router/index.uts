/**
 * 路由模块统一入口 (Router Suite)
 * 统一聚合路由配置 (config)、路由守卫与拦截器 (interceptor)、业务路由守卫 (guard)、
 * 登录跳转 (toLoginPage)、路由工具 (utils) 与 vue-router 形态的组合式 hooks
 * (hooks：useRoute / useRouter)
 *
 * ⚠️ 每个符号**只在这里转发一层**（子模块之间不互相 `export *`），避免 Kotlin 端
 *    符号被改名成 `xxx__1` 报 error18 / 运行期 NoSuchMethodError。`./guard/` 下面三个文件
 *    是被本文件**各自直接转发**的（guard/index.uts 只 import 兄弟文件，不二次 `export *`），
 *    所以别在 guard 目录里再加一层门面。
 * ⚠️ 业务规则（登录判定 / 白名单 / 放行裁决）一律写在 `./guard/` 里（业务开发者主战场，
 *    目录约定见 ./guard/index.uts），别往本文件加业务代码；反过来 `./guard/` 里的文件也不要
 *    import 本入口 —— 本文件转出了它们，互相 import 就成自环（Kotlin 端类初始化死锁）。
 */
export * from './config/config.uts';
export * from './guard/guardLogin.uts';
export * from './guard/index.uts';
export * from './guard/types.uts';
export * from './hooks/route-state.uts';
export * from './hooks/useRoute.uts';
export * from './hooks/useRouter.uts';
export * from './interceptor/interceptor.uts';
export * from './toLoginPage/toLoginPage.uts';
export * from './utils/utils.uts';
