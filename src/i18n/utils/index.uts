import i18n from '../index.uts';

/**
 * 通用 i18n 翻译函数（未找到翻译时自动回退返回原 key 字符串）
 * @param key 翻译的 key
 * @param named 命名参数
 */
export function t(key: string, named: UTSJSONObject | null = null): string {
  let res: string = '';
  if (named != null) {
    res = i18n.global.t(key, named);
  }
  else {
    res = i18n.global.t(key);
  }
  return (res != null && res.length > 0) ? res : key;
}

/**
 * 模板内可直接调用的翻译别名（`t` 的同义封装，行为完全一致；脚本里请直接用 `t`）
 * @param key 翻译 key，**未命中翻译时原样返回 key 本身**（不抛错也不返回空串，方便肉眼发现漏配）
 * @param named 命名插值参数（对应文案里 `{name}` 形式的占位符），传 null 表示该文案无插值
 * @returns 翻译文案；key 不存在时返回 key 原文
 */
export function $t(key: string, named: UTSJSONObject | null = null): string {
  return t(key, named);
}

/**
 * 判断字符串是否为「多语言 key 形态」而非展示用原文（如中文标题）
 *
 * 规则：非空、含 `.` 分隔符、且全部字符均为可打印 ASCII（不含空格）
 * - 'tabbar.home'      → true
 * - 'Crypto 加密解密'   → false（含空格与中文）
 * - '时间日期操作'      → false（无点号且为中文）
 *
 * @param text 待判断的字符串
 * @returns 形如多语言 key 时返回 true
 */
export function isI18nKeyLike(text: string): boolean {
  if (text.length == 0) {
    return false;
  }
  // key 至少形如 'a.b'，无点号一律视为展示原文
  if (text.indexOf('.') <= 0) {
    return false;
  }
  for (let i = 0; i < text.length; i++) {
    // UTS 里 String.charCodeAt() 的返回类型是 number | null
    const code: number = text.charCodeAt(i) ?? 0;
    // 33..126 为可打印 ASCII（排除空格、控制字符与全部非 ASCII 字符）
    if (code < 33 || code > 126) {
      return false;
    }
  }
  return true;
}

/**
 * 获取 %xxx% 格式包装或普通 key 的多语言翻译文本（未找到时自动回退返回原 key 字符串）
 * 例如：%basic.langTitle% 或 basic.langTitle
 *
 * 未做 %xxx% 包装的文本，仅在「形如 key」（见 isI18nKeyLike）时才进入 i18n 查询；
 * 中文标题等展示原文原样返回，避免被 lime-i18n 当作缺失 key 打出
 * 「无法翻译键路径 'xxx'」的控制台噪音（navBar / TabBar 标题共用本函数）
 *
 * @param key 多语言 key 或展示原文
 */
export function getI18nText(key: string): string {
  const isWrapped = key.startsWith('%') && key.endsWith('%') && key.length > 2;
  // 显式 %xxx% 包装视为强意图，一律走翻译；其余仅在形如 key 时才查询
  if (!isWrapped && !isI18nKeyLike(key)) {
    return key;
  }
  let cleanKey = key;
  if (isWrapped) {
    cleanKey = key.substring(1, key.length - 1);
  }
  const res = i18n.global.t(cleanKey);
  return (res != null && res.length > 0) ? res : cleanKey;
}

/**
 * 设置原生/当前页面 NavigationBar (导航栏) 标题的多语言文本
 * @param titleKey 标题的多语言 key，支持 'basic.langTitle' 或 '%basic.langTitle%' 格式
 */
export function setNavigationBarTitle(titleKey: string): void {
  const title = getI18nText(titleKey);
  uni.setNavigationBarTitle({
    title
  } as SetNavigationBarTitleOptions);
  uni.$emit('setNavbarTitle', title);
}

/**
 * 非 vue / uvue 文件中使用 i18n 测试示例
 */
export function testI18n(): void {
  uni.showModal({
    title: 'i18n 测试',
    content: t('message.welcome', null)
  } as ShowModalOptions);
}

// ==========================================
// 国际化多语言工具聚合类（全端一目了然速查与单例）
// ==========================================

/**
 * 国际化多语言工具聚合类
 *
 * 集中呈现国际化翻译与标题设置方法，一目了然；同时支持面向对象式 `i18nUtils.xxx()` 调用。
 *
 * @example
 * ```uts
 * // 方式 1：标准具名导入
 * import { t, getI18nText } from '@/src/i18n/utils/index.uts';
 *
 * // 方式 2：对象单例导入（一目了然）
 * import { i18nUtils } from '@/src/i18n/utils/index.uts';
 * console.log(i18nUtils.t('app.name'));
 * ```
 */
export class I18nUtils {
  /** 通用 i18n 翻译函数（未找到翻译时自动回退返回原 key 字符串） */
  t(key: string, named: UTSJSONObject | null = null): string {
    return t(key, named);
  }

  /** 通用 i18n 翻译快捷函数 */
  $t(key: string, named: UTSJSONObject | null = null): string {
    return $t(key, named);
  }

  /** 获取 %xxx% 格式包装或普通 key 的多语言翻译文本 */
  getI18nText(key: string): string {
    return getI18nText(key);
  }

  /** 判断字符串是否为「多语言 key 形态」（非 key 的展示原文不进入 i18n 查询） */
  isI18nKeyLike(text: string): boolean {
    return isI18nKeyLike(text);
  }

  /** 设置原生/当前页面 NavigationBar (导航栏) 标题的多语言文本 */
  setNavigationBarTitle(titleKey: string): void {
    setNavigationBarTitle(titleKey);
  }

  /** 非 vue / uvue 文件中使用 i18n 测试示例 */
  testI18n(): void {
    testI18n();
  }
}

/** 国际化多语言工具全局单例 */
export const i18nUtils = new I18nUtils();

export default i18nUtils;
