import { createI18n } from '@/uni_modules/lime-i18n';
import zhCN from './locales/zh-CN.json';
import enUS from './locales/en-US.json';
import { getDefaultLocale } from '@/src/config/env/env.uts';

function getInitialLocale(): string {
  try {
    const limeRaw = uni.getStorageSync('uVueI18nLocale');
    if (limeRaw != null) {
      const str = `${limeRaw}`;
      if (str.length > 0 && str != 'null' && str != 'undefined') {
        return str;
      }
    }
    const piniaRaw = uni.getStorageSync('pinia:i18n');
    if (piniaRaw != null) {
      const rawStr = `${piniaRaw}`;
      if (rawStr.length > 0 && rawStr != 'null' && rawStr != 'undefined') {
        const parsed = JSON.parseObject(rawStr);
        if (parsed != null) {
          const obj = (parsed.state != null ? parsed.state : parsed) as UTSJSONObject;
          if (obj.locale != null) {
            const l = `${obj.locale}`;
            if (l.length > 0 && l != 'null' && l != 'undefined') {
              return l;
            }
          }
        }
      }
    }
  }
  catch {
    // ignore
  }
  return getDefaultLocale();
}

const i18n = createI18n({
  locale: getInitialLocale(),
  fallbackLocale: 'en-US',
  messages: {
    'zh-CN': zhCN as UTSJSONObject,
    'en-US': enUS as UTSJSONObject
  } as UTSJSONObject
} as UTSJSONObject);

export default i18n;
