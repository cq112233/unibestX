<template>
  <!-- 全屏遮罩弹窗组件 (具备穿透/覆盖底部 TabBar 能力的基础通用组件) -->
  <!-- 微信小程序端：使用 root-portal 提升至 page 根节点以穿透 TabBar -->
  <!-- #ifdef MP -->
  <root-portal v-if="isShown">
    <view class="tabbar-modal-mask-root" :style="{ zIndex }">
      <!-- 暗色遮罩背景（点击空白处触发关闭） -->
      <view class="tabbar-modal-backdrop" @click="handleMaskClick" />

      <!-- 居中卡片本体 -->
      <view
        class="tabbar-modal-card"
        :class="{ 'tabbar-modal-card--dark': isDark }"
        :style="{ width }"
      >
        <!-- 头部插槽 / 默认标题栏 -->
        <slot name="header">
          <view
            v-if="title.length > 0 || showClose"
            class="tabbar-modal-header"
          >
            <view class="tabbar-modal-title-wrap">
              <text v-if="icon.length > 0" class="tabbar-modal-icon">{{ icon }}</text>
              <text
                class="tabbar-modal-title-text"
                :class="{ 'tabbar-modal-title-text--dark': isDark }"
              >
                {{ displayTitle }}
              </text>
            </view>
            <view v-if="showClose" class="tabbar-modal-close-btn" @click="handleClose">
              <text class="tabbar-modal-close-text">✕</text>
            </view>
          </view>
        </slot>

        <!-- 命令式传入的数据回执（ref 桥「传数据」的落点）；未传时不渲染 -->
        <view v-if="payloadMessage.length > 0" class="tabbar-modal-payload-wrap">
          <text
            class="tabbar-modal-payload-msg"
            :class="{ 'tabbar-modal-payload-msg--dark': isDark }"
          >
            {{ payloadMessage }}
          </text>
          <text class="tabbar-modal-payload-source">来自：{{ payloadSource }}</text>
        </view>

        <!-- 默认内容插槽（未传自定义 slot 时展示默认全屏覆盖解析卡片） -->
        <slot>
          <text
            class="tabbar-modal-desc-text"
            :class="{ 'tabbar-modal-desc-text--dark': isDark }"
          >
            在模式 0、2、3、4（尤其默认推荐的模式 4）下，暗色遮罩已将全屏及底部 TabBar 完全覆盖！
          </text>

          <!-- 关键原理解析卡片 -->
          <view
            class="tabbar-modal-tip-card"
            :class="{ 'tabbar-modal-tip-card--dark': isDark }"
          >
            <text class="tabbar-modal-tip-text-green">
              ✓ 全屏覆盖：模式 0/2/3/4 全端完美覆盖全屏（z-index: {{ zIndex }} &gt; 999）
            </text>
            <text class="tabbar-modal-tip-text-indigo">
              ✓ 原生底座差异：模式 1 原生 TabBar 仅 H5 可遮挡，App/小程序为系统层级
            </text>
            <text class="tabbar-modal-tip-text-amber">
              ✓ 微信环境适配：小程序端使用 root-portal 提升至 Page 根节点
            </text>
          </view>
        </slot>

        <!-- 底部插槽 / 默认操作按钮 -->
        <slot name="footer">
          <view class="tabbar-modal-confirm-btn" @click="handleClose">
            <text class="tabbar-modal-confirm-text">{{ confirmText }}</text>
          </view>
        </slot>
      </view>
    </view>
  </root-portal>
  <!-- #endif -->

  <!-- 非微信小程序端（App、H5 等）：无需 root-portal，直接由 position: fixed 覆盖 -->
  <!-- #ifndef MP -->
  <view
    v-if="isShown"
    class="tabbar-modal-mask-root"
    :style="{ zIndex }"
  >
    <!-- 暗色遮罩背景（点击空白处触发关闭） -->
    <view class="tabbar-modal-backdrop" @click="handleMaskClick" />

    <!-- 居中卡片本体 -->
    <view
      class="tabbar-modal-card"
      :class="{ 'tabbar-modal-card--dark': isDark }"
      :style="{ width }"
    >
      <!-- 头部插槽 / 默认标题栏 -->
      <slot name="header">
        <view
          v-if="title.length > 0 || showClose"
          class="tabbar-modal-header"
        >
          <view class="tabbar-modal-title-wrap">
            <text v-if="icon.length > 0" class="tabbar-modal-icon">{{ icon }}</text>
            <text
              class="tabbar-modal-title-text"
              :class="{ 'tabbar-modal-title-text--dark': isDark }"
            >
              {{ displayTitle }}
            </text>
          </view>
          <view v-if="showClose" class="tabbar-modal-close-btn" @click="handleClose">
            <text class="tabbar-modal-close-text">✕</text>
          </view>
        </view>
      </slot>

      <!-- 命令式传入的数据回执（ref 桥「传数据」的落点）；未传时不渲染 -->
      <view v-if="payloadMessage.length > 0" class="tabbar-modal-payload-wrap">
        <text
          class="tabbar-modal-payload-msg"
          :class="{ 'tabbar-modal-payload-msg--dark': isDark }"
        >
          {{ payloadMessage }}
        </text>
        <text class="tabbar-modal-payload-source">来自：{{ payloadSource }}</text>
      </view>

      <!-- 默认内容插槽（未传自定义 slot 时展示默认全屏覆盖解析卡片） -->
      <slot>
        <text
          class="tabbar-modal-desc-text"
          :class="{ 'tabbar-modal-desc-text--dark': isDark }"
        >
          在模式 0、2、3、4（尤其默认推荐的模式 4）下，暗色遮罩已将全屏及底部 TabBar 完全覆盖！
        </text>

        <!-- 关键原理解析卡片 -->
        <view
          class="tabbar-modal-tip-card"
          :class="{ 'tabbar-modal-tip-card--dark': isDark }"
        >
          <text class="tabbar-modal-tip-text-green">
            ✓ 全屏覆盖：模式 0/2/3/4 全端完美覆盖全屏（z-index: {{ zIndex }} &gt; 999）
          </text>
          <text class="tabbar-modal-tip-text-indigo">
            ✓ 原生底座差异：模式 1 原生 TabBar 仅 H5 可遮挡，App/小程序为系统层级
          </text>
          <text class="tabbar-modal-tip-text-amber">
            ✓ 微信环境适配：小程序端使用 root-portal 提升至 Page 根节点
          </text>
        </view>
      </slot>

      <!-- 底部插槽 / 默认操作按钮 -->
      <slot name="footer">
        <view class="tabbar-modal-confirm-btn" @click="handleClose">
          <text class="tabbar-modal-confirm-text">{{ confirmText }}</text>
        </view>
      </slot>
    </view>
  </view>
  <!-- #endif -->
</template>

<script setup lang="uts">
import { computed, ref } from 'vue';
import { useThemeStore } from '@/src/store';
import type { IModalPayload } from '@/src/store';

const props = defineProps({
  /** 弹窗显隐控制 */
  visible: {
    type: Boolean,
    default: false
  },
  /** 弹窗标题 */
  title: {
    type: String,
    default: '已覆盖全屏'
  },
  /** 标题前置图标（如 emoji '🛡️'） */
  icon: {
    type: String,
    default: '🛡️'
  },
  /** 弹窗层级（默认 9999，高于组件层 TabBar 的 999） */
  zIndex: {
    type: Number,
    default: 9999
  },
  /** 居中卡片宽度（默认 '310px'） */
  width: {
    type: String,
    default: '310px'
  },
  /** 是否显示右上角关闭按钮 */
  showClose: {
    type: Boolean,
    default: true
  },
  /** 点击暗色遮罩背景是否允许关闭 */
  maskClosable: {
    type: Boolean,
    default: true
  },
  /** 默认底部确认按钮文本 */
  confirmText: {
    type: String,
    default: '关闭弹窗'
  }
});

const emit = defineEmits(['close', 'update:visible', 'confirm']);

// ==========================================
// 命令式开关（ref 桥）：与 visible prop 并存的第二条驱动路径
// ==========================================
// 本组件有两条驱动路径，任一为真即显示：
//   1) prop 驱动：`:visible="xxx"`（页面级实例直接绑状态）；
//   2) ref 命令式驱动：由 modal store 持有实例后 `$callMethod('openModal', payload)`。
// 之所以要第二条：弹窗必须挂在页面级才能覆盖全屏，而触发它的按钮可能埋在很深的
// 层级（例如 swiper-item 内的子组件）里，那种位置拿不到页面级的状态。
//
// ⚠️ 方法名刻意不叫 `open` / `close`：避免与运行环境（H5 的 window.open / close）
// 同名，项目红线要求局部方法一律加业务前缀。

/** 命令式打开态 */
const innerVisible = ref(false);

/** 最近一次关闭动作（confirm / close），供调用方「取数据」时经 ref 读回 */
const lastAction = ref('');

/** 通过 openModal(payload) 传进来的数据（「传数据」落到实例内的那一份） */
const payloadTitle = ref('');
const payloadMessage = ref('');
const payloadSource = ref('');

/** 最终显隐：prop 与命令式两条路取「或」 */
const isShown = computed((): boolean => {
  return props.visible || innerVisible.value;
});

/** 标题：命令式传入的优先，其次才是 title prop */
const displayTitle = computed((): string => {
  return payloadTitle.value.length > 0 ? payloadTitle.value : props.title;
});

const themeStore = useThemeStore();
const isDark = computed((): boolean => themeStore.state.isDark);

function handleClose(): void {
  // 命令式那条路径必须在这里收口：否则点遮罩 / ✕ / 底部按钮只会 emit 事件，
  // innerVisible 仍为 true，弹窗根本关不掉（prop 驱动路径不受影响）
  innerVisible.value = false;
  lastAction.value = 'close';
  emit('close');
  emit('update:visible', false);
}

function handleMaskClick(): void {
  if (props.maskClosable) {
    handleClose();
  }
}

/**
 * 命令式打开并把数据传进来（供 modal store 通过 `$callMethod('openModal', payload)` 调用）
 *
 * @param payload 传入的数据
 */
function openModal(payload: IModalPayload): void {
  payloadTitle.value = payload.title;
  payloadMessage.value = payload.message;
  payloadSource.value = payload.source;
  innerVisible.value = true;
}

/** 命令式关闭（调用方 `$callMethod('closeModal')`） */
function closeModal(): void {
  innerVisible.value = false;
  // 与 handleClose 一样记录动作，否则经 ref 关闭后 getLastAction() 读回来是空的
  lastAction.value = 'closeModal';
  emit('close');
}

/** 当前是否处于显示态（含 prop 驱动），供 store 侧查询 */
function isOpened(): boolean {
  return isShown.value;
}

/**
 * 取数据：把实例内部持有的 payload 吐给调用方
 *
 * ⚠️ 刻意返回 string 而不是对象：调用方走 `$callMethod`，其返回值类型是 `any | null`，
 * 把 `any` 强转回对象类型在 Kotlin 端有抛 ClassCastException 的风险
 * （与项目红线「严禁把回调结果强转 UTSJSONObject」同类问题）。
 */
/** 取数据：读回最近一次关闭动作（经 ref 读取，返回 string 同上为避险） */
function getLastAction(): string {
  return lastAction.value;
}

function readPayloadSummary(): string {
  if (payloadTitle.value.length == 0) {
    return '';
  }
  return `title=${payloadTitle.value}｜source=${payloadSource.value}`;
}

defineExpose({
  openModal,
  closeModal,
  isOpened,
  readPayloadSummary,
  getLastAction
});
</script>

<style lang="scss" scoped>
.tabbar-modal-mask-root {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.tabbar-modal-backdrop {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background-color: rgba(0, 0, 0, 0.65);
}

.tabbar-modal-card {
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  padding: 20px;
  border-width: 1px;
  border-style: solid;
  border-color: #e2e8f0;
  border-radius: 16px;
  background-color: #ffffff;

  &--dark {
    border-color: #334155;
    background-color: #1e293b;
  }
}

.tabbar-modal-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.tabbar-modal-title-wrap {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex: 1;
  margin-right: 8px;
}

.tabbar-modal-icon {
  margin-right: 8px;
  font-size: 18px;
}

.tabbar-modal-title-text {
  color: #1e293b;
  font-size: 16px;
  font-weight: bold;

  &--dark {
    color: #f1f5f9;
  }
}

.tabbar-modal-close-btn {
  padding: 4px;
}

.tabbar-modal-close-text {
  color: #94a3b8;
  font-size: 16px;
}

.tabbar-modal-payload-wrap {
  display: flex;
  flex-direction: column;
  margin-bottom: 12px;
}

.tabbar-modal-payload-msg {
  color: #64748b;
  font-size: 12px;
  line-height: 20px;

  &--dark {
    color: #94a3b8;
  }
}

.tabbar-modal-payload-source {
  margin-top: 4px;
  color: #4f46e5;
  font-size: 11px;
  line-height: 18px;
}

.tabbar-modal-desc-text {
  margin-bottom: 12px;
  color: #64748b;
  font-size: 12px;
  line-height: 20px;

  &--dark {
    color: #94a3b8;
  }
}

.tabbar-modal-tip-card {
  display: flex;
  flex-direction: column;
  margin-bottom: 16px;
  padding: 10px;
  border-radius: 8px;
  background-color: #f8fafc;

  &--dark {
    background-color: #0f172a;
  }
}

.tabbar-modal-tip-text-green {
  color: #059669;
  font-size: 11px;
  line-height: 18px;
}

.tabbar-modal-tip-text-indigo {
  margin-top: 4px;
  color: #4f46e5;
  font-size: 11px;
  line-height: 18px;
}

.tabbar-modal-tip-text-amber {
  margin-top: 4px;
  color: #d97706;
  font-size: 11px;
  line-height: 18px;
}

.tabbar-modal-confirm-btn {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 40px;
  border-radius: 8px;
  background-color: #4f46e5;

  &:active {
    opacity: 0.85;
  }
}

.tabbar-modal-confirm-text {
  color: #ffffff;
  font-size: 14px;
  font-weight: 500;
}
</style>
