<template>
  <!-- 全屏遮罩弹窗组件 (具备穿透/覆盖底部 TabBar 能力的基础通用组件) -->
  <!-- 微信小程序端：使用 root-portal 提升至 page 根节点以穿透 TabBar -->
  <!-- #ifdef MP-WEIXIN -->
  <root-portal v-if="isShown">
    <view
      class="fixed top-0 bottom-0 left-0 right-0 flex flex-col items-center justify-center"
      :style="{ zIndex }"
    >
      <!-- 暗色遮罩背景（点击空白处触发关闭） -->
      <view
        class="absolute top-0 bottom-0 left-0 right-0 bg-[#000000a6]"
        @click="handleMaskClick"
      />

      <!-- 居中卡片本体 -->
      <view
        class="p-[20px] rounded-[16px] border-[1px] border-solid relative z-10 flex flex-col"
        :class="isDark ? 'bg-[#1e293b] border-[#334155]' : 'bg-[#ffffff] border-[#e2e8f0]'"
        :style="{ width }"
      >
        <!-- 头部插槽 / 默认标题栏 -->
        <slot name="header">
          <view
            v-if="title.length > 0 || showClose"
            class="flex flex-row items-center justify-between mb-[12px]"
          >
            <view class="flex flex-row items-center flex-1 mr-[8px]">
              <text v-if="icon.length > 0" class="text-[18px] mr-[8px]">{{ icon }}</text>
              <text
                class="text-[16px] font-bold"
                :class="isDark ? 'text-[#f1f5f9]' : 'text-[#1e293b]'"
              >
                {{ displayTitle }}
              </text>
            </view>
            <view v-if="showClose" class="p-[4px]" @click="handleClose">
              <text class="text-[16px] text-[#94a3b8]">✕</text>
            </view>
          </view>
        </slot>

        <!-- 命令式传入的数据回执（ref 桥「传数据」的落点）；未传时不渲染 -->
        <view v-if="payloadMessage.length > 0" class="flex flex-col mb-[12px]">
          <text class="text-[12px] leading-[20px]" :class="isDark ? 'text-[#94a3b8]' : 'text-[#64748b]'">
            {{ payloadMessage }}
          </text>
          <text class="text-[11px] leading-[18px] mt-[4px] text-[#4f46e5]">来自：{{ payloadSource }}</text>
        </view>

        <!-- 默认内容插槽（未传自定义 slot 时展示默认全屏覆盖解析卡片） -->
        <slot>
          <text
            class="text-[12px] leading-[20px] mb-[12px]"
            :class="isDark ? 'text-[#94a3b8]' : 'text-[#64748b]'"
          >
            在模式 0、2、3、4（尤其默认推荐的模式 4）下，暗色遮罩已将全屏及底部 TabBar 完全覆盖！
          </text>

          <!-- 关键原理解析卡片 -->
          <view
            class="p-[10px] rounded-[8px] mb-[16px] flex flex-col"
            :class="isDark ? 'bg-[#0f172a]' : 'bg-[#f8fafc]'"
          >
            <text class="text-[11px] leading-[18px] text-[#059669]">
              ✓ 全屏覆盖：模式 0/2/3/4 全端完美覆盖全屏（z-index: {{ zIndex }} &gt; 999）
            </text>
            <text class="text-[11px] leading-[18px] text-[#4f46e5] mt-[4px]">
              ✓ 原生底座差异：模式 1 原生 TabBar 仅 H5 可遮挡，App/小程序为系统层级
            </text>
            <text class="text-[11px] leading-[18px] text-[#d97706] mt-[4px]">
              ✓ 微信环境适配：小程序端使用 root-portal 提升至 Page 根节点
            </text>
          </view>
        </slot>

        <!-- 底部插槽 / 默认操作按钮 -->
        <slot name="footer">
          <view
            class="w-full h-[40px] rounded-[8px] bg-[#4f46e5] flex flex-row items-center justify-center active:opacity-85"
            @click="handleClose"
          >
            <text class="text-[#ffffff] text-[14px] font-medium">{{ confirmText }}</text>
          </view>
        </slot>
      </view>
    </view>
  </root-portal>
  <!-- #endif -->

  <!-- 非微信小程序端（App、H5 等）：无需 root-portal，直接由 position: fixed 覆盖 -->
  <!-- #ifndef MP-WEIXIN -->
  <view
    v-if="isShown"
    class="fixed top-0 bottom-0 left-0 right-0 flex flex-col items-center justify-center"
    :style="{ zIndex }"
  >
    <!-- 暗色遮罩背景（点击空白处触发关闭） -->
    <view
      class="absolute top-0 bottom-0 left-0 right-0 bg-[#000000a6]"
      @click="handleMaskClick"
    />

    <!-- 居中卡片本体 -->
    <view
      class="p-[20px] rounded-[16px] border-[1px] border-solid relative z-10 flex flex-col"
      :class="isDark ? 'bg-[#1e293b] border-[#334155]' : 'bg-[#ffffff] border-[#e2e8f0]'"
      :style="{ width }"
    >
      <!-- 头部插槽 / 默认标题栏 -->
      <slot name="header">
        <view
          v-if="title.length > 0 || showClose"
          class="flex flex-row items-center justify-between mb-[12px]"
        >
          <view class="flex flex-row items-center flex-1 mr-[8px]">
            <text v-if="icon.length > 0" class="text-[18px] mr-[8px]">{{ icon }}</text>
            <text
              class="text-[16px] font-bold"
              :class="isDark ? 'text-[#f1f5f9]' : 'text-[#1e293b]'"
            >
              {{ displayTitle }}
            </text>
          </view>
          <view v-if="showClose" class="p-[4px]" @click="handleClose">
            <text class="text-[16px] text-[#94a3b8]">✕</text>
          </view>
        </view>
      </slot>

      <!-- 命令式传入的数据回执（ref 桥「传数据」的落点）；未传时不渲染 -->
      <view v-if="payloadMessage.length > 0" class="flex flex-col mb-[12px]">
        <text class="text-[12px] leading-[20px]" :class="isDark ? 'text-[#94a3b8]' : 'text-[#64748b]'">
          {{ payloadMessage }}
        </text>
        <text class="text-[11px] leading-[18px] mt-[4px] text-[#4f46e5]">来自：{{ payloadSource }}</text>
      </view>

      <!-- 默认内容插槽（未传自定义 slot 时展示默认全屏覆盖解析卡片） -->
      <slot>
        <text
          class="text-[12px] leading-[20px] mb-[12px]"
          :class="isDark ? 'text-[#94a3b8]' : 'text-[#64748b]'"
        >
          在模式 0、2、3、4（尤其默认推荐的模式 4）下，暗色遮罩已将全屏及底部 TabBar 完全覆盖！
        </text>

        <!-- 关键原理解析卡片 -->
        <view
          class="p-[10px] rounded-[8px] mb-[16px] flex flex-col"
          :class="isDark ? 'bg-[#0f172a]' : 'bg-[#f8fafc]'"
        >
          <text class="text-[11px] leading-[18px] text-[#059669]">
            ✓ 全屏覆盖：模式 0/2/3/4 全端完美覆盖全屏（z-index: {{ zIndex }} &gt; 999）
          </text>
          <text class="text-[11px] leading-[18px] text-[#4f46e5] mt-[4px]">
            ✓ 原生底座差异：模式 1 原生 TabBar 仅 H5 可遮挡，App/小程序为系统层级
          </text>
          <text class="text-[11px] leading-[18px] text-[#d97706] mt-[4px]">
            ✓ 微信环境适配：小程序端使用 root-portal 提升至 Page 根节点
          </text>
        </view>
      </slot>

      <!-- 底部插槽 / 默认操作按钮 -->
      <slot name="footer">
        <view
          class="w-full h-[40px] rounded-[8px] bg-[#4f46e5] flex flex-row items-center justify-center active:opacity-85"
          @click="handleClose"
        >
          <text class="text-[#ffffff] text-[14px] font-medium">{{ confirmText }}</text>
        </view>
      </slot>
    </view>
  </view>
  <!-- #endif -->
</template>

<script setup lang="uts">
import { computed, ref } from 'vue';
import { useAppStore } from '@/src/store';
import type { IModalPayload } from '@/src/store';

const props = defineProps({
  /** 弹窗显隐控制 */
  visible: {
    type: Boolean,
    default: false
  },
  /** 弹窗标题 */
  title: {
    type: String,
    default: '已覆盖全屏'
  },
  /** 标题前置图标（如 emoji '🛡️'） */
  icon: {
    type: String,
    default: '🛡️'
  },
  /** 弹窗层级（默认 9999，高于组件层 TabBar 的 999） */
  zIndex: {
    type: Number,
    default: 9999
  },
  /** 居中卡片宽度（默认 '310px'） */
  width: {
    type: String,
    default: '310px'
  },
  /** 是否显示右上角关闭按钮 */
  showClose: {
    type: Boolean,
    default: true
  },
  /** 点击暗色遮罩背景是否允许关闭 */
  maskClosable: {
    type: Boolean,
    default: true
  },
  /** 默认底部确认按钮文本 */
  confirmText: {
    type: String,
    default: '关闭弹窗'
  }
});

const emit = defineEmits(['close', 'update:visible', 'confirm']);

// ==========================================
// 命令式开关（ref 桥）：与 visible prop 并存的第二条驱动路径
// ==========================================
// 本组件有两条驱动路径，任一为真即显示：
//   1) prop 驱动：`:visible="xxx"`（页面级实例直接绑状态）；
//   2) ref 命令式驱动：由 modal store 持有实例后 `$callMethod('openModal', payload)`。
// 之所以要第二条：弹窗必须挂在页面级才能覆盖全屏，而触发它的按钮可能埋在很深的
// 层级（例如 swiper-item 内的子组件）里，那种位置拿不到页面级的状态。
//
// ⚠️ 方法名刻意不叫 `open` / `close`：避免与运行环境（H5 的 window.open / close）
// 同名，项目红线要求局部方法一律加业务前缀。

/** 命令式打开态 */
const innerVisible = ref(false);

/** 最近一次关闭动作（confirm / close），供调用方「取数据」时经 ref 读回 */
const lastAction = ref('');

/** 通过 openModal(payload) 传进来的数据（「传数据」落到实例内的那一份） */
const payloadTitle = ref('');
const payloadMessage = ref('');
const payloadSource = ref('');

/** 最终显隐：prop 与命令式两条路取「或」 */
const isShown = computed((): boolean => {
  return props.visible || innerVisible.value;
});

/** 标题：命令式传入的优先，其次才是 title prop */
const displayTitle = computed((): string => {
  return payloadTitle.value.length > 0 ? payloadTitle.value : props.title;
});

const appStore = useAppStore();
const isDark = computed((): boolean => appStore.state.isDark);

function handleClose(): void {
  // 命令式那条路径必须在这里收口：否则点遮罩 / ✕ / 底部按钮只会 emit 事件，
  // innerVisible 仍为 true，弹窗根本关不掉（prop 驱动路径不受影响）
  innerVisible.value = false;
  lastAction.value = 'close';
  emit('close');
  emit('update:visible', false);
}

function handleMaskClick(): void {
  if (props.maskClosable) {
    handleClose();
  }
}

/**
 * 命令式打开并把数据传进来（供 modal store 通过 `$callMethod('openModal', payload)` 调用）
 *
 * @param payload 传入的数据
 */
function openModal(payload: IModalPayload): void {
  payloadTitle.value = payload.title;
  payloadMessage.value = payload.message;
  payloadSource.value = payload.source;
  innerVisible.value = true;
}

/** 命令式关闭（调用方 `$callMethod('closeModal')`） */
function closeModal(): void {
  innerVisible.value = false;
  // 与 handleClose 一样记录动作，否则经 ref 关闭后 getLastAction() 读回来是空的
  lastAction.value = 'closeModal';
  emit('close');
}

/** 当前是否处于显示态（含 prop 驱动），供 store 侧查询 */
function isOpened(): boolean {
  return isShown.value;
}

/**
 * 取数据：把实例内部持有的 payload 吐给调用方
 *
 * ⚠️ 刻意返回 string 而不是对象：调用方走 `$callMethod`，其返回值类型是 `any | null`，
 * 把 `any` 强转回对象类型在 Kotlin 端有抛 ClassCastException 的风险
 * （与项目红线「严禁把回调结果强转 UTSJSONObject」同类问题）。
 */
/** 取数据：读回最近一次关闭动作（经 ref 读取，返回 string 同上为避险） */
function getLastAction(): string {
  return lastAction.value;
}

function readPayloadSummary(): string {
  if (payloadTitle.value.length == 0) {
    return '';
  }
  return `title=${payloadTitle.value}｜source=${payloadSource.value}`;
}

defineExpose({
  openModal,
  closeModal,
  isOpened,
  readPayloadSummary,
  getLastAction
});
</script>
