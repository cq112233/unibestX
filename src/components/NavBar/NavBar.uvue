<script setup lang="uts">
import { computed } from 'vue';
import { isMpAlipay } from '@/src/config/env/platform.uts';
import { NAVBAR_CONTENT_HEIGHT, safeAreaInsets, systemInfo } from '@/src/utils/systemInfo/index.uts';
import { useThemeStore } from '@/src/store/index.uts';
import { getThemeTokens } from '@/src/theme/index.uts';
import type { ThemeTokens } from '@/src/theme/index.uts';
import { useRouter } from '@/uni_modules/route-bestX/index.uts';

// 定义组件参数类型
const props = defineProps({
  title: {
    type: String,
    default: ''
  },
  titleColor: {
    type: String,
    default: ''
  },
  bgColor: {
    type: String,
    default: ''
  },
  /** 状态栏区域独立背景颜色（推荐规范命名：navigationStatusBarBackgroundColor） */
  navigationStatusBarBackgroundColor: {
    type: String,
    default: ''
  },
  /** 兼容别名：状态栏背景颜色 */
  statusBarBgColor: {
    type: String,
    default: ''
  },
  /** 导航栏内容区域独立背景颜色（推荐规范命名：navigationContentBackgroundColor） */
  navigationContentBackgroundColor: {
    type: String,
    default: ''
  },
  /** 兼容别名：内容区背景颜色 */
  contentBgColor: {
    type: String,
    default: ''
  },
  /** 返回按钮图标独立颜色（推荐规范命名：navigationBackIconColor） */
  navigationBackIconColor: {
    type: String,
    default: ''
  },
  /** 兼容别名：返回按钮图标颜色 */
  backIconColor: {
    type: String,
    default: ''
  },
  fixed: {
    type: Boolean,
    default: true
  },
  placeholder: {
    type: Boolean,
    default: true
  },
  showBack: {
    type: Boolean,
    default: true
  },
  border: {
    type: Boolean,
    default: false
  },
  isNavbarVisible: {
    type: Boolean,
    default: true
  },
  /** 是否隐藏状态栏占位高度（默认 false，若为 true 则状态栏占位高度为 0，实现完全沉浸全屏） */
  hideStatusBar: {
    type: Boolean,
    default: false
  },
  /** 页面 style 完整配置对象（未拍平，包含 navigationBarTitleText, enablePullDownRefresh 等） */
  pageStyleObj: {
    type: Object,
    default: () => ({})
  }
});

// 亮 / 暗主题 token（与 theme.json 同步）：未显式传色时跟随当前外观模式
const themeTokens = computed((): ThemeTokens => {
  return getThemeTokens(useThemeStore().state.isDark);
});

// 实际生效的导航栏全局背景色：显式传 bgColor 时优先，否则跟随主题
const effectiveBgColor = computed((): string => {
  return props.bgColor != '' ? props.bgColor : themeTokens.value.navBg;
});

// 实际生效的状态栏背景色：规范命名 navigationStatusBarBackgroundColor 优先，兼容 statusBarBgColor
const effectiveStatusBarBgColor = computed((): string => {
  if (props.navigationStatusBarBackgroundColor != '') {
    return props.navigationStatusBarBackgroundColor;
  }
  if (props.statusBarBgColor != '') {
    return props.statusBarBgColor;
  }
  return '';
});

// 实际生效的内容区背景色：规范命名 navigationContentBackgroundColor 优先，兼容 contentBgColor
const effectiveContentBgColor = computed((): string => {
  if (props.navigationContentBackgroundColor != '') {
    return props.navigationContentBackgroundColor;
  }
  if (props.contentBgColor != '') {
    return props.contentBgColor;
  }
  return '';
});

// 实际生效的导航栏外层容器背景色：若单独指定了状态栏或内容区背景且未显式指定全局 bgColor，则外层透明，由内部各自独立着色
const effectiveBarBgColor = computed((): string => {
  const hasCustomPart = props.navigationStatusBarBackgroundColor != ''
    || props.statusBarBgColor != ''
    || props.navigationContentBackgroundColor != ''
    || props.contentBgColor != '';
  if (props.bgColor == '' && hasCustomPart) {
    return 'transparent';
  }
  return effectiveBgColor.value;
});

// 实际生效的标题颜色：显式传 titleColor 时优先，否则跟随主题
const effectiveTitleColor = computed((): string => {
  return props.titleColor != '' ? props.titleColor : themeTokens.value.navText;
});

// 实际生效的返回箭头颜色：优先使用 navigationBackIconColor 或 backIconColor，未设置时跟随标题/主题颜色
const effectiveBackIconColor = computed((): string => {
  if (props.navigationBackIconColor != '') {
    return props.navigationBackIconColor;
  }
  if (props.backIconColor != '') {
    return props.backIconColor;
  }
  return effectiveTitleColor.value;
});

// 实际生效的底边框颜色：跟随暗黑模式自适应
const effectiveBorderColor = computed((): string => {
  return useThemeStore().state.isDark ? '#334155' : '#e2e8f0';
});

// 计算状态栏高度
const statusBarHeight = computed<number>((): number => {
  const insets = safeAreaInsets.value;
  if (insets != null && insets.top > 0) {
    return insets.top;
  }
  const info = systemInfo.value;
  if (info != null && info.statusBarHeight > 0) {
    return info.statusBarHeight;
  }
  return 0;
});

const router = useRouter();

/** 标题是否可见（单值计算属性，鸿蒙模板规范） */
const isTitleVisible = computed((): boolean => {
  return props.title.length > 0 && !isMpAlipay;
});

/** 占位垫高块是否可见 */
const isPlaceholderVisible = computed((): boolean => {
  return props.fixed && props.placeholder;
});

// 处理返回事件
function handleBack() {
  if (!props.showBack) {
    return;
  }
  const pages = getCurrentPages();
  if (pages.length > 1) {
    router.back();
  }
  else {
    router.relaunch('/src/pages/index/index');
  }
}
</script>

<template>
  <view v-if="props.isNavbarVisible" class="navbar-wrapper">
    <!-- 导航栏外层容器 -->
    <view
      class="navbar-bar"
      :class="{ 'navbar-bar--fixed': props.fixed }"
      :style="{
        backgroundColor: effectiveBarBgColor,
        borderBottomWidth: (props.border && props.isNavbarVisible) ? '1px' : '0px',
        borderBottomStyle: (props.border && props.isNavbarVisible) ? 'solid' : 'none',
        borderBottomColor: (props.border && props.isNavbarVisible) ? effectiveBorderColor : 'transparent'
      }"
    >
      <!-- 安全区域：状态栏占位高度 -->
      <view
        v-if="!props.hideStatusBar"
        class="navbar-status-bar"
        :style="{
          height: `${statusBarHeight}px`,
          backgroundColor: effectiveStatusBarBgColor != '' ? effectiveStatusBarBgColor : 'transparent'
        }"
      >
        <slot name="statusBar"></slot>
      </view>

      <!-- 导航栏内容区 -->
      <view
        class="navbar-content"
        :style="{
          height: `${NAVBAR_CONTENT_HEIGHT}px`,
          backgroundColor: effectiveContentBgColor != '' ? effectiveContentBgColor : 'transparent'
        }"
      >
        <!-- 左侧返回按钮区域（支付宝小程序不渲染，使用原生返回栏） -->
        <view v-if="!isMpAlipay" class="navbar-left">
          <slot name="left">
            <view v-if="props.showBack" class="navbar-back-btn" @click="handleBack">
              <view class="navbar-back-icon">
                <!-- #ifdef H5 -->
                <svg width="26" height="26" viewBox="0 0 32 32">
                  <path
                    d="M21.781 7.844l-9.063 8.594 9.063 8.594q0.25 0.25 0.25 0.609t-0.25 0.578q-0.25 0.25-0.578 0.25t-0.578-0.25l-9.625-9.125q-0.156-0.125-0.203-0.297t-0.047-0.359q0-0.156 0.047-0.328t0.203-0.297l9.625-9.125q0.25-0.25 0.578-0.25t0.578 0.25q0.25 0.219 0.25 0.578t-0.25 0.578z"
                    :fill="effectiveBackIconColor"
                  />
                </svg>
                <!-- #endif -->
                <!-- #ifndef H5 -->
                <uni-icons type="left" size="24" :color="effectiveBackIconColor" />
                <!-- #endif -->
              </view>
            </view>
          </slot>
        </view>

        <!-- 中间标题区域 -->
        <view class="navbar-mid">
          <slot name="mid">
            <slot>
              <!-- 支付宝小程序不显示标题，使用原生返回栏 -->
              <text v-if="isTitleVisible" class="navbar-title" :style="{ color: effectiveTitleColor }">{{ props.title }}</text>
            </slot>
          </slot>
        </view>

        <!-- 右侧操作栏区域 -->
        <view class="navbar-right">
          <slot name="right"></slot>
        </view>
      </view>
    </view>

    <!-- 占位垫高块：当固定在顶部时防内容遮挡 -->
    <view v-if="isPlaceholderVisible" class="navbar-placeholder" :style="{ height: `${(props.hideStatusBar ? 0 : statusBarHeight) + (props.isNavbarVisible ? NAVBAR_CONTENT_HEIGHT : 0)}px` }"></view>
  </view>
  <view v-else-if="!props.hideStatusBar" class="navbar-status-bar" :style="{ height: `${statusBarHeight}px` }"></view>
</template>

<style lang="scss" scoped>
.navbar-wrapper {
  width: 100%;
}

.navbar-bar {
  display: flex;
  flex-direction: column;
  width: 100%;

  &--fixed {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    z-index: 999;
  }
}

.navbar-status-bar {
  width: 100%;
}

.navbar-content {
  position: relative;
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  width: 100%;
}

.navbar-left {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  display: flex;
  flex-direction: row;
  justify-content: flex-start;
  align-items: center;
  height: 100%;
}

.navbar-back-btn {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  height: 100%;
  padding-right: 10px;
  padding-left: 5px;
  /* #ifdef H5 */
  cursor: pointer;
  /* #endif */
}

.navbar-back-icon {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  width: 26px;
  height: 26px;
}

.navbar-mid {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  flex: 1;
  height: 100%;
  padding-right: 60px;
  padding-left: 60px;
}

.navbar-title {
  font-size: 16px;
  font-weight: bold;
  line-height: 30px;
  text-align: center;
  text-overflow: ellipsis;
  /* #ifndef APP */
  white-space: nowrap;
  /* #endif */
}

.navbar-right {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  align-items: center;
  width: 60px;
  padding-right: 15px;
}

.navbar-placeholder {
  width: 100%;
}
</style>
