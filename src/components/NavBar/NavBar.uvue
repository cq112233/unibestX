<template>
  <!-- 直接使用官方 uni-nav-bar 组件并优雅代理插槽 -->
  <uni-nav-bar
    :title="title"
    :hide-default-back="true"
    :navigation-bar-text-style="effectiveTitleColor"
    :style="{ backgroundColor: effectiveBgColor }"
  >
    <!-- 左侧区域：外部传 slot 则显示外部内容，未传则展示默认返回箭头 -->
    <template #left>
      <slot name="left">
        <view
          v-if="showBack"
          style="width: 44px; height: 44px; justify-content: center; align-items: center;"
          @click="handleBack"
        >
          <view
            style="width: 12px; height: 12px; transform: rotate(45deg); border-left-width: 2px; border-left-style: solid; border-bottom-width: 2px; border-bottom-style: solid;"
            :style="{ borderLeftColor: effectiveTitleColor, borderBottomColor: effectiveTitleColor }"
          />
        </view>
      </slot>
    </template>

    <!-- 中间区域：外部传 mid / default 插槽则展示，未传则展示标题 -->
    <template #mid>
      <slot name="mid">
        <slot>
          <text
            v-if="title.length > 0"
            class="title-text"
            :style="{ color: effectiveTitleColor }"
          >
            {{ title }}
          </text>
        </slot>
      </slot>
    </template>

    <!-- 右侧区域 -->
    <template #right>
      <slot name="right" />
    </template>
  </uni-nav-bar>
</template>

<script setup lang="uts">
import { computed } from 'vue';
import UniNavBar from '@/uni_modules/uni-nav-bar-x/components/uni-nav-bar/uni-nav-bar.uvue';
import { useAppStore } from '@/src/store';
import { getThemeTokens } from '@/src/utils/theme';
import type { ThemeTokens } from '@/src/utils/theme';

// 定义组件参数类型
const props = defineProps({
  title: {
    type: String,
    default: ''
  },
  titleColor: {
    type: String,
    default: ''
  },
  bgColor: {
    type: String,
    default: ''
  },
  showBack: {
    type: Boolean,
    default: true
  }
});

// 亮 / 暗主题 token（与 theme.json 同步）：未显式传色时跟随当前外观模式
const themeTokens = computed((): ThemeTokens => {
  return getThemeTokens(useAppStore().state.isDark);
});

// 实际生效的导航栏背景色：显式传 bgColor 时优先，否则跟随主题
const effectiveBgColor = computed((): string => {
  return props.bgColor != '' ? props.bgColor : themeTokens.value.navBg;
});

// 实际生效的标题 / 返回箭头颜色：显式传 titleColor 时优先，否则跟随主题
const effectiveTitleColor = computed((): string => {
  return props.titleColor != '' ? props.titleColor : themeTokens.value.navText;
});

// 处理返回事件
function handleBack() {
  const pages = getCurrentPages();
  if (pages.length > 1) {
    uni.navigateBack({ delta: 1 });
  }
  else {
    uni.reLaunch({ url: '/src/pages/index/index' });
  }
}
</script>

<style>
.title-text {
  font-size: 17px;
  font-weight: 600;
  text-overflow: ellipsis;
}
</style>
