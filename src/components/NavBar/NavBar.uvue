<template>
  <view v-if="isNavbarVisible" class="navbar-wrapper">
    <!-- 导航栏外层容器 -->
    <view
      class="navbar-bar"
      :class="{ 'navbar-bar--fixed': fixed }"
      :style="{
        backgroundColor: effectiveBgColor,
        borderBottomWidth: (border && isNavbarVisible) ? '1px' : '0px',
        borderBottomStyle: (border && isNavbarVisible) ? 'solid' : 'none',
        borderBottomColor: (border && isNavbarVisible) ? effectiveBorderColor : 'transparent'
      }"
    >
      <!-- 安全区域：状态栏占位高度 -->
      <view v-if="!hideStatusBar" class="navbar-status-bar" :style="{ height: `${statusBarHeight}px` }">
        <slot name="statusBar"></slot>
      </view>

      <!-- 导航栏内容区 -->
      <view class="navbar-content" :style="{ height: `${NAVBAR_CONTENT_HEIGHT}px` }">
        <!-- 左侧返回按钮区域（支付宝小程序不渲染，使用原生返回栏） -->
        <view v-if="!isMpAlipay" class="navbar-left">
          <slot name="left">
            <view v-if="showBack" class="navbar-back-btn" @click="handleBack">
              <view class="navbar-back-icon">
                <!-- #ifdef H5 -->
                <svg width="26" height="26" viewBox="0 0 32 32">
                  <path
                    d="M21.781 7.844l-9.063 8.594 9.063 8.594q0.25 0.25 0.25 0.609t-0.25 0.578q-0.25 0.25-0.578 0.25t-0.578-0.25l-9.625-9.125q-0.156-0.125-0.203-0.297t-0.047-0.359q0-0.156 0.047-0.328t0.203-0.297l9.625-9.125q0.25-0.25 0.578-0.25t0.578 0.25q0.25 0.219 0.25 0.578t-0.25 0.578z"
                    :fill="effectiveTitleColor"
                  />
                </svg>
                <!-- #endif -->
                <!-- #ifndef H5 -->
                <uni-icons type="left" size="24" :color="effectiveTitleColor" />
                <!-- #endif -->
              </view>
            </view>
          </slot>
        </view>

        <!-- 中间标题区域 -->
        <view class="navbar-mid">
          <slot name="mid">
            <slot>
              <!-- 支付宝小程序不显示标题，使用原生返回栏 -->
              <text v-if="title.length > 0 && !isMpAlipay " class="navbar-title" :style="{ color: effectiveTitleColor }">{{ title }}</text>
            </slot>
          </slot>
        </view>

        <!-- 右侧操作栏区域 -->
        <view class="navbar-right">
          <slot name="right"></slot>
        </view>
      </view>
    </view>

    <!-- 占位垫高块：当固定在顶部时防内容遮挡 -->
    <view v-if="fixed && placeholder" class="navbar-placeholder" :style="{ height: `${(hideStatusBar ? 0 : statusBarHeight) + (isNavbarVisible ? NAVBAR_CONTENT_HEIGHT : 0)}px` }"></view>
  </view>
  <view v-else-if="!hideStatusBar" class="navbar-status-bar" :style="{ height: `${statusBarHeight}px` }"></view>
</template>

<script setup lang="uts">
import { computed } from 'vue';
import { isMpAlipay } from '@/src/config/env/platform.uts';
import { NAVBAR_CONTENT_HEIGHT, safeAreaInsets, systemInfo } from '@/src/utils/systemInfo/index.uts';
import { useRouter } from '@/uni_modules/route-bestX/index.uts';

// 定义组件参数类型
const props = defineProps({
  title: {
    type: String,
    default: ''
  },
  titleColor: {
    type: String,
    default: ''
  },
  bgColor: {
    type: String,
    default: ''
  },
  fixed: {
    type: Boolean,
    default: true
  },
  placeholder: {
    type: Boolean,
    default: true
  },
  showBack: {
    type: Boolean,
    default: true
  },
  border: {
    type: Boolean,
    default: false
  },
  isNavbarVisible: {
    type: Boolean,
    default: true
  },
  /** 是否隐藏状态栏占位高度（默认 false，若为 true 则状态栏占位高度为 0，实现完全沉浸全屏） */
  hideStatusBar: {
    type: Boolean,
    default: false
  },
  /** 页面 style 完整配置对象（未拍平，包含 navigationBarTitleText, enablePullDownRefresh 等） */
  pageStyleObj: {
    type: Object,
    default: () => ({})
  }
});

// 实际生效的导航栏背景色：显式传 bgColor 时优先，否则使用静态白色
const effectiveBgColor = computed((): string => {
  return props.bgColor != '' ? props.bgColor : '#ffffff';
});

// 实际生效的标题 / 返回箭头颜色：显式传 titleColor 时优先，否则使用静态黑色
const effectiveTitleColor = computed((): string => {
  return props.titleColor != '' ? props.titleColor : '#000000';
});

// 实际生效的底边框颜色：使用静态浅灰
const effectiveBorderColor = computed((): string => {
  return '#e2e8f0';
});

// 计算状态栏高度
const statusBarHeight = computed<number>((): number => {
  const insets = safeAreaInsets.value;
  if (insets != null && insets.top > 0) {
    return insets.top;
  }
  const info = systemInfo.value;
  if (info != null && info.statusBarHeight > 0) {
    return info.statusBarHeight;
  }
  return 0;
});

const router = useRouter();

// 处理返回事件
function handleBack() {
  if (!props.showBack) {
    return;
  }
  const pages = getCurrentPages();
  if (pages.length > 1) {
    router.back();
  }
  else {
    router.relaunch('/src/pages/index/index');
  }
}
</script>

<style lang="scss" scoped>
.navbar-wrapper {
  width: 100%;
}

.navbar-bar {
  display: flex;
  flex-direction: column;
  width: 100%;

  &--fixed {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    z-index: 999;
  }
}

.navbar-status-bar {
  width: 100%;
}

.navbar-content {
  position: relative;
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  width: 100%;
}

.navbar-left {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  display: flex;
  flex-direction: row;
  justify-content: flex-start;
  align-items: center;
  height: 100%;
}

.navbar-back-btn {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  height: 100%;
  padding-right: 10px;
  padding-left: 5px;
  /* #ifdef H5 */
  cursor: pointer;
  /* #endif */
}

.navbar-back-icon {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  width: 26px;
  height: 26px;
}

.navbar-mid {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  flex: 1;
  height: 100%;
  padding-right: 60px;
  padding-left: 60px;
}

.navbar-title {
  font-size: 16px;
  font-weight: bold;
  line-height: 30px;
  text-align: center;
  text-overflow: ellipsis;
  /* #ifndef APP */
  white-space: nowrap;
  /* #endif */
}

.navbar-right {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  align-items: center;
  width: 60px;
  padding-right: 15px;
}

.navbar-placeholder {
  width: 100%;
}
</style>
