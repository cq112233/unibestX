<template>
  <view class="page-container bg-[#f8fafc] min-h-screen pb-[30px]">
    <NavBar title="up-color-picker 颜色选择"></NavBar>
    <view class="p-[16px]">
      <!-- 1. 基础用法 -->
      <view class="demo-block">
        <up-title class="demo-title">
          <text class="demo-title-text">基础用法（点击色块选择颜色）</text>
        </up-title>
        <view class="flex-row items-center">
          <up-color-picker v-model="color1"></up-color-picker>
          <text class="demo-text ml-[12px]">当前颜色：{{ color1 }}</text>
        </view>
      </view>

      <!-- 2. 自定义常用颜色 -->
      <view class="demo-block mt-[12px]">
        <up-title class="demo-title">
          <text class="demo-title-text">自定义常用颜色</text>
        </up-title>
        <view class="flex-row items-center">
          <up-color-picker v-model="color2" :common-colors="customColors"></up-color-picker>
          <text class="demo-text ml-[12px]">当前颜色：{{ color2 }}</text>
        </view>
      </view>

      <!-- 3. 渐变模式 -->
      <view class="demo-block mt-[12px]">
        <up-title class="demo-title">
          <text class="demo-title-text">渐变模式（默认值传入渐变字符串）</text>
        </up-title>
        <view class="flex-row items-center">
          <up-color-picker v-model="gradientColor"></up-color-picker>
          <text class="demo-text ml-[12px]">{{ gradientColor }}</text>
        </view>
        <view class="gradient-preview mt-[10px]" :style="{ background: gradientColor }"></view>
      </view>

      <!-- 4. 通过 ref 调用 open -->
      <view class="demo-block mt-[12px]">
        <up-title class="demo-title">
          <text class="demo-title-text">通过 ref 调用 open</text>
        </up-title>
        <view class="flex-row items-center">
          <up-color-picker ref="colorPickerRef" v-model="color3" @confirm="onConfirm"></up-color-picker>
          <up-button text="打开选择器" type="primary" size="small" class="demo-btn ml-[12px]" @click="onOpenPicker"></up-button>
        </view>
        <text class="log-text mt-[10px]">{{ apiLog }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue';

definePage({
  style: {
    navigationStyle: 'custom',
    navigationBarTitleText: 'up-color-picker 颜色选择'
  }
});

const color1 = ref<string>('#ff0000');
const color2 = ref<string>('#2979ff');
const color3 = ref<string>('#19be6b');
const gradientColor = ref<string>('linear-gradient(to right, #ff0000, #0000ff)');
const customColors = ref<Array<string>>([
  '#2979ff',
  '#fa3534',
  '#19be6b',
  '#ff9900',
  '#ff00ff',
  '#00ffff'
] as Array<string>);

const apiLog = ref<string>('');

const colorPickerRef = ref(null as ComponentPublicInstance | null);

function onOpenPicker() {
  const picker = colorPickerRef.value;
  if (picker != null) {
    picker.$callMethod('open');
    apiLog.value = '已调用 open()';
  }
}

function onConfirm(color: string) {
  apiLog.value = `confirm => ${color}`;
}
</script>

<style lang="scss" scoped>
.demo-block {
  margin-bottom: 12px;
  padding: 12px;
  background-color: #ffffff;
  border-radius: 8px;
}
.demo-title {
  margin-bottom: 10px;
}
.demo-title-text {
  font-size: 14px;
  font-weight: bold;
  color: #606266;
}
.demo-text {
  font-size: 13px;
  color: #475569;
}
.log-text {
  font-size: 13px;
  color: #475569;
  line-height: 20px;
}
.gradient-preview {
  width: 100%;
  height: 48px;
  border-radius: 6px;
  border-width: 1px;
  border-style: solid;
  border-color: #e5e7eb;
}
</style>
