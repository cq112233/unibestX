<template>
  <view class="page-container bg-[#f8fafc] min-h-screen pb-[30px]">
    <NavBar title="Steps 步骤条" :auto-back="true" :safe-area-inset-top="true" bg-color="#ffffff"></NavBar>
    <view class="p-[16px]">
      <view class="demo-block">
        <text class="demo-label">基础步骤条</text>
        <UpSteps :current="currentStep">
          <UpStepsItem title="已下单" desc="10:30"></UpStepsItem>
          <UpStepsItem title="已出库" desc="10:35"></UpStepsItem>
          <UpStepsItem title="运输中" desc="11:40"></UpStepsItem>
          <UpStepsItem title="已签收" desc="14:20"></UpStepsItem>
        </UpSteps>
        <view class="mt-[12px] flex-row justify-center">
          <UpButton size="small" type="primary" text="下一步" @click="nextStep"></UpButton>
        </view>
      </view>

      <view class="demo-block mt-[12px]">
        <text class="demo-label">圆点模式 (dot)</text>
        <UpSteps :current="1" :dot="true">
          <UpStepsItem title="已下单" desc="10:30"></UpStepsItem>
          <UpStepsItem title="已出库" desc="10:35"></UpStepsItem>
          <UpStepsItem title="运输中" desc="11:40"></UpStepsItem>
        </UpSteps>
      </view>

      <view class="demo-block mt-[12px]">
        <text class="demo-label">自定义颜色与错误状态</text>
        <UpSteps :current="1" active-color="#19be6b">
          <UpStepsItem title="已下单" desc="10:30"></UpStepsItem>
          <UpStepsItem title="出库异常" desc="10:35" :error="true"></UpStepsItem>
          <UpStepsItem title="运输中" desc="11:40"></UpStepsItem>
        </UpSteps>
      </view>

      <view class="demo-block mt-[12px]">
        <text class="demo-label">垂直方向</text>
        <UpSteps :current="1" direction="column">
          <UpStepsItem title="已下单" desc="买家已提交订单 10:30"></UpStepsItem>
          <UpStepsItem title="已出库" desc="包裹已出库并在分拣 10:35"></UpStepsItem>
          <UpStepsItem title="运输中" desc="快件正在运往目的地 11:40"></UpStepsItem>
          <UpStepsItem title="已签收" desc="快件已安全送达 14:20"></UpStepsItem>
        </UpSteps>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue';
import NavBar from '@/src/components/NavBar/NavBar.uvue';
import UpSteps from '@/uni_modules/uview-ultra/components/up-steps/up-steps.uvue';
import UpStepsItem from '@/uni_modules/uview-ultra/components/up-steps-item/up-steps-item.uvue';
import UpButton from '@/uni_modules/uview-ultra/components/up-button/up-button.uvue';

definePage({
  style: {
    navigationStyle: 'custom',
    navigationBarTitleText: 'Steps 步骤条'
  }
});

const currentStep = ref<number>(1);

function nextStep(): void {
  currentStep.value = (currentStep.value + 1) % 4;
}
</script>

