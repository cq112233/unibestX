<template>
  <view class="page-container bg-[#f8fafc] min-h-screen pb-[30px]">
    <view class="p-[16px]">
      <view class="demo-block">
        <text class="demo-label">组件说明</text>
        <text class="demo-text">up-float-button 通过 position: fixed 固定在屏幕上。页面右侧常驻了 4 个不同配置的悬浮按钮：</text>
        <view class="mt-[8px] flex flex-col gap-[6px]">
          <text class="demo-text text-[#475569]">⚫ 【深灰·置顶】右上角 top:120px ➔ 基础点击</text>
          <text class="demo-text text-[#f59e0b]">🟠 【橙色·图钉】右上偏下 top:200px ➔ 可随意拖拽</text>
          <text class="demo-text text-[#2979ff] font-bold">🔵 【蓝色·加号】右下角 bottom:100px ➔ 菜单模式（点此展开菜单！）</text>
          <text class="demo-text text-[#19be6b]">🟢 【绿色·编辑】右下底部 bottom:25px ➔ 自定义大尺寸</text>
        </view>
      </view>

      <view class="demo-block mt-[12px]">
        <text class="demo-label">1. 基础用法（右上角深灰按钮）</text>
        <text class="demo-text">不传 isMenu 时点击仅触发 click 事件。点击右上角深灰置顶按钮查看效果：</text>
        <text class="demo-text mt-[6px] font-bold text-[#475569]">click 累计次数：{{ basicClickCount }}</text>
      </view>

      <view class="demo-block mt-[12px]">
        <text class="demo-label">2. 菜单模式（右下角蓝色加号按钮 ⭐）</text>
        <text class="demo-text">传 isMenu 且绑定 list。点击右下角蓝色【+】按钮展开/收起：主按钮上的加号会旋转 45° 变成叉号关闭样式，上方展开【收藏、聊天、分享】三个子按钮。点击子项触发 item-click。</text>
      </view>

      <view class="demo-block mt-[12px]">
        <text class="demo-label">3. 可拖动（橙色图钉按钮）</text>
        <text class="demo-text">打开 draggable 后，按住橙色图钉按钮可以在屏幕任意位置拖拽，自动限制在窗口内部。拖动位移超过 8px 时会自动抑制 click 事件，防止误触。</text>
      </view>

      <view class="demo-block mt-[12px]">
        <text class="demo-label">4. 自定义尺寸与插槽（右下角底部绿色按钮）</text>
        <text class="demo-text">支持自定义 width / height / backgroundColor / color，默认插槽可传入任意内容（如 edit-pen 编辑笔图标）。</text>
      </view>

      <view class="demo-block mt-[12px]">
        <text class="demo-label">事件交互日志</text>
        <view class="log-box mt-[10px]">
          <text class="log-text">{{ eventLog }}</text>
        </view>
      </view>
    </view>

    <!-- 1. 基础用法：深灰置顶图标，仅触发点击 -->
    <up-float-button
      top="120px"
      right="20px"
      background-color="#475569"
      color="#ffffff"
      @click="onBasicClick"
    >
      <up-icon name="arrow-up" color="#ffffff" size="22"></up-icon>
    </up-float-button>

    <!-- 2. 可拖动：橙色图钉图标，可随手势拖动 -->
    <up-float-button
      top="200px"
      right="20px"
      background-color="#f59e0b"
      color="#ffffff"
      :draggable="true"
      @click="onDragButtonClick"
    >
      <up-icon name="pushpin" color="#ffffff" size="22"></up-icon>
    </up-float-button>

    <!-- 3. 菜单模式：经典蓝色加号，点击展开/收起菜单 -->
    <up-float-button
      bottom="100px"
      right="20px"
      background-color="#2979ff"
      color="#ffffff"
      :is-menu="true"
      :list="menuList"
      @click="onMenuClick"
      @item-click="onItemClick"
    ></up-float-button>

    <!-- 4. 自定义尺寸与配色 + 默认插槽：绿色编辑图标 -->
    <up-float-button
      bottom="25px"
      right="20px"
      background-color="#19be6b"
      color="#ffffff"
      width="60px"
      height="60px"
      @click="onCustomClick"
    >
      <up-icon name="edit-pen" color="#ffffff" size="26"></up-icon>
    </up-float-button>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue';

definePage({
  layout: 'navbar',
  showBack: true,
  hideNavbar: false,
  enablePullDownRefresh: false,
  style: {
    navigationBarTitleText: 'up-float-button 悬浮按钮',
    navigationStyle: 'custom'
  }
});

const basicClickCount = ref(0);
const eventLog = ref<string>('点击任意悬浮按钮，事件会打印在这里');

// 菜单项：name 为图标名，未指定的 backgroundColor / color 会退回组件自身的同名属性
const menuList = ref<UTSJSONObject[]>([
  { name: 'star-fill', backgroundColor: '#ff9900', color: '#ffffff' },
  { name: 'chat-fill', backgroundColor: '#3c9cff', color: '#ffffff' },
  { name: 'share-fill', backgroundColor: '#19be6b', color: '#ffffff' }
] as UTSJSONObject[]);

function log(message: string): void {
  eventLog.value = message;
}

function onBasicClick(): void {
  basicClickCount.value = basicClickCount.value + 1;
  log(`click => 基础按钮被点击，第 ${basicClickCount.value} 次`);
}

function onMenuClick(): void {
  log('click => 菜单按钮展开 / 收起');
}

function onCustomClick(): void {
  log('click => 自定义样式按钮被点击');
}

function onDragButtonClick(): void {
  log('click => 可拖动按钮被点击（拖动不会触发这一条）');
}

function onItemClick(item: UTSJSONObject): void {
  const index = item.index != null ? parseInt(item.index!.toString()) : 0;
  const name = item.name != null ? item.name!.toString() : '';
  log(`item-click => index=${index} name=${name}`);
}
</script>

<style lang="scss" scoped>
.demo-block {
  margin-bottom: 12px;
  padding: 12px;
  background-color: #ffffff;
  border-radius: 8px;
}
.demo-label {
  font-size: 14px;
  font-weight: bold;
  color: #606266;
  margin-bottom: 10px;
  padding-left: 4px;
  border-left-width: 3px;
  border-left-style: solid;
  border-left-color: $up-primary;
}
.demo-text {
  font-size: 13px;
  color: #475569;
  line-height: 20px;
}
.log-box {
  padding: 10px;
  background-color: #f1f5f9;
  border-radius: 8px;
}
.log-text {
  font-size: 13px;
  color: #475569;
  line-height: 20px;
}
</style>
