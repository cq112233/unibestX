<template>
  <view class="page-container bg-[#f8fafc] min-h-screen pb-[30px]">
    <NavBar title="Transition 动画" :auto-back="true" :safe-area-inset-top="true" bg-color="#ffffff"></NavBar>
    <view class="p-[16px]">
      <view class="demo-block">
        <text class="demo-label">内置过渡动画</text>
        <view class="transition-demo-wrapper">
          <UpTransition :show="transitionShow" mode="fade">
            <view class="transition-demo-box transition-demo-blue">
              <text class="text-[14px] text-white font-[500]">fade 淡入淡出</text>
            </view>
          </UpTransition>
          <view class="mt-[10px]">
            <UpButton type="primary" :text="transitionShow ? '隐藏动画' : '显示动画'" size="mini" @click="transitionShow = !transitionShow"></UpButton>
          </view>
        </view>
      </view>
      <view class="demo-block mt-[12px]">
        <text class="demo-label">缩放动画</text>
        <view class="transition-demo-wrapper">
          <UpTransition :show="transitionShow" mode="zoom">
            <view class="transition-demo-box bg-[#19be6b]">
              <text class="text-[14px] text-white font-[500]">zoom 缩放</text>
            </view>
          </UpTransition>
        </view>
      </view>
      <view class="demo-block mt-[12px]">
        <text class="demo-label">滑动动画</text>
        <view class="transition-demo-wrapper">
          <UpTransition :show="slideShow" :mode="slideMode">
            <view class="transition-demo-box bg-[#f56c6c]">
              <text class="text-[14px] text-white font-[500]">slide 滑动</text>
            </view>
          </UpTransition>
        </view>
        <view class="flex-row items-center justify-around mt-[10px]">
          <UpButton type="primary" text="上滑" size="mini" custom-style="margin: 0 4px;" @click="triggerSlide('slide-up')"></UpButton>
          <UpButton type="success" text="下滑" size="mini" custom-style="margin: 0 4px;" @click="triggerSlide('slide-down')"></UpButton>
          <UpButton type="warning" text="左滑" size="mini" custom-style="margin: 0 4px;" @click="triggerSlide('slide-left')"></UpButton>
          <UpButton type="error" text="右滑" size="mini" custom-style="margin: 0 4px;" @click="triggerSlide('slide-right')"></UpButton>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue';
import NavBar from '@/src/components/NavBar/NavBar.uvue';
import UpTransition from '@/uni_modules/uview-ultra/components/up-transition/up-transition.uvue';
import UpButton from '@/uni_modules/uview-ultra/components/up-button/up-button.uvue';

definePage({
  style: {
    navigationStyle: 'custom',
    navigationBarTitleText: 'Transition 动画'
  }
});

const transitionShow = ref(true);

const slideMode = ref('slide-up');
const slideShow = ref(false);

function triggerSlide(mode: string) {
  slideMode.value = mode;
  slideShow.value = true;
  setTimeout(() => {
    slideShow.value = false;
  }, 1500);
}
</script>

<style lang="scss" scoped>
.demo-block {
  margin-bottom: 12px;
  padding: 12px;
  background-color: #ffffff;
  border-radius: 8px;
}
.demo-label {
  font-size: 14px;
  font-weight: bold;
  color: #606266;
  margin-bottom: 10px;
  padding-left: 4px;
  border-left-width: 3px;
  border-left-style: solid;
  border-left-color: $up-primary;
}
.transition-demo-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20px 0;
}
.transition-demo-box {
  width: 120px;
  height: 120px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 15px;
}
.transition-demo-blue {
  background-color: #2979ff;
}
</style>
