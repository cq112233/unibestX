  font-size: 13px;
  color: #475569;
  line-height: 20px;
}
.log-box {
  padding: 10px;
  background-color: #f1f5f9;
  border-radius: 8px;
}
.log-text {
  font-size: 13px;
  color: #475569;
  line-height: 20px;
}
.drag-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 56px;
  padding-left: 12px;
  padding-right: 52px;
  background-color: #ffffff;
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: #eef2f7;
}
.drag-item--disabled {
  background-color: #f8fafc;
}
.drag-item-text {
  font-size: 14px;
  color: #1e293b;
}
.drag-item-index {
  margin-left: auto;
  font-size: 12px;
  color: #94a3b8;
}
.drag-handler {
  position: absolute;
  top: 0;
  right: 0;
  width: 44px;
  height: 56px;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #eef2f7;
  border-left-width: 1px;
  border-left-style: solid;
  border-left-color: #e2e8f0;
}
.drag-handler--left {
  left: 0;
  right: auto;
  border-left-width: 0px;
  border-right-width: 1px;
  border-right-style: solid;
  border-right-color: #e2e8f0;
}
.drag-item--left {
  padding-left: 52px;
  padding-right: 12px;
}
.drag-handler--disabled {
  background-color: #e2e8f0;
}
.drag-handler-h {
  position: absolute;
  top: 0;
  right: 0;
  width: 40px;
  height: 56px;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #dbeafe;
  border-left-width: 1px;
  border-left-style: solid;
  border-left-color: #bfdbfe;
  border-radius: 0 8px 8px 0;
}
.drag-item-h {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 140px;
  height: 56px;
  margin-right: 8px;
  background-color: #eff6ff;
  border-width: 1px;
  border-style: solid;
  border-color: #bfdbfe;
  border-radius: 8px;
  box-sizing: border-box;
}
.drag-item-grid {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 96px;
  height: 96px;
  background-color: #f1f5f9;
  border-width: 1px;
  border-style: solid;
  border-color: #e2e8f0;
  border-radius: 8px;
  box-sizing: border-box;
}
.drag-item-grid-text {
  font-size: 13px;
  color: #334155;
}
.drag-item-grid-index {
  margin-top: 6px;
  font-size: 11px;
  color: #94a3b8;
}
.drag-handler-grid {
  position: absolute;
  top: 0;
  right: 0;
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #e2e8f0;
  border-radius: 0 8px 0 8px;
}
</style>
