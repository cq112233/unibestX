<template>
  <view class="page-container bg-[#f8fafc] min-h-screen pb-[30px]">
    <NavBar title="up-tooltip 长按提示" :auto-back="true" :safe-area-inset-top="true" bg-color="#ffffff"></NavBar>
    <view class="p-[16px]">
      <!-- 基础用法 -->
      <view class="demo-block">
        <text class="demo-label">基础用法</text>
        <view class="flex flex-row items-center flex-wrap">
          <view class="mr-[12px] mb-[8px]">
            <UpTooltip text="长按此处复制文本" direction="top"></UpTooltip>
          </view>
          <view class="mb-[8px]">
            <UpTooltip text="长按显示操作" direction="top" :show-copy="false" :buttons="tooltipButtons" @click="handleBtnClick"></UpTooltip>
          </view>
        </view>
      </view>

      <!-- 弹出方向 -->
      <view class="demo-block mt-[12px]">
        <text class="demo-label">弹出方向</text>
        <view class="flex flex-row items-center flex-wrap">
          <view class="mr-[16px] mb-[8px]">
            <UpTooltip text="长按文本，上方提示" direction="top"></UpTooltip>
          </view>
          <view class="mb-[8px]">
            <UpTooltip text="长按文本，下方提示" direction="bottom"></UpTooltip>
          </view>
        </view>
      </view>

      <!-- 高亮选中文本背景色 -->
      <view class="demo-block mt-[12px]">
        <text class="demo-label">高亮选中文本背景色</text>
        <view class="flex flex-row items-center">
          <UpTooltip text="长按文本，显示背景色" bg-color="#d1fae5" direction="top"></UpTooltip>
        </view>
      </view>

      <!-- 扩展按钮 -->
      <view class="demo-block mt-[12px]">
        <text class="demo-label">扩展按钮</text>
