<template>
  <view class="page" :style="{ height: `${windowHeight}px` }">
    <view class="video-wrap">
      <up-short-video
        ref="shortVideoRef"
        :video-list="videoList"
        :current-tab="0"
        :current-video="0"
        @tab-change="onTabChange"
        @video-change="onVideoChange"
        @like="onLike"
        @comment="onComment"
        @share="onShare"
        @collect="onCollect"
        @progress-change="onProgressChange"
        @go-next="onGoNext"
      ></up-short-video>
    </view>

    <up-button
      text="返回"
      type="primary"
      size="small"
      color="rgba(0, 0, 0, 0.4)"
      class="back-btn"
      @click="onBack"
    ></up-button>

    <view class="log-bar">
      <text class="log-text">{{ eventLog }}</text>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue';

definePage({
  style: {
    navigationStyle: 'custom',
    navigationBarTitleText: 'up-short-video 短视频'
  }
});

function makeVideo(
  url: string,
  name: string,
  avatar: string,
  desc: string,
  likeCount: string,
  commentCount: string,
  shareCount: string,
  collectCount: string
): UTSJSONObject {
  return {
    videoUrl: url,
    author: {
      name,
      avatar,
      desc
    },
    likeCount,
    commentCount,
    shareCount,
    collectCount,
    isLiked: false,
    isCollected: false,
    playbackRate: 1,
    progress: 0,
    aspectRatio: 16.0 / 9.0
  } as UTSJSONObject;
}

const videoList = ref<Array<UTSJSONObject>>([
  makeVideo(
    'https://qiniu-web-assets.dcloud.net.cn/unidoc/zh/2minute-demo.mp4',
    'uni-app 官方示例',
    '/static/logo.png',
    'DCloud 官方示例视频（国内 CDN）',
    '1.2w',
    '356',
    '89',
    '120'
  ),
  makeVideo(
    'https://sf1-cdn-tos.huoshanstatic.com/obj/media-fe/xgplayer_doc_video/mp4/xgplayer-demo-360p.mp4',
    'xgplayer 示例 360P',
    '/static/qq_uniBestX.jpg',
    '字节跳动 xgplayer 官方示例视频',
    '8600',
    '124',
    '45',
    '67'
  ),
  makeVideo(
    'https://sf1-cdn-tos.huoshanstatic.com/obj/media-fe/xgplayer_doc_video/mp4/xgplayer-demo-720p.mp4',
    'xgplayer 示例 720P',
    '/static/qr-code.png',
    '字节跳动 xgplayer 官方示例视频',
    '5300',
    '88',
    '30',
    '42'
  )
]);

const eventLog = ref<string>('上下滑动切换视频，右侧按钮点赞/评论/分享/收藏');
const shortVideoRef = ref(null as ComponentPublicInstance | null);
const windowHeight = ref<number>(uni.getWindowInfo().windowHeight);

function onTabChange(index: number) {
  eventLog.value = `tabChange => ${index.toString()}`;
}

function onVideoChange(index: number) {
  eventLog.value = `videoChange => 第 ${(index + 1).toString()} 个视频`;
}

function getEventIndex(event: UTSJSONObject): number {
  const value = event.index;
  if (typeof value == 'number') {
    return value as number;
  }
  if (value == null) {
    return 0;
  }
  const parsed = parseInt(value.toString());
  return isNaN(parsed) ? 0 : parsed;
}

function onLike(event: UTSJSONObject) {
  eventLog.value = `like => 第 ${(getEventIndex(event) + 1).toString()} 个视频`;
}

function onComment(event: UTSJSONObject) {
  eventLog.value = `comment => 第 ${(getEventIndex(event) + 1).toString()} 个视频`;
}

function onShare(event: UTSJSONObject) {
  eventLog.value = `share => 第 ${(getEventIndex(event) + 1).toString()} 个视频`;
}

function onCollect(event: UTSJSONObject) {
  eventLog.value = `collect => 第 ${(getEventIndex(event) + 1).toString()} 个视频`;
}

function onProgressChange(event: UTSJSONObject) {
  const progress = event.progress;
  const value = progress == null ? 0 : progress.toString();
  eventLog.value = `progressChange => ${value}`;
}

function onGoNext() {
  eventLog.value = 'goNext => 点击了 Home 底部导航';
}

function onBack() {
  uni.navigateBack();
}
</script>

<style lang="scss" scoped>
.page {
  width: 100%;
  background-color: #000000;
  position: relative;
}

.video-wrap {
  width: 100%;
  height: 100%;
}

.back-btn {
  position: fixed;
  left: 16px;
  top: 56px;
  z-index: 99;
  border-radius: 18px;
}

.log-bar {
  position: fixed;
  left: 50%;
  bottom: 96px;
  transform: translateX(-50%);
  z-index: 99;
  width: 80%;
  max-width: 600px;
  padding: 8px 14px;
  background-color: rgba(0, 0, 0, 0.55);
  border-radius: 18px;
}

.log-text {
  font-size: 12px;
  color: #ffffff;
  line-height: 18px;
}
</style>
