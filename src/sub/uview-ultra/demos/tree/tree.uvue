<template>
  <view class="page-container bg-[#f8fafc] min-h-screen pb-[30px]">
    <NavBar title="up-tree 树形"></NavBar>
    <view class="p-[16px]">
      <!-- 1. 基础用法 -->
      <view class="demo-block">
        <UpTitle class="demo-title">
          <text class="demo-title-text">基础用法（点击节点展开/收起）</text>
        </UpTitle>
        <UpTree :data="treeData"></UpTree>
      </view>

      <!-- 2. 默认展开全部 -->
      <view class="demo-block mt-[12px]">
        <UpTitle class="demo-title">
          <text class="demo-title-text">默认展开全部</text>
        </UpTitle>
        <UpTree :data="treeData" default-expand-all></UpTree>
      </view>

      <!-- 3. 默认展开指定节点 + 高亮当前 -->
      <view class="demo-block mt-[12px]">
        <UpTitle class="demo-title">
          <text class="demo-title-text">默认展开指定节点 + 高亮当前节点</text>
        </UpTitle>
        <UpTree
          :data="treeData"
          :default-expanded-keys="[1, 11]"
          :current-node-key="12"
          highlight-current
        ></UpTree>
      </view>

      <!-- 4. 复选框（父子级联） -->
      <view class="demo-block mt-[12px]">
        <UpTitle class="demo-title">
          <text class="demo-title-text">复选框（父子级联勾选）</text>
        </UpTitle>
        <UpTree :data="treeData" show-checkbox></UpTree>
      </view>

      <!-- 5. 复选框（父子独立） -->
      <view class="demo-block mt-[12px]">
        <UpTitle class="demo-title">
          <text class="demo-title-text">复选框（父子独立 checkStrictly）</text>
        </UpTitle>
        <UpTree :data="treeData" show-checkbox check-strictly></UpTree>
      </view>

      <!-- 6. 手风琴模式 -->
      <view class="demo-block mt-[12px]">
        <UpTitle class="demo-title">
          <text class="demo-title-text">手风琴模式（同时只展开一个）</text>
        </UpTitle>
        <UpTree :data="treeData" accordion></UpTree>
      </view>

      <!-- 7. 自定义字段 -->
      <view class="demo-block mt-[12px]">
        <UpTitle class="demo-title">
          <text class="demo-title-text">自定义字段（label/children/nodeKey/disabled）</text>
        </UpTitle>
        <UpTree :data="customData" :props="customTreeProps"></UpTree>
      </view>

      <!-- 8. 事件监听 -->
      <view class="demo-block mt-[12px]">
        <UpTitle class="demo-title">
          <text class="demo-title-text">事件监听</text>
        </UpTitle>
        <UpTree
          :data="treeData"
          show-checkbox
          @node-click="onNodeClick"
          @node-expand="onNodeExpand"
          @node-collapse="onNodeCollapse"
          @check-change="onCheckChange"
        ></UpTree>
        <view class="log-box mt-[10px]">
          <text class="log-text">{{ eventLog }}</text>
        </view>
      </view>

      <!-- 9. ref 实例方法 -->
      <view class="demo-block mt-[12px]">
        <UpTitle class="demo-title">
          <text class="demo-title-text">ref 实例方法</text>
        </UpTitle>
        <UpTree ref="treeRef" :data="treeData" show-checkbox default-expand-all></UpTree>
        <view class="btn-row mt-[10px]">
          <UpButton text="setCheckedKeys" type="primary" size="small" class="demo-btn" @click="onSetCheckedKeys"></UpButton>
          <UpButton text="getCheckedKeys" type="primary" size="small" class="demo-btn" @click="onGetCheckedKeys"></UpButton>
          <UpButton text="setCurrentKey" type="primary" size="small" class="demo-btn" @click="onSetCurrentKey"></UpButton>
        </view>
        <text class="log-text mt-[10px]">{{ apiLog }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue';
import NavBar from '@/src/components/NavBar/NavBar.uvue';
import UpTitle from '@/uni_modules/uview-ultra/components/up-title/up-title.uvue';
import UpTree from '@/uni_modules/uview-ultra/components/up-tree/up-tree.uvue';
import UpButton from '@/uni_modules/uview-ultra/components/up-button/up-button.uvue';

definePage({
  style: {
    navigationStyle: 'custom',
    navigationBarTitleText: 'up-tree 树形'
  }
});

const treeData = ref<UTSJSONObject[]>([
  {
    id: 1,
    label: '一级菜单 1',
    children: [
      { id: 11, label: '二级菜单 1-1' },
      {
        id: 12,
        label: '二级菜单 1-2',
        children: [
          { id: 121, label: '三级菜单 1-2-1' },
          { id: 122, label: '三级菜单 1-2-2' }
        ]
      }
    ]
  },
  {
    id: 2,
    label: '一级菜单 2',
    children: [
      { id: 21, label: '二级菜单 2-1' }
    ]
  },
  { id: 3, label: '一级菜单 3（叶子节点）' }
] as UTSJSONObject[]);

const customTreeProps = ref<UTSJSONObject>({
  label: 'name',
  children: 'list',
  nodeKey: 'key',
  disabled: 'forbidden'
} as UTSJSONObject);

const customData = ref<UTSJSONObject[]>([
  {
    key: 'c1',
    name: '自定义字段 1',
    forbidden: false,
    list: [
      { key: 'c1-1', name: '自定义字段 1-1', forbidden: false },
      { key: 'c1-2', name: '自定义字段 1-2（禁用）', forbidden: true }
    ]
  },
  { key: 'c2', name: '自定义字段 2', forbidden: false }
] as UTSJSONObject[]);

const eventLog = ref<string>('点击节点或勾选复选框试试');
const apiLog = ref<string>('');

function getNodeLabel(node: UTSJSONObject): string {
  const label = node.label;
  return label == null ? '' : label.toString();
}

function onNodeClick(node: UTSJSONObject) {
  eventLog.value = `node-click：${getNodeLabel(node)}`;
}

function onNodeExpand(node: UTSJSONObject) {
  eventLog.value = `node-expand：${getNodeLabel(node)}`;
}

function onNodeCollapse(node: UTSJSONObject) {
  eventLog.value = `node-collapse：${getNodeLabel(node)}`;
}

function onCheckChange(node: UTSJSONObject, checked: boolean) {
  eventLog.value = `check-change：${getNodeLabel(node)} => ${checked ? '勾选' : '取消勾选'}`;
}

const treeRef = ref(null as ComponentPublicInstance | null);

function onSetCheckedKeys() {
  const tree = treeRef.value;
  if (tree != null) {
    tree.$callMethod('setCheckedKeys', [1, 11] as any[], false);
    apiLog.value = '已调用 setCheckedKeys([1, 11])';
  }
}

function onGetCheckedKeys() {
  const tree = treeRef.value;
  if (tree != null) {
    const keys = tree.$callMethod('getCheckedKeys', false) as string[];
    apiLog.value = `getCheckedKeys() => ${keys.join(', ')}`;
  }
}

function onSetCurrentKey() {
  const tree = treeRef.value;
  if (tree != null) {
    tree.$callMethod('setCurrentKey', 21);
    apiLog.value = '已调用 setCurrentKey(21)';
  }
}
</script>

<style lang="scss" scoped>
.demo-block {
  margin-bottom: 12px;
  padding: 12px;
  background-color: #ffffff;
  border-radius: 8px;
}
.demo-title {
  margin-bottom: 10px;
}
.demo-title-text {
  font-size: 14px;
  font-weight: bold;
  color: #606266;
}
.log-box {
  padding: 10px;
  background-color: #f8fafc;
  border-radius: 6px;
}
.log-text {
  font-size: 13px;
  color: #475569;
  line-height: 20px;
}
.btn-row {
  display: flex;
  flex-direction: row;
}
.demo-btn {
  margin-right: 10px;
}
</style>
