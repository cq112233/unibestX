                <text class="text-[12px] text-[#64748b]">文件缓存大小：</text>
                <text class="text-[10px] text-[#94a3b8]">(临时/下载文件)</text>
              </view>
              <text class="text-[12px] font-bold" :class="fileCacheBytes > 0 ? 'text-[#ef4444]' : 'text-[#10b981]'">{{ fileCacheSizeText }}</text>
            </view>
            <view class="flex flex-row items-center justify-between mb-[6px]">
              <text class="text-[12px] text-[#64748b]">缓存文件数量：</text>
              <text class="text-[12px] font-medium text-[#1e293b]">{{ cacheFileCount }} 个文件</text>
            </view>
            <view class="flex flex-row items-center justify-between mb-[6px]">
              <view class="flex flex-row items-center">
                <text class="text-[12px] text-[#64748b]">本地 Storage 占用：</text>
                <text class="text-[10px] text-[#94a3b8]">(Token/Pinia/偏好)</text>
              </view>
              <text class="text-[12px] font-bold text-[#3b82f6]">{{ storageSizeText }}</text>
            </view>
            <view class="flex flex-col">
              <text class="text-[12px] text-[#64748b] mb-[2px]">缓存路径 (CACHE_PATH)：</text>
              <text class="text-[11px] text-[#94a3b8] leading-[16px]" style="font-family: monospace;">
                {{ cacheDirPath }}
              </text>
            </view>
          </view>
          <!-- 操作按钮行：清晰区分文件缓存与 Storage 清理 -->
          <view class="flex flex-row mb-[8px]">
            <view
              class="flex-1 h-[38px] rounded-[8px] bg-[#3b82f6] flex flex-row items-center justify-center mr-[6px]"
