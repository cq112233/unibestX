        </view>
      </view>
    </view>

    <!-- 3. 系统缓存管理 (getFileSystemManager) 卡片 -->
    <view class="mb-[16px]">
      <view
        class="rounded-[16px] p-[20px] m-[16px] border-[1px] border-solid"
