        </view>
        <view
          class="rounded-[12px] p-[16px] border-[1px] border-solid border-[#e2e8f0]"
          :style="{ paddingBottom: `${keyboardHeight > 0 ? keyboardHeight + 8 : 16}px` }"
        >
          <view class="flex flex-row items-center justify-between mb-[8px]">
            <text class="text-[14px] font-bold text-[#1e293b]">键盘高度动态避让</text>
            <view class="px-[8px] py-[3px] rounded-[6px] bg-[#e0f2fe] flex flex-row items-center">
              <text class="text-[12px] font-bold text-[#0284c7]">
                高度: {{ keyboardHeight }} px
              </text>
            </view>
          </view>
          <text class="text-[12px] text-[#64748b] leading-[18px] mb-[12px]">
            监听软键盘弹起高度变化，演练容器根据高度动态增加内边距防止遮挡内容。
          </text>

          <input
