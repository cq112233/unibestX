            <view
              class="flex-1 h-[38px] rounded-[8px] bg-[#f97316] flex flex-row items-center justify-center mr-[6px]"
              @click="handleClearFileCache"
            >
              <text class="text-[#ffffff] text-[12px] font-bold">清除文件缓存</text>
            </view>
            <view
              class="flex-1 h-[38px] rounded-[8px] bg-[#8b5cf6] flex flex-row items-center justify-center"
              @click="handleClearStorage"
            >
              <text class="text-[#ffffff] text-[12px] font-bold">清空 Storage</text>
            </view>
          </view>

          <!-- 一键彻底清空全部 (文件 + Storage) -->
          <view
            class="w-full h-[38px] rounded-[8px] bg-[#ef4444] flex flex-row items-center justify-center mb-[8px]"
            @click="handleClearAll"
          >
            <text class="text-[#ffffff] text-[13px] font-bold">一键清空全部缓存与数据 (彻底归零)</text>
          </view>

          <!-- 模拟写入测试缓存 -->
          <view
            class="w-full h-[36px] rounded-[8px] border-[1px] border-solid border-[#cbd5e1] bg-[#ffffff] flex flex-row items-center justify-center"
            @click="handleGenerateTestCache"
          >
            <text class="text-[#475569] text-[12px] font-medium">+ 写入 500KB 测试缓存文件 (观察数据减少)</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 4. 键盘感知与高度避让卡片 -->
    <view class="mb-[16px]">
      <view
        class="rounded-[16px] p-[20px] m-[16px] border-[1px] border-solid"
