<script setup lang="uts">
import { useAppStore } from '@/src/store'
import { isDark, setTheme } from '@/uni_modules/rice-ui'
import { computed } from 'vue'

const appStore = useAppStore()

const currentTheme = computed((): string => {
  return appStore.state.theme
})

const isDarkMode = computed((): boolean => {
  return isDark.value
})

function toggleTheme() {
  if (isDarkMode.value) {
    setTheme('light')
  }
  else {
    setTheme('dark')
  }
}

function goToDemo(page: string) {
  uni.navigateTo({
    url: `/src/sub/rice-ui/demos/${page}/${page}`,
    fail: (err) => {
      console.error('goToDemo fail:', err)
      uni.showToast({
        title: `打开 ${page} 页面失败`,
        icon: 'none',
      })
    },
  })
}
</script>

<style scoped>
.demo-group-card {
