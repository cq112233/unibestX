    <view class="p-16px">
      <!-- 基础滑块 -->
      <view class="demo-block">
        <text class="demo-label" :style="{ borderLeftColor: currentTheme }">基础用法</text>
        <view class="py-12px px-8px">
          <rice-slider v-model="val1" :active-color="currentTheme" />
