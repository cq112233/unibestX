<template>
  <view class="page-container bg-[#f8fafc] min-h-screen pb-[30px]">
    <NavBar title="ColorPicker 颜色选择" />
    <view class="p-[16px]">
      <!-- 基础颜色选择器 -->
      <view class="mb-[12px] p-[14px] bg-white rounded-[10px]">
        <view class="flex-row items-center mb-[12px]">
          <view class="w-[3px] h-[14px] rounded-[1px] mr-[6px]" :style="{ backgroundColor: currentTheme }" />
          <text class="text-[14px] font-bold text-[#334155]">颜色选择器</text>
        </view>
        <view class="rounded-[8px] overflow-hidden border border-solid border-[#e2e8f0]">
          <rice-color-picker v-model="selectedColor" :show-alpha="true" />
        </view>
        <view class="mt-[14px] flex-row items-center">
          <text class="text-[13px] text-[#64748b] mr-[8px]">当前颜色：{{ selectedColor }}</text>
          <view class="w-[24px] h-[24px] rounded-[4px] border border-solid border-[#cbd5e1]" :style="{ backgroundColor: selectedColor }" />
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { useAppStore } from '@/src/store';
import { computed, watch } from 'vue';

definePage({
  style: {
    navigationBarTitleText: 'ColorPicker 颜色选择',
    navigationStyle: 'custom'
  }
});

const appStore = useAppStore();
const currentTheme = computed((): string => appStore.state.theme);

const selectedColor = ref(appStore.state.theme);

watch(currentTheme, (newVal: string) => {
  selectedColor.value = newVal;
});
</script>
