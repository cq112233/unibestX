<template>
  <view class="page-container bg-[#f8fafc] min-h-screen pb-30px">
    <NavBar title="ColorPicker 颜色选择" :auto-back="true" :safe-area-inset-top="true" bg-color="#ffffff"></NavBar>
    <view class="p-16px">
      <!-- 基础颜色选择器 -->
      <view class="demo-block">
        <text class="demo-label" :style="{ borderLeftColor: currentTheme }">颜色选择器</text>
        <view class="rounded-8px overflow-hidden border-width-1px border-solid border-color-[#e2e8f0]">
          <rice-color-picker v-model="selectedColor" :show-alpha="true" />
        </view>
        <view class="mt-14px flex-row items-center">
          <text class="text-13px text-[#64748b] mr-8px">当前颜色：{{ selectedColor }}</text>
          <view class="w-24px h-24px rounded-4px border-width-1px border-solid border-color-[#cbd5e1]" :style="{ backgroundColor: selectedColor }" />
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { useAppStore } from '@/src/store'
import { computed, watch } from 'vue'

const appStore = useAppStore()
const currentTheme = computed((): string => appStore.state.theme)

const selectedColor = ref(appStore.state.theme)

watch(currentTheme, (newVal: string) => {
  selectedColor.value = newVal
})
</script>

<style scoped>
.demo-block {
  margin-bottom: 12px;
  padding: 14px;
  background-color: #ffffff;
  border-radius: 10px;
}
.demo-label {
  font-size: 14px;
  font-weight: bold;
  color: #334155;
  margin-bottom: 12px;
  padding-left: 6px;
  border-left-width: 3px;
  border-left-style: solid;
}
</style>
