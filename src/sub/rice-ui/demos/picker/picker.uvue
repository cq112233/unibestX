<template>
  <view class="page-container bg-[#f8fafc] min-h-screen pb-30px">
    <NavBar title="Picker 选择器" :auto-back="true" :safe-area-inset-top="true" bg-color="#ffffff"></NavBar>
    <view class="p-16px">
      <!-- 基础选择器 -->
      <view class="demo-block">
        <text class="demo-label" :style="{ borderLeftColor: currentTheme }">单列选择器</text>
        <view class="rounded-8px overflow-hidden border-width-1px border-solid border-color-[#e2e8f0]">
          <rice-picker
            :columns="columns"
            :use-popup="false"
            title="选择城市"
            @confirm="onConfirm"
          />
        </view>
        <view class="mt-10px">
          <text class="text-13px text-[#64748b]">已选城市：{{ selectedCity }}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { useAppStore } from '@/src/store'
import type { PickerEvent, PickerOption } from '@/uni_modules/rice-ui'
import { computed } from 'vue'

const appStore = useAppStore()
const currentTheme = computed((): string => appStore.state.theme)

const selectedCity = ref('杭州')

const columns: PickerOption[][] = [
  [
    { text: '杭州', value: 'hangzhou' } as PickerOption,
    { text: '宁波', value: 'ningbo' } as PickerOption,
    { text: '温州', value: 'wenzhou' } as PickerOption,
    { text: '嘉兴', value: 'jiaxing' } as PickerOption,
    { text: '绍兴', value: 'shaoxing' } as PickerOption,
  ],
]

function onConfirm(e: PickerEvent) {
  if (e.selectedOptions.length > 0) {
    selectedCity.value = e.selectedOptions[0].text as string
  }
}
</script>

<style scoped>
.demo-block {
  margin-bottom: 12px;
  padding: 14px;
  background-color: #ffffff;
  border-radius: 10px;
}
.demo-label {
  font-size: 14px;
  font-weight: bold;
  color: #334155;
  margin-bottom: 12px;
  padding-left: 6px;
  border-left-width: 3px;
  border-left-style: solid;
}
</style>
