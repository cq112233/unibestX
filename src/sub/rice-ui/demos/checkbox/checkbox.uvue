      <view class="mb-[12px] p-[14px] bg-white rounded-[10px]">
        <view class="flex-row items-center mb-[12px]">
          <view class="w-[3px] h-[14px] rounded-[1px] mr-[6px]" :style="{ backgroundColor: currentTheme }" />
          <text class="text-[14px] font-bold text-[#334155]">基础复选框</text>
        </view>
        <view class="flex-col">
          <view class="mb-[10px]">
            <rice-checkbox v-model="checked1" :checked-color="currentTheme" label="基础复选框 1" />
          </view>
          <view class="mb-[10px]">
            <rice-checkbox v-model="checked2" label="自定义颜色" checked-color="#ee0a24" />
          </view>
          <view class="mb-[10px]">
            <rice-checkbox v-model="checked3" :checked-color="currentTheme" label="方形复选框" shape="square" />
          </view>
          <view>
            <rice-checkbox :disabled="true" :value="true" :checked-color="currentTheme" label="禁用状态" />
          </view>
        </view>
      </view>

      <!-- 复选框组 -->
      <view class="mb-[12px] p-[14px] bg-white rounded-[10px]">
        <view class="flex-row items-center mb-[12px]">
          <view class="w-[3px] h-[14px] rounded-[1px] mr-[6px]" :style="{ backgroundColor: currentTheme }" />
