<template>
  <view class="page-container bg-[#f8fafc] min-h-screen pb-30px">
    <NavBar title="CountDown 倒计时" :auto-back="true" :safe-area-inset-top="true" bg-color="#ffffff"></NavBar>
    <view class="p-16px">
      <!-- 基础倒计时 -->
      <view class="demo-block">
        <text class="demo-label" :style="{ borderLeftColor: currentTheme }">基础倒计时 (30秒)</text>
        <view class="py-10px flex-row items-center">
          <rice-count-down :time="30 * 1000" />
        </view>
      </view>

      <!-- 自定义格式与样式 -->
      <view class="demo-block">
        <text class="demo-label" :style="{ borderLeftColor: currentTheme }">自定义时间格式 (HH:mm:ss)</text>
        <view class="py-10px flex-row items-center">
