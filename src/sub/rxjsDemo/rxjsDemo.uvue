<template>
  <view class="flex flex-col items-center flex-1 px-[16px] pt-[12px] pb-[24px]">
    <scroll-view direction="vertical" class="w-full flex flex-col flex-1" :style="{ maxWidth: '560px' }">
      <!-- 控制卡片 -->
      <view class="w-full rounded-[16px] bg-[#ffffff] border-[1px] border-solid border-[#e2e8f0] p-[16px] mb-[12px]">
        <view class="w-full flex flex-row items-center justify-between mb-[8px]">
          <text class="text-[17px] font-bold text-[#1e293b]">RxJS 流式 Markdown 演示</text>
          <view
            class="px-[8px] py-[3px] rounded-[6px]"
            :class="streamPlaying ? 'bg-[#dbeafe]' : (streamEmpty ? 'bg-[#f1f5f9]' : 'bg-[#dcfce7]')"
          >
            <text
              class="text-[11px] font-medium"
              :class="streamPlaying ? 'text-[#2563eb]' : (streamEmpty ? 'text-[#64748b]' : 'text-[#15803d]')"
            >
              {{ streamPlaying ? '传输中' : (streamEmpty ? '就绪' : '已完成') }}
            </text>
          </view>
        </view>
        <text class="text-[13px] text-[#64748b] leading-[20px] mb-[14px]">
          纯 UTS 驱动的 RxJS 管道接收数据流，由 mp-html 自动解析并渲染 Markdown、KaTeX 公式与 Mermaid 图。
        </text>

        <view class="w-full flex flex-row items-center">
          <view
            class="flex-1 h-[40px] rounded-[10px] flex flex-row items-center justify-center mr-[10px]"
            :class="streamPlaying ? 'bg-[#ef4444]' : 'bg-[#6366f1]'"
            @click="handleToggleStream"
          >
            <text class="text-[#ffffff] text-[14px] font-semibold">
              {{ streamPlaying ? '中断接收' : (streamEmpty ? '开始流式传输' : '重新播放') }}
            </text>
          </view>
          <view
            v-if="!streamEmpty"
            class="h-[40px] px-[16px] rounded-[10px] border-[1px] border-solid border-[#cbd5e1] bg-[#f8fafc] flex flex-row items-center justify-center"
            @click="handleClear"
          >
            <text class="text-[13px] text-[#475569] font-medium">清空</text>
          </view>
        </view>
      </view>

      <!-- 渲染输出区：直接由 mp-html 自动解析并渲染 -->
      <view class="w-full rounded-[16px] bg-[#ffffff] border-[1px] border-solid border-[#e2e8f0] p-[16px] min-h-[220px]">
        <view v-if="streamEmpty" class="w-full flex flex-col items-center justify-center py-[48px]">
          <text class="text-[13px] text-[#94a3b8]">点击上方按钮开始接收数据流</text>
        </view>
        <MpHtml v-else :content="streamHtml" />
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import { computed, onUnmounted, ref } from 'vue';
import { simulateStream } from '@/src/http/stream.uts';
import type { StreamChunk } from '@/src/http/stream.uts';
import type { Subscription } from '@/src/utils/rxjs-lite/index.uts';
import { scan } from '@/src/utils/rxjs-lite/index.uts';
import MpHtml from '@/uni_modules/mp-html/components/mp-html/mp-html.uvue';
import { markdownToHtml } from '@/uni_modules/mp-html/index.uts';

definePage({
  layout: 'navbar',
  showBack: true,
  hideNavbar: false,
  style: {
    navigationBarTitleText: 'RxJS 流式渲染',
    navigationStyle: 'custom'
  }
});

const DEMO_TEXT: string = '## 流式 Markdown 与全功能排版\n\n'
  + '数据分块陆续到达，实时解析，构建平滑的 AI 对话体验。\n\n'
  + '### 核心行内格式\n\n'
  + '**加粗**、*斜体*、***粗斜体***、~~删除线~~、`行内代码`，还有[一条超链接](https://doc.dcloud.net.cn/uni-app-x/)。\n\n'
  + '### 彩色文本支持\n\n'
  + '<span style="color:#e11d48">绯红</span>、<span style="color:#2563eb">蔚蓝</span>、<span style="color:#059669">翠绿</span>，嵌套在加粗里也生效：**<span style="color:#7c3aed">紫色粗体</span>**。\n\n'
  + '### 列表与内联样式\n\n'
  + '- 列表内支持 **加粗标签** 与 `代码高亮`\n'
  + '- 列表项支持 *斜体标注* 以及 [文档链接](https://doc.dcloud.net.cn/uni-app-x/)\n\n'
  + '### 图片渲染（点击可全屏原生预览）\n\n'
  + '![uni-app Logo](https://qiniu-web-assets.dcloud.net.cn/unidoc/zh/uni-app.png)\n\n'
  + '### 视频媒体流原生播放\n\n'
  + '<video src="https://qiniu-web-assets.dcloud.net.cn/unidoc/zh/2minute-demo.mp4" controls></video>\n\n'
  + '### 架构流程图（内置 Mermaid 原生排版）\n\n'
  + '```mermaid\n'
  + 'graph TD\n'
  + '  A[数据源分块到达] --> B(RxJS scan 累积)\n'
  + '  B --> C[markdownToHtml 转换]\n'
  + '  C --> D[mp-html 原生富文本渲染]\n'
  + '```\n\n'
  + '### 数学公式（内置 KaTeX 原生排版）\n\n'
  + '$$\n'
  + '\\sum_{n=1}^{\\infty} \\frac{1}{n^{2}} = \\frac{\\pi^{2}}{6}\n'
  + '$$\n\n'
  + '$$\n'
  + 'x = \\frac{-b \\pm \\sqrt{b^{2}-4ac}}{2a}\n'
  + '$$\n\n'
  + '流式传输与自动排版完成。\n';

/** 已接收到的完整内容（每个 chunk 都增长，不直接驱动渲染） */
let receivedText = '';

/**
 * 已交给 mp-html 渲染的内容快照 —— **只在块边界推进**，不是每个 chunk 都推进。
 *
 * 为什么必须这样：Markdown 分块到达时，末尾那个块（`<video>`、```mermaid、`$$…$$`、表格）
 * 常常只到了一半，此时块结构还没确定。若每个 chunk 都重渲染，同一个节点会在
 * 渲染分支之间「搬家」——最典型的就是 `<video>`：`</p>` 还没到齐时 parseHtml 里
 * `closePos == -1` 会把标签当顶层节点吐出（走顶层 video 分支），等 `</p>` 到齐它又变成
 * `<p>` 的子节点（走嵌套 video 分支）。原生组件于是被**销毁 → 重建**，
 * 在 Android Vapor 上重建时会拿到已释放的原生实例 id，直接抛
 * `IllegalStateException: UTS instance N is not registered`
 * （栈里 `codec` / `duration` 是 <video> 初始化时才会全量写一遍的私有 props，见 unibestX-skill 1.3.23）。
 *
 * 按空行（块边界）推进即回避整类问题：交给 mp-html 的每一份快照，块结构都是完整的。
 * 附带收益：每秒重解析次数从 25 次降到几次。
 */
const streamText = ref<string>('');
const streamPlaying = ref<boolean>(false);
/** 是否已经收到过数据（比 streamText 更早翻转，用于第一块到齐前就切掉空状态文案） */
const hasReceived = ref<boolean>(false);
let streamSub: Subscription | null = null;

/**
 * 取「最后一个完整块」结尾的位置（末尾那次 `\n\n` 之后），没有则返回 -1。
 *
 * 用 lastIndexOf 而不是判断整串是否以 `\n\n` 结尾：分块是 8 个字符一块，
 * 空行大多落在块中间，`endsWith` 会漏掉绝大多数块边界，流式会变成几次大跳。
 */
function lastBlockBoundary(text: string): number {
  const cut = text.lastIndexOf('\n\n');
  return cut < 0 ? -1 : cut + 2;
}

function resetStreamState(): void {
  receivedText = '';
  streamText.value = '';
  hasReceived.value = false;
}

function stopStream(): void {
  if (streamSub != null) {
    streamSub!.unsubscribe();
    streamSub = null;
  }
  streamPlaying.value = false;
}

function startStream(): void {
  stopStream();
  resetStreamState();
  streamPlaying.value = true;
  // 吐字节奏：8 字/块 × 90ms ≈ 89 字/秒；原 40ms 一块约 200 字/秒，滚动太快跟不上阅读。
  // 分块大小保持 8 —— lastBlockBoundary 的注释也是按 8 字一块写的。
  streamSub = simulateStream(DEMO_TEXT, 8, 90)
    .pipe(scan((acc: string, chunk: StreamChunk): string => acc + chunk.text, ''))
    .subscribe((full: string): void => {
      receivedText = full;
      hasReceived.value = true;
      // 只把「最后一个完整块」为止的内容交给渲染器：半截块永不进渲染，
      // 避免节点在渲染分支之间搬家、原生组件被销毁重建（详见 streamText 的说明）
      const boundary = lastBlockBoundary(full);
      if (boundary > streamText.value.length) {
        streamText.value = full.substring(0, boundary);
      }
    }, null, (): void => {
      // 收尾：把最后不足一个块边界的尾巴也渲染出来
      streamText.value = receivedText;
      streamPlaying.value = false;
    });
}

function handleToggleStream(): void {
  if (streamPlaying.value) {
    stopStream();
  }
  else {
    startStream();
  }
}

function handleClear(): void {
  stopStream();
  resetStreamState();
}

const streamEmpty = computed((): boolean => {
  return !hasReceived.value;
});

const streamHtml = computed((): string => {
  if (streamText.value.length == 0) {
    return '';
  }
  return markdownToHtml(streamText.value);
});

onUnmounted(() => {
  stopStream();
});
</script>
