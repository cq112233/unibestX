<template>
  <view class="flex flex-col flex-1 bg-[#f8fafc] p-[16px]">
    <scroll-view direction="vertical" class="flex-1 flex flex-col">
      <!-- 页面顶部描述卡片 -->
      <view
        class="rounded-[16px] p-[20px] mb-[16px] border-[1px] border-solid bg-[#ffffff] border-[#edf2f7]"
      >
        <view class="flex flex-row items-center mb-[10px]">
          <view
            class="w-[4px] h-[16px] rounded-[2px] mr-[8px] bg-[#0957de]"
          />
          <text class="text-[17px] font-bold text-[#1e293b]">lime-signature 签名板演示</text>
        </view>
        <text class="text-[13px] leading-[18px] text-[#64748b]">
          演示跨端平滑笔迹书写、画笔粗细与颜色调节、撤销重做及签名图片导出保存。
        </text>
      </view>

      <!-- 签名画布区域卡片 -->
      <view
        class="rounded-[16px] p-[16px] mb-[16px] border-[1px] border-solid bg-[#ffffff] border-[#edf2f7]"
      >
        <view
          class="signature-wrapper rounded-[12px] mb-[12px] border-[1px] border-solid border-[#e2e8f0] overflow-hidden"
          style="width: 100%; height: 280px;"
          @touchstart="onCardTouchStart"
          @touchend="onCardTouchEnd"
          @touchcancel="onCardTouchEnd"
          @touchmove.stop.prevent="preventScroll"
        >
          <l-signature
            ref="sigRef"
            style="width: 100%; height: 100%;"
            :pen-color="penColor"
            :pen-size="penSize"
            :open-smooth="openSmooth"
            :disable-scroll="true"
            background-color="#ffffff"
          />
        </view>

        <!-- 操作按钮组 -->
        <text class="text-[12px] font-bold text-[#94a3b8] mb-[10px]">画板操作</text>
        <view class="flex flex-row justify-between mb-[8px]">
          <view
            class="flex-1 h-[38px] rounded-[8px] bg-[#10b981] flex flex-row items-center justify-center mr-[6px]"
            @click="onAction('save')"
          >
            <text class="text-[#ffffff] text-[13px] font-bold">保存图片</text>
          </view>
          <view
            class="flex-1 h-[38px] rounded-[8px] bg-[#f59e0b] flex flex-row items-center justify-center mr-[6px]"
            @click="onAction('undo')"
          >
            <text class="text-[#ffffff] text-[13px] font-bold">撤销</text>
          </view>
          <view
            class="flex-1 h-[38px] rounded-[8px] bg-[#3b82f6] flex flex-row items-center justify-center mr-[6px]"
            @click="onAction('redo')"
          >
            <text class="text-[#ffffff] text-[13px] font-bold">重做</text>
          </view>
          <view
            class="flex-1 h-[38px] rounded-[8px] bg-[#ef4444] flex flex-row items-center justify-center"
            @click="onAction('clear')"
          >
            <text class="text-[#ffffff] text-[13px] font-bold">清空</text>
          </view>
        </view>
      </view>

      <!-- 画笔参数设置卡片 -->
      <view
        class="rounded-[16px] p-[16px] mb-[16px] border-[1px] border-solid bg-[#ffffff] border-[#edf2f7]"
      >
        <text class="text-[12px] font-bold text-[#94a3b8] mb-[12px]">画笔设置</text>

        <!-- 颜色选择 -->
        <view class="flex flex-row justify-between items-center mb-[14px]">
          <text class="text-[13px] text-[#475569]">画笔颜色</text>
          <view class="flex flex-row">
            <view
              v-for="clr in colorList"
              :key="clr"
              class="w-[28px] h-[28px] rounded-[14px] ml-[8px] border-[2px] border-solid items-center justify-center"
              :style="{
                backgroundColor: clr,
                borderColor: penColor === clr ? '#1e293b' : 'transparent'
              }"
              @click="penColor = clr"
            />
          </view>
        </view>

        <!-- 粗细选择 -->
        <view class="flex flex-row justify-between items-center mb-[10px]">
          <text class="text-[13px] text-[#475569]">画笔粗细</text>
          <text class="text-[12px] font-bold text-[#94a3b8]">{{ penSize }}px</text>
        </view>
        <view class="flex flex-row mb-[14px]">
          <view
            v-for="(sz, _j) in penSizeOptions"
            :key="sz"
            class="flex-1 h-[32px] rounded-[6px] flex flex-row items-center justify-center"
            :class="_j < penSizeOptions.length - 1 ? 'mr-[6px]' : ''"
            :style="{ backgroundColor: penSize === sz ? '#3b82f6' : '#e2e8f0' }"
            @click="penSize = sz"
          >
            <text class="text-[12px] font-bold" :style="{ color: penSize === sz ? '#ffffff' : '#475569' }">
              {{ sz }}px
            </text>
          </view>
        </view>

        <!-- #ifndef APP -->
        <!-- 压感切换 (非原生环境) -->
        <view class="flex flex-row justify-between items-center">
          <text class="text-[13px] text-[#475569]">模拟压感</text>
          <view
            class="h-[32px] w-[60px] rounded-[16px] flex flex-row items-center justify-center"
            :style="{ backgroundColor: openSmooth ? '#10b981' : '#cbd5e1' }"
            @click="openSmooth = !openSmooth"
          >
            <text class="text-[12px] text-[#ffffff] font-bold">{{ openSmooth ? '开' : '关' }}</text>
          </view>
        </view>
        <!-- #endif -->
      </view>

      <!-- 保存预览卡片 -->
      <view
        v-if="signUrl !== ''"
        class="rounded-[16px] p-[16px] mb-[16px] border-[1px] border-solid bg-[#ffffff] border-[#edf2f7] items-center"
      >
        <text class="text-[12px] font-bold text-[#94a3b8] mb-[10px]">签名导出预览</text>
        <image
          :src="signUrl"
          class="w-full h-[140px] rounded-[8px] border-[1px] border-solid border-[#e2e8f0]"
          mode="aspectFit"
        />
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import { onUnmounted, ref } from 'vue';
import type { ComponentPublicInstance } from 'vue';
import type { LimeSignatureToFileSuccess, LimeSignatureToTempFilePathOptions } from '@/uni_modules/lime-signature/index.uts';
import { setPageScrollEnabled } from '@/src/layouts/navbar/utils/index.uts';

definePage({
  debug: false,
  layout: 'navbar',
  showBack: true,
  hideNavbar: false,
  enablePullDownRefresh: false,
  style: {
    navigationBarTitleText: 'lime-signature 签名板',
    navigationStyle: 'custom'
  }
});

const sigRef = ref<ComponentPublicInstance | null>(null);

const penColor = ref('#ef4444');
const penSize = ref(4);
const openSmooth = ref(true);
const signUrl = ref('');

const colorList = ['#ef4444', '#000000', '#3b82f6', '#10b981', '#f59e0b'];
const penSizeOptions = [1, 3, 5, 8, 12];

function onCardTouchStart(): void {
  setPageScrollEnabled(false);
}

function onCardTouchEnd(): void {
  setPageScrollEnabled(true);
}

function preventScroll(): void {
  // 阻止滑动穿透到父级 scroll-view
}

onUnmounted(() => {
  setPageScrollEnabled(true);
});

function onAction(type: string): void {
  const el = sigRef.value as any;
  if (el == null) {
    uni.showToast({ title: '签名组件未就绪', icon: 'none' });
    return;
  }
  if (type === 'clear') {
    el.$callMethod('clear');
    signUrl.value = '';
  }
  else if (type === 'undo') {
    el.$callMethod('undo');
  }
  else if (type === 'redo') {
    el.$callMethod('redo');
  }
  else if (type === 'save') {
    el.$callMethod('canvasToTempFilePath', {
      success: (res: LimeSignatureToFileSuccess) => {
        if (res.isEmpty) {
          uni.showToast({ title: '请先签名', icon: 'none' });
          return;
        }
        signUrl.value = res.tempFilePath;
        uni.showToast({ title: '签名保存成功', icon: 'success' });
      },
      fail: (_err: any) => {
        uni.showToast({ title: '保存失败', icon: 'error' });
      }
    } as LimeSignatureToTempFilePathOptions);
  }
}
</script>

<style scoped>
/* #ifdef H5 */
.signature-wrapper {
  touch-action: none;
}
/* #endif */
</style>
