<template>
  <view class="flex flex-col flex-1 bg-[#f8fafc]">
    <scroll-view direction="vertical" class="flex-1 flex flex-col p-[16px]">
      <view class="rounded-[14px] p-[18px] mb-[12px] border-[1px] border-solid border-[#dbeafe] bg-[#ffffff]">
        <AppText variant="title" class="text-[#0f172a] mb-[6px]">
          字体与排版
        </AppText>
        <AppText variant="caption" class="text-[#64748b]">
          切换字体或字号，下方所有 AppText 会实时更新。
        </AppText>
      </view>

      <view class="rounded-[14px] p-[18px] border-[1px] border-solid border-[#e2e8f0] bg-[#ffffff]">
        <AppText variant="subtitle" class="text-[#1e293b] mb-[10px]">
          预览
        </AppText>

        <view class="p-[14px] mb-[18px] rounded-[10px] bg-[#f8fafc] border-[1px] border-solid border-[#e2e8f0]">
          <AppText variant="title" class="text-[#0f172a] mb-[6px]">
            订单详情
          </AppText>
          <AppText variant="body" class="text-[#334155] mb-[6px]">
            今天 14:30 已送达，共 3 件商品。
          </AppText>
          <AppText variant="caption" class="text-[#64748b]">
            AppText 会自动继承全局字体与字号缩放。
          </AppText>
        </view>

        <AppText variant="label" class="text-[#475569] mb-[8px]">
          字体
        </AppText>
        <view class="flex-row flex-wrap mb-[16px]">
          <view
            v-for="item in fontOptions"
            :key="item.id"
            class="px-[12px] py-[7px] mr-[8px] mb-[8px] rounded-[7px] border-[1px] border-solid"
            :class="fontStore.state.fontId == item.id ? 'bg-[#eff6ff] border-[#3b82f6]' : 'bg-[#ffffff] border-[#cbd5e1]'"
            @click="selectFont(item.id)"
          >
            <AppText
              variant="label"
              :class="fontStore.state.fontId == item.id ? 'text-[#1d4ed8]' : 'text-[#475569]'"
            >
              {{ item.label }}
            </AppText>
          </view>
        </view>

        <AppText variant="label" class="text-[#475569] mb-[8px]">
          字号
        </AppText>
        <view class="flex-row flex-wrap mb-[16px]">
          <view
            v-for="item in fontScaleOptions"
            :key="item.value"
            class="px-[12px] py-[7px] mr-[8px] mb-[8px] rounded-[7px] border-[1px] border-solid"
            :class="fontStore.state.fontScale == item.value ? 'bg-[#f0fdf4] border-[#22c55e]' : 'bg-[#ffffff] border-[#cbd5e1]'"
            @click="selectFontScale(item.value)"
          >
            <AppText
              variant="label"
              :class="fontStore.state.fontScale == item.value ? 'text-[#15803d]' : 'text-[#475569]'"
            >
              {{ item.label }}
            </AppText>
          </view>
        </view>

        <view class="p-[10px] rounded-[8px] bg-[#eff6ff]">
          <AppText variant="caption" class="text-[#1e40af]">
            当前：{{ currentFontLabel }} · {{ currentScaleLabel }}
          </AppText>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import { computed } from 'vue';
import { fontOptions } from '@/src/config/font/font.uts';
import { useFontStore } from '@/src/store/index.uts';

definePage({
  debug: false,
  layout: 'navbar',
  showBack: true,
  hideNavbar: false,
  enablePullDownRefresh: false,
  style: {
    navigationBarTitleText: '字体演示',
    navigationStyle: 'custom'
  }
});

type FontScaleOption = {
  label: string;
  value: number;
};

const fontStore = useFontStore();

const fontScaleOptions: Array<FontScaleOption> = [
  { label: '标准 100%', value: 1 },
  { label: '大 115%', value: 1.15 },
  { label: '特大 130%', value: 1.3 }
];

const currentFontLabel = computed((): string => {
  for (let i = 0; i < fontOptions.length; i++) {
    if (fontOptions[i].id == fontStore.state.fontId) {
      return fontOptions[i].label;
    }
  }
  return '系统默认';
});

const currentScaleLabel = computed((): string => {
  return `${Math.round(fontStore.state.fontScale * 100)}%`;
});

/**
 * 切换全局字体
 * @param fontId 字体配置 id
 */
function selectFont(fontId: string): void {
  fontStore.setFont(fontId).then((_ok: boolean): void => {}, (_err: any): void => {
    uni.showToast({
      title: '字体切换失败',
      icon: 'none'
    });
  });
}

/**
 * 切换全局字号缩放
 * @param scale 缩放比例
 */
function selectFontScale(scale: number): void {
  fontStore.setFontScale(scale);
}
</script>

<style scoped>
</style>
