<script setup lang="uts">
import { ref } from 'vue';
import { useCodeTimer, useCountDown, useZIndex } from '@/uni_modules/lime-use';
import type { UseCodeTimerOptions, UseCountDownOptions } from '@/uni_modules/lime-use';
// useTimeout 未在 lime-use 根门面导出，按子路径精准导入
import { useTimeout } from '@/uni_modules/lime-use/useTimeout';

definePage({
  debug: false,
  layout: 'navbar',
  showBack: true,
  hideNavbar: false,
  enablePullDownRefresh: false,
  style: {
    navigationBarTitleText: 'lime-use 组合式函数',
    navigationStyle: 'custom'
  }
});

// =========================================================================
// 【可选删除】以下内容仅供 lime-use 演示使用，接入真实业务时可整段删除。
// 演示参数属于「页面结构级只读常量」（随页面固化、不由后端下发），故内联在本文件。
// =========================================================================
const SECOND_COUNT_DOWN_TIME: number = 90 * 1000;
const MILLISECOND_COUNT_DOWN_TIME: number = 60 * 1000;
const CODE_TIMER_SECONDS: number = 60;
const TIMEOUT_DELAY: number = 3000;

// —— 倒计时模块：秒级 / 毫秒级两档独立实例，互不影响
const secondCountDownOption: UseCountDownOptions = {
  time: SECOND_COUNT_DOWN_TIME,
  format: 'HH:mm:ss'
};
const {
  formattedTime: secondCountDownTime,
  start: startSecondCountDown,
  pause: pauseSecondCountDown,
  reset: resetSecondCountDown
} = useCountDown(secondCountDownOption);

const millisecondCountDownOption: UseCountDownOptions = {
  time: MILLISECOND_COUNT_DOWN_TIME,
  format: 'ss:SSS',
  millisecond: true
};
const {
  formattedTime: millisecondCountDownTime,
  start: startMillisecondCountDown,
  pause: pauseMillisecondCountDown,
  reset: resetMillisecondCountDown
} = useCountDown(millisecondCountDownOption);

/** 启动秒级倒计时 */
function onStartSecondCountDown(): void {
  startSecondCountDown();
}

/** 暂停秒级倒计时（再次开始会从剩余时间继续） */
function onPauseSecondCountDown(): void {
  pauseSecondCountDown();
}

/** 重置秒级倒计时到初始 90 秒 */
function onResetSecondCountDown(): void {
  resetSecondCountDown(SECOND_COUNT_DOWN_TIME);
}

/** 启动毫秒级倒计时 */
function onStartMillisecondCountDown(): void {
  startMillisecondCountDown();
}

/** 暂停毫秒级倒计时 */
function onPauseMillisecondCountDown(): void {
  pauseMillisecondCountDown();
}

/** 重置毫秒级倒计时到初始 60 秒 */
function onResetMillisecondCountDown(): void {
  resetMillisecondCountDown(MILLISECOND_COUNT_DOWN_TIME);
}

// —— 验证码模块：请求结果与本地倒计时状态成组
/** 演示用的验证码返回值结构：接入真实业务时改为后端接口的返回类型 */
type VerifyCodeResult = {
  /** 开发期可见的验证码；线上由短信下发，接口不应再返回该字段 */
  code: string;
  /** 提示文案，由后端决定，页面直接展示 */
  message: string;
};

const DEMO_VERIFY_CODE: VerifyCodeResult = {
  code: '1024',
  message: '验证码已下发，请注意查收'
};

const isSendingCode = ref<boolean>(false);
const verifyCode = ref<string>('');
const verifyCodeMessage = ref<string>('');

/** 申请短信验证码：演示期直接返回本地结果，接入真实业务时替换为 http 请求 */
function requestVerifyCode(): Promise<VerifyCodeResult> {
  return Promise.resolve(DEMO_VERIFY_CODE);
}

const codeTimerOption: UseCodeTimerOptions = {
  seconds: CODE_TIMER_SECONDS,
  startText: '获取验证码',
  changeText: 'X 秒后重新获取',
  endText: '重新获取',
  keepRunning: false,
  uniqueKey: 'limeUseFunctionDemoCodeTimer',
  onEnd: (): void => {
    verifyCode.value = '';
    verifyCodeMessage.value = '';
  }
};
const {
  tip: codeTimerTip,
  canGetCode,
  start: startCodeTimer,
  reset: resetCodeTimer,
  pause: pauseCodeTimer,
  resume: resumeCodeTimer,
  isPaused: codeTimerPaused
} = useCodeTimer(codeTimerOption);

/** 点击获取验证码：拿到验证码后启动 60 秒倒计时 */
function onGetVerifyCode(): void {
  if (canGetCode.value == false || isSendingCode.value == true) {
    return;
  }
  isSendingCode.value = true;
  requestVerifyCode().then((res: VerifyCodeResult): void => {
    isSendingCode.value = false;
    verifyCode.value = res.code;
    verifyCodeMessage.value = res.message;
    startCodeTimer();
  }, (err: any): void => {
    isSendingCode.value = false;
    console.error('requestVerifyCode fail:', err);
  });
}

/** 暂停 / 继续验证码倒计时 */
function onTogglePauseCodeTimer(): void {
  if (codeTimerPaused.value) {
    resumeCodeTimer();
    return;
  }
  pauseCodeTimer();
}

/** 重置验证码倒计时并清空请求结果区 */
function onResetCodeTimer(): void {
  resetCodeTimer();
  verifyCode.value = '';
  verifyCodeMessage.value = '';
}

// —— 延时模块：延时到期前可随时取消
const timeoutFiredCount = ref<number>(0);

const { isPending: timeoutPending, start: startTimeout, stop: stopTimeout } = useTimeout((): void => {
  timeoutFiredCount.value += 1;
}, TIMEOUT_DELAY);

/** 启动 3 秒延时任务 */
function onStartTimeout(): void {
  startTimeout();
}

/** 取消尚未到期的延时任务 */
function onStopTimeout(): void {
  stopTimeout();
}

// —— 层级模块：弹层开合时抬升 / 回落 z-index
const { zIndex, increase: increaseZIndex, decrease: decreaseZIndex } = useZIndex();

/** 抬升一档 z-index，等价于打开一个弹层 */
function onIncreaseZIndex(): void {
  increaseZIndex();
}

/** 回落一档 z-index，等价于关闭一个弹层 */
function onDecreaseZIndex(): void {
  decreaseZIndex();
}
// =================== 【可选删除】lime-use 组合式函数演示 结束 ===================
</script>

<template>
  <view class="flex flex-col items-center flex-1 px-[16px] pt-[12px] pb-[24px]">
    <scroll-view direction="vertical" class="w-full flex flex-col flex-1" :style="{ maxWidth: '560px' }">
      <!-- 模块说明：来源与演示范围 -->
      <view class="w-full rounded-[16px] bg-[#ffffff] border-[1px] border-solid border-[#e2e8f0] p-[16px] mb-[12px]">
        <text class="text-[15px] font-bold text-[#1e293b]">lime-use 组合式函数</text>
        <text class="text-[12px] leading-[18px] text-[#64748b] mt-[6px]">uni_modules/lime-use 提供的 Vue 组合式函数（Hooks）：倒计时、验证码、延时执行与 z-index 分配，跨端一套写法，无需自己维护定时器。</text>
      </view>

      <!-- 1. useCountDown：秒级 / 毫秒级两档倒计时，各自独立控制 -->
      <view class="w-full rounded-[16px] bg-[#ffffff] border-[1px] border-solid border-[#e2e8f0] p-[16px] mb-[12px]">
        <view class="flex flex-row items-center mb-[10px]">
          <view class="w-[4px] h-[16px] rounded-[2px] mr-[8px] bg-[#2563eb]" />
          <text class="text-[14px] font-bold text-[#1e293b]">1. useCountDown 倒计时</text>
        </view>

        <!-- 秒级档：format 为 HH:mm:ss，默认每跨一秒刷新一次 -->
        <view class="w-full rounded-[12px] bg-[#f8fafc] p-[12px] mb-[10px]">
          <text class="text-[12px] text-[#64748b]">format: 'HH:mm:ss'（初始 90 秒）</text>
          <text class="text-[26px] font-bold text-[#2563eb] mt-[4px]" style="font-family: monospace;">{{ secondCountDownTime }}</text>
          <view class="flex flex-row items-center mt-[10px]">
            <view class="flex-1 h-[34px] flex flex-row items-center justify-center rounded-[8px] bg-[#2563eb] mr-[8px]" @click="onStartSecondCountDown">
              <text class="text-[12px] font-bold text-[#ffffff]">开始</text>
            </view>
            <view class="flex-1 h-[34px] flex flex-row items-center justify-center rounded-[8px] bg-[#e2e8f0] mr-[8px]" @click="onPauseSecondCountDown">
              <text class="text-[12px] font-bold text-[#475569]">暂停</text>
            </view>
            <view class="flex-1 h-[34px] flex flex-row items-center justify-center rounded-[8px] bg-[#e2e8f0]" @click="onResetSecondCountDown">
              <text class="text-[12px] font-bold text-[#475569]">重置</text>
            </view>
          </view>
        </view>

        <!-- 毫秒级档：millisecond 为 true 时按帧刷新，可看到 SSS 高速跳动 -->
        <view class="w-full rounded-[12px] bg-[#f8fafc] p-[12px]">
          <text class="text-[12px] text-[#64748b]">format: 'ss:SSS' + millisecond: true（初始 60 秒）</text>
          <text class="text-[26px] font-bold text-[#7c3aed] mt-[4px]" style="font-family: monospace;">{{ millisecondCountDownTime }}</text>
          <view class="flex flex-row items-center mt-[10px]">
            <view class="flex-1 h-[34px] flex flex-row items-center justify-center rounded-[8px] bg-[#7c3aed] mr-[8px]" @click="onStartMillisecondCountDown">
              <text class="text-[12px] font-bold text-[#ffffff]">开始</text>
            </view>
            <view class="flex-1 h-[34px] flex flex-row items-center justify-center rounded-[8px] bg-[#e2e8f0] mr-[8px]" @click="onPauseMillisecondCountDown">
              <text class="text-[12px] font-bold text-[#475569]">暂停</text>
            </view>
            <view class="flex-1 h-[34px] flex flex-row items-center justify-center rounded-[8px] bg-[#e2e8f0]" @click="onResetMillisecondCountDown">
              <text class="text-[12px] font-bold text-[#475569]">重置</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 2. useCodeTimer：验证码按钮，秒数由页面常量初始化、点击后先走演示接口再启动倒计时 -->
      <view class="w-full rounded-[16px] bg-[#ffffff] border-[1px] border-solid border-[#e2e8f0] p-[16px] mb-[12px]">
        <view class="flex flex-row items-center mb-[10px]">
          <view class="w-[4px] h-[16px] rounded-[2px] mr-[8px] bg-[#0d9488]" />
          <text class="text-[14px] font-bold text-[#1e293b]">2. useCodeTimer 验证码倒计时</text>
        </view>
        <text class="text-[12px] leading-[18px] text-[#64748b]">点击按钮先请求验证码（requestVerifyCode），成功后再启动本地倒计时；倒计时期间按钮自动置灰，结束后自动恢复。</text>

        <view
          class="w-full h-[42px] flex flex-row items-center justify-center rounded-[10px] mt-[12px]"
          :class="canGetCode ? 'bg-[#0d9488]' : 'bg-[#cbd5e1]'"
          @click="onGetVerifyCode"
        >
          <text class="text-[14px] font-bold" :class="canGetCode ? 'text-[#ffffff]' : 'text-[#64748b]'">{{ codeTimerTip }}</text>
        </view>

        <view class="flex flex-row items-center justify-between mt-[10px]">
          <text class="text-[12px] text-[#64748b]">倒计时状态：{{ codeTimerPaused ? '已暂停' : '运行中 / 可获取' }}</text>
          <view class="flex flex-row items-center">
            <view class="px-[10px] h-[28px] flex flex-row items-center justify-center rounded-[6px] bg-[#f1f5f9] mr-[8px]" @click="onTogglePauseCodeTimer">
              <text class="text-[11px] font-bold text-[#475569]">{{ codeTimerPaused ? '继续' : '暂停' }}</text>
            </view>
            <view class="px-[10px] h-[28px] flex flex-row items-center justify-center rounded-[6px] bg-[#f1f5f9]" @click="onResetCodeTimer">
              <text class="text-[11px] font-bold text-[#475569]">重置</text>
            </view>
          </view>
        </view>

        <!-- 请求结果区：验证码与提示文案均由 requestVerifyCode 下发 -->
        <view v-if="verifyCodeMessage != ''" class="w-full rounded-[8px] bg-[#ecfdf5] border-[1px] border-solid border-[#a7f3d0] p-[10px] mt-[10px]">
          <text class="text-[12px] text-[#047857]">{{ verifyCodeMessage }}（当前验证码：{{ verifyCode }}）</text>
        </view>
      </view>

      <!-- 3. useTimeout：一次性延时执行，可在到期前取消 -->
      <view class="w-full rounded-[16px] bg-[#ffffff] border-[1px] border-solid border-[#e2e8f0] p-[16px] mb-[12px]">
        <view class="flex flex-row items-center mb-[10px]">
          <view class="w-[4px] h-[16px] rounded-[2px] mr-[8px] bg-[#d97706]" />
          <text class="text-[14px] font-bold text-[#1e293b]">3. useTimeout 延时执行</text>
        </view>
        <view class="flex flex-row items-center justify-between">
          <text class="text-[12px] text-[#64748b]">定时器状态：{{ timeoutPending ? '等待中…' : '空闲' }}</text>
          <text class="text-[12px] text-[#64748b]">已触发 {{ timeoutFiredCount }} 次</text>
        </view>
        <view class="flex flex-row items-center mt-[10px]">
          <view class="flex-1 h-[34px] flex flex-row items-center justify-center rounded-[8px] bg-[#d97706] mr-[8px]" @click="onStartTimeout">
            <text class="text-[12px] font-bold text-[#ffffff]">3 秒后执行</text>
          </view>
          <view class="flex-1 h-[34px] flex flex-row items-center justify-center rounded-[8px] bg-[#e2e8f0]" @click="onStopTimeout">
            <text class="text-[12px] font-bold text-[#475569]">取消</text>
          </view>
        </view>
      </view>

      <!-- 4. useZIndex：统一分配弹层层级，避免各处手写魔数 -->
      <view class="w-full rounded-[16px] bg-[#ffffff] border-[1px] border-solid border-[#e2e8f0] p-[16px] mb-[12px]">
        <view class="flex flex-row items-center mb-[10px]">
          <view class="w-[4px] h-[16px] rounded-[2px] mr-[8px] bg-[#059669]" />
          <text class="text-[14px] font-bold text-[#1e293b]">4. useZIndex 层级分配</text>
        </view>
        <text class="text-[12px] leading-[18px] text-[#64748b]">每个弹层打开时 increase() 抬升一档、关闭时 decrease() 回落，zIndex 变量可直接绑定到弹层的 :style 上。</text>
        <view class="flex flex-row items-center justify-between mt-[12px]">
          <text class="text-[26px] font-bold text-[#059669]" style="font-family: monospace;">z-index = {{ zIndex }}</text>
          <view class="flex flex-row items-center">
            <view class="w-[46px] h-[32px] flex flex-row items-center justify-center rounded-[8px] bg-[#e2e8f0] mr-[8px]" @click="onDecreaseZIndex">
              <text class="text-[13px] font-bold text-[#475569]">-1</text>
            </view>
            <view class="w-[46px] h-[32px] flex flex-row items-center justify-center rounded-[8px] bg-[#059669]" @click="onIncreaseZIndex">
              <text class="text-[13px] font-bold text-[#ffffff]">+1</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<style scoped></style>
