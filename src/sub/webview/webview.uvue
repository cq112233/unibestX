<template>
  <view class="flex flex-col flex-1">
    <web-view
      class="flex-1 w-full h-full"
      style="flex: 1;"
      :src="targetUrl"
      @message="onWebviewMessage"
    />
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue';
import { useRouter } from '@/uni_modules/route-bestX/index.uts';

const router = useRouter();

definePage({
  debug: false,
  layout: 'navbar',
  showBack: true,
  enablePullDownRefresh: false,
  hideNavbar: false,
  hideStatusBar: false,
  style: {
    navigationBarTitleText: '浏览网页',
    navigationStyle: 'custom'
  }
});

const defaultUrl = 'https://github.com/cq112233/unibestX';
const targetUrl = ref<string>(defaultUrl);

onLoad((options: UTSJSONObject | null) => {
  if (options != null) {
    const raw = options.url as string | null;
    if (raw != null && raw != '') {
      const decoded = decodeURIComponent(raw);
      targetUrl.value = decoded != null ? decoded : raw;
    }
    const pageTitle = options.title as string | null;
    if (pageTitle != null && pageTitle != '') {
      uni.setNavigationBarTitle({
        title: pageTitle
      });
    }
  }
});

function onWebviewMessage(event: UniWebViewMessageEvent): void {
  const detail = event.detail;
  const data = detail.data;
  if (data != null && data.length > 0) {
    const lastItem = data[data.length - 1] as UTSJSONObject;
    const msgType = lastItem.type as string | null;
    if (msgType == 'NAVIGATE_BACK') {
      router.back();
      return;
    }
    const title = (lastItem.title as string | null) ?? (lastItem.content as string | null) ?? '收到网页消息';
    uni.showToast({
      title,
      icon: 'none'
    });
  }
}
</script>

<style scoped></style>
