<template>
  <view class="flex flex-col flex-1" :style="{ height: `${availableHeight}px` }">
    <web-view
      class="flex-1 w-full h-full"
      style="flex: 1;"
      :src="targetUrl"
      @message="onWebviewMessage"
    />
  </view>
</template>

<script setup lang="uts">
/* eslint-disable dot-notation */
import { ref } from 'vue';
import { availableHeight } from '@/src/utils/systemInfo/index.uts';

definePage({
  layout: 'navbar',
  showBack: true,
  hideNavbar: false,
  enablePullDownRefresh: false,
  style: {
    navigationBarTitleText: 'WebView 双向通讯',
    navigationStyle: 'custom'
  }
});

// 默认加载项目内置的双向通讯演示网页
const defaultDemoUrl = '/static/webview/index.html';
const targetUrl = ref<string>(defaultDemoUrl);

// 参数解析：优先使用传入的 url（供隐私协议等外链使用），未传时回退到默认演示页面
onLoad((options: UTSJSONObject | null) => {
  if (options != null) {
    const raw = options['url'] as string | null;
    if (raw != null && raw != '') {
      const decoded = decodeURIComponent(raw);
      targetUrl.value = decoded != null ? decoded : raw;
      return;
    }
  }
  targetUrl.value = defaultDemoUrl;
});

function onWebviewMessage(event: any): void {
  const detail = event?.detail as UTSJSONObject | null;
  const data = detail != null ? (detail['data'] as Array<any> | null) : null;
  if (data != null && data.length > 0) {
    const lastItem = data[data.length - 1] as UTSJSONObject;
    const msgType = lastItem['type'] as string | null;
    if (msgType === 'NAVIGATE_BACK') {
      uni.navigateBack();
      return;
    }
    const title = (lastItem['title'] as string | null) ?? (lastItem['content'] as string | null) ?? '收到网页消息';
    uni.showToast({
      title,
      icon: 'none'
    });
  }
}
</script>

<style scoped></style>
