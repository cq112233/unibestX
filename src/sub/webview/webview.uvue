<template>
  <!-- 通用 webview 容器：整页交给原生 <web-view>，无需自建根容器与滚动区 -->
  <web-view :src="targetUrl"></web-view>
</template>

<script setup lang="uts">
/* eslint-disable dot-notation */
/**
 * 通用 webview 容器（src/sub/webview/webview.uvue）
 *
 * 用法：/src/sub/webview/webview?url=<encodeURIComponent(链接)>
 * 供隐私页打开《用户协议》《隐私政策》等外链使用。
 *
 * 说明：整页由原生 <web-view> 承载，因此不使用 navbar 布局、不建 flex 根容器
 * 与 scroll-view（滚动由 web-view 自身接管）。
 */
import { ref } from 'vue';

definePage({
  customPageClass: 'page-container',
  customPageStyle: 'background-color: transparent;',
  debug: false,
  debugHome: false,
  showBack: false,
  hideStatusBar: false,
  hideNavbar: false,
  enablePullDownRefresh: false,
  style: {
    navigationBarTitleText: '详情',
    navigationStyle: 'custom'
  }
});

// —— 页面状态：待打开的链接
const targetUrl = ref<string>('');

// —— 参数解析：url 由调用方 encodeURIComponent 编码后传入
onLoad((options: UTSJSONObject | null) => {
  if (options == null) {
    return;
  }
  const raw = options['url'] as string | null;
  if (raw == null || raw == '') {
    return;
  }
  const decoded = decodeURIComponent(raw);
  targetUrl.value = decoded != null ? decoded : raw;
});
</script>
