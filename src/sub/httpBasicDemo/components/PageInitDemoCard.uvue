<template>
  <!-- ============ 页面加载自执行请求示例 ============ -->
  <view class="rounded-[16px] p-[20px] mb-[16px] border-[1px] border-solid border-[#edf2f7] bg-[#ffffff]">
    <!-- 标题 -->
    <view class="flex flex-row items-center mb-[8px]">
      <view class="w-[4px] h-[16px] rounded-[2px] mr-[8px] bg-[#0284c7]" />
      <text class="text-[16px] font-bold text-[#1e293b]">页面加载调用接口（自执行 Demo）</text>
    </view>

    <!-- 核心概念避坑提示 -->
    <view class="rounded-[8px] p-[10px] mb-[14px] bg-[#f0f9ff] border-[1px] border-solid border-[#bae6fd]">
      <text class="text-[12px] text-[#0369a1] leading-[18px]">
        💡 提示：definePage 是构建期编译宏（仅用于提取 pages.json 路由和导航栏配置，编译后会被剥离，绝不能写 await 调接口）。页面加载调接口请用以下两种标准方式：
      </text>
    </view>

    <!-- 方式一：Vue Query useQuery（最推荐：声明式、自执行、全自动状态） -->
    <view class="rounded-[10px] p-[12px] mb-[14px] border-[1px] border-solid border-[#e2e8f0]">
      <view class="flex-row justify-between items-center mb-[8px]">
        <text class="text-[13px] font-bold text-[#334155]">方式一：useQuery（声明式自执行）</text>
        <view class="px-[8px] py-[2px] rounded-[10px]" :class="queryBadgeBg">
          <text class="text-[11px]" :class="queryBadgeTextClass">{{ queryBadgeText }}</text>
        </view>
      </view>
      <text class="text-[11px] text-[#64748b] leading-[16px] mb-[8px]">
        代码只需声明 useQuery，无需写 onLoad 或 onMounted，页面一打开自动发起，自带 loading、error、cache。
      </text>

      <!-- 数据或加载状态展示 -->
      <view v-if="autoQuery.isLoading.value" class="py-[8px] flex-row items-center justify-center">
        <text class="text-[12px] text-[#0284c7]">自动拉取中，正在请求后端数据...</text>
      </view>
      <view v-else-if="autoQuery.isError.value" class="py-[8px]">
        <text class="text-[12px] text-[#ef4444]">拉取失败：{{ autoQuery.error.value?.message }}</text>
      </view>
      <view v-else-if="autoQuery.data.value != null" class="py-[4px]">
        <text class="text-[12px] text-[#166534] mb-[4px]">拉取成功（共 {{ autoQuery.data.value?.total }} 条）：</text>
        <view
          v-for="(item, idx) in autoQuery.data.value?.list"
          :key="idx"
          class="flex-row justify-between py-[4px] border-b-[1px] border-solid border-[#f1f5f9]"
        >
          <text class="text-[12px] text-[#334155]">{{ item.name }}</text>
          <text class="text-[11px] text-[#94a3b8]">ID: {{ item.id }}</text>
        </view>
      </view>

      <view class="mt-[8px] flex-row justify-end">
        <view
          class="bg-[#0284c7] rounded-[6px] px-[12px] py-[6px] flex flex-row items-center justify-center"
          @click="handleRefetch"
        >
          <text class="text-[#ffffff] text-[12px]">重新拉取 (refetch)</text>
        </view>
      </view>
    </view>

    <!-- 方式二：标准生命周期（onMounted / onLoad + http.get） -->
    <view class="rounded-[10px] p-[12px] border-[1px] border-solid border-[#e2e8f0]">
      <view class="flex-row justify-between items-center mb-[8px]">
        <text class="text-[13px] font-bold text-[#334155]">方式二：onMounted + http.get（传统命令式）</text>
        <view class="px-[8px] py-[2px] rounded-[10px]" :class="manualBadgeBg">
          <text class="text-[11px]" :class="manualBadgeTextClass">{{ manualBadgeText }}</text>
        </view>
      </view>
      <text class="text-[11px] text-[#64748b] leading-[16px] mb-[8px]">
        在 onMounted 挂载后手动触发异步函数并维护 loading 状态。
      </text>

      <view v-if="manualLoading" class="py-[8px] flex-row items-center justify-center">
        <text class="text-[12px] text-[#d97706]">手动请求中...</text>
      </view>
      <view v-else class="py-[4px]">
        <text class="text-[12px] text-[#475569]">{{ manualResultText }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed, onMounted, ref } from 'vue';
import { fetchFooList } from '@/src/api/example.uts';
import type { FooItem, PageResult } from '@/src/api/example.uts';
import { useQuery } from '@/src/http/request/hooks/index.uts';
import type { QueryFunctionContext, QueryOptions } from '@/src/http/request/hooks/index.uts';

// =========================================================================
// 方式一：Vue Query useQuery（声明式、进入页面自动执行、免手动管理生命周期）
// =========================================================================
const autoQuery = useQuery<PageResult<FooItem>>({
  queryKey: ['pageInitAutoQuery'],
  queryFn: (_ctx: QueryFunctionContext): Promise<PageResult<FooItem>> => {
    return fetchFooList(1, 3, 'auto');
  },
  // 默认 enabled 就是 true，无需手动触发，页面打开自动发起！
  staleTime: 60 * 1000
} as QueryOptions<PageResult<FooItem>>);

// ✅ script 里面拿
console.log(autoQuery.data); // 接口返回结果
console.log(autoQuery.isLoading); // 是否加载中（首次请求）
console.log(autoQuery.isError); // 是否报错
console.log(autoQuery.error); // 错误信息

const queryBadgeText = computed((): string => {
  if (autoQuery.isLoading.value)
    return '加载中';
  if (autoQuery.isError.value)
    return '失败';
  if (autoQuery.isSuccess.value)
    return '完成';
  return '就绪';
});

const queryBadgeTextClass = computed((): string => {
  if (autoQuery.isLoading.value)
    return 'text-[#0284c7]';
  if (autoQuery.isError.value)
    return 'text-[#dc2626]';
  if (autoQuery.isSuccess.value)
    return 'text-[#16a34a]';
  return 'text-[#64748b]';
});

const queryBadgeBg = computed((): string => {
  if (autoQuery.isLoading.value)
    return 'bg-[#e0f2fe]';
  if (autoQuery.isError.value)
    return 'bg-[#fee2e2]';
  if (autoQuery.isSuccess.value)
    return 'bg-[#dcfce7]';
  return 'bg-[#f1f5f9]';
});

function handleRefetch(): void {
  autoQuery.refetch();
}

// =========================================================================
// 方式二：标准生命周期 onMounted / onLoad（传统手动写法）
// =========================================================================
const manualLoading = ref<boolean>(false);
const manualResultText = ref<string>('等待生命周期触发');

onMounted(() => {
  manualLoading.value = true;
  fetchFooList(1, 2, 'lifecycle').then(
    (res: PageResult<FooItem>) => {
      manualResultText.value = `生命周期拉取成功：共 ${res.total} 条`;
    },
    (err: any) => {
      manualResultText.value = `生命周期拉取失败：${err}`;
    }
  ).finally(() => {
    manualLoading.value = false;
  });
});

const manualBadgeText = computed((): string => {
  if (manualLoading.value)
    return '加载中';
  return '已完成';
});

const manualBadgeTextClass = computed((): string => {
  if (manualLoading.value)
    return 'text-[#d97706]';
  return 'text-[#16a34a]';
});

const manualBadgeBg = computed((): string => {
  if (manualLoading.value)
    return 'bg-[#fef3c7]';
  return 'bg-[#dcfce7]';
});
</script>
