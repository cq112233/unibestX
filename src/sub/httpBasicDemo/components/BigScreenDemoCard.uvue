<template>
  <!-- ============ 4. 大屏 / 副业务接口（secondaryHttp + useQuery / useMutation） ============ -->
  <view class="rounded-[16px] p-[20px] m-[16px] border-[1px] border-solid border-[#edf2f7] bg-[#ffffff]">
    <!-- 标题区域 -->
    <view class="flex flex-row items-center mb-[16px]">
      <view class="w-[4px] h-[16px] rounded-[2px] mr-[8px] bg-[#6366f1]" />
      <text class="text-[16px] font-bold text-[#2d3748]">大屏与副业务请求 (secondaryHttp)</text>
    </view>
    <text class="text-[12px] text-[#64748b] leading-[19px] mb-[12px]">
      基于 useQuery 与 useMutation 声明式状态机调度。GET /api/auth/captcha 走 useQuery 自动加载与缓存，POST /api/auth/login 走 useMutation 状态机变更。
    </text>

    <!-- 1. 验证码区域 (useQuery) -->
    <view class="rounded-[10px] p-[14px] border-[1px] border-solid border-[#e2e8f0] bg-[#f8fafc] mb-[14px]">
      <view class="flex flex-row items-center justify-between mb-[12px]">
        <view class="flex-row items-center">
          <text class="text-[13px] font-bold text-[#334155] mr-[6px]">1. 验证码查询 (useQuery)</text>
          <view class="px-[6px] py-[1px] rounded-[4px] bg-[#ede9fe]">
            <text class="text-[11px] font-medium text-[#7c3aed]">{{ captchaQuery.status.value }}</text>
          </view>
        </view>
        <view
          class="px-[12px] py-[6px] rounded-[6px] bg-[#6366f1] flex flex-row items-center"
          @click="handleRefetchCaptcha"
        >
          <text class="text-[12px] text-[#ffffff] font-medium">{{ captchaQuery.isFetching.value ? '拉取中...' : '刷新验证码' }}</text>
        </view>
      </view>

      <!-- 验证码图形渲染 -->
      <view class="w-full flex flex-col items-center justify-center p-[12px] bg-[#ffffff] rounded-[8px] border-[1px] border-solid border-[#cbd5e1] mb-[12px]">
        <view v-if="(captchaQuery.data.value?.captchaImage ?? '').length > 0" class="w-full flex flex-col items-center">
          <MpHtml :content="captchaQuery.data.value?.captchaImage ?? ''" />
        </view>
        <view v-else class="py-[16px]">
          <text class="text-[13px] text-[#94a3b8]">{{ captchaQuery.isFetching.value ? '正在加载验证码图形...' : '暂无数据，请点击上方刷新' }}</text>
        </view>
      </view>

      <!-- 字段信息 -->
      <view class="bg-[#ffffff] rounded-[8px] p-[10px] border-[1px] border-solid border-[#e2e8f0]">
        <view class="flex flex-row items-center justify-between mb-[6px]">
          <text class="text-[12px] text-[#64748b]">captchaId:</text>
          <text class="text-[12px] text-[#0f172a]">{{ captchaQuery.data.value?.captchaId ?? '-' }}</text>
        </view>
        <view class="flex flex-row items-center justify-between mb-[6px]">
          <text class="text-[12px] text-[#64748b]">captchaCode:</text>
          <view class="px-[6px] py-[1px] rounded-[4px] bg-[#e0e7ff]">
            <text class="text-[12px] font-bold text-[#4338ca]">{{ captchaQuery.data.value?.captchaCode ?? '-' }}</text>
          </view>
        </view>
        <view class="flex flex-row items-center justify-between">
          <text class="text-[12px] text-[#64748b]">isFetching / isSuccess:</text>
          <text class="text-[12px] text-[#10b981] font-medium">{{ captchaQuery.isFetching.value ? 'true' : 'false' }} / {{ captchaQuery.isSuccess.value ? 'true' : 'false' }}</text>
        </view>
      </view>
    </view>

    <!-- 2. 用户登录区域 (useMutation) -->
    <view class="rounded-[10px] p-[14px] border-[1px] border-solid border-[#e2e8f0] bg-[#f8fafc]">
      <view class="flex flex-row items-center justify-between mb-[12px]">
        <view class="flex-row items-center">
          <text class="text-[13px] font-bold text-[#334155] mr-[6px]">2. 用户登录变更 (useMutation)</text>
          <view class="px-[6px] py-[1px] rounded-[4px] bg-[#e0e7ff]">
            <text class="text-[11px] font-medium text-[#4338ca]">{{ status }}</text>
          </view>
        </view>
      </view>

      <!-- 表单输入项 -->
      <view class="mb-[8px]">
        <text class="text-[12px] text-[#475569] mb-[4px]">用户名 (username)</text>
        <input
          v-model="loginUsername"
          placeholder="请输入用户名/邮箱"
          class="h-[38px] bg-white rounded-[6px] px-[12px] border-[1px] border-solid border-[#cbd5e1] text-[13px] text-[#334155]"
        />
      </view>

      <view class="mb-[8px]">
        <text class="text-[12px] text-[#475569] mb-[4px]">密码 (password / hash)</text>
        <input
          v-model="loginPassword"
          placeholder="请输入密码或SHA-256密文"
          class="h-[38px] bg-white rounded-[6px] px-[12px] border-[1px] border-solid border-[#cbd5e1] text-[13px] text-[#334155]"
        />
      </view>

      <view class="mb-[12px]">
        <text class="text-[12px] text-[#475569] mb-[4px]">验证码 (captchaCode)</text>
        <input
          v-model="loginCaptchaCode"
          placeholder="请输入图形中的验证码"
          class="h-[38px] bg-white rounded-[6px] px-[12px] border-[1px] border-solid border-[#cbd5e1] text-[13px] text-[#334155]"
        />
      </view>

      <!-- 登录按钮 -->
      <view
        class="rounded-[8px] h-[40px] w-full flex flex-row items-center justify-center bg-[#6366f1] mb-[12px]"
        @click="handleLogin"
      >
        <text class="text-[#ffffff] text-[14px] font-medium">{{ isPending ? '正在提交登录 (isPending)...' : '立即登录 (mutate)' }}</text>
      </view>

      <!-- 登录结果展示 -->
      <view v-if="data != null" class="bg-[#ffffff] rounded-[8px] p-[10px] border-[1px] border-solid border-[#a7f3d0]">
        <view class="flex flex-row items-center mb-[4px]">
          <view class="w-[6px] h-[6px] rounded-full bg-[#10b981] mr-[6px]" />
          <text class="text-[12px] font-bold text-[#065f46]">登录成功！</text>
        </view>
        <view class="flex flex-row items-center justify-between mb-[4px]">
          <text class="text-[11px] text-[#64748b]">Access Token:</text>
          <text class="text-[11px] text-[#0f172a]">{{ (data?.access_token ?? '').substring(0, 20) }}...</text>
        </view>
        <view v-if="(data?.user.username ?? '').length > 0" class="flex flex-row items-center justify-between">
          <text class="text-[11px] text-[#64748b]">用户:</text>
          <text class="text-[11px] text-[#0f172a]">{{ data?.user.username }}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, watch } from 'vue';
import MpHtml from '@/uni_modules/mp-html/components/mp-html/mp-html.uvue';
import { HttpError, useMutation, useQuery } from '@/uni_modules/request-bestX/index.uts';
import type { MutationOptions, QueryOptions } from '@/uni_modules/request-bestX/index.uts';
import { fetchBigScreenData, loginBigScreen } from '@/src/api/bigScreen/bigScreen.uts';
import type { CaptchaResult, LoginParams, LoginResult } from '@/src/api/bigScreen/bigScreen.uts';

// 登录表单
const loginUsername = ref<string>('chenqi8186358@gmail.com');
const loginPassword = ref<string>('2bb9e1528737434e711ea0580ee0b28e5ba92b07a35b7d862cfdc99ce2d8df65111');
const loginCaptchaCode = ref<string>('');

// ==========================================
// 1. useQuery: 声明式验证码查询状态机
// ==========================================
const captchaQuery = useQuery<CaptchaResult>({
  queryKey: ['bigScreen', 'captcha'],
  queryFn: (): Promise<CaptchaResult> => {
    return fetchBigScreenData();
  }
} as QueryOptions<CaptchaResult>);

// 监听到新验证码到达时，自动同步填充输入框
watch(captchaQuery.data, (newData: CaptchaResult | null): void => {
  if (newData != null) {
    loginCaptchaCode.value = newData.captchaCode;
  }
});

function handleRefetchCaptcha(): void {
  captchaQuery.refetch();
}

// ==========================================
// 2. useMutation: 声明式登录变更状态机
// ==========================================
const { isPending, status, data, mutate } = useMutation<LoginResult, LoginParams>({
  mutationKey: ['bigScreen', 'login'],
  mutationFn: (variables: LoginParams): Promise<LoginResult> => {
    return loginBigScreen(variables);
  },
  onSuccess(_data) {
    // console.log(data, 'data');
    uni.showToast({ title: '登录成功！', icon: 'success' });
  },
  onError(err) {
    console.log(err.message, 'err message');
    if (err instanceof HttpError) {
      const httpErr = err as HttpError;
      console.log(httpErr.data, '完整错误响应数据 (err.data)');
      console.log(httpErr.statusCode, '错误状态码 (err.statusCode)');
    }
    // 登录失败后自动刷新图形验证码
    captchaQuery.refetch();
  }
} as MutationOptions<LoginResult, LoginParams>);

function handleLogin(): void {
  const currentCaptchaId = captchaQuery.data.value?.captchaId ?? '';
  if (currentCaptchaId.length == 0) {
    uni.showToast({ title: '请等待验证码加载完成', icon: 'none' });
    return;
  }
  if (loginUsername.value.trim().length == 0) {
    uni.showToast({ title: '请输入用户名', icon: 'none' });
    return;
  }
  if (loginPassword.value.trim().length == 0) {
    uni.showToast({ title: '请输入密码', icon: 'none' });
    return;
  }
  if (loginCaptchaCode.value.trim().length == 0) {
    uni.showToast({ title: '请输入验证码', icon: 'none' });
    return;
  }

  const params: LoginParams = {
    username: loginUsername.value.trim(),
    password: loginPassword.value.trim(),
    captchaId: currentCaptchaId,
    captchaCode: loginCaptchaCode.value.trim()
  };

  // 通过 mutate 触发变更
  mutate(params);

  console.log(data.value, 'data');
}
</script>
