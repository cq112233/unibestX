<template>
  <!-- ============ 1. 真实请求（CRUD 增删改查） ============ -->
  <view
    class="rounded-[16px] p-[20px] my-[16px] border-[1px] border-solid border-[#edf2f7] bg-[#ffffff]"
  >
    <!-- 标题区域 -->
    <view class="flex flex-row items-center mb-[16px]">
      <view class="w-[4px] h-[16px] rounded-[2px] mr-[8px] bg-[#06b6d4]" />
      <text class="text-[16px] font-bold text-[#2d3748]">真实请求（CRUD 增删改查）</text>
    </view>
    <text class="text-[12px] text-[#64748b] leading-[19px] mb-[4px]">
      由 src/api/example.uts 打 mockapi.io 的 /test 资源（地址写死在该文件的 FOO_BASE_URL）：列表与详情走 useQuery 自动加载与缓存，增删改走 useMutation 状态机，成功后自动重拉列表。五个动词都真实发出并落库持久化。
    </text>

    <!-- 2.1 表单区：新增与编辑共用一套输入框，crudEditingId > 0 即编辑态 -->
    <view class="rounded-[10px] p-[12px] mt-[12px] border-[1px] border-solid border-[#e2e8f0]">
      <view class="flex-row items-center justify-between mb-[8px]">
        <text class="text-[13px] text-[#64748b]">{{ crudFormTitle }}</text>
        <view class="px-[8px] py-[2px] rounded-[10px]" :class="crudFormModeBgClass">
          <text class="text-[12px]" :class="crudFormModeTextClass">{{ crudFormModeText }}</text>
        </view>
      </view>
      <input
        v-model="crudName"
        placeholder="name，例如 He was an expert"
        class="h-[38px] bg-white rounded-[6px] px-[12px] border-[1px] border-solid border-[#cbd5e1] text-[13px] text-[#334155] mb-[8px]"
      />
      <input
        v-model="crudDesc"
        placeholder="desc，例如 一段正文……"
        class="h-[38px] bg-white rounded-[6px] px-[12px] border-[1px] border-solid border-[#cbd5e1] text-[13px] text-[#334155] mb-[10px]"
      />
      <!-- 操作按钮：用 margin-right 代替 gap -->
      <view class="flex-row">
        <view :class="crudSubmitWrapClass">
          <view
            class="rounded-[8px] h-[42px] w-full flex flex-row items-center justify-center"
            :class="crudSubmitBgClass"
            @click="submitCrud"
          >
            <text class="text-[#ffffff] text-[14px]">{{ crudSubmitText }}</text>
          </view>
        </view>
        <view v-if="crudEditing" class="flex-1">
          <view
            class="bg-[#94a3b8] rounded-[8px] h-[42px] w-full flex flex-row items-center justify-center"
            @click="cancelCrudEdit"
          >
            <text class="text-[#ffffff] text-[14px]">取消编辑</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 2.2 数据列表：每行挂「详情 / 编辑 / 删除」三个操作 -->
    <view class="mt-[12px]">
      <!-- 窄屏（375）下标题 + 状态 + 条数 + 按钮一行放不下，会把「重置」挤没，故拆成两行 -->
      <view class="flex-row items-center justify-between mb-[6px]">
        <text class="text-[13px] text-[#64748b]">最近 2 条（useQuery · GET /test）</text>
        <view class="px-[6px] py-[2px] rounded-[4px] ml-[8px]" :class="crudListStatusBgClass">
          <text class="text-[10px] font-medium" :class="crudListStatusTextClass">{{ crudListStatusText }}</text>
        </view>
      </view>
      <view class="flex-row items-center justify-between mb-[8px]">
        <text class="text-[12px] text-[#94a3b8]">{{ crudListCountText }}</text>
        <view class="px-[10px] py-[4px] rounded-[4px] bg-[#0ea5e9] flex-row items-center" @click="resetCrudDemo">
          <text class="text-[11px] text-[#ffffff] font-medium">{{ crudLoading ? '加载中…' : '重置' }}</text>
        </view>
      </view>

      <text v-if="crudList.length == 0" class="text-[12px] text-[#94a3b8]">暂无数据，可在上方表单新增一条</text>
      <view
        v-for="item in crudList"
        :key="item.id"
        class="flex-row items-center py-[10px] px-[10px] bg-[#f8fafc] rounded-[8px] mb-[8px]"
      >
        <view class="flex-1 mr-[8px]">
          <view class="flex-row items-center">
            <text class="text-[13px] font-bold text-[#334155]">{{ item.name }}</text>
            <text class="text-[11px] text-[#94a3b8] ml-[6px]">#{{ item.id }}</text>
            <text v-if="item.id == crudEditingId" class="text-[10px] text-[#0ea5e9] ml-[6px]">编辑中</text>
          </view>
          <text class="text-[11px] text-[#64748b] mt-[2px]">{{ crudDescPreview(item.desc) }}</text>
        </view>
        <view class="flex-row items-center">
          <view class="px-[8px] py-[4px] rounded-[4px] bg-[#e0e7ff] mr-[6px]" @click="loadCrudDetail(item)">
            <text class="text-[11px] text-[#4338ca]">详情</text>
          </view>
          <view class="px-[8px] py-[4px] rounded-[4px] bg-[#dbeafe] mr-[6px]" @click="startCrudEdit(item)">
            <text class="text-[11px] text-[#1d4ed8]">编辑</text>
          </view>
          <view class="px-[8px] py-[4px] rounded-[4px] bg-[#fee2e2]" @click="removeCrud(item)">
            <text class="text-[11px] text-[#b91c1c]">删除</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 2.3 详情结果面板（GET /test/:id） -->
    <view
      v-if="hasCrudDetail"
      class="mt-[12px] rounded-[8px] bg-[#f8fafc] border-[1px] border-solid border-[#cbd5e1] overflow-hidden"
    >
      <view class="h-[3px] bg-[#6366f1]" />
      <view class="p-[12px]">
        <view class="flex-row items-center justify-between mb-[6px]">
          <text class="text-[11px] text-[#64748b]">详情结果</text>
          <text class="text-[10px] text-[#94a3b8]">GET /test/:id</text>
        </view>
        <text class="text-[12px] text-[#334155] leading-[20px]">{{ crudDetailText }}</text>
      </view>
    </view>

    <!-- 2.4 失败兜底：http 拦截器已统一 toast，这里只留卡片内的一行提示 -->
    <view
      v-if="hasCrudError"
      class="mt-[10px] bg-[#fff5f5] rounded-[8px] p-[10px] border-[1px] border-solid border-[#fecaca]"
    >
      <text class="text-[12px] text-[#ef4444]">{{ crudErrorText }}</text>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed, ref } from 'vue';
import { createFooApi, deleteFooApi, fetchFooByIdApi, fetchFooLatestApi, updateFooApi } from '@/src/api/example.uts';
import type { FooItem, PageResult } from '@/src/api/example.uts';
import { useMutation, useQuery } from '@/uni_modules/request-bestX/index.uts';
import type { MutationOptions, QueryFunctionContext, QueryOptions } from '@/uni_modules/request-bestX/index.uts';
import { toast, toastSuccess } from '@/src/utils/toast/index.uts';

// ==========================================
// 1. 表单状态
// ==========================================

const crudName = ref<string>('');
const crudDesc = ref<string>('');
const crudEditingId = ref<number>(0);
/** 详情查询的目标 id：0 表示不查询（配合 useQuery 的 enabled 依赖） */
const crudDetailId = ref<number>(0);
/** 仅承载 mutation 的本地错误文案；查询错误直接读 query.error */
const crudError = ref<string>('');

function resetCrudForm(): void {
  crudEditingId.value = 0;
  crudName.value = '';
  crudDesc.value = '';
}

// ==========================================
// 2. useQuery：声明式查询（自动加载 / 缓存 / 响应式 key）
// ==========================================

/**
 * 列表查询：setup 阶段即自动发起（enabled 默认 true），无需 onMounted 手动拉取。
 * 只取**最近新增的 2 条**（服务端按 createdAt 倒序），queryKey 固定，
 * 组件内 refetch() 与 invalidateQueries 都会命中同一份缓存。
 */
const listQuery = useQuery<PageResult<FooItem>>({
  queryKey: ['fooList', 'crudDemo', 'latest2'],
  queryFn: (_ctx: QueryFunctionContext): Promise<PageResult<FooItem>> => {
    return fetchFooLatestApi(2);
  }
} as QueryOptions<PageResult<FooItem>>);

/**
 * 详情查询：queryKey 里放的是 Ref，crudDetailId 一变 useQuery 就自动取消旧请求并重拉；
 * enabled 为 getter，id 归零时不会再发请求（对标 TanStack Query 的 dependent query）。
 *
 * 泛型用 `FooItem` 而不是 `FooItem | null`：`fetchFooByIdApi` 的半包空值在这里转成
 * rejection（「查无数据」走 query.error 展示），避免给 hook 传联合类型实参。
 */
const detailQuery = useQuery<FooItem>({
  queryKey: ['fooDetail', crudDetailId],
  queryFn: (_ctx: QueryFunctionContext): Promise<FooItem> => {
    const targetId = crudDetailId.value;
    return fetchFooByIdApi(targetId).then((detail: FooItem | null): Promise<FooItem> => {
      if (detail == null) {
        return Promise.reject(new Error(`#${targetId} 查无数据`)) as Promise<FooItem>;
      }
      return Promise.resolve(detail);
    });
  },
  enabled: (): boolean => crudDetailId.value > 0
} as QueryOptions<FooItem>);

// ==========================================
// 3. useMutation：声明式变更（isPending / onSuccess / onError）
// ==========================================

/** 新增：成功后清空表单，并把详情查询指向新记录（自动触发详情 useQuery） */
const createMutation = useMutation<FooItem, FooItem>({
  mutationKey: ['crudCreate'],
  mutationFn: (payload: FooItem): Promise<FooItem> => {
    return createFooApi(payload);
  },
  onSuccess: (created: FooItem, _variables: FooItem, _context: any): void => {
    toastSuccess('新增成功');
    resetCrudForm();
    crudDetailId.value = created.id;
    listQuery.refetch();
  },
  onError: (error: Error, _variables: FooItem, _context: any): void => {
    crudError.value = error.message;
  }
} as MutationOptions<FooItem, FooItem>);

/** 编辑保存：成功后退出编辑态并刷新列表 */
const updateMutation = useMutation<FooItem, FooItem>({
  mutationKey: ['crudUpdate'],
  mutationFn: (payload: FooItem): Promise<FooItem> => {
    return updateFooApi(payload.id, payload);
  },
  onSuccess: (updated: FooItem, _variables: FooItem, _context: any): void => {
    toastSuccess('修改成功');
    resetCrudForm();
    crudDetailId.value = updated.id;
    listQuery.refetch();
  },
  onError: (error: Error, _variables: FooItem, _context: any): void => {
    crudError.value = error.message;
  }
} as MutationOptions<FooItem, FooItem>);

/** 删除：成功后清掉编辑/详情状态并刷新列表 */
const deleteMutation = useMutation<boolean, FooItem>({
  mutationKey: ['crudDelete'],
  mutationFn: (item: FooItem): Promise<boolean> => {
    return deleteFooApi(item.id);
  },
  onSuccess: (_deleted: boolean, _variables: FooItem, _context: any): void => {
    toastSuccess('已删除');
    resetCrudForm();
    crudDetailId.value = 0;
    listQuery.refetch();
  },
  onError: (error: Error, _variables: FooItem, _context: any): void => {
    crudError.value = error.message;
  }
} as MutationOptions<boolean, FooItem>);

// ==========================================
// 4. 派生状态（全部从 hook 的响应式字段计算，不再手写 loading 开关）
// ==========================================

const crudList = computed((): Array<FooItem> => {
  const data = listQuery.data.value;
  if (data == null) {
    return [] as Array<FooItem>;
  }
  return data.list;
});

const crudLoading = computed((): boolean => {
  return listQuery.isFetching.value == true;
});

const crudSubmitting = computed((): boolean => {
  return createMutation.isPending.value == true || updateMutation.isPending.value == true || deleteMutation.isPending.value == true;
});

const crudEditing = computed((): boolean => {
  return crudEditingId.value > 0;
});

const crudFormTitle = computed((): string => {
  if (crudEditing.value) {
    return `编辑 #${crudEditingId.value}（PUT /test/:id）`;
  }
  return '新增一条（POST /test）';
});

const crudFormModeText = computed((): string => {
  if (crudEditing.value) {
    return '编辑态';
  }
  return '新增态';
});

const crudFormModeBgClass = computed((): string => {
  if (crudEditing.value) {
    return 'bg-[#dbeafe]';
  }
  return 'bg-[#e0f2fe]';
});

const crudFormModeTextClass = computed((): string => {
  if (crudEditing.value) {
    return 'text-[#1d4ed8]';
  }
  return 'text-[#0369a1]';
});

const crudSubmitWrapClass = computed((): string => {
  if (crudEditing.value) {
    return 'flex-1 mr-[10px]';
  }
  return 'w-full';
});

const crudSubmitBgClass = computed((): string => {
  if (crudEditing.value) {
    return 'bg-[#2563eb]';
  }
  return 'bg-[#0284c7]';
});

const crudSubmitText = computed((): string => {
  if (crudSubmitting.value) {
    return '提交中...';
  }
  if (crudEditing.value) {
    return '保存修改';
  }
  return '新增';
});

const crudListCountText = computed((): string => {
  const data = listQuery.data.value;
  if (data == null) {
    return '—';
  }
  return `共 ${data.total} 条`;
});

const crudListStatusText = computed((): string => {
  if (listQuery.isError.value == true) {
    return 'error';
  }
  if (listQuery.isFetching.value == true) {
    return 'fetching';
  }
  if (listQuery.data.value != null) {
    return 'success';
  }
  return 'pending';
});

const crudListStatusBgClass = computed((): string => {
  if (listQuery.isError.value == true) {
    return 'bg-[#fee2e2]';
  }
  if (listQuery.isFetching.value == true) {
    return 'bg-[#dbeafe]';
  }
  if (listQuery.data.value != null) {
    return 'bg-[#d1fae5]';
  }
  return 'bg-[#f1f5f9]';
});

const crudListStatusTextClass = computed((): string => {
  if (listQuery.isError.value == true) {
    return 'text-[#dc2626]';
  }
  if (listQuery.isFetching.value == true) {
    return 'text-[#2563eb]';
  }
  if (listQuery.data.value != null) {
    return 'text-[#059669]';
  }
  return 'text-[#94a3b8]';
});

/** 详情面板文案：直接由 detailQuery 的状态驱动（加载中 / 查无 / 详情） */
const crudDetailText = computed((): string => {
  const targetId = crudDetailId.value;
  if (targetId <= 0) {
    return '';
  }
  if (detailQuery.isError.value == true) {
    return '';
  }
  if (detailQuery.isFetching.value == true) {
    return `正在查询 #${targetId}…`;
  }
  const detail = detailQuery.data.value;
  if (detail == null) {
    return `#${targetId} 查无数据`;
  }
  return `id: ${detail.id} · name: ${detail.name} · desc: ${detail.desc}`;
});

const hasCrudDetail = computed((): boolean => {
  return crudDetailText.value.length > 0;
});

/** 错误提示：mutation 的本地文案优先，其次取两个 query 的 error */
const crudErrorText = computed((): string => {
  if (crudError.value.length > 0) {
    return crudError.value;
  }
  const listError = listQuery.lastError.value;
  if (listError != null) {
    return listError.message;
  }
  const detailError = detailQuery.lastError.value;
  if (detailError != null) {
    return detailError.message;
  }
  return '';
});

const hasCrudError = computed((): boolean => {
  return crudErrorText.value.length > 0;
});

function crudDescPreview(text: string): string {
  if (text.length <= 40) {
    return text;
  }
  return `${text.substring(0, 40)}…`;
}

// ==========================================
// 5. 交互动作：只改状态 / 调 mutate，不再手写请求与 try-catch
// ==========================================

function resetCrudDemo(): void {
  resetCrudForm();
  crudDetailId.value = 0;
  crudError.value = '';
  listQuery.refetch();
}

function removeCrud(item: FooItem): void {
  if (deleteMutation.isPending.value == true) {
    return;
  }
  uni.showModal({
    title: '删除确认',
    content: `确认删除 #${item.id} ${item.name} 吗？此操作不可撤销。`,
    confirmText: '删除',
    cancelText: '取消',
    confirmColor: '#dc2626',
    success: (modalRes) => {
      if (modalRes.confirm == true) {
        deleteMutation.mutate(item);
      }
    }
  });
}

/** 点击「详情」只改 crudDetailId，请求由 detailQuery 自己发起 */
function loadCrudDetail(item: FooItem): void {
  crudError.value = '';
  if (crudDetailId.value == item.id) {
    detailQuery.refetch();
  }
  else {
    crudDetailId.value = item.id;
  }
}

function startCrudEdit(item: FooItem): void {
  crudEditingId.value = item.id;
  crudName.value = item.name;
  crudDesc.value = item.desc;
  crudError.value = '';
}

function cancelCrudEdit(): void {
  resetCrudForm();
  crudError.value = '';
}

function submitCrud(): void {
  if (crudSubmitting.value == true) {
    return;
  }
  const name = crudName.value.trim();
  const desc = crudDesc.value.trim();
  if (name == '') {
    toast('请先填写 name');
    return;
  }

  crudError.value = '';
  if (crudEditingId.value > 0) {
    updateMutation.mutate({ id: crudEditingId.value, name, desc } as FooItem);
  }
  else {
    createMutation.mutate({ id: 0, name, desc } as FooItem);
  }
}
</script>
