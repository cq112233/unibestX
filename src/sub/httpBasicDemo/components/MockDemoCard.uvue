<template>
  <!-- ============ 5. 本地 Mock 拦截（vite-plugin-mock + useQuery / useMutation） ============ -->
  <view
    class="rounded-[16px] p-[20px] my-[16px] border-[1px] border-solid border-[#edf2f7] bg-[#ffffff]"
  >
    <!-- 标题区域 -->
    <view class="flex flex-row items-center mb-[12px]">
      <view class="w-[4px] h-[16px] rounded-[2px] mr-[8px] bg-[#f43f5e]" />
      <text class="text-[16px] font-bold text-[#2d3748]">本地 Mock 拦截</text>
      <view class="ml-[8px] px-[6px] py-[2px] rounded-[4px] bg-[#fdf2f8] border-[1px] border-solid border-[#fbcfe8]">
        <text class="text-[10px] font-bold text-[#db2777]">vite-plugin-mock</text>
      </view>
    </view>
    <text class="text-[12px] text-[#64748b] leading-[19px] mb-[12px]">
      以 pnpm dev:mock 启动后，下面两个相对路径请求会被 Vite 中间件直接拦截、秒回挡板数据，完全不需要后端。列表走 useQuery 手动触发，登录走 useMutation 状态机。
    </text>

    <!-- 提示条 -->
    <view class="flex-row items-center bg-[#fdf2f8] p-[8px] rounded-[6px] mb-[12px] border-[1px] border-solid border-[#fce7f3]">
      <text class="text-[11px] text-[#be123c] leading-[16px] flex-1">
        💡 普通 dev 模式下这两个请求会打到 VITE_SERVER_BASEURL 指向的真实开发服务器；联调 Mock 请运行 pnpm dev:mock（VITE_USE_MOCK=true + VITE_H5_USE_PROXY=true）。路由定义见 mock/foo.ts 与 mock/auth.ts。
      </text>
    </view>

    <!-- 1. useQuery：Mock 列表 (GET /api/foo) -->
    <view class="rounded-[10px] p-[12px] mb-[12px] border-[1px] border-solid border-[#e2e8f0] bg-[#f8fafc]">
      <view class="flex-row items-center justify-between mb-[8px]">
        <text class="text-[13px] font-bold text-[#334155]">1. Mock 列表（useQuery）</text>
        <view class="px-[6px] py-[2px] rounded-[4px]" :class="listStatusBgClass">
          <text class="text-[10px] font-medium" :class="listStatusTextClass">{{ listStatusText }}</text>
        </view>
      </view>
      <text v-if="listSummary != ''" class="text-[12px] text-[#475569] leading-[18px] mb-[8px]">{{ listSummary }}</text>
      <view
        class="rounded-[8px] h-[38px] w-full flex flex-row items-center justify-center bg-[#ec4899]"
        @click="requestMockList"
      >
        <text class="text-[#ffffff] text-[13px] font-medium">{{ listQuery.isFetching.value ? '拦截中…' : '请求 Mock 列表（GET /api/foo）' }}</text>
      </view>
    </view>

    <!-- 2. useMutation：Mock 登录 (POST /api/auth/login) -->
    <view class="rounded-[10px] p-[12px] border-[1px] border-solid border-[#e2e8f0] bg-[#f8fafc]">
      <view class="flex-row items-center justify-between mb-[8px]">
        <text class="text-[13px] font-bold text-[#334155]">2. Mock 登录（useMutation）</text>
        <view class="px-[6px] py-[2px] rounded-[4px]" :class="loginStatusBgClass">
          <text class="text-[10px] font-medium" :class="loginStatusTextClass">{{ loginStatusText }}</text>
        </view>
      </view>

      <view class="flex-row items-center mb-[8px]">
        <input
          v-model="mockUsername"
          placeholder="用户名（admin）"
          class="h-[36px] flex-1 mr-[8px] bg-white rounded-[6px] px-[10px] border-[1px] border-solid border-[#cbd5e1] text-[12px] text-[#334155]"
        />
        <input
          v-model="mockPassword"
          placeholder="密码（123456 / admin）"
          class="h-[36px] flex-1 bg-white rounded-[6px] px-[10px] border-[1px] border-solid border-[#cbd5e1] text-[12px] text-[#334155]"
        />
      </view>

      <view
        class="rounded-[8px] h-[38px] w-full flex flex-row items-center justify-center bg-[#6366f1] mb-[8px]"
        @click="submitMockLogin"
      >
        <text class="text-[#ffffff] text-[13px] font-medium">{{ loginMutation.isPending.value ? '登录中…' : 'Mock 登录（POST /api/auth/login）' }}</text>
      </view>

      <view v-if="loginSummary != ''" class="rounded-[8px] bg-[#ffffff] p-[10px] border-[1px] border-solid border-[#e2e8f0]">
        <text class="text-[11px] text-[#334155] leading-[18px]">{{ loginSummary }}</text>
      </view>
    </view>

    <!-- 3. OpenAPI 契约接口：留样记录菜品明细 (POST /gateway/foodSampleReport/dishDetail) -->
    <view class="rounded-[10px] p-[12px] mt-[12px] border-[1px] border-solid border-[#e2e8f0] bg-[#f8fafc]">
      <view class="flex-row items-center justify-between mb-[8px]">
        <text class="text-[13px] font-bold text-[#334155]">3. OpenAPI 生成接口 Mock</text>
        <view class="px-[6px] py-[2px] rounded-[4px]" :class="dishStatusBgClass">
          <text class="text-[10px] font-medium" :class="dishStatusTextClass">{{ dishStatusText }}</text>
        </view>
      </view>

      <view class="mb-[8px]">
        <text class="text-[11px] text-[#64748b] leading-[17px]">
          调用由 OpenAPI 规范自动生成的 foodSampleReportDishDetailUsingPost() 强类型接口，走本地契约挡板 Mock 拦截。
        </text>
      </view>

      <view
        class="rounded-[8px] h-[38px] w-full flex flex-row items-center justify-center bg-[#0284c7] mb-[8px]"
        @click="requestDishDetail"
      >
        <text class="text-[#ffffff] text-[13px] font-medium">{{ isDishLoading ? '请求中…' : '请求留样明细（POST /gateway/foodSampleReport/dishDetail）' }}</text>
      </view>

      <view v-if="dishSummary != ''" class="rounded-[8px] bg-[#ffffff] p-[10px] border-[1px] border-solid border-[#e2e8f0]">
        <text class="text-[11px] text-[#0369a1] leading-[18px]">{{ dishSummary }}</text>
      </view>
    </view>

    <!-- 失败兜底：拦截未命中 / 真实服务器报错都在这里提示 -->
    <view
      v-if="hasMockError"
      class="mt-[10px] bg-[#fff5f5] rounded-[8px] p-[10px] border-[1px] border-solid border-[#fecaca]"
    >
      <text class="text-[12px] text-[#ef4444] leading-[18px]">{{ mockErrorText }}</text>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed, ref } from 'vue';
import { fetchMockFooList, fetchMockLogin } from '@/src/api/example.uts';
import type { FooItem, MockLoginParams, MockLoginResult, PageResult } from '@/src/api/example.uts';
import { foodSampleReportDishDetailUsingPost } from '@/src/api/generated/index.uts';
import type { FoodSampleReportDishDetailUsingPostBody, FoodSampleReportDishDetailUsingPostResponse } from '@/src/api/generated/index.uts';
import { useMutation, useQuery } from '@/uni_modules/request-bestX/index.uts';
import type { MutationOptions, QueryFunctionContext, QueryOptions } from '@/uni_modules/request-bestX/index.uts';

const mockUsername = ref<string>('admin');
const mockPassword = ref<string>('123456');

// ==========================================
// 0. OpenAPI 契约接口：留样记录菜品明细
// ==========================================
const isDishLoading = ref<boolean>(false);
const dishData = ref<UTSJSONObject | null>(null);
const dishErrorMsg = ref<string>('');

// ==========================================
// 1. useQuery：Mock 列表（enabled=false，由按钮手动 refetch）
// ==========================================

/**
 * 演示「手动触发的查询」：默认 `enabled: false`，页面加载时不自动请求；
 * 点击按钮调用 refetch() 才会真正发出请求并走 Mock 拦截。
 */
const listQuery = useQuery<PageResult<FooItem>>({
  queryKey: ['mockFooList', 'demo'],
  queryFn: (_ctx: QueryFunctionContext): Promise<PageResult<FooItem>> => {
    return fetchMockFooList();
  },
  enabled: false
} as QueryOptions<PageResult<FooItem>>);

// ==========================================
// 2. useMutation：Mock 登录
// ==========================================

const loginMutation = useMutation<MockLoginResult, MockLoginParams>({
  mutationKey: ['mockLogin'],
  mutationFn: (params: MockLoginParams): Promise<MockLoginResult> => {
    return fetchMockLogin(params.username, params.password);
  }
} as MutationOptions<MockLoginResult, MockLoginParams>);

// ==========================================
// 3. 派生状态
// ==========================================

const listStatusText = computed((): string => {
  if (listQuery.isError.value == true) {
    return 'error';
  }
  if (listQuery.isFetching.value == true) {
    return 'fetching';
  }
  if (listQuery.data.value != null) {
    return 'success';
  }
  return 'idle';
});

const listStatusBgClass = computed((): string => {
  const status = listStatusText.value;
  if (status == 'error') {
    return 'bg-[#fee2e2]';
  }
  if (status == 'fetching') {
    return 'bg-[#dbeafe]';
  }
  if (status == 'success') {
    return 'bg-[#d1fae5]';
  }
  return 'bg-[#f1f5f9]';
});

const listStatusTextClass = computed((): string => {
  const status = listStatusText.value;
  if (status == 'error') {
    return 'text-[#dc2626]';
  }
  if (status == 'fetching') {
    return 'text-[#2563eb]';
  }
  if (status == 'success') {
    return 'text-[#059669]';
  }
  return 'text-[#94a3b8]';
});

const loginStatusText = computed((): string => {
  const status = loginMutation.status.value;
  if (status == 'pending') {
    return 'pending';
  }
  if (status == 'success') {
    return 'success';
  }
  if (status == 'error') {
    return 'error';
  }
  return 'idle';
});

const loginStatusBgClass = computed((): string => {
  const status = loginStatusText.value;
  if (status == 'error') {
    return 'bg-[#fee2e2]';
  }
  if (status == 'pending') {
    return 'bg-[#dbeafe]';
  }
  if (status == 'success') {
    return 'bg-[#d1fae5]';
  }
  return 'bg-[#f1f5f9]';
});

const loginStatusTextClass = computed((): string => {
  const status = loginStatusText.value;
  if (status == 'error') {
    return 'text-[#dc2626]';
  }
  if (status == 'pending') {
    return 'text-[#2563eb]';
  }
  if (status == 'success') {
    return 'text-[#059669]';
  }
  return 'text-[#94a3b8]';
});

/** 列表摘要：把 useQuery.data 映射成一行人类可读文本 */
const listSummary = computed((): string => {
  const data = listQuery.data.value;
  if (data == null) {
    return '';
  }
  let names = '';
  for (let i = 0; i < data.list.length; i++) {
    if (i > 0) {
      names += ' / ';
    }
    names += data.list[i].name;
  }
  return `共 ${data.total} 条 · 前 ${data.list.length} 条：${names}`;
});

/** 登录摘要：把 useMutation.data 映射成一行文本 */
const loginSummary = computed((): string => {
  const data = loginMutation.data.value;
  if (data == null) {
    return '';
  }
  return `登录成功 · ${data.nickname}（${data.username}）· token: ${data.token} · 有效期 ${data.expiresIn}s`;
});

const dishStatusText = computed((): string => {
  if (dishErrorMsg.value != '') {
    return 'error';
  }
  if (isDishLoading.value == true) {
    return 'fetching';
  }
  if (dishData.value != null) {
    return 'success';
  }
  return 'idle';
});

const dishStatusBgClass = computed((): string => {
  const status = dishStatusText.value;
  if (status == 'error') {
    return 'bg-[#fee2e2]';
  }
  if (status == 'fetching') {
    return 'bg-[#dbeafe]';
  }
  if (status == 'success') {
    return 'bg-[#d1fae5]';
  }
  return 'bg-[#f1f5f9]';
});

const dishStatusTextClass = computed((): string => {
  const status = dishStatusText.value;
  if (status == 'error') {
    return 'text-[#dc2626]';
  }
  if (status == 'fetching') {
    return 'text-[#2563eb]';
  }
  if (status == 'success') {
    return 'text-[#059669]';
  }
  return 'text-[#94a3b8]';
});

/** 留样明细摘要：把 foodSampleReportDishDetailUsingPost 返回数据映射成摘要 */
const dishSummary = computed((): string => {
  const raw = dishData.value;
  if (raw == null) {
    return '';
  }
  let list = raw.getArray('data') as UTSJSONObject[] | null;
  if (list == null) {
    const inner = raw.getJSON('data');
    if (inner != null) {
      list = inner.getArray('data') as UTSJSONObject[] | null;
    }
  }
  const items = list ?? ([] as UTSJSONObject[]);
  if (items.length == 0) {
    return '已拦截成功，留样记录暂无菜品明细';
  }
  let details = '';
  for (let i = 0; i < items.length; i++) {
    if (i > 0) {
      details += ' · ';
    }
    const item = items[i];
    const diningHall = item.getString('diningHallName') ?? '';
    const person = item.getString('personName') ?? '';
    const temp = item.getString('temperature') ?? '';
    details += `${diningHall}(${person} ${temp})`;
  }
  return `留样记录获取成功 · 共 ${items.length} 条：${details}`;
});

/** 错误文案：查询错误与 mutation 错误都会展示 */
const mockErrorText = computed((): string => {
  if (dishErrorMsg.value != '') {
    return dishErrorMsg.value;
  }
  const loginError = loginMutation.error.value;
  if (loginError != null) {
    return loginError.message;
  }
  const listError = listQuery.error.value;
  if (listError != null) {
    return `${listError.message}（若非以 pnpm dev:mock 启动，请求会落到真实开发服务器）`;
  }
  return '';
});

const hasMockError = computed((): boolean => {
  return mockErrorText.value.length > 0;
});

// ==========================================
// 4. 交互动作
// ==========================================

function requestMockList(): void {
  // 每次都强制重拉（refetch 会绕过缓存新鲜度判定）
  listQuery.refetch();
}

function submitMockLogin(): void {
  if (loginMutation.isPending.value == true) {
    return;
  }
  loginMutation.mutate({
    username: mockUsername.value.trim(),
    password: mockPassword.value.trim()
  } as MockLoginParams);
}

function requestDishDetail(): void {
  if (isDishLoading.value == true) {
    return;
  }
  isDishLoading.value = true;
  dishErrorMsg.value = '';
  dishData.value = null;

  foodSampleReportDishDetailUsingPost({
    body: {
      recordId: 1001,
      sampled: 1
    } as FoodSampleReportDishDetailUsingPostBody
  })
    .then((res: FoodSampleReportDishDetailUsingPostResponse) => {
      console.log(111, res);
      dishData.value = JSON.parseObject(JSON.stringify(res));
    })
    .catch((err: any) => {
      dishErrorMsg.value = err?.message ?? '请求留样明细失败';
    })
    .finally(() => {
      isDishLoading.value = false;
    });
}
</script>
