<template>
  <!-- ============ 2. 文件上传 ============ -->
  <view
    class="rounded-[16px] p-[20px] my-[16px] border-[1px] border-solid border-[#edf2f7] bg-[#ffffff]"
  >
    <!-- 标题区域 -->
    <view class="flex flex-row items-center mb-[16px]">
      <view
        class="w-[4px] h-[16px] rounded-[2px] mr-[8px] bg-[#3182ce]"
      />
      <text class="text-[16px] font-bold text-[#2d3748]">文件上传（uploadFooFile → http.upload）</text>
    </view>
    <view class="mb-[16px]">
      <view class="flex-row items-center mb-[10px]">
        <view class="w-[32px] h-[32px] rounded-[8px] bg-[#fff7ed] border-[1px] border-solid border-[#fdba74] items-center justify-center mr-[10px]">
          <text class="text-[12px] font-bold text-[#c2410c]">UP</text>
        </view>
        <view class="flex-1">
          <text class="text-[14px] font-bold text-[#1e293b]">文件上传</text>
          <text class="text-[11px] text-[#64748b] mt-[2px]">{{ uploadPath }}</text>
        </view>
      </view>

      <view class="flex-row items-center bg-[#fff7ed] p-[8px] rounded-[6px] mb-[10px] border-[1px] border-solid border-[#ffedd5]">
        <text class="text-[11px] text-[#c2410c] leading-[16px] flex-1">
          💡 默认使用免费临时图床 tmpfiles.org（免注册、无需 Key，文件公开且保留 48 小时）；在 .env 配置 VITE_UPLOAD_BASEURL / VITE_UPLOAD_PATH 后会自动改打你自己的 OSS
        </text>
      </view>

      <view class="rounded-[8px] bg-[#f8fafc] border-[1px] border-solid border-[#cbd5e1] overflow-hidden">
        <view class="h-[3px] bg-[#f97316]" />
        <view class="p-[12px]">
          <view class="flex-row items-center justify-between mb-[8px]">
            <text class="text-[11px] text-[#64748b]">上传结果（useMutation）</text>
            <view class="px-[6px] py-[2px] rounded-[4px]" :class="uploadStatusBgClass">
              <text class="text-[10px] font-medium" :class="uploadStatusTextClass">{{ uploadStatusText }}</text>
            </view>
          </view>
          <text v-if="uploadLoading" class="text-[12px] text-[#c2410c]">正在上传...</text>
          <text v-else-if="hasUploadError" class="text-[12px] text-[#dc2626]">{{ uploadErrorText }}</text>
          <view v-else-if="hasUploadResult">
            <!-- 上：图片居中预览（支持点击放大） -->
            <view
              class="items-center justify-center py-[10px] rounded-[8px] border-[1px] border-solid bg-[#ffffff] border-[#e2e8f0]"
            >
              <image
                :src="uploadResultText"
                class="w-[120px] h-[120px] rounded-[8px]"
                mode="aspectFill"
                @click="previewUploadedImage"
              />
              <text class="text-[10px] text-[#94a3b8] mt-[6px]">点击查看大图</text>
            </view>

            <!-- 下：OSS 链接美化展示卡片（支持一键复制） -->
            <view
              class="mt-[10px] p-[10px] rounded-[8px] border-[1px] border-solid bg-[#f8fafc] border-[#e2e8f0]"
            >
              <view class="flex-row items-center justify-between mb-[6px]">
                <view class="flex-row items-center">
                  <view class="w-[3px] h-[12px] bg-[#f97316] rounded-[2px] mr-[6px]" />
                  <text class="text-[11px] font-bold text-[#475569]">OSS 链接地址</text>
                </view>
                <view
                  class="px-[8px] py-[3px] rounded-[4px] bg-[#ea580c] flex-row items-center"
                  @click="copyUploadUrl"
                >
                  <text class="text-[10px] text-[#ffffff] font-medium">复制链接</text>
                </view>
              </view>
              <text
                class="oss-url-text text-[11px] leading-[18px] text-[#334155]"
                :selectable="true"
              >
                {{ uploadResultText }}
              </text>
            </view>
          </view>
          <text v-else class="text-[12px] text-[#94a3b8]">未选择文件</text>
        </view>
      </view>

      <view class="mt-[10px]">
        <view
          class="bg-[#f97316] rounded-[8px] h-[42px] w-full flex flex-row items-center justify-center"
          @click="chooseAndUpload"
        >
          <text class="text-[#ffffff] text-[14px]">{{ uploadLoading ? '上传中...' : '选择图片并上传' }}</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed, ref } from 'vue';
import { FOO_UPLOAD_PATH, uploadFooFile } from '@/src/api/example.uts';
import { useMutation } from '@/uni_modules/request-bestX/index.uts';
import type { MutationOptions } from '@/uni_modules/request-bestX/index.uts';
import { toastSuccess } from '@/src/utils/toast/index.uts';

/** 上传目标地址（默认免费图床 tmpfiles.org，配置了 .env 后自动改用真实 OSS） */
const uploadPath = ref<string>(FOO_UPLOAD_PATH);

/** 仅在「选图失败」这类本地异常时使用；上传本身的错误由 mutation.error 承载 */
const chooseError = ref<string>('');

// ==========================================
// useMutation：上传是一次性变更，天然适合 mutation 状态机
//   TData     = string（最终可访问的文件 URL）
//   TVariables = string（本地文件路径）
// ==========================================
const uploadMutation = useMutation<string, string>({
  mutationKey: ['demoUpload'],
  mutationFn: (filePath: string): Promise<string> => {
    return uploadFooFile(filePath, true, uploadPath.value);
  },
  onSuccess: (_url: string, _variables: string, _context: any): void => {
    toastSuccess('上传成功');
  }
} as MutationOptions<string, string>);

const uploadLoading = computed((): boolean => {
  return uploadMutation.isPending.value == true;
});

const uploadResult = computed((): string => {
  return uploadMutation.data.value ?? '';
});

const hasUploadResult = computed((): boolean => {
  return uploadResult.value.length > 0;
});

const uploadResultText = computed((): string => {
  return uploadResult.value;
});

/** 错误文案：本地选图错误优先，其次取 mutation 的 error */
const uploadErrorText = computed((): string => {
  if (chooseError.value.length > 0) {
    return chooseError.value;
  }
  const err = uploadMutation.error.value;
  if (err != null) {
    return err.message;
  }
  return '';
});

const hasUploadError = computed((): boolean => {
  return uploadErrorText.value.length > 0;
});

const uploadStatusText = computed((): string => {
  const status = uploadMutation.status.value;
  if (status == 'pending') {
    return 'pending';
  }
  if (status == 'success') {
    return 'success';
  }
  if (status == 'error') {
    return 'error';
  }
  return 'idle';
});

const uploadStatusBgClass = computed((): string => {
  const status = uploadMutation.status.value;
  if (status == 'pending') {
    return 'bg-[#dbeafe]';
  }
  if (status == 'success') {
    return 'bg-[#d1fae5]';
  }
  if (status == 'error') {
    return 'bg-[#fee2e2]';
  }
  return 'bg-[#f1f5f9]';
});

const uploadStatusTextClass = computed((): string => {
  const status = uploadMutation.status.value;
  if (status == 'pending') {
    return 'text-[#2563eb]';
  }
  if (status == 'success') {
    return 'text-[#059669]';
  }
  if (status == 'error') {
    return 'text-[#dc2626]';
  }
  return 'text-[#94a3b8]';
});

function uploadFileByPath(filePath: string): void {
  chooseError.value = '';
  // 重置上一轮的结果/错误，避免上传过程中还显示旧图片
  uploadMutation.reset();
  uploadMutation.mutate(filePath);
}

function chooseAndUpload(): void {
  if (uploadLoading.value) {
    return;
  }
  chooseError.value = '';
  uni.chooseImage({
    count: 1,
    sourceType: ['album', 'camera'],
    success: (res) => {
      const paths = res.tempFilePaths;
      if (paths.length <= 0) {
        chooseError.value = '未选择文件';
        return;
      }
      uploadFileByPath(paths[0] as string);
    },
    fail: (err) => {
      console.log('chooseImage fail:', err);
      let errMsg = '';
      if (err != null && err.errMsg != null) {
        errMsg = `${err.errMsg}`;
      }
      if (errMsg.includes('cancel')) {
        return;
      }
      chooseError.value = errMsg != '' ? `选择文件失败: ${errMsg}` : '选择文件失败';
    }
  });
}

function copyUploadUrl(): void {
  const url = uploadResult.value;
  if (url == '') {
    return;
  }
  uni.setClipboardData({
    data: url,
    showToast: false,
    success: () => {
      toastSuccess('链接已复制');
    }
  });
}

function previewUploadedImage(): void {
  const url = uploadResult.value;
  if (url == '') {
    return;
  }
  uni.previewImage({
    urls: [url]
  });
}
</script>

<style scoped>
/* #ifdef H5 || MP-WEIXIN */
.oss-url-text {
  word-break: break-all;
}
/* #endif */
</style>
