<template>
  <!-- ============ 4. Vue Query 组合式状态机 ============ -->
  <view
    class="rounded-[16px] p-[20px] my-[16px] border-[1px] border-solid border-[#edf2f7] bg-[#ffffff]"
  >
    <!-- 标题区域 -->
    <view class="flex flex-row items-center mb-[16px]">
      <view class="w-[4px] h-[16px] rounded-[2px] mr-[8px] bg-[#8b5cf6]" />
      <text class="text-[16px] font-bold text-[#2d3748]">Vue Query 组合式状态机（TanStack Vue Query）</text>
    </view>
    <text class="text-[12px] text-[#64748b] leading-[18px] mb-[12px]">对标 TanStack Vue Query：包含声明式 useQuery、数据变更 useMutation、QueryClient 全局缓存池与 invalidateQueries 协同失效。</text>

    <!-- 5.1 成功路径：列表接口 -->
    <view class="rounded-[10px] p-[12px] mb-[12px] border-[1px] border-solid border-[#e2e8f0]">
      <view class="flex-row justify-between items-center mb-[6px]">
        <text class="text-[13px] text-[#64748b]">fetchFooListApi（GET /test）</text>
        <view class="px-[8px] py-[2px] rounded-[10px]" :class="listStatusBgClass">
          <text class="text-[12px]" :class="listStatusTextClass">{{ listStatusText }}</text>
        </view>
      </view>
      <text class="text-[12px] text-[#475569]">{{ listDataText }}</text>
      <text class="text-[11px] text-[#94a3b8]">查询已触发 {{ listTick }} 次</text>
    </view>
    <view class="flex-row mb-[12px]">
      <view class="flex-1 mr-[10px]">
        <view
          class="bg-[#8b5cf6] rounded-[8px] h-[42px] w-full flex flex-row items-center justify-center"
          @click="sendListRequest"
        >
          <text class="text-[#ffffff] text-[14px]">refetch()</text>
        </view>
      </view>
      <view class="flex-1 mr-[10px]">
        <view
          class="bg-[#10b981] rounded-[8px] h-[42px] w-full flex flex-row items-center justify-center"
          @click="refreshListRequest"
        >
          <text class="text-[#ffffff] text-[14px]">invalidate()</text>
        </view>
      </view>
      <view class="flex-1">
        <view
          class="bg-[#ef4444] rounded-[8px] h-[42px] w-full flex flex-row items-center justify-center"
          @click="abortListRequest"
        >
          <text class="text-[#ffffff] text-[13px]">cancelQueries()</text>
        </view>
      </view>
    </view>

    <!-- 5.2 失败与取消路径：真实接口 + 重试 -->
    <view class="rounded-[10px] p-[12px] mb-[12px] border-[1px] border-solid border-[#e2e8f0]">
      <view class="flex-row justify-between items-center mb-[6px]">
        <text class="text-[13px] text-[#64748b]">fetchFooRemoteApi（真实接口 · retry 2）</text>
        <view class="px-[8px] py-[2px] rounded-[10px]" :class="remoteStatusBgClass">
          <text class="text-[12px]" :class="remoteStatusTextClass">{{ remoteStatusText }}</text>
        </view>
      </view>
      <text class="text-[12px] text-[#475569]">{{ remoteDetailText }}</text>
      <text class="text-[11px] text-[#94a3b8]">onError 已触发 {{ remoteErrorTick }} 次 · 请求函数实际被调用 {{ remoteCalls }} 次</text>
    </view>
    <view class="flex-row mb-[12px]">
      <view class="flex-1 mr-[10px]">
        <view
          class="bg-[#0ea5e9] rounded-[8px] h-[42px] w-full flex flex-row items-center justify-center"
          @click="sendRemoteRequest"
        >
          <text class="text-[#ffffff] text-[14px]">发起请求</text>
        </view>
      </view>
      <view class="flex-1">
        <view
          class="bg-[#ef4444] rounded-[8px] h-[42px] w-full flex flex-row items-center justify-center"
          @click="abortRemoteRequest"
        >
          <text class="text-[#ffffff] text-[13px]">cancelQueries()</text>
        </view>
      </view>
    </view>

    <!-- 5.3 防抖：连续输入只发一次 -->
    <view class="rounded-[10px] p-[12px] mb-[12px] border-[1px] border-solid border-[#e2e8f0]">
      <text class="text-[13px] text-[#64748b] mb-[8px]">防抖 400ms —— 连续输入只在停手后发一次</text>
      <input
        v-model="searchKeyword"
        placeholder="输入关键字，观察下方只发一次"
        class="h-[38px] bg-white rounded-[6px] px-[12px] border-[1px] border-solid border-[#cbd5e1] text-[13px] text-[#334155] mb-[8px]"
        @input="handleSearchInput"
      />
      <text class="text-[12px] text-[#475569]">请求函数实际被调用 {{ searchCalls }} 次</text>
      <text class="text-[11px] text-[#94a3b8]">最后一次发出的关键字「{{ searchLastKeyword }}」</text>
    </view>

    <!-- 5.4 轮询：不翻 loading、失败静默 -->
    <view class="rounded-[10px] p-[12px] border-[1px] border-solid border-[#e2e8f0]">
      <view class="flex-row justify-between items-center mb-[8px]">
        <text class="text-[13px] text-[#64748b]">轮询 3s（不翻 loading、失败静默）</text>
        <text class="text-[12px] text-[#475569]">已轮询 {{ pollingTick }} 次</text>
      </view>
      <view
        class="h-[42px] w-full rounded-[8px] flex flex-row items-center justify-center"
        :class="pollingButtonClass"
        @click="togglePolling"
      >
        <text class="text-[#ffffff] text-[14px]">{{ pollingButtonText }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed, ref } from 'vue';
import { fetchFooListApi, fetchFooRemoteApi } from '@/src/api/example.uts';
import type { FooItem, PageResult } from '@/src/api/example.uts';
import { defaultQueryClient, useMutation, useQuery } from '@/uni_modules/request-bestX/index.uts';
import type { MutationOptions, QueryFunctionContext, QueryOptions } from '@/uni_modules/request-bestX/index.uts';

const listTick = ref<number>(0);
const remoteErrorTick = ref<number>(0);
const remoteCalls = ref<number>(0);
const searchKeyword = ref<string>('');
const searchCalls = ref<number>(0);
const searchLastKeyword = ref<string>('');
const pollingOn = ref<boolean>(false);
const pollingTick = ref<number>(0);

const listQuery = useQuery<PageResult<FooItem>>({
  queryKey: ['fooList', 'uni'],
  queryFn: (_ctx: QueryFunctionContext): Promise<PageResult<FooItem>> => {
    return fetchFooListApi(1, 5, 'uni');
  },
  enabled: false
} as QueryOptions<PageResult<FooItem>>);

const remoteQuery = useQuery<FooItem>({
  queryKey: ['fooRemote'],
  queryFn: (_ctx: QueryFunctionContext): Promise<FooItem> => {
    remoteCalls.value = remoteCalls.value + 1;
    return fetchFooRemoteApi();
  },
  enabled: false,
  retry: 2,
  retryDelay: 600
} as QueryOptions<FooItem>);

const searchMutation = useMutation<PageResult<FooItem>, string>({
  mutationFn: (kw: string): Promise<PageResult<FooItem>> => {
    searchCalls.value = searchCalls.value + 1;
    searchLastKeyword.value = kw;
    return fetchFooListApi(1, 5, kw);
  }
} as MutationOptions<PageResult<FooItem>, string>);

const pollingQuery = useQuery<PageResult<FooItem>>({
  queryKey: ['fooPolling'],
  queryFn: (_ctx: QueryFunctionContext): Promise<PageResult<FooItem>> => {
    pollingTick.value = pollingTick.value + 1;
    return fetchFooListApi(1, 3, '');
  },
  enabled: false,
  refetchInterval: 3000
} as QueryOptions<PageResult<FooItem>>);

const listStatusKey = computed((): string => {
  if (listQuery.isError.value == true) {
    return 'error';
  }
  if (listQuery.isFetching.value == true) {
    if (listQuery.data.value != null) {
      return 'refreshing';
    }
    return 'loading';
  }
  if (listQuery.data.value != null) {
    return 'success';
  }
  return 'idle';
});

const listStatusText = computed((): string => {
  switch (listStatusKey.value) {
    case 'loading': return '加载中';
    case 'refreshing': return '刷新中';
    case 'success': return '成功';
    case 'error': return '失败';
    default: return '待发起';
  }
});

const listStatusTextClass = computed((): string => {
  switch (listStatusKey.value) {
    case 'loading': return 'text-[#d97706]';
    case 'refreshing': return 'text-[#2563eb]';
    case 'success': return 'text-[#059669]';
    case 'error': return 'text-[#dc2626]';
    default: return 'text-[#94a3b8]';
  }
});

const listStatusBgClass = computed((): string => {
  switch (listStatusKey.value) {
    case 'loading': return 'bg-[#fef9c3]';
    case 'refreshing': return 'bg-[#dbeafe]';
    case 'success': return 'bg-[#d1fae5]';
    case 'error': return 'bg-[#fee2e2]';
    default: return 'bg-[#f1f5f9]';
  }
});

const listDataText = computed((): string => {
  const data = listQuery.data.value;
  if (data == null) {
    return '暂无数据';
  }
  return `共 ${data.total} 条 · 本页 ${data.list.length} 条`;
});

const remoteStatusText = computed((): string => {
  if (remoteQuery.isFetching.value == true) {
    return `请求中（第 ${remoteCalls.value} 次尝试）`;
  }
  if (remoteQuery.isError.value == true) {
    return '已重试后仍失败';
  }
  if (remoteQuery.data.value != null) {
    return '成功';
  }
  return '待发起';
});

const remoteStatusTextClass = computed((): string => {
  if (remoteQuery.isFetching.value == true) {
    return 'text-[#d97706]';
  }
  if (remoteQuery.isError.value == true) {
    return 'text-[#dc2626]';
  }
  if (remoteQuery.data.value != null) {
    return 'text-[#059669]';
  }
  return 'text-[#94a3b8]';
});

const remoteStatusBgClass = computed((): string => {
  if (remoteQuery.isFetching.value == true) {
    return 'bg-[#fef9c3]';
  }
  if (remoteQuery.isError.value == true) {
    return 'bg-[#fee2e2]';
  }
  if (remoteQuery.data.value != null) {
    return 'bg-[#d1fae5]';
  }
  return 'bg-[#f1f5f9]';
});

const remoteDetailText = computed((): string => {
  const err = remoteQuery.error.value;
  if (err != null) {
    return `错误：${err.message}`;
  }
  const data = remoteQuery.data.value;
  if (data != null) {
    return `id: ${data.id}, name: ${data.name}`;
  }
  return '未配置后端时走失败分支，正好演示重试与 error 状态';
});

const pollingButtonText = computed((): string => {
  if (pollingOn.value == true) {
    return '停止轮询';
  }
  return '开始轮询';
});

const pollingButtonClass = computed((): string => {
  if (pollingOn.value == true) {
    return 'bg-[#ef4444]';
  }
  return 'bg-[#8b5cf6]';
});

function sendListRequest(): void {
  listTick.value = listTick.value + 1;
  listQuery.refetch();
}

function refreshListRequest(): void {
  listTick.value = listTick.value + 1;
  defaultQueryClient.invalidateQueries(['fooList', 'uni']);
}

function abortListRequest(): void {
  // 对标 TanStack Query 规范：queryClient.cancelQueries({ queryKey })
  defaultQueryClient.cancelQueries({ queryKey: ['fooList', 'uni'] });
}

function sendRemoteRequest(): void {
  remoteCalls.value = 0;
  remoteQuery.refetch().then(
    (_res) => {},
    (_err) => {
      remoteErrorTick.value = remoteErrorTick.value + 1;
    }
  );
}

function abortRemoteRequest(): void {
  // 对标 TanStack Query 规范：queryClient.cancelQueries({ queryKey })
  defaultQueryClient.cancelQueries({ queryKey: ['fooRemote'] });
}

function handleSearchInput(): void {
  searchMutation.mutate(searchKeyword.value);
}

function togglePolling(): void {
  if (pollingOn.value == true) {
    pollingQuery.abort();
    pollingOn.value = false;
    return;
  }
  pollingQuery.refetch();
  pollingOn.value = true;
}
</script>
