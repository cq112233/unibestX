<template>
  <!-- 页面根容器：view + flex flex-col flex-1（flex-1 撑满开发高度） -->
  <view class="flex flex-col items-center flex-1 px-[12px] pt-[8px]">
    <!-- 顶部简要说明：request-bestX 用法与 hooks 总览 -->
    <view class="w-full mb-[12px]" :style="{ maxWidth: '760px' }">
      <view class="w-full bg-white rounded-[12px] px-[16px] py-[14px]">
        <view class="flex-row items-center justify-between mb-[8px]">
          <view class="flex-row items-center">
            <view class="w-[4px] h-[14px] rounded-[2px] bg-[#0f766e] mr-[8px]" />
            <text class="text-[14px] font-bold text-[#1e293b]">HTTP 请求演示</text>
          </view>
          <text class="text-[12px] text-[#94a3b8]">request-bestX · 声明式 hooks</text>
        </view>

        <text class="text-[12px] text-[#64748b] leading-[19px] mb-[4px]">
          所有请求都由 @/src/http 里的 request-bestX 实例发出：拦截器统一注入 token、拆业务码、toast 报错。页面侧不再手写 loading / try-catch —— 列表与详情用 useQuery 自动加载、缓存与重拉，增删改与上传用 useMutation 驱动状态机。
        </text>

        <!-- 能力标签：flex-wrap 换行，靠 mr / mb 控制间距（原生端不支持 gap） -->
        <view class="flex-row flex-wrap mt-[8px]">
          <view
            v-for="tag in apiTags"
            :key="tag"
            class="px-[8px] py-[2px] rounded-[4px] bg-[#f1f5f9] mr-[6px] mb-[6px]"
          >
            <text class="text-[10px] font-medium text-[#475569]">{{ tag }}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 内部 scroll-view：居中列 + 整列滚动 -->
    <scroll-view
      direction="vertical" class="w-full flex flex-col flex-1" :style="{ maxWidth: '760px' }"
      :lower-threshold="50" @scroll="handleScroll" @scrolltolower="handleScrollToLower"
    >
      <view class="flex flex-col">
        <!-- 1. 真实请求（CRUD 增删改查） -->
        <CrudDemoCard />

        <!-- 2. 文件上传 -->
        <UploadDemoCard />

        <!-- 3. 文件下载 -->
        <DownloadDemoCard />
        <view class="flex-col items-center py-[16px]">
          <text class="text-[12px] text-[#94a3b8]">已触底 {{ reachBottomCount }} 次 · 内容结束</text>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue';
import { onNavbarPullDownRefresh, stopNavbarPullDownRefresh } from '@/src/layouts/navbar/utils/index.uts';
import CrudDemoCard from '@/src/sub/httpBasicDemo/components/CrudDemoCard.uvue';
import UploadDemoCard from '@/src/sub/httpBasicDemo/components/UploadDemoCard.uvue';
import DownloadDemoCard from '@/src/sub/httpBasicDemo/components/DownloadDemoCard.uvue';

definePage({
  debug: false,
  layout: 'navbar',
  showBack: true,
  hideNavbar: false,
  enablePullDownRefresh: false,
  style: {
    navigationBarTitleText: 'HTTP 请求 Demo',
    navigationStyle: 'custom'
  }
});

const reachBottomCount = ref<number>(0);

/**
 * 顶部能力标签：本页演示到的 request-bestX 能力
 *
 * 只做静态展示，所以用普通常量（不需要 ref）；UTS 里数组元素类型要显式标注。
 */
const apiTags: Array<string> = [
  'useQuery',
  'useMutation',
  'http.get',
  'http.post / put / delete',
  'http.upload',
  'http.downloadFile'
];

function handleScroll(e: UniScrollEvent): void {
  const top = Math.ceil(e.detail.scrollTop);
  if (top < 0) {
    console.log('scrollTop:', top);
  }
}

function handleScrollToLower(): void {
  reachBottomCount.value++;
}

onNavbarPullDownRefresh(() => {
  setTimeout(() => {
    stopNavbarPullDownRefresh();
  }, 600);
});
</script>
