<template>
  <!-- 页面根容器：view + flex flex-col flex-1（flex-1 撑满开发高度） -->
  <view class="flex flex-col items-center flex-1 px-[16px] pt-[8px]">
    <!-- 固定说明区（不随内容滚动） -->
    <view class="w-full mb-[16px]" :style="{ maxWidth: '520px' }">
      <view class="w-full bg-white rounded-[12px] p-[16px] flex flex-col">
        <view class="flex-row items-center mb-[10px]">
          <view class="w-[6px] h-[16px] rounded-[3px] bg-[#0f766e] mr-[8px]" />
          <text class="text-[16px] font-bold text-[#1e293b]">HTTP 请求 Demo</text>
          <text class="text-[11px] text-[#94a3b8] ml-[8px] px-[6px] py-[2px] rounded-[4px] bg-[#f1f5f9]">独立页</text>
        </view>
        <text class="text-[13px] text-[#64748b] leading-[19px]">
          基于 lime-request 封装的 http 请求演示，包含 Mock 数据、真实接口请求、uniCloud 云对象、OSS 文件上传与文件下载五种模式。
        </text>
        <view class="flex-row flex-wrap mt-[12px]">
          <view class="rounded-[6px] px-[8px] py-[4px] bg-[#eff6ff] mr-[8px] mb-[8px]">
            <text class="text-[11px] text-[#1d4ed8]">Mock 数据</text>
          </view>
          <view class="rounded-[6px] px-[8px] py-[4px] bg-[#ecfdf5] mr-[8px] mb-[8px]">
            <text class="text-[11px] text-[#065f46]">真实 API</text>
          </view>
          <view class="rounded-[6px] px-[8px] py-[4px] bg-[#f0fdfa] mr-[8px] mb-[8px]">
            <text class="text-[11px] text-[#0f766e]">uniCloud</text>
          </view>
          <view class="rounded-[6px] px-[8px] py-[4px] bg-[#fff7ed] mr-[8px] mb-[8px]">
            <text class="text-[11px] text-[#c2410c]">文件上传</text>
          </view>
          <view class="rounded-[6px] px-[8px] py-[4px] bg-[#eef2ff] mr-[8px] mb-[8px]">
            <text class="text-[11px] text-[#4338ca]">文件下载</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 内部 scroll-view：居中列 + 整列滚动 -->
    <scroll-view
      direction="vertical" class="w-full flex flex-col flex-1" :style="{ maxWidth: '520px' }"
      :lower-threshold="50" @scroll="handleScroll" @scrolltolower="handleScrollToLower"
    >
      <view class="flex flex-col">
        <!-- ============ 1. uniCloud 云对象 ============ -->
        <view
          class="rounded-[16px] p-[20px] m-[16px] border-[1px] border-solid border-[#edf2f7] bg-[#ffffff]"
        >
          <!-- 标题区域 -->
          <view class="flex flex-row items-center mb-[16px]">
            <view
              class="w-[4px] h-[16px] rounded-[2px] mr-[8px] bg-[#3182ce]"
            />
            <text class="text-[16px] font-bold text-[#2d3748]">uniCloud 云对象</text>
          </view>
          <view class="mb-[16px]">
            <view class="flex-row items-center justify-between mb-[10px]">
              <view class="flex-row items-center">
                <view class="w-[32px] h-[32px] rounded-[8px] bg-[#e6fffb] border-[1px] border-solid border-[#99f6e4] items-center justify-center mr-[10px]">
                  <text class="text-[12px] font-bold text-[#0f766e]">UC</text>
                </view>
                <view>
                  <text class="text-[14px] font-bold text-[#1e293b]">uniCloud 云对象</text>
                  <text class="text-[11px] text-[#64748b] mt-[2px]">user.getUserInfo</text>
                </view>
              </view>
              <view class="flex-row items-center px-[8px] py-[4px] rounded-[10px]" :class="cloudStatusBgClass">
                <view class="w-[6px] h-[6px] rounded-[3px] mr-[5px]" :class="cloudStatusDotClass" />
                <text class="text-[11px]" :class="cloudStatusTextClass">{{ cloudStatusText }}</text>
              </view>
            </view>

            <view class="rounded-[8px] bg-[#f8fafc] border-[1px] border-solid border-[#cbd5e1] overflow-hidden">
              <view class="h-[3px] bg-[#14b8a6]" />
              <view class="p-[12px]">
                <view class="flex-row items-center justify-between mb-[8px]">
                  <text class="text-[11px] text-[#64748b]">响应数据</text>
                  <text class="text-[10px] text-[#94a3b8]">JSON</text>
                </view>
                <text v-if="cloudLoading" class="text-[12px] text-[#0f766e]">正在连接云端服务...</text>
                <text v-else-if="hasCloudError" class="text-[12px] text-[#dc2626]">{{ cloudErrorMsg }}</text>
                <text v-else class="text-[12px] text-[#334155] leading-[20px]">{{ userInfo }}</text>

                <view v-if="hasCloudError" class="mt-[10px] flex-row">
                  <view class="h-[32px] px-[12px] rounded-[6px] bg-[#0f766e] items-center justify-center" @click="getUserInfo">
                    <text class="text-[12px] text-[#ffffff]">重新获取</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- ============ 2. Mock 数据列表 ============ -->
        <view
          class="rounded-[16px] p-[20px] m-[16px] border-[1px] border-solid border-[#edf2f7] bg-[#ffffff]"
        >
          <!-- 标题区域 -->
          <view class="flex flex-row items-center mb-[16px]">
            <view
              class="w-[4px] h-[16px] rounded-[2px] mr-[8px] bg-[#3182ce]"
            />
            <text class="text-[16px] font-bold text-[#2d3748]">Mock 数据列表（ID 为任意类型）</text>
          </view>
          <text class="text-[12px] text-[#64748b] leading-[19px] mb-[4px]">
            在 src/api/example.uts 中定义，由 fetchFooList() 直接返回，无需网络即可演示列表渲染。
          </text>
          <view v-for="(item, index) in mockList" :key="index" class="flex-row items-center py-[10px] px-[12px] bg-[#f1f5f9] rounded-[8px] mt-[8px]">
            <view class="w-[28px] h-[28px] rounded-[14px] bg-[#3182ce] justify-center items-center mr-[10px]">
              <text class="text-[12px] text-[#ffffff] font-bold">{{ item.id }}</text>
            </view>
            <text class="text-[14px] text-[#334155]">{{ item.name }}</text>
          </view>
        </view>

        <!-- ============ 3. 真实接口请求状态 ============ -->
        <view
          class="rounded-[16px] p-[20px] m-[16px] border-[1px] border-solid border-[#edf2f7] bg-[#ffffff]"
        >
          <!-- 标题区域 -->
          <view class="flex flex-row items-center mb-[16px]">
            <view
              class="w-[4px] h-[16px] rounded-[2px] mr-[8px] bg-[#3182ce]"
            />
            <text class="text-[16px] font-bold text-[#2d3748]">真实 API 请求（拦截器 + 错误处理）</text>
          </view>
          <view class="rounded-[10px] p-[12px] mb-[16px] border-[1px] border-solid border-[#e2e8f0]">
            <view class="flex-row justify-between items-center mb-[6px]">
              <text class="text-[13px] text-[#64748b]">接口请求状态:</text>
              <view class="px-[8px] py-[2px] rounded-[10px]" :class="statusBgClass">
                <text class="text-[12px]" :class="statusTextClass">{{ statusText }}</text>
              </view>
            </view>
            <view
              v-if="hasResponseData"
              class="rounded-[8px] p-[10px] border-[1px] border-solid bg-[#ffffff] border-[#e2e8f0]"
            >
              <text class="text-[12px] text-[#475569]">{{ responseText }}</text>
            </view>
            <view v-if="hasErrorMsg" class="bg-[#fff5f5] rounded-[8px] p-[10px] border-[1px] border-solid border-[#fecaca] mt-[6px]">
              <text class="text-[12px] text-[#ef4444]">错误：{{ errorMsg }}</text>
            </view>
          </view>

          <!-- 操作按钮：用 margin-right 代替 gap -->
          <view class="flex-row">
            <view class="flex-1 mr-[10px]">
              <view
                class="bg-[#3182ce] rounded-[8px] h-[42px] w-full flex flex-row items-center justify-center"
                @click="loadMockData"
              >
                <text class="text-[#ffffff] text-[14px]">加载 Mock 数据</text>
              </view>
            </view>
            <view class="flex-1">
              <view
                class="bg-[#10b981] rounded-[8px] h-[42px] w-full flex flex-row items-center justify-center"
                @click="fetchRealApi"
              >
                <text class="text-[#ffffff] text-[14px]">{{ loading ? '请求中...' : '真实 API 请求' }}</text>
              </view>
            </view>
          </view>
        </view>

        <!-- ============ 4. 文件上传 ============ -->
        <view
          class="rounded-[16px] p-[20px] m-[16px] border-[1px] border-solid border-[#edf2f7] bg-[#ffffff]"
        >
          <!-- 标题区域 -->
          <view class="flex flex-row items-center mb-[16px]">
            <view
              class="w-[4px] h-[16px] rounded-[2px] mr-[8px] bg-[#3182ce]"
            />
            <text class="text-[16px] font-bold text-[#2d3748]">文件上传（uploadFooFile → http.upload）</text>
          </view>
          <view class="mb-[16px]">
            <view class="flex-row items-center mb-[10px]">
              <view class="w-[32px] h-[32px] rounded-[8px] bg-[#fff7ed] border-[1px] border-solid border-[#fdba74] items-center justify-center mr-[10px]">
                <text class="text-[12px] font-bold text-[#c2410c]">UP</text>
              </view>
              <view class="flex-1">
                <text class="text-[14px] font-bold text-[#1e293b]">文件上传</text>
                <text class="text-[11px] text-[#64748b] mt-[2px]">{{ uploadPath }}</text>
              </view>
            </view>

            <view class="flex-row items-center bg-[#fff7ed] p-[8px] rounded-[6px] mb-[10px] border-[1px] border-solid border-[#ffedd5]">
              <text class="text-[11px] text-[#c2410c] leading-[16px] flex-1">
                💡 上传 OSS 接口地址支持直接在 .env 环境变量中配置（VITE_UPLOAD_BASEURL / VITE_UPLOAD_PATH）
              </text>
            </view>

            <view class="rounded-[8px] bg-[#f8fafc] border-[1px] border-solid border-[#cbd5e1] overflow-hidden">
              <view class="h-[3px] bg-[#f97316]" />
              <view class="p-[12px]">
                <view class="flex-row items-center justify-between mb-[8px]">
                  <text class="text-[11px] text-[#64748b]">上传结果</text>
                  <text class="text-[10px] text-[#94a3b8]">POST</text>
                </view>
                <text v-if="uploadLoading" class="text-[12px] text-[#c2410c]">正在上传...</text>
                <text v-else-if="hasUploadError" class="text-[12px] text-[#dc2626]">{{ uploadError }}</text>
                <view v-else-if="hasUploadResult">
                  <!-- 上：图片居中预览（支持点击放大） -->
                  <view
                    class="items-center justify-center py-[10px] rounded-[8px] border-[1px] border-solid bg-[#ffffff] border-[#e2e8f0]"
                  >
                    <image
                      :src="uploadResultText"
                      class="w-[120px] h-[120px] rounded-[8px]"
                      mode="aspectFill"
                      @click="previewUploadedImage"
                    />
                    <text class="text-[10px] text-[#94a3b8] mt-[6px]">点击查看大图</text>
                  </view>

                  <!-- 下：OSS 链接美化展示卡片（支持一键复制） -->
                  <view
                    class="mt-[10px] p-[10px] rounded-[8px] border-[1px] border-solid bg-[#f8fafc] border-[#e2e8f0]"
                  >
                    <view class="flex-row items-center justify-between mb-[6px]">
                      <view class="flex-row items-center">
                        <view class="w-[3px] h-[12px] bg-[#f97316] rounded-[2px] mr-[6px]" />
                        <text class="text-[11px] font-bold text-[#475569]">OSS 链接地址</text>
                      </view>
                      <view
                        class="px-[8px] py-[3px] rounded-[4px] bg-[#ea580c] flex-row items-center"
                        @click="copyUploadUrl"
                      >
                        <text class="text-[10px] text-[#ffffff] font-medium">复制链接</text>
                      </view>
                    </view>
                    <text
                      class="oss-url-text text-[11px] leading-[18px] text-[#334155]"
                      :selectable="true"
                    >
                      {{ uploadResultText }}
                    </text>
                  </view>
                </view>
                <text v-else class="text-[12px] text-[#94a3b8]">未选择文件</text>
              </view>
            </view>

            <view class="mt-[10px]">
              <view
                class="bg-[#f97316] rounded-[8px] h-[42px] w-full flex flex-row items-center justify-center"
                @click="chooseAndUpload"
              >
                <text class="text-[#ffffff] text-[14px]">{{ uploadLoading ? '上传中...' : '选择图片并上传' }}</text>
              </view>
            </view>
          </view>
        </view>

        <!-- ============ 5. 文件下载 ============ -->
        <view
          class="rounded-[16px] p-[20px] m-[16px] border-[1px] border-solid border-[#edf2f7] bg-[#ffffff]"
        >
          <!-- 标题区域 -->
          <view class="flex flex-row items-center mb-[16px]">
            <view
              class="w-[4px] h-[16px] rounded-[2px] mr-[8px] bg-[#3182ce]"
            />
            <text class="text-[16px] font-bold text-[#2d3748]">文件下载（downloadFooFile → http.downloadFile）</text>
          </view>
          <view class="mb-[16px]">
            <view class="flex-row items-center mb-[10px]">
              <view class="w-[32px] h-[32px] rounded-[8px] bg-[#eef2ff] border-[1px] border-solid border-[#c7d2fe] items-center justify-center mr-[10px]">
                <text class="text-[12px] font-bold text-[#4338ca]">DL</text>
              </view>
              <view class="flex-1">
                <text class="text-[14px] font-bold text-[#1e293b]">文件下载</text>
                <text class="text-[11px] text-[#64748b] mt-[2px]">GET · 自动携带 Token</text>
              </view>
            </view>

            <view class="flex-row items-center bg-[#eef2ff] p-[8px] rounded-[6px] mb-[10px] border-[1px] border-solid border-[#e0e7ff]">
              <text class="text-[11px] text-[#4338ca] leading-[16px] flex-1">
                💡 下载成功后返回临时文件路径（tempFilePath），可直接预览图片或交给 uni.openDocument 打开文档
              </text>
            </view>

            <view class="rounded-[8px] bg-[#f8fafc] border-[1px] border-solid border-[#cbd5e1] overflow-hidden">
              <view class="h-[3px] bg-[#6366f1]" />
              <view class="p-[12px]">
                <view class="flex-row items-center justify-between mb-[8px]">
                  <text class="text-[11px] text-[#64748b]">下载结果</text>
                  <text class="text-[10px] text-[#94a3b8]">DOWNLOAD</text>
                </view>

                <!-- 下载中：展示进度条 -->
                <view v-if="downloadLoading" class="flex flex-col">
                  <view class="flex-row items-center justify-between mb-[6px]">
                    <text class="text-[12px] text-[#4338ca]">正在下载...</text>
                    <text class="text-[12px] text-[#4338ca] font-bold">{{ downloadProgressText }}</text>
                  </view>
                  <view class="w-full h-[6px] rounded-[3px] bg-[#e2e8f0] overflow-hidden">
                    <view class="h-[6px] rounded-[3px] bg-[#6366f1]" :style="downloadProgressBarStyle" />
                  </view>
                </view>

                <text v-else-if="hasDownloadError" class="text-[12px] text-[#dc2626]">{{ downloadError }}</text>

                <view v-else-if="hasDownloadResult" class="flex flex-col">
                  <view class="flex-row items-center mb-[8px]">
                    <view class="px-[8px] py-[2px] rounded-[4px] bg-[#e0e7ff] mr-[8px]">
                      <text class="text-[11px] text-[#4338ca]">HTTP {{ downloadStatusCode }}</text>
                    </view>
                    <text class="text-[11px] text-[#64748b]">已下载到本地临时文件</text>
                  </view>

                  <!-- 图片类资源：居中预览（支持点击放大） -->
                  <view
                    v-if="isDownloadImage"
                    class="items-center justify-center py-[10px] rounded-[8px] border-[1px] border-solid bg-[#ffffff] border-[#e2e8f0]"
                  >
                    <image
                      :src="downloadFilePath"
                      class="w-[120px] h-[120px] rounded-[8px]"
                      mode="aspectFit"
                      @click="previewDownloadedFile"
                    />
                    <text class="text-[10px] text-[#94a3b8] mt-[6px]">点击查看大图</text>
                  </view>

                  <!-- 本地路径展示卡片（支持一键复制） -->
                  <view
                    class="mt-[10px] p-[10px] rounded-[8px] border-[1px] border-solid bg-[#f8fafc] border-[#e2e8f0]"
                  >
                    <view class="flex-row items-center justify-between mb-[6px]">
                      <view class="flex-row items-center">
                        <view class="w-[3px] h-[12px] bg-[#6366f1] rounded-[2px] mr-[6px]" />
                        <text class="text-[11px] font-bold text-[#475569]">临时文件路径</text>
                      </view>
                      <view
                        class="px-[8px] py-[3px] rounded-[4px] bg-[#4f46e5] flex-row items-center"
                        @click="copyDownloadPath"
                      >
                        <text class="text-[10px] text-[#ffffff] font-medium">复制路径</text>
                      </view>
                    </view>
                    <text
                      class="oss-url-text text-[11px] leading-[18px] text-[#334155]"
                      :selectable="true"
                    >
                      {{ downloadFilePath }}
                    </text>
                  </view>
                </view>

                <text v-else class="text-[12px] text-[#94a3b8]">尚未发起下载</text>
              </view>
            </view>

            <view class="flex-row mt-[10px]">
              <view class="flex-1 mr-[10px]">
                <view
                  class="bg-[#6366f1] rounded-[8px] h-[42px] w-full flex flex-row items-center justify-center"
                  @click="downloadSampleFile"
                >
                  <text class="text-[#ffffff] text-[14px]">{{ downloadLoading ? '下载中...' : '下载示例图片' }}</text>
                </view>
              </view>
              <view class="flex-1">
                <view
                  class="bg-[#0ea5e9] rounded-[8px] h-[42px] w-full flex flex-row items-center justify-center"
                  @click="openDownloadedFile"
                >
                  <text class="text-[#ffffff] text-[14px]">打开已下载文件</text>
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- ============ 6. useRequest 组合式请求 ============ -->
        <view
          class="rounded-[16px] p-[20px] m-[16px] border-[1px] border-solid border-[#edf2f7] bg-[#ffffff]"
        >
          <!-- 标题区域 -->
          <view class="flex flex-row items-center mb-[16px]">
            <view class="w-[4px] h-[16px] rounded-[2px] mr-[8px] bg-[#8b5cf6]" />
            <text class="text-[16px] font-bold text-[#2d3748]">useRequest 组合式请求（对标 Alova）</text>
          </view>
          <text class="text-[12px] text-[#64748b] leading-[18px] mb-[12px]">第 3 张卡那一套手写的 loading / error 样板，这里全部由 hook 托管：状态流转、并发竞态、失败重试、防抖、轮询、取消一次配齐。</text>

          <!-- 6.1 成功路径：本地 mock -->
          <view class="rounded-[10px] p-[12px] mb-[12px] border-[1px] border-solid border-[#e2e8f0]">
            <view class="flex-row justify-between items-center mb-[6px]">
              <text class="text-[13px] text-[#64748b]">fetchFooList（本地 mock）</text>
              <view class="px-[8px] py-[2px] rounded-[10px]" :class="listStatusBgClass">
                <text class="text-[12px]" :class="listStatusTextClass">{{ listStatusText }}</text>
              </view>
            </view>
            <text class="text-[12px] text-[#475569]">{{ listDataText }}</text>
            <text class="text-[11px] text-[#94a3b8]">onComplete 已触发 {{ listTick }} 次</text>
          </view>
          <view class="flex-row mb-[12px]">
            <view class="flex-1 mr-[10px]">
              <view
                class="bg-[#8b5cf6] rounded-[8px] h-[42px] w-full flex flex-row items-center justify-center"
                @click="sendListRequest"
              >
                <text class="text-[#ffffff] text-[14px]">send('uni')</text>
              </view>
            </view>
            <view class="flex-1 mr-[10px]">
              <view
                class="bg-[#10b981] rounded-[8px] h-[42px] w-full flex flex-row items-center justify-center"
                @click="refreshListRequest"
              >
                <text class="text-[#ffffff] text-[14px]">refresh()</text>
              </view>
            </view>
            <view class="flex-1">
              <view
                class="bg-[#ef4444] rounded-[8px] h-[42px] w-full flex flex-row items-center justify-center"
                @click="abortListRequest"
              >
                <text class="text-[#ffffff] text-[14px]">abort()</text>
              </view>
            </view>
          </view>

          <!-- 6.2 失败与取消路径：真实接口 + 重试 -->
          <view class="rounded-[10px] p-[12px] mb-[12px] border-[1px] border-solid border-[#e2e8f0]">
            <view class="flex-row justify-between items-center mb-[6px]">
              <text class="text-[13px] text-[#64748b]">fetchFooRemote（真实接口 · retry 2）</text>
              <view class="px-[8px] py-[2px] rounded-[10px]" :class="remoteStatusBgClass">
                <text class="text-[12px]" :class="remoteStatusTextClass">{{ remoteStatusText }}</text>
              </view>
            </view>
            <text class="text-[12px] text-[#475569]">{{ remoteDetailText }}</text>
            <text class="text-[11px] text-[#94a3b8]">onError 已触发 {{ remoteErrorTick }} 次 · 请求函数实际被调用 {{ remoteCalls }} 次</text>
          </view>
          <view class="flex-row mb-[12px]">
            <view class="flex-1 mr-[10px]">
              <view
                class="bg-[#0ea5e9] rounded-[8px] h-[42px] w-full flex flex-row items-center justify-center"
                @click="sendRemoteRequest"
              >
                <text class="text-[#ffffff] text-[14px]">发起请求</text>
              </view>
            </view>
            <view class="flex-1">
              <view
                class="bg-[#ef4444] rounded-[8px] h-[42px] w-full flex flex-row items-center justify-center"
                @click="abortRemoteRequest"
              >
                <text class="text-[#ffffff] text-[14px]">abort() 取消</text>
              </view>
            </view>
          </view>

          <!-- 6.3 防抖：连续输入只发一次 -->
          <view class="rounded-[10px] p-[12px] mb-[12px] border-[1px] border-solid border-[#e2e8f0]">
            <text class="text-[13px] text-[#64748b] mb-[8px]">防抖 400ms —— 连续输入只在停手后发一次</text>
            <input
              v-model="searchKeyword"
              placeholder="输入关键字，观察下方只发一次"
              class="h-[38px] bg-white rounded-[6px] px-[12px] border-[1px] border-solid border-[#cbd5e1] text-[13px] text-[#334155] mb-[8px]"
              @input="handleSearchInput"
            />
            <text class="text-[12px] text-[#475569]">请求函数实际被调用 {{ searchCalls }} 次</text>
            <text class="text-[11px] text-[#94a3b8]">最后一次发出的关键字「{{ searchLastKeyword }}」</text>
          </view>

          <!-- 6.4 轮询：不翻 loading、失败静默 -->
          <view class="rounded-[10px] p-[12px] border-[1px] border-solid border-[#e2e8f0]">
            <view class="flex-row justify-between items-center mb-[8px]">
              <text class="text-[13px] text-[#64748b]">轮询 3s（不翻 loading、失败静默）</text>
              <text class="text-[12px] text-[#475569]">已轮询 {{ pollingTick }} 次</text>
            </view>
            <view
              class="h-[42px] w-full rounded-[8px] flex flex-row items-center justify-center"
              :class="pollingButtonClass"
              @click="togglePolling"
            >
              <text class="text-[#ffffff] text-[14px]">{{ pollingButtonText }}</text>
            </view>
          </view>
        </view>

        <view class="flex-col items-center py-[16px]">
          <text class="text-[12px] text-[#94a3b8]">已触底 {{ reachBottomCount }} 次 · 内容结束</text>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
/* eslint-disable dot-notation */
import { computed, ref } from 'vue';
import { downloadFooFile, fetchFooList, fetchFooRemote, FOO_DOWNLOAD_URL, FOO_UPLOAD_PATH, uploadFooFile } from '@/src/api/example.uts';
import type { FooItem, PageResult } from '@/src/api/example.uts';
// useRequest 走精准导入（红线 36）：不经门面 `index.uts` 二次转发
import { useRequest } from '@/src/http/hooks/useRequest.uts';
import type { UseRequestContext, UseRequestEvent } from '@/src/http/hooks/useRequest.uts';
import { getOssBaseUrl } from '@/src/config/index.uts';
import { toast, toastSuccess } from '@/src/utils/toast/index.uts';
import { onNavbarPullDownRefresh, stopNavbarPullDownRefresh } from '@/src/layouts/navbar/utils/index.uts';

definePage({
  debug: false,
  layout: 'navbar',
  showBack: true,
  hideNavbar: false,
  enablePullDownRefresh: false,
  style: {
    navigationBarTitleText: 'HTTP 请求 Demo',
    navigationStyle: 'custom'
  }
});

// ==========================================
// 响应式状态
// ==========================================
const mockList = ref<FooItem[]>([]);
const loading = ref<boolean>(false);
const requestStatus = ref<string>('idle'); // idle | loading | success | error
const responseData = ref<FooItem | null>(null);
const errorMsg = ref<string>('');
const userInfo = ref<string>('');
const cloudLoading = ref<boolean>(false);
const cloudErrorMsg = ref<string>('');
const uploadPath = ref<string>(FOO_UPLOAD_PATH);
const uploadLoading = ref<boolean>(false);
const uploadResult = ref<string>('');
const uploadError = ref<string>('');
// 文件下载相关状态
const downloadLoading = ref<boolean>(false);
const downloadProgress = ref<number>(0);
const downloadFilePath = ref<string>('');
const downloadStatusCode = ref<number>(0);
const downloadError = ref<string>('');
const reachBottomCount = ref<number>(0);

// ==========================================
// 第 6 张卡：useRequest 组合式请求
// 与第 3 张卡（手写 loading / error）是同一件事的两种写法，对照着看
// ==========================================
const listTick = ref<number>(0);
const remoteErrorTick = ref<number>(0);
const remoteCalls = ref<number>(0);
const searchKeyword = ref<string>('');
const searchCalls = ref<number>(0);
const searchLastKeyword = ref<string>('');
const pollingOn = ref<boolean>(false);
const pollingTick = ref<number>(0);

/**
 * 成功路径：本地 mock，`immediate: false` 让它不在页面挂载时就发（否则一进页面就白跑一次）
 *
 * 演示 `send` 带参 / `refresh` 复用上次入参 / `abort` 取消 / `refreshing` 与 `loading` 的区别。
 */
const listRequest = useRequest<PageResult<FooItem>>((ctx: UseRequestContext): Promise<PageResult<FooItem>> => {
  let keyword: string = '';
  if (ctx.args.length > 0) {
    keyword = ctx.args[0] as string;
  }
  return fetchFooList(1, 5, keyword);
}, {
  immediate: false
});
listRequest.onComplete((_e: UseRequestEvent<PageResult<FooItem>>): void => {
  listTick.value = listTick.value + 1;
});

/**
 * 失败与取消路径：真实接口 + `retry: 2`
 *
 * 无后端时正好演示「网络层失败自动重试」与 `error` 状态；有后端时演示 `abort()` 真取消。
 * 每次尝试都计入 `remoteCalls`，重试有没有生效一眼可见。
 */
const remoteRequest = useRequest<FooItem>((_ctx: UseRequestContext): Promise<FooItem> => {
  remoteCalls.value = remoteCalls.value + 1;
  return fetchFooRemote();
}, {
  immediate: false,
  retry: 2,
  retryDelay: 600
});
remoteRequest.onError((_e: UseRequestEvent<FooItem>): void => {
  remoteErrorTick.value = remoteErrorTick.value + 1;
});

/**
 * 防抖：连续输入只在停手 400ms 后发一次
 *
 * 注意入参取的是 `searchKeyword.value` 而不是 `ctx.args`：`@input` 触发时 v-model 已同步，
 * 而防抖窗口结束时用户可能又敲了新字符，这里始终以「当前输入」为准。
 */
const searchRequest = useRequest<PageResult<FooItem>>((): Promise<PageResult<FooItem>> => {
  searchCalls.value = searchCalls.value + 1;
  searchLastKeyword.value = searchKeyword.value;
  return fetchFooList(1, 5, searchKeyword.value);
}, {
  immediate: false,
  debounce: 400
});

/**
 * 轮询：3s 一次，不翻 loading、失败静默
 *
 * `immediate: false` 只影响首帧自动触发，不会阻止 `startPolling()`，所以这里可以纯手动开关。
 */
const pollingRequest = useRequest<PageResult<FooItem>>((): Promise<PageResult<FooItem>> => {
  pollingTick.value = pollingTick.value + 1;
  return fetchFooList(1, 3, '');
}, {
  immediate: false,
  polling: 3000
});

// ==========================================
// 计算属性
// ==========================================
const statusText = computed((): string => {
  switch (requestStatus.value) {
    case 'loading': return '请求中';
    case 'success': return '请求成功';
    case 'error': return '请求失败';
    default: return '待请求';
  }
});

const statusTextClass = computed((): string => {
  switch (requestStatus.value) {
    case 'loading': return 'text-[#d97706]';
    case 'success': return 'text-[#059669]';
    case 'error': return 'text-[#dc2626]';
    default: return 'text-[#94a3b8]';
  }
});

const statusBgClass = computed((): string => {
  switch (requestStatus.value) {
    case 'loading': return 'bg-[#fef9c3]';
    case 'success': return 'bg-[#d1fae5]';
    case 'error': return 'bg-[#fee2e2]';
    default: return 'bg-[#f1f5f9]';
  }
});

// 用显式 boolean 计算属性替换模板里的 != null / != '' 条件判断
const hasResponseData = computed((): boolean => {
  return responseData.value != null;
});

const hasErrorMsg = computed((): boolean => {
  return errorMsg.value.length > 0;
});

const responseText = computed((): string => {
  const data = responseData.value;
  if (data == null)
    return '';
  return `id: ${data.id}, name: ${data.name}`;
});

const hasCloudError = computed((): boolean => {
  return cloudErrorMsg.value.length > 0;
});

const cloudStatusText = computed((): string => {
  if (cloudLoading.value)
    return '连接中';
  if (hasCloudError.value)
    return '连接失败';
  return '已连接';
});

const cloudStatusBgClass = computed((): string => {
  if (cloudLoading.value)
    return 'bg-[#fef9c3]';
  if (hasCloudError.value)
    return 'bg-[#fee2e2]';
  return 'bg-[#ccfbf1]';
});

const cloudStatusDotClass = computed((): string => {
  if (cloudLoading.value)
    return 'bg-[#d97706]';
  if (hasCloudError.value)
    return 'bg-[#dc2626]';
  return 'bg-[#0d9488]';
});

const cloudStatusTextClass = computed((): string => {
  if (cloudLoading.value)
    return 'text-[#a16207]';
  if (hasCloudError.value)
    return 'text-[#b91c1c]';
  return 'text-[#0f766e]';
});

const hasUploadError = computed((): boolean => {
  return uploadError.value.length > 0;
});

const hasUploadResult = computed((): boolean => {
  return uploadResult.value.length > 0;
});

const uploadResultText = computed((): string => {
  return uploadResult.value;
});

const hasDownloadError = computed((): boolean => {
  return downloadError.value.length > 0;
});

const hasDownloadResult = computed((): boolean => {
  return downloadFilePath.value.length > 0;
});

const downloadProgressText = computed((): string => {
  return `${downloadProgress.value}%`;
});

/** 进度条宽度：以行内 style 绑定，原生端不支持动态 class 拼接百分比宽度 */
const downloadProgressBarStyle = computed((): string => {
  return `width: ${downloadProgress.value}%;`;
});

/** 下载资源是否为图片：图片走预览，其它类型交给 openDocument */
const isDownloadImage = computed((): boolean => {
  const path = downloadFilePath.value.toLowerCase();
  return path.endsWith('.png') || path.endsWith('.jpg') || path.endsWith('.jpeg') || path.endsWith('.gif') || path.endsWith('.webp');
});

// ==========================================
// 方法
// ==========================================

/**
 * 加载 Mock 数据（本地，无需网络）
 */
async function loadMockData() {
  try {
    const pageResult = await fetchFooList(1, 100, '');
    mockList.value = pageResult.list;
    // toastSuccess(`加载了 ${pageResult.list.length} 条数据`)
  }
  catch (err) {
    console.error('loadMockData error:', err);
  }
}

/**
 * 发起真实 API 请求（演示拦截器与错误处理）
 * 使用 async/await 与 try/catch，这在 UTS 中类型推导更稳定
 */
async function fetchRealApi() {
  loading.value = true;
  requestStatus.value = 'loading';
  responseData.value = null;
  errorMsg.value = '';

  try {
    const res = await fetchFooRemote();
    responseData.value = res;
    requestStatus.value = 'success';
  }
  catch (err) {
    console.log(err, 'err');
    requestStatus.value = 'error';
    let msg = '请求失败';
    if (err instanceof Error) {
      msg = (err as Error).message;
    }
    else if (err instanceof UTSJSONObject) {
      // 用下标取值而非 getString：getString 在 TS 类型桩里被标为可能 undefined，
      // 与本项目其它位置（如 login.uvue 读 options）保持同一种写法
      const errObj = err as UTSJSONObject;
      const errMsg = (errObj['message'] as string | null) ?? (errObj['msg'] as string | null) ?? (errObj['errMsg'] as string | null);
      if (errMsg != null) {
        msg = errMsg;
      }
      else {
        msg = JSON.stringify(err);
      }
    }
    else if (err != null) {
      msg = `${err}`;
    }
    errorMsg.value = msg;
  }

  loading.value = false;
}

async function getUserInfo() {
  cloudLoading.value = true;
  cloudErrorMsg.value = '';

  try {
    const res = await uniCloud.importObject('user').getUserInfo();
    userInfo.value = JSON.stringify((res as UTSJSONObject)['data'] ?? res);
    console.log('res', res);
  }
  catch (err) {
    cloudErrorMsg.value = '云端数据获取失败，请检查 uniCloud 配置后重试';
    console.error('getUserInfo error:', err);
  }

  cloudLoading.value = false;
}

/**
 * 执行上传并展示结果
 */
async function uploadFileByPath(filePath: string) {
  const ossBaseUrl = getOssBaseUrl();
  if (ossBaseUrl == '' || ossBaseUrl.includes('xxx') || uploadPath.value == '' || uploadPath.value.includes('xxx')) {
    uploadError.value = '请在对应环境的 .env 文件中配置真实的 VITE_UPLOAD_BASEURL 与 VITE_UPLOAD_PATH';
    toast('请先在 .env 中配置真实上传地址');
    return;
  }
  uploadLoading.value = true;
  uploadError.value = '';
  uploadResult.value = '';

  try {
    const ossUrl = await uploadFooFile(filePath, true, uploadPath.value);
    uploadResult.value = ossUrl;
  }
  catch (err) {
    let msg = '上传失败';
    if (err instanceof Error) {
      msg = (err as Error).message;
    }
    else if (err != null) {
      msg = `${err}`;
    }
    uploadError.value = msg;
  }

  uploadLoading.value = false;
}

/**
 * 选择图片并上传（uploadFooFile → http.upload）
 */
function chooseAndUpload() {
  if (uploadLoading.value) {
    return;
  }
  uploadError.value = '';
  uni.chooseImage({
    count: 1,
    sourceType: ['album', 'camera'],
    success: (res) => {
      const paths = res.tempFilePaths;
      if (paths.length <= 0) {
        uploadError.value = '未选择文件';
        return;
      }
      uploadFileByPath(paths[0] as string);
    },
    fail: (err) => {
      console.log('chooseImage fail:', err);
      let errMsg = '';
      if (err != null && err.errMsg != null) {
        errMsg = `${err.errMsg}`;
      }
      // 用户主动取消时不显示为错误
      if (errMsg.includes('cancel')) {
        return;
      }
      uploadError.value = errMsg != '' ? `选择文件失败: ${errMsg}` : '选择文件失败';
    }
  });
}

/**
 * 复制 OSS 链接到剪贴板
 */
function copyUploadUrl() {
  const url = uploadResult.value;
  if (url == '') {
    return;
  }
  uni.setClipboardData({
    data: url,
    showToast: false,
    success: () => {
      toastSuccess('链接已复制');
    }
  });
}

/**
 * 点击查看图片大图
 */
function previewUploadedImage() {
  const url = uploadResult.value;
  if (url == '') {
    return;
  }
  uni.previewImage({
    urls: [url]
  });
}

// ==========================================
// 文件下载（downloadFooFile → http.downloadFile）
// ==========================================

/**
 * 下载文件并展示结果（带进度回调）
 */
async function downloadFileByUrl(url: string) {
  if (downloadLoading.value) {
    return;
  }
  if (url == '') {
    downloadError.value = '下载地址为空';
    return;
  }

  downloadLoading.value = true;
  downloadProgress.value = 0;
  downloadFilePath.value = '';
  downloadStatusCode.value = 0;
  downloadError.value = '';

  try {
    // 进度回调：在 api 层已把 DownloadTask.onProgressUpdate 换算为 0~100 的百分比
    const res = await downloadFooFile(url, (progress: number) => {
      downloadProgress.value = progress;
    });
    downloadFilePath.value = res.tempFilePath;
    downloadStatusCode.value = res.statusCode;
    downloadProgress.value = 100;
    toastSuccess('下载完成');
  }
  catch (err) {
    let msg = '下载失败';
    if (err instanceof Error) {
      msg = (err as Error).message;
    }
    else if (err != null) {
      msg = `${err}`;
    }
    downloadError.value = msg;
  }

  downloadLoading.value = false;
}

/**
 * 下载示例图片（演示完整下载流程 + 进度条）
 */
function downloadSampleFile() {
  downloadFileByUrl(FOO_DOWNLOAD_URL);
}

/**
 * 复制下载后的临时文件路径
 */
function copyDownloadPath() {
  const path = downloadFilePath.value;
  if (path == '') {
    return;
  }
  uni.setClipboardData({
    data: path,
    showToast: false,
    success: () => {
      toastSuccess('路径已复制');
    }
  });
}

/**
 * 预览下载后的文件：图片走 previewImage，其它类型交给 openDocument
 */
function previewDownloadedFile() {
  const path = downloadFilePath.value;
  if (path == '') {
    return;
  }
  uni.previewImage({
    urls: [path]
  });
}

/**
 * 打开已下载文件（图片预览 / 文档原生阅读器）
 */
function openDownloadedFile() {
  const path = downloadFilePath.value;
  if (path == '') {
    toast('请先下载文件');
    return;
  }
  if (isDownloadImage.value) {
    previewDownloadedFile();
    return;
  }
  // #ifdef APP || MP-WEIXIN
  uni.openDocument({
    filePath: path,
    success: () => {
      toastSuccess('文件已打开');
    },
    fail: () => {
      toast('当前环境无法打开该格式文件');
    }
  });
  // #endif
  // #ifndef APP || MP-WEIXIN
  toast('当前平台不支持文档预览，可在真机上体验');
  // #endif
}

// ==========================================
// 第 6 张卡：状态文案与操作函数
// 状态键一律由 hook 的 data / loading / refreshing / error 推导，页面不再自己维护 loading 布尔值
// ==========================================

/** 主请求状态键：error > refreshing > loading > success > idle，优先级即页面该显示的语义 */
const listStatusKey = computed((): string => {
  if (listRequest.error.value != null) {
    return 'error';
  }
  if (listRequest.loading.value == true) {
    if (listRequest.refreshing.value == true) {
      return 'refreshing';
    }
    return 'loading';
  }
  if (listRequest.data.value != null) {
    return 'success';
  }
  return 'idle';
});

const listStatusText = computed((): string => {
  switch (listStatusKey.value) {
    case 'loading': return '加载中';
    // refreshing 与 loading 在页面上是两种体验：前者可以继续展示旧内容，后者只能空着等
    case 'refreshing': return '刷新中';
    case 'success': return '成功';
    case 'error': return '失败';
    default: return '待发起';
  }
});

const listStatusTextClass = computed((): string => {
  switch (listStatusKey.value) {
    case 'loading': return 'text-[#d97706]';
    case 'refreshing': return 'text-[#2563eb]';
    case 'success': return 'text-[#059669]';
    case 'error': return 'text-[#dc2626]';
    default: return 'text-[#94a3b8]';
  }
});

const listStatusBgClass = computed((): string => {
  switch (listStatusKey.value) {
    case 'loading': return 'bg-[#fef9c3]';
    case 'refreshing': return 'bg-[#dbeafe]';
    case 'success': return 'bg-[#d1fae5]';
    case 'error': return 'bg-[#fee2e2]';
    default: return 'bg-[#f1f5f9]';
  }
});

const listDataText = computed((): string => {
  const data = listRequest.data.value;
  if (data == null) {
    return '暂无数据';
  }
  return `共 ${data.total} 条 · 本页 ${data.list.length} 条`;
});

const remoteStatusText = computed((): string => {
  if (remoteRequest.loading.value == true) {
    return `请求中（第 ${remoteCalls.value} 次尝试）`;
  }
  if (remoteRequest.error.value != null) {
    return '已重试后仍失败';
  }
  if (remoteRequest.data.value != null) {
    return '成功';
  }
  return '待发起';
});

const remoteStatusTextClass = computed((): string => {
  if (remoteRequest.loading.value == true) {
    return 'text-[#d97706]';
  }
  if (remoteRequest.error.value != null) {
    return 'text-[#dc2626]';
  }
  if (remoteRequest.data.value != null) {
    return 'text-[#059669]';
  }
  return 'text-[#94a3b8]';
});

const remoteStatusBgClass = computed((): string => {
  if (remoteRequest.loading.value == true) {
    return 'bg-[#fef9c3]';
  }
  if (remoteRequest.error.value != null) {
    return 'bg-[#fee2e2]';
  }
  if (remoteRequest.data.value != null) {
    return 'bg-[#d1fae5]';
  }
  return 'bg-[#f1f5f9]';
});

const remoteDetailText = computed((): string => {
  const err = remoteRequest.error.value;
  if (err != null) {
    return `错误：${err.message}`;
  }
  const data = remoteRequest.data.value;
  if (data != null) {
    return `id: ${data.id}, name: ${data.name}`;
  }
  return '未配置后端时走失败分支，正好演示重试与 error 状态';
});

const pollingButtonText = computed((): string => {
  if (pollingOn.value == true) {
    return '停止轮询';
  }
  return '开始轮询';
});

const pollingButtonClass = computed((): string => {
  if (pollingOn.value == true) {
    return 'bg-[#ef4444]';
  }
  return 'bg-[#8b5cf6]';
});

/** 发起主请求（带参），演示 send 的入参透传 */
function sendListRequest(): void {
  listRequest.send('uni');
}

/** 复用上一次 send 的入参再发一次 */
function refreshListRequest(): void {
  listRequest.refresh();
}

function abortListRequest(): void {
  listRequest.abort();
}

function sendRemoteRequest(): void {
  remoteCalls.value = 0;
  remoteRequest.send();
}

function abortRemoteRequest(): void {
  remoteRequest.abort();
}

/** 输入即送进防抖队列，窗口内的连续调用只会真正发一次 */
function handleSearchInput(): void {
  searchRequest.send(searchKeyword.value);
}

function togglePolling(): void {
  if (pollingOn.value == true) {
    pollingRequest.stopPolling();
    pollingOn.value = false;
    return;
  }
  pollingRequest.startPolling();
  pollingOn.value = true;
}

// ==========================================
// 滚动与下拉刷新
// ==========================================
function handleScroll(e: UniScrollEvent): void {
  // 预留：可用于吸顶 / 滚动进度等交互
  const top = Math.ceil(e.detail.scrollTop);
  if (top < 0) {
    console.log('scrollTop:', top);
  }
}

function handleScrollToLower(): void {
  reachBottomCount.value++;
}

onNavbarPullDownRefresh(() => {
  loadMockData();
  setTimeout(() => {
    stopNavbarPullDownRefresh();
  }, 600);
});

// 页面挂载时自动加载 Mock 数据
onMounted(() => {
  loadMockData();
  // getUserInfo();
});
</script>

<style scoped>
/* #ifdef H5 || MP-WEIXIN */
