<template>
  <view class="flex flex-col flex-1" :style="{ backgroundColor: isDark ? '#0f172a' : '#f8fafc' }">
    <scroll-view direction="vertical" class="flex-1 flex flex-col p-[16px]">
      <view
        class="rounded-[16px] p-[20px] mb-[16px] border-[1px] border-solid"
        :style="{
          backgroundColor: isDark ? '#1e293b' : '#ffffff',
          borderColor: isDark ? '#334155' : '#edf2f7'
        }"
      >
        <!-- 标题区域 -->
        <view class="flex flex-row items-center mb-[16px]">
          <view
            class="w-[4px] h-[16px] rounded-[2px] mr-[8px]"
            :style="{ backgroundColor: currentTheme }"
          />
          <text class="text-[16px] font-bold" :style="{ color: isDark ? '#ffffff' : '#2d3748' }">主题设置</text>
        </view>

        <!-- 预览区域 -->
        <view
          class="rounded-[12px] p-[16px] mb-[16px] border-[1px] border-solid items-center"
          :style="{
            backgroundColor: isDark ? '#0f172a' : '#f8fafc',
            borderColor: isDark ? '#334155' : '#e2e8f0'
          }"
        >
          <text
            class="text-[12px] mb-[8px]"
            :style="{ color: isDark ? '#94a3b8' : '#64748b' }"
          >
            主题色效果预览
          </text>

          <view
            class="mt-[10px] mx-auto w-[200px] h-[44px] rounded-[8px] flex flex-row items-center justify-center"
            :style="{ backgroundColor: currentTheme }"
          >
            <text class="text-[#ffffff] text-[14px] font-medium">主题按钮</text>
          </view>
        </view>

        <!-- 颜色选择区 -->
        <view class="flex flex-row justify-between py-[10px]">
          <view
            v-for="(item, index) in THEME_COLOR_PRESETS"
            :key="index"
            class="w-[40px] h-[40px] rounded-[20px] items-center justify-center"
            :style="{
              backgroundColor: item,
              borderWidth: currentTheme == item ? '3px' : '0px',
              borderStyle: 'solid',
              borderColor: isDark ? '#ffffff' : '#1e293b'
            }"
            @click="changeTheme(item)"
          >
            <text
              v-if="currentTheme == item"
              class="text-[16px] text-[#ffffff] font-bold"
            >
              ✓
            </text>
          </view>
        </view>

        <!-- 外观模式：跟随系统 / 浅色 / 深色 -->
        <view class="flex flex-row justify-between items-center mt-[10px] pt-[10px]">
          <text
            class="text-[14px]"
            :style="{ color: isDark ? '#ffffff' : '#2d3748' }"
          >
            外观模式
          </text>
          <view
            class="flex flex-row rounded-[8px] overflow-hidden"
            :style="{
              borderWidth: '1px',
              borderStyle: 'solid',
              borderColor: isDark ? '#334155' : '#e2e8f0'
            }"
          >
            <view
              v-for="(item, index) in themeModeOptions"
              :key="index"
              class="px-[14px] py-[8px]"
              :style="{
                backgroundColor: currentMode == item.value ? currentTheme : (isDark ? '#0f172a' : 'transparent')
              }"
              @click="changeThemeMode(item.value)"
            >
              <text
                class="text-[12px]"
                :style="{
                  color: currentMode == item.value ? '#ffffff' : (isDark ? '#94a3b8' : '#64748b')
                }"
              >
                {{ item.label }}
              </text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import { computed } from 'vue';
import { useThemeStore } from '@/src/store';
import { THEME_COLOR_PRESETS } from '@/src/theme/index.uts';
import { toast } from '@/src/utils/toast/index.uts';

definePage({
  debug: false,
  layout: 'navbar',
  showBack: true,
  hideNavbar: false,
  enablePullDownRefresh: false,
  style: {
    navigationBarTitleText: '主题设置',
    navigationStyle: 'custom'
  }
});

type ThemeModeOption = {
  label: string;
  value: string;
};

const themeStore = useThemeStore();

const currentTheme = computed((): string => themeStore.state.theme);
const currentMode = computed((): string => themeStore.state.themeMode);
const isDark = computed((): boolean => themeStore.state.isDark);

const themeModeOptions: ThemeModeOption[] = [
  { label: '跟随系统', value: 'auto' },
  { label: '浅色', value: 'light' },
  { label: '深色', value: 'dark' }
];

function changeTheme(color: string) {
  themeStore.setTheme(color);
  toast('主题色切换成功');
}

function changeThemeMode(value: string) {
  themeStore.setThemeMode(value);
  toast('外观模式切换成功');
}

onMounted(() => {
  themeStore.initThemeMode();
});
</script>

<style scoped>
</style>
