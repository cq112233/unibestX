<script setup lang="uts">
import { computed, ref } from 'vue';
import { useThemeStore } from '@/src/store/index.uts';
import {
  applyNavbarTheme,
  getSystemTheme,
  getThemeTokens,
  isDarkMode,
  THEME_COLOR_PRESETS,
  themeColor
} from '@/src/theme/index.uts';
import { toast } from '@/src/utils/toast/index.uts';

definePage({
  debug: false,
  layout: 'navbar',
  showBack: true,
  hideNavbar: false,
  enablePullDownRefresh: false,
  style: {
    navigationBarTitleText: '主题设置',
    navigationStyle: 'custom'
  }
});

// =========================================================================
// 【可选删除】以下内容仅供主题换肤演示使用，接入真实业务时可整段删除。
// =========================================================================

type ThemeModeOption = {
  label: string;
  value: string;
};

const themeStore = useThemeStore();

// —— 1. 主题状态 ——
const currentTheme = computed((): string => themeStore.state.theme);
const currentMode = computed((): string => themeStore.state.themeMode);
const isDark = computed((): boolean => themeStore.state.isDark);
/** 全局响应式主题色 ref（与 store.state.theme 同步，供非 store 场景读取） */
const globalThemeColor = computed((): string => themeColor.value);

// —— 暗黑模式自适应配色（供本页样式绑定） ——
const pageBg = computed((): string => isDark.value ? '#0f172a' : '#f8fafc');
const cardBg = computed((): string => isDark.value ? '#1e293b' : '#ffffff');
const cardBorder = computed((): string => isDark.value ? '#334155' : '#e2e8f0');
const innerBg = computed((): string => isDark.value ? '#0f172a' : '#f8fafc');
const textMain = computed((): string => isDark.value ? '#ffffff' : '#1e293b');
const textSub = computed((): string => isDark.value ? '#94a3b8' : '#64748b');

const themeModeOptions: ThemeModeOption[] = [
  { label: '跟随系统', value: 'auto' },
  { label: '浅色', value: 'light' },
  { label: '深色', value: 'dark' }
];

// —— 2. 展示用文案 ——
const isDarkText = computed((): string => isDark.value ? 'true' : 'false');

// —— 3. getThemeTokens 读取的色板 ——
const tokenNavBg = computed((): string => getThemeTokens(isDark.value).navBg);
const tokenTabBg = computed((): string => getThemeTokens(isDark.value).tabBg);
const tokenTabSelected = computed((): string => getThemeTokens(isDark.value).tabSelected);
const tokenBgContent = computed((): string => getThemeTokens(isDark.value).bgContent);

// —— 5. 系统主题 ——
/** 系统主题每次点击刷新时重新读取（避免启动时取到空值） */
const systemTheme = ref<string>(getSystemTheme());
const systemThemeText = computed((): string => systemTheme.value);
const autoDarkText = computed((): string => isDarkMode('auto', systemTheme.value) ? 'true' : 'false');

/** 切换主题主色 */
function changeTheme(color: string): void {
  themeStore.setTheme(color);
  toast('主题色切换成功');
}

/** 切换外观模式 */
function changeThemeMode(value: string): void {
  themeStore.setThemeMode(value);
  toast('外观模式切换成功');
}

/** 重新读取系统主题并刷新实际生效的亮暗状态 */
function refreshSystemTheme(): void {
  systemTheme.value = getSystemTheme();
  themeStore.refreshIsDark();
  toast(`系统主题：${systemTheme.value}`);
}

/** 按当前实际亮暗同步原生导航栏配色（H5 / 小程序） */
function syncNavbarTheme(): void {
  applyNavbarTheme(isDark.value);
  toast('已同步导航栏配色');
}

onMounted(() => {
  themeStore.initThemeMode();
});
// =================== 【可选删除】主题换肤演示 结束 ===================
</script>

<template>
  <view class="flex flex-col flex-1" :style="{ backgroundColor: pageBg }">
    <scroll-view direction="vertical" class="flex-1 flex flex-col p-[16px]">
      <!-- 用法说明 + 核心代码 -->
      <view
        class="w-full rounded-[16px] border-[1px] border-solid p-[16px] mb-[12px]"
        :style="{ backgroundColor: cardBg, borderColor: cardBorder }"
      >
        <view class="flex flex-row items-center mb-[10px]">
          <view class="w-[4px] h-[16px] rounded-[2px] mr-[8px]" :style="{ backgroundColor: currentTheme }" />
          <text class="text-[15px] font-bold" :style="{ color: textMain }">主题换肤与暗黑模式</text>
        </view>
        <text class="text-[12px] leading-[18px]" :style="{ color: textSub }">
          主题色与亮暗色板全部由 theme.json 单源驱动：useThemeStore().setTheme() 换主色、setThemeMode() 切外观模式，二者都会同步写入全局 CSS 变量（--theme-color / --bg-color / --card-bg 等）并自动持久化。跟随系统时由 initThemeMode() 监听系统深浅色变化。
        </text>
        <view class="w-full rounded-[10px] p-[12px] mt-[10px] bg-[#0f172a]">
          <text class="text-[11px] leading-[18px] text-[#e2e8f0]" :style="{ fontFamily: 'monospace' }">import { useThemeStore } from '@/src/store/index.uts';</text>
          <text class="text-[11px] leading-[18px] text-[#38bdf8] mt-[2px]" :style="{ fontFamily: 'monospace' }">const themeStore = useThemeStore();</text>
          <text class="text-[11px] leading-[18px] text-[#38bdf8] mt-[2px]" :style="{ fontFamily: 'monospace' }">themeStore.setTheme('#0957DE');</text>
          <text class="text-[11px] leading-[18px] text-[#38bdf8] mt-[2px]" :style="{ fontFamily: 'monospace' }">themeStore.setThemeMode('dark');</text>
        </view>
      </view>

      <!-- 1. 主题色换肤 -->
      <view
        class="w-full rounded-[16px] border-[1px] border-solid p-[16px] mb-[12px]"
        :style="{ backgroundColor: cardBg, borderColor: cardBorder }"
      >
        <view class="flex flex-row items-center mb-[10px]">
          <view class="w-[4px] h-[16px] rounded-[2px] mr-[8px] bg-[#0d9488]" />
          <text class="text-[14px] font-bold" :style="{ color: textMain }">1. setTheme() 切换主题主色</text>
        </view>
        <text class="text-[12px] leading-[18px]" :style="{ color: textSub }">
          点击下方色块即调用 setTheme(color)，主色会即时写入 themeColor 与 CSS 变量，所有依赖它的组件同步变色。
        </text>

        <!-- 当前主色 + 效果预览 -->
        <view
          class="w-full rounded-[12px] border-[1px] border-solid p-[12px] mt-[10px]"
          :style="{ backgroundColor: innerBg, borderColor: cardBorder }"
        >
          <view class="flex flex-row items-center justify-between mb-[10px]">
            <text class="text-[12px]" :style="{ color: textSub }">themeColor</text>
            <text class="text-[12px] font-bold" :style="{ color: textMain, fontFamily: 'monospace' }">{{ currentTheme }}</text>
          </view>
          <view
            class="mx-auto w-[200px] h-[44px] rounded-[8px] flex flex-row items-center justify-center"
            :style="{ backgroundColor: currentTheme }"
          >
            <text class="text-[14px] font-medium text-[#ffffff]">主题按钮</text>
          </view>
        </view>

        <!-- 色板：THEME_COLOR_PRESETS -->
        <view class="flex flex-row justify-between py-[10px]">
          <view
            v-for="(item, index) in THEME_COLOR_PRESETS"
            :key="index"
            class="w-[40px] h-[40px] rounded-[20px] items-center justify-center"
            :style="{
              backgroundColor: item,
              borderWidth: currentTheme == item ? '3px' : '0px',
              borderStyle: 'solid',
              borderColor: isDark ? '#ffffff' : '#1e293b'
            }"
            @click="changeTheme(item)"
          >
            <text v-if="currentTheme == item" class="text-[16px] font-bold text-[#ffffff]">✓</text>
          </view>
        </view>
        <text class="text-[11px] leading-[16px]" :style="{ color: textSub }">色板来源：THEME_COLOR_PRESETS（src/theme/index.uts）</text>
      </view>

      <!-- 2. 外观模式 -->
      <view
        class="w-full rounded-[16px] border-[1px] border-solid p-[16px] mb-[12px]"
        :style="{ backgroundColor: cardBg, borderColor: cardBorder }"
      >
        <view class="flex flex-row items-center mb-[10px]">
          <view class="w-[4px] h-[16px] rounded-[2px] mr-[8px] bg-[#7c3aed]" />
          <text class="text-[14px] font-bold" :style="{ color: textMain }">2. setThemeMode() 切换外观模式</text>
        </view>
        <text class="text-[12px] leading-[18px]" :style="{ color: textSub }">
          auto 跟随系统、light 强制浅色、dark 强制深色。App 端会同步调用 uni.setAppTheme 让原生控件跟随，H5 端写入 html 的 data-theme 与 CSS 变量。
        </text>

        <view class="flex flex-row items-center justify-between mt-[12px]">
          <text class="text-[13px]" :style="{ color: textMain }">外观模式</text>
          <view
            class="flex flex-row rounded-[8px] overflow-hidden border-[1px] border-solid"
            :style="{ borderColor: cardBorder }"
          >
            <view
              v-for="(item, index) in themeModeOptions"
              :key="index"
              class="px-[14px] py-[8px]"
              :style="{ backgroundColor: currentMode == item.value ? currentTheme : (isDark ? '#0f172a' : 'transparent') }"
              @click="changeThemeMode(item.value)"
            >
              <text
                class="text-[12px]"
                :style="{ color: currentMode == item.value ? '#ffffff' : textSub }"
              >
                {{ item.label }}
              </text>
            </view>
          </view>
        </view>

        <view class="w-full rounded-[12px] p-[12px] mt-[10px]" :style="{ backgroundColor: innerBg }">
          <view class="flex flex-row items-center justify-between mb-[6px]">
            <text class="text-[12px]" :style="{ color: textSub }">state.themeMode</text>
            <text class="text-[12px] font-bold" :style="{ color: textMain, fontFamily: 'monospace' }">{{ currentMode }}</text>
          </view>
          <view class="flex flex-row items-center justify-between">
            <text class="text-[12px]" :style="{ color: textSub }">state.isDark（实际生效）</text>
            <text class="text-[12px] font-bold" :style="{ color: isDark ? '#10b981' : '#f43f5e', fontFamily: 'monospace' }">{{ isDarkText }}</text>
          </view>
        </view>
      </view>

      <!-- 3. 主题令牌（theme.json 单源） -->
      <view
        class="w-full rounded-[16px] border-[1px] border-solid p-[16px] mb-[12px]"
        :style="{ backgroundColor: cardBg, borderColor: cardBorder }"
      >
        <view class="flex flex-row items-center mb-[10px]">
          <view class="w-[4px] h-[16px] rounded-[2px] mr-[8px] bg-[#f59e0b]" />
          <text class="text-[14px] font-bold" :style="{ color: textMain }">3. getThemeTokens() 读取色板</text>
        </view>
        <text class="text-[12px] leading-[18px]" :style="{ color: textSub }">
          getThemeTokens(isDark) 只读地取出 theme.json 的 light / dark 段（不会切换主题），用于自定义组件跟随主题。
        </text>

        <view class="w-full rounded-[12px] p-[12px] mt-[10px]" :style="{ backgroundColor: innerBg }">
          <view class="flex flex-row items-center justify-between mb-[6px]">
            <text class="text-[12px]" :style="{ color: textSub }" style-font="">navBg（导航栏背景）</text>
            <text class="text-[12px] font-bold" :style="{ color: textMain, fontFamily: 'monospace' }">{{ tokenNavBg }}</text>
          </view>
          <view class="flex flex-row items-center justify-between mb-[6px]">
            <text class="text-[12px]" :style="{ color: textSub }">tabBg（TabBar 背景）</text>
            <text class="text-[12px] font-bold" :style="{ color: textMain, fontFamily: 'monospace' }">{{ tokenTabBg }}</text>
          </view>
          <view class="flex flex-row items-center justify-between mb-[6px]">
            <text class="text-[12px]" :style="{ color: textSub }">tabSelected（选中色）</text>
            <text class="text-[12px] font-bold" :style="{ color: textMain, fontFamily: 'monospace' }">{{ tokenTabSelected }}</text>
          </view>
          <view class="flex flex-row items-center justify-between">
            <text class="text-[12px]" :style="{ color: textSub }">bgContent（页面背景）</text>
            <text class="text-[12px] font-bold" :style="{ color: textMain, fontFamily: 'monospace' }">{{ tokenBgContent }}</text>
          </view>
        </view>
      </view>

      <!-- 4. CSS 变量下发 -->
      <view
        class="w-full rounded-[16px] border-[1px] border-solid p-[16px] mb-[12px]"
        :style="{ backgroundColor: cardBg, borderColor: cardBorder }"
      >
        <view class="flex flex-row items-center mb-[10px]">
          <view class="w-[4px] h-[16px] rounded-[2px] mr-[8px] bg-[#0ea5e9]" />
          <text class="text-[14px] font-bold" :style="{ color: textMain }">4. getRootThemeStyle() 下发 CSS 变量</text>
        </view>
        <text class="text-[12px] leading-[18px]" :style="{ color: textSub }">
          根容器通过内联 :style 绑定该对象，App 原生端才会跟随 JS 变量响应式更新（CSS 变量继承在原生端必须由根元素下发）。
        </text>

        <view class="w-full rounded-[10px] p-[12px] mt-[10px] bg-[#0f172a]">
          <text class="text-[11px] leading-[18px] text-[#e2e8f0]" :style="{ fontFamily: 'monospace' }">// App.ku.uvue / layout 根 view</text>
          <text class="text-[11px] leading-[18px] text-[#38bdf8] mt-[2px]" :style="{ fontFamily: 'monospace' }">:style="getRootThemeStyle(themeColor, isDark)"</text>
          <text class="text-[11px] leading-[18px] text-[#38bdf8] mt-[2px]" :style="{ fontFamily: 'monospace' }">// → --theme-color / --bg-color / --card-bg</text>
          <text class="text-[11px] leading-[18px] text-[#38bdf8] mt-[2px]" :style="{ fontFamily: 'monospace' }">//   --border-color / --text-color / --text-secondary</text>
        </view>

        <!-- 用 CSS 变量渲染的示例块 -->
        <view class="w-full rounded-[12px] border-[1px] border-solid p-[12px] mt-[10px]" :style="{ backgroundColor: 'var(--card-bg, #ffffff)', borderColor: 'var(--border-color, #e2e8f0)' }">
          <text class="text-[12px] leading-[18px]" :style="{ color: 'var(--text-color, #1e293b)' }">
            本块背景 / 边框 / 文字均取自 CSS 变量，切换主题与外观模式时会跟着变。
          </text>
          <view class="w-full h-[6px] rounded-[3px] mt-[8px]" :style="{ backgroundColor: 'var(--theme-color, #37c2bc)' }" />
        </view>
      </view>

      <!-- 5. 系统主题与监听 -->
      <view
        class="w-full rounded-[16px] border-[1px] border-solid p-[16px] mb-[12px]"
        :style="{ backgroundColor: cardBg, borderColor: cardBorder }"
      >
        <view class="flex flex-row items-center mb-[10px]">
          <view class="w-[4px] h-[16px] rounded-[2px] mr-[8px] bg-[#2563eb]" />
          <text class="text-[14px] font-bold" :style="{ color: textMain }">5. 跟随系统与监听变化</text>
        </view>
        <text class="text-[12px] leading-[18px]" :style="{ color: textSub }">
          getSystemTheme() 读取系统深浅色（App 读 osTheme、H5 读 prefers-color-scheme、小程序读宿主主题）；initThemeMode() 注册监听，auto 模式下系统切换主题时自动跟随。
        </text>

        <view class="w-full rounded-[10px] p-[12px] mt-[10px] bg-[#0f172a]">
          <text class="text-[11px] leading-[18px] text-[#e2e8f0]" :style="{ fontFamily: 'monospace' }">// 页面 onMounted 时注册一次</text>
          <text class="text-[11px] leading-[18px] text-[#38bdf8] mt-[2px]" :style="{ fontFamily: 'monospace' }">themeStore.initThemeMode();</text>
          <text class="text-[11px] leading-[18px] text-[#38bdf8] mt-[2px]" :style="{ fontFamily: 'monospace' }">watchThemeChange(() => themeStore.refreshIsDark());</text>
        </view>

        <view class="w-full rounded-[12px] p-[12px] mt-[10px]" :style="{ backgroundColor: innerBg }">
          <view class="flex flex-row items-center justify-between mb-[6px]">
            <text class="text-[12px]" :style="{ color: textSub }">getSystemTheme()</text>
            <text class="text-[12px] font-bold" :style="{ color: textMain, fontFamily: 'monospace' }">{{ systemThemeText }}</text>
          </view>
          <view class="flex flex-row items-center justify-between">
            <text class="text-[12px]" :style="{ color: textSub }">isDarkMode('auto')</text>
            <text class="text-[12px] font-bold" :style="{ color: textMain, fontFamily: 'monospace' }">{{ autoDarkText }}</text>
          </view>
        </view>

        <view class="flex flex-row items-center mt-[10px]">
          <view class="flex-1 h-[34px] flex flex-row items-center justify-center rounded-[8px] bg-[#2563eb] mr-[8px]" @click="refreshSystemTheme">
            <text class="text-[12px] font-bold text-[#ffffff]">重新读取系统主题</text>
          </view>
          <view class="flex-1 h-[34px] flex flex-row items-center justify-center rounded-[8px] bg-[#334155]" @click="syncNavbarTheme">
            <text class="text-[12px] font-bold text-[#ffffff]">同步导航栏配色</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<style scoped></style>
