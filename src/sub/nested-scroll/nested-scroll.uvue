<template>
  <view class="flex flex-col flex-1" :class="isDark ? 'bg-[#0f172a]' : 'bg-[#f8fafc]'">
    <!-- 核心嵌套滚动场景（基于验证无误的标准容器结构） -->
    <view class="flex-1 flex flex-col relative">
      <NestedScroll
        ref="articleScrollRef"
        v-model:refreshing="articleRefreshing"
        v-model:loading="articleLoading"
        :sticky-header="true"
        :finished="articleFinished"
        :error="articleError"
        :empty="articleList.length === 0"
        :show-back-to-top="true"
        :back-to-top-threshold="200"
        :back-to-top-bottom="customBottom"
        :back-to-top-right="20"
        @refresh="onArticleRefresh"
        @load-more="onArticleLoadMore"
        @back-to-top="onBackToTop"
      >
        <!-- 粘性吸顶头部插槽：全生命周期模拟演练卡片与操作面板（向上滑动时吸附在顶部不滚出） -->
        <template #sticky>
          <view
            class="m-[14px] p-[16px] rounded-[14px] border-[1px] border-solid shadow-xs"
            :class="isDark ? 'bg-[#1e293b] border-[#334155]' : 'bg-[#e0e7ff] border-[#c7d2fe]'"
          >
            <view class="flex flex-row items-center justify-between mb-[6px]">
              <text
                class="text-[15px] font-bold"
                :class="isDark ? 'text-[#f1f5f9]' : 'text-[#1e293b]'"
              >
                🎨 全生命周期模拟演练
              </text>
              <text class="text-[10px] font-bold text-[#4f46e5] px-[6px] py-[2px] rounded-[4px] bg-[#6366f11f]">
                自研嵌套联动
              </text>
            </view>

            <!-- 实时步骤状态条 -->
            <view
              class="p-[8px] rounded-[8px] my-[8px] flex flex-row items-center border-[1px] border-solid"
              :class="isDark ? 'bg-[#0f172a]/60 border-[#334155]' : 'bg-white/80 border-[#c7d2fe]'"
            >
              <text class="text-[14px] mr-[6px]">
                {{ simStep == 1 || simStep == 2 ? '⏳' : (simStep == 3 ? (articleError ? '🚨' : '⚡') : (simStep >= 4 ? '🎉' : '💡')) }}
              </text>
              <text
                class="text-[11px] font-medium leading-[16px] flex-1"
                :class="articleError ? 'text-[#dc2626]' : (simStep >= 4 ? 'text-[#16a34a]' : (isDark ? 'text-[#38bdf8]' : 'text-[#4338ca]'))"
              >
                {{ simStatusText }}
              </text>
            </view>

            <!-- 控制操作按钮排 -->
            <view class="flex flex-row">
              <view
                class="flex-1 py-[7px] mr-[4px] rounded-[6px] bg-[#fef3c7] items-center justify-center"
                @click="triggerEmpty"
              >
                <text class="text-[10px] text-[#d97706] font-bold">清空数据</text>
              </view>
              <view
                class="flex-1 py-[7px] mr-[4px] rounded-[6px] bg-[#dcfce7] items-center justify-center"
                @click="triggerReset"
              >
                <text class="text-[10px] text-[#16a34a] font-bold">恢复重置</text>
              </view>
              <view
                class="flex-1 py-[7px] rounded-[6px] bg-[#e0e7ff] items-center justify-center"
                @click="triggerScrollToTop"
              >
                <text class="text-[10px] text-[#4338ca] font-bold">一键回顶</text>
              </view>
            </view>

            <!-- 回顶位置调节行 -->
            <view class="flex flex-row items-center justify-between mt-[8px] pt-[6px] border-t-[1px] border-solid" :class="isDark ? 'border-[#334155]' : 'border-[#c7d2fe]'">
              <text class="text-[11px]" :class="isDark ? 'text-[#94a3b8]' : 'text-[#475569]'">
                回顶按钮底部边距: <text class="font-bold text-[#3b82f6]">{{ customBottom }}px</text>
              </text>
              <view
                class="px-[8px] py-[3px] rounded-[4px] bg-[#3b82f61a] active:opacity-75"
                @click="toggleBottomPosition"
              >
                <text class="text-[10px] font-bold text-[#2563eb]">切换高度 ⇄</text>
              </view>
            </view>
          </view>
        </template>

        <!-- 1. 自定义下拉刷新插槽演示 -->
        <template #refresher>
          <view class="w-full py-[16px] flex flex-row items-center justify-center">
            <text class="text-[16px] mr-[8px]">{{ articleRefreshing ? '🚀' : '⚓' }}</text>
            <text
              class="text-[12px] font-bold"
              :class="isDark ? 'text-[#38bdf8]' : 'text-[#0957de]'"
            >
              {{ articleRefreshing ? '自定义下拉中：数据正在极速吞吐...' : '松开手指立即触发自定义刷新' }}
            </text>
          </view>
        </template>

        <!-- 2. 自定义一键返回顶部插槽演示 -->
        <template #backToTop>
          <view
            class="px-[12px] py-[8px] rounded-full flex flex-row items-center border-[1px] border-solid shadow-md active:opacity-75"
            :class="isDark ? 'bg-[#0284c7] border-[#38bdf8]' : 'bg-[#0957de] border-[#1d4ed8]'"
          >
            <uni-icons type="top" size="14" color="#ffffff" />
            <text class="text-[12px] text-white font-bold ml-[4px]">回顶</text>
          </view>
        </template>

        <!-- 列表内容：采用全端统一的标准弹性容器组件 -->
        <view v-for="item in articleList" :key="item.id" class="w-full">
          <view
            class="mx-[14px] my-[6px] p-[14px] rounded-[12px] border-[1px] border-solid flex flex-col"
            :class="isDark ? 'bg-[#1e293b] border-[#334155]' : 'bg-white border-[#e2e8f0]'"
          >
            <view class="flex flex-row items-center justify-between mb-[6px]">
              <view
                class="px-[8px] py-[2px] rounded-[4px]"
                :style="{ backgroundColor: item.categoryBg }"
              >
                <text class="text-[10px] font-bold" :style="{ color: item.categoryColor }">
                  {{ item.category }}
                </text>
              </view>
              <text class="text-[11px] text-[#94a3b8]">{{ item.time }}</text>
            </view>
            <text
              class="text-[14px] font-bold mb-[4px]"
              :class="isDark ? 'text-[#f1f5f9]' : 'text-[#1e293b]'"
            >
              {{ item.title }}
            </text>
            <text
              class="text-[12px] leading-[17px]"
              :class="isDark ? 'text-[#94a3b8]' : 'text-[#64748b]'"
            >
              {{ item.summary }}
            </text>
          </view>
        </view>

        <!-- 2. 自定义正在加载中插槽演示 -->
        <template #loading>
          <view
            class="mx-[14px] my-[10px] p-[14px] rounded-[12px] border-[1px] border-dashed flex flex-row items-center justify-center shadow-xs"
            :class="isDark ? 'bg-[#1e293b]/70 border-[#38bdf866]' : 'bg-[#eff6ff] border-[#93c5fd]'"
          >
            <text class="text-[14px] mr-[6px]">⚡</text>
            <text
              class="text-[12px] font-semibold"
              :class="isDark ? 'text-[#38bdf8]' : 'text-[#0957de]'"
            >
              自定义加载中：自研引擎正在流式计算数据...
            </text>
          </view>
        </template>

        <!-- 3. 自定义加载报错与重试插槽演示 -->
        <template #error>
          <view
            class="mx-[14px] my-[8px] p-[12px] rounded-[12px] border-[1px] border-solid flex flex-row items-center justify-between shadow-xs"
            :class="isDark ? 'bg-[#450a0a]/50 border-[#7f1d1d]' : 'bg-[#fef2f2] border-[#fecaca]'"
          >
            <view class="flex flex-row items-center flex-1 mr-[10px]">
              <text class="text-[18px] mr-[8px]">🚨</text>
              <view class="flex flex-col">
                <text class="text-[12px] font-bold text-[#dc2626]">自定义报错：服务连接暂时中断</text>
                <text class="text-[10px] text-[#ef4444] mt-[2px]">请检查网络环境或轻触右侧按钮重新拉取</text>
              </view>
            </view>
            <view
              class="px-[12px] py-[6px] rounded-[6px] bg-[#dc2626] items-center justify-center"
              @click="onArticleLoadMore"
            >
              <text class="text-[11px] font-bold text-white">立即重试</text>
            </view>
          </view>
        </template>

        <!-- 4. 自定义没有更多数据插槽演示 -->
        <template #finished>
          <view class="w-full py-[18px] flex flex-row items-center justify-center">
            <view class="w-[36px] h-[1px]" :class="isDark ? 'bg-[#334155]' : 'bg-[#cbd5e1]'" />
            <view class="mx-[10px] flex flex-row items-center">
              <text class="text-[12px] mr-[4px]">🎉</text>
              <text
                class="text-[12px] font-medium"
                :class="isDark ? 'text-[#64748b]' : 'text-[#94a3b8]'"
              >
                已展示完全部数据内容
              </text>
            </view>
            <view class="w-[36px] h-[1px]" :class="isDark ? 'bg-[#334155]' : 'bg-[#cbd5e1]'" />
          </view>
        </template>
      </NestedScroll>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed, onMounted, onUnmounted, ref } from 'vue';
import NestedScroll from '@/src/components/NestedScroll/NestedScroll.uvue';
import { useAppStore } from '@/src/store';
import { setPageScrollEnabled } from '@/src/utils/pageScroll.uts';

definePage({
  layout: 'navbar',
  showBack: true,
  hideNavbar: false,
  enablePullDownRefresh: false,
  style: {
    navigationBarTitleText: 'NestedScroll 自研嵌套滚动',
    navigationStyle: 'custom'
  }
});

const appStore = useAppStore();
const isDark = computed((): boolean => appStore.state.isDark);

// 挂载时禁用外层通用滚动，交由 NestedScroll 组件全屏独立接管
onMounted(() => {
  setPageScrollEnabled(false);
});

onUnmounted(() => {
  setPageScrollEnabled(true);
});

// -------------------------------------------------------------
// 数据模型定义（遵守规范，严禁使用 interface，全部使用 type）
// -------------------------------------------------------------
type ArticleItem = {
  id: number;
  title: string;
  summary: string;
  category: string;
  categoryBg: string;
  categoryColor: string;
  time: string;
};

// 状态机响应式变量
const articleScrollRef = ref<ComponentPublicInstance | null>(null);
const articleList = ref<ArticleItem[]>([]);
const articleRefreshing = ref<boolean>(false);
const articleLoading = ref<boolean>(false);
const articleFinished = ref<boolean>(false);
const articleError = ref<boolean>(false);

// 状态机步骤控制：1=首批不足一屏, 2=自动调接口补齐中, 3=铺满待触底报错, 4=报错重试中, 5=全部加载完成
const simStep = ref<number>(1);
const simStatusText = ref<string>('【第 1 步】首次加载 2 条数据（未超出底部），800ms后将自动掉接口补齐...');

// 辅助方法：生成标准资讯数据项
function generateArticlesData(start: number, count: number, stageName: string): ArticleItem[] {
  const list: ArticleItem[] = [];
  const categories = ['原生渲染', '性能调优', '工程化', 'UTS深度解析'];
  const bgs = ['#e0e7ff', '#fef3c7', '#dcfce7', '#f3e8ff'];
  const colors = ['#4338ca', '#d97706', '#16a34a', '#7e22ce'];

  for (let i = start; i < start + count; i++) {
    const cIdx = i % 4;
    list.push({
      id: i,
      title: `uni-app X 极速体验与架构实践 #${i}（${stageName}）`,
      summary: `流式数据单元 #${i}，手势平滑通透，支持超高刷流畅滑动，无缝嵌套联动。`,
      category: categories[cIdx],
      categoryBg: bgs[cIdx],
      categoryColor: colors[cIdx],
      time: '刚刚'
    } as ArticleItem);
  }
  return list;
}

// 第 2 步：自动掉接口补齐数据（超出底部一屏）
function autoLoadFillScreen(): void {
  simStep.value = 2;
  articleLoading.value = true;
  simStatusText.value = '【第 2 步】检测到数据未超出底部，正在自动调用接口追加数据...';

  setTimeout(() => {
    // 追加 6 条数据，累计达到 8 条（总高度逾 1000px，页面已铺满并超出底部）
    const nextData = generateArticlesData(3, 6, '自动补齐数据');
    const combined: ArticleItem[] = [];
    for (let i = 0; i < articleList.value.length; i++) {
      combined.push(articleList.value[i]);
    }
    for (let i = 0; i < nextData.length; i++) {
      combined.push(nextData[i]);
    }
    articleList.value = combined;
    articleLoading.value = false;
    simStep.value = 3;
    simStatusText.value = '【第 2 步完成】数据已超出屏幕！请向上滑动触底，第3次加载将模拟报错(500)';
  }, 1000);
}

// 上拉加载更多 / 错误重试处理函数
function onArticleLoadMore(): void {
  if (articleFinished.value) {
    return;
  }

  // 场景 A：当前处于第 3 步且尚未报错 -> 触底模拟接口报错 500
  if (simStep.value == 3 && !articleError.value) {
    articleLoading.value = true;
    simStatusText.value = '【第 3 步进行中】正在发起第 3 次请求... 模拟网络 500 异常';

    setTimeout(() => {
      articleLoading.value = false;
      articleError.value = true;
      simStatusText.value = '【第 3 步报错】模拟 500 接口异常！请点击底部「点击重试」再次加载';
      uni.showToast({
        title: '模拟接口异常：500 Internal Error',
        icon: 'none'
      });
    }, 700);
    return;
  }

  // 场景 B：当前处于报错态，用户点击了「点击重试」再次加载
  if (articleError.value) {
    articleError.value = false;
    articleLoading.value = true;
    simStep.value = 4;
    simStatusText.value = '【第 4 步】已发起重试请求，正在重新拉取接口数据...';

    setTimeout(() => {
      // 成功拉取最后 2 条终态数据
      const finalItems = generateArticlesData(9, 2, '终态数据');
      const combined: ArticleItem[] = [];
      for (let i = 0; i < articleList.value.length; i++) {
        combined.push(articleList.value[i]);
      }
      for (let i = 0; i < finalItems.length; i++) {
        combined.push(finalItems[i]);
      }
      articleList.value = combined;
      articleLoading.value = false;
      articleFinished.value = true;
      simStep.value = 5;
      simStatusText.value = '【全部完成】🎉 重试成功！没有更多数据了（下拉列表可重新再来一遍）';

      uni.showToast({
        title: '重试成功！数据已全部加载',
        icon: 'success'
      });
    }, 800);
    return;
  }

  // 兜底普通加载
  articleLoading.value = true;
  setTimeout(() => {
    articleLoading.value = false;
  }, 600);
}

// 开始 / 重新启动完整模拟
function startFullSimulation(): void {
  articleError.value = false;
  articleFinished.value = false;
  articleRefreshing.value = false;
  articleLoading.value = false;
  // 首次仅加载 2 条数据（未超出底部）
  articleList.value = generateArticlesData(1, 2, '首批数据');
  simStep.value = 1;
  simStatusText.value = '【第 1 步】首批返回 2 条数据（未超出底部），正在启动自动补齐...';

  // 400ms 后自动触发第 2 步展示 loading UI 并掉接口补齐
  setTimeout(() => {
    if (simStep.value == 1) {
      autoLoadFillScreen();
    }
  }, 400);
}

// 下拉刷新：重新再来一遍完整模拟
function onArticleRefresh(): void {
  articleRefreshing.value = true;
  articleError.value = false;
  articleFinished.value = false;
  articleLoading.value = false;
  simStep.value = 1;
  simStatusText.value = '【下拉刷新中】正在极速吞吐拉取首批数据...';

  // 模拟真实的接口请求耗时（700ms），给予流畅的下拉刷新视觉与回弹反馈
  setTimeout(() => {
    // 1. 重新生成并赋值首批 2 条数据
    articleList.value = generateArticlesData(1, 2, '首批数据');

    // 2. 结束下拉刷新，收起动画
    articleRefreshing.value = false;

    simStatusText.value = '【第 1 步】首批仅返回 2 条数据（未超出底部），正在自动补齐...';
    uni.showToast({ title: '刷新成功，正在追加数据', icon: 'none' });

    // 3. 400ms 后自动触发第 2 步展示 loading UI 补齐超出底部
    setTimeout(() => {
      if (simStep.value == 1) {
        autoLoadFillScreen();
      }
    }, 400);
  }, 700);
}

function triggerEmpty(): void {
  articleList.value = [];
  articleError.value = false;
  articleFinished.value = true;
  simStep.value = 5;
  simStatusText.value = '【已清空数据】触发空列表缺省兜底展示';
  uni.showToast({ title: '已清空数据，触发空态兜底', icon: 'none' });
}

function triggerReset(): void {
  startFullSimulation();
  uni.showToast({ title: '已重新开始完整流程模拟', icon: 'success' });
}

const customBottom = ref<number>(120);

function toggleBottomPosition(): void {
  if (customBottom.value == 120) {
    customBottom.value = 160;
  }
  else {
    customBottom.value = 120;
  }
  uni.showToast({
    title: `回顶按钮底部边距设为 ${customBottom.value}px`,
    icon: 'none'
  });
}

function triggerScrollToTop(): void {
  articleScrollRef.value?.$callMethod('scrollToTop', true);
}

function onBackToTop(): void {
  uni.showToast({ title: '已平滑滚动返回顶部', icon: 'none' });
}

// 页面初次进入，立即执行首次模拟
startFullSimulation();
</script>

<style scoped></style>
