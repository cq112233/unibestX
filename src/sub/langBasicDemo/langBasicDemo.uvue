<script setup lang="uts">
import { computed } from 'vue';
import { $t, getI18nText, isI18nKeyLike, setNavigationBarTitle } from '@/src/i18n/utils/index.uts';
import { useI18nStore } from '@/src/store/index.uts';
import { setTabbarItem } from '@/src/tabbar/index.uts';
import { toast } from '@/src/utils/toast/index.uts';

definePage({
  debug: false,
  layout: 'navbar',
  showBack: true,
  hideNavbar: false,
  enablePullDownRefresh: false,
  style: {
    navigationBarTitleText: '国际化多语言',
    navigationStyle: 'custom'
  }
});

// =========================================================================
// 【可选删除】以下内容仅供 i18n 多语言演示使用，接入真实业务时可整段删除。
// =========================================================================

type LanguageOption = {
  label: string;
  value: string;
};

const i18nStore = useI18nStore();

// —— 卡片文案（自身也走 i18n，切换语言后整页同步刷新）——
const langUsageTitle = computed((): string => $t('basic.langUsageTitle'));
const langUsageDesc = computed((): string => $t('basic.langUsageDesc'));
const langTitle = computed((): string => $t('basic.langTitle'));
const langPreview = computed((): string => $t('basic.langPreview'));
const langCurLocale = computed((): string => $t('basic.langCurLocale'));
const langCardTrans = computed((): string => $t('basic.langCardTrans'));
const langCardTransDesc = computed((): string => $t('basic.langCardTransDesc'));
const langCardNamed = computed((): string => $t('basic.langCardNamed'));
const langCardNamedDesc = computed((): string => $t('basic.langCardNamedDesc'));
const langCardTextUtil = computed((): string => $t('basic.langCardTextUtil'));
const langCardTextUtilDesc = computed((): string => $t('basic.langCardTextUtilDesc'));
const langCardTitle = computed((): string => $t('basic.langCardTitle'));
const langCardTitleDesc = computed((): string => $t('basic.langCardTitleDesc'));
const langCardSwitch = computed((): string => $t('basic.langCardSwitch'));
const langCardSwitchDesc = computed((): string => $t('basic.langCardSwitchDesc'));
const langFallback = computed((): string => $t('basic.langFallback'));
const langPlainText = computed((): string => $t('basic.langPlainText'));
const langSetTitleBtn = computed((): string => $t('basic.langSetTitleBtn'));
const langSetPreviewBtn = computed((): string => $t('basic.langSetPreviewBtn'));
const langSwitchZh = computed((): string => $t('basic.langSwitchZh'));
const langSwitchEn = computed((): string => $t('basic.langSwitchEn'));

// —— 实时预览文案 ——
const welcomeText = computed((): string => $t('message.welcome'));
const helloText = computed((): string => $t('message.hello', { msg: 'hi' }));

/** 当前语言（来自 store，切换后驱动全页响应式刷新） */
const currentLocale = computed((): string => i18nStore.state.locale);

const languageOptions: LanguageOption[] = [
  { label: '简体中文', value: 'zh-CN' },
  { label: 'English', value: 'en-US' }
];

// —— 1. $t 基础翻译演示 ——
const tBasicWelcome = computed((): string => $t('message.welcome'));
const tBasicTitle = computed((): string => $t('basic.langTitle'));
const tBasicTabHome = computed((): string => $t('tabbar.home'));
/** 故意取一个不存在的 key：$t 会原样返回 key 本身 */
const tMissingKey = computed((): string => $t('demo.not.exist.key'));

// —— 2. 具名插值演示 ——
const tNamedHello = computed((): string => $t('message.hello', { msg: 'hi' }));

// —— 3. getI18nText 与 key 形态判断演示 ——
/** 形如 key：正常翻译 */
const tTextByKey = computed((): string => getI18nText('basic.langPreview'));
/** 显式 %key% 包装：强制走翻译 */
const tTextByWrapped = computed((): string => getI18nText('%basic.langPreview%'));
/** 中文原文：非 key 形态，原样返回（不查询、不产生缺失 key 噪音） */
const tTextByPlain = computed((): string => getI18nText('语言设置'));
const keyLikeTrue = computed((): string => isI18nKeyLike('tabbar.home') ? 'true' : 'false');
const keyLikeFalse = computed((): string => isI18nKeyLike('语言设置') ? 'true' : 'false');

// —— 4. 动态设置导航栏标题 ——
function onSetTitleByLang(): void {
  setNavigationBarTitle('basic.langTitle');
  toast($t('basic.langTitle'));
}

function onSetTitleByPreview(): void {
  setNavigationBarTitle('basic.langPreview');
  toast($t('basic.langPreview'));
}

// —— 5. 切换语言（同步 TabBar 文案 + 持久化） ——
function switchLanguage(lang: string): void {
  i18nStore.setLocale(lang);
  setTabbarItem();
  toast($t('message.switch_success'));
}
// =================== 【可选删除】i18n 多语言演示 结束 ===================
</script>

<template>
  <view class="flex flex-col flex-1 bg-[#f8fafc]">
    <scroll-view direction="vertical" class="flex-1 flex flex-col p-[16px]">
      <!-- 用法说明 + 核心代码 -->
      <view class="w-full rounded-[16px] bg-[#ffffff] border-[1px] border-solid border-[#e2e8f0] p-[16px] mb-[12px]">
        <view class="flex flex-row items-center mb-[10px]">
          <view class="w-[4px] h-[16px] rounded-[2px] mr-[8px] bg-[#2563eb]" />
          <text class="text-[15px] font-bold text-[#1e293b]">{{ langUsageTitle }}</text>
        </view>
        <text class="text-[12px] leading-[18px] text-[#64748b]">{{ langUsageDesc }}</text>
        <view class="w-full rounded-[10px] bg-[#0f172a] p-[12px] mt-[10px]">
          <text class="text-[11px] leading-[18px] text-[#e2e8f0]" style="font-family: monospace;">import { $t, getI18nText } from '@/src/i18n/utils/index.uts';</text>
          <text class="text-[11px] leading-[18px] text-[#38bdf8] mt-[2px]" style="font-family: monospace;">const text = $t('message.welcome');</text>
          <text class="text-[11px] leading-[18px] text-[#38bdf8] mt-[2px]" style="font-family: monospace;">const named = $t('message.hello', { msg: 'hi' });</text>
          <text class="text-[11px] leading-[18px] text-[#38bdf8] mt-[2px]" style="font-family: monospace;">useI18nStore().setLocale('en-US');</text>
        </view>
      </view>

      <!-- 当前语言 + 实时预览 + 语言切换列表 -->
      <view class="w-full rounded-[16px] bg-[#ffffff] border-[1px] border-solid border-[#e2e8f0] p-[16px] mb-[12px]">
        <view class="flex flex-row items-center mb-[10px]">
          <view class="w-[4px] h-[16px] rounded-[2px] mr-[8px] bg-[#0d9488]" />
          <text class="text-[14px] font-bold text-[#1e293b]">{{ langTitle }}</text>
        </view>

        <view class="flex flex-row items-center justify-between mb-[10px]">
          <text class="text-[12px] text-[#64748b] mr-[10px]">{{ langCurLocale }}</text>
          <text class="text-[12px] font-bold text-[#0d9488]" style="font-family: monospace;">{{ currentLocale }}</text>
        </view>

        <!-- 实时预览：切换语言后下面所有文案即时刷新 -->
        <view class="w-full rounded-[12px] bg-[#f8fafc] border-[1px] border-solid border-[#e2e8f0] p-[12px]">
          <text class="text-[12px] mb-[6px] text-[#94a3b8]">{{ langPreview }}</text>
          <text class="text-[16px] font-bold text-[#1e293b]">{{ welcomeText }}</text>
          <text class="text-[14px] mt-[8px] text-[#475569]">{{ helloText }}</text>
        </view>

        <!-- 语言选项列表 -->
        <view
          v-for="(item, index) in languageOptions"
          :key="index"
        >
          <view
            class="flex-row items-center justify-between py-[12px]"
            @click="switchLanguage(item.value)"
          >
            <view class="flex-row items-center">
              <text
                class="text-[15px] font-medium"
                :class="currentLocale == item.value ? 'text-[#3b82f6]' : 'text-[#334155]'"
              >
                {{ item.label }}
              </text>
            </view>
            <view class="flex-row items-center">
              <uni-icons
                v-if="currentLocale == item.value"
                type="checkmarkempty"
                size="20"
                color="#0957de"
              />
            </view>
          </view>
          <view
            v-if="index < languageOptions.length - 1"
            class="h-[1px] bg-[#f1f5f9]"
          />
        </view>
      </view>

      <!-- 1. $t 基础翻译 -->
      <view class="w-full rounded-[16px] bg-[#ffffff] border-[1px] border-solid border-[#e2e8f0] p-[16px] mb-[12px]">
        <view class="flex flex-row items-center mb-[10px]">
          <view class="w-[4px] h-[16px] rounded-[2px] mr-[8px] bg-[#7c3aed]" />
          <text class="text-[14px] font-bold text-[#1e293b]">{{ langCardTrans }}</text>
        </view>
        <text class="text-[12px] leading-[18px] text-[#64748b]">{{ langCardTransDesc }}</text>

        <view class="flex flex-row items-start justify-between mt-[10px] mb-[6px]">
          <text class="text-[12px] text-[#64748b] mr-[10px]" style="font-family: monospace;">$t('message.welcome')</text>
          <text class="text-[12px] font-bold text-[#1e293b] flex-1 text-right">{{ tBasicWelcome }}</text>
        </view>
        <view class="flex flex-row items-start justify-between mb-[6px]">
          <text class="text-[12px] text-[#64748b] mr-[10px]" style="font-family: monospace;">$t('basic.langTitle')</text>
          <text class="text-[12px] font-bold text-[#1e293b] flex-1 text-right">{{ tBasicTitle }}</text>
        </view>
        <view class="flex flex-row items-start justify-between mb-[6px]">
          <text class="text-[12px] text-[#64748b] mr-[10px]" style="font-family: monospace;">$t('tabbar.home')</text>
          <text class="text-[12px] font-bold text-[#1e293b] flex-1 text-right">{{ tBasicTabHome }}</text>
        </view>

        <!-- 未命中 key 的回退 -->
        <view class="w-full rounded-[12px] bg-[#fffbeb] border-[1px] border-solid border-[#fef3c7] p-[12px] mt-[6px]">
          <text class="text-[12px] font-bold text-[#b45309]">{{ langFallback }}</text>
          <view class="flex flex-row items-start justify-between mt-[6px]">
            <text class="text-[12px] text-[#b45309] mr-[10px]" style="font-family: monospace;">$t('demo.not.exist.key')</text>
            <text class="text-[12px] font-bold text-[#b45309] flex-1 text-right" style="font-family: monospace;">{{ tMissingKey }}</text>
          </view>
        </view>
      </view>

      <!-- 2. 具名插值 -->
      <view class="w-full rounded-[16px] bg-[#ffffff] border-[1px] border-solid border-[#e2e8f0] p-[16px] mb-[12px]">
        <view class="flex flex-row items-center mb-[10px]">
          <view class="w-[4px] h-[16px] rounded-[2px] mr-[8px] bg-[#f59e0b]" />
          <text class="text-[14px] font-bold text-[#1e293b]">{{ langCardNamed }}</text>
        </view>
        <text class="text-[12px] leading-[18px] text-[#64748b]">{{ langCardNamedDesc }}</text>

        <view class="w-full rounded-[12px] bg-[#f8fafc] p-[12px] mt-[10px]">
          <text class="text-[12px] text-[#64748b]" style="font-family: monospace;">$t('message.hello', { msg: 'hi' })</text>
          <text class="text-[14px] font-bold text-[#f59e0b] mt-[6px]">{{ tNamedHello }}</text>
        </view>

        <view class="w-full rounded-[10px] bg-[#0f172a] p-[12px] mt-[10px]">
          <text class="text-[11px] leading-[18px] text-[#e2e8f0]" style="font-family: monospace;">// zh-CN.json → "hello": "{msg}，世界！"</text>
          <text class="text-[11px] leading-[18px] text-[#38bdf8] mt-[2px]" style="font-family: monospace;">// en-US.json → "hello": "The world says {msg}!"</text>
        </view>
      </view>

      <!-- 3. getI18nText 与 key 形态判断 -->
      <view class="w-full rounded-[16px] bg-[#ffffff] border-[1px] border-solid border-[#e2e8f0] p-[16px] mb-[12px]">
        <view class="flex flex-row items-center mb-[10px]">
          <view class="w-[4px] h-[16px] rounded-[2px] mr-[8px] bg-[#0ea5e9]" />
          <text class="text-[14px] font-bold text-[#1e293b]">{{ langCardTextUtil }}</text>
        </view>
        <text class="text-[12px] leading-[18px] text-[#64748b]">{{ langCardTextUtilDesc }}</text>

        <view class="flex flex-row items-start justify-between mt-[10px] mb-[6px]">
          <text class="text-[12px] text-[#64748b] mr-[10px]" style="font-family: monospace;">getI18nText('basic.langPreview')</text>
          <text class="text-[12px] font-bold text-[#1e293b] flex-1 text-right">{{ tTextByKey }}</text>
        </view>
        <view class="flex flex-row items-start justify-between mb-[6px]">
          <text class="text-[12px] text-[#64748b] mr-[10px]" style="font-family: monospace;">getI18nText('%basic.langPreview%')</text>
          <text class="text-[12px] font-bold text-[#1e293b] flex-1 text-right">{{ tTextByWrapped }}</text>
        </view>
        <view class="flex flex-row items-start justify-between mb-[6px]">
          <text class="text-[12px] text-[#64748b] mr-[10px]">{{ langPlainText }}</text>
          <text class="text-[12px] font-bold text-[#1e293b] flex-1 text-right">{{ tTextByPlain }}</text>
        </view>

        <view class="w-full rounded-[12px] bg-[#f8fafc] p-[12px] mt-[6px]">
          <view class="flex flex-row items-center justify-between mb-[6px]">
            <text class="text-[12px] text-[#64748b] mr-[10px]" style="font-family: monospace;">isI18nKeyLike('tabbar.home')</text>
            <text class="text-[12px] font-bold text-[#10b981]" style="font-family: monospace;">{{ keyLikeTrue }}</text>
          </view>
          <view class="flex flex-row items-center justify-between">
            <text class="text-[12px] text-[#64748b] mr-[10px]" style="font-family: monospace;">isI18nKeyLike('语言设置')</text>
            <text class="text-[12px] font-bold text-[#f43f5e]" style="font-family: monospace;">{{ keyLikeFalse }}</text>
          </view>
        </view>
      </view>

      <!-- 4. 动态设置导航栏标题 -->
      <view class="w-full rounded-[16px] bg-[#ffffff] border-[1px] border-solid border-[#e2e8f0] p-[16px] mb-[12px]">
        <view class="flex flex-row items-center mb-[10px]">
          <view class="w-[4px] h-[16px] rounded-[2px] mr-[8px] bg-[#2563eb]" />
          <text class="text-[14px] font-bold text-[#1e293b]">{{ langCardTitle }}</text>
        </view>
        <text class="text-[12px] leading-[18px] text-[#64748b]">{{ langCardTitleDesc }}</text>

        <view class="w-full rounded-[10px] bg-[#0f172a] p-[12px] mt-[10px]">
          <text class="text-[11px] leading-[18px] text-[#e2e8f0]" style="font-family: monospace;">import { setNavigationBarTitle } from '@/src/i18n/utils/index.uts';</text>
          <text class="text-[11px] leading-[18px] text-[#38bdf8] mt-[2px]" style="font-family: monospace;">setNavigationBarTitle('basic.langTitle');</text>
        </view>

        <view class="flex flex-row items-center mt-[10px]">
          <view class="flex-1 h-[34px] flex flex-row items-center justify-center rounded-[8px] bg-[#2563eb] mr-[8px]" @click="onSetTitleByLang">
            <text class="text-[12px] font-bold text-[#ffffff]">{{ langSetTitleBtn }}</text>
          </view>
          <view class="flex-1 h-[34px] flex flex-row items-center justify-center rounded-[8px] bg-[#334155]" @click="onSetTitleByPreview">
            <text class="text-[12px] font-bold text-[#ffffff]">{{ langSetPreviewBtn }}</text>
          </view>
        </view>
      </view>

      <!-- 5. 切换语言（含 TabBar 联动） -->
      <view class="w-full rounded-[16px] bg-[#ffffff] border-[1px] border-solid border-[#e2e8f0] p-[16px] mb-[12px]">
        <view class="flex flex-row items-center mb-[10px]">
          <view class="w-[4px] h-[16px] rounded-[2px] mr-[8px] bg-[#7c3aed]" />
          <text class="text-[14px] font-bold text-[#1e293b]">{{ langCardSwitch }}</text>
        </view>
        <text class="text-[12px] leading-[18px] text-[#64748b]">{{ langCardSwitchDesc }}</text>

        <view class="w-full rounded-[10px] bg-[#0f172a] p-[12px] mt-[10px]">
          <text class="text-[11px] leading-[18px] text-[#e2e8f0]" style="font-family: monospace;">i18nStore.setLocale('en-US'); // 同步 i18n.global.locale + 持久化</text>
          <text class="text-[11px] leading-[18px] text-[#38bdf8] mt-[2px]" style="font-family: monospace;">setTabbarItem();           // 刷新自定义 TabBar 文案</text>
        </view>

        <view class="flex flex-row items-center mt-[10px]">
          <view class="flex-1 h-[34px] flex flex-row items-center justify-center rounded-[8px] bg-[#7c3aed] mr-[8px]" @click="switchLanguage('zh-CN')">
            <text class="text-[12px] font-bold text-[#ffffff]">{{ langSwitchZh }}</text>
          </view>
          <view class="flex-1 h-[34px] flex flex-row items-center justify-center rounded-[8px] bg-[#7c3aed]" @click="switchLanguage('en-US')">
            <text class="text-[12px] font-bold text-[#ffffff]">{{ langSwitchEn }}</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<style scoped></style>
