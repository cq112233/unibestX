<script setup lang="uts">
import { setTheme } from '@/uni_modules/rice-ui/index.uts';
import { ref } from 'vue';

definePage({
  layout: 'navbar',
  showBack: true,
  hideNavbar: false,
  enablePullDownRefresh: false,
  style: {
    navigationBarTitleText: 'Rice UI 组件演示',
    navigationStyle: 'custom'
  }
});

const isDarkMode = ref(false);

function toggleTheme() {
  isDarkMode.value = !isDarkMode.value;
  setTheme(isDarkMode.value ? 'dark' : 'light');
}

function goToDemo(page: string) {
  uni.navigateTo({
    url: `/src/sub/riceuiBasicDemo/demos/${page}/${page}`,
    fail: (err) => {
      console.error('goToDemo fail:', err);
      uni.showToast({
        title: `打开 ${page} 页面失败`,
        icon: 'none'
      });
    }
  });
}
</script>
