<!--
  ========================================================================
  TabBar 液态玻璃 UI 组件 (Custom Liquid Glass Floating Dock TabBar)
  基于 glass-effect-view 组件（iOS 26+ 原生系统级液态玻璃，多端优雅降级毛玻璃）
  文档参考：https://doc.dcloud.net.cn/uni-app-x/component/glass-effect-view.html
  ========================================================================
-->
<script setup lang="uts">
import { computed, onMounted, onUnmounted } from 'vue';
import {
  activeThemeColor,
  curIdx,
  customTabbarConfig,
  formatTabbarText,
  handleTabbarClick,
  isDark,
  resetTabSwitchThrottle,
  safeHideNativeTabBar,
  safeRestoreNativeTabBar,
  syncCurIdxByCurrentPage,
  tabbarList,
  themeTokens
} from '@/src/tabbar/index.uts';
import { safeAreaInsets } from '@/src/utils/systemInfo/index.uts';

const props = defineProps({
  /** 悬浮 TabBar 容器高度（默认 64px） */
  height: {
    type: Number,
    default: 64
  },
  /** 底部与屏幕边缘的间距（默认 12px） */
  bottomOffset: {
    type: Number,
    default: 12
  },
  /** 是否渲染底部占位块（默认 false） */
  showPlaceholder: {
    type: Boolean,
    default: false
  },
  /** 玻璃效果样式：'regular'（常规）| 'clear'（通透）（仅 iOS 26+ 生效） */
  glassStyle: {
    type: String,
    default: 'regular'
  },
  /** 是否启用液态玻璃交互行为（仅 iOS 26+ 生效，底座 TabBar 默认设为 false 避免原生拦截点击手势） */
  interactive: {
    type: Boolean,
    default: false
  },
  /** 施加在液态玻璃效果上的着色（仅 iOS 26+ 生效） */
  tintColor: {
    type: String,
    default: ''
  }
});

/** 解析液态玻璃样式（优先取 prop，未传时读取 config.uts 中的 glassStyle） */
const resolvedGlassStyle = computed<string>((): string => {
  if (props.glassStyle != '') {
    return props.glassStyle;
  }
  if (customTabbarConfig.glassStyle != null && customTabbarConfig.glassStyle != '') {
    return customTabbarConfig.glassStyle!;
  }
  return 'regular';
});

/** 是否启用液态玻璃交互（优先读取 config.uts 中的 interactive，未配时使用 prop 默认值） */
const resolvedInteractive = computed<boolean>((): boolean => {
  if (customTabbarConfig.interactive != null) {
    return customTabbarConfig.interactive!;
  }
  return props.interactive;
});

/** 解析液态玻璃着色（优先取 prop，未传时读取 config.uts 中的 tintColor） */
const resolvedTintColor = computed<string>((): string => {
  if (props.tintColor != '') {
    return props.tintColor;
  }
  if (customTabbarConfig.tintColor != null && customTabbarConfig.tintColor != '') {
    return customTabbarConfig.tintColor!;
  }
  return '';
});

/** 悬浮液态玻璃底座背景色（半透明通透质感，确保在浅色背景下清晰可见） */
const glassBgColor = computed<string>((): string => {
  if (isDark.value) {
    return 'rgba(15, 23, 42, 0.85)';
  }
  return 'rgba(255, 255, 255, 0.88)';
});

/** 悬浮液态玻璃底座边框色（液态流光微反差边框） */
const glassBorderColor = computed<string>((): string => {
  if (isDark.value) {
    return 'rgba(255, 255, 255, 0.18)';
  }
  return 'rgba(226, 232, 240, 0.95)';
});

/** 安全区底部高度 */
const safeAreaBottom = computed<number>((): number => {
  const insets = safeAreaInsets.value;
  return insets != null ? insets.bottom : 0;
});

/** 激活项的高亮流体气泡底色 */
const activeItemBgColor = computed<string>((): string => {
  if (isDark.value) {
    return '#ffffff';
  }
  return activeThemeColor.value;
});

/** 激活项高亮流体气泡的不透明度（适当增强至 0.18，确保激活状态底色清晰饱满） */
const activeItemBgOpacity = computed<number>((): number => {
  return isDark.value ? 0.2 : 0.18;
});

/** 滑块单项宽度占比（百分比） */
const sliderWidthPercent = computed<number>((): number => {
  if (tabbarList.length == 0) {
    return 25;
  }
  return 100 / tabbarList.length;
});

/** 滑块样式：根据当前选中项索引动态计算水平位移 */
const sliderStyle = computed<string>((): string => {
  const widthPct = sliderWidthPercent.value;
  const offsetPct = curIdx.value * 100;
  return `width: ${widthPct}%;transform: translateX(${offsetPct}%);`;
});

let isMounted = false;

// 挂载时同步激活索引并确保原生 TabBar 隐藏
onMounted(() => {
  isMounted = true;
  syncCurIdxByCurrentPage();
  safeHideNativeTabBar();
});

// 卸载时彻底清理异步资源、还原原生 TabBar 并重置切换节流锁
onUnmounted(() => {
  isMounted = false;
  safeRestoreNativeTabBar();
  resetTabSwitchThrottle();
});

/** 处理 Tab 点击 */
function onTabClick(index: number) {
  if (!isMounted) {
    return;
  }
  handleTabbarClick(index);
}

/** 获取多语言翻译文本 */
function getText(text: string): string {
  return formatTabbarText(text);
}

/** 获取图标字体名称 */
function getItemIcon(index: number): string {
  if (tabbarList.length <= index) {
    return '';
  }
  const item = tabbarList[index];
  if (curIdx.value == index && item.iconActive.length > 0) {
    return item.iconActive;
  }
  return item.icon;
}

/** 获取图标图片路径 */
function getItemIconPath(index: number): string {
  if (tabbarList.length <= index) {
    return '';
  }
  const item = tabbarList[index];
  if (curIdx.value == index && item.selectedIconPath != null && item.selectedIconPath!.length > 0) {
    return item.selectedIconPath!;
  }
  return item.iconPath != null ? item.iconPath! : '';
}

/** 获取图标颜色 */
function getItemIconColor(index: number): string {
  return curIdx.value == index ? activeThemeColor.value : themeTokens.value.tabColor;
}

/** 获取文字颜色 */
function getItemTextColor(index: number): string {
  return curIdx.value == index ? activeThemeColor.value : themeTokens.value.tabColor;
}

/** 获取文字字重 */
function getItemFontWeight(index: number): string {
  return curIdx.value == index ? '600' : 'normal';
}

/** 适配底部安全区高度 */
const bottom = computed<string>((): string => {
  if (safeAreaBottom.value == 0) {
    return `${props.bottomOffset}`;
  }
  return `${props.bottomOffset + safeAreaBottom.value - 12}`;
});
</script>

<template>
  <view class="custom-glass-wrapper">
    <!-- 底部占位块：防止页面底部内容被悬浮 Tab 栏遮挡 -->
    <view
      v-if="showPlaceholder"
      class="custom-glass-placeholder"
      :style="{ height: `${height + bottomOffset * 2 + safeAreaBottom}px` }"
    />

    <!-- #ifdef APP-IOS -->
    <!-- iOS 原生液态玻璃视图容器 (外层使用标准 view 胶囊外壳强制 34px 圆角裁切与边框投影，内部承载原生液态玻璃) -->
    <view
      class="custom-glass-container"
      :style="{
        bottom: `${bottom}px`,
        height: `${height}px`,
        borderColor: glassBorderColor
      }"
    >
      <glass-effect-view
        class="custom-glass-inner"
        :glass-style="resolvedGlassStyle"
        :interactive="resolvedInteractive"
        :tint-color="resolvedTintColor"
        :style="{
          backgroundColor: glassBgColor
        }"
      >
        <!-- 滑动滑块：在各 Tab 底部平滑移动的流体高光气泡 -->
        <view class="glass-slider-track">
          <view class="glass-slider" :style="sliderStyle">
            <view class="glass-slider-pill" :style="{ backgroundColor: activeItemBgColor, opacity: activeItemBgOpacity }" />
          </view>
        </view>

        <!-- 各 Tab 交互格位 -->
        <view
          v-for="(item, index) in tabbarList"
          :key="item.pagePath.length > 0 ? item.pagePath : `${item.text}_${index}`"
          class="glass-item-slot"
          @click="onTabClick(index)"
        >
          <view class="glass-item-inner">
            <view class="glass-icon-wrap">
              <uni-icons
                v-if="item.iconType == 'icon'"
                :type="getItemIcon(index)"
                :size="22"
                :color="getItemIconColor(index)"
              />
              <image
                v-else
                :src="getItemIconPath(index)"
                class="glass-icon-image"
              />
              <view v-if="item.badge != null && `${item.badge}` == 'dot'" class="glass-badge-dot" />
              <view v-else-if="item.badge != null && `${item.badge}` != 'dot'" class="glass-badge-text">
                <text class="glass-badge-label">{{ item.badge }}</text>
              </view>
            </view>
            <text
              class="glass-item-text"
              :style="{
                color: getItemTextColor(index),
                fontWeight: getItemFontWeight(index)
              }"
            >
              {{ getText(item.text) }}
            </text>
          </view>
        </view>
      </glass-effect-view>
    </view>
    <!-- #endif -->

    <!-- #ifndef APP-IOS -->
    <!-- 非 iOS 平台多端优雅降级 (Android / HarmonyOS / Web / 小程序) -->
    <view
      class="custom-glass-container glass-fallback"
      :style="{
        bottom: `${bottom}px`,
        height: `${height}px`,
        backgroundColor: glassBgColor,
        borderColor: glassBorderColor
      }"
    >
      <!-- 滑动滑块：在各 Tab 底部平滑移动的流体高光气泡 -->
      <view class="glass-slider-track">
        <view class="glass-slider" :style="sliderStyle">
          <view class="glass-slider-pill" :style="{ backgroundColor: activeItemBgColor, opacity: activeItemBgOpacity }" />
        </view>
      </view>

      <!-- 各 Tab 交互格位 -->
      <view
        v-for="(item, index) in tabbarList"
        :key="item.pagePath.length > 0 ? item.pagePath : `${item.text}_${index}`"
        class="glass-item-slot"
        @click="onTabClick(index)"
      >
        <view class="glass-item-inner">
          <view class="glass-icon-wrap">
            <uni-icons
              v-if="item.iconType == 'icon'"
              :type="getItemIcon(index)"
              :size="22"
              :color="getItemIconColor(index)"
            />
            <image
              v-else
              :src="getItemIconPath(index)"
              class="glass-icon-image"
            />
            <view v-if="item.badge != null && `${item.badge}` == 'dot'" class="glass-badge-dot" />
            <view v-else-if="item.badge != null && `${item.badge}` != 'dot'" class="glass-badge-text">
              <text class="glass-badge-label">{{ item.badge }}</text>
            </view>
          </view>
          <text
            class="glass-item-text"
            :style="{
              color: getItemTextColor(index),
              fontWeight: getItemFontWeight(index)
            }"
          >
            {{ getText(item.text) }}
          </text>
        </view>
      </view>
    </view>
    <!-- #endif -->
  </view>
</template>

<style>
/* 整个 TabBar 最外层包裹器：作为内部 absolute 容器的定位基准 */
.custom-glass-wrapper {
  position: relative;
  width: 100%;
  overflow: visible;
}

/* 占位填充块 */
.custom-glass-placeholder {
  width: 100%;
}

/* 悬浮液态玻璃底座主容器（全端统一使用 view 胶囊外壳，强制 34px 圆角裁切、边框与轻量投影） */
.custom-glass-container {
  position: absolute;
  right: 16px;
  left: 16px;
  z-index: 999;
  flex-direction: row;
  justify-content: space-around;
  align-items: center;
  border-width: 1px;
  border-style: solid;
  border-radius: 34px;
  overflow: hidden;
  /* 轻量弱阴影，规避 Android 原生端阴影重绘掉帧 */
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

/* iOS 原生液态玻璃内部容器（撑满外壳并继承 34px 胶囊圆角） */
.custom-glass-inner {
  flex-direction: row;
  justify-content: space-around;
  align-items: center;
  flex: 1;
  width: 100%;
  height: 100%;
  padding: 4px 6px;
  border-radius: 34px;
  overflow: hidden;
}

/* 多端优雅降级毛玻璃磨砂效果（Web / 小程序 / Android / HarmonyOS） */
.glass-fallback {
  padding: 4px 6px;
  /* #ifdef WEB || MP-WEIXIN */
  backdrop-filter: blur(25px);
  /* #endif */
}

/* 动态滑块滑动轨道 */
.glass-slider-track {
  position: absolute;
  top: 4px;
  right: 6px;
  bottom: 4px;
  left: 6px;
  z-index: 1;
  flex-direction: row;
  pointer-events: none;
}

/* 滑块单元 */
.glass-slider {
  justify-content: center;
  align-items: center;
  width: 25%;
  height: 100%;
  pointer-events: none;
  transition-property: transform;
  transition-duration: 250ms;
  transition-timing-function: cubic-bezier(0.25, 1, 0.5, 1);
}

/* 动态滑块本体流体气泡（高亮背景） */
.glass-slider-pill {
  width: 90%;
  height: 84%;
  border-radius: 20px;
  pointer-events: none;
}

/* 单个 Tab 格位 */
.glass-item-slot {
  position: relative;
  z-index: 2;
  justify-content: center;
  align-items: center;
  flex: 1;
  height: 100%;
  background-color: rgba(0, 0, 0, 0);
}

/* 原生点击轻触反馈态 */
.glass-item-hover {
  opacity: 0.75;
}

/* 胶囊内容项 */
.glass-item-inner {
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 90%;
  height: 84%;
  padding: 2px 0;
  border-radius: 20px;
}

/* 图标包裹器（含绝对定位徽标） */
.glass-icon-wrap {
  position: relative;
  justify-content: center;
  align-items: center;
  height: 22px;
}

.glass-icon-image {
  width: 20px;
  height: 20px;
}

/* 标签文本 */
.glass-item-text {
  margin-top: 2px;
  font-size: 11px;
  line-height: 14px;
}

/* 徽标小红点 */
.glass-badge-dot {
  position: absolute;
  top: -2px;
  right: -6px;
  width: 7px;
  height: 7px;
  border-radius: 999px;
  background-color: #ef4444;
}

/* 徽标数字/文字胶囊 */
.glass-badge-text {
  position: absolute;
  top: -4px;
  right: -12px;
  justify-content: center;
  align-items: center;
  height: 14px;
  padding: 0 4px;
  border-radius: 999px;
  background-color: #ef4444;
}

.glass-badge-label {
  color: #ffffff;
  font-size: 9px;
  font-weight: bold;
}
</style>
