<script setup lang="uts">
import { computed, onMounted, onUnmounted } from 'vue';
import {
  customTabbarConfig,
  handleTabbarClick,
  isDark,
  isVersionGte525,
  resetTabSwitchThrottle,
  safeAreaBottom,
  safeHideNativeTabBar,
  safeRestoreNativeTabBar,
  syncCurIdxByCurrentPage,
  TABBAR_CONTAINER_HEIGHT,
  TABBAR_HEIGHT,
  tabbarList,
  tabbarPlaceholderHeight,
  themeTokens
} from '@/src/tabbar/index.uts';
import TabbarItem from './TabbarItem.uvue';

/** 是否启用液态玻璃背景（由 config.uts 的 glassEffect 统一控制） */
const glassEnabled = computed<boolean>((): boolean => {
  return customTabbarConfig.glassEffect == true;
});

/** iOS 原生液态玻璃样式 */
const resolvedGlassStyle = computed<string>((): string => {
  return customTabbarConfig.glassStyle ?? 'regular';
});

/** 是否启用液态玻璃交互行为（仅 iOS 26+ 生效） */
const resolvedGlassInteractive = computed<boolean>((): boolean => {
  return customTabbarConfig.interactive ?? false;
});

/** 施加在液态玻璃上的着色（仅 iOS 26+ 生效） */
const resolvedGlassTintColor = computed<string>((): string => {
  return customTabbarConfig.tintColor ?? '';
});

/** 玻璃模式下的半透明背景色（非 iOS 端作为毛玻璃降级底色） */
const glassBgColor = computed<string>((): string => {
  return isDark.value ? 'rgba(15, 23, 42, 0.85)' : 'rgba(255, 255, 255, 0.88)';
});

/** 玻璃模式下的边框色 */
const glassBorderColor = computed<string>((): string => {
  return isDark.value ? 'rgba(255, 255, 255, 0.18)' : 'rgba(226, 232, 240, 0.95)';
});

/** TabBar 底板背景色：iOS 玻璃模式由原生 glass-effect-view 绘制 */
const tabbarBgColor = computed<string>((): string => {
  if (!glassEnabled.value) {
    return themeTokens.value.tabBg;
  }
  let color = glassBgColor.value;
  // #ifdef APP-IOS
  color = 'transparent';
  // #endif
  return color;
});

/** TabBar 顶边框色 */
const tabbarBorderColor = computed<string>((): string => {
  return glassEnabled.value ? glassBorderColor.value : themeTokens.value.tabBorder;
});

/** 安全区填充色：玻璃层已经覆盖底部安全区 */
const safeAreaBgColor = computed<string>((): string => {
  return glassEnabled.value ? 'transparent' : themeTokens.value.tabBg;
});

let isMounted = false;

// 首次挂载时同步索引并隐藏原生 TabBar
onMounted(() => {
  isMounted = true;
  syncCurIdxByCurrentPage();
  safeHideNativeTabBar();
});

// 卸载时彻底清理异步资源、还原原生 TabBar 并重置切换节流锁
onUnmounted(() => {
  isMounted = false;
  safeRestoreNativeTabBar();
  resetTabSwitchThrottle();
});

/** 处理 Tab 点击 */
function onTabClick(index: number) {
  if (!isMounted) {
    return;
  }
  handleTabbarClick(index);
}
</script>

<template>
  <!-- 占位块：仅在 5.25 及以上版本 H5 时使用 position: absolute，5.24及以下和App/小程序保持正常文档流占位 -->
  <view
    class="tabbar-placeholder"
    :class="{ 'tabbar-placeholder-absolute': isVersionGte525 }"
    :style="{ height: `${tabbarPlaceholderHeight}px` }"
  >
    <view
      class="tabbar-container"
      :style="{ height: `${TABBAR_CONTAINER_HEIGHT + safeAreaBottom}px` }"
    >
      <!-- 【整体底板】覆盖「固定高度 + 安全区」的全部区域 -->
      <!-- #ifdef APP-IOS -->
      <glass-effect-view
        v-if="glassEnabled"
        class="tabbar-bg"
        :glass-style="resolvedGlassStyle"
        :interactive="resolvedGlassInteractive"
        :tint-color="resolvedGlassTintColor"
        :style="{ height: `${TABBAR_HEIGHT + safeAreaBottom}px`, borderTopColor: tabbarBorderColor }"
      ></glass-effect-view>
      <view
        v-else
        class="tabbar-bg"
        :style="{ height: `${TABBAR_HEIGHT + safeAreaBottom}px`, backgroundColor: tabbarBgColor, borderTopColor: tabbarBorderColor }"
      ></view>
      <!-- #endif -->
      <!-- #ifndef APP-IOS -->
      <view
        class="tabbar-bg"
        :class="{ 'tabbar-bg-glass': glassEnabled }"
        :style="{ height: `${TABBAR_HEIGHT + safeAreaBottom}px`, backgroundColor: tabbarBgColor, borderTopColor: tabbarBorderColor }"
      ></view>
      <!-- #endif -->

      <!-- 【固定高度】tab 图标按钮区 -->
      <view class="tabbar-inner">
        <view
          v-for="(item, index) in tabbarList"
          :key="item.pagePath.length > 0 ? item.pagePath : `${item.text}_${index}`"
          class="tabbar-item"
          :style="{ height: `${item.isBulge ? TABBAR_CONTAINER_HEIGHT : TABBAR_HEIGHT}px` }"
          @click="onTabClick(index)"
        >
          <TabbarItem :item="item" :index="index" :is-bulge="item.isBulge" />
        </view>
      </view>

      <!-- 【安全区】底部安全区填充块 -->
      <view class="safe-area-bg" :style="{ height: `${safeAreaBottom}px`, backgroundColor: safeAreaBgColor }" />
    </view>
  </view>
</template>

<style>
.tabbar-placeholder {
  /* 高度通过 :style 动态绑定，占据正常文档流防止遮挡页面内容 */
  width: 100%;
}

/* 仅在 5.25 及以上版本 H5 时脱离文档流 */
.tabbar-placeholder-absolute {
  /* #ifdef H5 */
  position: absolute;
  /* #endif */
}

/* 固定在底部的容器，内部级联展示三个层 */
.tabbar-container {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
  flex-direction: column;
  background-color: transparent;
}

/* 【底板层】覆盖「固定高度 + 安全区」的底板，绑定高度动态设定 */
.tabbar-bg {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
  border-top-width: 1rpx;
  border-top-style: solid;
}

/* 非 iOS 端的毛玻璃降级（仅 Web / 微信小程序支持 backdrop-filter） */
.tabbar-bg-glass {
  /* #ifdef WEB || MP-WEIXIN */
  backdrop-filter: blur(25px);
  /* #endif */
}

/* 【固定高度层】tab 图标按钮区，与底板同高；鼓包由 TabbarItem 内绝对定位向上突出 */
.tabbar-inner {
  z-index: 2;
  flex-direction: row;
  align-items: flex-end;
  height: 80px;
}

/* 单个 tab 项：flex 平分宽度；高度通过 :style 动态绑定（普通项 TABBAR_HEIGHT / 鼓包项 TABBAR_CONTAINER_HEIGHT） */
.tabbar-item {
  justify-content: center;
  align-items: center;
  flex: 1;
}

/* 【安全区层】底部安全区填充，高度动态设定 */
.safe-area-bg {
  z-index: 1;
}
</style>
