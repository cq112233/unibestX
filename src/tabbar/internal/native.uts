import { getI18nText } from '@/src/i18n/utils/index.uts';
import { isCompilerVersionGte } from '@/src/utils/systemInfo/index.uts';
import { tabbarList } from './state.uts';
import { isNativeTabbar, needHideNativeTabbar } from './strategy.uts';

/**
 * 设置原生 TabBar 各项的多语言文本 (设置 uni.setTabBarItem)
 */
export function setTabbarItem(): void {
  // 仅在原生 TabBar 模式或带原生缓存的自定义模式（pages.json 中存在 tabBar 节点）下执行
  if (!isNativeTabbar && !needHideNativeTabbar) {
    return;
  }
  for (let i = 0; i < tabbarList.length; i++) {
    const item = tabbarList[i];
    const text = getI18nText(item.text);
    try {
      uni.setTabBarItem({
        index: i,
        text
      } as SetTabBarItemOptions);
    }
    catch {
      // 捕获无原生 tabBar 节点时的异常，保证全平台平稳运行
    }
  }
}

/**
 * 隐藏系统原生 TabBar 并根据编译器版本动态适配 H5 底部容器
 */
export function safeHideNativeTabBar(): void {
  // #ifdef H5
  try {
    if (typeof document != 'undefined' && document.getElementById('hide-native-tabbar-style') == null) {
      const style = document.createElement('style');
      style.id = 'hide-native-tabbar-style';
      if (isCompilerVersionGte('5.25')) {
        style.innerHTML = 'uni-tabbar, .uni-tabbar, .uni-tabbar-bottom, .uni-tabbar__icon, .uni-tabbar__label { display: none !important; } :root { --window-bottom: 0px !important; } uni-page-wrapper { height: 100% !important; } uni-page-body { padding-bottom: 0px !important; }';
      }
      else {
        // 5.24 及以下版本（与 uniX-rice-ui 100% 相同原版逻辑）
        style.innerHTML = 'uni-tabbar, .uni-tabbar, .uni-tabbar-bottom, .uni-tabbar__icon, .uni-tabbar__label { display: none !important; }';
      }
      document.head.appendChild(style);
    }
  }
  catch { }
  // #endif
  // #ifndef MP-WEIXIN
  // 仅在模式2（带原生底板的自定义模式）且系统存在原生 TabBar 时才需调用 hideTabBar
  // 模式4（单页保活容器，当前默认）与模式3下 pages.json 无原生 tabBar 节点，避免调用触发 tabBar is not exist
  if (needHideNativeTabbar) {
    try {
      uni.hideTabBar({
        animation: false,
        fail: (_err: any) => {
          // 原生 tabBar 不存在时（如非 Tab 页面）属于预期内正常防御状态，静默捕获不输出报警日志
        }
      });
    }
    catch { }
  }
  // #endif
}
