import { computed, inject, onUnmounted, watch } from 'vue';
import { onHide as onPageHide, onLoad as onPageLoad, onShow as onPageShow } from '@dcloudio/uni-app';
import { getCurrentPath } from '@/uni_modules/route-bestX/index.uts';
import { isPageVisible, pageShowTimes } from '../core/lifecycle.uts';
import { curIdx } from '../core/state.uts';
import { resolveTabIndexByKey } from '../core/tab-key.uts';

/** Tab 页面生命周期回调 */
export type TabPageLifecycleCallback = () => void;

/** 单页 TabBar 的页面生命周期适配结果 */
export type UseTabPageResult = {
  /** 首次进入该 Tab 时执行一次，等价页面 onLoad */
  onLoad: (callback: TabPageLifecycleCallback) => void;
  /** 每次切回该 Tab / 从子页返回 / App 回前台时执行，等价页面 onShow */
  onShow: (callback: TabPageLifecycleCallback) => void;
  /** 切走该 Tab / 进入子页 / App 切后台时执行，等价页面 onHide */
  onHide: (callback: TabPageLifecycleCallback) => void;
  /** Tab 视图卸载时执行，等价页面 onUnload */
  onUnload: (callback: TabPageLifecycleCallback) => void;
};

/**
 * 单页 TabBar（模式 4）的页面生命周期适配 hook。
 *
 * 在 Tab 页面 `.uvue`（如 `src/pages/basic/basic.uvue`）中调用后，接管并派发页面生命周期：
 * - `onLoad / onShow / onHide / onUnload`
 *
 * Tab 切换由单页容器完成，保留零闪烁与页面状态常驻。
 *
 * @example
 * ```uts
 * const {
 *   onLoad,
 *   onShow,
 *   onHide
 * } = useTabPage();
 *
 * onLoad((): void => {
 *   console.log('Tab 首次进入');
 * });
 *
 * onShow((): void => {
 *   console.log('切回当前 Tab、从子页面返回或 App 回前台');
 * });
 * ```
 */
export function useTabPage(): UseTabPageResult {
  // TabContent 在插槽外层注入当前 Tab 在完整 tabbarList 中的下标。
  const injectedPageIndex = inject<number>('tabPageIndex', -1);
  // 模式 4 宿主页不经过 TabContent 插槽，按宿主页面路由匹配 Tab 下标。
  const pageIndex = injectedPageIndex >= 0
    ? injectedPageIndex
    : resolveTabIndexByKey(getCurrentPath());

  const isActive = computed<boolean>((): boolean => {
    // 未命中 Tab 时说明当前是普通页面，页面本身始终处于激活状态
    return pageIndex < 0 || curIdx.value == pageIndex;
  });

  /** onLoad 已执行的标记：每个 Tab 视图实例只执行一次 */
  let hasLoaded: boolean = false;
  /** 当前是否已经向业务派发 onShow */
  let hasShown: boolean = false;
  const loadCallbacks: Array<TabPageLifecycleCallback> = [];
  const showCallbacks: Array<TabPageLifecycleCallback> = [];
  const hideCallbacks: Array<TabPageLifecycleCallback> = [];
  const unloadCallbacks: Array<TabPageLifecycleCallback> = [];

  /** 批量执行回调 */
  function runCallbacks(callbacks: Array<TabPageLifecycleCallback>): void {
    for (let i = 0; i < callbacks.length; i++) {
      callbacks[i]();
    }
  }

  /**
   * 当前 Tab 是否处于“页面可见”状态。
   * pageShowTimes == 0 时说明宿主尚未桥接 onShow；此时按首屏可见处理，
   * 与 onTabPageShow 的既有无门控兜底保持一致。
   */
  function isCurrentTabVisible(): boolean {
    if (!isActive.value) {
      return false;
    }
    if (injectedPageIndex >= 0) {
      return isPageVisible.value || pageShowTimes.value == 0;
    }
    // 宿主页必须等待 useTabPageShell() 桥接 onShow，避免入口深链切到其他 Tab 时，
    // 首页在宿主 setup 阶段误触发一次 onLoad / onShow。
    return isPageVisible.value;
  }

  /** 激活 / 失活时统一派发 onLoad、onShow、onHide */
  function syncLifecycle(): void {
    if (isCurrentTabVisible()) {
      if (!hasLoaded) {
        hasLoaded = true;
        runCallbacks(loadCallbacks);
      }
      if (!hasShown) {
        hasShown = true;
        runCallbacks(showCallbacks);
      }
      return;
    }
    if (hasShown) {
      hasShown = false;
      runCallbacks(hideCallbacks);
    }
  }

  /** 注册首次进入回调；若注册时页面已经可见则立即执行 */
  const registerLoad = (callback: TabPageLifecycleCallback): void => {
    if (!loadCallbacks.includes(callback)) {
      loadCallbacks.push(callback);
    }
    if (!hasLoaded && isCurrentTabVisible()) {
      hasLoaded = true;
      callback();
    }
  };

  /** 注册页面显示回调；若注册时页面已经可见则立即执行 */
  const registerShow = (callback: TabPageLifecycleCallback): void => {
    if (!showCallbacks.includes(callback)) {
      showCallbacks.push(callback);
    }
    if (!hasShown && isCurrentTabVisible()) {
      hasShown = true;
      callback();
    }
  };

  /** 注册页面隐藏回调；切走 Tab、进入子页或 App 切后台时执行 */
  const registerHide = (callback: TabPageLifecycleCallback): void => {
    if (!hideCallbacks.includes(callback)) {
      hideCallbacks.push(callback);
    }
  };

  /** 注册视图卸载回调 */
  const registerUnload = (callback: TabPageLifecycleCallback): void => {
    if (!unloadCallbacks.includes(callback)) {
      unloadCallbacks.push(callback);
    }
  };

  // 普通页面（非 Tab 页面）直接使用原生页面生命周期，保证同一套调用方式在普通页面同样生效
  if (pageIndex < 0) {
    onPageLoad((): void => {
      if (!hasLoaded) {
        hasLoaded = true;
        runCallbacks(loadCallbacks);
      }
    });
    onPageShow((): void => {
      if (!hasShown) {
        hasShown = true;
        runCallbacks(showCallbacks);
      }
    });
    onPageHide((): void => {
      if (hasShown) {
        hasShown = false;
        runCallbacks(hideCallbacks);
      }
    });
  }

  const stopActiveWatch = watch(isActive, (_value: boolean): void => {
    syncLifecycle();
  });
  const stopVisibleWatch = watch(isPageVisible, (_value: boolean): void => {
    syncLifecycle();
  });

  onUnmounted((): void => {
    stopActiveWatch();
    stopVisibleWatch();
    if (hasShown) {
      hasShown = false;
      runCallbacks(hideCallbacks);
    }
    runCallbacks(unloadCallbacks);
    loadCallbacks.length = 0;
    showCallbacks.length = 0;
    hideCallbacks.length = 0;
    unloadCallbacks.length = 0;
  });

  return {
    onLoad: (callback: TabPageLifecycleCallback): void => {
      registerLoad(callback);
    },
    onShow: (callback: TabPageLifecycleCallback): void => {
      registerShow(callback);
    },
    onHide: (callback: TabPageLifecycleCallback): void => {
      registerHide(callback);
    },
    onUnload: (callback: TabPageLifecycleCallback): void => {
      registerUnload(callback);
    }
  };
}
