<template>
  <view v-if="hasRendered" :style="rootStyle" class="tab-content-wrapper">
    <scroll-view
      direction="vertical"
      class="flex-1 flex flex-col"
      style="flex: 1;"
      :refresher-enabled="isRefresherEnabled"
      :refresher-triggered="isTriggered"
      :refresher-background="themeTokens.bgContent"
      :lower-threshold="50"
      @refresherrefresh="handleRefresherRefresh"
      @refresherrestore="handleRefresherRestore"
      @scroll="handleScroll"
      @scrolltolower="handleScrollToLower"
    >
      <slot />
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import { computed, onMounted, onUnmounted, provide, ref, watch } from 'vue';
import { curIdx, tabbarList } from '@/src/tabbar/index.uts';
import { $t } from '@/src/utils/i18n/index.uts';
import { isPageRefresherDisabled, isPageScrollDisabled, setHideNavbar, setHideStatusBar, setNavbarTitle } from '@/src/utils/refresh/index.uts';
import { useAppStore } from '@/src/store';
import { getThemeTokens } from '@/src/utils/theme/index.uts';
import type { ThemeTokens } from '@/src/utils/theme/index.uts';

const props = defineProps({
  /** 对应的 TabBar 索引（0, 1, 2, 3 等） */
  contentIndex: {
    type: Number,
    required: true
  },
  /** 可选的自定义导航栏标题（若未指定，默认读取当前 TabBar 对应项的多语言文本） */
  title: {
    type: String,
    default: ''
  },
  /** 当前 Tab 是否隐藏顶部导航栏（各 Tab 独立控制显隐，true 隐藏，false 显示） */
  hideNavbar: {
    type: Boolean,
    default: false
  },
  /** 当前 Tab 是否隐藏状态栏占位（默认 false，true 隐藏不占空间，完全沉浸式） */
  hideStatusBar: {
    type: Boolean,
    default: false
  },
  /** 当前 Tab 是否启用下拉刷新（默认 true） */
  enablePullDownRefresh: {
    type: Boolean,
    default: true
  }
});

const hasRendered = ref(false);
const isActive = computed<boolean>((): boolean => curIdx.value == props.contentIndex);
const contentTitle = computed((): string => props.title);
const shouldHideNavbar = computed((): boolean => props.hideNavbar);
const shouldHideStatusBar = computed((): boolean => props.hideStatusBar);

// 向下跨层级注入当前 Tab 激活状态，供内部 fixed 元素通过 inject('isTabActive') 配合 v-if 兜底销毁
provide('isTabActive', isActive);

// 非激活 Tab 采用「移出视口 + visibility + display」三重隐藏，兼顾全端保活与渲染性能。
// ⚠️ 注意：iOS 原生引擎会将 position: fixed 提升至 Page Root 视图，导致父级 CSS display:none 无法穿透；
// 若 Tab 内部使用了 position: fixed，必须配合 v-if="isActive" 以在切走 Tab 时彻底卸载原生视图。
const rootStyle = computed<UTSJSONObject>((): UTSJSONObject => {
  return {
    left: isActive.value ? '0px' : '-9999px',
    visibility: isActive.value ? 'visible' : 'hidden'
  } as UTSJSONObject;
});

/**
 * 设置/同步当前激活 Tab 的导航栏标题与显隐状态
 */
function updateNavbarTitle(): void {
  let targetTitle = '';
  if (props.title.length > 0) {
    targetTitle = props.title;
  }
  else if (props.contentIndex >= 0 && props.contentIndex < tabbarList.length) {
    const item = tabbarList[props.contentIndex];
    targetTitle = $t(item.text);
  }

  if (targetTitle.length > 0) {
    setNavbarTitle(targetTitle);
    uni.setNavigationBarTitle({
      title: targetTitle
    } as SetNavigationBarTitleOptions);
  }
}

function syncNavbarState(): void {
  updateNavbarTitle();
  setHideNavbar(props.hideNavbar);
  setHideStatusBar(props.hideStatusBar);
}

onMounted(() => {
  if (curIdx.value == props.contentIndex) {
    hasRendered.value = true;
    syncNavbarState();
  }
});

watch(isActive, (newVal: boolean) => {
  if (newVal) {
    if (!hasRendered.value) {
      hasRendered.value = true;
    }
    syncNavbarState();
  }
});

watch(contentTitle, (newTitle: string) => {
  if (isActive.value && newTitle.length > 0) {
    setNavbarTitle(newTitle);
    uni.setNavigationBarTitle({
      title: newTitle
    } as SetNavigationBarTitleOptions);
  }
});

watch(shouldHideNavbar, (newVal: boolean) => {
  if (isActive.value) {
    setHideNavbar(newVal);
  }
});

watch(shouldHideStatusBar, (newVal: boolean) => {
  if (isActive.value) {
    setHideStatusBar(newVal);
  }
});

const appStore = useAppStore();
const themeTokens = computed<ThemeTokens>((): ThemeTokens => {
  return getThemeTokens(appStore.state.isDark);
});

/** 下拉刷新状态控制：true 表示刷新中，false 表示已复位收起 */
const isTriggered = ref(false);

/** 当前激活 Tab 是否允许下拉刷新 */
const isRefresherEnabled = computed<boolean>((): boolean => {
  return isActive.value && props.enablePullDownRefresh && !isPageScrollDisabled.value && !isPageRefresherDisabled.value;
});

/** 下拉刷新触发事件 */
function handleRefresherRefresh(): void {
  isTriggered.value = true;
  uni.$emit('onPagePullDownRefresh');
}

/** 下拉刷新复位事件 */
function handleRefresherRestore(): void {
  isTriggered.value = false;
}

/** 监听外部发出的停止刷新通知（stopNavbarPullDownRefresh） */
function onStopRefresh(): void {
  isTriggered.value = false;
}

/** 滚动事件回调 */
function handleScroll(e: UniScrollEvent): void {
  if (!isActive.value) {
    return;
  }
  const scrollTop = e.detail.scrollTop;
  uni.$emit('onNavbarPageScroll', {
    scrollTop: Math.ceil(scrollTop)
  } as UTSJSONObject);
}

/** 触底事件回调 */
function handleScrollToLower(): void {
  if (!isActive.value) {
    return;
  }
  uni.$emit('onNavbarReachBottom');
}

uni.$on('stopPagePullDownRefresh', onStopRefresh);

onUnmounted(() => {
  uni.$off('stopPagePullDownRefresh', onStopRefresh);
});

defineExpose({
  updateNavbarTitle,
  syncNavbarState
});
</script>

<style scoped>
.tab-content-wrapper {
  position: absolute;
  top: 0;
  width: 100%;
  height: 100%;
  flex-direction: column;
}
</style>
