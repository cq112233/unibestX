<template>
  <view class="tab-views-container" style="position: relative; display: flex; flex-direction: column; flex: 1; height: 100%;">
    <!-- #ifdef H5 -->
    <TabContent v-if="isTabRendered(0)" :content-index="0" title="首页" :enable-pull-down-refresh="false" :show-back="false" custom-page-class="init-page" custom-page-style="background-color: transparent;">
      <slot name="tabHost" />
    </TabContent>
    <!-- #endif -->
    <!-- #ifdef APP-ANDROID || APP-IOS || APP-HARMONY || MP-WEIXIN || MP-ALIPAY || MP-BAIDU || MP-TOUTIAO || MP-QQ || MP-KUAISHOU || MP-LARK || MP-JD || MP-XHS || MP-360 || MP-HARMONY -->
    <TabContent v-if="isTabRendered(0)" :content-index="0" title="首页" :enable-pull-down-refresh="true" :show-back="false" custom-page-class="init-page" custom-page-style="background-color: transparent;">
      <slot name="tabHost" />
    </TabContent>
    <!-- #endif -->
    <TabContent v-if="isTabRendered(1)" :content-index="1" title="我的" :enable-pull-down-refresh="true" :show-back="false">
      <MePage />
    </TabContent>
  </view>
</template>

<script setup lang="uts">
import MePage from '@/src/pages/me/me.uvue';
import TabContent from './TabContent.uvue';
import { reactive, watch } from 'vue';
import { useTabbar } from '@/src/tabbar/index.uts';

const { curIdx } = useTabbar();
const renderedTabs: Array<boolean> = reactive([false, false]);

if (curIdx.value >= 0 && curIdx.value < renderedTabs.length) {
  renderedTabs[curIdx.value] = true;
}

watch(curIdx, (nextIdx: number): void => {
  if (nextIdx >= 0 && nextIdx < renderedTabs.length) {
    renderedTabs[nextIdx] = true;
  }
});

/** 首次激活后常驻保活；未访问过的 Tab 不创建页面组件 */
function isTabRendered(index: number): boolean {
  return renderedTabs[index] == true;
}
</script>

<style lang="scss" scoped>
.tab-views-container {
  position: relative;
  display: flex;
  flex-direction: column;
  flex: 1;
  height: 100%;
}
</style>
