<script setup lang="uts">
import {
  handleTabbarClick,
  isVersionGte525,
  safeAreaBottom,
  safeHideNativeTabBar,
  syncCurIdxByCurrentPage,
  TABBAR_CONTAINER_HEIGHT,
  TABBAR_HEIGHT,
  tabbarList,
  tabbarPlaceholderHeight,
  themeTokens
} from './helper';
import TabbarItem from './TabbarItem.uvue';

// 首次挂载时同步索引并隐藏原生 TabBar
onMounted(() => {
  syncCurIdxByCurrentPage();
  safeHideNativeTabBar();
});
</script>

<template>
  <!-- 占位块：仅在 5.25 及以上版本 H5 时使用 position: absolute，5.24及以下和App/小程序保持正常文档流占位 -->
  <view
    class="tabbar-placeholder"
    :class="{ 'tabbar-placeholder-absolute': isVersionGte525 }"
    :style="{ height: `${tabbarPlaceholderHeight}px` }"
  >
    <view
      class="tabbar-container"
      :style="{ height: `${TABBAR_CONTAINER_HEIGHT + safeAreaBottom}px` }"
    >
      <!-- 【整体底板】覆盖「固定高度 + 安全区」的全部区域 -->
      <view
        class="tabbar-bg"
        :style="{ height: `${TABBAR_HEIGHT + safeAreaBottom}px`, backgroundColor: themeTokens.tabBg, borderTopColor: themeTokens.tabBorder }"
      ></view>

      <!-- 【固定高度】tab 图标按钮区 -->
      <view class="tabbar-inner">
        <view
          v-for="(item, index) in tabbarList"
          :key="index"
          class="tabbar-item"
          :class="{ 'tabbar-item-bulge': item.isBulge }"
          @click="handleTabbarClick(index)"
        >
          <TabbarItem :item="item" :index="index" :is-bulge="item.isBulge" />
        </view>
      </view>

      <!-- 【安全区】底部安全区填充块 -->
      <view class="safe-area-bg" :style="{ height: `${safeAreaBottom}px`, backgroundColor: themeTokens.tabBg }" />
    </view>
  </view>
</template>

<style>
.tabbar-placeholder {
  /* 高度通过 :style 动态绑定，占据正常文档流防止遮挡页面内容 */
  width: 100%;
}

/* 仅在 5.25 及以上版本 H5 时脱离文档流 */
.tabbar-placeholder-absolute {
  /* #ifdef H5 */
  position: absolute;
  /* #endif */
}

/* 固定在底部的容器，内部级联展示三个层 */
.tabbar-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 1;
  background-color: transparent;
  flex-direction: column;
}

/* 【底板层】覆盖「固定高度 + 安全区」的底板，绑定高度动态设定 */
.tabbar-bg {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  border-top-width: 1rpx;
  border-top-style: solid;
  z-index: 1;
}

/* 【固定高度层】tab 图标按钮区，与底板同高；鼓包由 TabbarItem 内绝对定位向上突出 */
.tabbar-inner {
  flex-direction: row;
  height: 80px;
  align-items: flex-end;
  z-index: 2;
}

.tabbar-item {
  flex: 1;
  align-items: center;
  justify-content: center;
  height: 50px;
}

.tabbar-item-bulge {
  height: 80px;
}

/* 【安全区层】底部安全区填充，高度动态设定 */
.safe-area-bg {
  z-index: 1;
}
</style>
