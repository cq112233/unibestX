import { computed } from 'vue';

export type ThemeTokens = {
  bgContent: string;
  navBg: string;
  navText: string;
  tabBg: string;
  tabBorder: string;
  tabColor: string;
  tabSelected: string;
};

const defaultTokens: ThemeTokens = {
  bgContent: '#ffffff',
  navBg: '#ffffff',
  navText: '#000000',
  tabBg: '#ffffff',
  tabBorder: 'rgba(0, 0, 0, 0.1)',
  tabColor: '#94a3b8',
  tabSelected: '#10b981'
};

/**
 * 当前是否为深色模式（极简模式固定为 false）
 */
export const isDark = computed<boolean>((): boolean => {
  return false;
});

/**
 * TabBar 主题样式令牌（极简模式静态固定色板）
 */
export const themeTokens = computed((): ThemeTokens => {
  return defaultTokens;
});

/**
 * TabBar 当前激活的高亮主题色（极简模式静态固定色值）
 */
export const activeThemeColor = computed<string>((): string => {
  return '#10b981';
});
