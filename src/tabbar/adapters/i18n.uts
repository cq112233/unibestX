import { $t, getI18nText } from '@/src/i18n/utils/index.uts';
import { getCurrentRoute } from '../core/path.uts';
import { isPageTabbar, tabbarList } from '../core/state.uts';
import { isNativeTabbar, needHideNativeTabbar } from '../core/strategy.uts';

/**
 * TabBar 文本国际化适配器
 * （当 CLI 裁剪掉 i18n 时，只需替换本文件为直接返回原文本，TabBar 内部 UI 无需做任何修改）
 *
 * @param text 待翻译文本或多语言 key
 * @returns 翻译后的展示文本
 */
export function formatTabbarText(text: string): string {
  return $t(text);
}

/**
 * 设置原生 TabBar 各项的多语言文本 (设置 uni.setTabBarItem)
 */
export function setTabbarItem(): void {
  // 仅在原生 TabBar 模式或带原生缓存的自定义模式（pages.json 中存在 tabBar 节点）下执行
  if (!isNativeTabbar && !needHideNativeTabbar) {
    return;
  }
  // 只有当前已处于 TabBar 页面时才执行 uni.setTabBarItem；在启动期或非 TabBar 子页面直接跳过，杜绝报错
  const route = getCurrentRoute();
  if (route.length == 0 || !isPageTabbar(route)) {
    return;
  }
  for (let i = 0; i < tabbarList.length; i++) {
    const item = tabbarList[i];
    const text = getI18nText(item.text);
    try {
      uni.setTabBarItem({
        index: i,
        text,
        fail: (_err: any) => {
          // 静默处理非 TabBar 页面调用 setTabBarItem 导致的失败，避免控制台抛出 UniError
        }
      } as SetTabBarItemOptions);
    }
    catch {
      // 捕获无原生 tabBar 节点时的异常，保证全平台平稳运行
    }
  }
}
