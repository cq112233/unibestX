/**
 * 将导航栏标题转换为中文展示文本（极简无 i18n 模式）
 *
 * @param title 标题原文或多语言 key（如 'tabbar.home' 或 '%tabbar.home%'）
 * @returns 最终展示标题
 */
export function formatNavbarTitle(title: string): string {
  if (title == 'tabbar.home') {
    return '首页';
  }
  if (title == 'tabbar.me') {
    return '我的';
  }
  return title;
}
