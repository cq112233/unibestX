import { computed } from 'vue';

export type ThemeTokens = {
  bgContent: string;
  navBg: string;
  navText: string;
  tabBg: string;
  tabBorder: string;
  tabColor: string;
  tabSelected: string;
};

const defaultTokens: ThemeTokens = {
  bgContent: '#ffffff',
  navBg: '#ffffff',
  navText: '#000000',
  tabBg: '#ffffff',
  tabBorder: 'rgba(0, 0, 0, 0.1)',
  tabColor: '#94a3b8',
  tabSelected: '#10b981'
};

/**
 * 布局主题设计令牌（极简静态色板）
 */
export const navbarThemeTokens = computed((): ThemeTokens => {
  return defaultTokens;
});

/**
 * 下拉刷新背景底色
 */
export const refresherBackground = computed<string>((): string => {
  return navbarThemeTokens.value.bgContent;
});
