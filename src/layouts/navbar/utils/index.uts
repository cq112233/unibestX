import { onMounted, onUnmounted, ref } from 'vue';
import type { Ref } from 'vue';

// ==========================================
// 1. 页面滚动与触底控制
// ==========================================

/** 页面滚动禁用响应式开关 */
export const isPageScrollDisabled: Ref<boolean> = ref(false);
/** 页面下拉刷新禁用响应式开关 */
export const isPageRefresherDisabled: Ref<boolean> = ref(false);

/**
 * 动态启用/禁用页面滚动
 * @param enabled true 为启用，false 为禁用
 */
export function setPageScrollEnabled(enabled: boolean): void {
  isPageScrollDisabled.value = !enabled;
}

/**
 * 动态启用/禁用页面下拉刷新
 * @param enabled true 为启用，false 为禁用
 */
export function setPageRefresherEnabled(enabled: boolean): void {
  isPageRefresherDisabled.value = !enabled;
}

/** 页面滚动事件参数类型 */
export type PageScrollDetail = {
  scrollTop: number;
};

export const EVENT_PAGE_SCROLL: string = 'onNavbarPageScroll';
export const EVENT_REACH_BOTTOM: string = 'onNavbarReachBottom';

/**
 * 监听 NavBar 布局内的页面滚动事件（在页面采用了 navbar 布局时替代原生的 onPageScroll）
 */
export function onNavbarPageScroll(callback: (e: PageScrollDetail) => void): void {
  const handler = (data: any | null): void => {
    if (data != null) {
      const obj = data as UTSJSONObject;
      // eslint-disable-next-line dot-notation
      const topVal = obj['scrollTop'];
      const st = topVal != null ? (topVal as number) : 0;
      callback({ scrollTop: st } as PageScrollDetail);
    }
    else {
      callback({ scrollTop: 0 } as PageScrollDetail);
    }
  };
  onMounted(() => {
    uni.$on(EVENT_PAGE_SCROLL, handler);
  });
  onUnmounted(() => {
    uni.$off(EVENT_PAGE_SCROLL, handler);
  });
}

/**
 * 监听 NavBar 布局内的触底事件（在页面采用了 navbar 布局时替代原生的 onReachBottom）
 */
export function onNavbarReachBottom(callback: () => void): void {
  onMounted(() => {
    uni.$on(EVENT_REACH_BOTTOM, callback);
  });
  onUnmounted(() => {
    uni.$off(EVENT_REACH_BOTTOM, callback);
  });
}

// ==========================================
// 2. 下拉刷新控制
// ==========================================

export const EVENT_PULL_DOWN_REFRESH: string = 'onPagePullDownRefresh';
export const EVENT_STOP_PULL_DOWN_REFRESH: string = 'stopPagePullDownRefresh';

/**
 * 监听 NavBar 布局下拉刷新事件
 */
export function onNavbarPullDownRefresh(callback: () => void): void {
  onMounted(() => {
    uni.$on(EVENT_PULL_DOWN_REFRESH, callback);
  });
  onUnmounted(() => {
    uni.$off(EVENT_PULL_DOWN_REFRESH, callback);
  });
}

/**
 * 停止 NavBar 布局下拉刷新状态
 */
export function stopNavbarPullDownRefresh(): void {
  uni.$emit(EVENT_STOP_PULL_DOWN_REFRESH);
  uni.stopPullDownRefresh();
}

// ==========================================
// 3. 导航栏标题控制
// ==========================================

export const EVENT_SET_NAVBAR_TITLE: string = 'setNavbarTitle';
export const EVENT_RESET_NAVBAR_TITLE: string = 'resetNavbarTitle';

/**
 * 动态设置/修改 NavBar 布局及原生导航栏标题
 * @param title 新的导航栏标题文本
 */
export function setNavbarTitle(title: string): void {
  uni.$emit(EVENT_SET_NAVBAR_TITLE, title);
  uni.setNavigationBarTitle({
    title
  } as SetNavigationBarTitleOptions);
}

/**
 * 重置 NavBar 布局的导航栏标题为初始配置标题
 */
export function resetNavbarTitle(): void {
  uni.$emit(EVENT_RESET_NAVBAR_TITLE);
}

// ==========================================
// 4. 导航栏与状态栏显隐控制
// ==========================================

export const EVENT_SET_NAVBAR_VISIBLE: string = 'setNavbarVisible';
export const EVENT_SET_HIDE_NAVBAR: string = 'setHideNavbar';
export const EVENT_RESET_NAVBAR_VISIBLE: string = 'resetNavbarVisible';

/**
 * 动态控制 NavBar 布局导航栏的显示或隐藏
 * @param visible 是否显示导航栏（true 显示，false 隐藏）
 */
export function setNavbarVisible(visible: boolean): void {
  uni.$emit(EVENT_SET_NAVBAR_VISIBLE, visible);
}

/**
 * 动态控制是否隐藏 NavBar 布局导航栏
 * @param hide 是否隐藏导航栏（true 隐藏，false 显示）
 */
export function setHideNavbar(hide: boolean): void {
  uni.$emit(EVENT_SET_HIDE_NAVBAR, hide);
}

/**
 * 重置 NavBar 布局导航栏显隐为页面初始配置
 */
export function resetNavbarVisible(): void {
  uni.$emit(EVENT_RESET_NAVBAR_VISIBLE);
}

export const EVENT_SET_STATUS_BAR_VISIBLE: string = 'setStatusBarVisible';
export const EVENT_SET_HIDE_STATUS_BAR: string = 'setHideStatusBar';
export const EVENT_RESET_STATUS_BAR_VISIBLE: string = 'resetStatusBarVisible';

/**
 * 动态控制是否隐藏状态栏占位高度
 * @param hide 是否隐藏状态栏占位（true 隐藏，false 显示）
 */
export function setHideStatusBar(hide: boolean): void {
  uni.$emit(EVENT_SET_HIDE_STATUS_BAR, hide);
}

/**
 * 动态控制状态栏占位高度是否可见
 * @param visible 是否显示状态栏占位（true 显示，false 隐藏）
 */
export function setStatusBarVisible(visible: boolean): void {
  uni.$emit(EVENT_SET_STATUS_BAR_VISIBLE, visible);
}

/**
 * 重置状态栏显隐为页面初始配置
 */
export function resetStatusBarVisible(): void {
  uni.$emit(EVENT_RESET_STATUS_BAR_VISIBLE);
}

export * from './i18n.uts';
export * from './theme.uts';
