import { Request } from '@/uni_modules/lime-request';
import type { LimeRequestConfig, LimeRequestFail, LimeRequestResponse } from '@/uni_modules/lime-request';
import { useTokenStore } from '@/src/store';
import { toLoginPage } from '../router/toLoginPage';
import { ContentTypeEnum, ResultEnum, ShowMessage } from './tools/enum';
import { claimRefreshFailure, tryRefreshToken } from './refresh.uts';

import { getApiBaseUrl, getApiSecondaryUrl, getH5UseProxy } from '../utils/env/index.uts';

/**
 * 401 哨兵：拦截器抛出它表示「应尝试刷新并重放」，由 HttpClient.request 捕获。
 * 拦截器运行在 Promise 内部、无法在此 await 后重放，故只能抛出信号交由外层处理。
 */
const REFRESHABLE_401: string = '__REFRESHABLE_401__';

// ==========================================
// 域名配置（所有端统一从 Vite 环境变量读取）
// ==========================================
// H5：VITE_H5_USE_PROXY=true 走 /api 反向代理，false 直连（默认）
// 小程序 / App：固定直连，不支持 /api，误配时回退默认完整域名

const DEFAULT_API_URL: string = 'https://ukw0y1.laf.run';
const directBaseUrl: string = getApiBaseUrl();
const directSecondaryUrl: string = getApiSecondaryUrl();

let defaultUrl: string = directBaseUrl.startsWith('/') ? DEFAULT_API_URL : directBaseUrl;
let secondaryUrl: string = directSecondaryUrl.startsWith('/') ? DEFAULT_API_URL : directSecondaryUrl;

// #ifdef H5
// H5：VITE_H5_USE_PROXY=true 时走 /api 反向代理
const useH5Proxy: boolean = getH5UseProxy();
if (useH5Proxy) {
  defaultUrl = '/api';
  secondaryUrl = '/api';
}
// #endif

type ApiDomainConfig = {
  DEFAULT: string;
  SECONDARY: string;
};

export const API_DOMAINS: ApiDomainConfig = {
  DEFAULT: defaultUrl,
  SECONDARY: secondaryUrl
};

// ==========================================
// 创建底层 lime-request 实例
// ==========================================
const requestInstance = new Request({
  baseURL: API_DOMAINS.DEFAULT,
  timeout: 5000,
  header: {
    'Content-Type': ContentTypeEnum.AppJson,
    'Accept': 'application/json, text/plain, */*'
  }
} as LimeRequestConfig);

// ==========================================
// 1. 请求拦截器
// ==========================================
requestInstance.interceptors.request.use(
  (config: LimeRequestConfig): LimeRequestConfig => {
    if (config.header === null) {
      config.header = {} as UTSJSONObject;
    }
    const header = config.header as UTSJSONObject;
    // UPLOAD 由 uni.uploadFile 自动生成 multipart Content-Type（含 boundary），
    // 不能强制 JSON，否则 H5 端上传可能失败
    if (config.method != 'UPLOAD' && header['Content-Type'] == null) {
      header['Content-Type'] = ContentTypeEnum.AppJson;
    }
    if (header.Accept == null) {
      header.Accept = 'application/json, text/plain, */*';
    }
    const extra = config.extra;
    let ignoreAuth = false;
    if (extra != null) {
      const extraObj = extra as UTSJSONObject;
      const authVal = typeof extraObj.getBoolean === 'function'
        ? extraObj.getBoolean('ignoreAuth')
        : (extraObj.ignoreAuth as boolean | null);
      if (authVal == true) {
        ignoreAuth = true;
      }
    }
    if (!ignoreAuth) {
      const tokenStore = useTokenStore();
      const token = tokenStore.getToken();
      if (token == '') {
        throw new Error('[请求错误]：未登录');
      }
      header.token = token;
    }
    if (extra != null) {
      const extraObj = extra as UTSJSONObject;
      const domain = extraObj.domain as string | null;
      if (domain != null) {
        config.baseURL = domain;
      }
    }
    return config;
  },
  (error: LimeRequestFail): Promise<LimeRequestFail> => {
    return Promise.reject(error) as Promise<LimeRequestFail>;
  }
);

// ==========================================
// 2. 响应拦截器
// ==========================================
requestInstance.interceptors.response.use(
  (response: LimeRequestResponse<any>): LimeRequestResponse<any> => {
    const config = response.config;
    const extra = config.extra;
    const method = config.method;
    if (method === 'UPLOAD' || method === 'DOWNLOAD') {
      return response;
    }
    const statusCode = response.statusCode;
    if (statusCode != 200) {
      const errorMessage = ShowMessage(statusCode);
      console.error('errorMessage===>', errorMessage);
      uni.showToast({ title: errorMessage, icon: 'error' });
      if (statusCode == 401) {
        // 是否跳过自动刷新（刷新接口自身 / 明确声明不需要刷新的请求）
        let skipRefresh = false;
        if (extra != null) {
          const skipVal = (extra as UTSJSONObject).getBoolean('skipRefresh');
          if (skipVal == true) {
            skipRefresh = true;
          }
        }
        if (skipRefresh) {
          // 抛错即可，交由调用方处理；绝不在此清 token，避免刷新失败连锁登出
          throw new Error(`未授权[401]：${response.errMsg}`);
        }
        // 标记为可刷新错误，由 HttpClient.request 捕获后刷新并重放一次
        throw new Error(REFRESHABLE_401);
      }
      throw new Error(`${errorMessage}：${response.errMsg}`);
    }
    const rawData = response.data;
    if (rawData === null) {
      throw new Error('返回的响应数据为空');
    }
    const resultObj = JSON.parseObject(JSON.stringify(rawData));
    if (resultObj !== null) {
      const code = resultObj.getNumber('code');
      const msgByKey = resultObj.message as string | null;
      const msgByMsg = resultObj.msg as string | null;
      const message: string = msgByKey != null ? msgByKey : (msgByMsg != null ? msgByMsg : '未知错误');
      if (code !== null) {
        const codeVal = code as number;
        if (codeVal !== ResultEnum.Success0 && codeVal !== ResultEnum.Success200) {
          let toastEnabled = true;
          if (extra !== null) {
            const toastVal = (extra as UTSJSONObject).getBoolean('toast');
            if (toastVal == false) {
              toastEnabled = false;
            }
          }
          if (toastEnabled) {
            uni.showToast({ title: message, icon: 'none' });
          }
          if (codeVal === ResultEnum.Unauthorized) {
            let skipRefresh = false;
            if (extra != null) {
              const skipVal = (extra as UTSJSONObject).getBoolean('skipRefresh');
              if (skipVal == true) {
                skipRefresh = true;
              }
            }
            if (skipRefresh) {
              throw new Error(`请求错误[${codeVal}]：${message}`);
            }
            throw new Error(REFRESHABLE_401);
          }
          throw new Error(`请求错误[${codeVal}]：${message}`);
        }
      }
    }
    return response;
  },
  (error: LimeRequestFail): Promise<LimeRequestFail> => {
    console.error('request error ===>', error);
    uni.showToast({ title: '网络错误，请稍后再试', icon: 'none' });
    return Promise.reject(error) as Promise<LimeRequestFail>;
  }
);

// ==========================================
// 3. 封装 http 类（class 支持泛型方法 + this + 默认参数）
//    Android 端泛型方法需要 inline + reified 注解
// ==========================================

/** 判断错误是否为拦截器抛出的「可刷新 401」哨兵 */
function isRefreshable401(err: any): boolean {
  if (err == null) {
    return false;
  }
  if (typeof err == 'string') {
    return err == REFRESHABLE_401;
  }
  try {
    const obj = err as UTSJSONObject;
    const msg = obj.getString('message');
    return msg != null && msg == REFRESHABLE_401;
  }
  catch (_) {
    return false;
  }
}

/** 浅拷贝请求配置：重放时不能复用已被拦截器改写的对象，同时保留 getTask 等回调字段 */
function cloneConfig(config: LimeRequestConfig): LimeRequestConfig {
  return {
    url: config.url,
    method: config.method,
    data: config.data,
    params: config.params,
    header: config.header,
    timeout: config.timeout,
    baseURL: config.baseURL,
    dataType: config.dataType,
    responseType: config.responseType,
    sslVerify: config.sslVerify,
    withCredentials: config.withCredentials,
    enableCache: config.enableCache,
    enableQuic: config.enableQuic,
    enableChunked: config.enableChunked,
    forceCellularNetwork: config.forceCellularNetwork,
    enableCookie: config.enableCookie,
    defer: config.defer,
    files: config.files,
    getTask: config.getTask,
    extra: config.extra
  } as LimeRequestConfig;
}

/**
 * 把任意错误安全地转成 Error，供抛出使用。
 *
 * 严禁直接 `err as Error`：拦截器与 lime-request 失败回调抛出的是对象类型，
 * 强转在 Kotlin 端会抛 ClassCastException（skill 红线 19）。
 */
function toError(err: any): Error {
  if (err == null) {
    return new Error('请求失败');
  }
  if (typeof err == 'string') {
    return new Error(err as string);
  }
  const e = err as Error;
  if (e.message != null && e.message != '') {
    return e;
  }
  return new Error('请求失败');
}

export class HttpClient {
  request<T>(config: LimeRequestConfig): Promise<T> {
    return this.send<T>(config).catch((err: any): Promise<T> => {
      // 非 401 哨兵错误：原样抛出
      if (!isRefreshable401(err)) {
        throw toError(err);
      }
      // 刷新接口自身的 401 已在拦截器抛普通错误，不会走到这里
      return tryRefreshToken().then((ok: boolean): Promise<T> => {
        if (!ok) {
          this.handleUnauthorizedOnce();
          return Promise.reject(new Error('登录已过期，请重新登录')) as Promise<T>;
        }
        // 刷新成功：用同一份 config 重放一次（不递归，避免无限刷新）
        const replayConfig = cloneConfig(config);
        return this.send<T>(replayConfig).catch((replayErr: any): Promise<T> => {
          // 重放仍 401：刷新出来的 token 依然无效，只收尾一次
          if (isRefreshable401(replayErr)) {
            this.handleUnauthorizedOnce();
            return Promise.reject(new Error('登录已过期，请重新登录')) as Promise<T>;
          }
          throw toError(replayErr);
        });
      });
    });
  }

  /**
   * 清登录态并跳转登录页。
   *
   * 并发 401 时多个请求会同时拿到刷新失败，此处通过 claimRefreshFailure()
   * 保证只有第一个调用方真正执行收尾，避免重复清 token / 重复跳登录页。
   */
  private handleUnauthorizedOnce(): void {
    if (!claimRefreshFailure()) {
      return;
    }
    const tokenStore = useTokenStore();
    tokenStore.clearToken();
    toLoginPage({ mode: 'reLaunch' } as UTSJSONObject);
  }

  /** 实际发出请求并解包业务数据 */
  private send<T>(config: LimeRequestConfig): Promise<T> {
    return requestInstance.request<any>(config).then((res: LimeRequestResponse<any>): T => {
      const rawData = res.data;
      if (rawData === null) {
        throw new Error('响应数据为空');
      }
      const obj = JSON.parseObject(JSON.stringify(rawData));
      if (obj !== null) {
        const code = obj.getNumber('code');
        if (code !== null) {
          const innerData = obj.get('data');
          if (innerData !== null) {
            return innerData as T;
          }
          throw new Error('响应结构包含 code，但 data 字段为空');
        }
      }
      return rawData as T;
    });
  }

  get<T>(url: string, config: LimeRequestConfig | null = null): Promise<T> {
    const _config = (config ?? {}) as LimeRequestConfig;
    _config.url = url;
    _config.method = 'GET';
    return this.request<T>(_config);
  }

  post<T>(url: string, data: any | null = null, config: LimeRequestConfig | null = null): Promise<T> {
    const _config = (config ?? {}) as LimeRequestConfig;
    _config.url = url;
    _config.data = data;
    _config.method = 'POST';
    return this.request<T>(_config);
  }

  put<T>(url: string, data: any | null = null, config: LimeRequestConfig | null = null): Promise<T> {
    const _config = (config ?? {}) as LimeRequestConfig;
    _config.url = url;
    _config.data = data;
    _config.method = 'PUT';
    return this.request<T>(_config);
  }

  delete<T>(url: string, data: any | null = null, config: LimeRequestConfig | null = null): Promise<T> {
    const _config = (config ?? {}) as LimeRequestConfig;
    _config.url = url;
    _config.data = data;
    _config.method = 'DELETE';
    return this.request<T>(_config);
  }

  /**
   * 上传文件（lime-request UPLOAD，自动携带 token，响应为原始 JSON 字符串）
   */
  upload<T>(url: string, config: LimeRequestConfig | null = null): Promise<T> {
    return requestInstance.upload(url, config).then((res: LimeRequestResponse<any>): T => {
      const rawData = res.data;
      if (rawData === null) {
        throw new Error('上传响应为空');
      }
      return rawData as T;
    });
  }
}

export const http = new HttpClient();
export default http;
