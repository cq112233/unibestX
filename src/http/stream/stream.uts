/**
 * 流式请求封装 —— 基于 uni.request 的 chunked 分块接收，输出为 Observable 流
 *
 * 设计目标：把「真实 SSE 分块接口」与「本地模拟流」统一成同一个 Observable<StreamChunk>，
 * 页面侧只需要切换数据源，下游的流处理逻辑（map / scan / takeUntil / catchError）完全复用。
 *
 * 平台支持：uni.request 的 enableChunked 与 RequestTask.onChunkReceived
 * 在 Web / Android / iOS / 鸿蒙 4.71+ 均可用（本项目 uni-app X 版本远高于此）。
 *
 * @example
 * ```uts
 * import { requestStream, simulateStream } from '@/src/http/stream/stream.uts';
 * import { scan, takeUntil } from '@/src/utils/rxjs-lite/index.uts';
 *
 * const source = requestStream(url, body, null, 60000);
 * const sub = source
 *   .pipe(scan((acc: string, chunk: StreamChunk): string => acc + chunk.text, ''))
 *   .subscribe((full: string): void => { content.value = full; });
 * ```
 */

import { Observable } from '@/src/utils/rxjs-lite/index.uts';
import type { Subscriber, TeardownFn } from '@/src/utils/rxjs-lite/index.uts';

// ==========================================
// 类型定义（禁止 interface，统一使用 type）
// ==========================================

/** 流式数据块 */
export type StreamChunk = {
  /** 本次新到达的文本片段 */
  text: string;
  /** 累计已接收的字符数 */
  receivedLength: number;
  /** 从发起请求到收到该块的耗时（毫秒） */
  elapsedMs: number;
};

// ==========================================
// 增量 UTF-8 解码器
// ==========================================

/**
 * 增量 UTF-8 解码器
 *
 * 为什么需要它：UTS 内置的 TextDecoder.decode() 只有单参数签名（没有 Web 端的 `{ stream: true }`），
 * 若直接对每个 chunk 调用 decode()，被 chunk 边界切断的多字节字符（中文、emoji）会被替换成
 * U+FFFD「」。本类自持一个尾部字节缓冲，只解码完整的 UTF-8 字符序列，残缺尾部留给下一块拼接。
 */
export class Utf8StreamDecoder {
  /** 上一块遗留的不完整多字节序列；不能直接丢弃，丢了那个字符就会解码成 U+FFFD */
  private _pending: Array<number> = [];
  private _decoder: TextDecoder = new TextDecoder('utf-8');

  /**
   * 解码一个 chunk
   * @param buffer 本次到达的原始字节；平台给的是 ArrayBuffer，内部才转成 Uint8Array
   * @returns 本次可安全输出的文本；返回空串表示这一块全是被截断的多字节字符 ——
   *          那些字节已留在 _pending 里等下一块拼，调用方按「本次没有新文本」处理即可
   */
  decodeChunk(buffer: ArrayBuffer): string {
    const incoming = new Uint8Array(buffer);
    const merged: Array<number> = this._pending;
    const incomingLen = incoming.length;
    for (let i: number = 0; i < incomingLen; i++) {
      merged.push(incoming[i]);
    }
    const total = merged.length;
    const safeEnd = this._findSafeEnd(merged, total);
    if (safeEnd <= 0) {
      // 整段都还不完整，继续等下一块
      this._pending = merged;
      return '';
    }
    const safe = new Uint8Array(safeEnd);
    for (let i: number = 0; i < safeEnd; i++) {
      safe[i] = merged[i];
    }
    const rest: Array<number> = [];
    for (let i: number = safeEnd; i < total; i++) {
      rest.push(merged[i]);
    }
    this._pending = rest;
    return this._decoder.decode(safe);
  }

  /** 清空缓冲（重新发起请求前调用） */
  reset(): void {
    this._pending = [];
  }

  /**
   * 从尾部向前寻找可安全解码的结束位置。
   * 末尾若存在被截断的多字节序列，则把该序列整体留给下一块。
   * @param bytes 待扫描的字节缓冲（已含上一块遗留的残缺序列）
   * @param total 缓冲总长度，取值与 bytes.length 相同
   */
  private _findSafeEnd(bytes: Array<number>, total: number): number {
    if (total <= 0) {
      return 0;
    }
    // 最多向前回溯 4 字节（UTF-8 单字符最长 4 字节），跳过续接字节 0b10xxxxxx
    let contCount: number = 0;
    let idx: number = total - 1;
    let scanned: number = 0;
    while (idx >= 0 && scanned < 4) {
      const b: number = bytes[idx];
      if ((b & 0xC0) == 0x80) {
        contCount = contCount + 1;
        idx = idx - 1;
        scanned = scanned + 1;
        continue;
      }
      break;
    }
    if (idx < 0) {
      // 整段都是续接字节（异常数据），全部留待下一块
      return 0;
    }
    const lead: number = bytes[idx];
    let expected: number = 1;
    if ((lead & 0x80) == 0x00) {
      expected = 1;
    }
    else if ((lead & 0xE0) == 0xC0) {
      expected = 2;
    }
    else if ((lead & 0xF0) == 0xE0) {
      expected = 3;
    }
    else if ((lead & 0xF8) == 0xF0) {
      expected = 4;
    }
    else {
      // 非法起始字节，按单字节放行，交给 TextDecoder 输出 U+FFFD
      expected = 1;
    }
    if (contCount + 1 >= expected) {
      // 该字符已完整到达
      return total;
    }
    // 该字符被截断，从它的起始字节处切开
    return idx;
  }
}

// ==========================================
// 真实流式请求
// ==========================================

/**
 * 发起一个 chunked 流式 POST 请求，返回逐块吐出文本的 Observable。
 *
 * 订阅时立即发起请求；取消订阅（unsubscribe）会 abort 掉底层 RequestTask，
 * 流正常完成或出错时也会自动释放。
 *
 * @param url 完整请求地址
 * @param body 请求体（字符串，通常是 JSON.stringify 的结果）
 * @param header 请求头，不需要时传 null
 * @param timeout 超时时间（毫秒）
 */
export function requestStream(
  url: string,
  body: string,
  header: UTSJSONObject | null = null,
  timeout: number = 60000
): Observable<StreamChunk> {
  return new Observable<StreamChunk>((subscriber: Subscriber<StreamChunk>): TeardownFn | null => {
    const startTime: number = Date.now();
    const decoder = new Utf8StreamDecoder();
    let receivedText: string = '';
    let settled: boolean = false;
    // 错误统一以 Error 实例下沉，页面侧用 `err instanceof Error` 即可安全取文案，
    // 规避 UTS 中对象字面量 / UTSJSONObject 类型断言的运行时不确定性
    const settle = (errMsg: string | null): void => {
      if (settled) {
        return;
      }
      settled = true;
      if (errMsg == null) {
        subscriber.complete();
      }
      else {
        subscriber.error(new Error(errMsg));
      }
    };
    const requestHeader: UTSJSONObject = header != null
      ? header
      : {
          'Content-Type': 'application/json',
          'Accept': 'text/event-stream, application/x-ndjson, application/json'
        } as UTSJSONObject;
    const task = uni.request({
      url,
      method: 'POST',
      data: body,
      header: requestHeader,
      timeout,
      enableChunked: true,
      responseType: 'arraybuffer',
      dataType: 'text',
      success: (_res) => {
        settle(null);
      },
      fail: (err) => {
        let msg = '网络请求失败';
        if (err != null && err.errMsg != null) {
          msg = `${err.errMsg}`;
        }
        settle(msg);
      }
    });
    // 逐块接收：解码 → 累积 → 推送
    task.onChunkReceived((result) => {
      if (settled) {
        return;
      }
      const text = decoder.decodeChunk(result.data);
      if (text.length <= 0) {
        return;
      }
      receivedText = receivedText + text;
      subscriber.next({
        text,
        receivedLength: receivedText.length,
        elapsedMs: Date.now() - startTime
      } as StreamChunk);
    });
    // 取消订阅时中断底层请求
    return (): void => {
      settled = true;
      task.abort();
    };
  });
}

// ==========================================
// 本地模拟流
// ==========================================

/**
 * 本地模拟流：把一段完整文本按 chunkSize 切片、以 intervalMs 为间隔逐块吐出。
 *
 * 与 requestStream 返回完全相同的 Observable<StreamChunk> 类型，
 * 因此可作为「真实接口不可用」时的降级数据源（配合 catchError 使用）。
 *
 * @param text 要模拟输出的完整文本
 * @param chunkSize 每块字符数（默认 6）
 * @param intervalMs 每块间隔毫秒数（默认 90）
 */
export function simulateStream(
  text: string,
  chunkSize: number = 6,
  intervalMs: number = 90
): Observable<StreamChunk> {
  return new Observable<StreamChunk>((subscriber: Subscriber<StreamChunk>): TeardownFn | null => {
    const startTime: number = Date.now();
    const totalLen = text.length;
    if (totalLen <= 0) {
      subscriber.complete();
      return null;
    }
    let cursor: number = 0;
    let receivedLength: number = 0;
    // 必须先声明再赋值，不能写成 `const timerId = setInterval(() => { ... clearInterval(timerId) ... })`：
    // 回调体里引用了 timerId 自己，Kotlin 端会报「找不到名称 timerId」
    // （变量在自身初始化表达式中不可见；JS 因为回调延后执行才侥幸能跑）。
    let timerId: number = 0;
    // ⚠️ 外层 `as any) as number` 不可省：DOM lib 的 setInterval 返回 number（UTS 侧同样为 number），
    // 但 @types/node（经 vite.config.ts 引入）把返回值声明为 Timeout，TS 侧直接赋值报
    // TS2322「不能将类型 Timeout 分配给类型 number」。同写法先例：src/sub/timeFunctionDemo/timeFunctionDemo.uvue:151
    timerId = (setInterval((): void => {
      const remain = totalLen - cursor;
      const size = remain < chunkSize ? remain : chunkSize;
      const piece = text.substring(cursor, cursor + size);
      cursor = cursor + size;
      receivedLength = receivedLength + piece.length;
      subscriber.next({
        text: piece,
        receivedLength,
        elapsedMs: Date.now() - startTime
      } as StreamChunk);
      if (cursor >= totalLen) {
        clearInterval(timerId);
        subscriber.complete();
      }
    }, intervalMs) as any) as number;
    return (): void => {
      clearInterval(timerId);
    };
  });
}
