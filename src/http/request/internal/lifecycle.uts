/**
 * 请求生命周期管理：主动取消 / 并发去重 / TTL 缓存
 *
 * 封装为纯面向对象的 RequestLifecycle 类：
 * - taskMap      requestKey → RequestTask，供 abort(key) 取消在飞请求
 * - abortedMap   requestKey → true，标记已取消，防止竞态回调把结果继续往下喂
 * - inflightMap  请求指纹 → Promise，GET 并发去重时后来者复用同一份结果
 * - cacheMap     请求指纹 → CacheEntry，内存级 TTL 缓存
 *
 * 全生命周期状态与操作统一收敛在实例中，彻底支持多实例隔离。
 */

import type { LimeRequestConfig, LimeRequestTask } from '@/uni_modules/lime-request';

/**
 * 在飞请求任务类型
 */
export type AbortableTask = RequestTask;

/**
 * 内存 TTL 缓存条目类型：指纹 → { expireAt, value }
 */
export type CacheEntry = {
  expireAt: number;
  value: string;
};

/**
 * HTTP 请求生命周期控制器类
 */
export class RequestLifecycle {
  private taskMap: Map<string, AbortableTask> = new Map<string, AbortableTask>();
  private abortedMap: Map<string, boolean> = new Map<string, boolean>();
  private inflightMap: Map<string, any> = new Map<string, any>();
  private cacheMap: Map<string, CacheEntry> = new Map<string, CacheEntry>();

  // ==========================================
  // 1. requestKey 读写
  // ==========================================

  /**
   * 从 config.extra 读取字符串字段，缺失返回空串。
   */
  static readExtraString(config: LimeRequestConfig, key: string): string {
    const extra = config.extra;
    if (extra == null) {
      return '';
    }
    const extraObj = extra as UTSJSONObject;
    const v = typeof extraObj.getString == 'function'
      ? extraObj.getString(key)
      : (extraObj[key] as string | null);
    return v != null ? v : '';
  }

  /**
   * 实例方法：从 config.extra 读取字符串字段
   */
  readExtraString(config: LimeRequestConfig, key: string): string {
    return RequestLifecycle.readExtraString(config, key);
  }

  /** 从 config.extra 读取数字字段，缺失返回 0 */
  static readExtraNumber(config: LimeRequestConfig, key: string): number {
    const extra = config.extra;
    if (extra == null) {
      return 0;
    }
    const extraObj = extra as UTSJSONObject;
    const v = typeof extraObj.getNumber == 'function'
      ? extraObj.getNumber(key)
      : (extraObj[key] as number | null);
    return v != null ? v : 0;
  }

  /** 实例方法：从 config.extra 读取数字字段 */
  readExtraNumber(config: LimeRequestConfig, key: string): number {
    return RequestLifecycle.readExtraNumber(config, key);
  }

  /** 从 config.extra 读取布尔字段，缺失返回 false */
  static readExtraBoolean(config: LimeRequestConfig, key: string): boolean {
    const extra = config.extra;
    if (extra == null) {
      return false;
    }
    const extraObj = extra as UTSJSONObject;
    const v = typeof extraObj.getBoolean == 'function'
      ? extraObj.getBoolean(key)
      : (extraObj[key] as boolean | null);
    return v != null && v == true;
  }

  /** 实例方法：从 config.extra 读取布尔字段 */
  readExtraBoolean(config: LimeRequestConfig, key: string): boolean {
    return RequestLifecycle.readExtraBoolean(config, key);
  }

  // ==========================================
  // 2. 取消：登记 / 中止 / 判定
  // ==========================================

  /**
   * 登记在飞请求，供后续 abort。
   */
  registerTask(requestKey: string, task: LimeRequestTask): void {
    if (requestKey == '') {
      return;
    }
    this.taskMap.set(requestKey, task as AbortableTask);
  }

  /** 请求结束后摘除登记（成功或失败都要调，避免 Map 泄漏） */
  clearTask(requestKey: string): void {
    if (requestKey == '') {
      return;
    }
    this.taskMap.delete(requestKey);
  }

  /** 该 requestKey 是否已被标记取消 */
  isAborted(requestKey: string): boolean {
    if (requestKey == '') {
      return false;
    }
    const v = this.abortedMap.get(requestKey);
    return v != null && v == true;
  }

  /** 消费取消标记：读取并清除，避免污染同 key 的下一次请求 */
  consumeAborted(requestKey: string): boolean {
    if (requestKey == '') {
      return false;
    }
    if (this.abortedMap.get(requestKey) != true) {
      return false;
    }
    this.abortedMap.delete(requestKey);
    return true;
  }

  /**
   * 取消指定 requestKey 的在飞请求。
   */
  abort(requestKey: string): void {
    if (requestKey == '') {
      return;
    }
    this.abortedMap.set(requestKey, true);
    const task = this.taskMap.get(requestKey);
    if (task != null) {
      try {
        task.abort();
      }
      catch (e) {
        console.warn('[request] abort fail', requestKey, e);
      }
    }
    this.taskMap.delete(requestKey);
    this.inflightMap.delete(requestKey);
    console.log('[request] abort', requestKey);
  }

  /** 取消全部在飞请求 */
  abortAll(): void {
    const keys: Array<string> = [];
    this.taskMap.forEach((_task: AbortableTask, key: string) => {
      keys.push(key);
    });
    for (let i = 0; i < keys.length; i = i + 1) {
      this.abort(keys[i]);
    }
  }

  // ==========================================
  // 3. 并发去重（GET）
  // ==========================================

  /** 生成请求指纹：method + url + 序列化后的 data */
  static buildRequestKey(config: LimeRequestConfig): string {
    const method = config.method != null ? config.method : 'GET';
    const url = config.url != null ? config.url : '';
    let dataPart = '';
    if (config.data != null) {
      try {
        dataPart = JSON.stringify(config.data);
      }
      catch (_) {
        dataPart = '';
      }
    }
    return `${method}|${url}|${dataPart}`;
  }

  /** 实例方法：生成请求指纹 */
  buildRequestKey(config: LimeRequestConfig): string {
    return RequestLifecycle.buildRequestKey(config);
  }

  /** 取进行中的同指纹请求（没有则返回 null） */
  getInflight<T>(fingerprint: string): Promise<T> | null {
    const p = this.inflightMap.get(fingerprint);
    if (p == null) {
      return null;
    }
    return p as Promise<T>;
  }

  /** 登记进行中的请求，结束后自动摘除（成功失败都要摘） */
  setInflight<T>(fingerprint: string, task: Promise<T>): void {
    this.inflightMap.set(fingerprint, task);
    task.then(
      (_r: T) => {
        if (this.inflightMap.get(fingerprint) == task) {
          this.inflightMap.delete(fingerprint);
        }
      },
      (_e: any) => {
        if (this.inflightMap.get(fingerprint) == task) {
          this.inflightMap.delete(fingerprint);
        }
      }
    );
  }

  // ==========================================
  // 4. 内存 TTL 缓存
  // ==========================================

  /** 写入缓存；ttlMs <= 0 不写 */
  setCache(fingerprint: string, value: string, ttlMs: number): void {
    if (fingerprint == '' || ttlMs <= 0) {
      return;
    }
    this.cacheMap.set(fingerprint, {
      expireAt: Date.now() + ttlMs,
      value
    } as CacheEntry);
  }

  /** 读取缓存；过期则删除并返回 null */
  getCache(fingerprint: string): string | null {
    if (fingerprint == '') {
      return null;
    }
    const entry = this.cacheMap.get(fingerprint);
    if (entry == null) {
      return null;
    }
    if (Date.now() >= entry.expireAt) {
      this.cacheMap.delete(fingerprint);
      return null;
    }
    return entry.value;
  }

  /** 手动清缓存：不传 key 清全部，传 key 清单条 */
  clearCache(fingerprint: string = ''): void {
    if (fingerprint == '') {
      this.cacheMap.clear();
      return;
    }
    this.cacheMap.delete(fingerprint);
  }
}

/**
 * 别名类：HttpLifecycle
 */
export class HttpLifecycle extends RequestLifecycle {}

/**
 * 默认全局请求生命周期单例
 */
export const defaultLifecycle: RequestLifecycle = new RequestLifecycle();
