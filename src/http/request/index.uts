/**
 * 原生 HTTP 请求核心门面 (Native Request Facade)
 *
 * 聚合基础强类型定义、HttpClient 控制器与纯净工厂函数。
 * 结构清晰分层：
 * - core/  : 核心调度引擎、生命周期管理、传输常量与核心强类型
 * - util/  : URL 合并序列化、错误提取与配置复制等工具函数
 *
 * 纯原生驱动，零第三方库依赖，零业务代码耦合，可直接独立发布为 uni_modules/http-bestX。
 */

import { ContentTypeEnum } from './core/enum.uts';
import { defaultLifecycle } from './core/lifecycle.uts';
import { HttpClient } from './core/client.uts';
import type { HttpClientOptions } from './core/types.uts';

// 1. 核心控制器与传输协议枚举
export { HttpClient } from './core/client.uts';
export { ContentTypeEnum } from './core/enum.uts';
export { abortRequest, defaultLifecycle, HttpLifecycle, RequestLifecycle } from './core/lifecycle.uts';
export type { CacheEntry } from './core/lifecycle.uts';

// 3. 核心强类型与异常类定义
export {
  HttpError
} from './core/types.uts';

export type {
  AbortableTask,
  AfterResponseCompleteHook,
  AfterResponseErrorHook,
  AfterResponseOptions,
  AfterResponseSuccessHook,
  BeforeRequestHook,
  DownloadResult,
  HttpClientOptions,
  HttpFailResult,
  HttpRequestAdapter,
  HttpRequestConfig,
  HttpRequestMethod,
  HttpResponse,
  RespondedOptions,
  StreamTask
} from './core/types.uts';
// 2. 组合式请求 Hook
export * from './hooks/index.uts';

// 4. 通用工具函数
export {
  cloneConfig,
  extractErrorMessage,
  extractStatusCode,
  toError
} from './util/helper.uts';
export {
  buildRequestUrl,
  stringifyQueryParams
} from './util/url.uts';

// ==========================================
// 5. 核心纯净工厂函数
// ==========================================

/**
 * 工厂函数：统一创建并生成 HttpClient 原生底层客户端实例（纯净基础设施引擎，无预置业务代码）
 * @param options 客户端配置；传 null 时初始化一个纯净无业务拦截的基础实例
 */
export function createHttpClient(options: HttpClientOptions | null = null): HttpClient {
  if (options == null) {
    const pureOptions: HttpClientOptions = {
      baseURL: '',
      timeout: 5000,
      header: {
        'Content-Type': ContentTypeEnum.AppJson,
        'Accept': 'application/json, text/plain, */*'
      } as UTSJSONObject,
      lifecycle: defaultLifecycle
    };
    return new HttpClient(pureOptions);
  }
  return new HttpClient(options);
}
