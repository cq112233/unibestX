/**
 * 副业务 HTTP 实例 (Secondary HTTP Instance)
 *
 * 接口基础地址指向 VITE_SERVER_BASEURL_SECONDARY
 */

import { getApiSecondaryUrl } from '@/src/config/index.uts';
import type { HttpClient } from '@/uni_modules/request-bestX/index.uts';
import { createApiInstance } from './internal/factory.uts';

/**
 * 备用/副业务 HTTP 客户端单例（指向 VITE_SERVER_BASEURL_SECONDARY，H5 代理时走指定字段 /api-secondary）
 *
 * 对应 `vite.config.ts` 中 `server.proxy` 的代理规则配置：
 * ```ts
 * // vite.config.ts
 * server: {
 *   proxy: {
 *     '/api-secondary': {
 *       target: env.VITE_SERVER_BASEURL_SECONDARY || env.VITE_GATEWAY_BASEURL || env.VITE_SERVER_BASEURL || 'http://localhost:8080',
 *       changeOrigin: true,
 *       rewrite: (p) => p.replace(/^\/api-secondary/, '')
 *     }
 *   }
 * }
 * ```
 * 默认不传第三个参数，与主业务 `http` 实例共同继承 `./internal/factory.uts` 的全局统一配置；
 * 当前使用单 Token，默认不启用 401 静默刷新。
 */
export const secondaryHttp: HttpClient = createApiInstance(getApiSecondaryUrl(), '/api-secondary');
