/**
 * 默认主业务 HTTP 实例 (Default HTTP Instance)
 *
 * 接口基础地址指向 VITE_SERVER_BASEURL，H5 开启代理时默认走第一个代理字段 '/api'
 */

import { getApiBaseUrl } from '@/src/config/index.uts';
import type { HttpClient } from '@/uni_modules/request-bestX/index.uts';
import {
  createApiInstance
} from './internal/factory.uts';

/**
 * 默认主业务 HTTP 客户端单例（指向 VITE_SERVER_BASEURL，H5 代理走第一个代理字段 /api）
 *
 * `createApiInstance` 参数说明：
 * @param baseURL API 服务根地址，默认通过 `getApiBaseUrl()` 获取
 * @param proxyPrefix H5 开启代理时的代理前缀字段，默认 `'/api'`。
 *                    对应 `vite.config.ts` 中 `server.proxy` 的代理规则配置：
 *                    ```ts
 *                    // vite.config.ts
 *                    server: {
 *                      proxy: {
 *                        '/api': {
 *                          target: env.VITE_SERVER_BASEURL || 'http://localhost:3000',
 *                          changeOrigin: true,
 *                          rewrite: (p) => p.replace(/^\/api/, '')
 *                        }
 *                      }
 *                    }
 *                    ```
 *                    当 `.env` 中 `VITE_H5_USE_PROXY=true` 时，H5 端请求将走此代理以解决跨域；App / 小程序端则直连 `baseURL`。
 * @param customOptions 可选个性化定制参数（`HttpClientOptions`），用于覆盖基础配置与扩展钩子：
 *                      - `timeout`: 自定义超时时间（默认 30000ms）
 *                      - `header`: 自定义公共请求头
 *                      - `lifecycle` / `beforeRequest` / `afterSuccess` / `afterError` / `afterComplete`: 自定义拦截器钩子
 *
 * 💡 提示：
 * 若不传第三个参数（保持默认），多个业务实例（如 `http`、`secondaryHttp` 等）都统一走
 * `./internal/factory.uts` 中的全局默认配置（包含通用的业务 Token 鉴权注入、
 * 业务错误码统一 Toast 提示与结果解包等）。当前项目使用单 Token，默认不启用 401 静默刷新；
 * 如后续接入双 Token，可在第三个参数中注入 `refreshToken` 回调。
 *
 * 示例（传入第三个参数局部覆盖）：
 * ```uts
 * export const http: HttpClient = createApiInstance(getApiBaseUrl(), '/api', {
 *   timeout: 15000
 * } as HttpClientOptions);
 * ```
 */
export const http: HttpClient = createApiInstance(getApiBaseUrl(), '/api');
