/**
 * 默认主业务 HTTP 实例 (Default HTTP Instance)
 *
 * 接口基础地址指向 VITE_SERVER_BASEURL，H5 开启代理时默认走第一个代理字段 '/api'
 */

import type { LimeRequestConfig } from '@/uni_modules/lime-request';
import { getApiBaseUrl } from '@/src/config/index.uts';
import type {
  DownloadResult,
  HttpClient,
  StreamTask
} from '../request/request.uts';
import {
  createApiInstance
} from './internal/factory.uts';

/**
 * 默认主业务 HTTP 客户端单例（指向 VITE_SERVER_BASEURL，H5 代理走第一个代理字段 /api）
 */
export const http: HttpClient = createApiInstance(getApiBaseUrl(), '/api');

// ==========================================
// 便捷代理函数（默认委托给主业务 http 单例）
// ==========================================

/**
 * 取消指定 requestKey 的在飞请求（委托给默认 http 实例）
 */
export function abortHttp(requestKey: string): void {
  http.abort(requestKey);
}

/**
 * 取消全部在飞请求（委托给默认 http 实例）
 */
export function abortAllHttp(): void {
  http.abortAll();
}

/**
 * 清除缓存（委托给默认 http 实例）
 */
export function clearCache(fingerprint: string = ''): void {
  http.clearCache(fingerprint);
}

/**
 * 便捷文件上传（委托给默认 http 实例）
 */
export function uploadHttp<T>(url: string, config: LimeRequestConfig | null = null): Promise<T> {
  return http.upload<T>(url, config);
}

/**
 * 便捷文件下载（委托给默认 http 实例）
 */
export function downloadHttp(url: string, config: LimeRequestConfig | null = null): Promise<DownloadResult> {
  return http.downloadFile(url, config);
}

/**
 * 便捷函数：chunked 流式请求（委托给默认 http 实例），方法固定为 POST
 *
 * @param url 请求地址：支持完整 http(s):// 地址，相对路径会与配置里的 baseURL 拼接
 * @param body 请求体（通常是 JSON.stringify 的结果）
 * @param onChunk 字节块到达回调
 * @param onEnd 流收尾回调
 * @param config 覆盖项，传 null 走默认配置
 */
export function streamHttp(
  url: string,
  body: string,
  onChunk: (data: ArrayBuffer) => void,
  onEnd: (errMsg: string | null) => void,
  config: LimeRequestConfig | null = null
): StreamTask {
  const _config = (config ?? {}) as LimeRequestConfig;
  _config.url = url;
  _config.data = body;
  _config.method = 'POST';
  _config.enableChunked = true;
  _config.responseType = 'arraybuffer';
  _config.dataType = 'text';
  return http.stream(_config, onChunk, onEnd);
}
