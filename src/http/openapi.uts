/**
 * openapi-ts-request 业务网络驱动适配器
 *
 * 抹平 openapi-ts-request 自动生成代码的调用风格 (url, options)
 * 与 unibestX 业务实例 (http / secondaryHttp) 的连接。
 */

import { http, secondaryHttp } from '@/src/http/instances/index.uts';
import type { HttpClient, HttpRequestConfig } from '@/uni_modules/request-bestX/index.uts';

/**
 * openapi 请求参数类型（直接复用底层强类型的 HttpRequestConfig）
 */
export type OpenApiRequestOptions = HttpRequestConfig;

/**
 * 通用请求执行器：组装 url 与 options 并发起请求
 */
function executeRequest<T>(client: HttpClient, url: string, options: HttpRequestConfig | null = null): Promise<T> {
  const config = (options != null ? options! : ({} as HttpRequestConfig));
  config.url = url;
  return client.request<T>(config);
}

/**
 * 主服务请求函数（默认走主服务器 http / /api）
 */
export function request<T>(url: string, options: HttpRequestConfig | null = null): Promise<T> {
  return executeRequest<T>(http, url, options);
}

/**
 * 副服务请求函数（显式强制走副服务器 secondaryHttp / /api-secondary）
 */
export function secondaryRequest<T>(url: string, options: HttpRequestConfig | null = null): Promise<T> {
  return executeRequest<T>(secondaryHttp, url, options);
}

export default request;
