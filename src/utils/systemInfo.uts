        console.log(`safeBottom:${safeBottom}`,34);
        console.log(`safeTop:${safeTop}`,0);
        console.log('----', sys.screenHeight - sys.statusBarHeight - sys.navBarHeight - sys.tabBarHeight - safeBottom)
        sys.availableHeight = sys.screenHeight - sys.navBarHeight - sys.statusBarHeight - sys.tabBarHeight - safeBottom;
        console.log(`蒸汽模式-IOS-availableHeight: ${sys.availableHeight}`);
      }
      else {
        console.log(`第${systemId}次`);
        console.log('VDOM-IOS😂');
        console.log(`窗口windowHeight:${sys.windowHeight}`);
        console.log(`状态栏statusBarHeight:${sys.statusBarHeight}`);
        console.log(`导航栏navBarHeight:${sys.navBarHeight}`);
        console.log(`tabBarHeight:${sys.tabBarHeight}`);
        console.log(`safeBottom:${safeBottom}`);
        if (systemId <= 1) {
          sys.availableHeight = sys.windowHeight - statusBarOffset - navBarOffset - safeBottom;
          console.log(`availableHeight得到高度:${sys.availableHeight}`);
        }
        else {
          sys.availableHeight = sys.windowHeight - statusBarOffset - navBarOffset - sys.tabBarHeight - safeBottom;
          console.log(`availableHeight得到高度:${sys.availableHeight}`);
        }
        systemId++;
      }
      // #endif

      // #ifdef APP-HARMONY
      if (isVaporMode()) {
        console.log(`第${systemId}次`);
        console.log('蒸汽-鸿蒙😂');
        console.log(`窗口screenHeight:${sys.screenHeight}`);
        console.log(`窗口windowHeight:${sys.windowHeight}`,749);
        console.log(`状态栏statusBarHeight:${sys.statusBarHeight}`,54);
        console.log(`导航栏navBarHeight:${sys.navBarHeight}`,44);
        console.log(`tabBarHeight:${sys.tabBarHeight}`,50);
        console.log(`safeBottom:${safeBottom}`,34);
        console.log(`safeTop:${safeTop}`,0);
        console.log('----', sys.screenHeight - sys.statusBarHeight - sys.navBarHeight - sys.tabBarHeight - safeBottom)
        if (systemId <= 1) {
          sys.availableHeight = sys.windowHeight - sys.statusBarHeight - sys.navBarHeight;
        }
        else {
          sys.availableHeight = sys.windowHeight -  sys.navBarHeight  - sys.navBarHeight - sys.tabBarHeight - safeBottom;
        }
        systemId++;
      }
      else {
        console.log(`第${systemId}次`);
        console.log('VDOM鸿蒙😂');
        console.log(`窗口screenHeight:${sys.screenHeight}`);
        console.log(`窗口windowHeight:${sys.windowHeight}`,749);
        console.log(`状态栏statusBarHeight:${sys.statusBarHeight}`,54);
        console.log(`导航栏navBarHeight:${sys.navBarHeight}`,44);
        console.log(`tabBarHeight:${sys.tabBarHeight}`,50);
        console.log(`safeBottom:${safeBottom}`,34);
        console.log(`safeTop:${safeTop}`,0);
        if (systemId <= 1) {
          sys.availableHeight = sys.windowHeight - sys.statusBarHeight - sys.navBarHeight - sys.tabBarHeight - safeBottom;
          console.log(`availableHeight得到高度:${sys.availableHeight}`);
        }
        else {
          sys.availableHeight = sys.windowHeight - sys.statusBarHeight - sys.navBarHeight - sys.tabBarHeight - safeBottom;
          console.log(`availableHeight得到高度:${sys.availableHeight}`);
        }
        systemId++;
      }
      // #endif

      // #ifdef MP-WEIXIN
      console.log('微信小程序😂', sys.windowHeight, sys.statusBarHeight, sys.navBarHeight, sys.tabBarHeight, safeBottom);
      sys.availableHeight = sys.windowHeight - statusBarOffset - navBarOffset - sys.tabBarHeight - safeBottom;
      // #endif
    }
  }
  // if (selectedTabbarStrategy === 1) {

  // }
  console.log('AppKu:', sys.availableHeight, selectedTabbarStrategy, isCustomNav, 'selectedTabbarStrategy');
}

