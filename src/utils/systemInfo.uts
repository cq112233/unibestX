        sys.availableHeight = sys.windowHeight - statusBarOffset - navBarOffset - sys.tabBarHeight;
      }
      systemId++;
      // #endif

      // #ifdef APP-ANDROID
      if (isVaporMode()) {
        //👌 695
        console.log(`第${systemId}次`);
        console.log('蒸汽安卓😂', sys.windowHeight, sys.statusBarHeight, sys.navBarHeight, safeAreaBottom.value, safeBottom);
        sys.availableHeight = sys.windowHeight - statusBarOffset - navBarOffset - sys.tabBarHeight - safeBottom;
