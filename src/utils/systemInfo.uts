import { computed, ref } from 'vue';
import { customTabbarConfig } from '../tabbar/config.uts';

/**
 * NavBar 内容区默认基准高度（不含状态栏，单位 px，标准 44px）
 */
export const NAVBAR_CONTENT_HEIGHT: number = 44;

/**
 * TabBar 默认基准高度（单位 px，标准 50px）
 */
export const TABBAR_BASE_HEIGHT: number = 50;

// eslint-disable-next-line import/no-mutable-exports
export let systemId: number = 0;

export type SystemSafeAreaInsets = {
  top: number;
  right: number;
  bottom: number;
  left: number;
};

export type SystemSafeArea = {
  top: number;
  right: number;
  bottom: number;
  left: number;
  width: number;
  height: number;
};

export type SystemInfoType = {
  // 窗口与屏幕尺寸
  screenWidth: number;
  screenHeight: number;
  windowWidth: number;
  windowHeight: number;
  statusBarHeight: number;
  // 可用内容高度 = 窗口高度 - 状态栏高度
  availableHeight: number;
  navBarHeight: number;
  tabBarHeight: number;
  pixelRatio: number;
  // 设备信息
  brand: string;
  model: string;
  system: string;
  // 编译引擎与平台信息
  compilerVersion: string;
  uniCompileVersion: string;
  isVapor: boolean;
  compileMode: string;
  platformName: string;
  // 应用与环境变量
  appTitle: string;
  appVersion: string;
  apiBaseUrl: string;
  env: string;
  envName: string;
  // 安全区域插入距离（同时独立挂一份到 safeAreaInsets ref 上）
  safeAreaInsets: SystemSafeAreaInsets | null;
  safeArea: SystemSafeArea | null;
};

export const systemInfo = ref(null as SystemInfoType | null);
export const safeAreaInsets = ref(null as SystemSafeAreaInsets | null);

/** 便捷响应式：窗口/屏幕宽度（px），未初始化时为 0 */
export const windowWidth = computed<number>((): number => systemInfo.value?.windowWidth ?? 0);
/** 便捷响应式：窗口/屏幕高度（px），未初始化时为 0 */
export const windowHeight = computed<number>((): number => systemInfo.value?.windowHeight ?? 0);
/** 便捷响应式：屏幕宽度（px），未初始化时为 0 */
export const screenWidth = computed<number>((): number => systemInfo.value?.screenWidth ?? 0);
/** 便捷响应式：屏幕高度（px），未初始化时为 0 */
export const screenHeight = computed<number>((): number => systemInfo.value?.screenHeight ?? 0);
/** 便捷响应式：状态栏高度（px），未初始化时为 0 */
export const statusBarHeight = computed<number>((): number => systemInfo.value?.statusBarHeight ?? 0);
/** 便捷响应式：可用内容高度（px），= 窗口高度 - 状态栏高度，未初始化时为 0 */
export const availableHeight = computed<number>((): number => {
  if (customTabbarConfig.type == 'default') {
    return systemInfo.value?.availableHeight ?? 0;
  }
  else {
    return systemInfo.value?.availableHeight ? systemInfo.value?.availableHeight + TABBAR_BASE_HEIGHT : 0;
  }
});
/** 便捷响应式：底部安全区高度（px），未初始化时为 0 */
export const safeAreaBottom = computed<number>((): number => systemInfo.value?.safeAreaInsets?.bottom ?? 0);

/**
 * 获取当前应用名称（全端从 import.meta.env 读取）
 */
export function getAppTitle(): string {
  return `${import.meta.env.VITE_APP_TITLE ?? 'unibestX'}`;
}

/**
 * 获取接口 BaseURL 地址（全端从 import.meta.env 读取）
 */
export function getApiBaseUrl(): string {
  return `${import.meta.env.VITE_SERVER_BASEURL ?? 'https://ukw0y1.laf.run'}`;
}

/**
 * 获取当前是否为 Vapor 渲染模式（使用 uni-app X 原生编译条件 VUE3-VAPOR 判定）
 */
export function isVaporMode(): boolean {
  // #ifdef VUE3-VAPOR
  return true;
  // #endif
  // #ifndef VUE3-VAPOR
  return false;
  // #endif
}

/**
 * 获取当前运行环境类型标识（'development' | 'test' | 'production'）
 */
export function getCurrentEnv(): string {
  const buildEnvType = `${import.meta.env.VITE_ENV_TYPE ?? ''}`;
  if (buildEnvType == 'test') {
    return 'test';
  }
  return process.env.NODE_ENV == 'development' ? 'development' : 'production';
}

/**
 * 获取当前运行环境中文名称（'开发环境' | '测试环境' | '生产环境'）
 */
export function getCurrentEnvName(): string {
  // 优先从环境变量读取中文名称（.env.* 中配置 VITE_ENV_NAME）
  const envName = `${import.meta.env.VITE_ENV_NAME ?? ''}`;
  if (envName != '') {
    return envName;
  }
  // 兜底：按 VITE_ENV_TYPE 推导
  const env = getCurrentEnv();
  if (env == 'test') {
    return '测试环境';
  }
  if (env == 'production') {
    return '生产环境';
  }
  return '开发环境';
}

/**
 * 获取当前应用版本号（优先从系统运行时获取，若为空从 VITE_APP_VERSION 或兜底 1.0.0）
 */
export function getAppVersion(): string {
  try {
    const sys = uni.getSystemInfoSync();
    if ((sys.appVersion ?? '') != '') {
      return `${sys.appVersion}`;
    }
  }
  catch { }
  // #ifdef MP-WEIXIN
  try {
    const appBaseInfo = uni.getAppBaseInfo() as any;
    if ((appBaseInfo.appVersion ?? '') != '') {
      return `${appBaseInfo.appVersion}`;
    }
  }
  catch { }
  // #endif
  return `${import.meta.env.VITE_APP_VERSION ?? '1.0.0'}`;
}

/**
 * 获取当前编译运行模式（如 "Vapor 模式 (开发)" / "VDOM 模式 (生产)"）
 */
export function getCompileMode(): string {
  const isVapor = isVaporMode();
  const modeName = isVapor ? 'Vapor 模式' : 'VDOM 模式';
  const envText = getCurrentEnv() == 'test' ? '测试' : (process.env.NODE_ENV == 'production' ? '生产' : '开发');
  return `${modeName} (${envText})`;
}

/**
 * 获取当前编译目标平台（如 "H5"、"Android"、"iOS"、"微信小程序" 等）
 */
export function getCompilePlatform(): string {
  // #ifdef H5
  return 'H5';
  // #endif
  // #ifdef APP-ANDROID
  return 'Android';
  // #endif
  // #ifdef APP-IOS
  return 'iOS';
  // #endif
  // #ifdef APP-HARMONY
  return 'HarmonyOS';
  // #endif
  // #ifdef MP-WEIXIN
  return '微信小程序';
  // #endif
  // #ifdef MP-ALIPAY
  return '支付宝小程序';
  // #endif
  // #ifdef MP-BAIDU
  return '百度小程序';
  // #endif
  // #ifdef MP-TOUTIAO
  return '字节小程序';
  // #endif
  // #ifdef MP-KUAISHOU
  return '快手小程序';
  // #endif
  // #ifdef MP-QQ
  return 'QQ小程序';
  // #endif
  // #ifndef H5 || APP-ANDROID || APP-IOS || APP-HARMONY || MP-WEIXIN || MP-ALIPAY || MP-BAIDU || MP-TOUTIAO || MP-KUAISHOU || MP-QQ
  try {
    const sys = uni.getSystemInfoSync();
    return sys.uniPlatform ?? '未知平台';
  }
  catch {
    return '未知平台';
  }
  // #endif
}

export function updateSystemInfo() {
  // 窗口信息：所有平台统一从 uni.getWindowInfo() 读取
  const windowInfo = uni.getWindowInfo();
  // ---- 编译器版本：各平台来源不同，互相兜底 ----
  let compileVer = '';
  // #ifdef H5
  try {
    const conf = (globalThis as any).__uniConfig as any;
    if (conf != null && conf.compilerVersion != null) {
      compileVer = `${conf.compilerVersion}`;
    }
  }
  catch { }
  // #endif
  // 非 H5：优先 uni.getSystemInfoSync().uniCompileVersion（全端通用 uni 编译版本，已验证 App 可取）
  if (compileVer == '') {
    try {
      const sysInfo = uni.getSystemInfoSync();
      compileVer = `${(sysInfo as any).uniCompileVersion ?? ''}`;
    }
    catch { }
  }
  // 兜底：getAppBaseInfo 版本字段（微信小程序用 appCompilerVersion/SDKVersion，其余用 version 引擎号）
  if (compileVer == '') {
    try {
      const appBaseInfo = uni.getAppBaseInfo();
      // #ifdef MP-WEIXIN
      compileVer = `${(appBaseInfo as any).appCompilerVersion ?? (appBaseInfo as any).SDKVersion ?? ''}`;
      // #endif
      // #ifndef MP-WEIXIN
      compileVer = `${appBaseInfo.version ?? ''}`;
      // #endif
    }
    catch { }
  }
  if (compileVer == '') {
    compileVer = '1.0.0';
  }

  // ---- 品牌 / 型号 / 系统信息：getDeviceInfo 优先，缺失时回退 getSystemInfoSync ----
  let brand = '';
  let model = '';
  let system = '';
  try {
    const dev = uni.getDeviceInfo();
    brand = `${dev.brand ?? ''}`;
    model = `${dev.model ?? ''}`;
  }
  catch { }
  try {
    const sys = uni.getSystemInfoSync();
    system = `${sys.system ?? ''}`;
    if (brand == '') {
      brand = `${sys.brand ?? ''}`;
    }
    if (model == '') {
      model = `${sys.model ?? ''}`;
    }
  }
  catch { }

  // ---- 写入公共系统信息 ----
  systemInfo.value = {
    screenWidth: windowInfo.screenWidth, // 屏幕宽度（px）
    screenHeight: windowInfo.screenHeight, // 屏幕高度（px）
    windowWidth: windowInfo.windowWidth, // 窗口可视宽度（px）
    windowHeight: windowInfo.windowHeight, // 窗口可视高度（px）
    statusBarHeight: windowInfo.statusBarHeight, // 状态栏高度（px）
    availableHeight: windowInfo.windowHeight - windowInfo.statusBarHeight, // 可用内容高度（px，窗口高度 - 状态栏高度）
    tabBarHeight: TABBAR_BASE_HEIGHT, // TabBar 默认基准高度（px）
    navBarHeight: NAVBAR_CONTENT_HEIGHT, // 导航栏内容区默认基准高度（px）
    pixelRatio: windowInfo.pixelRatio, // 像素比（dpr）
    brand, // 设备品牌
    model, // 设备型号
    system, // 操作系统及版本
    compilerVersion: compileVer, // 编译器 / SDK 版本
    uniCompileVersion: compileVer, // uni 编译器版本（当前与 compilerVersion 同源）
    isVapor: isVaporMode(), // 是否为 Vapor 渲染模式
    compileMode: getCompileMode(), // 编译运行模式（Vapor / VDOM + 环境）
    platformName: getCompilePlatform(), // 编译目标平台
    appTitle: getAppTitle(), // 应用名称
    appVersion: getAppVersion(), // 应用版本号
    apiBaseUrl: getApiBaseUrl(), // 接口 BaseURL 地址
    env: getCurrentEnv(), // 运行环境标识（development / test / production）
    envName: getCurrentEnvName(), // 运行环境中文名称
    safeAreaInsets: null, // 安全区域插入距离（稍后单独赋值）
    safeArea: null
  } as SystemInfoType;

  // ---- 安全区：微信 safeArea 为绝对坐标矩形，其余平台为相对边界距离 ----
  // #ifdef MP-WEIXIN
  const safeAreaInset = windowInfo.safeAreaInsets;
  console.log('wx windowInfo.safeArea:', safeAreaInset);
  console.log('wx windowInfo.safeAreaInsets:', windowInfo.safeAreaInsets);
  if (safeAreaInset != null) {
    const insets = {
      top: safeAreaInset.top,
      right: safeAreaInset.right,
      bottom: safeAreaInset.bottom,
      left: safeAreaInset.left
    } as SystemSafeAreaInsets;
    safeAreaInsets.value = insets;
    systemInfo.value.safeAreaInsets = insets;
  }
  const safeArea = windowInfo.safeArea;
  if (safeArea != null) {
    systemInfo.value.safeArea = {
      top: safeArea.top,
      right: safeArea.right,
      bottom: safeArea.bottom,
      left: safeArea.left,
      width: safeArea.width,
      height: safeArea.height
    } as SystemSafeArea;
  }
  // #endif
  // #ifndef MP-WEIXIN
  const safeAreaInset = windowInfo.safeAreaInsets;
  if (safeAreaInset != null) {
    const insets = {
      top: safeAreaInset.top,
      right: safeAreaInset.right,
      bottom: safeAreaInset.bottom,
      left: safeAreaInset.left
    } as SystemSafeAreaInsets;
    safeAreaInsets.value = insets;
    systemInfo.value.safeAreaInsets = insets;
  }
  const safeArea = windowInfo.safeArea;
  if (safeArea != null) {
    systemInfo.value.safeArea = {
      top: safeArea.top,
      right: safeArea.right,
      bottom: safeArea.bottom,
      left: safeArea.left,
      width: safeArea.width,
      height: safeArea.height
    } as SystemSafeArea;
  }
  // #endif
}

/**
 * 判断当前 HBuilderX / uni-app 编译器版本是否大于等于指定版本（如 '5.25' 或 '4.25'）
 */
export function isCompilerVersionGte(targetVersion: string): boolean {
  const current = systemInfo.value?.compilerVersion ?? '';
  if (current == '') {
    return false;
  }
  const curParts = current.split('.');
  const targetParts = targetVersion.split('.');
  const len = Math.max(curParts.length, targetParts.length);
  for (let i = 0; i < len; i++) {
    const curNum = i < curParts.length ? parseInt(curParts[i], 10) : 0;
    const targetNum = i < targetParts.length ? parseInt(targetParts[i], 10) : 0;
    if (curNum > targetNum) {
      return true;
    }
    if (curNum < targetNum) {
      return false;
    }
  }
  return true;
}

/**
 * 实时获取当前 TabBar 高度（单位 px）
 * @param includeSafeArea 是否包含底部安全区高度（默认 false）
 * @returns TabBar 高度（px）
 */
export function getTabBarHeight(includeSafeArea: boolean = false): number {
  const baseHeight: number = 50;
  if (!includeSafeArea) {
    return baseHeight;
  }
  const insets = safeAreaInsets.value;
  const bottomInset = insets != null ? insets.bottom : 0;
  return baseHeight + bottomInset;
}

/**
 * 获取环境变量中配置的 TabBar 策略模式（0: 无, 1: 原生, 2: 带原生自定义, 3: 纯自定义）
 */
export function getTabBarMode(): string {
  return `${import.meta.env.VITE_TABBAR_MODE ?? '1'}`.trim();
}

/**
 * 判断当前是否为原生 TabBar 模式（VITE_TABBAR_MODE 为 1 或 NATIVE_TABBAR）
 */
export function isNativeTabBar(): boolean {
  const mode = getTabBarMode();
  return mode == '1' || mode == 'NATIVE_TABBAR';
}

/**
 * 计算页面视口内滚动容器的自适应剩余可用高度（单位 px）
 * - 自动检测环境变量中的 TabBar 模式，若为原生 TabBar 模式（VITE_TABBAR_MODE=1）则自动扣除 TabBar 高度
 * @param topOffset 顶部占用高度（如自定义 Header、搜索框、Tabs 等，默认 0）
 * @param bottomOffset 底部占用高度（如自定义 TabBar、底部操作栏等，默认 0）
 * @param minusStatusBar 是否自动扣除系统状态栏高度（默认 true）
 * @returns 剩余可用视口高度（px）
 */
export function getScrollHeight(
  topOffset: number = 0,
  bottomOffset: number = 0,
  minusStatusBar: boolean = true
): number {
  const info = uni.getWindowInfo();
  const statusBar = minusStatusBar ? (info.statusBarHeight ?? 0) : 0;
  let tabBar = 0;
  if (isNativeTabBar()) {
    tabBar = getTabBarHeight(true);
  }
  return Math.max(0, info.windowHeight - topOffset - bottomOffset - statusBar - tabBar);
}

/**
 * 实时获取当前窗口可用高度（单位 px）
 */
export function getWindowHeight(): number {
  return uni.getWindowInfo().windowHeight;
}

/**
 * 实时获取当前状态栏高度（单位 px）
 */
export function getStatusBarHeight(): number {
  return uni.getWindowInfo().statusBarHeight;
}

/**
 * App.ku.uvue 页面 props 中参与可用高度计算的字段（由 autoRootPlugin 编译期全量注入）
 */
export type AppKuHeightProps = {
  /** 是否隐藏导航栏（true 时可用高度不扣除导航栏高度 navBarHeight） */
  hideNavbar: boolean;
  /** 页面 style 完整配置对象（与 App.ku.uvue 的 pageStyle prop 同源，含 navigationStyle，可能为空） */
  pageStyle: UTSJSONObject | null;
  /** 页面布局模板标识：不是 'navbar'（如 default 等无导航布局）时状态栏与导航栏都不扣除；'navbar' 正常扣除 */
  layout: string;
};

// 参考这个计算得出 https://doc.dcloud.net.cn/uni-app-x/api/get-window-info.html#%E8%BF%94%E5%9B%9E%E5%80%BC
export function updateAvailableHeight(kuProps: AppKuHeightProps, selectedTabbarStrategy: number): void {
  updateSystemInfo();
  // 非空收窄：局部 sys 固定为 SystemInfoType，避免对可空的 systemInfo.value 逐个 ?. / !! 处理（?. 得到 Number? 不能直接参与运算）
  const sys = systemInfo.value;
  if (sys == null) {
    return;
  }
  const safeBottom: number = sys.safeAreaInsets?.bottom ?? 0;
  const safeTop: number = sys.safeAreaInsets?.top ?? 0;
  const safeAreaBottom: number = sys.safeArea?.bottom ?? 0;

  // 是否自定义导航栏（navigationStyle == 'custom'）：由注入的 pageStyle 推导，与 App.ku.uvue 内 isCustomNav 判定同源
  const kuPageStyle: UTSJSONObject | null = kuProps.pageStyle ?? null;
  const navStyleText: string = kuPageStyle != null ? ((kuPageStyle.navigationStyle as string | null) ?? '') : '';
  const isCustomNav: boolean = navStyleText == 'custom';
  // 布局不是 'navbar'（default 等无自定义导航布局）时，窗口内没有导航栏占位，状态栏与导航栏高度都不扣除
  const isNoNavbarLayout: boolean = kuProps.layout != 'navbar';
  // hideNavbar 为 true（页面隐藏导航栏）或非 navbar 布局时，可用高度不扣除导航栏高度

  // 自定义状态栏高度
  let statusBarOffset: number = 0;
  if (isNoNavbarLayout) {
    statusBarOffset = isCustomNav ? 0 : safeTop;
  }
  else {
    statusBarOffset = kuProps.hideNavbar ? safeTop : safeTop;
  }

  // 自定义导航栏高度
  let navBarOffset: number = 0;
  if (isNoNavbarLayout) {
    navBarOffset = isCustomNav ? 0 : sys.navBarHeight;
  }
  else {
    if (isCustomNav) {
      navBarOffset = kuProps.hideNavbar ? 0 : sys.navBarHeight;
    }
    else {
      navBarOffset = sys.navBarHeight;
    }
  }

  // console.log(isNoNavbarLayout ? '不是navbar' : '是navbar');
  // console.log(kuProps.hideNavbar ? '隐藏了导航栏' : '没有隐藏导航栏');
  // console.log(isCustomNav ? '自定义导航栏' : '没有自定义导航栏');
  // console.log(navBarOffset, 'navBarOffset');
  // console.log(statusBarOffset, 'statusBarOffset');

  if (selectedTabbarStrategy == 2 || selectedTabbarStrategy == 3 || selectedTabbarStrategy == 1) {
    if (isNoNavbarLayout) {
      if (isCustomNav) {
        // #ifdef H5
        console.log('H5😂');
        console.log(`窗口screenHeight:${sys.screenHeight}`, 812);
        console.log(`窗口windowHeight:${sys.windowHeight}`, 812);
        console.log(`状态栏statusBarHeight:${sys.statusBarHeight}`, 0);
        console.log(`导航栏navBarHeight:${sys.navBarHeight}`, 44);
        console.log(`tabBarHeight:${sys.tabBarHeight}`, 50);
        console.log(`safeBottom:${safeBottom}`, 0);
        console.log(`safeAreaBottom:${safeAreaBottom}`, 812);
        console.log(`safeTop:${safeTop}`, 0);
        sys.availableHeight = safeAreaBottom - navBarOffset - statusBarOffset - sys.tabBarHeight;
        console.log(`H5-availableHeight: ${sys.availableHeight}`);
        systemId++;
        // #endif

        // #ifdef APP-ANDROID
        if (isVaporMode()) {
          // 👌 651 合格
          console.log(`第${systemId}次`);
          console.log('蒸汽-安卓😂');
          console.log(`窗口screenHeight:${sys.screenHeight}`, 780);
          console.log(`窗口windowHeight:${sys.windowHeight}`, 651);
          console.log(`状态栏statusBarHeight:${sys.statusBarHeight}`, 35);
          console.log(`导航栏navBarHeight:${sys.navBarHeight}`, 44);
          console.log(`tabBarHeight:${sys.tabBarHeight}`, 50);
          console.log(`safeBottom:${safeBottom}`, 0);
          console.log(`safeAreaBottom:${safeAreaBottom}`, 780);
          console.log(`safeTop:${safeTop}`, 35);
          sys.availableHeight = safeAreaBottom - navBarOffset - statusBarOffset - sys.tabBarHeight;
          systemId++;
        }
        else {
          // 👌 651 合格
          console.log(`第${systemId}次`);
          console.log('VDOM-安卓😂');
          console.log(`窗口screenHeight:${sys.screenHeight}`, 780);
          console.log(`窗口windowHeight:${sys.windowHeight}`, 780);
          console.log(`状态栏statusBarHeight:${sys.statusBarHeight}`, 35);
          console.log(`导航栏navBarHeight:${sys.navBarHeight}`, 44);
          console.log(`tabBarHeight:${sys.tabBarHeight}`, 50);
          console.log(`safeBottom:${safeBottom}`, 0);
          console.log(`safeAreaBottom:${safeAreaBottom}`, 780);
          console.log(`safeTop:${safeTop}`, 35);
          sys.availableHeight = safeAreaBottom - navBarOffset - statusBarOffset - sys.tabBarHeight;
          console.log(`vDOM-安卓-availableHeight: ${sys.availableHeight}`);
          systemId++;
        }

        // #endif

        // #ifdef APP-IOS
        if (isVaporMode()) {
          // 👌 852 670
          console.log(`第${systemId}次`);
          console.log('蒸汽-IOS😂');
          console.log(`窗口screenHeight:${sys.screenHeight}`, 852);
          console.log(`窗口windowHeight:${sys.windowHeight}`, 749);
          console.log(`状态栏statusBarHeight:${sys.statusBarHeight}`, 54);
          console.log(`导航栏navBarHeight:${sys.navBarHeight}`, 44);
          console.log(`tabBarHeight:${sys.tabBarHeight}`, 50);
          console.log(`safeBottom:${safeBottom}`, 34);
          console.log(`safeAreaBottom:${safeAreaBottom}`, 818);
          console.log(`safeTop:${safeTop}`, 59);
          console.log('----', sys.screenHeight - sys.statusBarHeight - sys.navBarHeight - sys.tabBarHeight - safeBottom);
          sys.availableHeight = safeAreaBottom - navBarOffset - statusBarOffset - sys.tabBarHeight;
          console.log(`蒸汽模式-IOS-availableHeight: ${sys.availableHeight}`);
        }
        else {
