/**
 * 全局轻提示与加载等待工具 (Toast & Loading)
 *
 * 统一轻提示体验，防御原生 uni.showToast 默认大对勾乌龙，并提供快捷 Loading 封装。
 */

/**
 * 普通文本轻提示（无图标，时长 1500ms）
 * @param message 提示文本
 */
export function toast(message: string): void {
  uni.showToast({
    title: message,
    icon: 'none',
    duration: 1500
  });
}

/**
 * 成功轻提示（带成功对勾图标，时长 1500ms）
 * @param message 成功提示文本
 */
export function toastSuccess(message: string): void {
  uni.showToast({
    title: message,
    icon: 'success',
    duration: 1500
  });
}

/**
 * 失败错误轻提示（带错误图标，时长 1500ms）
 * @param message 错误提示文本
 */
export function toastError(message: string): void {
  uni.showToast({
    title: message,
    icon: 'error',
    duration: 1500
  });
}

/**
 * 显示全局加载中提示框（默认带透明蒙层防重复操作）
 * @param title 加载中文案，默认为 '加载中...'
 * @param mask 是否显示透明蒙层，默认为 true
 */
export function showLoading(title: string = '加载中...', mask: boolean = true): void {
  uni.showLoading({
    title,
    mask
  });
}

/**
 * 关闭全局加载中提示框
 */
export function hideLoading(): void {
  uni.hideLoading();
}
