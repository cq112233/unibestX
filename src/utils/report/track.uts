/**
 * 业务行为埋点钩子
 *
 * 设计要点：只留钩子不给实现 —— 不绑任何厂商 SDK、不注册回调函数引用
 * （UTS 禁传函数引用）。接入时直接改 onTrackStub 的函数体，或先
 * setTrackEndpoint() 再在 stub 内发请求。
 *
 * 上报地址默认为空：为空时 onTrackStub 直接返回，不会把数据误发到未知域名。
 */

import { isProd } from '@/src/config/index.uts';
import { currentPagePath } from './internal/common.uts';

export type TrackPayload = {
  event: string;
  propsJson: string;
  page: string;
  time: number;
};

/** 上报地址；为空表示未配置，stub 不发任何请求 */
let trackEndpoint: string = '';

/**
 * 配置埋点上报地址（空则 stub 不真正发送）
 * @param url 埋点上报接口的完整地址；传空字符串等于**关闭上报**（stub 直接 return），
 *            另外 stub 还要求处于生产环境才会真正发送
 */
export function setTrackEndpoint(url: string): void {
  trackEndpoint = url;
}

/** 当前埋点上报地址 */
export function getTrackEndpoint(): string {
  return trackEndpoint;
}

/**
 * 业务覆盖此 stub 实现真实上报。
 *
 * 默认实现只在本项目已配置上报地址、且处于生产环境时才提示，
 * 避免开发期误发数据。接入真实 SDK 时替换本函数体即可，签名保持不变。
 * @param payload 已组装好的埋点载荷（event / propsJson / page / time）；
 *                默认实现只打一条 console.log，且仅在「已配置 endpoint + 生产环境」时命中
 */
export function onTrackStub(payload: TrackPayload): void {
  if (trackEndpoint.length == 0) {
    return;
  }
  if (!isProd()) {
    return;
  }
  // 占位：对接时在此发起上报请求（如 http.post(trackEndpoint, payload)）
  console.log('[track] stub →', trackEndpoint, payload.event, payload.page);
}

/**
 * 上报一个埋点事件
 * @param event 事件名
 * @param propsJson 属性 JSON 字符串（UTS 友好，避免传对象）
 */
export function track(event: string, propsJson: string = ''): void {
  if (event.length == 0) {
    return;
  }
  const payload: TrackPayload = {
    event,
    propsJson,
    page: currentPagePath(),
    time: Date.now()
  } as TrackPayload;
  try {
    onTrackStub(payload);
  }
  catch (e) {
    console.error('[track] stub threw', e);
  }
}

/**
 * 页面曝光：page 为空则取当前路由
 * @param page 页面路径；传空字符串即自动取 `currentPagePath()`（页面栈顶路由），
 *             显式传入的场景一般是「上报的是上一个页面」
 */
export function trackPageView(page: string = ''): void {
  const p = page.length > 0 ? page : currentPagePath();
  track('page_view', `{"page":"${p}"}`);
}

/**
 * 点击埋点
 * @param name 点击事件名（建议形如 `btn_login`）；会被直接拼进 `propsJson` 的 `{"name":"..."}`，
 *             **含双引号会破坏 JSON 结构**，命名请只用字母 / 数字 / 下划线
 */
export function trackClick(name: string): void {
  track('click', `{"name":"${name}"}`);
}
