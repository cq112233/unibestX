import { getCurrentPath, useRouter } from '@/uni_modules/route-bestX/index.uts';

/**
 * 登录页面绝对路由路径
 */
export const LOGIN_PAGE: string = '/src/sub/auth/login';

/**
 * 注册页面绝对路由路径
 */
export const REGISTER_PAGE: string = '/src/sub/auth/register';

let lastRedirectTime = 0;

/**
 * 跳转到登录页面，带防抖与节流保护，避免并发请求时重复打开多个登录页。
 * - 使用 getCurrentPath() 精准判断当前页面，避免重复打开自身
 * - 默认 1000ms 节流窗口
 *
 * @param options 可选配置项（mode: 'navigateTo' | 'reLaunch', queryString: string）
 */
export function toLoginPage(options: UTSJSONObject | null = null) {
  const now = Date.now();
  if (now - lastRedirectTime < 1000) {
    return;
  }
  lastRedirectTime = now;
  const opts = options ?? ({} as UTSJSONObject);
  const rawMode = typeof opts.getString == 'function'
    ? opts.getString('mode')
    : (opts.mode as string | null);
  const mode = rawMode != null ? rawMode : 'navigateTo';
  const rawQuery = typeof opts.getString == 'function'
    ? opts.getString('queryString')
    : (opts.queryString as string | null);
  const queryString = rawQuery != null ? rawQuery : '';
  const url = `${LOGIN_PAGE}${queryString}`;
  // 判断当前页面是否已是登录页，避免重复跳转
  const currentPath = getCurrentPath();
  if (currentPath == LOGIN_PAGE || currentPath.endsWith(LOGIN_PAGE)) {
    return;
  }
  const router = useRouter();
  if (mode == 'navigateTo') {
    router.push(url);
  }
  else {
    router.relaunch(url);
  }
}

export default toLoginPage;
