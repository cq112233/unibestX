/**
 * 权限判断工具
 *
 * 权限码直接来自用户信息 `userInfo.permissions`，支持 `*` 通配。
 * 页面与按钮统一从这里判断，避免各页面重复实现导致规则漂移。
 */

import { useUserStore } from '@/src/store/index.uts';

/**
 * 获取当前用户的权限码；兼容旧持久化数据缺失字段的情况。
 */
export function getPermissions(): Array<string> {
  const permissions = useUserStore().state.userInfo.permissions;
  return permissions != null ? permissions : ([] as Array<string>);
}

/**
 * 判断当前用户是否具备指定权限。
 * @param permission 权限码，例如 `report:read`；空字符串直接视为无权限。
 */
export function hasPermission(permission: string): boolean {
  if (permission == '') {
    return false;
  }
  const permissions = getPermissions();
  for (let i = 0; i < permissions.length; i++) {
    const code = permissions[i];
    if (code == '*' || code == permission) {
      return true;
    }
  }
  return false;
}

/**
 * 判断当前用户是否具备任意一个权限码。
 */
export function hasAnyPermission(permissionList: Array<string>): boolean {
  for (let i = 0; i < permissionList.length; i++) {
    if (hasPermission(permissionList[i])) {
      return true;
    }
  }
  return false;
}
